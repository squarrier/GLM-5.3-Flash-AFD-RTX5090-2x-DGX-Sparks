#!/usr/bin/env python3
"""glm53f-afd-report [days=1]: roll up glm53f-afd-watch telemetry into a markdown summary.

Reads $STATE_DIR/telemetry/*.jsonl. Prints availability, probe TTFT,
hourly decode-benchmark drift, drafter acceptance, slot pressure / host-cache traffic, per-host memory
floor and GPU power/temperature, guard/kernel events and recoveries: the data for tuning slots,
context cap, drafter, MPS and the Spark count.
"""
import glob, json, os, statistics as st, sys, time, datetime

STATE = os.environ.get("STATE_DIR", os.path.expanduser("~/.glm53f-afd-watch"))

days = float(sys.argv[1]) if len(sys.argv) > 1 else 1
cut = time.time() - days * 86400
R = []
for f in sorted(glob.glob(f"{STATE}/telemetry/*.jsonl")):
    for line in open(f):
        try:
            r = json.loads(line)
        except Exception:
            continue
        if r.get("ts", 0) >= cut:
            R.append(r)
if not R:
    print("no telemetry in window"); sys.exit(0)


def pct(v, q):
    v = sorted(v); return v[min(len(v) - 1, int(q * len(v)))] if v else None


def fmt(x, n=1):
    return "—" if x is None else f"{x:.{n}f}"


serving = [r for r in R if r.get("mode") == "serving"]
up = [r for r in serving if r.get("health") == 200 and r.get("probe", {}).get("ok")]
ttft = [r["probe"]["ttft_s"] for r in up if r.get("probe", {}).get("ttft_s", -1) > 0]
bench = [(r["iso"], r["bench"]["tok_s_e2e"]) for r in R if isinstance(r.get("bench"), dict) and r["bench"].get("tok_s_e2e")]
drafter = [r["drafter"]["kept_pct"] for r in R if r.get("drafter")]
tpw = [r["drafter"]["tokens_per_window"] for r in R if r.get("drafter")]
cl = [r.get("coord_log", {}) for r in R]
rec = [r for r in R if r.get("recover")]
print(f"# glm53f-afd telemetry: {R[0]['iso']} → {R[-1]['iso']} ({len(R)} samples, {days:g} d)\n")
print(f"- Availability (serving mode, health 200 + correct probe): **{100*len(up)/max(1,len(serving)):.2f}%** ({len(up)}/{len(serving)})")
print(f"- Probe TTFT p50/p95: {fmt(pct(ttft,.5),3)} / {fmt(pct(ttft,.95),3)} s")
if bench:
    v = [b for _, b in bench]
    print(f"- Hourly 256-token decode bench (e2e tok/s): n={len(v)} median {st.median(v):.1f}, min {min(v):.1f}, max {max(v):.1f}; first {v[0]:.1f} → last {v[-1]:.1f}")
if drafter:
    print(f"- Drafter acceptance (cumulative log lines): kept {st.median(drafter):.1f}% median, {st.median(tpw):.2f} tokens/window")
print(f"- Slot pressure evictions: {sum(c.get('slot_pressure',0) for c in cl)}; host-cache stores/restores: {sum(c.get('hostcache_store',0) for c in cl)}/{sum(c.get('hostcache_restore',0) for c in cl)}; coordinator error-ish lines: {sum(c.get('errors',0) for c in cl)}")
print(f"- Auto-recoveries: {len(rec)}" + "".join(f"\n  - {r['iso']}: rc={r['recover']['rc']} in {r['recover']['seconds']} s" for r in rec))
print("\n| host | min MemAvailable GiB | p50 | max swap GiB | max PSI | GPU p95 util % | max power W | max temp °C | guard events | kernel events |")
print("|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|")
for h in ("spark1", "spark2", "coord"):
    hs = [r[h] for r in R if r.get(h, {}).get("ssh")]
    g = lambda k: [x[k] for x in hs if x.get(k) is not None]
    a = g("avail_gib")
    print(f"| {h} | {fmt(min(a) if a else None)} | {fmt(st.median(a) if a else None)} | {fmt(max(g('swap_used_gib') or [0]))} | {fmt(max(g('psi_full_avg10') or [0]),2)} | {fmt(pct(g('gpu_util'),.95),0)} | {fmt(max(g('gpu_power_w') or [0]))} | {fmt(max(g('gpu_temp_c') or [0]),0)} | {sum(g('guard_events_new'))} | {sum(g('kern_events_3m'))} |")
