#!/usr/bin/env python3
"""extras/watch/glm53f-afd-watch: keep-alive + telemetry for the lane. Run it every 2 min from cron:

    */2 * * * * /path/to/repo/extras/watch/glm53f-afd-watch >> ~/.glm53f-afd-watch/alerts.log 2>&1

It is silent unless it acts or something needs you, so the cron output (or alerts.log) *is* the alert
channel; pipe it to your notifier of choice.

Keep-alive (STATE_DIR/mode = serving, the default; `echo maintenance > STATE_DIR/mode` to pause):
  * /health + a real completion every run (/health can stay 200 ~2 min with a dead rank).
  * 2 consecutive failures -> `./start.sh recover` (restarts only what is broken, always the coordinator).
  * Circuit breaker: max 3 recoveries in 6 h, then LATCH (stop acting, alert, keep collecting);
    `rm STATE_DIR/latched` to clear.
  * Never reboots and never hard-kills MPS. A Spark stranded below the memory floor after a graceful
    stop (recover rc=3) latches immediately with a "needs a reboot" alert.

Telemetry (JSONL in STATE_DIR/telemetry/YYYY-MM-DD.jsonl; roll-up: glm53f-afd-report [days]):
  per host MemAvailable/swap/PSI, GPU util/mem/power/temp/clock, MPS count, unit states, new kernel
  Xid/NVRM/OOM lines; coordinator log deltas (drafter acceptance, slot pressure, host-cache traffic,
  errors); probe TTFT; an hourly 256-token decode benchmark (skipped when the lane is busy).
"""
import json, os, re, shlex, subprocess, sys, time, urllib.request, urllib.error, datetime

REPO = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
STATE = os.environ.get("STATE_DIR", os.path.expanduser("~/.glm53f-afd-watch"))
TEL = f"{STATE}/telemetry"
CTL = f"{REPO}/start.sh"
ENV = {}
for line in open(f"{REPO}/.env"):
    line = line.split("#", 1)[0].strip()
    if "=" in line:
        k, v = line.split("=", 1); ENV[k.strip()] = v.strip().strip('"')
ENV.update({k: v for k, v in os.environ.items() if k in ENV})
USER = ENV["SSH_USER"]
GLM_HOME = ENV["GLM_HOME"]
PORT = ENV.get("API_LISTEN", "0.0.0.0:8000").rsplit(":", 1)[1]
BASE = f"http://{ENV.get('COORD_API_HOST') or ENV['COORD_HOST']}:{PORT}"
MODEL = (ENV.get("SERVED_NAMES") or "glm-5.3-flash").split(",")[0]
API_KEY = os.environ.get("API_KEY", "")
AUTH = {"Authorization": f"Bearer {API_KEY}"} if API_KEY else {}
HOSTS = {"spark1": ENV["SPARK1_HOST"], "spark2": ENV["SPARK2_HOST"], "coord": ENV["COORD_HOST"]}
MAX_RECOVERIES, WINDOW_S = 3, 6 * 3600
os.makedirs(STATE, exist_ok=True)
os.makedirs(TEL, exist_ok=True)
now = time.time()
alerts, events = [], []


def sh(cmd, timeout=60):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except subprocess.TimeoutExpired:
        return 124, ""


def rsh(host, cmd, timeout=40):
    return sh(f"timeout {timeout} ssh -o BatchMode=yes -o ConnectTimeout=8 {USER}@{HOSTS[host]} {shlex.quote(cmd)}", timeout + 5)


def rd(name, default=""):
    try:
        return open(f"{STATE}/{name}").read().strip()
    except Exception:
        return default


def wr(name, val):
    open(f"{STATE}/{name}", "w").write(str(val))


def http(path, body=None, timeout=10):
    req = urllib.request.Request(BASE + path, data=json.dumps(body).encode() if body else None,
                                 headers={"Content-Type": "application/json", **AUTH})
    t = time.time()
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.status, r.read().decode(), time.time() - t


def probe():
    """Streaming probe: correctness + TTFT + decode tok/s."""
    body = {"model": MODEL, "messages": [{"role": "user", "content": "Reply with exactly: PONG-7731"}],
            "max_tokens": 256, "temperature": 0, "reasoning_effort": "none", "stream": True}
    req = urllib.request.Request(BASE + "/v1/chat/completions", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json", **AUTH})
    t0 = time.time(); ttft = None; text = ""
    with urllib.request.urlopen(req, timeout=90) as r:
        for line in r:
            line = line.decode().strip()
            if not line.startswith("data:") or line == "data: [DONE]":
                continue
            d = json.loads(line[5:])
            c = (d.get("choices") or [{}])[0].get("delta", {}).get("content") or ""
            if c and ttft is None:
                ttft = time.time() - t0
            text += c
    return "PONG-7731" in text, ttft, time.time() - t0


def bench():
    """Fixed hourly decode benchmark: 256 tokens, single stream, thinking off, temp 0."""
    body = {"model": MODEL, "messages": [{"role": "user", "content":
            "Write a detailed explanation of how a hash map handles collisions, with a Python example."}],
            "max_tokens": 256, "temperature": 0, "reasoning_effort": "none", "ignore_eos": True}
    st, out, dt = http("/v1/chat/completions", body, timeout=180)
    u = json.loads(out).get("usage", {})
    return {"completion_tokens": u.get("completion_tokens"), "seconds": round(dt, 2),
            "tok_s_e2e": round((u.get("completion_tokens") or 0) / dt, 1) if dt else None}


rec = {"ts": int(now), "iso": datetime.datetime.now().isoformat(timespec="seconds"), "mode": rd("mode", "serving"),
       "latched": os.path.exists(f"{STATE}/latched")}

# ---- per-host telemetry -------------------------------------------------------------------
HOSTCMD = r"""
awk '/MemAvailable/{a=$2}/SwapTotal/{st=$2}/SwapFree/{sf=$2}END{printf "mem %.1f %.1f\n",a/1048576,(st-sf)/1048576}' /proc/meminfo
awk '/full/{split($2,x,"=");print "psi",x[2]}' /proc/pressure/memory
nvidia-smi --query-gpu=utilization.gpu,memory.used,power.draw,temperature.gpu,clocks.sm --format=csv,noheader,nounits 2>/dev/null | sed 's/^/gpu /'
echo "mps $(pgrep -fc ^nvidia-cuda-mps-server)"
for u in gb10-hostguard glm53f-afd-coord glm53f-afd-ranks; do echo "unit $u $(systemctl is-active $u 2>/dev/null)"; done
echo "guard_events $(wc -l < /var/log/gb10-hostguard/events.log 2>/dev/null || echo 0)"
echo "kern $(journalctl -k --since '-3min' --no-pager -q 2>/dev/null | grep -ciE 'xid|nvrm|out of memory|oom-kill|hung_task')"
"""
for h in HOSTS:
    rc, out = rsh(h, HOSTCMD)
    hs = {"ssh": rc == 0 and bool(out)}
    for line in out.splitlines():
        p = line.split()
        if not p:
            continue
        try:
            if p[0] == "mem": hs["avail_gib"], hs["swap_used_gib"] = float(p[1]), float(p[2])
            elif p[0] == "psi": hs["psi_full_avg10"] = float(p[1])
            elif p[0] == "gpu":
                v = [x.strip() for x in " ".join(p[1:]).split(",")]
                hs.update(gpu_util=float(v[0]), gpu_mem_mib=None if "N/A" in v[1] else float(v[1]),
                          gpu_power_w=None if "N/A" in v[2] else float(v[2]), gpu_temp_c=float(v[3]), sm_mhz=float(v[4]))
            elif p[0] == "mps": hs["mps_servers"] = int(p[1])
            elif p[0] == "unit" and len(p) > 2 and p[2] != "inactive": hs.setdefault("units", {})[p[1]] = p[2]
            elif p[0] == "guard_events":
                n = int(p[1]); last = int(rd(f"{h}.guard_events", n)); wr(f"{h}.guard_events", n)
                hs["guard_events_new"] = max(0, n - last)
            elif p[0] == "kern": hs["kern_events_3m"] = int(p[1])
        except Exception:
            pass
    rec[h] = hs
    if not hs["ssh"]:
        n = int(rd(f"{h}.sshfail", 0)) + 1; wr(f"{h}.sshfail", n)
        if n == 2: alerts.append(f"{h} ({HOSTS[h]}): SSH not answering for 2 checks (~4 min).")
    else:
        wr(f"{h}.sshfail", 0)
        if ENV.get("REQUIRE_GUARD") == "1" and hs.get("units", {}).get("gb10-hostguard") != "active":
            alerts.append(f"{h}: gb10-hostguard is not active.")
        if hs.get("guard_events_new"):
            _, ev = rsh(h, f"tail -n {hs['guard_events_new']} /var/log/gb10-hostguard/events.log")
            if re.search(r'"(killed|warn_low_mem|hard_low_mem)"', ev):
                alerts.append(f"{h}: gb10-hostguard acted: {ev.strip()[-300:]}")
        if hs.get("kern_events_3m"):
            events.append(f"{h}: {hs['kern_events_3m']} kernel Xid/NVRM/OOM line(s) in the last 3 min")
        if h != "coord" and hs.get("avail_gib") is not None and hs["avail_gib"] < 12:
            alerts.append(f"{h}: MemAvailable {hs['avail_gib']} GiB (< 12) while serving.")

# ---- coordinator log since last run ---------------------------------------------------------
rc, out = rsh("coord", f"f=$(readlink -f {GLM_HOME}/logs/coord-latest.log); echo $f; wc -l < $f")
lines = out.split()
if len(lines) == 2:
    path, n = lines[0], int(lines[1])
    prev_path, prev_n = rd("coordlog.path"), int(rd("coordlog.n", 0) or 0)
    start = prev_n + 1 if prev_path == path and prev_n <= n else 1
    wr("coordlog.path", path); wr("coordlog.n", n)
    if n >= start:
        _, new = rsh("coord", f"sed -n '{start},{min(n, start + 4000)}p' {path}")
        acc = re.findall(r"\[drafter\] (\d+) rounds.*?(\d+) drafts verified, (\d+) kept \(([\d.]+)%\), ([\d.]+) tokens a window", new)
        if acc:
            a = acc[-1]; rec["drafter"] = {"rounds": int(a[0]), "kept_pct": float(a[3]), "tokens_per_window": float(a[4])}
        rec["coord_log"] = {"new_lines": n - start + 1,
                            "slot_pressure": len(re.findall(r"slot pressure", new)),
                            "hostcache_store": len(re.findall(r"\[hostcache\] store", new)),
                            "hostcache_restore": len(re.findall(r"\[hostcache\] restore", new)),
                            "errors": len(re.findall(r"(?i)\b(error|panic|failed|refus)", new))}
        errs = [l for l in new.splitlines() if re.search(r"(?i)\b(panic|wire error|refuses every pass|CUDA error)", l)]
        if errs:
            events.append("coordinator log: " + errs[-1][:240])

# ---- health + probe + keep-alive --------------------------------------------------------------
try:
    hc, hbody, _ = http("/health", timeout=6)
except urllib.error.HTTPError as e:
    hc, hbody = e.code, e.read().decode()[:200]
except Exception as e:
    hc, hbody = 0, str(e)[:200]
rec["health"] = hc
pok = False
if hc == 200:
    try:
        pok, ttft, tot = probe(); rec["probe"] = {"ok": pok, "ttft_s": round(ttft or -1, 3), "total_s": round(tot, 2)}
    except Exception as e:
        rec["probe"] = {"ok": False, "err": str(e)[:160]}
healthy = hc == 200 and pok
mode = rec["mode"]
# After a reboot of the controller box, give an `@reboot ./start.sh` 10 min before acting.
try:
    boot_age = time.time() - float(open("/proc/uptime").read().split()[0])
    in_boot_grace = (time.time() - boot_age) < 600
except Exception:
    in_boot_grace = False
if not healthy and mode == "serving" and in_boot_grace:
    rec["boot_grace"] = True
    mode = "boot-grace"
if healthy:
    wr("fails", 0)
    if datetime.datetime.now().minute < 2 and mode == "serving":
        busy = (rec.get("coord", {}).get("gpu_util") or 0) > 15 or (rec.get("coord_log", {}).get("new_lines") or 0) > 40
        if busy:
            rec["bench"] = {"skipped": "lane busy"}
        else:
            try:
                rec["bench"] = bench()
            except Exception as e:
                rec["bench"] = {"err": str(e)[:160]}
elif mode == "serving":
    fails = int(rd("fails", 0)) + 1; wr("fails", fails)
    rec["fails"] = fails
    if os.path.exists(f"{STATE}/latched"):
        if fails in (2, 30):  # remind once at detection and ~1 h later, not every 2 min
            alerts.append(f"glm53f-afd DOWN (/health {hc}); watchdog is LATCHED ({rd('latched')}) — not acting. `./start.sh status`, then `rm {STATE}/latched`.")
    elif fails >= 2:
        hist = [float(x) for x in rd("recoveries").split() if x and now - float(x) < WINDOW_S]
        if len(hist) >= MAX_RECOVERIES:
            wr("latched", f"{len(hist)} recoveries in 6 h at {rec['iso']}")
            alerts.append(f"glm53f-afd DOWN (/health {hc} {hbody[:120]}). {len(hist)} recoveries in 6 h — circuit breaker LATCHED; not retrying. Look at `./start.sh status`.")
        else:
            t = time.time(); rc, out = sh(f"{shlex.quote(CTL)} recover", timeout=900)
            hist.append(now); wr("recoveries", " ".join(str(int(x)) for x in hist))
            rec["recover"] = {"rc": rc, "seconds": round(time.time() - t, 1), "tail": out.strip()[-400:]}
            if rc == 0:
                wr("fails", 0)
                alerts.append(f"glm53f-afd was down (/health {hc}: {hbody[:100]}); auto-recovered in {time.time()-t:.0f} s ({len(hist)}/{MAX_RECOVERIES} in 6 h). {out.strip().splitlines()[-1] if out.strip() else ''}")
            elif rc == 3:
                wr("latched", f"stranded GB10 memory at {rec['iso']}")
                alerts.append("glm53f-afd DOWN and a Spark is below the memory floor after a graceful stop (stranded GB10 memory). Needs a reboot of that Spark — your call; watchdog latched. Details: " + out.strip()[-300:])
            else:
                alerts.append(f"glm53f-afd DOWN; recover failed rc={rc}: {out.strip()[-300:]}")

with open(f"{TEL}/{datetime.date.today().isoformat()}.jsonl", "a") as f:
    f.write(json.dumps(rec) + "\n")
wr("last_run", rec["iso"])
if events:
    with open(f"{STATE}/events.log", "a") as f:
        for e in events:
            f.write(f"{rec['iso']} {e}\n")
if alerts:
    print(f"glm53f-afd watch ({rec['iso']}):")
    for a in alerts:
        print("- " + a)
