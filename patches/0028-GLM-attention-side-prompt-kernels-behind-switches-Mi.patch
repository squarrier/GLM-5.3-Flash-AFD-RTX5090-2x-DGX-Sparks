+    """(digests, checks): the ported kernels with every switch on (``setenv`` sets them for our per-call switches;
+    her tree read them at import). ``ours``: also this port's same-bits checks (switch-off paths vs ported ones)."""
+
+    setenv = setenv or os.environ.__setitem__
+    for name, value in ON.items():
+        setenv(name, value)
+    dev = device
+    out: dict[str, str] = {}
+    chk: dict[str, object] = {}
+    R, H, D, LW, DV = 70, 2, 128, 256, 128
+    q = _randn((R, H, D), 1, device=dev)
+    a = latent.AbsorbW(_randn((H, D, LW), 2, 0.05, device=dev), _randn((H, DV, LW), 3, 0.05, device=dev))
+    o = torch.empty((R, H, LW), dtype=torch.bfloat16, device=dev)
+    latent.absorb_q(q, a, o, prompt=True)
+    out["absorb_mma"] = _digest(o)
+    ov = torch.empty((R, H, DV), dtype=torch.bfloat16, device=dev)
+    latent.expand_v(_randn((R, H, LW), 4, device=dev), a, ov, prompt=True)
+    out["expand_mma"] = _digest(ov)
+    if ours:
+        lo = torch.empty((64, H, LW), dtype=torch.bfloat16, device=dev)
+        hi = torch.empty((R - 64, H, LW), dtype=torch.bfloat16, device=dev)
+        latent.absorb_q(q[:64].contiguous(), a, lo, prompt=True)
+        latent.absorb_q(q[64:].contiguous(), a, hi, prompt=True)
+        chk["absorb_mma rows independent of the chunk"] = bool(torch.equal(torch.cat([lo, hi]), o))
+        ref = torch.einsum("rhd,hdl->rhl", q.float(), a.wk.float())
+        chk["absorb_mma max |err| vs fp32 einsum"] = float((o.float() - ref).abs().max())
+
+    S, DH = 4, 512                                  # 128-column blocks: _hc_partial's SUB (the model's are 1,024)
+    x = _randn((R, S * DH), 5, device=dev)
+    fn = _randn((24, S * DH), 6, 0.05, device=dev)
+    base = _randn((24,), 7, 0.1, torch.float32, device=dev)
+    scale = torch.tensor([0.5, 0.25, 0.125], device=dev)
+    norm_w = _randn((DH,), 8, 0.1, device=dev).float() + 1.0
+
+    def hc(mma: str):
+        setenv("TF_GLM_HC_MMA", mma)
+        bufs = (torch.empty((R, DH), dtype=torch.bfloat16, device=dev), torch.empty((R, DH // 64), device=dev),
+                torch.empty((R, S), device=dev), torch.empty((R, S * S), device=dev),
+                torch.zeros((R, glue.HC_BLOCKS, 32), device=dev))
+        glue.hc_pre(x, fn, base, scale, norm_w, *bufs, 1e-6, 1e-6, 3, prompt=True)
+        setenv("TF_GLM_HC_MMA", "1")
+        return bufs
+
+    hb = hc("1")
+    out["hc_mma"] = _digest(*hb)
+    if ours:
+        h0 = hc("0")
+        chk["hc: max |out|, |post|, |comb| mma vs switch off"] = [
+            float((h0[i].float() - hb[i].float()).abs().max()) for i in (0, 2, 3)]
+
+    for kind, (N, K) in (("b16", (512, 1024)), ("f8", (512, 1024)), ("f8", (4096, 1024))):
+        name = f"seq_{kind}_{N}x{K}"
+        xm = _randn((64, K), 9, device=dev)
+        w = _randn((N, K), 10, 0.05, device=dev)
+        wq = qmm.B16(weight=w.contiguous(), n=N, k=K) if kind == "b16" else _f8(w)
+        om = qmm.matmul(xm, wq)
+        out[name] = _digest(om)
+        if ours:
+            setenv("TF_GLM_SEQ_ROWS", "0")
+            o0 = qmm.matmul(xm, wq)
+            setenv("TF_GLM_SEQ_ROWS", "16")
+            chk[f"{name}: SEQ == split grid + _reduce (bits)"] = bool(torch.equal(om, o0))
+
+    RS, HS, NC = 4, 16, 600
+    qa = _randn((RS, HS, 512), 11, device=dev)
+    lat = _randn((NC, 512), 12, device=dev)
+    counts = torch.tensor([100, 37, 0, 64], dtype=torch.int32)
+    tokens = torch.full((RS, sparse.TOKENS), -1, dtype=torch.int32)
+    for r in range(RS):
+        pick = torch.randperm(NC, generator=torch.Generator().manual_seed(20 + r))[: int(counts[r])].sort().values
+        tokens[r, : len(pick)] = pick.to(torch.int32)
+    counts, tokens = counts.to(dev), tokens.to(dev)
+    for kind in ("bf16", "fp8"):
+        name = f"onepass_{kind}"
+        cache = lat.contiguous() if kind == "bf16" else kv8.quantize_rows(lat)
+        op = torch.zeros((RS, HS, 512), dtype=torch.bfloat16, device=dev)
+        latent.sparse_onepass(qa, cache, tokens, counts, op, 0.0625)
+        out[name] = _digest(op)
+        if ours:
+            vals = kv8.dequantize(cache).float() if kind == "fp8" else lat.float()
+            err = 0.0
+            for r in (0, 1, 3):
+                sel = vals[tokens[r, : int(counts[r])].long()]
+                ref = torch.softmax(qa[r].float() @ sel.T * 0.0625, -1) @ sel
+                err = max(err, float((op[r].float() - ref).abs().max()))
+            chk[f"{name}: max |onepass - torch softmax reference|"] = err
+            chk[f"{name}: count-0 row left alone"] = bool(torch.equal(op[2], torch.zeros_like(op[2])))
+
+    for pos, R2, np_max in ((2045, 8, 1024), (8400, 8, 4096)):
+        name = f"select_prompt_{pos}"
+        qi = _randn((R2, 32 * 128), 30, device=dev)
+        wts = _randn((R2, 32), 31, device=dev)
+        pk = _randn((np_max + 2, 128), 32, device=dev)
+        pos_dev = torch.tensor([pos], dtype=torch.int32, device=dev)
+        tok, cnt = sparse._select_prompt(qi, wts, pk, pos, R2, np_max, pos_dev)
+        counted = cnt > 0
+        out[name] = _digest(cnt, tok[counted])
+        if ours:
+            setenv("TF_GLM_PROMPT_DSA", "0")
+            tok0, cnt0 = sparse.select_tokens(qi, wts, pk, pos, R2, np_max, pos_dev)
+            setenv("TF_GLM_PROMPT_DSA", "1")
+            chk[f"{name}: counts and counted rows' tokens == switch off"] = bool(
+                torch.equal(cnt, cnt0) and torch.equal(tok[counted], tok0[counted]))
+
+    R3, HD, pos = 6, 16, 2047                       # rows 2047 .. 2052: 2051 and 2052 are sparse-counted
+    qa3 = _randn((R3, HD, 512), 40, device=dev)
+    lc = _randn((pos + R3 + 8, 512), 41, device=dev)
+    pos_dev = torch.tensor([pos], dtype=torch.int32, device=dev)
+    nch = latent.chunks_for(pos + R3)
+    s = latent.LatentScratch(R3, HD, nch, dev, lw=512, part_rows=2)
+    hbk = latent.head_block(R3)
+    full = torch.zeros((R3, HD, 512), dtype=torch.bfloat16, device=dev)
+    for r0 in range(0, R3, 2):                       # the switch-off path: blocks at pos_dev + r0
+        latent.attention(qa3[r0:r0 + 2], lc, pos_dev + r0, s, scale=0.0625, nch=nch, out=full[r0:r0 + 2], hb=hbk)
+    out["dense_rows_starts"] = _digest(full)
+    if ours:
+        class C:
+            dense_limit = sparse.SPARSE_FROM
+
+        n = forward.dense_rows(C, R3, pos)
+        starts = torch.arange(0, R3, 2, dtype=torch.int32, device=dev)
+        lean = torch.zeros_like(full)
+        forward.dense_attention(qa3[:n], lc, pos_dev, s, scale=0.0625, nch=nch, out=lean[:n], hb=hbk, starts=starts)
+        whole = torch.zeros_like(full)
+        forward.dense_attention(qa3, lc, pos_dev, s, scale=0.0625, nch=nch, out=whole, hb=hbk, starts=starts)
+        chk["lean dense rows == full pass rows, starts path == pos_dev + r0 path (bits)"] = bool(
+            n == 4 and torch.equal(lean[:n], full[:n]) and torch.equal(whole, full))
+    return out, chk
+
+
+def _assert_checks(chk: dict) -> None:
+    for name, value in chk.items():
+        if isinstance(value, bool):
+            assert value, name
+    assert chk["absorb_mma max |err| vs fp32 einsum"] < 0.05
+    assert max(chk["hc: max |out|, |post|, |comb| mma vs switch off"]) < 1e-3
+    for kind in ("bf16", "fp8"):
+        assert chk[f"onepass_{kind}: max |onepass - torch softmax reference|"] < 0.05
+
+
+@pytest.mark.skipif(os.environ.get("TRITON_INTERPRET") != "1", reason="the Triton interpreter (TRITON_INTERPRET=1)")
+def test_interpreter_digests_equal_mia(monkeypatch):
+    with bf16_dot():
+        got, chk = cases("cpu", True, lambda k, v: monkeypatch.setenv(k, v))
+    want = json.loads(DIGESTS.read_text())["digests"]
+    assert got == want
+    _assert_checks(chk)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs a GPU")
+def test_cuda_same_bits(monkeypatch):
+    _, chk = cases("cuda", True, lambda k, v: monkeypatch.setenv(k, v))
+    _assert_checks(chk)
