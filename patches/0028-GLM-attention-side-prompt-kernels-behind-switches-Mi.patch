+"""MiaAI-Lab recipe patches 0004-glm-prompt-kernels, 0009-glm-prefill-kernels and 0028's prompt dense blocks
+(recipe 1576746, her tree d747563), each behind its own switch, default off.
+
+- Switches unset: every helper says so and the paths are the base's (TF_GLM_LATENT_MMA, TF_GLM_HC_MMA,
+  TF_GLM_SEQ_ROWS, TF_GLM_SPARSE_ONEPASS, TF_GLM_PROMPT_DSA).
+- ``cases``: the ported kernels on seeded inputs, digests and this port's same-bits checks. Under the Triton
+  interpreter (TRITON_INTERPRET=1) the digests equal her tree's (tests/data/glm_attn_prompt_mia_digests.json, made by
+  running these cases on her tree d747563 with the same inputs); on a GPU the same-bits checks must hold.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import json
+import os
+from pathlib import Path
+
+import pytest
+import torch
+
+from tensorfold.families.glm5_next.cuda import forward, glue, kv8, latent, qmm, sparse
+
+SWITCHES = ("TF_GLM_LATENT_MMA", "TF_GLM_HC_MMA", "TF_GLM_SEQ_ROWS", "TF_GLM_SPARSE_ONEPASS", "TF_GLM_PROMPT_DSA")
+ON = {"TF_GLM_LATENT_MMA": "1", "TF_GLM_HC_MMA": "1", "TF_GLM_SEQ_ROWS": "16", "TF_GLM_SPARSE_ONEPASS": "1",
+      "TF_GLM_PROMPT_DSA": "1", "TF_GLM_SCORE_RB": "4"}
+DIGESTS = Path(__file__).parent / "data" / "glm_attn_prompt_mia_digests.json"
+
+
+def test_switches_default_off(monkeypatch):
+    for name in (*SWITCHES, "TF_GLM_SCORE_RB"):
+        monkeypatch.delenv(name, raising=False)
+    assert not latent.prompt_mma() and not glue.hc_mma() and not latent.sparse_onepass_on()
+    assert not sparse.prompt_dsa() and qmm.seq_rows() is None
+    assert qmm._prompt_cfg(4, 2048, 4096, 4096) is None and not qmm._seq(4, 2048, 4096, 1024)
+    assert sparse.score_rows() == 4
+    for name in SWITCHES:
+        monkeypatch.setenv(name, "0")
+    assert not (latent.prompt_mma() or glue.hc_mma() or latent.sparse_onepass_on() or sparse.prompt_dsa())
+    assert qmm.seq_rows() is None
+
+
+def test_switches_on(monkeypatch):
+    for name, value in ON.items():
+        monkeypatch.setenv(name, value)
+    assert latent.prompt_mma() and glue.hc_mma() and latent.sparse_onepass_on() and sparse.prompt_dsa()
+    assert qmm.seq_rows() == 16
+    # her table and default tiles (MiaAI-Lab 0004): SEQ only with split K, from SEQ_ROWS rows
+    assert qmm._prompt_cfg(4, 2048, 4096, 1024) == (64, 128, 8, 3, True)
+    assert qmm._prompt_cfg(4, 8, 4096, 1024) is None
+    assert qmm._prompt_cfg(4, 2048, 777, 1024) == (64, 128, 8, 3, True)
+    assert qmm._prompt_cfg(4, 2048, 288, 1024) == (64, 128, 8, 3, False)       # narrow: no SEQ
+    monkeypatch.setenv("TF_GLM_SEQ_ROWS", "lots")
+    with pytest.raises(ValueError):
+        qmm.seq_rows()
+    monkeypatch.setenv("TF_GLM_SCORE_RB", "3")
+    with pytest.raises(ValueError):
+        sparse.score_rows()
+
+
+def test_dense_rows_and_pool_count():
+    class C:
+        dense_limit = sparse.SPARSE_FROM
+
+    class Other:
+        dense_limit = 2048
+
+    assert sparse.SPARSE_FROM == 2051
+    assert forward.dense_rows(C, 6, 2047) == 4              # rows 2047 .. 2050 dense, 2051 and 2052 sparse
+    assert forward.dense_rows(C, 2048, 0) == 2048 and forward.dense_rows(C, 2048, 1024) == 1027
+    assert forward.dense_rows(C, 512, 4096) == 0 and forward.dense_rows(C, 8, None) == 8
+    assert forward.dense_rows(Other, 8, 2047) == 8
+    assert sparse.pool_count(2045, 8, 1024) == 1024 and sparse.pool_bucket(2045, 8, 1024) == 1024
+    assert sparse.pool_count(8400, 8, 4096) == 3072 and sparse.pool_bucket(8400, 8, 4096) == 4096
+    assert sparse.pool_count(8400, 8, 2048) == 2048
+
+
+# -- the kernels' cases (also run on her tree d747563 for the digests: only names both trees have) --
+def _digest(*ts: torch.Tensor) -> str:
+    h = hashlib.sha256()
+    for t in ts:
+        h.update(t.detach().cpu().contiguous().view(torch.uint8).numpy().tobytes())
+    return h.hexdigest()[:24]
+
+
+def _randn(shape, seed, scale=1.0, dtype=torch.bfloat16, device="cpu"):
+    return (torch.randn(shape, generator=torch.Generator().manual_seed(seed)) * scale).to(dtype).to(device)
+
+
+def _f8(w: torch.Tensor):
+    n, k = w.shape
+    blocks = w.float().view(n, k // 128, 128)
+    s = blocks.abs().amax(-1).clamp_min(1e-8) / 448.0
+    wq = (blocks / s[..., None]).view(n, k).to(torch.float8_e4m3fn)
+    return qmm.F8(weight=wq.contiguous(), scale=s.contiguous(), n=n, k=k)
+
+
+@contextlib.contextmanager
+def bf16_dot():
+    """Triton 3.8.0's interpreter multiplies bf16 dot operands as their raw uint16 storage (it widens only fp8):
+    widen them to fp32 (exact) for the duration, so the interpreter's numbers are real ones."""
+    import numpy as np
+    import triton.language as tl
+    from triton.runtime import interpreter as ti
+
+    builder = next(c for c in vars(ti).values() if isinstance(c, type) and "create_dot" in vars(c))
+    dot = builder.create_dot
+
+    def wide(h):
+        if h.dtype == tl.bfloat16:
+            return ti.TensorHandle((h.data.astype(np.uint32) << 16).view(np.float32), tl.float32)
+        return h
+
+    builder.create_dot = lambda self, a, b, d, ip, mx: dot(self, wide(a), wide(b), d, ip, mx)
+    try:
+        yield
+    finally:
+        builder.create_dot = dot
+
+
