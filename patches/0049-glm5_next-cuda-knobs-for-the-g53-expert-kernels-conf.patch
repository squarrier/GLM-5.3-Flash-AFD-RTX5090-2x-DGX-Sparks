+"""The g53 configuration knobs and which configuration fields can change a bit (TF_GLM_EXPERT_KERNEL=g53's
+TF_GLM_EXPERT_KERNEL_MT, _GW, _NT, _L2, _FUSE, _DISCARD, _SK, _SKD, _SWIGLU; expert prompt kernels from glm53f-afd,
+written by Hugh Madden (@dangerm00se, github.com/hughmadden), glm53f-afd @ 91db3cc, MIT, Copyright (c) 2026 Turquoise
+Bay AI Pty Ltd). CPU only:
+
+- unset, nothing changes: switch() gives the settings it gave before, every window runs default_cfg, and the node
+  calls routed() as before (no configuration passed, no new buffer, the same startup line);
+- each knob sets its field and only its field, for every window size; bad values refuse; the knobs are read only
+  under TF_GLM_EXPERT_KERNEL=g53; set, the node passes the configuration on every window, says so on its line and
+  claims any buffer K splits need at its start;
+- tests/glm_g53_schedule.py, an emulation of the kernels' work decomposition: the schedule fields (rows per group,
+  warps, down chunks, L2 policy, fusion, discard, row rotation, group order, the plan's order within an expert, the
+  order the items are taken in) give the default's bits; sk, skd and the SwiGLU precision give other bits, the same
+  under every schedule; a row's bits do not depend on its window under any configuration.
+
+The GPU test (tests/cuda/test_glm_g53_kernel.py) checks the CUDA kernels' bits for the same schedules.
+"""
+
+from __future__ import annotations
+
+from dataclasses import fields as dc_fields
+from dataclasses import replace
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from tensorfold.families.glm5_next.cuda import g53_experts
+from tests import glm_g53_schedule as sched
+from tests.test_glm_g53_kernel import _layer, _node
+
+KNOBS = {field: name for field, (name, _) in g53_experts.SCHEDULE_ENVS.items()}
+ENVS = (g53_experts.ENV, g53_experts.ROWS_ENV, g53_experts.ROWROT_ENV, g53_experts.ORDER_ENV, *KNOBS.values())
+SIZES = (1, 2, 7, 63, 64, 65, 594, 2047, 2048, 2049, 4095, 4096)
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    for k in ENVS:
+        monkeypatch.delenv(k, raising=False)
+
+
+# ------------------------------------------------------------------------------------------------------- the knobs
+
+def test_names_and_classes():
+    assert KNOBS == {"mt": "TF_GLM_EXPERT_KERNEL_MT", "gw": "TF_GLM_EXPERT_KERNEL_GW", "nt": "TF_GLM_EXPERT_KERNEL_NT",
+                     "l2": "TF_GLM_EXPERT_KERNEL_L2", "fuse": "TF_GLM_EXPERT_KERNEL_FUSE",
+                     "discard": "TF_GLM_EXPERT_KERNEL_DISCARD", "sk": "TF_GLM_EXPERT_KERNEL_SK",
+                     "skd": "TF_GLM_EXPERT_KERNEL_SKD", "swiglu": "TF_GLM_EXPERT_KERNEL_SWIGLU"}
+    assert g53_experts.BIT_FIELDS == ("sk", "skd", "swiglu")
+    cfg_fields = {f.name for f in dc_fields(g53_experts.Cfg)}
+    assert set(KNOBS) == cfg_fields - {"rot", "gord"}         # rot and gord: TF_GLM_EXPERT_KERNEL_ROWROT / _ORDER
+    # the values g53_rank.cpp accepts (sk and skd: those whose sums fit the node's prompt scratch or a start buffer)
+    assert {f: ok for f, (_, ok) in g53_experts.SCHEDULE_ENVS.items()} == {
+        "mt": (2, 4), "gw": (8, 16), "nt": (1, 2, 4), "l2": (1, 2), "fuse": (1, 2), "discard": (1, 2),
+        "sk": (1, 2, 4), "skd": (1, 2, 4), "swiglu": (0, 1)}
+
+
+def test_unset_knobs_are_the_settings_and_configurations_before(monkeypatch):
+    monkeypatch.setenv(g53_experts.ENV, "g53")
+    assert g53_experts.schedule() == {}
+    assert g53_experts.switch() == {"min_rows": 1, "rowrot": True, "order": False}      # no "schedule" key
+    for R in range(1, g53_experts.MAX_ROWS + 1):
+        for rowrot, order in ((True, False), (False, True)):
+            want = g53_experts.default_cfg(R, rowrot=rowrot, order=order)
+            assert g53_experts.tuned_cfg(R, rowrot=rowrot, order=order) == want
+            assert g53_experts.tuned_cfg(R, rowrot=rowrot, order=order, fields={}) == want
+    for k in KNOBS.values():                                    # empty is unset
+        monkeypatch.setenv(k, " ")
+    assert g53_experts.switch() == {"min_rows": 1, "rowrot": True, "order": False}
+
+
+def test_each_knob_sets_its_field_and_only_its_field_for_every_window(monkeypatch):
+    monkeypatch.setenv(g53_experts.ENV, "g53")
+    names = [f.name for f in dc_fields(g53_experts.Cfg)]
+    for field, (name, ok) in g53_experts.SCHEDULE_ENVS.items():
+        for v in ok:
+            monkeypatch.setenv(name, f" {v} ")
+            s = g53_experts.switch()
+            assert s == {"min_rows": 1, "rowrot": True, "order": False, "schedule": {field: v}}
+            for R in SIZES:
+                d, c = g53_experts.default_cfg(R), g53_experts.tuned_cfg(R, fields=s["schedule"])
+                assert getattr(c, field) == v
+                assert all(getattr(c, f) == getattr(d, f) for f in names if f != field), (field, v, R)
+        monkeypatch.delenv(name)
+    for field, v in (("mt", 4), ("gw", 16), ("nt", 2), ("l2", 1)):     # several at once: a sweep line
+        monkeypatch.setenv(KNOBS[field], str(v))
+    got = g53_experts.switch()["schedule"]
+    assert got == {"mt": 4, "gw": 16, "nt": 2, "l2": 1}
+    for R in SIZES:
+        assert g53_experts.tuned_cfg(R, fields=got) == replace(g53_experts.default_cfg(R), mt=4, gw=16, nt=2, l2=1)
+
+
+def test_bad_knob_values_refuse(monkeypatch):
+    monkeypatch.setenv(g53_experts.ENV, "g53")
+    for field, bad in (("mt", "3"), ("mt", "x"), ("mt", "4.0"), ("gw", "12"), ("nt", "8"), ("nt", "0"), ("l2", "0"),
+                       ("fuse", "3"), ("discard", "0"), ("sk", "8"), ("sk", "3"), ("skd", "8"), ("swiglu", "2"),
+                       ("swiglu", "bf16")):
+        monkeypatch.setenv(KNOBS[field], bad)
+        with pytest.raises(ValueError, match=KNOBS[field]):
+            g53_experts.switch()
+        monkeypatch.delenv(KNOBS[field])
+
+
+def test_knobs_are_read_only_under_the_switch(monkeypatch):
+    monkeypatch.setenv(KNOBS["mt"], "3")                     # a bad value, but TensorFold's kernels run every window
+    assert g53_experts.switch() is None
+    monkeypatch.setenv(g53_experts.ENV, "tf")
+    assert g53_experts.switch() is None
+
+
+def test_every_window_keeps_one_set_of_bit_fields(monkeypatch):
+    """Set or not, the knobs give every window size the same sk, skd and SwiGLU precision, the only fields that change
+    a bit: a prompt row's bits never depend on its window."""
+
+    for fields in ({}, {"mt": 4, "gw": 16}, {"mt": 2, "nt": 4, "l2": 1}, {"sk": 2}, {"skd": 4}, {"swiglu": 1},
+                   {"sk": 4, "skd": 2, "nt": 1}):
+        bits = {(c.sk, c.skd, c.swiglu) for R in range(1, g53_experts.MAX_ROWS + 1)
+                for c in (g53_experts.tuned_cfg(R, fields=fields),
+                          g53_experts.tuned_cfg(R, rowrot=False, order=True, fields=fields))}
+        assert len(bits) == 1, fields
+
+
+# ---------------------------------------------------------------------------------------------------------- the node
+
+def test_node_calls_routed_as_before_without_knobs_and_with_the_configuration_with(monkeypatch):
+    seen = []
+    monkeypatch.setattr(g53_experts, "routed", lambda x, pick, wts, ex, s, out, R, limit, *a, **k: seen.append(
+        (R, a, k)) or out[:R])
+    _, node = _node(monkeypatch)
+    h = g53_experts.Node(node, {"min_rows": 1, "rowrot": True, "order": False})
+    for R in (1, 6, 70, 256):
+        h.compute(3, R)
+    assert seen == [(R, (), {"rowrot": True, "order": False}) for R in (1, 6, 70, 256)]     # the call before
+    assert h.fields == {} and h.scratch._own is None
+    seen.clear()
+    fields = {"mt": 4, "gw": 16, "nt": 2}
+    h = g53_experts.Node(node, {"min_rows": 1, "rowrot": True, "order": True, "schedule": fields})
+    for R in (1, 70, 256):
+        h.compute(3, R)
+    assert seen == [(R, (g53_experts.tuned_cfg(R, rowrot=True, order=True, fields=fields),), {}) for R in (1, 70, 256)]
+    assert h.config(256) == replace(g53_experts.default_cfg(256, rowrot=True, order=True), mt=4, gw=16, nt=2)
+    assert h.scratch._own is None                          # the schedule fits the node's prompt scratch
+
+
+def _expert_node(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    cfg = SimpleNamespace(hidden=4096, top_k=8, moe_width=2048, experts=288, limit=10.0)
+    monkeypatch.setattr(experts_node.Config, "read", staticmethod(lambda _d: cfg))
+    monkeypatch.setattr(experts_node, "load_half", lambda _d, _h, layers, device="cuda": [_layer() for _ in layers])
+    real = experts_node.ExpertBuffers
+
+    def cpu_buffers(c, rows, prefill_rows, device):
+        return real(c, rows=rows, prefill_rows=prefill_rows, device="cpu")
+
+    monkeypatch.setattr(experts_node, "ExpertBuffers", cpu_buffers)
+    return lambda: experts_node.ExpertNode("/nowhere", 1, [3, 4], prefill_rows=256)
+
+
+def test_node_line_unchanged_without_knobs_and_with_the_schedule_with(monkeypatch, capsys):
+    make = _expert_node(monkeypatch)
+    monkeypatch.setenv(g53_experts.ENV, "g53")
+    node = make()
+    line = capsys.readouterr().out.strip().splitlines()[-1]
+    assert line.endswith("rowrot on (0 layers share one gate/up suh), order off); 2 of 2 MoE layers in scope")
+    assert node.g53.fields == {} and node.g53.scratch._own is None
+    monkeypatch.setenv(KNOBS["mt"], "4")
+    monkeypatch.setenv(KNOBS["gw"], "16")
+    node = make()
+    line = capsys.readouterr().out.strip().splitlines()[-1]
+    assert line.endswith("2 of 2 MoE layers in scope; schedule mt 4 gw 16 for every window (the same bits)")
+    assert node.g53.fields == {"mt": 4, "gw": 16} and node.g53.scratch._own is None
+    monkeypatch.setenv(KNOBS["skd"], "2")                   # down K splits: past the prompt scratch, a start buffer
+    node = make()
+    line = capsys.readouterr().out.strip().splitlines()[-1]
+    own = node.g53.scratch._own
+    P = 256 * 8
+    assert own is not None and own[0].numel() >= 2 * P * 1024 + 2 * P * 4096
+    mib = sum(t.numel() * t.element_size() for t in own) >> 20
+    assert line.endswith(f"; schedule mt 4 gw 16 skd 2 for every window (skd: outputs change; {mib} MiB own scratch)")
+    z, _xd, zd, _xh = node.g53.scratch.big(256, node.g53.config(256))   # the start buffer serves the widest window
+    assert node.g53.scratch._own is own and zd.data_ptr() == own[0][z.numel():].data_ptr()
+
+
+# ---------------------------------------------------------------------------- the emulated decomposition (CPU digests)
+
+D = sched.Dims()
+SAME_BITS = ({"mt": 4, "gw": 16}, {"mt": 4, "gw": 16, "nt": 2}, {"mt": 4, "gw": 16, "nt": 4, "l2": 1}, {"mt": 4},
+             {"gw": 16}, {"nt": 1}, {"nt": 4}, {"gw": 16, "nt": 1}, {"l2": 1}, {"fuse": 1}, {"discard": 1},
+             {"gord": 2}, {"rot": 1}, {"mt": 4, "gw": 16, "nt": 2, "gord": 2})
+CHANGED_BITS = ({"sk": 2}, {"sk": 4}, {"skd": 2}, {"skd": 4}, {"swiglu": 1})
+
+
+@pytest.fixture(scope="module")
+def case():
+    rng = np.random.default_rng(53)
+    L = sched.layer(D, rng, shared=True)
+    x, pick, w = sched.inputs(D, 80, rng)
+    want = sched.ffn(D, L, x, pick, w, sched.base_cfg())
+    assert np.isfinite(want).all()
+    counts = np.bincount(pick.reshape(-1), minlength=D.E)
+    assert counts.max() > 64 and (counts > 32).sum() >= 2 and (counts <= 32).sum() >= 2   # 1-3 groups an expert
+    return SimpleNamespace(L=L, x=x, pick=pick, w=w, want=want)
+
+
+def test_emulated_schedule_fields_keep_every_bit(case):
+    want = sched.digest(case.want)
+    for i, kw in enumerate(SAME_BITS):
+        got = sched.ffn(D, case.L, case.x, case.pick, case.w, sched.base_cfg(**kw), seed=i % 3 or None)
+        assert sched.digest(got) == want, kw
+    again = sched.ffn(D, case.L, case.x, case.pick, case.w, sched.base_cfg(), seed=7)   # plan and item order shuffled
+    assert sched.digest(again) == want
+
+
+def test_emulated_bit_fields_change_bits_the_same_under_every_schedule(case):
+    want = sched.digest(case.want)
+    for bits in CHANGED_BITS:
+        a = sched.ffn(D, case.L, case.x, case.pick, case.w, sched.base_cfg(**bits))
+        assert np.isfinite(a).all() and sched.digest(a) != want, bits
+        b = sched.ffn(D, case.L, case.x, case.pick, case.w, sched.base_cfg(**bits, mt=4, gw=16, nt=4, l2=1, fuse=1,
+                                                                             gord=2), seed=5)
+        assert sched.digest(b) == sched.digest(a), bits
+
+
+def test_emulated_rows_bits_whatever_their_window(case):
+    for kw in ({}, {"mt": 4, "gw": 16, "nt": 2}, {"sk": 2, "skd": 2}):
+        full = sched.ffn(D, case.L, case.x, case.pick, case.w, sched.base_cfg(**kw))
+        for lo, hi in ((0, 1), (1, 9), (9, 80)):
+            cfg = dict(kw)
+            if hi - lo > 20:                           # the widest part under another schedule as well
+                cfg.update(mt=4, gw=16)
+            part = sched.ffn(D, case.L, case.x[lo:hi], case.pick[lo:hi], case.w[lo:hi], sched.base_cfg(**cfg), seed=lo)
+            assert sched.digest(part) == sched.digest(full[lo:hi]), (kw, lo, hi)
+
+
+def test_emulation_sees_a_changed_sum_order(case, monkeypatch):
+    """A negative control: the digests do see an order change. The k tiles of every MMA chain in descending order
+    (a schedule that reorders a sum) give other bits."""
+
+    real = sched._mma_chain
+    monkeypatch.setattr(sched, "_mma_chain", lambda acc, a, b, k_tiles: real(acc, a, b, list(k_tiles)[::-1]))
+    got = sched.ffn(D, case.L, case.x, case.pick, case.w, sched.base_cfg())
+    assert np.isfinite(got).all() and sched.digest(got) != sched.digest(case.want)
+
