diff --git a/src/tensorfold/families/glm5_next/cuda/g53_experts.py b/src/tensorfold/families/glm5_next/cuda/g53_experts.py
index bb5b8cb..4041fae 100644
--- a/src/tensorfold/families/glm5_next/cuda/g53_experts.py
+++ b/src/tensorfold/families/glm5_next/cuda/g53_experts.py
@@ -31,13 +31,18 @@ skd 1: one FP32 MMA chain a sum over ascending k tiles; its fused epilogue; the
 acc + w * (y * 1/sqrt(128) * svh), built with --fmad=false), not the grouped kernel's split-K sums and combine. The
 rotation and order schedules, the rows per group, the tilings and the row count keep every bit (glm53f-rank's own
 statement). It never becomes a default by itself.
+
+The schedule (TF_GLM_EXPERT_KERNEL_MT, _GW, _NT, _L2, _FUSE, _DISCARD; each unset: default_cfg's value for the window,
+as before): one value for every window, so a launch shape can be tuned for the GPU the experts run on. These fields
+keep every bit. TF_GLM_EXPERT_KERNEL_SK, _SKD and _SWIGLU (the K splits and the SwiGLU precision) change outputs; set,
+they too apply to every window, so a prompt row's bits still never depend on its window.
 """
 
 from __future__ import annotations
 
 import math
 import os
-from dataclasses import dataclass
+from dataclasses import dataclass, replace
 from functools import lru_cache
 from pathlib import Path
 
@@ -52,6 +57,19 @@ MIN_ROWS = 1             # every prompt window takes the large-M kernels here: a
 MAX_ROWS = 4096          # glm53f-rank's MAX_ROWS (a wire lane's cap)
 H, WID, E, TOPK = 4096, 1024, 288, 8
 NVCC = ["-O3", "--fmad=false", "--ftz=false", "--prec-div=true"]   # glm53f-rank's build.rs flags (arch from build)
+# One knob a configuration field (the values g53_rank.cpp accepts); unset: default_cfg's value for the window.
+SCHEDULE_ENVS = {
+    "mt": ("TF_GLM_EXPERT_KERNEL_MT", (2, 4)),               # 16-row tiles a group: 32- or 64-row groups
+    "gw": ("TF_GLM_EXPERT_KERNEL_GW", (8, 16)),              # gate/up MMA warps a block
+    "nt": ("TF_GLM_EXPERT_KERNEL_NT", (1, 2, 4)),            # down: 16-column tiles a warp (128 nt-column chunks)
+    "l2": ("TF_GLM_EXPERT_KERNEL_L2", (1, 2)),               # 2: trellis words loaded evict-first
+    "fuse": ("TF_GLM_EXPERT_KERNEL_FUSE", (1, 2)),           # 2: the epilogue and the reduce fused
+    "discard": ("TF_GLM_EXPERT_KERNEL_DISCARD", (1, 2)),     # 2: consumed partial sums dropped from L2 (fused only)
+    "sk": ("TF_GLM_EXPERT_KERNEL_SK", (1, 2, 4)),            # gate/up K splits (outputs change)
+    "skd": ("TF_GLM_EXPERT_KERNEL_SKD", (1, 2, 4)),          # down K splits (outputs change)
+    "swiglu": ("TF_GLM_EXPERT_KERNEL_SWIGLU", (0, 1)),       # 1: FP32 SwiGLU (outputs change)
+}
+BIT_FIELDS = ("sk", "skd", "swiglu")   # the only fields that change a bit (glm53f-rank's own statement)
 
 
 @lru_cache(maxsize=1)
@@ -96,6 +114,14 @@ def default_cfg(rows: int, *, rowrot: bool = True, order: bool = False) -> Cfg:
     return Cfg(mt=4, sk=1, skd=1, nt=4, gw=16, l2=1, fuse=2, discard=2, swiglu=0, rot=rot, gord=gord)
 
 
+def tuned_cfg(rows: int, *, rowrot: bool = True, order: bool = False, fields: dict | None = None) -> Cfg:
+    """default_cfg(rows) with ``fields`` (``schedule()``'s: the knobs set) over it, the same values for every window
+    size. No fields: default_cfg itself."""
+
+    c = default_cfg(rows, rowrot=rowrot, order=order)
+    return replace(c, **fields) if fields else c
+
+
 def _flag(name: str, default: bool) -> bool:
     v = os.environ.get(name, "").strip()
     if v == "":
@@ -105,11 +131,32 @@ def _flag(name: str, default: bool) -> bool:
     return v == "1"
 
 
+def schedule() -> dict:
+    """The configuration knobs set (SCHEDULE_ENVS: TF_GLM_EXPERT_KERNEL_MT, _GW, _NT, _L2, _FUSE, _DISCARD, _SK, _SKD,
+    _SWIGLU), as {field: value}; empty when none is (every window then runs default_cfg, as before). Bad values
+    refuse."""
+
+    got = {}
+    for field, (name, ok) in SCHEDULE_ENVS.items():
+        v = os.environ.get(name, "").strip()
+        if v == "":
+            continue
+        try:
+            n = int(v)
+        except ValueError:
+            n = None
+        if n not in ok:
+            raise ValueError(f"{name} is one of {', '.join(map(str, ok))}, not {v!r}")
+        got[field] = n
+    return got
+
+
 def switch() -> dict | None:
     """TF_GLM_EXPERT_KERNEL, read once at the node's start: None (unset, empty or ``tf``: TensorFold's kernels) or the
     settings of ``g53``: min_rows (TF_GLM_EXPERT_KERNEL_ROWS, 1..4,096, default 1: every prompt window; above 1 the
     smaller windows stay on TensorFold's kernels and a prompt row's bits depend on its window), rowrot
-    (TF_GLM_EXPERT_KERNEL_ROWROT, default 1) and order (TF_GLM_EXPERT_KERNEL_ORDER, default 0). Bad values refuse."""
+    (TF_GLM_EXPERT_KERNEL_ROWROT, default 1) and order (TF_GLM_EXPERT_KERNEL_ORDER, default 0), plus ``schedule``
+    (``schedule()``'s fields) when a configuration knob is set. Bad values refuse."""
 
     v = os.environ.get(ENV, "").strip().lower()
     if v in ("", "tf"):
@@ -125,7 +172,11 @@ def switch() -> dict | None:
     if not MIN_ROWS <= rows <= MAX_ROWS:
         raise ValueError(f"{ROWS_ENV}: {MIN_ROWS}..{MAX_ROWS} (the smallest prompt window through the kernels), "
                          f"not {rows}")
-    return {"min_rows": rows, "rowrot": _flag(ROWROT_ENV, True), "order": _flag(ORDER_ENV, False)}
+    got = {"min_rows": rows, "rowrot": _flag(ROWROT_ENV, True), "order": _flag(ORDER_ENV, False)}
+    fields = schedule()
+    if fields:
+        got["schedule"] = fields
+    return got
 
 
 def layer_ready(ex) -> str | None:
@@ -243,9 +294,12 @@ class Node:
         b = node.buf
         self.node, self.min_rows = node, int(settings["min_rows"])
         self.rowrot, self.order = bool(settings["rowrot"]), bool(settings["order"])
+        self.fields = dict(settings.get("schedule") or {})   # the configuration knobs set: none, default_cfg's
         self.max_rows = min(MAX_ROWS, b.prefill_rows)
         self.ready = {i: layer_ready(ex) is None for i, ex in node.by_layer.items()}
         self.scratch = Scratch(self.max_rows, b.routed.device, share=getattr(b, "pref", None))
+        if self.fields:                 # K splits past the prompt scratch's room: the owned buffers now, not in a window
+            self.scratch.big(self.max_rows, self.config(self.max_rows))
         if any(self.ready.values()) and b.routed.is_cuda:
             _ext()                  # loaded (prebuilt: tools/prebuild_ext.py) at the start, not in a prompt forward
         shared = sum(1 for i, ok in self.ready.items()
@@ -253,11 +307,24 @@ class Node:
         floor = ("every prompt window: a row's bits whatever its window" if self.min_rows <= MIN_ROWS else
                  f"{ROWS_ENV}={self.min_rows}: windows under {self.min_rows} rows stay on TensorFold's kernels, so a "
                  f"prompt row's bits depend on its window")
+        tuned = ""
+        if self.fields:
+            bits = [f for f in BIT_FIELDS if f in self.fields]
+            own = self.scratch._own
+            tuned = (f"; schedule {' '.join(f'{k} {v}' for k, v in self.fields.items())} for every window ("
+                     + (f"{', '.join(bits)}: outputs change" if bits else "the same bits")
+                     + (f"; {sum(t.numel() * t.element_size() for t in own) >> 20} MiB own scratch" if own else "")
+                     + ")")
         print(f"[tensorfold] afd expert {node.half + 1}: {ENV}=g53: prompt chunks of {self.min_rows}-{self.max_rows} "
               f"rows through glm53f-afd's large-M expert kernels (Hugh Madden; outputs class; {floor}; rowrot "
               f"{'on' if self.rowrot else 'off'} ({shared} layers share one gate/up suh), order "
-              f"{'on' if self.order else 'off'}); {sum(self.ready.values())} of {len(self.ready)} MoE layers in scope",
-              flush=True)
+              f"{'on' if self.order else 'off'}); {sum(self.ready.values())} of {len(self.ready)} MoE layers in scope"
+              f"{tuned}", flush=True)
+
+    def config(self, R: int) -> Cfg:
+        """The configuration a window of R rows runs: default_cfg with the knobs set over it."""
+
+        return tuned_cfg(R, rowrot=self.rowrot, order=self.order, fields=self.fields)
 
     def takes(self, layer_i: int, R: int, prompt: bool) -> bool:
         """A prompt chunk's window (``prompt``: the node's MODE_CHUNK, MODE_SLICE, MODE_PAIR and MODE_LANES forwards)
@@ -274,5 +341,8 @@ class Node:
         b = self.node.buf
         normed, pick, wts = x if x is not None else (b.normed[:R], b.pick[:R], b.wts[:R])
         dst = b.routed[:R] if out is None else out
+        if self.fields:                 # a configuration knob set: that configuration for every window
+            return routed(normed, pick, wts, self.node.by_layer[layer_i], self.scratch, dst, R, self.node.cfg.limit,
+                          self.config(R))
         return routed(normed, pick, wts, self.node.by_layer[layer_i], self.scratch, dst, R, self.node.cfg.limit,
                       rowrot=self.rowrot, order=self.order)
