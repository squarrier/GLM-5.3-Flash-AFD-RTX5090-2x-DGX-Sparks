+def test_emulated_group_order_interleaves_single_and_multi_group_experts():
+    groups = [(0, 0, 32), (0, 32, 32), (0, 64, 5), (1, 69, 7), (2, 76, 20), (3, 96, 32), (3, 128, 1), (4, 129, 3)]
+    order = sched.group_order(groups)          # heavy (an expert with several groups): 0, 1, 2, 5, 6; light: 3, 4, 7
+    assert order == [0, 3, 1, 2, 4, 5, 7, 6]   # order_kernel: heavy h at (2h + 1) / 2nh, light l at (2l + 1) / 2nl
