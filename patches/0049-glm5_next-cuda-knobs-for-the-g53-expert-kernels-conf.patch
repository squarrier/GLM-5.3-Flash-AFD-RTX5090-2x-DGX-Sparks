+
+
+# ------------------------------------------------------------------- the configuration knobs' schedules (same bits)
+
+TUNE = ({"mt": 4, "gw": 16}, {"mt": 4, "gw": 16, "nt": 2}, {"mt": 4, "gw": 16, "nt": 4, "l2": 1},
+        {"mt": 4, "gw": 16, "nt": 2, "l2": 1}, {"mt": 4, "gw": 16, "nt": 2, "gord": 2}, {"gord": 2}, {"l2": 1},
+        {"nt": 1}, {"nt": 4}, {"gw": 16, "nt": 1}, {"fuse": 1}, {"discard": 1})
+
+
+def _label(kw: dict) -> str:
+    return " ".join(f"{k} {v}" for k, v in kw.items()) or "default"
+
+
+@pytest.mark.parametrize("R", [256, 1024, 2048])
+@pytest.mark.parametrize("kind", ["uniform", "skewed"])
+def test_tuned_schedules_keep_every_bit(layer, R, kind):
+    """The schedules the configuration knobs (TF_GLM_EXPERT_KERNEL_MT, _GW, _NT, _L2, _FUSE, _DISCARD) and
+    TF_GLM_EXPERT_KERNEL_ORDER can give a prompt chunk's window: the default's bytes."""
+
+    _, ex = layer
+    inp = _inputs(R, kind, 77 + R)
+    want = _ours(ex, inp, _cfg(R))
+    for kw in TUNE:
+        assert _bits_equal(_ours(ex, inp, _cfg(R, **kw)), want), (R, kind, kw)
+
+
+def test_tuned_times_report(layer):
+    """Information (TF_G53_TUNE_TIMES: a JSON file to write them to): ms a call for the default and each schedule of
+    TUNE at 256-2,048 rows, uniform and skewed routing."""
+
+    from tensorfold.families.glm5_next.cuda import g53_experts
+
+    name, ex = layer
+    res = {}
+    for R in (256, 512, 1024, 2048):
+        for kind in ("uniform", "skewed"):
+            inp = _inputs(R, kind, 61 + R)
+            s = _scratch(R)
+            out = torch.empty((R, D), dtype=torch.float32, device="cuda")
+            row = {}
+            for kw in ({}, *TUNE):
+                cfg = _cfg(R, **kw)
+
+                def call(inp=inp, s=s, out=out, R=R, cfg=cfg):
+                    g53_experts.routed(inp.x, inp.pick, inp.wts, ex, s, out, R, LIMIT, cfg)
+
+                row[_label(kw)] = _time(call, n=20)
+            res[f"{name} R{R} {kind}"] = row
+            print(f"[tune times, ms a call] {name} R{R} {kind}: {row}")
+    path = os.environ.get("TF_G53_TUNE_TIMES")
+    if path:
+        old = json.loads(Path(path).read_text()) if Path(path).exists() else {}
+        old.update(res)
+        Path(path).write_text(json.dumps(old, indent=1))
diff --git a/tests/glm_g53_schedule.py b/tests/glm_g53_schedule.py
new file mode 100644
index 0000000..90149bb
--- /dev/null
+++ b/tests/glm_g53_schedule.py
@@ -0,0 +1,302 @@
+"""A CPU emulation of g53_rank.cu's work decomposition, for tests/test_glm_g53_schedule.py (expert prompt kernels from
+glm53f-afd, written by Hugh Madden (@dangerm00se, github.com/hughmadden), glm53f-afd @ 91db3cc, MIT, Copyright (c)
+2026 Turquoise Bay AI Pty Ltd; ported in families/glm5_next/cuda/g53_rank.cu).
+
+It runs a call the way the kernels split it, at reduced sizes (``Dims``; the kernels' own are H 4,096, WID 1,024,
+512-column blocks, 288 experts), with every index formula of g53_rank.cu:
+- the plan: an expert's pairs in ascending expert order, in an arbitrary order within the expert (the kernel's
+  atomics), cut into groups of 16 mt pairs; the group order (gord 2: order_kernel's interleave of single- and
+  multi-group experts);
+- gate/up items (matrix, column block, group, K split) taken in any order (persistent blocks and their item
+  counter); in an item, warp w of gw owns n tiles cb * TPB + w * NT .. + NT (NT = TPB / gw), m tiles past the group's
+  rows are predicated off and rows past its pairs are zero and never stored; one MMA chain a sum over the split's k
+  tiles in ascending order; the row rotation once a row (rot 2) or per (row, matrix) (rot 1);
+- the epilogue fused (the last of a group's 2 CB sk items runs it for the group's pairs) or as its own pass, the K
+  splits summed in order from 0;
+- down items (group, chunk of 128 nt columns, K split) in any order, 8 warps of nt n tiles each, the K split's k tiles
+  ascending;
+- the reduce fused (the item that brings a (row, chunk) to its 8 skd arrivals reduces it) or as its own pass, slots in
+  order, splits in order;
+- discard (fused only): every partial-sum line a fused epilogue or reduce consumed is poisoned (NaN) at once, so a
+  later read would show in the output; l2 changes no value (a cache policy).
+
+Every product and sum is the reference's (tests/glm_g53_reference.py): fwht128, the BF16 roundings, FP32 sums in the
+kernels' order. An m16n8k16 MMA is modelled as acc + float32(the 16 products summed in k order in float64): a fixed
+function of the row, the column and the accumulator, as the tensor cores are (rows and columns independent). Only the
+order in which the schedule feeds it is under test.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from dataclasses import dataclass
+
+import numpy as np
+
+from tests import glm_g53_reference as ref
+
+TOPK, HAD = 8, 128
+F32 = np.float32
+
+
+@dataclass(frozen=True)
+class Dims:
+    H: int = 512      # gate/up K, down N (kernels: 4,096)
+    WID: int = 512    # gate/up N, down K (kernels: 1,024, a TP2 half)
+    CBW: int = 256    # gate/up column block (kernels: 512): 16 n tiles, so gw 8 -> NT 2, gw 16 -> NT 1
+    E: int = 16       # experts (kernels: 288)
+
+    @property
+    def CB(self):
+        return self.WID // self.CBW
+
+    @property
+    def TPB(self):    # n tiles of a column block
+        return self.CBW // 16
+
+    @property
+    def KB(self):     # gate/up 128-wide K blocks (kernels: 32)
+        return self.H // HAD
+
+    @property
+    def NTG(self):    # gate/up n tiles of the slice, down k tiles
+        return self.WID // 16
+
+
+def layer(d: Dims, rng: np.random.Generator, shared: bool = True) -> dict:
+    """Random FP16 weights and scales for ``d.E`` experts (decoded weights stand in for the trellises: the decode is
+    per tile and has no schedule). ``shared``: one gate/up suh for every expert (rot 2 possible)."""
+
+    def h(*shape, mag=1.0):
+        return (rng.standard_normal(shape) * mag).astype(np.float16).astype(F32)
+
+    one = h(1, d.H, mag=0.5)
+    suh_g = np.repeat(one, d.E, 0) if shared else h(d.E, d.H, mag=0.5)
+    suh_u = suh_g.copy() if shared else h(d.E, d.H, mag=0.5)
+    return {"wg": h(d.E, d.H, d.WID, mag=0.05), "wu": h(d.E, d.H, d.WID, mag=0.05), "wd": h(d.E, d.WID, d.H, mag=0.05),
+            "suh_g": suh_g, "suh_u": suh_u, "svh_g": h(d.E, d.WID, mag=0.5), "svh_u": h(d.E, d.WID, mag=0.5),
+            "suh_d": h(d.E, d.WID, mag=0.5), "svh_d": h(d.E, d.H, mag=0.5), "shared": shared}
+
+
+def inputs(d: Dims, R: int, rng: np.random.Generator, skew: float = 1.1):
+    """R BF16 rows, 8 distinct experts a row (a few hot ones, as routing has), weights in [0.05, 0.35)."""
+
+    x = ref.bf16r(rng.standard_normal((R, d.H)).astype(F32))
+    p = 1.0 / np.arange(1, d.E + 1) ** skew
+    p = p[rng.permutation(d.E)]
+    pick = np.stack([rng.choice(d.E, TOPK, replace=False, p=p / p.sum()) for _ in range(R)]).astype(np.int64)
+    w = (rng.random((R, TOPK)) * 0.3 + 0.05).astype(F32)
+    return x, pick, w
+
+
+def _mma_chain(acc: np.ndarray, a: np.ndarray, b: np.ndarray, k_tiles) -> np.ndarray:
+    """acc [m, n] after one MMA a k tile, in ``k_tiles``' order: acc + float32(sum over the tile's 16 k of a * b)."""
+
+    for kt in k_tiles:
+        s = np.zeros(acc.shape, np.float64)
+        for j in range(kt * 16, kt * 16 + 16):
+            s = s + a[:, j:j + 1].astype(np.float64) * b[j:j + 1, :].astype(np.float64)
+        acc = (acc + s.astype(F32)).astype(F32)
+    return acc
+
+
+def _rotate(x: np.ndarray, suh: np.ndarray) -> np.ndarray:
+    return ref.rotate(x, suh)          # row_rotate: x * suh, fwht128, * 1/sqrt(128), FP16 (as float32)
+
+
+def plan(pick: np.ndarray, E: int, gr: int, rng: np.random.Generator | None):
+    """(groups [(expert, start, count)], pair_row, pair_route, inverse); within an expert the pairs in a random order
+    (the kernel's atomics) when ``rng``, else route order."""
+
+    ids = pick.reshape(-1)
+    routes = ids.size
+    order = []
+    for e in range(E):
+        mine = np.nonzero(ids == e)[0]
+        order.extend(rng.permutation(mine) if rng is not None else mine)
+    pair_route = np.asarray(order, dtype=np.int64)
+    pair_row = pair_route // TOPK
+    inverse = np.empty(routes, dtype=np.int64)
+    inverse[pair_route] = np.arange(routes)
+    cnt = np.bincount(ids, minlength=E)
+    base = np.concatenate([[0], np.cumsum(cnt)[:-1]])
+    groups = [(e, int(base[e]) + k * gr, int(min(gr, cnt[e] - k * gr)))
+              for e in range(E) for k in range((int(cnt[e]) + gr - 1) // gr)]
+    return groups, pair_row, pair_route, inverse
+
+
+def group_order(groups: list) -> list:
+    """order_kernel's gorder (one thread's arithmetic for every slot): heavy groups (an expert with several) and light
+    ones merged evenly, each list in plan order."""
+
+    n = len(groups)
+    heavy = [(i > 0 and groups[i - 1][0] == groups[i][0]) or (i + 1 < n and groups[i + 1][0] == groups[i][0])
+             for i in range(n)]
+    nh = sum(heavy)
+    nl = n - nh
+    gorder = [-1] * n
+    hb = 0
+    for i in range(n):
+        if heavy[i]:
+            hh = hb
+            hb += 1
+            q = ((2 * hh + 1) * nl + nh - 1) // nh if nh else 0
+            pos = hh + min(q // 2, nl)
+        else:
+            lo = i - hb
+            f = ((2 * lo + 1) * nh) // nl if nl else 0
+            pos = lo + min((f + 1) // 2, nh)
+        gorder[pos] = i
+    assert sorted(gorder) == list(range(n)), "the group order is a permutation"
+    return gorder
+
+
+def ffn(d: Dims, L: dict, x: np.ndarray, pick: np.ndarray, w: np.ndarray, cfg: dict, *, seed: int | None = None,
+        limit: float = 10.0) -> np.ndarray:
+    """The half's rows [R, H] (float32) as g53_ffn_launch computes them with configuration ``cfg`` (mt, sk, skd, nt,
+    gw, l2, fuse, discard, swiglu, rot, gord). ``seed``: the plan's within-expert order and the order the items are
+    taken in are shuffled with it (None: plan and grid order)."""
+
+    rng = np.random.default_rng(seed) if seed is not None else None
+    mt, sk, skd, nt, gw = cfg["mt"], cfg["sk"], cfg["skd"], cfg["nt"], cfg["gw"]
+    fused, discard = cfg["fuse"] == 2, cfg["fuse"] == 2 and cfg["discard"] == 2
+    bf16 = cfg["swiglu"] == 0
+    R = x.shape[0]
+    P = R * TOPK
+    NT = d.TPB // gw                                  # gate/up n tiles a warp
+    CW = 8 * nt * 16                                  # down chunk width: 8 warps of nt n tiles
+    nch = d.H // CW
+    assert NT >= 1 and d.TPB % gw == 0 and d.KB % sk == 0 and d.NTG % skd == 0 and (d.NTG // skd) % 8 == 0
+    assert nch >= 1 and d.H % CW == 0
+    rowrot = cfg["rot"] == 2 and L["shared"]
+    groups, pair_row, pair_route, inverse = plan(pick, d.E, 16 * mt, rng)
+    ng = len(groups)
+    gorder = group_order(groups) if cfg["gord"] == 2 else list(range(ng))
+    z = np.full((2, sk, P, d.WID), np.nan, F32)
+    xd = np.full((P, d.WID), np.nan, F32)
+    zd = np.full((skd, P, d.H), np.nan, F32)
+    out = np.full((R, d.H), np.nan, F32)
+    xh = _rotate(x, L["suh_g"][0]) if rowrot else None  # rotrows_kernel: once a row with the shared suh
+
+    def epilogue_item(e, gp, blk):
+        n = slice(blk * HAD, blk * HAD + HAD)
+        gv, uv = np.zeros(HAD, F32), np.zeros(HAD, F32)
+        for s in range(sk):
+            gv = (gv + z[0, s, gp, n]).astype(F32)
+            uv = (uv + z[1, s, gp, n]).astype(F32)
+        gv, uv = ref.fwht128(gv), ref.fwht128(uv)
+        gg = (gv * ref.HAD_SCALE).astype(F32) * L["svh_g"][e, n]
+        uu = (uv * ref.HAD_SCALE).astype(F32) * L["svh_u"][e, n]
+        lim = F32(limit)
+        with np.errstate(over="ignore"):
+            if bf16:
+                gg = np.minimum(ref.bf16r(gg), lim)
+                uu = np.minimum(np.maximum(ref.bf16r(uu), -lim), lim)
+                act = ref.bf16r(ref.bf16r(gg / (F32(1) + np.exp(-gg))) * uu)
+            else:
+                gg = np.minimum(gg, lim)
+                uu = np.minimum(np.maximum(uu, -lim), lim)
+                act = gg / (F32(1) + np.exp(-gg)) * uu
+        v = ref.fwht128(act.astype(F32) * L["suh_d"][e, n])
+        xd[gp, n] = (v * ref.HAD_SCALE).astype(np.float16).astype(F32)
+
+    def reduce_item(row, blk):
+        n = slice(blk * HAD, blk * HAD + HAD)
+        acc = np.zeros(HAD, F32)
+        for s in range(TOPK):
+            gp = inverse[row * TOPK + s]
+            v = (F32(0) + zd[0, gp, n]).astype(F32)
+            for k in range(1, skd):
+                v = (v + zd[k, gp, n]).astype(F32)
+            v = ref.fwht128(v)
+            t = ((v * ref.HAD_SCALE).astype(F32) * L["svh_d"][pick[row, s], n]).astype(F32)
+            acc = (acc + (F32(w[row, s]) * t).astype(F32)).astype(F32)
+        out[row, n] = acc
+
+    # gate/up: items (mat, cb, group, split), matrix fastest, then the column block, then the group, then the split
+    items = list(range(2 * d.CB * ng * sk))
+    if rng is not None:
+        items = list(rng.permutation(items))
+    gcnt = [0] * ng
+    seen = np.zeros((2, sk, P, d.WID), np.int32)
+    for item in items:
+        mc, rest = item % (2 * d.CB), item // (2 * d.CB)
+        mat, cb, gs, split = mc & 1, mc >> 1, rest % ng, rest // ng
+        g = gorder[gs]
+        e, start, count = groups[g]
+        mt_used = (count + 15) // 16
+        rows = np.zeros((mt_used * 16, d.H), F32)       # rows past the group's pairs: zero, never stored
+        suh = L["suh_u"][e] if mat else L["suh_g"][e]
+        for r in range(count):
+            rr = pair_row[start + r]
+            rows[r] = xh[rr] if xh is not None else _rotate(x[rr:rr + 1], suh)[0]
+        W = L["wu"][e] if mat else L["wg"][e]
+        kbs = d.KB // sk
+        k_tiles = range(split * kbs * 8, split * kbs * 8 + kbs * 8)
+        for warp in range(gw):
+            cols = [cb * d.CBW + warp * NT * 16 + i * 16 + hh * 8 + 2 * t4 + c
+                    for i in range(NT) for hh in range(2) for t4 in range(4) for c in range(2)]
+            acc = _mma_chain(np.zeros((mt_used * 16, len(cols)), F32), rows, W[:, cols], k_tiles)
+            z[mat, split][start:start + count, cols] = acc[:count]
+            seen[mat, split][start:start + count, cols] += 1
+        gcnt[g] += 1
+        if fused and gcnt[g] == 2 * d.CB * sk:           # the last of the group's items: its epilogue
+            for gp in range(start, start + count):
+                for blk in range(d.WID // HAD):
+                    epilogue_item(e, gp, blk)
+            if discard:
+                z[:, :, start:start + count, :] = np.nan
+    for g, (_, start, count) in enumerate(groups):    # every (pair, column) of every split written exactly once
+        assert (seen[:, :, start:start + count, :] == 1).all(), "a partial sum written other than once"
+    if not fused:
+        for gp in range(P):
+            r = pair_route[gp]
+            for blk in range(d.WID // HAD):
+                epilogue_item(int(pick[r // TOPK, r % TOPK]), gp, blk)
+    # down: items (group, chunk, split), the group fastest
+    items = list(range(ng * nch * skd))
+    if rng is not None:
+        items = list(rng.permutation(items))
+    rcnt = np.zeros((R, nch), np.int32)
+    kts = d.NTG // skd
+    for item in items:
+        g = gorder[item % ng]
+        chunk, split = (item // ng) % nch, item // (ng * nch)
+        e, start, count = groups[g]
+        mt_used = (count + 15) // 16
+        rows = np.zeros((mt_used * 16, d.WID), F32)
+        rows[:count] = xd[start:start + count]
+        k_tiles = range(split * kts, split * kts + kts)
+        for warp in range(8):
+            cols = [chunk * CW + warp * nt * 16 + i * 16 + hh * 8 + 2 * t4 + c
+                    for i in range(nt) for hh in range(2) for t4 in range(4) for c in range(2)]
+            acc = _mma_chain(np.zeros((mt_used * 16, len(cols)), F32), rows, L["wd"][e][:, cols], k_tiles)
+            zd[split][start:start + count, cols] = acc[:count]
+        if fused:                                         # each pair's row counts one arrival for this chunk
+            for r in range(count):
+                row = pair_row[start + r]
+                rcnt[row, chunk] += 1
+                if rcnt[row, chunk] == TOPK * skd:
+                    rcnt[row, chunk] = 0
+                    for blk in range(chunk * (CW // HAD), (chunk + 1) * (CW // HAD)):
+                        reduce_item(row, blk)
+                    if discard:
+                        for s in range(TOPK):
+                            zd[:, inverse[row * TOPK + s], chunk * CW:(chunk + 1) * CW] = np.nan
+    if not fused:
+        for row in range(R):
+            for blk in range(d.H // HAD):
+                reduce_item(row, blk)
+    return out
+
+
+def digest(a: np.ndarray) -> str:
+    return hashlib.sha256(np.ascontiguousarray(a, dtype=F32).tobytes()).hexdigest()[:16]
+
+
+def base_cfg(**kw) -> dict:
+    """The kernels' up-to-2,048-row default (default_cfg) with ``kw`` over it."""
+
+    c = {"mt": 2, "sk": 1, "skd": 1, "nt": 2, "gw": 8, "l2": 2, "fuse": 2, "discard": 2, "swiglu": 0, "rot": 2, "gord": 1}
+    c.update(kw)
+    return c
