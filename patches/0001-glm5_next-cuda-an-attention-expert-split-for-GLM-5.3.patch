new file mode 100644
index 0000000..a517239
--- /dev/null
+++ b/tests/glm_afd_fakes.py
@@ -0,0 +1,389 @@
+"""CPU stand-ins for the AFD wire tests (``tests/test_glm_afd_*.py``).
+
+A fake mcdma-rpcd pair over real protocol-1 mailbox files (on one host the connect and listen mailboxes are the same
+file, and the "listen daemon" copies each new staged word to the done word while a service is attached), an ABI-1
+libmcdma-rpc stand-in compiled here (unless ``TF_AFD_MCDMA_LIB`` names a build), a fake CUDA driver whose stream runs
+its memory operations in order on the host, fake expert halves, and the attention node's real ``AfdWire`` over
+the MCDMA wire.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import mmap
+import os
+import shutil
+import socket
+import struct
+import subprocess
+import threading
+import time
+from datetime import timedelta
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from tensorfold.families.glm5_next.cuda import afd as afd_mod  # noqa: E402
+from tensorfold.families.glm5_next.cuda import afd_mcdma, mcdma  # noqa: E402
+
+D, S = 64, 9                       # a small hidden size; GLM's 8 routed slots + the shared slot
+LAYERS = [3, 4, 5, 6]              # the experts' MoE layer indices (three dense layers first, as GLM)
+PREFILL = 48
+STAND_IN = r"""
+#define _POSIX_C_SOURCE 200809L
+#include <stdint.h>
+#include <time.h>
+uint32_t mcdma_rpc_abi(void) { return 1u; }
+static uint64_t ns(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+                           return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec; }
+uint64_t mcdma_rpc_wait_word(const volatile uint64_t *w, uint32_t seq, int eq, uint64_t spin, uint64_t limit) {
+    uint64_t t0 = ns();
+    for (;;) {
+        uint64_t v = __atomic_load_n(w, __ATOMIC_ACQUIRE);
+        uint32_t s = (uint32_t)(v >> 32);
+        if (eq ? s == seq : (s != 0 && s != seq)) return v;
+        uint64_t e = ns() - t0;
+        if (e >= limit) return 0;
+        if (e >= spin) { struct timespec p = {0, 20000}; nanosleep(&p, 0); }
+    }
+}
+void mcdma_rpc_store_word(volatile uint64_t *w, uint64_t v) { __atomic_store_n(w, v, __ATOMIC_RELEASE); }
+"""
+
+
+# -- fixtures (registered by name; tests import the functions under these private names) --------------------------
+@pytest.fixture(scope="module", name="libpath")
+def libpath_fixture(tmp_path_factory):
+    path = os.environ.get(mcdma.LIB_ENV, "")
+    if path:
+        return path
+    cc = shutil.which("cc") or shutil.which("gcc")
+    if cc is None:
+        pytest.skip("no libmcdma-rpc (set TF_AFD_MCDMA_LIB) and no C compiler for the stand-in")
+    d = tmp_path_factory.mktemp("lib")
+    (d / "stand_in.c").write_text(STAND_IN)
+    subprocess.run([cc, "-std=c11", "-O2", "-shared", "-fPIC", "-o", str(d / "libmcdma-rpc.so"), str(d / "stand_in.c")],
+                   check=True)
+    return str(d / "libmcdma-rpc.so")
+
+
+@pytest.fixture(name="words")
+def words_fixture(libpath):
+    return mcdma.Words(libpath)
+
+
+@pytest.fixture(name="env")
+def env_fixture(monkeypatch, libpath, tmp_path):
+    monkeypatch.setenv(mcdma.LIB_ENV, libpath)
+    monkeypatch.setenv(mcdma.SPIN_ENV, "200")
+    monkeypatch.setenv(mcdma.SHM_ENV, str(tmp_path / "shm"))
+    monkeypatch.delenv(mcdma.SOCKET_ENV, raising=False)
+    return monkeypatch
+
+
+@pytest.fixture(name="daemon")
+def daemon_fixture(tmp_path):
+    d = FakeDaemon(tmp_path, ["a2", "a1"])
+    yield d
+    d.close()
+
+
+@pytest.fixture(name="master")
+def master_fixture(monkeypatch):
+    """The attention's store (rank 0's TCPStore) on a free port; AfdWire's own watchdog sleeps (the tests drive it)."""
+
+    from torch.distributed import TCPStore
+
+    monkeypatch.setattr(afd_mod, "WATCH_EVERY", 3600)
+    port = free_port()
+    server = TCPStore("127.0.0.1", port, 1, True, timeout=timedelta(seconds=30), wait_for_workers=False)
+    yield port
+    del server
+
+
+def free_port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+# -- the MCDMA daemons and the CUDA driver --------------------------------------------------------------------------
+class FakeDaemon:
+    """Both daemons of each link on one host: the mailbox file (sizes at +256, link-up 1, generation 1), the listen
+    socket (MODE poll -> OK, one service at a time, else ERR busy; its last-sent sequence taken from the staged word at
+    attach), and the reply path (a new staged word -> the done word, while a service is attached)."""
+
+    def __init__(self, root, names, req=4 << 20, rep=4 << 20) -> None:
+        self.shm = root / "shm"
+        self.shm.mkdir(exist_ok=True)
+        self.tag = f"afdm-{os.getpid()}-{id(self):x}"     # abstract sockets: test paths outgrow sun_path
+        self.req, self.rep = req, rep
+        self.mm, self.listeners, self.svc, self.last, self.stalled = {}, {}, {}, {}, set()
+        self.stop = threading.Event()
+        for n in names:
+            path = self.shm / f"mcdma-rpc.{n}"
+            with open(path, "wb") as f:
+                f.truncate(req + rep)
+            fd = os.open(path, os.O_RDWR)
+            m = mmap.mmap(fd, req + rep)
+            os.close(fd)
+            struct.pack_into("<QQ", m, mcdma.SIZES, req, rep)
+            struct.pack_into("<Q", m, mcdma.GENERATION, 1)
+            struct.pack_into("<Q", m, mcdma.LINK_UP, 1)
+            self.mm[n], self.svc[n], self.last[n] = m, None, 0
+            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+            s.bind(self.sock(n))
+            s.listen(4)
+            s.settimeout(0.1)
+            self.listeners[n] = s
+            threading.Thread(target=self._accept, args=(n,), daemon=True).start()
+        threading.Thread(target=self._replies, daemon=True).start()
+
+    def sock(self, n) -> str:
+        return f"\0{self.tag}-{n}"
+
+    def u64(self, n, off) -> int:
+        return struct.unpack_from("<Q", self.mm[n], off)[0]
+
+    def put(self, n, off, v) -> None:
+        struct.pack_into("<Q", self.mm[n], off, v)
+
+    def _accept(self, n) -> None:
+        while not self.stop.is_set():
+            try:
+                c, _ = self.listeners[n].accept()
+            except (TimeoutError, socket.timeout, OSError):
+                continue
+            c.settimeout(2)
+            line = c.recv(64).strip()
+            if line == b"MODE poll" and self.svc[n] is None:
+                c.sendall(b"OK\n")
+                self.last[n] = self.u64(n, self.req + mcdma.STAGED) >> 32
+                self.svc[n] = c
+            else:
+                c.sendall(b"ERR busy\n")
+                c.close()
+
+    def _replies(self) -> None:
+        while not self.stop.is_set():
+            for n, m in self.mm.items():
+                if self.svc[n] is None or n in self.stalled:
+                    continue
+                w = self.u64(n, self.req + mcdma.STAGED)
+                if w >> 32 and (w >> 32) != self.last[n]:
+                    self.last[n] = w >> 32
+                    self.put(n, self.req + mcdma.DONE, w)
+            time.sleep(0.00002)
+
+    def bye(self, n) -> None:
+        c, self.svc[n] = self.svc[n], None
+        if c is not None:
+            try:
+                c.sendall(b"BYE\n")
+            finally:
+                c.close()
+
+    def reconnect(self, n) -> None:
+        """The connect daemon's reconnect: words cleared, generation bumped, link up again."""
+
+        self.put(n, mcdma.REQ_WORD, 0)
+        self.put(n, self.req + mcdma.DONE, 0)
+        self.put(n, mcdma.GENERATION, self.u64(n, mcdma.GENERATION) + 1)
+
+    def replace(self, n) -> None:
+        """A restarted connect daemon: the old mailbox unlinked, a new one (a new inode) under the same path."""
+
+        path = self.shm / f"mcdma-rpc.{n}"
+        os.unlink(path)
+        with open(path, "wb") as f:
+            f.truncate(self.req + self.rep)
+
+    def close(self) -> None:
+        for n in list(self.svc):
+            self.bye(n)
+        self.stop.set()
+        for s in self.listeners.values():
+            s.close()
+
+
+class FakeDriver:
+    """The CUDA driver as one in-order host stream: write-value stores now, wait-value spins until the whole word
+    is equal (as CU_STREAM_WAIT_VALUE_EQ), registered memory's device pointer is its host address (UVA)."""
+
+    def __init__(self, words, flush=0) -> None:
+        self.words, self.flush, self.ops = words, flush, []
+
+    def attr(self, name, ordinal=0) -> int:
+        return self.flush if name == "can_flush_remote_writes" else 1
+
+    def register(self, addr, size) -> int:
+        self.ops.append(("register", addr, size))
+        return addr
+
+    def unregister(self, addr) -> None:
+        pass
+
+    def write64(self, stream, dptr, value) -> None:
+        self.ops.append(("write", dptr, value))
+        self.words.store(dptr, value)
+
+    def wait64(self, stream, dptr, value, flags=mcdma.CU_STREAM_WAIT_VALUE_EQ) -> None:
+        self.ops.append(("wait", dptr, value, flags))
+        end = time.monotonic() + 20
+        while ctypes.c_uint64.from_address(dptr).value != value:
+            if time.monotonic() > end:
+                raise AssertionError(f"fake stream wedged waiting for {value:#x}")
+            time.sleep(0.0001)
+
+
+def partial(normed, pick, wts, layer: int, half: int):
+    """The fake expert half's output: depends on every request byte, the layer and the half."""
+
+    return normed.float() * (layer + 1 + 10 * half) + (pick.float() * wts).sum(dim=1, keepdim=True)
+
+
+class FakeNode:
+    """An expert half: ``compute`` writes ``partial`` into its routed slot; ``inputs`` keeps every request it read."""
+
+    def __init__(self, layers, half: int, prefill: int = PREFILL, record: bool = False) -> None:
+        self.cfg = SimpleNamespace(hidden=D, top_k=S - 1, limit=0.0)
+        self.layers, self.half, self.record = list(layers), half, record
+        self.buf = SimpleNamespace(slots=S, prefill_rows=prefill,
+                                   normed=torch.zeros((prefill, D), dtype=torch.bfloat16),
+                                   pick=torch.zeros((prefill, S), dtype=torch.int32),
+                                   wts=torch.zeros((prefill, S), dtype=torch.float32),
+                                   routed=torch.zeros((prefill, D), dtype=torch.float32))
+        self.seen, self.inputs = [], []
+
+    def compute(self, layer_i, R, x=None):
+        b = self.buf
+        normed, pick, wts = x if x is not None else (b.normed[:R], b.pick[:R], b.wts[:R])
+        b.routed[:R].copy_(partial(normed, pick, wts, layer_i, self.half))
+        self.seen.append((layer_i, R))
+        if self.record:
+            self.inputs.append((layer_i, R, normed.clone(), pick.clone(), wts.clone()))
+        return b.routed[:R]
+
+
+class Expert:
+    """``experts_node.forwards`` over one expert link in a thread; ``error`` holds what ended it."""
+
+    def __init__(self, link, node, store=None) -> None:
+        self.link, self.node, self.error = link, node, None
+        self.store = store or DictStore()
+        self.t = threading.Thread(target=self._run, daemon=True)
+        self.t.start()
+
+    def _run(self) -> None:
+        from tensorfold.families.glm5_next.cuda import experts_node
+
+        try:
+            experts_node.forwards(self.node, self.link, self.store, self.node.half + 1)
+        except BaseException as exc:  # noqa: BLE001
+            self.error = exc
+
+    def join(self, s=5.0) -> None:
+        self.t.join(s)
+        assert not self.t.is_alive(), "expert loop did not end"
+
+
+class DictStore:
+    def __init__(self) -> None:
+        self.d = {}
+
+    def set(self, k, v) -> None:
+        self.d[k] = v if isinstance(v, bytes) else str(v).encode()
+
+    def get(self, k):
+        if k not in self.d:
+            raise KeyError(k)
+        return self.d[k]
+
+
+def fake_cfg():
+    return SimpleNamespace(hidden=D, top_k=S - 1, mlp_kinds=["dense"] * 3 + ["moe"] * len(LAYERS), quant="exl3",
+                           experts=16, limit=0.0)
+
+
+def settings(prefill=PREFILL, layers=LAYERS):
+    return {"digest": "", "layers": list(layers), "max_rows": 8, "mtp": 0,
+            "prefill_rows": prefill, "quant": "exl3", "experts": 16, "top_k": S - 1}
+
+
+# -- the attention node ---------------------------------------------------------------------------------------------
+def mcdma_attention(links, port, layers=LAYERS, prefill=PREFILL):
+    """``AfdWire`` over ``McdmaTransport`` on the CPU (the test hosts the store; ``abort`` releases the links)."""
+
+    tr = afd_mcdma.McdmaTransport("127.0.0.1", port, links=links, comm=SimpleNamespace(abort=links.release),
+                                  device="cpu", hidden=D)
+    a = afd_mod.AfdWire("127.0.0.1", port, transport=tr)
+    a.announce(settings(prefill, layers))
+    return a
+
+
+def buffers(rows=PREFILL):
+    return SimpleNamespace(normed=torch.zeros((rows, D), dtype=torch.bfloat16),
+                           pick=torch.zeros((rows, S), dtype=torch.int32),
+                           wts=torch.zeros((rows, S), dtype=torch.float32),
+                           sy=torch.zeros((rows, D), dtype=torch.float32),
+                           afd_recv=torch.zeros((3 * rows * D,), dtype=torch.float32))
+
+
+def forward(a, b, rows, gen, layers=LAYERS, chunk=False, stop_after=None) -> list:
+    """One forward's MoE exchanges with fresh wire tensors; checks every reply against the fake experts' function and
+    returns each layer's ``[3, rows, D]`` (copies)."""
+
+    a.begin(rows, chunk=chunk)
+    out = []
+    for pos, layer in enumerate(layers):
+        if stop_after is not None and pos == stop_after:
+            return out
+        b.normed[:rows] = torch.randn((rows, D), generator=gen).to(torch.bfloat16)
+        b.pick[:rows] = torch.randint(0, 16, (rows, S), generator=gen, dtype=torch.int32)
+        b.wts[:rows] = torch.rand((rows, S), generator=gen)
+        b.sy[:rows] = torch.randn((rows, D), generator=gen)
+        a.exchange(b, rows)
+        got = a.collect(b, rows, D)
+        assert got.shape == (3, rows, D)
+        for half in (0, 1):
+            want = partial(b.normed[:rows], b.pick[:rows], b.wts[:rows], layer, half)
+            assert torch.equal(got[half], want), f"layer {layer} half {half} rows {rows}"
+        assert torch.equal(got[2], b.sy[:rows])
+        out.append(got.clone())
+    return out
+
+
+def setup_pair(daemon, words, *, attn="cpu", experts=("cpu", "cpu"), timeout=10.0, before_experts=None,
+               record=False):
+    """Both MCDMA links' attention end, and both experts' loops over their own ends."""
+
+    drv = FakeDriver(words)
+    links = mcdma.AttentionLinks(["a2", "a1"], words=words, driver=drv if attn == "gpu" else None, mode=attn,
+                                 stream=lambda: 0, timeout=timeout, shm_dir=str(daemon.shm), linkup_wait=2)
+    if before_experts:
+        before_experts(links)
+    eps = []
+    for half, (name, mode) in enumerate(zip(["a2", "a1"], experts)):
+        link = mcdma.ExpertLink(name, words=words, driver=drv if mode == "gpu" else None, mode=mode,
+                                socket_path=daemon.sock(name), shm_dir=str(daemon.shm), stream=lambda: 0)
+        link.base = links.base[half]
+        end = afd_mcdma.McdmaExpertLink(link, D, S, len(LAYERS), PREFILL, device="cpu")
+        eps.append(Expert(end, FakeNode(LAYERS, half, record=record)))
+    return links, eps, drv
+
+
+def wait_attached(daemon, names=("a2", "a1"), s=5.0) -> None:
+    end = time.monotonic() + s
+    while any(daemon.svc[n] is None for n in names):
+        assert time.monotonic() < end, "service never attached"
+        time.sleep(0.01)
+
+
+def finish(daemon, eps) -> None:
+    for n in ("a2", "a1"):
+        daemon.bye(n)
+    for e in eps:
+        e.join()
+        assert isinstance(e.error, mcdma.LinkError) and "BYE" in str(e.error), repr(e.error)
