+"""The MCDMA wire's CUDA driver side (``mcdma_cuda``) on the CPU: the gpu/cpu mode choice, the flush flag, and the
+current-context rule ``cuMemHostRegister`` needs (error 201 without one)."""
+
+from __future__ import annotations
+
+import threading
+
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from tensorfold.families.glm5_next.cuda import mcdma, mcdma_cuda  # noqa: E402
+from tests.glm_afd_fakes import FakeDriver  # noqa: E402
+from tests.glm_afd_fakes import env_fixture, libpath_fixture, words_fixture  # noqa: E402, F401  (fixtures)
+
+
+def test_mode_choice(env):
+    logs = []
+
+    def log(*a, **_):
+        logs.append(" ".join(map(str, a)))
+
+    class NoOps:
+        def attr(self, name, ordinal=0):
+            return 0 if name == "stream_mem_ops_64" else 1
+
+    env.setenv(mcdma.MODE_ENV, "auto")
+    mode, drv = mcdma_cuda.choose_mode(torch, 0, driver_factory=NoOps, log=log)
+    assert mode == "cpu" and isinstance(drv, NoOps) and "FALLING BACK" in logs[-1]
+    env.setenv(mcdma.MODE_ENV, "gpu")
+    with pytest.raises(RuntimeError, match="stream_mem_ops_64"):
+        mcdma_cuda.choose_mode(torch, 0, driver_factory=NoOps, log=log)
+    env.setenv(mcdma.MODE_ENV, "cpu")
+    assert mcdma_cuda.choose_mode(torch, 0, driver_factory=NoOps, log=log)[0] == "cpu"
+    env.setenv(mcdma.MODE_ENV, "auto")
+
+    def broken():
+        raise RuntimeError("libcuda not found")
+
+    assert mcdma_cuda.choose_mode(torch, 0, driver_factory=broken, log=log) == ("cpu", None)
+    env.setenv(mcdma.MODE_ENV, "fast")
+    with pytest.raises(ValueError):
+        mcdma_cuda.choose_mode(torch, 0, driver_factory=NoOps, log=log)
+
+
+def test_flush_flag_follows_the_device(words):
+    assert mcdma_cuda.flush_flag(FakeDriver(words, flush=1), 0) == mcdma.CU_STREAM_WAIT_VALUE_FLUSH
+    assert mcdma_cuda.flush_flag(FakeDriver(words, flush=0), 0) == 0
+
+
+class FakeLibcuda:
+    """libcuda's context calls for CudaDriver, per thread (as the driver's current context is): error 201 when
+    cuMemHostRegister runs with no context current."""
+
+    PRIMARY = {0: 0x1000, 1: 0x2000}
+
+    def __init__(self) -> None:
+        self.calls: list = []
+        self.tls = threading.local()
+
+    def install(self, drv) -> None:
+        def cur():
+            return getattr(self.tls, "cur", 0)
+
+        def out(p, v):
+            p._obj.value = v                               # a ctypes.byref(...) argument's target
+            return 0
+
+        def get_cur(p):
+            self.calls.append(("get",))
+            return out(p, cur() or None)
+
+        def set_cur(c):
+            self.calls.append(("set", c))
+            self.tls.cur = c
+            return 0
+
+        def retain(p, dev):
+            self.calls.append(("retain", dev))
+            return out(p, self.PRIMARY[dev])
+
+        def reg(addr, size, flags):
+            self.calls.append(("register", cur()))
+            return 0 if cur() else 201
+
+        drv._init = lambda flags: 0
+        drv._getcur, drv._setcur, drv._retain = get_cur, set_cur, retain
+        drv._dev = lambda p, ordinal: out(p, ordinal)
+        drv._reg, drv._unreg = reg, lambda addr: 0 if cur() else 201
+        drv._dptr = lambda p, addr, flags: out(p, addr)
+        drv._err = lambda code, p: out(p, b"invalid device context")
+        drv.ordinal, drv.ctx_source, drv._primary = 0, "", {}
+
+
+def test_register_makes_the_primary_context_current():
+    """cuMemHostRegister with no current context is error 201 (torch.cuda.init does not make one current).
+    register retains the device's primary context once and sets it current; an already-current one (torch's) is
+    used as is; nothing is ever released or destroyed; another thread gets the same primary context."""
+
+    fake, drv = FakeLibcuda(), object.__new__(mcdma_cuda.CudaDriver)
+    fake.install(drv)
+    with pytest.raises(RuntimeError, match="201"):           # the probe's situation before the fix
+        drv._check(drv._reg(0x5000, 4096, 0), "cuMemHostRegister")
+    assert drv.register(0x5000, 4096) == 0x5000 and drv.ctx_source == "primary"
+    assert ("retain", 0) in fake.calls and ("register", 0x1000) in fake.calls
+    fake.calls.clear()
+    drv.register(0x6000, 4096)                               # current now: no second retain, no set
+    drv.unregister(0x6000)
+    assert drv.ctx_source == "current" and not [c for c in fake.calls if c[0] in ("retain", "set")]
+    fake.calls.clear()
+    seen = []
+    t = threading.Thread(target=lambda: seen.append(drv.register(0x7000, 4096)))
+    t.start()
+    t.join()
+    assert seen == [0x7000] and ("set", 0x1000) in fake.calls and ("retain", 0) not in fake.calls
+    fake.tls.cur = 0x9000                                    # torch's runtime made a context current: use it
+    fake.calls.clear()
+    assert drv.ensure_ctx() == 0x9000 and fake.calls == [("get",)]
+
+
+def test_choose_mode_makes_the_serving_device_current(env):
+    fake, drv = FakeLibcuda(), object.__new__(mcdma_cuda.CudaDriver)
+    fake.install(drv)
+    drv.attr = lambda name, ordinal=0: 0 if name == "stream_mem_ops_64" else 1   # the probe stops at the attrs
+    logs = []
+    env.setenv(mcdma.MODE_ENV, "auto")
+    assert mcdma_cuda.choose_mode(torch, 1, driver_factory=lambda: drv,
+                                  log=lambda *a, **_: logs.append(a))[0] == "cpu"
+    assert drv.ordinal == 1 and ("retain", 1) in fake.calls and fake.tls.cur == 0x2000
+    drv.register(0x5000, 4096)                               # a mailbox registers under the serving device's ctx
+    assert fake.calls[-1] == ("register", 0x2000)
+    fake2, drv2 = FakeLibcuda(), object.__new__(mcdma_cuda.CudaDriver)
+    fake2.install(drv2)
+    env.setenv(mcdma.MODE_ENV, "cpu")
+    assert mcdma_cuda.choose_mode(torch, 1, driver_factory=lambda: drv2)[0] == "cpu" and drv2.ordinal == 1
+    assert not fake2.calls                                   # cpu mode: no probe, no context until a register
+    env.setenv(mcdma.MODE_ENV, "auto")
+
+
+def test_a_cpu_driven_link_registers_nothing(words):
+    logs = []
+    assert mcdma_cuda._register(None, object(), True, logs.append) is None
+
+    class Refuses:
+        def register(self, addr, size):
+            raise RuntimeError("no")
+
+    box = type("Box", (), {"base": 0x1000, "size": 4096, "path": "/dev/shm/mcdma-rpc.x"})()
+    assert mcdma_cuda._register(Refuses(), box, False, lambda *a, **_: logs.append(a[0])) is None
+    assert "not registered with CUDA" in logs[-1]
+    with pytest.raises(RuntimeError, match="no"):
+        mcdma_cuda._register(Refuses(), box, True, logs.append)
