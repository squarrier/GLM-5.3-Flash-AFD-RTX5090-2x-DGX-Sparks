@@ -0,0 +1,233 @@
+"""The CUDA driver side of the MCDMA wire: libcuda through ctypes for the GPU-driven exchange (mailboxes registered
+for the device, ``cuStreamWriteValue64``/``cuStreamWaitValue64`` on the serving stream), the capability probe and
+``TF_AFD_MCDMA_MODE``'s choice between it and the CPU-driven exchange.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import mmap
+import time
+
+from .mcdma import (CU_MEMHOSTREGISTER_DEVICEMAP, CU_MEMHOSTREGISTER_PORTABLE, CU_STREAM_WAIT_VALUE_EQ,
+                    CU_STREAM_WAIT_VALUE_FLUSH, CU_STREAM_WRITE_VALUE_DEFAULT, FLUSH_ENV, MODE_ENV, Mailbox, _env, word)
+
+ATTRS = {"integrated": 18, "can_map_host_memory": 19, "unified_addressing": 41, "host_native_atomic": 86,
+         "pageable_memory_access": 88, "host_pointer_for_registered_mem": 91, "can_flush_remote_writes": 98,
+         "host_register_supported": 99, "gpu_direct_rdma_writes_ordering": 118, "stream_mem_ops_64": 122}
+NEEDED = ("stream_mem_ops_64", "can_map_host_memory", "unified_addressing")
+_LEAKED: list = []              # a failed probe's page and stream: the stream may still read the page, keep both
+
+
+class CudaDriver:
+    """The CUDA driver calls the GPU-driven exchange needs, on libcuda through ctypes. torch owns the context's
+    lifetime, but ``torch.cuda.init()`` does not make it driver-current, and ``cuMemHostRegister`` needs a current
+    context (else CUDA error 201): ``ensure_ctx`` makes the device's primary context (the one torch's runtime
+    uses) current on the calling thread, retained once and never released or destroyed. ``register`` calls it first;
+    the stream ops take explicit stream handles and need none."""
+
+    def __init__(self, path: str | None = None) -> None:
+        for p in ([path] if path else ["libcuda.so.1", "libcuda.so"]):
+            try:
+                lib = ctypes.CDLL(p)
+                break
+            except OSError:
+                continue
+        else:
+            raise RuntimeError("libcuda not found")
+        u, vp, u64 = ctypes.c_uint, ctypes.c_void_p, ctypes.c_uint64
+
+        def fn(*names, args):
+            for n in names:
+                f = getattr(lib, n, None)
+                if f is not None:
+                    f.restype, f.argtypes = ctypes.c_int, args
+                    return f
+            raise RuntimeError(f"libcuda has none of {names}")
+
+        self._version = fn("cuDriverGetVersion", args=[ctypes.POINTER(ctypes.c_int)])
+        self._dev = fn("cuDeviceGet", args=[ctypes.POINTER(ctypes.c_int), ctypes.c_int])
+        self._attr = fn("cuDeviceGetAttribute", args=[ctypes.POINTER(ctypes.c_int), ctypes.c_int, ctypes.c_int])
+        self._err = fn("cuGetErrorString", args=[ctypes.c_int, ctypes.POINTER(ctypes.c_char_p)])
+        self._reg = fn("cuMemHostRegister_v2", "cuMemHostRegister", args=[vp, ctypes.c_size_t, u])
+        self._unreg = fn("cuMemHostUnregister", args=[vp])
+        self._dptr = fn("cuMemHostGetDevicePointer_v2", "cuMemHostGetDevicePointer",
+                        args=[ctypes.POINTER(u64), vp, u])
+        self._wait = fn("cuStreamWaitValue64_v2", "cuStreamWaitValue64", args=[vp, u64, u64, u])
+        self._write = fn("cuStreamWriteValue64_v2", "cuStreamWriteValue64", args=[vp, u64, u64, u])
+        self._init = fn("cuInit", args=[u])
+        self._getcur = fn("cuCtxGetCurrent", args=[ctypes.POINTER(vp)])
+        self._setcur = fn("cuCtxSetCurrent", args=[vp])
+        self._retain = fn("cuDevicePrimaryCtxRetain_v2", "cuDevicePrimaryCtxRetain",
+                          args=[ctypes.POINTER(vp), ctypes.c_int])
+        self.ordinal = 0                     # the device ensure_ctx defaults to (the last one it was given)
+        self.ctx_source = ""                 # how the last ensure_ctx found its context: "current" or "primary"
+        self._primary: dict[int, int] = {}   # ordinal -> the primary context retained here (held for the process)
+
+    def ensure_ctx(self, ordinal: int | None = None) -> int:
+        """A current context on this thread: the one already current (torch's, once its runtime made it so), else
+        device ``ordinal``'s primary context, retained once and set current (PROBE-CTX.md's B-sequence). Idempotent;
+        never pops, releases or destroys a context. Returns the context handle."""
+
+        if ordinal is not None:
+            self.ordinal = int(ordinal)
+        self._check(self._init(0), "cuInit")
+        cur = ctypes.c_void_p()
+        self._check(self._getcur(ctypes.byref(cur)), "cuCtxGetCurrent")
+        if cur.value:
+            self.ctx_source = "current"
+            return cur.value
+        ctx = self._primary.get(self.ordinal)
+        if ctx is None:
+            d, c = ctypes.c_int(), ctypes.c_void_p()
+            self._check(self._dev(ctypes.byref(d), self.ordinal), "cuDeviceGet")
+            self._check(self._retain(ctypes.byref(c), d.value), "cuDevicePrimaryCtxRetain")
+            if not c.value:
+                raise RuntimeError(f"cuDevicePrimaryCtxRetain({self.ordinal}) returned no context")
+            ctx = self._primary[self.ordinal] = int(c.value)
+        self._check(self._setcur(ctx), "cuCtxSetCurrent")
+        self.ctx_source = "primary"
+        return ctx
+
+    def _check(self, code: int, what: str) -> None:
+        if code:
+            s = ctypes.c_char_p()
+            self._err(code, ctypes.byref(s))
+            raise RuntimeError(f"{what}: CUDA driver error {code} ({(s.value or b'?').decode()})")
+
+    def version(self) -> int:
+        v = ctypes.c_int()
+        self._check(self._version(ctypes.byref(v)), "cuDriverGetVersion")
+        return v.value
+
+    def attr(self, name: str, ordinal: int = 0) -> int:
+        d, v = ctypes.c_int(), ctypes.c_int()
+        self._check(self._dev(ctypes.byref(d), ordinal), "cuDeviceGet")
+        self._check(self._attr(ctypes.byref(v), ATTRS[name], d.value), f"cuDeviceGetAttribute({name})")
+        return v.value
+
+    def register(self, addr: int, size: int) -> int:
+        """Page-lock ``size`` bytes at ``addr`` and map them for the device; the device pointer stream ops take.
+        Under a current context (``ensure_ctx``: cuMemHostRegister without one is error 201)."""
+
+        self.ensure_ctx()
+        self._check(self._reg(addr, size, CU_MEMHOSTREGISTER_PORTABLE | CU_MEMHOSTREGISTER_DEVICEMAP),
+                    "cuMemHostRegister")
+        d = ctypes.c_uint64()
+        self._check(self._dptr(ctypes.byref(d), addr, 0), "cuMemHostGetDevicePointer")
+        return d.value
+
+    def unregister(self, addr: int) -> None:
+        self.ensure_ctx()
+        self._check(self._unreg(addr), "cuMemHostUnregister")
+
+    def write64(self, stream: int, dptr: int, value: int) -> None:
+        self._check(self._write(stream, dptr, value, CU_STREAM_WRITE_VALUE_DEFAULT), "cuStreamWriteValue64")
+
+    def wait64(self, stream: int, dptr: int, value: int, flags: int = CU_STREAM_WAIT_VALUE_EQ) -> None:
+        self._check(self._wait(stream, dptr, value, flags), "cuStreamWaitValue64")
+
+
+def probe(driver, torch, ordinal: int = 0, timeout: float = 2.0) -> tuple[bool, str]:
+    """Can this GPU run the exchange's stream memory ops on registered host memory? The attributes, a write-value,
+    then a wait-value that must hold its stream until the host stores the value. A private page and a side stream:
+    a failure here never wedges the serving stream (a wedged probe stream and its page are left alone)."""
+
+    for name in NEEDED:
+        if not driver.attr(name, ordinal):
+            return False, f"device attribute {name} is 0"
+    size = 64 << 10
+    page = mmap.mmap(-1, size, mmap.MAP_SHARED | mmap.MAP_ANONYMOUS, mmap.PROT_READ | mmap.PROT_WRITE)
+    anchor = ctypes.c_char.from_buffer(page)
+    host = ctypes.addressof(anchor)
+    dev = driver.register(host, size)
+
+    def at(off: int) -> ctypes.c_uint64:
+        return ctypes.c_uint64.from_address(host + off)
+
+    side = torch.cuda.Stream()
+    s = side.cuda_stream
+    driver.write64(s, dev, word(7, 77))
+    side.synchronize()
+    if at(0).value != word(7, 77):
+        return False, f"write-value landed {at(0).value:#x}, not {word(7, 77):#x}"
+    driver.wait64(s, dev + 64, word(9, 99), CU_STREAM_WAIT_VALUE_EQ)
+    driver.write64(s, dev + 128, word(11, 111))
+    time.sleep(0.02)
+    if at(128).value == word(11, 111):
+        return False, "wait-value did not hold the stream (its marker landed before the host's store)"
+    at(64).value = word(9, 99)
+    end = time.monotonic() + timeout
+    while at(128).value != word(11, 111):
+        if time.monotonic() > end:
+            _LEAKED.append((page, anchor, side))         # the stream may still read the page: never unmap it
+            return False, f"the GPU never saw the host's store within {timeout:.1f} s (probe stream left waiting)"
+        time.sleep(0.0005)
+    side.synchronize()
+    driver.unregister(host)
+    del anchor
+    page.close()
+    return True, "ok"
+
+
+def flush_flag(driver, ordinal: int) -> int:
+    """CU_STREAM_WAIT_VALUE_FLUSH where the platform has it (TF_AFD_MCDMA_FLUSH=auto), so NIC writes ahead of a
+    word are visible to the stream's next copy; 0 elsewhere."""
+
+    want = _env(FLUSH_ENV, "auto").lower()
+    if want in ("0", "off", "no"):
+        return 0
+    try:
+        has = bool(driver.attr("can_flush_remote_writes", ordinal))
+    except Exception:  # noqa: BLE001  an old driver without the attribute
+        has = False
+    if want in ("1", "on", "yes") and not has:
+        raise RuntimeError(f"{FLUSH_ENV}=1 but the device lacks CAN_FLUSH_REMOTE_WRITES")
+    return CU_STREAM_WAIT_VALUE_FLUSH if has else 0
+
+
+def choose_mode(torch, ordinal: int, driver_factory=CudaDriver, log=print) -> tuple[str, object]:
+    """TF_AFD_MCDMA_MODE: gpu (refuse to start unless the probe passes), cpu, or auto (gpu when it passes, else cpu
+    with a loud line). Returns (mode, driver or None)."""
+
+    want = _env(MODE_ENV, "auto").lower()
+    if want not in ("gpu", "cpu", "auto"):
+        raise ValueError(f"{MODE_ENV}={want!r}: use gpu, cpu or auto")
+    try:
+        driver = driver_factory()
+    except Exception as exc:  # noqa: BLE001  no libcuda: only the CPU-driven exchange is possible
+        if want == "gpu":
+            raise
+        log(f"[tensorfold] afd mcdma: no CUDA driver binding ({exc}); CPU-driven exchange", flush=True)
+        return "cpu", None
+    if want == "cpu":
+        if hasattr(driver, "ensure_ctx"):
+            driver.ordinal = int(ordinal)      # the mailboxes' (best-effort) registers make this device's ctx current
+        return "cpu", driver
+    try:
+        ensure = getattr(driver, "ensure_ctx", None)
+        if ensure is not None:
+            ensure(ordinal)       # the device's context current on this (the serving) thread; later registers reuse it
+        ok, why = probe(driver, torch, ordinal)
+    except Exception as exc:  # noqa: BLE001  any driver refusal is a failed probe
+        ok, why = False, repr(exc)
+    if ok:
+        return "gpu", driver
+    if want == "gpu":
+        raise RuntimeError(f"{MODE_ENV}=gpu but the stream-memory-op probe failed: {why}")
+    log(f"[tensorfold] afd mcdma: WARNING: GPU-driven exchange unavailable ({why}); FALLING BACK to the CPU-driven "
+        f"exchange (one host sync per layer, slower); set {MODE_ENV}=cpu to silence this", flush=True)
+    return "cpu", driver
+
+
+def _register(driver, box: Mailbox, required: bool, log) -> int | None:
+    if driver is None:
+        return None
+    try:
+        return driver.register(box.base, box.size)
+    except Exception as exc:  # noqa: BLE001
+        if required:
+            raise
+        log(f"[tensorfold] afd mcdma: mailbox {box.path} not registered with CUDA ({exc}); staged copies", flush=True)
+        return None
+
