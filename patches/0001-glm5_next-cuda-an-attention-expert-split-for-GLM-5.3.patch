+"""The MCDMA AFD wire end to end on one host, CPU only: the attention's ``AfdWire`` over
+``McdmaTransport`` and the experts' ``forwards`` loops over ``McdmaExpertLink``, through a fake mcdma-rpcd pair
+(``glm_afd_fakes``)."""
+
+from __future__ import annotations
+
+import json
+import struct
+import threading
+import time
+
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from tensorfold.families.glm5_next.cuda import afd as afd_mod  # noqa: E402
+from tensorfold.families.glm5_next.cuda import afd_mcdma, mcdma  # noqa: E402
+from tensorfold.server.errors import CapacityError  # noqa: E402
+from tests.glm_afd_fakes import (D, LAYERS, PREFILL, S, FakeDaemon, FakeDriver, FakeNode, buffers,  # noqa: E402
+                                 fake_cfg, finish, forward, free_port, mcdma_attention, settings, setup_pair,
+                                 wait_attached)
+from tests.glm_afd_fakes import (daemon_fixture, env_fixture, libpath_fixture, master_fixture,  # noqa: E402, F401
+                                 words_fixture)
+
+
+# -- the protocol's arithmetic ---------------------------------------------------------------------------------------
+def test_sequence_never_zero_and_wraps():
+    assert mcdma.next_seq(1) == 2 and mcdma.next_seq(0) == 1
+    assert mcdma.next_seq(mcdma.SEQ_MAX) == 1 and mcdma.prev_seq(1) == mcdma.SEQ_MAX
+    s, seen = mcdma.SEQ_MAX - 2, []
+    for _ in range(6):
+        s = mcdma.next_seq(s)
+        seen.append(s)
+    assert seen == [mcdma.SEQ_MAX - 1, mcdma.SEQ_MAX, 1, 2, 3, 4] and 0 not in seen
+    assert all(a != b for a, b in zip(seen, seen[1:]))        # consecutive requests always differ (the daemon's test)
+    w = mcdma.word(0xFFFFFFFF, 16384)
+    assert mcdma.word_seq(w) == 0xFFFFFFFF and mcdma.word_len(w) == 16384
+
+
+def test_layout_for_glm_and_the_mailbox_sizes():
+    lay = mcdma.Layout(4096, 9)
+    assert lay.req(1) == 256 + 8192 + 256 + 36 and lay.rep(1) == 16384
+    assert all(o % 256 == 0 for r in (1, 3, 8, 2048) for o in lay.offsets(r)[:3])
+    assert lay.mib(8) == (4, 4) and lay.mib(2048) == (20, 36)     # the daemons' req_mib, rep_mib
+
+
+def test_packed_request_round_trips_through_the_landing_views():
+    lay, rows, gen = mcdma.Layout(D, S), 5, torch.Generator().manual_seed(1)
+    normed = torch.randn((rows, D), generator=gen).to(torch.bfloat16)
+    pick = torch.randint(0, 16, (rows, S), generator=gen, dtype=torch.int32)
+    wts = torch.rand((rows, S), generator=gen)
+    req = torch.empty((lay.req(rows),), dtype=torch.uint8)
+    hdr = torch.zeros((mcdma.HDR_INTS,), dtype=torch.int32)
+    torch.cat([hdr.view(torch.uint8), afd_mcdma._bytes(normed), afd_mcdma._bytes(pick),
+               torch.zeros((lay.pad(rows),), dtype=torch.uint8), afd_mcdma._bytes(wts)], out=req)
+    n2, p2, w2 = lay.views(req[mcdma.HDR_BYTES:].clone(), rows)
+    assert torch.equal(n2, normed) and torch.equal(p2, pick) and torch.equal(w2, wts)
+
+
+# -- mailboxes ----------------------------------------------------------------------------------------------------
+def test_mailbox_reads_the_daemon_layout_and_refuses_what_does_not_fit(daemon, words, tmp_path):
+    box = mcdma.Mailbox("a2", words, str(daemon.shm))
+    assert (box.req, box.rep) == (4 << 20, 4 << 20) and box.plain(mcdma.LINK_UP) == 1
+    box.check_room(mcdma.Layout(4096, 9), 8)
+    with pytest.raises(mcdma.LinkError, match="req_mib>=20 rep_mib>=36"):
+        box.check_room(mcdma.Layout(4096, 9), 2048)
+    with pytest.raises(mcdma.LinkError, match="--ipc=host"):
+        mcdma.Mailbox("nope", words, str(daemon.shm))
+
+
+def test_announce_refuses_a_window_the_mailboxes_cannot_carry(tmp_path, words):
+    d = FakeDaemon(tmp_path, ["b2", "b1"])
+    try:
+        links = mcdma.AttentionLinks(["b2", "b1"], words=words, shm_dir=str(d.shm), linkup_wait=2)
+        tr = afd_mcdma.McdmaTransport("", 0, links=links, comm=object(), device="cpu", hidden=4096)
+        with pytest.raises(mcdma.LinkError, match="req_mib>=20 rep_mib>=36"):
+            tr.publish(settings(prefill=2048))         # GLM's hidden 4096 at 2048 rows: past the fake's 4+4 MiB
+    finally:
+        d.close()
+
+
+# -- the exchange, end to end -------------------------------------------------------------------------------------
+@pytest.mark.parametrize("attn,experts", [("cpu", ("cpu", "cpu")), ("gpu", ("gpu", "gpu")), ("gpu", ("cpu", "gpu")),
+                                          ("cpu", ("gpu", "cpu"))])
+def test_exchange_end_to_end(env, daemon, words, master, attn, experts):
+    links, eps, drv = setup_pair(daemon, words, attn=attn, experts=experts)
+    wait_attached(daemon)
+    a, b, gen = mcdma_attention(links, master), buffers(), torch.Generator().manual_seed(7)
+    plan = [1, 3, 8, 1, PREFILL, 2]
+    for rows in plan:
+        forward(a, b, rows, gen, chunk=rows > 8)
+    n = len(plan) * len(LAYERS)
+    assert links.count == [n, n]
+    for k, e in enumerate(eps):                       # every request served in order, the sequence in step
+        assert e.node.seen == [(i, r) for r in plan for i in LAYERS]
+        assert mcdma.word_seq(words.load(links.boxes[k].done)) == links.seq[k]
+        assert links.seq[k] == (links.base[k] + n - 1) % (mcdma.SEQ_MAX + 1)
+    if attn == "gpu":                                 # the stream did it: per layer two writes, two EQ waits
+        writes = [op for op in drv.ops if op[0] == "write" and op[1] in (links.dptr[0], links.dptr[1])]
+        waits = [op for op in drv.ops if op[0] == "wait" and op[1] in [links.boxes[k].done for k in (0, 1)]]
+        assert len(writes) == 2 * n and len(waits) == 2 * n
+        assert all(op[3] == mcdma.CU_STREAM_WAIT_VALUE_EQ for op in waits)
+    assert links.health() == "" and a.tr.health() is None
+    finish(daemon, eps)
+
+
+def test_sequence_wrap_on_the_wire(env, daemon, words, master):
+    def stale(links):                                  # a previous run's last request was 2**32 - 2
+        for k, box in enumerate(links.boxes):
+            words.store(box.req_word, mcdma.word(mcdma.SEQ_MAX - 1, 100))
+            links.base[k] = mcdma.next_seq(mcdma.SEQ_MAX - 1)
+            links.seq[k] = mcdma.prev_seq(links.base[k])
+
+    links, eps, _ = setup_pair(daemon, words, attn="gpu", experts=("gpu", "cpu"), before_experts=stale)
+    assert links.base == [mcdma.SEQ_MAX, mcdma.SEQ_MAX]
+    wait_attached(daemon)
+    a, b, gen = mcdma_attention(links, master), buffers(), torch.Generator().manual_seed(3)
+    for rows in (1, 2):
+        forward(a, b, rows, gen)
+    assert links.seq == [2 * len(LAYERS) - 1] * 2     # 2**32-1, then 1, 2, ...: past the wrap, never 0
+    finish(daemon, eps)
+
+
+def test_a_stale_staged_word_cannot_swallow_the_first_reply(env, daemon, words, master):
+    """The listen daemon takes the staged word's sequence at attach as already sent; the expert clears it first."""
+
+    def stale(links):
+        for k, n in enumerate(("a2", "a1")):
+            daemon.put(n, daemon.req + mcdma.STAGED, mcdma.word(links.base[k], mcdma.Layout(D, S).rep(1)))
+
+    links, eps, _ = setup_pair(daemon, words, before_experts=stale)
+    wait_attached(daemon)
+    forward(mcdma_attention(links, master), buffers(), 1, torch.Generator().manual_seed(5))
+    finish(daemon, eps)
+
+
+def test_the_bases_the_settings_and_the_startup_line(env, daemon, words, master, capsys):
+    links, eps, _ = setup_pair(daemon, words)
+    a = mcdma_attention(links, master)
+    for peer, base in zip((1, 2), links.base):        # start(): each expert counts its link's sequence from here
+        assert int(bytes(a.store.get(f"afd_mcdma/base/{peer}")).decode()) == base
+    line = [ln for ln in capsys.readouterr().out.splitlines() if "afd transport" in ln]
+    assert line == [f"[tensorfold] afd transport mcdma, cpu-driven: link a2 -> expert 1, a1 -> expert 2; mailboxes "
+                    f"4+4 MiB; first sequences {links.base}; generations [1, 1]; no NCCL communicator"]
+    sent = json.loads(bytes(a.store.get("afd_settings")).decode())
+    assert sent == dict(settings(), transport="mcdma", mcdma_links=["a2", "a1"])
+    finish(daemon, eps)
+
+
+# -- failure detection --------------------------------------------------------------------------------------------
+def test_generation_change_fails_the_wait(env, daemon, words, master):
+    links, eps, _ = setup_pair(daemon, words, timeout=30)
+    wait_attached(daemon)
+    a, b, gen = mcdma_attention(links, master), buffers(), torch.Generator().manual_seed(2)
+    forward(a, b, 1, gen)
+    daemon.stalled.add("a2")
+    threading.Timer(0.3, daemon.reconnect, args=("a2",)).start()
+    with pytest.raises(CapacityError, match="restart the serving stack"):
+        forward(a, b, 1, gen)
+    assert a.dead.startswith("MCDMA ") and "reconnected (generation 1 -> 2)" in a.dead
+    with pytest.raises(CapacityError):
+        a.begin(1)
+    finish(daemon, eps)
+
+
+def test_cpu_wait_times_out_on_a_hung_expert(env, daemon, words, master):
+    links, eps, _ = setup_pair(daemon, words, timeout=0.5)
+    wait_attached(daemon)
+    a, b = mcdma_attention(links, master), buffers()
+    daemon.stalled.add("a1")                           # rank 2's replies never land: a hung expert or daemon
+    t0 = time.monotonic()
+    with pytest.raises(CapacityError):
+        forward(a, b, 1, torch.Generator().manual_seed(4))
+    assert time.monotonic() - t0 < 5
+    assert "link a1" in a.dead and ("no reply" in a.dead or "unanswered" in a.dead)
+    finish(daemon, eps)
+
+
+def test_gpu_mode_watchdog_releases_the_stream(env, daemon, words, master):
+    links, eps, drv = setup_pair(daemon, words, attn="gpu", experts=("cpu", "cpu"), timeout=0.3)
+    wait_attached(daemon)
+    a, b = mcdma_attention(links, master), buffers()
+    daemon.stalled.add("a2")
+
+    def watchdog():                                    # AfdWire._watchdog's transport check, faster
+        while a.dead is None:
+            why = a.tr.health()
+            if why:
+                a.die(why)
+            time.sleep(0.05)
+
+    threading.Thread(target=watchdog, daemon=True).start()
+    a.begin(1)
+    b.normed[:1] = 1
+    a.exchange(b, 1)
+    a.collect(b, 1, D)                                 # the stream's wait was answered by the release, not wedged
+    assert a.dead and a.dead.startswith("MCDMA ") and "unanswered" in a.dead
+    assert words.load(links.boxes[0].done) == mcdma.word(links.seq[0], 4 * D)
+    a.exchange(b, 1)                                   # the forward runs on without the wire, no new waits
+    a.collect(b, 1, D)
+    with pytest.raises(CapacityError, match="gone"):
+        a.begin(1)
+    daemon.stalled.discard("a2")
+    finish(daemon, eps)
+
+
+def test_link_down_is_reported(env, daemon, words, master):
+    links, eps, _ = setup_pair(daemon, words)
+    a = mcdma_attention(links, master)
+    daemon.put("a1", mcdma.LINK_UP, 0)
+    assert "link a1 is down" in links.health() and a.tr.health() == f"MCDMA {links.health()}"
+    daemon.put("a1", mcdma.LINK_UP, 1)
+    assert links.health() == "" and a.tr.health() is None
+    finish(daemon, eps)
+
+
+def test_a_replaced_mailbox_is_reported(env, daemon, words):
+    links, eps, _ = setup_pair(daemon, words)
+    daemon.replace("a2")
+    assert "mailbox" in links.health() and "replaced" in links.health()
+    finish(daemon, eps)
+
+
+def test_link_must_come_up(env, daemon, words):
+    daemon.put("a2", mcdma.LINK_UP, 0)
+    with pytest.raises(mcdma.LinkError, match="not up"):
+        mcdma.AttentionLinks(["a2", "a1"], words=words, shm_dir=str(daemon.shm), linkup_wait=0.3)
+
+
+def test_registration_busy_and_bye(env, daemon, words):
+    links, eps, _ = setup_pair(daemon, words)
+    wait_attached(daemon)
+    with pytest.raises(mcdma.LinkError, match="ERR busy"):
+        mcdma.ExpertLink("a2", words=words, socket_path=daemon.sock("a2"), shm_dir=str(daemon.shm))
+    with pytest.raises(mcdma.LinkError, match="cannot register"):
+        mcdma.ExpertLink("a2", words=words, socket_path=daemon.sock("none"), shm_dir=str(daemon.shm))
+    finish(daemon, eps)                                # BYE ends both loops with a LinkError naming it
+
+
+def test_expert_refuses_a_bad_first_request(env, daemon, words):
+    links, eps, _ = setup_pair(daemon, words)
+    wait_attached(daemon)
+    box = links.boxes[0]
+    struct.pack_into(mcdma.HDR_FMT, box.mm, mcdma.CTRL, 0x1234, 1, 1, 0, afd_mod.MODE_EAGER, len(LAYERS), 0, 0)
+    words.store(box.req_word, mcdma.word(links.base[0], mcdma.Layout(D, S).req(1)))
+    eps[0].join()
+    assert isinstance(eps[0].error, mcdma.LinkError) and "no forward's first" in str(eps[0].error)
+    daemon.bye("a1")
+    eps[1].join()
+
+
+def test_every_window_is_eager_and_a_forward_stopped_midway_kills_the_wire(env, daemon, words, master):
+    links, eps, _ = setup_pair(daemon, words)
+    wait_attached(daemon)
+    a, b = mcdma_attention(links, master), buffers()
+    assert a.forces_eager()
+    a.begin(1)                                         # the mode word every layer's request header carries
+    assert a.tr.hdr_tab[:, 4].tolist() == [afd_mod.MODE_EAGER] * len(LAYERS)
+    a.begin(3, chunk=True)
+    assert a.tr.hdr_tab[:, 4].tolist() == [afd_mod.MODE_CHUNK] * len(LAYERS)
+    forward(a, b, 2, torch.Generator().manual_seed(6), stop_after=2)
+    with pytest.raises(CapacityError, match="stopped after 2 of 4"):
+        a.begin(1)
+    finish(daemon, eps)
+
+
+# -- the expert node's serve(), handshake included ------------------------------------------------------------------
+@pytest.mark.parametrize("attn", ["cpu", "gpu"])
+def test_serve_over_mcdma_with_the_store_handshake(env, daemon, words, tmp_path, attn):
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    env.setattr(afd_mod, "WATCH_EVERY", 3600)
+    env.setattr(experts_node, "ALIVE_EVERY", 3600)     # serve()'s beat thread outlives the test: let it sleep
+    env.setattr(experts_node.Config, "read", staticmethod(lambda _d: fake_cfg()))
+    env.setattr(experts_node, "ExpertNode", lambda _d, half, layers, **_: FakeNode(layers, half))
+    by_thread = {"x0": "a2", "x1": "a1"}
+    env.setattr(mcdma, "link_name", lambda: by_thread[threading.current_thread().name])
+    init = mcdma.ExpertLink.__init__
+
+    def link_init(self, name, **kw):
+        kw.setdefault("socket_path", daemon.sock(name))
+        init(self, name, **kw)
+
+    env.setattr(mcdma.ExpertLink, "__init__", link_init)
+    port, errors = free_port(), {}
+
+    def run(half):
+        try:
+            experts_node.serve(tmp_path, half, "127.0.0.1", port, device="cpu")
+        except BaseException as exc:  # noqa: BLE001
+            errors[half] = exc
+
+    threads = [threading.Thread(target=run, args=(h,), name=f"x{h}", daemon=True) for h in (0, 1)]
+    for t in threads:
+        t.start()
+    links = mcdma.AttentionLinks(["a2", "a1"], words=words, driver=FakeDriver(words) if attn == "gpu" else None,
+                                 mode=attn, stream=lambda: 0, timeout=10, shm_dir=str(daemon.shm), linkup_wait=2)
+    tr = afd_mcdma.McdmaTransport("127.0.0.1", port, links=links, device="cpu", hidden=D)   # StoreComm: both join
+    a = afd_mod.AfdWire("127.0.0.1", port, transport=tr)
+    a.announce(afd_mod.settings_for(tmp_path, fake_cfg(), prefill_rows=PREFILL))
+    a.wait_loaded(30)
+    b, gen = buffers(), torch.Generator().manual_seed(11)
+    for rows in (1, 4, PREFILL, 1):
+        forward(a, b, rows, gen, chunk=rows > 8)
+    for n in ("a2", "a1"):
+        daemon.bye(n)
+    for t in threads:
+        t.join(10)
+        assert not t.is_alive()
+    assert all(isinstance(errors[h], mcdma.LinkError) for h in (0, 1)), errors
+    for r in (1, 2):                                   # the attention's watchdog would read these
+        assert b"BYE" in bytes(a.store.get(f"afd_error/{r}"))
+
+
+def test_an_expert_on_another_link_refuses(env):
+    env.setenv(mcdma.LINK_ENV, "a1")
+    theirs = dict(settings(), transport="mcdma", mcdma_links=["a2", "a1"])
+    with pytest.raises(SystemExit, match="serves MCDMA link 'a1' but the attention maps links"):
+        afd_mcdma.open_expert_link(theirs, 1, fake_cfg(), None, device="cpu")
