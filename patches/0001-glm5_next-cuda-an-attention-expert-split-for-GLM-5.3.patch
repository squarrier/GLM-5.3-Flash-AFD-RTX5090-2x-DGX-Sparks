@@ -0,0 +1,96 @@
+"""The AFD's transport seam: the wire between the attention node and the two expert nodes.
+
+The wire is MCDMA's link daemons (``afd_mcdma``): GPU-driven stream memory operations where the device's probe
+passes, CPU-driven otherwise (``TF_AFD_MCDMA_MODE``). Each node holds one end:
+
+- the attention node an ``ExpertTransport``, under ``afd.AfdWire``, which keeps the store, the settings handshake,
+  the watchdog, the forward's ``seq``/``rows``/``mode`` and the wire check and timer;
+- each expert node an ``ExpertLink``, under ``experts_node.serve``'s per-forward loop.
+
+``layer`` is the MoE exchange's position within the forward, 0 for the first MoE layer.
+"""
+
+from __future__ import annotations
+
+from typing import Protocol
+
+
+class WireError(RuntimeError):
+    """``send``/``recv`` found the wire unable to carry the exchange: ``AfdWire`` dies with ``why`` and fails the
+    forward with a capacity error naming this error's text."""
+
+    def __init__(self, message: str, why: str) -> None:
+        super().__init__(message)
+        self.why = why
+
+
+class ExpertTransport(Protocol):
+    """The attention node's end of the wire."""
+
+    name: str      # the wire's name in the handshake and the startup line: "mcdma"
+
+    def publish(self, settings: dict) -> dict:
+        """The handshake settings this wire adds to ``settings``, once its buffers are sized for them."""
+        ...
+
+    def start(self, store) -> None:
+        """Once the attention's store exists: what the experts read before their first forward."""
+        ...
+
+    def header(self, seq: int, rows: int, mode: int) -> None:
+        """Once per forward, before layer 0: the forward's ``seq``, ``rows`` and ``mode`` to both experts."""
+        ...
+
+    def send(self, b, rows: int, layer: int) -> None:
+        """This layer's ``b.normed``/``b.pick``/``b.wts`` rows to both expert halves."""
+        ...
+
+    def recv(self, dst1, dst2, layer: int) -> None:
+        """Both halves' fp32 partials for this layer into ``dst1`` (expert 1) and ``dst2`` (expert 2)."""
+        ...
+
+    def health(self) -> str | None:
+        """Why the wire can no longer carry the exchange, in the watchdog's words; None while it can."""
+        ...
+
+    def abort(self) -> None:
+        """No exchange may wait for an answer that will not come (the watchdog's death)."""
+        ...
+
+    def describe(self) -> str:
+        """The wire's one startup line."""
+        ...
+
+
+class ExpertLink(Protocol):
+    """An expert node's end of the wire."""
+
+    def next_forward(self) -> tuple[int, int, int]:
+        """Wait for the next forward; its ``(seq, rows, mode)``."""
+        ...
+
+    def land(self, layer: int, views):
+        """This layer's request; ``views`` are the node's ``(normed, pick, wts)`` slots. Returns the views it landed
+        in, which the compute reads."""
+        ...
+
+    def reply(self, layer: int, routed) -> None:
+        """This layer's fp32 partial back to the attention node."""
+        ...
+
+    def health(self) -> str | None:
+        """Why this end can no longer carry the wire, or None."""
+        ...
+
+    def close(self) -> None:
+        """Let go of the wire."""
+        ...
+
+
+def transport_for(**kw) -> ExpertTransport:
+    """The attention node's end of the wire, MCDMA's link daemons, built with ``kw`` (``master``, ``port`` and
+    ``model_dir`` in the server)."""
+
+    from .afd_mcdma import McdmaTransport
+
+    return McdmaTransport(**kw)
