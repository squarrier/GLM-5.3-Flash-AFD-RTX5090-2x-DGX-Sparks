index 0000000..e40c677
--- /dev/null
+++ b/tests/cuda/test_glm_afd.py
@@ -0,0 +1,82 @@
+"""The AFD expert halves sum to the local MoE, offline (no network).
+
+One GPU plays every role: the two-rank ``moe_block`` partials are the reference, the halves' ``compute`` outputs
+( shared slot zeroed) plus the world-1 shared expert are the AFD sum.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from test_glm_engine import _checkpoint  # noqa: E402  (the synthetic EXL3 checkpoint builder)
+
+from tensorfold.families.glm5_next.cuda import forward as fwd  # noqa: E402
+from tensorfold.families.glm5_next.cuda import glue  # noqa: E402
+from tensorfold.families.glm5_next.cuda.experts_node import ExpertNode  # noqa: E402
+from tensorfold.families.glm5_next.cuda.forward import Buffers  # noqa: E402
+from tensorfold.families.glm5_next.cuda.weights import load  # noqa: E402
+
+ROWS = (1, 4, 8, 64)
+LAYER = 1                                    # the synthetic checkpoint's MoE layer (mtp=False drops the other)
+
+
+@pytest.fixture(scope="module")
+def afd(tmp_path_factory):
+    path = tmp_path_factory.mktemp("afd")
+    _checkpoint(path, exl3=True, mtp=False)
+    ranks = [load(path, rank=h) for h in (0, 1)]
+    attn = load(path, rank=0, world=1, experts=False)
+    nodes = [ExpertNode(path, h, [LAYER]) for h in (0, 1)]
+    bufs = [Buffers(w, max(ROWS)) for w in ranks] + [Buffers(attn, max(ROWS))]
+    return attn, ranks, nodes, bufs
+
+
+def _pieces(afd, x, R):
+    """The two-rank moe_block partials, the halves' routed outputs and the world-1 shared expert, in order."""
+
+    attn, ranks, nodes, bufs = afd
+    c = attn.cfg
+    parts = []
+    for w, b in zip(ranks, bufs[:2]):
+        b.normed[:R].copy_(x)
+        fwd.moe_block(w.layers[LAYER], w, b, R)
+        parts.append(b.part[:R].clone())
+    ba = bufs[2]
+    m = attn.layers[LAYER].moe
+    ba.normed[:R].copy_(x)
+    glue.router(ba.normed[:R], m.router, ba.mlog[:R])
+    glue.select(ba.mlog[:R], m.bias, ba.pick[:R], ba.wts[:R], c.top_k, c.experts, c.routed_scale, c.norm_topk)
+    fwd.mm(ba, ba.normed[:R], m.shared.gu, ba.xs[:R], ba.sgu[:R])
+    glue.swiglu(ba.sgu[:R], ba.sact[:R], ba.sxs[:R], c.limit)
+    fwd.mm(ba, ba.sact[:R], m.shared.down, ba.sxs[:R], ba.sy[:R], f32=True)
+    routed = []
+    for node in nodes:
+        nb = node.buf
+        nb.normed[:R].copy_(x)
+        nb.pick[:R].copy_(ba.pick[:R])
+        nb.wts[:R].copy_(ba.wts[:R])
+        routed.append(node.compute(LAYER, R).clone())
+    return parts, routed, ba.sy[:R].clone()
+
+
+@pytest.mark.parametrize("R", ROWS)
+def test_halves_sum_to_local_moe(afd, R):
+    """routed0 + routed1 + sy equals part0 + part1 within fp32 reassociation, and every piece re-runs bit-exact."""
+
+    attn, ranks, nodes, bufs = afd
+    hidden = attn.cfg.hidden
+    x = torch.tensor(np.random.default_rng(7).standard_normal((R, hidden)) * 0.5).to("cuda", torch.bfloat16)
+    parts, routed, sy = _pieces(afd, x, R)
+    ref, afd_sum = parts[0] + parts[1], (routed[0] + routed[1]) + sy
+    scale = float(ref.abs().max())
+    err = float((afd_sum - ref).abs().max())
+    assert err <= 1e-3 * scale, (err, err / scale)
+    parts2, routed2, sy2 = _pieces(afd, x, R)
+    for a, b in [(parts2[0], parts[0]), (parts2[1], parts[1]), (routed2[0], routed[0]), (routed2[1], routed[1]),
+                 (sy2, sy)]:
+        assert torch.equal(a, b)
