diff --git a/src/tensorfold/families/glm5_next/cuda/mcdma.py b/src/tensorfold/families/glm5_next/cuda/mcdma.py
new file mode 100644
index 0000000..fc0675c
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/mcdma.py
@@ -0,0 +1,597 @@
+"""The MCDMA link-daemon transport for the AFD exchange: protocol-1 mailboxes and words,
+the request layout and libmcdma-rpc through ctypes; the CUDA driver side (registered mailboxes, the stream memory
+operations, their probe and the gpu/cpu choice) is ``mcdma_cuda``.
+
+One mailbox per link (MCDMA docs/link-daemon.md, e672c14): a request half of R bytes, then a reply half of P bytes,
+each led by a 4 KiB control page. A word is ``seq << 32 | length``; sequence 0 means empty. The attention node is
+the connect end of both links (``mcdma-rpcd connect``, mailbox ``/dev/shm/mcdma-rpc.NAME``), each expert node the
+listen end of its own (``mcdma-rpcd listen``, a registered ``MODE poll`` service). A link carries one request at a
+time: the next is issued only once the previous reply's done word has landed, so both ends count the same sequence
+numbers (``next_seq`` from a base the attention publishes) and one mailbox per link is enough.
+
+GPU-driven (``TF_AFD_MCDMA_MODE=gpu``): the copies into and out of the registered mailbox are stream-ordered, the
+words are ``cuStreamWriteValue64``/``cuStreamWaitValue64`` on the torch stream; no host sync per layer.
+CPU-driven (``cpu``): blocking copies, ``mcdma_rpc_store_word``/``mcdma_rpc_wait_word`` on the host. ``auto`` (the
+default) runs a capability probe and falls back to CPU loudly.
+"""
+
+from __future__ import annotations
+
+import collections
+import ctypes
+import ctypes.util
+import mmap
+import os
+import re
+import socket
+import struct
+import threading
+import time
+
+LINKS_ENV = "TF_AFD_MCDMA_LINKS"        # attention: link names for expert ranks 1 and 2, e.g. "link1,link2"
+LINK_ENV = "TF_AFD_MCDMA_LINK"          # expert: this node's link name
+MODE_ENV = "TF_AFD_MCDMA_MODE"          # gpu | cpu | auto (default)
+LIB_ENV = "TF_AFD_MCDMA_LIB"            # libmcdma-rpc.so (ABI 1)
+SHM_ENV = "TF_AFD_MCDMA_SHM_DIR"        # where the mailboxes are (default /dev/shm; tests move them)
+TIMEOUT_ENV = "TF_AFD_MCDMA_TIMEOUT"    # s a request may stay unanswered before the attention calls the link dead
+SPIN_ENV = "TF_AFD_MCDMA_SPIN_US"       # us a host wait spins before it sleeps in 20 us steps
+FLUSH_ENV = "TF_AFD_MCDMA_FLUSH"        # auto | 0 | 1: CU_STREAM_WAIT_VALUE_FLUSH on the stream waits
+SOCKET_ENV = "MCDMA_RPCD_SOCKET"        # the listen daemon's socket (the MCDMA tools' own variable)
+
+CTRL = 4096                     # each half's control page
+SEG = 4 << 20                   # mailbox halves are whole multiples of 4 MiB
+REQ_WORD, LINK_UP, GENERATION, SIZES = 0, 64, 72, 256   # request-half offsets
+DONE, STAGED = 64, 128          # reply-half offsets: done (connect end), staged (listen end)
+SEQ_MAX = 0xFFFFFFFF
+ALIGN = 256                     # every request section starts 256-B aligned (the kernels' and DMA's comfort)
+HDR_BYTES = 256                 # the request's header slot
+HDR_FMT = "<8i"                 # magic, forward seq, rows, layer, mode, layers, 0, 0
+HDR_INTS = HDR_BYTES // 4
+WIRE_MAGIC = 0x0AFD4D31         # "AFD M1": the MCDMA request header
+SLICE_NS = 50_000_000           # a host wait's slice between liveness checks
+LINKUP_WAIT = 120.0             # s the attention waits for each link to come up at start
+
+# libcuda enums (cuda.h, CUDA 13; unchanged since 11.x)
+CU_STREAM_WAIT_VALUE_EQ = 0x1
+CU_STREAM_WAIT_VALUE_FLUSH = 1 << 30
+CU_STREAM_WRITE_VALUE_DEFAULT = 0x0      # a stream-scoped system fence before the write: earlier copies land first
+CU_MEMHOSTREGISTER_PORTABLE = 0x01
+CU_MEMHOSTREGISTER_DEVICEMAP = 0x02
+PENDING_MAX = 1 << 16           # GPU mode's enqueued (seq, bytes) per link: far more than a forward's 42
+
+
+class LinkError(RuntimeError):
+    """A link that can no longer carry the exchange: daemon down, reconnected, timed out, or a protocol breach."""
+
+
+def word(seq: int, length: int) -> int:
+    return (int(seq) & SEQ_MAX) << 32 | (int(length) & SEQ_MAX)
+
+
+def word_seq(w: int) -> int:
+    return (int(w) >> 32) & SEQ_MAX
+
+
+def word_len(w: int) -> int:
+    return int(w) & SEQ_MAX
+
+
+def next_seq(s: int) -> int:
+    """The link's next sequence number: +1, wrapping past 2**32 - 1 to 1, never 0 (0 means an empty word)."""
+
+    return 1 if s >= SEQ_MAX or s < 0 else s + 1
+
+
+def prev_seq(s: int) -> int:
+    return SEQ_MAX if s <= 1 else s - 1
+
+
+def _align(n: int) -> int:
+    return (n + ALIGN - 1) // ALIGN * ALIGN
+
+
+def _env(name: str, default: str = "") -> str:
+    return (os.environ.get(name) or default).strip()
+
+
+def link_names() -> list[str]:
+    names = [n.strip() for n in _env(LINKS_ENV).split(",") if n.strip()]
+    if len(names) != 2 or len(set(names)) != 2:
+        raise ValueError(f"--experts remote needs {LINKS_ENV}=LINK_FOR_RANK1,LINK_FOR_RANK2 (two distinct "
+                         f"mcdma-rpcd link names, e.g. link1,link2); got {_env(LINKS_ENV)!r}")
+    return names
+
+
+def link_name() -> str:
+    name = _env(LINK_ENV)
+    if not name:
+        raise ValueError(f"an expert node needs {LINK_ENV}=its mcdma-rpcd link name")
+    return name
+
+
+def timeout_s() -> float:
+    return float(_env(TIMEOUT_ENV, "30"))
+
+
+def spin_ns() -> int:
+    return int(float(_env(SPIN_ENV, "5000")) * 1000)
+
+
+class Layout:
+    """One exchange's payloads for ``rows`` rows, after each half's control page. Request: the 256-B header slot,
+    normed bf16 [rows, D], pick int32 [rows, S], wts fp32 [rows, S], each section 256-B aligned. Reply: the expert
+    half's fp32 partial [rows, D]."""
+
+    def __init__(self, hidden: int, slots: int) -> None:
+        self.d, self.s = int(hidden), int(slots)
+
+    def offsets(self, rows: int) -> tuple[int, int, int, int]:
+        normed = HDR_BYTES
+        pick = normed + 2 * self.d * rows
+        wts = pick + _align(4 * self.s * rows)
+        return normed, pick, wts, wts + 4 * self.s * rows
+
+    def req(self, rows: int) -> int:
+        return self.offsets(rows)[3]
+
+    def pad(self, rows: int) -> int:
+        return _align(4 * self.s * rows) - 4 * self.s * rows
+
+    def rep(self, rows: int) -> int:
+        return 4 * self.d * rows
+
+    def mib(self, rows: int) -> tuple[int, int]:
+        """The smallest mailbox halves (req_mib, rep_mib) that carry ``rows`` rows."""
+
+        def up(n: int) -> int:
+            return (CTRL + n + SEG - 1) // SEG * 4
+
+        return up(self.req(rows)), up(self.rep(rows))
+
+    def views(self, land, rows: int):
+        """(normed, pick, wts) over a device buffer holding a request's bytes from the header slot's end on."""
+
+        import torch
+
+        normed, pick, wts, end = (o - HDR_BYTES for o in self.offsets(rows))
+        return (land[normed:pick].view(torch.bfloat16).view(rows, self.d),
+                land[pick:pick + 4 * self.s * rows].view(torch.int32).view(rows, self.s),
+                land[wts:end].view(torch.float32).view(rows, self.s))
+
+
+class Words:
+    """libmcdma-rpc ABI 1 through ctypes: release stores and acquire loads/waits on mailbox words (the GIL is
+    released while a wait spins)."""
+
+    CANDIDATES = ("/mcdma/libmcdma-rpc.so", "/usr/local/lib/libmcdma-rpc.so")
+
+    def __init__(self, path: str | None = None) -> None:
+        cands = [path or _env(LIB_ENV)] + list(self.CANDIDATES)
+        found = ctypes.util.find_library("mcdma-rpc")
+        if found:
+            cands.append(found)
+        tried = []
+        for p in cands:
+            if not p:
+                continue
+            try:
+                lib = ctypes.CDLL(p)
+                break
+            except OSError as exc:
+                tried.append(f"{p} ({exc})")
+        else:
+            raise RuntimeError(f"libmcdma-rpc not found (tried {', '.join(tried) or 'nothing'}): set {LIB_ENV} to a "
+                               "build of MCDMA rpc/libmcdma_rpc.c for this architecture")
+        lib.mcdma_rpc_abi.restype = ctypes.c_uint32
+        lib.mcdma_rpc_abi.argtypes = []
+        if lib.mcdma_rpc_abi() != 1:
+            raise RuntimeError(f"{p}: libmcdma-rpc ABI {lib.mcdma_rpc_abi()}, this transport speaks ABI 1")
+        lib.mcdma_rpc_wait_word.restype = ctypes.c_uint64
+        lib.mcdma_rpc_wait_word.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int, ctypes.c_uint64,
+                                            ctypes.c_uint64]
+        lib.mcdma_rpc_store_word.restype = None
+        lib.mcdma_rpc_store_word.argtypes = [ctypes.c_void_p, ctypes.c_uint64]
+        self.lib, self.path = lib, p
+
+    def store(self, addr: int, value: int) -> None:
+        self.lib.mcdma_rpc_store_word(addr, value)
+
+    def load(self, addr: int) -> int:
+        """An acquire load: the word, or 0 while its sequence is 0 (empty)."""
+
+        return int(self.lib.mcdma_rpc_wait_word(addr, 0, 0, 0, 0))
+
+    def wait(self, addr: int, seq: int, equal: bool, spin: int, timeout: int) -> int:
+        """The word once its sequence equals ``seq`` (or, ``equal`` False, is non-zero and differs); 0 on timeout."""
+
+        return int(self.lib.mcdma_rpc_wait_word(addr, seq, 1 if equal else 0, spin, timeout))
+
+
+class Mailbox:
+    """One link's mailbox mapped shared: the daemon's ``/dev/shm/mcdma-rpc.NAME`` (``TF_AFD_MCDMA_SHM_DIR`` moves it).
+    Containers need the host's /dev/shm (``--ipc=host``, or ``-v /dev/shm:/dev/shm``)."""
+
+    def __init__(self, name: str, words: Words, shm_dir: str | None = None, wait_s: float = 10.0) -> None:
+        if not re.fullmatch(r"[A-Za-z0-9_-]{1,32}", name):
+            raise ValueError(f"MCDMA link name {name!r}: letters, digits, '-' and '_' only")
+        self.name, self.words = name, words
+        self.path = os.path.join(shm_dir or _env(SHM_ENV, "/dev/shm"), f"mcdma-rpc.{name}")
+        try:
+            fd = os.open(self.path, os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC)
+        except FileNotFoundError:
+            raise LinkError(f"no mailbox {self.path}: start mcdma-rpcd for link {name} first, and give the "
+                            "container the host's /dev/shm (--ipc=host or -v /dev/shm:/dev/shm)") from None
+        try:
+            st = os.fstat(fd)
+            self.size, self.ino = st.st_size, st.st_ino
+            if self.size <= 2 * CTRL:
+                raise LinkError(f"mailbox {self.path} is {self.size} bytes: not an mcdma-rpcd mailbox")
+            self.mm = mmap.mmap(fd, self.size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
+        finally:
+            os.close(fd)
+        end = time.monotonic() + wait_s
+        while True:                          # a daemon writes the sizes right after it creates the mailbox
+            self.req, self.rep = struct.unpack_from("<QQ", self.mm, SIZES)
+            if self.req and self.rep:
+                break
+            if time.monotonic() >= end:
+                break
+            time.sleep(0.1)
+        if (self.req + self.rep != self.size or self.req % SEG or self.rep % SEG or self.req <= CTRL
+                or self.rep <= CTRL):
+            raise LinkError(f"mailbox {self.path}: sizes R={self.req} P={self.rep} do not describe its {self.size} "
+                            "bytes (not a protocol-1 mailbox, or its daemon is still starting)")
+        self._anchor = ctypes.c_char.from_buffer(self.mm)    # pins the mapping for the process's life
+        self.base = ctypes.addressof(self._anchor)
+        self.req_word = self.base + REQ_WORD
+        self.done = self.base + self.req + DONE
+        self.staged = self.base + self.req + STAGED
+        self._req_bytes = self._rep_bytes = None
+
+    def replaced(self) -> bool:
+        """The daemon made a new mailbox under our path (a connect daemon unlinks and recreates it at start):
+        this mapping will never see another reply."""
+
+        try:
+            return os.stat(self.path).st_ino != self.ino
+        except OSError:
+            return True
+
+    def plain(self, off: int) -> int:
+        """A status value (link-up, generation): plain u64s the connect daemon stores, not words."""
+
+        return ctypes.c_uint64.from_address(self.base + off).value
+
+    def header(self) -> tuple:
+        return struct.unpack_from(HDR_FMT, self.mm, CTRL)
+
+    @property
+    def req_bytes(self):
+        """The request payload (after the control page) as a CPU uint8 tensor over the mapping."""
+
+        if self._req_bytes is None:
+            import torch
+
+            self._req_bytes = torch.frombuffer(self.mm, dtype=torch.uint8, count=self.req - CTRL, offset=CTRL)
+        return self._req_bytes
+
+    @property
+    def rep_bytes(self):
+        if self._rep_bytes is None:
+            import torch
+
+            self._rep_bytes = torch.frombuffer(self.mm, dtype=torch.uint8, count=self.rep - CTRL,
+                                               offset=self.req + CTRL)
+        return self._rep_bytes
+
+    def check_room(self, layout: Layout, rows: int) -> None:
+        """Refuse to start when the widest window (``rows``, the prompt chunk) does not fit this mailbox."""
+
+        need_req, need_rep = layout.req(rows), layout.rep(rows)
+        if need_req > self.req - CTRL or need_rep > self.rep - CTRL:
+            q, p = layout.mib(rows)
+            raise LinkError(f"mailbox {self.path} ({self.req >> 20}+{self.rep >> 20} MiB) cannot carry a {rows}-row "
+                            f"window ({need_req} request + {need_rep} reply bytes): run mcdma-rpcd with "
+                            f"req_mib>={q} rep_mib>={p} on both ends of link {self.name}")
+
+
+def _snapshot(dq) -> list:
+    """A copy of a deque another thread appends to (a mutation mid-copy raises; copy again)."""
+
+    for _ in range(100):
+        try:
+            return list(dq)
+        except RuntimeError:
+            continue
+    return []
+
+
+class AttentionLinks:
+    """The attention node's (connect) end of both links. ``issue`` puts one packed request into every mailbox and
+    rings it; ``collect`` waits for every reply and copies it to the device. GPU mode does both as stream operations
+    (no host sync); CPU mode syncs, then stores and spins on the host. ``health`` and ``release`` serve the
+    watchdog."""
+
+    def __init__(self, names: list[str], *, words: Words | None = None, driver=None, mode: str = "cpu",
+                 stream=None, timeout: float | None = None, shm_dir: str | None = None, flags: int = 0,
+                 linkup_wait: float = LINKUP_WAIT, log=print) -> None:
+        self.names, self.mode, self.driver, self.flags = list(names), mode, driver, flags
+        if mode == "gpu" and driver is None:
+            raise ValueError("GPU-driven MCDMA needs the CUDA driver binding")
+        self.words = words or Words()
+        self.boxes = [Mailbox(n, self.words, shm_dir) for n in self.names]
+        end = time.monotonic() + linkup_wait
+        for box in self.boxes:
+            while box.plain(LINK_UP) != 1:
+                if time.monotonic() >= end:
+                    raise LinkError(f"link {box.name} is not up after {linkup_wait:.0f} s (connect daemon's link-up "
+                                    "word 0): is mcdma-rpcd listen running on that expert node?")
+                time.sleep(0.1)
+        self.gen = [box.plain(GENERATION) for box in self.boxes]
+        # the connect daemon resends only a sequence that differs from its last; its last is the request word's
+        self.base = [next_seq(word_seq(self.words.load(box.req_word))) for box in self.boxes]
+        self.seq = [prev_seq(b) for b in self.base]          # the last issued; the first issue uses the base
+        self.count = [0] * len(self.boxes)
+        self.pending = [collections.deque(maxlen=PENDING_MAX) for _ in self.boxes]   # GPU mode: (seq, reply bytes)
+        from .mcdma_cuda import _register
+
+        self.dptr = [_register(driver, box, mode == "gpu", log) for box in self.boxes]
+        self.stream = stream
+        self.timeout = timeout_s() if timeout is None else float(timeout)
+        self.spin = spin_ns()
+        self.failed: str | None = None
+        self._last = [(0, 0)] * len(self.boxes)
+        self._since = [time.monotonic()] * len(self.boxes)
+        self._lock = threading.Lock()
+        self._releasing = False
+
+    def check_room(self, layout: Layout, rows: int) -> None:
+        for box in self.boxes:
+            box.check_room(layout, rows)
+
+    def _stream(self) -> int:
+        if self.stream is not None:
+            return self.stream()
+        import torch
+
+        return torch.cuda.current_stream().cuda_stream
+
+    # -- the exchange --------------------------------------------------------------------------------------------
+    def issue(self, req, n: int, rep_len: int) -> None:
+        """``req``: the packed request (``n`` bytes, a device uint8 tensor) to every link, then its word."""
+
+        if self.mode == "gpu":
+            h = self._stream()
+            for k, box in enumerate(self.boxes):
+                box.req_bytes[:n].copy_(req, non_blocking=True)
+                s = next_seq(self.seq[k])
+                self.pending[k].append((s, rep_len))
+                self.driver.write64(h, self.dptr[k] + REQ_WORD, word(s, n))   # fenced: the copy lands first
+                self.seq[k] = s
+                self.count[k] += 1
+            if self.failed is not None:                     # released while this was enqueued: release it too
+                self.release()
+            return
+        for box in self.boxes:
+            box.req_bytes[:n].copy_(req)                    # blocking: the forward so far, then these bytes
+        for k, box in enumerate(self.boxes):
+            s = next_seq(self.seq[k])
+            self.words.store(box.req_word, word(s, n))
+            self.seq[k] = s
+            self.count[k] += 1
+
+    def collect(self, outs, rep_len: int) -> None:
+        """Each link's reply (``rep_len`` bytes) into ``outs[k]`` (device uint8 views), in link order."""
+
+        if self.mode == "gpu":
+            h = self._stream()
+            for k, box in enumerate(self.boxes):
+                self.driver.wait64(h, self.dptr[k] + box.req + DONE, word(self.seq[k], rep_len),
+                                   CU_STREAM_WAIT_VALUE_EQ | self.flags)
+                outs[k].copy_(box.rep_bytes[:rep_len], non_blocking=True)
+            return
+        for k, box in enumerate(self.boxes):
+            self._wait(k, rep_len)
+            outs[k].copy_(box.rep_bytes[:rep_len], non_blocking=True)   # ordered before the next issue's sync
+
+    def _wait(self, k: int, rep_len: int) -> None:
+        box, want = self.boxes[k], self.seq[k]
+        start = time.monotonic()
+        while True:
+            w = self.words.wait(box.done, want, True, self.spin, SLICE_NS)
+            if w:
+                if word_len(w) != rep_len:
+                    raise LinkError(f"link {box.name}: reply {want} is {word_len(w)} bytes, not {rep_len} (0 = the "
+                                    "daemon refused a request larger than its mailbox)")
+                return
+            if self.failed is not None:
+                raise LinkError(self.failed)
+            why = self.health()
+            if why:
+                raise LinkError(why)
+            if time.monotonic() - start > self.timeout:
+                raise LinkError(f"link {box.name}: no reply to request {want} in {self.timeout:.0f} s "
+                                "(expert hung, or a daemon down)")
+
+    # -- the watchdog's side -------------------------------------------------------------------------------------
+    def health(self) -> str:
+        """'' while every link is up, on its first generation and answering; else why not."""
+
+        now = time.monotonic()
+        with self._lock:
+            for k, box in enumerate(self.boxes):
+                if box.replaced():
+                    return (f"link {box.name}: mailbox {box.path} was replaced or removed (its daemon restarted or "
+                            "stopped): requests in flight are lost")
+                up = box.plain(LINK_UP)
+                if up != 1:
+                    return f"link {box.name} is down (connect daemon link-up word {up})"
+                g = box.plain(GENERATION)
+                if g != self.gen[k]:
+                    return (f"link {box.name} reconnected (generation {self.gen[k]} -> {g}): requests in flight "
+                            "were lost")
+                r = word_seq(self.words.load(box.req_word))
+                d = word_seq(self.words.load(box.done))
+                if self.count[k] and r != d:
+                    if (r, d) != self._last[k]:
+                        self._last[k], self._since[k] = (r, d), now
+                    elif now - self._since[k] > self.timeout:
+                        return (f"link {box.name}: request {r} unanswered for {now - self._since[k]:.0f} s "
+                                "(expert hung, or a daemon down)")
+                else:
+                    self._last[k], self._since[k] = (r, d), now
+                self._trim(k, d)
+        return ""
+
+    def _trim(self, k: int, done: int) -> None:
+        pend = self.pending[k]
+        if not pend or done not in {s for s, _ in _snapshot(pend)}:
+            return
+        while pend:
+            s, _ = pend.popleft()
+            if s == done:
+                break
+
+    def release(self) -> None:
+        """Abort: no request may wait for an answer that will not come. CPU mode just fails the waits; GPU mode
+        answers every enqueued stream wait itself so the serving stream drains (the in-flight forward's partials
+        are garbage, and the next begin refuses)."""
+
+        self.failed = self.failed or "the MCDMA links were aborted"
+        if self.mode != "gpu":
+            return
+        with self._lock:
+            if self._releasing:
+                return
+            self._releasing = True
+        threading.Thread(target=self._release_loop, daemon=True, name="afd-mcdma-release").start()
+
+    def _release_loop(self, budget: float = 30.0, grace: float = 2.0) -> None:
+        try:
+            end, quiet = time.monotonic() + budget, None
+            while time.monotonic() < end:
+                busy = False
+                for k, box in enumerate(self.boxes):
+                    pend = _snapshot(self.pending[k])
+                    if not pend:
+                        continue
+                    d = word_seq(self.words.load(box.done))
+                    if d == pend[-1][0]:
+                        continue
+                    busy = True
+                    r = word_seq(self.words.load(box.req_word))      # the newest request the stream issued
+                    if r != d:
+                        for s, n in pend:
+                            if s == r:
+                                self.words.store(box.done, word(s, n))
+                                break
+                if busy:
+                    quiet = None
+                elif quiet is None:
+                    quiet = time.monotonic()
+                elif time.monotonic() - quiet > grace:     # a late genuine reply could still rewind a done word
+                    return
+                time.sleep(0.0005)
+        finally:
+            with self._lock:
+                self._releasing = False
+
+
+class ExpertLink:
+    """An expert node's (listen) end of its link: the listen daemon's registered ``MODE poll`` service, the request
+    wait, the reply stage. Requests come strictly one at a time, so the service counts the sequence itself."""
+
+    def __init__(self, name: str, *, words: Words | None = None, driver=None, mode: str = "cpu",
+                 socket_path: str | None = None, shm_dir: str | None = None, stream=None, flags: int = 0,
+                 log=print) -> None:
+        self.name, self.mode, self.driver, self.flags = name, mode, driver, flags
+        if mode == "gpu" and driver is None:
+            raise ValueError("GPU-driven MCDMA needs the CUDA driver binding")
+        self.words = words or Words()
+        self.box = Mailbox(name, self.words, shm_dir)
+        # both words empty before registering: the daemon takes the staged word's sequence at attach as its last
+        # sent, and a stale request word must never pass for this run's first request
+        self.words.store(self.box.req_word, 0)
+        self.words.store(self.box.staged, 0)
+        self.socket_path = socket_path or _env(SOCKET_ENV) or f"/tmp/mcdma-rpcd.{name}.sock"
+        self.sock = self._register(self.socket_path)
+        from .mcdma_cuda import _register
+
+        self.dptr = _register(driver, self.box, mode == "gpu", log)
+        self.stream = stream
+        self.spin = spin_ns()
+        self.base = 1
+
+    def _register(self, path: str) -> socket.socket:
+        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        s.settimeout(5.0)
+        try:
+            s.connect(path)
+            s.sendall(b"MODE poll\n")
+            line = b""
+            while not line.endswith(b"\n") and len(line) < 256:
+                got = s.recv(1)
+                if not got:
+                    break
+                line += got
+        except OSError as exc:
+            s.close()
+            raise LinkError(f"cannot register with the listen daemon of link {self.name} at {path} ({exc}): is "
+                            f"mcdma-rpcd listen running, and its socket mounted ({SOCKET_ENV})?") from None
+        if line.strip() != b"OK":
+            s.close()
+            raise LinkError(f"the listen daemon of link {self.name} refused the service: {line.strip()!r} "
+                            "('ERR busy' = another service holds the link)")
+        s.setblocking(False)
+        return s
+
+    def alive(self) -> str:
+        """'' while the registration stands; else why it ended (the daemon says BYE, or closes, when the link drops)."""
+
+        try:
+            data = self.sock.recv(256)
+        except BlockingIOError:
+            return ""
+        except OSError as exc:
+            return f"service socket error {exc}"
+        if not data:
+            return "the listen daemon closed the service socket (it stopped, or dropped the link)"
+        if b"BYE" in data:
+            return "the listen daemon ended the registration (BYE): the link dropped, requests in flight are lost"
+        return ""
+
+    def check_room(self, layout: Layout, rows: int) -> None:
+        self.box.check_room(layout, rows)
+
+    def _stream(self) -> int:
+        if self.stream is not None:
+            return self.stream()
+        import torch
+
+        return torch.cuda.current_stream().cuda_stream
+
+    def wait(self, seq: int) -> int:
+        """Host wait for request ``seq`` (as long as the attention idles), checking the registration between slices."""
+
+        while True:
+            w = self.words.wait(self.box.req_word, seq, True, self.spin, SLICE_NS)
+            if w:
+                return w
+            why = self.alive()
+            if why:
+                raise LinkError(f"link {self.name}: {why}")
+
+    def stage(self, seq: int, n: int) -> None:
+        self.words.store(self.box.staged, word(seq, n))
+
+    def wait_gpu(self, seq: int, n: int) -> None:
+        self.driver.wait64(self._stream(), self.dptr + REQ_WORD, word(seq, n), CU_STREAM_WAIT_VALUE_EQ | self.flags)
+
+    def stage_gpu(self, seq: int, n: int) -> None:
+        self.driver.write64(self._stream(), self.dptr + self.box.req + STAGED, word(seq, n))
+
+    def close(self) -> None:
+        try:
+            self.sock.close()
+        except OSError:
+            pass
