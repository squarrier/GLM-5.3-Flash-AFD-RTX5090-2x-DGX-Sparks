index 0000000..7f849be
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/afd.py
@@ -0,0 +1,394 @@
+"""The attention node's half of the attention/expert split: the engine hooks over the MCDMA wire.
+
+The attention node is AFD rank 0 of 3; each expert node is its TP2 half plus one. ``AfdWire`` is what the engine
+calls: ``begin`` before every forward's eager kernels, then ``exchange`` and ``collect`` around each MoE layer's
+shared expert in ``forward.moe_block`` (through ``Weights.afd``). It keeps the store, the settings handshake, the
+watchdog, the forward's ``seq``/``rows``/``mode``, the wire check and the exchange timer; the wire itself is an
+``afd_transport.ExpertTransport``, MCDMA's link daemons (``afd_mcdma``). Idle waits are on the TCPStore, never a spin on the wire. ``TF_AFD_CHECK=1`` hashes both sides' wire tensors for
+the first ``TF_AFD_CHECK_FORWARDS`` forwards and compares them through the store; ``TF_AFD_TIME=1`` events-times
+each layer's exchange and prints a p50 every so often.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import threading
+import time
+from datetime import timedelta
+
+from .afd_transport import WireError
+
+# the header's mode word: the attention sends only these two, and the experts refuse any other value
+MODE_EAGER = 1          # an eager window
+MODE_CHUNK = 3          # a prompt chunk: eager, the expert's wide scratch
+CHECK_ENV = "TF_AFD_CHECK"
+TIME_ENV = "TF_AFD_TIME"
+CHECK_FORWARDS = int(os.environ.get("TF_AFD_CHECK_FORWARDS", "4096"))
+ALIVE_EVERY = 5         # s between an expert's store heartbeats
+ALIVE_STALE = 20        # s of silence before the attention's watchdog calls an expert dead
+WATCH_EVERY = 2         # s between watchdog polls
+
+
+def moe_layers(cfg) -> list[int]:
+    """The checkpoint's MoE layer indices, the expert nodes' layers in order."""
+
+    return [i for i, kind in enumerate(cfg.mlp_kinds) if kind == "moe"]
+
+
+def settings_for(model_dir, cfg, *, prefill_rows: int) -> dict:
+    """Everything both sides must agree on before the first forward; a mismatch refuses to start."""
+
+    from pathlib import Path
+
+    index = Path(model_dir) / "model.safetensors.index.json"
+    digest = hashlib.sha256(index.read_bytes()).hexdigest() if index.is_file() else ""
+    return {"digest": digest, "layers": moe_layers(cfg), "max_rows": 8, "mtp": 0, "prefill_rows": int(prefill_rows),
+            "quant": cfg.quant, "experts": cfg.experts, "top_k": cfg.top_k}
+
+
+def settings_mismatch(mine: dict, theirs: dict) -> str:
+    """The first differing settings key, or "" (every key must be equal; the attention's value names the print)."""
+
+    for key in sorted(set(mine) | set(theirs)):
+        if mine.get(key) != theirs.get(key):
+            return f"{key}: attention {theirs.get(key)!r} != expert {mine.get(key)!r}"
+    return ""
+
+
+def wait_store(store, keys: list[str], seconds: float, every: float = 30.0) -> None:
+    """``store.wait`` with the idle timeout retried until ``seconds`` elapse."""
+
+    end = time.monotonic() + seconds
+    while True:
+        try:
+            store.wait(keys, timedelta(seconds=every))
+            return
+        except Exception as exc:  # noqa: BLE001  the idle timeout; anything else is real
+            if "timeout" not in str(exc).lower() or time.monotonic() >= end:
+                raise
+
+
+def client(host: str, port: int, seconds: float = 5.0):
+    """A store client of our own: short ops (the comm's shared store wedges; 5 s beats the 300 s default)."""
+
+    from torch.distributed import TCPStore
+
+    return TCPStore(host, port, is_master=False, timeout=timedelta(seconds=seconds), wait_for_workers=False)
+
+
+class Store:
+    """The protocol's store: short timeouts, and one fresh-client retry when an op stalls or drops."""
+
+    def __init__(self, host: str, port: int) -> None:
+        self.host, self.port = host, port
+        self.s = client(host, port)
+
+    def _fresh(self) -> None:
+        try:
+            self.s.close()
+        except Exception:  # noqa: BLE001
+            pass
+        self.s = client(self.host, self.port)
+
+    def get(self, key: str):
+        try:
+            if not self.s.check([key]):          # an absent key: get would block the full timeout on it
+                raise KeyError(key)
+            return self.s.get(key)
+        except Exception:  # noqa: BLE001  a stall or a dropped socket: once more, on a new connection
+            self._fresh()
+            if not self.s.check([key]):
+                raise KeyError(key)  # noqa: B904
+            return self.s.get(key)
+
+    def set(self, key: str, value) -> None:
+        try:
+            self.s.set(key, value)
+        except Exception:  # noqa: BLE001
+            self._fresh()
+            self.s.set(key, value)
+
+    def wait(self, keys: list[str], timeout) -> None:  # noqa: ANN001  timedelta passthrough
+        try:
+            self.s.wait(keys, timeout)
+        except Exception:  # noqa: BLE001
+            self._fresh()
+            self.s.wait(keys, timeout)
+
+    def check(self, keys: list[str]) -> bool:
+        try:
+            return bool(self.s.check(keys))
+        except Exception:  # noqa: BLE001
+            self._fresh()
+            return bool(self.s.check(keys))
+
+
+def get_store(store, key: str, seconds: float = 10.0):
+    """A store value once it appears, else None; the handshake's and the check's patient read."""
+
+    end = time.monotonic() + seconds
+    while True:
+        try:
+            return store.get(key)
+        except Exception:  # noqa: BLE001  a missing key or a hiccup: retry until the budget is gone
+            if time.monotonic() >= end:
+                return None
+            time.sleep(0.05)
+
+
+def sha(tensor) -> str:
+    """sha256 of a tensor's bytes, the wire check's atom (call on a contiguous tensor; syncs)."""
+
+    import torch
+
+    return hashlib.sha256(tensor.detach().contiguous().view(torch.uint8).cpu().numpy().tobytes()).hexdigest()
+
+
+def p50_p90(v: list[float]) -> tuple[float, float]:
+    """The sample set's p50 and p90; empty samples read 0."""
+
+    s = sorted(v)
+    if not s:
+        return 0.0, 0.0
+    return s[len(s) // 2], s[min(len(s) - 1, int(len(s) * 0.9))]
+
+
+class Solo:
+    """The engine's no-op stand-in for a tensor-parallel link: world 1, every collective local."""
+
+    world = 1
+
+    def barrier(self) -> None:
+        pass
+
+    def ready(self, label: str, **_: object) -> None:
+        pass
+
+    def all_gather(self, send, recv) -> None:
+        recv[:send.numel()].copy_(send.view(-1).to(recv.dtype))
+
+
+def make_afd(master: str, port: int, model_dir=None):
+    """The attention node's AFD: ``AfdWire`` over the MCDMA wire."""
+
+    return AfdWire(master, port, model_dir)
+
+
+class AfdWire:
+    """The attention node's side: the engine hooks, the watchdog and the wire check, over an ``ExpertTransport``."""
+
+    def __init__(self, master: str, port: int, model_dir=None, transport=None) -> None:
+        import torch
+
+        from tensorfold.server.errors import CapacityError
+
+        if transport is None:                    # rank 0 hosts the store; both experts join before this returns
+            from .afd_transport import transport_for
+
+            transport = transport_for(master=master, port=port, model_dir=model_dir)
+        self.tr = transport
+        self._cap = CapacityError
+        self.torch = torch
+        self.host, self.port = master, port
+        local = "127.0.0.1"                      # our own clients over the loopback: the host-ip hairpin stalls
+        self.store = Store(local, port)          # short-timeout, self-healing clients for the bells and the checks
+        self._addr = local
+        self._wstore = None                      # the watchdog's own client: one socket per thread
+        self.peers = (1, 2)
+        self.seq = 0
+        self.layer = 0                           # the exchange's index within the forward
+        self.nlayers = 0                         # the MoE exchanges a forward makes, once announced
+        self.rows = self.mode = 0
+        self.dead: str | None = None
+        self.check = os.environ.get(CHECK_ENV, "").strip() == "1"
+        self.checked = 0
+        self.mismatches = 0
+        self._seen: set[int] = set()             # the window widths the check covered, for the check's summary line
+        self._chk: list | None = None
+        self._why = ""
+        self.timing = os.environ.get(TIME_ENV, "").strip() == "1"
+        self._times: dict[int, list[float]] = {}
+        self._timed = 0
+        self.ev = [(torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)) for _ in range(64)] \
+            if self.timing else None
+        self._alive: dict[int, float] = {}
+        self._quiet = {r: 0.0 for r in self.peers}    # s since the peer's stamp changed: clock-free liveness
+        threading.Thread(target=self._watchdog, daemon=True, name="afd-watchdog").start()
+        self.tr.start(self.store)
+        print(f"[tensorfold] {self.tr.describe()}", flush=True)
+
+    # -- startup -------------------------------------------------------------------------------------------------
+    def announce(self, settings: dict) -> None:
+        """The settings both sides must agree on, plus the wire's own; the experts size off them."""
+
+        self.nlayers = len(settings["layers"])
+        self.store.set("afd_settings", json.dumps(dict(settings, **self.tr.publish(settings))).encode())
+
+    def wait_loaded(self, seconds: float = 3600.0) -> None:
+        """Both expert halves' weights resident; from here the first warm-up forward can run the wire for real."""
+
+        wait_store(self.store, [f"afd_loaded/{r}" for r in self.peers], seconds)
+
+    # -- watchdogs -----------------------------------------------------------------------------------------------
+    def die(self, why: str) -> None:
+        if self.dead is None:
+            self.dead = why
+            print(f"[tensorfold] afd: {why}; in-flight requests fail, restart the serving stack", flush=True)
+            try:
+                self.tr.abort()
+            except Exception:  # noqa: BLE001  already gone
+                pass
+
+    def _watchdog(self) -> None:
+        store = self._wstore = Store(self._addr, self.port)
+        while self.dead is None:
+            time.sleep(WATCH_EVERY)
+            try:
+                why = self.tr.health()           # the MCDMA links' health
+            except Exception as exc:  # noqa: BLE001  the wire itself is gone
+                why = f"watchdog lost the {self.tr.name} wire: {exc!r}"
+            if why:
+                self.die(why)
+                return
+            for peer in self.peers:
+                try:
+                    stamp = float(store.get(f"afd_alive/{peer}"))
+                except Exception:  # noqa: BLE001  no stamp yet, or a hiccup: judge on the last one
+                    continue
+                if stamp != self._alive.get(peer):     # the stamp's CHANGE is the beat: no cross-host clocks
+                    self._alive[peer] = stamp
+                    self._quiet[peer] = 0.0
+                else:
+                    self._quiet[peer] += WATCH_EVERY
+                if self._quiet[peer] > ALIVE_STALE:
+                    self.die(f"expert rank {peer} silent for {ALIVE_STALE:.0f}s (heartbeat unchanged)")
+                    return
+                try:
+                    dead = store.get(f"afd_error/{peer}")
+                except Exception:  # noqa: BLE001
+                    dead = None
+                if dead:
+                    self.die(f"expert rank {peer} failed: {bytes(dead).decode(errors='replace')}")
+                    return
+
+    def _fail(self, exc: WireError):
+        self.die(exc.why)
+        raise self._cap(f"the AFD expert link failed ({exc}); restart the serving stack") from exc
+
+    # -- the forward's host side ---------------------------------------------------------------------------------
+    def begin(self, rows: int, *, chunk: bool = False) -> None:
+        """The forward's header to both experts, before this forward's eager kernels."""
+
+        if self.dead is not None:
+            raise self._cap(f"the AFD expert nodes are gone ({self.dead}); restart the serving stack")
+        if self.layer not in (0, self.nlayers):
+            why = f"a forward stopped after {self.layer} of {self.nlayers} MoE exchanges; the experts are out of step"
+            self.die(why)
+            raise self._cap(f"the AFD expert nodes are gone ({why}); restart the serving stack")
+        if self.check:
+            self._finish_check()
+        if self.timing:
+            self._sample_times()
+        self.seq += 1
+        self.layer = 0
+        self.rows = rows
+        mode = MODE_CHUNK if chunk else MODE_EAGER
+        self.mode = mode
+        self.tr.header(self.seq, rows, mode)
+
+    def forces_eager(self) -> bool:
+        """Always: the AFD wire runs every window eager; graphs.py captures nothing for it."""
+
+        return True
+
+    def exchange(self, b, rows: int) -> None:
+        """The send half: ``normed/pick/wts`` to each expert; the layer's shared expert runs while it flies."""
+
+        if self.timing and self.ev is not None and self.layer < len(self.ev):
+            self.ev[self.layer][0].record()
+        if self.check and self.checked < CHECK_FORWARDS:
+            self._chk = self._chk or []
+            self._chk.append([b.normed[:rows].clone(), b.pick[:rows].clone(), b.wts[:rows].clone(), None, None])
+        try:
+            self.tr.send(b, rows, self.layer)
+        except WireError as exc:
+            self._fail(exc)
+        self.layer += 1
+
+    def collect(self, b, rows: int, d: int):
+        """The receive half: both routed partial, slot 2 = the shared expert; ``[3, rows, D]`` for ``hc_post``."""
+
+        if self.timing and self.ev is not None and 0 < self.layer <= len(self.ev):
+            self.ev[self.layer - 1][1].record()
+        n = rows * d
+        flat = b.afd_recv.view(-1)
+        try:
+            self.tr.recv(flat[:n].view(rows, d), flat[n:2 * n].view(rows, d), self.layer - 1)
+        except WireError as exc:
+            self._fail(exc)
+        flat[2 * n:3 * n].view(rows, d).copy_(b.sy[:rows])
+        if self.check and self._chk is not None:
+            self._chk[-1][3] = flat[:n].clone()          # rank 1's partial, to meet that expert's sent hash
+            self._chk[-1][4] = flat[n:2 * n].clone()     # rank 2's
+        return b.afd_recv[:3 * n].view(3, rows, d)
+
+    # -- the wire check ------------------------------------------------------------------------------------------
+    def _finish_check(self) -> None:
+        pend, self._chk = self._chk, None
+        if not pend:
+            return
+        self.checked += 1
+        self._seen.add(self.rows)
+        self.torch.cuda.synchronize()
+        theirs = []
+        for peer in self.peers:
+            raw = get_store(self.store, f"afd_chk/{self.seq}/{peer}", 15.0)
+            theirs.append(json.loads(bytes(raw).decode()) if raw else None)
+        bad = layers = 0
+        first = ""
+        for i, row in enumerate(pend):
+            layers += 1
+            mine = [sha(row[0]), sha(row[1]), sha(row[2])]
+            for peer, blob in enumerate(theirs):
+                if not blob:
+                    bad += 1
+                    continue
+                got = blob["in"][i] if i < len(blob["in"]) else []
+                for k, (a, b) in enumerate(zip(mine, got[:3])):
+                    if a != b:
+                        bad += 1
+                        if not first:
+                            first = f"layer {i} peer {peer} in{k}: {a[:8]} vs {b[:8] if isinstance(b, str) else b}"
+                out = blob["out"][i] if i < len(blob["out"]) else ""
+                if out and out != sha(row[3 + peer]):
+                    bad += 1
+                    if not first:
+                        first = f"layer {i} peer {peer} out: {sha(row[3 + peer])[:8]} vs {out[:8]}"
+        self.mismatches += bad
+        if bad and not self._why:
+            self._why = first          # the first difference, printed once, naming the cause
+            print(f"[tensorfold] afd-check first mismatch: {first}", flush=True)
+        if self.checked == CHECK_FORWARDS:
+            print(f"[tensorfold] afd-check: window complete, {CHECK_FORWARDS} forwards, "
+                  f"{self.mismatches} mismatches total, rows checked {sorted(self._seen)}", flush=True)
+        if bad:
+            print(f"[tensorfold] afd-check seq {self.seq}: {bad} mismatches over {layers} layers x 4 hashes",
+                  flush=True)
+
+    # -- TF_AFD_TIME: the exchange's device time per layer -------------------------------------------------------
+    def _sample_times(self) -> None:
+        if self.ev is None:
+            return
+        for a, b in self.ev[:max(self.layer, 0)]:
+            try:
+                dt = a.elapsed_time(b) * 1e3
+            except Exception:  # noqa: BLE001  not both recorded yet
+                continue
+            self._times.setdefault(self.rows, []).append(dt)
+        self._timed += 1
+        if self._timed % 256 == 0 and self._times:
+            parts = ", ".join(f"R{r} p50 {p50_p90(v)[0]:.1f}us n{len(v)} p90 {p50_p90(v)[1]:.1f}"
+                              for r, v in sorted(self._times.items()))
+            print(f"[tensorfold] afd exchange per layer: {parts}", flush=True)
