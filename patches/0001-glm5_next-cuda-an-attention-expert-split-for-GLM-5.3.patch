--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/afd_mcdma.py
@@ -0,0 +1,267 @@
+"""The AFD wire over MCDMA link daemons: eager windows.
+
+The attention node is the connect end of both links (``McdmaTransport``): per MoE layer one packed request
+``[header | normed | pick | pad | wts]`` into both mailboxes, then both fp32 replies back, as stream memory
+operations where the probe passes (``mcdma_cuda``). Each expert node is the listen end of its own link
+(``McdmaExpertLink``), opened before its weights load; the first request of a forward is its doorbell. The
+three-rank TCPStore (``StoreComm``) is the rendezvous; the handshake, the heartbeats and error keys, and the wire
+check and timer are ``afd.AfdWire``'s and ``experts_node.serve``'s.
+"""
+
+from __future__ import annotations
+
+from . import mcdma, mcdma_cuda
+from .afd import MODE_CHUNK, MODE_EAGER, get_store
+from .afd_transport import WireError
+
+
+def _bytes(t):
+    """A contiguous tensor's bytes as a flat uint8 view (no copy)."""
+
+    import torch
+
+    return t.reshape(-1).view(torch.uint8)
+
+
+class StoreComm:
+    """The AFD's rendezvous: the three-rank TCPStore (rank 0 hosts it and waits for both experts), and abort
+    (release the waits)."""
+
+    def __init__(self, rank: int, world: int, master: str, port: int, links=None) -> None:
+        from datetime import timedelta
+
+        from torch.distributed import TCPStore
+
+        self.rank, self.world, self.links = rank, world, links
+        self.store = TCPStore(master, port, world, rank == 0, timeout=timedelta(seconds=600))
+
+    def async_error(self) -> str:
+        return self.links.health() if self.links is not None else ""
+
+    def abort(self) -> None:
+        if self.links is not None:
+            self.links.release()
+
+    def close(self) -> None:
+        pass
+
+
+class McdmaTransport:
+    """The attention node's end (``afd_transport.ExpertTransport``): one packed request per MoE layer to both expert
+    links, two replies back. ``links``, ``comm``, ``device`` and ``hidden`` stand in for a GPU host in the tests."""
+
+    name = "mcdma"
+
+    def __init__(self, master: str, port: int, model_dir=None, *, links=None, comm=None, device: str = "cuda",
+                 hidden: int | None = None) -> None:
+        import torch
+
+        if links is None:
+            names = mcdma.link_names()
+            torch.cuda.init()                              # torch's runtime; the context the register needs is made
+            ordinal = torch.cuda.current_device()          # current by CudaDriver.ensure_ctx (choose_mode, register)
+            mode, driver = mcdma_cuda.choose_mode(torch, ordinal)
+            flags = mcdma_cuda.flush_flag(driver, ordinal) if mode == "gpu" else 0
+            links = mcdma.AttentionLinks(names, driver=driver, mode=mode, flags=flags)   # fail fast, before the store
+        self.mc = links
+        self.torch = torch
+        self.device = device
+        self.hidden = hidden
+        if model_dir is not None:
+            from .weights import Config
+
+            self.hidden = Config.read(model_dir).hidden
+        self.layout = None
+        self.hdr_tab = self.hdr_tab_cpu = self.req_dev = self.zeros = None
+        self.down = False                                  # aborted: the forward in flight runs on without the wire
+        # rank 0 hosts the store and waits for both experts' clients
+        self.comm = comm if comm is not None else StoreComm(0, 3, master, port, links)
+
+    def publish(self, settings: dict) -> dict:
+        """The request buffers and the header table, sized for the widest window, which both mailboxes must carry
+        (else refuse to start); the transport and the link map, which the experts check against theirs."""
+
+        torch = self.torch
+        if self.hidden is None:
+            raise RuntimeError("the MCDMA wire needs the checkpoint's hidden size: build it with the model dir")
+        layers = len(settings["layers"])
+        rows = max(int(settings["prefill_rows"]), int(settings["max_rows"]))
+        self.layout = mcdma.Layout(self.hidden, int(settings["top_k"]) + 1)
+        self.mc.check_room(self.layout, rows)
+        dev = self.device
+        tab = torch.zeros((layers, mcdma.HDR_INTS), dtype=torch.int32, pin_memory=dev != "cpu")
+        tab[:, 0] = mcdma.WIRE_MAGIC
+        tab[:, 3] = torch.arange(layers, dtype=torch.int32)
+        tab[:, 5] = layers
+        self.hdr_tab_cpu = tab
+        self.hdr_tab = torch.zeros(tab.shape, dtype=torch.int32, device=dev)
+        self.req_dev = torch.empty((self.layout.req(rows),), dtype=torch.uint8, device=dev)
+        self.zeros = torch.zeros((mcdma.ALIGN,), dtype=torch.uint8, device=dev)
+        return {"transport": "mcdma", "mcdma_links": list(self.mc.names)}
+
+    def start(self, store) -> None:
+        for peer, base in zip((1, 2), self.mc.base):       # each expert counts its link's sequence from here
+            store.set(f"afd_mcdma/base/{peer}", str(base).encode())
+
+    def header(self, seq: int, rows: int, mode: int) -> None:
+        """No doorbell of its own: the first layer's request carries the forward. One blocking copy of the
+        forward's request headers."""
+
+        tab = self.hdr_tab_cpu
+        tab[:, 1] = seq & 0x7FFFFFFF
+        tab[:, 2] = rows
+        tab[:, 4] = mode
+        self.hdr_tab.copy_(tab)                  # blocking: the next forward's rewrite must not race this copy
+
+    def send(self, b, rows: int, layer: int) -> None:
+        """[header | normed | pick | pad | wts] packed on the device, then into both mailboxes."""
+
+        if self.down:
+            return
+        torch = self.torch
+        lay = self.layout
+        n = lay.req(rows)
+        parts = [self.hdr_tab[layer].view(torch.uint8), _bytes(b.normed[:rows]), _bytes(b.pick[:rows])]
+        pad = lay.pad(rows)
+        if pad:
+            parts.append(self.zeros[:pad])
+        parts.append(_bytes(b.wts[:rows]))
+        req = self.req_dev[:n]
+        torch.cat(parts, out=req)            # one kernel: the request contiguous for one copy per link
+        try:
+            self.mc.issue(req, n, lay.rep(rows))
+        except mcdma.LinkError as exc:
+            raise WireError(str(exc), f"MCDMA {exc}") from exc
+
+    def recv(self, dst1, dst2, layer: int) -> None:
+        """Rank 1's then rank 2's partial straight from the mailboxes."""
+
+        if self.down:
+            return
+        try:
+            self.mc.collect([_bytes(dst1), _bytes(dst2)], dst1.numel() * dst1.element_size())
+        except mcdma.LinkError as exc:
+            raise WireError(str(exc), f"MCDMA {exc}") from exc
+
+    def health(self) -> str | None:
+        try:
+            err = self.mc.health()
+        except Exception as exc:  # noqa: BLE001  a mailbox gone bad
+            return f"watchdog lost the MCDMA links: {exc!r}"
+        return f"MCDMA {err}" if err else None
+
+    def abort(self) -> None:
+        self.down = True
+        self.comm.abort()
+
+    def describe(self) -> str:
+        mc, box = self.mc, self.mc.boxes[0]
+        return (f"afd transport mcdma, {mc.mode}-driven{' +flush' if mc.flags else ''}: link {mc.names[0]} -> "
+                f"expert 1, {mc.names[1]} -> expert 2; mailboxes {box.req >> 20}+{box.rep >> 20} MiB; first sequences "
+                f"{mc.base}; generations {mc.gen}; no NCCL communicator")
+
+
+# -- the expert node -----------------------------------------------------------------------------------------------
+def open_expert_link(theirs: dict, rank: int, cfg, store, device: str = "cuda", log=print) -> McdmaExpertLink:
+    """The expert's end of its link, before its weights load (a missing daemon fails in seconds, not after the load):
+    the link the attention maps to this rank, room for the widest window, the daemon registration, the base."""
+
+    import torch
+
+    name = mcdma.link_name()
+    names = list(theirs.get("mcdma_links") or [])
+    if len(names) != 2 or names[rank - 1] != name:
+        raise SystemExit(f"[tensorfold] afd: expert {rank} serves MCDMA link {name!r} but the attention maps links "
+                         f"{names} to ranks 1, 2 ({mcdma.LINK_ENV} vs {mcdma.LINKS_ENV})")
+    cuda = str(device).startswith("cuda")
+    ordinal = 0
+    if cuda:
+        torch.cuda.init()
+        ordinal = torch.cuda.current_device()
+    mode, driver = mcdma_cuda.choose_mode(torch, ordinal, log=log) if cuda else ("cpu", None)
+    flags = mcdma_cuda.flush_flag(driver, ordinal) if mode == "gpu" else 0
+    link = mcdma.ExpertLink(name, driver=driver, mode=mode, flags=flags, log=log)
+    rows = int(theirs["prefill_rows"])
+    link.check_room(mcdma.Layout(cfg.hidden, cfg.top_k + 1), max(rows, int(theirs["max_rows"])))
+    raw = get_store(store, f"afd_mcdma/base/{rank}", 60.0)
+    if raw is None:
+        link.close()
+        raise RuntimeError(f"the attention published no MCDMA base sequence for expert {rank}")
+    link.base = int(bytes(raw).decode())
+    log(f"[tensorfold] afd expert {rank}: MCDMA link {name}, {mode}-driven{' +flush' if flags else ''}, mailbox "
+        f"{link.box.req >> 20}+{link.box.rep >> 20} MiB, socket {link.socket_path}, first sequence {link.base}",
+        flush=True)
+    return McdmaExpertLink(link, cfg.hidden, cfg.top_k + 1, len(theirs["layers"]), rows, device)
+
+
+class McdmaExpertLink:
+    """An expert node's end (``afd_transport.ExpertLink``) over its listen-end ``mcdma.ExpertLink``. A forward's first
+    request is awaited on the host: its header gives rows and mode. Every layer then lands the request (one copy)
+    and stages the partial back: as stream operations (GPU-driven: the later layers' requests are stream waits) or
+    with a host wait and one sync per layer (CPU-driven)."""
+
+    def __init__(self, link, hidden: int, slots: int, layers: int, prefill_rows: int, device: str = "cuda") -> None:
+        self.link, self.lay = link, mcdma.Layout(hidden, slots)
+        self.layers, self.prefill_rows, self.device = layers, prefill_rows, device
+        self.gpu = link.mode == "gpu"
+        self.seq = link.base                     # the next request's sequence
+        self.landing = None                      # the widest request's bytes past the header slot, on the device
+        self.fseq = self.rows = self.n_req = self.n_rep = 0
+        self.x = self.src = self.dst = self.rep = self._routed = self._out = None
+
+    def next_forward(self) -> tuple[int, int, int]:
+        import torch
+
+        link, lay, L = self.link, self.lay, self.layers
+        if self.landing is None:
+            self.landing = torch.empty((lay.req(self.prefill_rows) - mcdma.HDR_BYTES,), dtype=torch.uint8,
+                                       device=self.device)
+        w = link.wait(self.seq)
+        magic, fseq, rows, layer, mode, nl = link.box.header()[:6]
+        if (magic != mcdma.WIRE_MAGIC or layer != 0 or nl != L or not 1 <= rows <= self.prefill_rows
+                or mcdma.word_len(w) != lay.req(rows)):
+            raise mcdma.LinkError(f"link {link.name}: request {self.seq} is no forward's first: magic {magic:#x}, "
+                                  f"layer {layer} of {nl}, {rows} rows, {mcdma.word_len(w)} bytes (expected layer 0 "
+                                  f"of {L}, rows 1..{self.prefill_rows}, {lay.req(rows) if 0 < rows else '?'} bytes)")
+        if mode not in (MODE_EAGER, MODE_CHUNK):
+            raise mcdma.LinkError(f"link {link.name}: forward mode {mode}: the MCDMA wire carries eager windows only")
+        self.fseq, self.rows = fseq, rows
+        self.n_req, self.n_rep = lay.req(rows), lay.rep(rows)
+        self.x = lay.views(self.landing, rows)
+        self.src, self.dst = link.box.req_bytes[mcdma.HDR_BYTES:self.n_req], self.landing[:self.n_req - mcdma.HDR_BYTES]
+        self.rep = link.box.rep_bytes[:self.n_rep]
+        return fseq, rows, mode
+
+    def land(self, layer: int, views):
+        """The request into the landing buffer, one copy; the compute reads its sections there (not ``views``)."""
+
+        link = self.link
+        if layer:
+            if self.gpu:
+                link.wait_gpu(self.seq, self.n_req)
+            else:
+                w = link.wait(self.seq)
+                h = link.box.header()
+                if (h[0] != mcdma.WIRE_MAGIC or h[1] != self.fseq or h[2] != self.rows or h[3] != layer
+                        or mcdma.word_len(w) != self.n_req):
+                    raise mcdma.LinkError(f"link {link.name}: request {self.seq} header {h[:6]} is not layer {layer} "
+                                          f"of forward {self.fseq} ({self.rows} rows, {self.n_req} bytes)")
+        self.dst.copy_(self.src, non_blocking=True)    # the request, header slot skipped: normed | pick | pad | wts
+        return self.x
+
+    def reply(self, layer: int, routed) -> None:
+        if routed is not self._routed:
+            self._routed, self._out = routed, _bytes(routed)
+        if self.gpu:
+            self.rep.copy_(self._out, non_blocking=True)
+            self.link.stage_gpu(self.seq, self.n_rep)       # write-value's fence: the partial lands before the word
+        else:
+            self.rep.copy_(self._out)                       # blocking: the compute, then these bytes, before the word
+            self.link.stage(self.seq, self.n_rep)
+        self.seq = mcdma.next_seq(self.seq)
+
+    def health(self) -> str | None:
+        return self.link.alive() or None
+
+    def close(self) -> None:
+        self.link.close()
