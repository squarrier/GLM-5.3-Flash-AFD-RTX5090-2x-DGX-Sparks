@@ -0,0 +1,237 @@
+"""The AFD transport seam (``afd_transport``) and the engine hooks over it, on the CPU: the one wire (MCDMA) behind
+``make_afd``, the interface it implements, the calls ``AfdWire`` makes in order, the eager-only header modes, the
+watchdog's fault lines, and the expert's refusal of a mode or a wire it does not run."""
+
+from __future__ import annotations
+
+import inspect
+import json
+import time
+from datetime import timedelta
+
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from tensorfold.families.glm5_next.cuda import afd as afd_mod  # noqa: E402
+from tensorfold.families.glm5_next.cuda import afd_mcdma, afd_transport  # noqa: E402
+from tensorfold.server.errors import CapacityError  # noqa: E402
+from tests.glm_afd_fakes import (D, LAYERS, PREFILL, DictStore, FakeNode, buffers, fake_cfg, free_port,  # noqa: E402
+                                 settings)
+from tests.glm_afd_fakes import master_fixture  # noqa: E402, F401  (the master fixture)
+
+MEMBERS = ("name", "publish", "start", "header", "send", "recv", "health", "abort", "describe")
+LINK_MEMBERS = ("next_forward", "land", "reply", "health", "close")
+
+
+class Recorder:
+    """An ``ExpertTransport`` that records the calls ``AfdWire`` makes, in order; ``fail`` raises from ``send``,
+    ``err`` is what ``health`` reports (an exception: raised)."""
+
+    name = "recorder"
+
+    def __init__(self, fail: Exception | None = None) -> None:
+        self.calls: list = []
+        self.err: object = None
+        self.fail, self.aborted = fail, False
+
+    def publish(self, settings: dict) -> dict:
+        return {"transport": self.name}
+
+    def start(self, store) -> None:
+        self.calls.append(("start",))
+
+    def header(self, seq: int, rows: int, mode: int) -> None:
+        self.calls.append(("header", seq, rows, mode))
+
+    def send(self, b, rows: int, layer: int) -> None:
+        if self.fail is not None:
+            raise self.fail
+        self.calls.append(("send", rows, layer))
+
+    def recv(self, dst1, dst2, layer: int) -> None:
+        self.calls.append(("recv", tuple(dst1.shape), tuple(dst2.shape), layer))
+
+    def health(self) -> str | None:
+        if isinstance(self.err, Exception):
+            raise self.err
+        return self.err
+
+    def abort(self) -> None:
+        self.aborted = True
+
+    def describe(self) -> str:
+        return "afd transport recorder"
+
+
+def wired(port, tr=None):
+    a = afd_mod.AfdWire("127.0.0.1", port, transport=tr if tr is not None else Recorder())
+    a.announce(settings())
+    return a
+
+
+def wait_dead(a, s=5.0) -> None:
+    end = time.monotonic() + s
+    while a.dead is None and time.monotonic() < end:
+        time.sleep(0.01)
+
+
+# -- the seam: one wire --------------------------------------------------------------------------------------------
+def test_make_afd_builds_the_engine_hooks_over_mcdma(monkeypatch):
+    built, made = [], []
+    monkeypatch.setattr(afd_mcdma, "McdmaTransport", lambda **kw: built.append(kw) or "mcdma")
+    monkeypatch.setenv("TF_AFD_TRANSPORT", "other")             # not read: MCDMA is the only wire
+    wire = dict(master="127.0.0.1", port=29551, model_dir="/model")
+    assert afd_transport.transport_for(**wire) == "mcdma" and built == [wire]
+    monkeypatch.setattr(afd_mod, "AfdWire", lambda *a: made.append(a) or "wire")
+    assert afd_mod.make_afd("127.0.0.1", 29551, "/model") == "wire" and made == [("127.0.0.1", 29551, "/model")]
+    assert not hasattr(afd_mod, "Afd")                          # one class, no alias
+    for gone in ("TRANSPORT_ENV", "NAMES", "transport_name"):
+        assert not hasattr(afd_transport, gone), gone
+
+
+def test_the_mcdma_wire_implements_the_interface():
+    cls = afd_mcdma.McdmaTransport
+    for m in MEMBERS:
+        assert hasattr(cls, m), m
+        want = getattr(afd_transport.ExpertTransport, m, None)
+        if callable(want):
+            assert list(inspect.signature(getattr(cls, m)).parameters) == \
+                list(inspect.signature(want).parameters), m
+    assert cls.name == "mcdma"
+    assert "graphs" not in afd_transport.ExpertTransport.__annotations__ and not hasattr(cls, "graphs")
+    for m in LINK_MEMBERS:
+        assert list(inspect.signature(getattr(afd_mcdma.McdmaExpertLink, m)).parameters) == \
+            list(inspect.signature(getattr(afd_transport.ExpertLink, m)).parameters), m
+    for hook in ("begin", "exchange", "collect", "forces_eager", "announce", "wait_loaded", "die"):
+        assert hasattr(afd_mod.AfdWire, hook)
+    assert str(inspect.signature(afd_mod.AfdWire.begin)) == "(self, rows: 'int', *, chunk: 'bool' = False) -> 'None'"
+    assert str(inspect.signature(afd_mod.AfdWire.exchange)) == "(self, b, rows: 'int') -> 'None'"
+    assert str(inspect.signature(afd_mod.AfdWire.collect)) == "(self, b, rows: 'int', d: 'int')"
+
+
+# -- the engine hooks over the seam --------------------------------------------------------------------------------
+def test_the_attention_makes_the_wire_calls_in_order(master):
+    tr = Recorder()
+    a = wired(master, tr)
+    b = buffers(8)
+    a.begin(3)
+    for _ in range(2):
+        a.exchange(b, 3)
+        out = a.collect(b, 3, D)
+    assert tr.calls == [("start",), ("header", 1, 3, afd_mod.MODE_EAGER), ("send", 3, 0), ("recv", (3, D), (3, D), 0),
+                        ("send", 3, 1), ("recv", (3, D), (3, D), 1)]
+    assert out.shape == (3, 3, D) and a.layer == 2
+    assert json.loads(bytes(a.store.get("afd_settings")).decode()) == dict(settings(), transport="recorder")
+
+
+def test_every_window_is_eager_and_a_chunk_says_so(master, monkeypatch):
+    tr = Recorder()
+    a = wired(master, tr)
+    for value in ("", "1", "0"):
+        monkeypatch.setenv("TF_AFD_EAGER", value)                # never read: every window stays eager
+        assert a.forces_eager()
+    a.begin(2)
+    a.begin(5, chunk=True)
+    assert [c for c in tr.calls if c[0] == "header"] == [("header", 1, 2, afd_mod.MODE_EAGER),
+                                                        ("header", 2, 5, afd_mod.MODE_CHUNK)]
+    assert (afd_mod.MODE_EAGER, afd_mod.MODE_CHUNK) == (1, 3)
+
+
+@pytest.mark.parametrize("mode", [0, 16])
+def test_the_expert_refuses_a_mode_it_does_not_run(mode):
+    """A forward whose mode is neither eager (1) nor chunk (3) stops the expert before it lands any layer."""
+
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    landed = []
+
+    class Link:
+        def next_forward(self):
+            return 1, 2, mode
+
+        def land(self, layer, views):
+            landed.append(layer)
+
+    with pytest.raises(RuntimeError, match=rf"^forward mode {mode}: the expert runs eager windows only$"):
+        experts_node.forwards(FakeNode(LAYERS, 0), Link(), DictStore(), 1)
+    assert landed == []
+
+
+def test_a_forward_stopped_midway_kills_the_wire(master):
+    tr = Recorder()
+    a = wired(master, tr)
+    b = buffers(8)
+    a.begin(1)
+    a.exchange(b, 1)
+    a.collect(b, 1, D)
+    with pytest.raises(CapacityError, match="stopped after 1 of 4 MoE exchanges"):
+        a.begin(1)
+    assert tr.aborted and "out of step" in str(a.dead)
+
+
+def test_a_wire_error_fails_the_forward_and_kills_the_wire(master):
+    tr = Recorder(fail=afd_transport.WireError("link1: no reply", "MCDMA link1: no reply"))
+    a = wired(master, tr)
+    a.begin(1)
+    with pytest.raises(CapacityError, match=r"the AFD expert link failed \(link1: no reply\)"):
+        a.exchange(buffers(8), 1)
+    assert a.dead == "MCDMA link1: no reply" and tr.aborted
+    with pytest.raises(CapacityError, match="no reply"):
+        a.begin(1)
+
+
+def test_health_names_the_fault_and_the_watchdog_dies_with_it(master, monkeypatch, capsys):
+    monkeypatch.setattr(afd_mod, "WATCH_EVERY", 0.01)
+    tr = Recorder()
+    tr.err = "MCDMA link link1: generation 1 -> 2 (its daemon restarted)"
+    a = afd_mod.AfdWire("127.0.0.1", master, transport=tr)
+    wait_dead(a)
+    assert a.dead == "MCDMA link link1: generation 1 -> 2 (its daemon restarted)" and tr.aborted
+    tr2 = Recorder()
+    tr2.err = RuntimeError("gone")
+    a2 = afd_mod.AfdWire("127.0.0.1", master, transport=tr2)
+    wait_dead(a2)
+    assert a2.dead == "watchdog lost the recorder wire: RuntimeError('gone')" and tr2.aborted
+    out = capsys.readouterr().out
+    assert ("[tensorfold] afd: watchdog lost the recorder wire: RuntimeError('gone'); in-flight requests fail, "
+            "restart the serving stack") in out
+    assert "[tensorfold] afd transport recorder" in out
+    with pytest.raises(CapacityError, match="gone"):
+        a2.begin(1)
+
+
+def test_the_watchdog_reads_the_experts_error_keys(master, monkeypatch):
+    monkeypatch.setattr(afd_mod, "WATCH_EVERY", 0.01)
+    a = afd_mod.AfdWire("127.0.0.1", master, transport=Recorder())
+    a.store.set("afd_alive/2", b"1.0")
+    a.store.set("afd_error/2", b"LinkError('boom')")
+    wait_dead(a)
+    assert a.dead == "expert rank 2 failed: LinkError('boom')"
+
+
+def test_the_watchdog_calls_a_silent_expert_dead(master, monkeypatch):
+    monkeypatch.setattr(afd_mod, "WATCH_EVERY", 0.01)
+    monkeypatch.setattr(afd_mod, "ALIVE_STALE", 0.05)
+    a = afd_mod.AfdWire("127.0.0.1", master, transport=Recorder())
+    a.store.set("afd_alive/1", b"2.0")                 # a stamp that never changes: rank 1 is silent
+    wait_dead(a)
+    assert a.dead == "expert rank 1 silent for 0s (heartbeat unchanged)"
+
+
+def test_an_expert_refuses_an_attention_on_another_wire(monkeypatch, tmp_path):
+    """The handshake names the wire: an expert node refuses an attention node that announces another one."""
+
+    from torch.distributed import TCPStore
+
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    monkeypatch.setattr(afd_mcdma, "StoreComm", lambda *a: object())
+    monkeypatch.setattr(experts_node, "ALIVE_EVERY", 3600)
+    monkeypatch.setattr(experts_node.Config, "read", staticmethod(lambda _d: fake_cfg()))
+    port = free_port()
+    master = TCPStore("127.0.0.1", port, 1, True, timeout=timedelta(seconds=30), wait_for_workers=False)
+    theirs = dict(afd_mod.settings_for(tmp_path, fake_cfg(), prefill_rows=PREFILL), transport="tcp")
+    master.set("afd_settings", json.dumps(theirs))
+    with pytest.raises(SystemExit, match="settings mismatch on expert 1: transport: attention 'tcp' != expert 'mcdma'"):
+        experts_node.serve(tmp_path, 0, "127.0.0.1", port, device="cpu")
diff --git a/tools/mcdma_streamops_probe.py b/tools/mcdma_streamops_probe.py
new file mode 100644
index 0000000..b845cdd
--- /dev/null
+++ b/tools/mcdma_streamops_probe.py
@@ -0,0 +1,309 @@
+#!/usr/bin/env python3
+"""Can this GPU drive the AFD's MCDMA exchange from its stream? (TF_AFD_MCDMA_MODE=gpu)
+
+Run in the serving image on each node before its first --experts remote boot, with PYTHONPATH=<checkout>/src:
+
+    python3 tools/mcdma_streamops_probe.py [--shm /dev/shm] [--iters 2000] [--bytes 8740] [--out probe.json]
+
+It prints the device attributes, makes the device's primary context current (cuMemHostRegister needs one;
+torch.cuda.init() does not do it: CUDA error 201), then runs, each step bounded by --timeout:
+  T1 register  a 4 MiB MAP_SHARED file under --shm (a mailbox's kind of memory; unlinked at once) with
+               cuMemHostRegister(PORTABLE|DEVICEMAP), and its device pointer
+  T2 write     cuStreamWriteValue64 lands in it
+  T3 wait      cuStreamWaitValue64(EQ) holds a stream until the host stores the value, then lets it go
+  T4 request   the attention's send path, --iters times with fresh bytes: D2H copy into the payload, then a
+               write-value of the word; the host waits for the word and checks every byte
+  T5 reply     the receive path, --iters times: the stream waits (EQ, +FLUSH where the device has it) on a word the
+               host stores after writing the payload, copies the payload to the device and writes an ack; every
+               byte is checked; the host's store -> ack round trip is timed (p50/p90)
+  T6 zerocopy  information only: a kernel reads the registered memory through the device pointer
+then one JSON line and ``STREAMOPS: PASS`` or ``STREAMOPS: FAIL (<first failure>)``; exit 0 on PASS, 1 on FAIL.
+A stream left waiting is never unmapped under it: the probe exits at once instead.
+
+Without a GPU, a live link's mailbox (sizes, room for --rows, link-up/generation on the connect end, the words), and
+with --socket its daemon's STATUS (never MODE poll, which would take the link from its service):
+
+    python3 tools/mcdma_streamops_probe.py --mailbox NAME [--side connect|listen] [--rows 2048] [--socket PATH]
+
+ends with ``MAILBOX: OK`` or ``MAILBOX: FAIL (...)``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import mmap
+import os
+import socket
+import sys
+import time
+
+HIDDEN, SLOTS = 4096, 9          # GLM-5.3-Flash: hidden 4096, top-8 routed + the shared slot
+
+
+def _finish(res: dict, ok: bool, why: str, out: str, tag: str = "STREAMOPS") -> int:
+    res["pass"], res["why"] = ok, why
+    if tag == "STREAMOPS":
+        res["mode"] = "gpu" if ok else "cpu"
+    line = json.dumps(res, sort_keys=True)
+    print(line, flush=True)
+    if out:
+        with open(out, "w") as f:
+            f.write(line + "\n")
+    print(f"{tag}: PASS" if ok and tag == "STREAMOPS" else f"{tag}: OK" if ok else f"{tag}: FAIL ({why})", flush=True)
+    return 0 if ok else 1
+
+
+def _pct(v: list[float]) -> dict:
+    s = sorted(v)
+    if not s:
+        return {}
+    return {"p50_us": round(s[len(s) // 2], 2), "p90_us": round(s[min(len(s) - 1, int(len(s) * 0.9))], 2),
+            "min_us": round(s[0], 2), "n": len(s)}
+
+
+def gpu_probe(a) -> int:
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import mcdma, mcdma_cuda
+
+    res: dict = {"host": socket.gethostname(), "tests": {}, "attrs": {}}
+    if not torch.cuda.is_available():
+        return _finish(res, False, "no CUDA device", a.out)
+    torch.cuda.init()
+    dev = torch.cuda.current_device()
+    res.update(device=torch.cuda.get_device_name(dev), cc=list(torch.cuda.get_device_capability(dev)),
+               torch=torch.__version__)
+    drv = mcdma_cuda.CudaDriver()
+    res["driver"] = drv.version()
+    try:                                             # cuMemHostRegister needs a current context (CUDA error 201)
+        drv.ensure_ctx(dev)
+        res["ctx"] = drv.ctx_source                  # "current" (torch's runtime had made it so) or "primary"
+    except Exception as exc:  # noqa: BLE001
+        return _finish(res, False, f"T0 context: {exc}", a.out)
+    for name in mcdma_cuda.ATTRS:
+        try:
+            res["attrs"][name] = drv.attr(name, dev)
+        except Exception as exc:  # noqa: BLE001  an attribute this driver does not know
+            res["attrs"][name] = f"error: {exc}"
+    print(f"device {res['device']} cc {res['cc']} driver {res['driver']} torch {res['torch']} ctx {res['ctx']}",
+          flush=True)
+    for name, v in res["attrs"].items():
+        print(f"  attr {name:34s} {v}", flush=True)
+    for name in mcdma_cuda.NEEDED:
+        if res["attrs"].get(name) != 1:
+            return _finish(res, False, f"device attribute {name} = {res['attrs'].get(name)}", a.out)
+    try:
+        words = mcdma.Words()
+        res["libmcdma_rpc"] = words.path
+    except Exception as exc:  # noqa: BLE001  the probe can store words without it
+        words = None
+        res["libmcdma_rpc"] = f"absent ({exc})"
+    flags = mcdma.CU_STREAM_WAIT_VALUE_EQ | mcdma_cuda.flush_flag(drv, dev)
+    res["wait_flags"] = flags
+
+    # T1: a mailbox's kind of memory, registered
+    size = 4 << 20
+    path = os.path.join(a.shm, f"tensorfold-streamops-probe.{os.getpid()}")
+    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        os.ftruncate(fd, size)
+        mm = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
+    finally:
+        os.close(fd)
+        os.unlink(path)                              # the mapping stays; nothing is left in --shm
+    anchor = ctypes.c_char.from_buffer(mm)
+    host = ctypes.addressof(anchor)
+    try:
+        dptr = drv.register(host, size)
+    except Exception as exc:  # noqa: BLE001
+        return _finish(res, False, f"T1 register: {exc}", a.out)
+    res["tests"]["T1"] = {"ok": True, "device_pointer_is_host_pointer": dptr == host}
+    print(f"PASS T1 register ({size >> 20} MiB under {a.shm}; device pointer {'==' if dptr == host else '!='} host)",
+          flush=True)
+
+    def load(off: int) -> int:
+        return ctypes.c_uint64.from_address(host + off).value
+
+    def store(off: int, v: int) -> None:
+        if words is not None:
+            words.store(host + off, v)
+        else:
+            ctypes.c_uint64.from_address(host + off).value = v
+
+    def until(off: int, v: int, timeout: float) -> float | None:
+        t0 = time.perf_counter()
+        end = t0 + timeout
+        while load(off) != v:
+            if time.perf_counter() > end:
+                return None
+        return (time.perf_counter() - t0) * 1e6
+
+    def wedged(step: str, why: str) -> int:
+        res["tests"][step] = {"ok": False, "why": why}
+        rc = _finish(res, False, f"{step}: {why}", a.out)
+        sys.stdout.flush()
+        os._exit(rc)                                 # a waiting stream may still read the page: never unmap it
+
+    st = torch.cuda.Stream()
+    h = st.cuda_stream
+    REQ, DONE, ACK, T2W, PAY, REP, ZC = 0, 64, 128, 192, 4096, 4096 + (1 << 20), 4096 + (2 << 20)
+
+    # T2: write-value
+    drv.write64(h, dptr + T2W, mcdma.word(5, 55))
+    st.synchronize()
+    if load(T2W) != mcdma.word(5, 55):
+        return _finish(res, False, f"T2 write-value landed {load(T2W):#x}", a.out)
+    res["tests"]["T2"] = {"ok": True}
+    print("PASS T2 write-value", flush=True)
+
+    # T3: wait-value holds the stream until the host's store
+    drv.wait64(h, dptr + DONE, mcdma.word(7, 70), flags)
+    drv.write64(h, dptr + ACK, mcdma.word(8, 80))
+    time.sleep(0.05)
+    if load(ACK) == mcdma.word(8, 80):
+        return _finish(res, False, "T3 wait-value did not hold the stream", a.out)
+    store(DONE, mcdma.word(7, 70))
+    dt = until(ACK, mcdma.word(8, 80), a.timeout)
+    if dt is None:
+        wedged("T3", f"the stream never saw the host's store in {a.timeout:.0f} s")
+    st.synchronize()
+    res["tests"]["T3"] = {"ok": True, "release_us": round(dt, 1)}
+    print(f"PASS T3 wait-value (held 50 ms, released {dt:.1f} us after the host's store)", flush=True)
+
+    n, iters = a.bytes, a.iters
+    base = torch.arange(n, dtype=torch.int32)
+    payload = torch.frombuffer(mm, dtype=torch.uint8, count=n, offset=PAY)
+    reply = torch.frombuffer(mm, dtype=torch.uint8, count=n, offset=REP)
+    src = torch.empty((n,), dtype=torch.uint8, device="cuda")
+    dst = torch.empty((n,), dtype=torch.uint8, device="cuda")
+    base_dev = base.cuda()
+
+    # T4: the request path (copy, then write-value; the host checks the bytes after the word)
+    lat = []
+    for i in range(iters):
+        seq = i + 1
+        with torch.cuda.stream(st):
+            src.copy_(((base_dev + i) % 251).to(torch.uint8))
+            payload.copy_(src, non_blocking=True)
+            drv.write64(h, dptr + REQ, mcdma.word(seq, n))
+        dt = until(REQ, mcdma.word(seq, n), a.timeout)
+        if dt is None:
+            return _finish(res, False, f"T4 request word {seq} never landed", a.out)
+        want = ((base + i) % 251).to(torch.uint8)
+        if not torch.equal(payload, want):
+            bad = int((payload != want).nonzero()[0])
+            return _finish(res, False, f"T4 iteration {i}: payload byte {bad} is {int(payload[bad])}, not "
+                                       f"{int(want[bad])} (the word overtook its copy)", a.out)
+        lat.append(dt)
+    st.synchronize()
+    res["tests"]["T4"] = {"ok": True, "iters": iters, "bytes": n, "enqueue_to_word": _pct(lat)}
+    print(f"PASS T4 request path x{iters} ({n} B): every byte before its word", flush=True)
+
+    # T5: the reply path (host payload then word; the stream waits, copies, acks)
+    lat = []
+    for i in range(iters):
+        seq = i + 1
+        with torch.cuda.stream(st):
+            drv.wait64(h, dptr + DONE, mcdma.word(seq, n), flags)
+            dst.copy_(reply, non_blocking=True)
+            drv.write64(h, dptr + ACK, mcdma.word(seq, n))
+        reply.copy_(((base + 3 * i) % 253).to(torch.uint8))
+        t0 = time.perf_counter()
+        store(DONE, mcdma.word(seq, n))
+        if until(ACK, mcdma.word(seq, n), a.timeout) is None:
+            wedged("T5", f"iteration {i}: no ack in {a.timeout:.0f} s")
+        lat.append((time.perf_counter() - t0) * 1e6)
+        st.synchronize()
+        if not torch.equal(dst.cpu(), ((base + 3 * i) % 253).to(torch.uint8)):
+            return _finish(res, False, f"T5 iteration {i}: the device copy missed bytes the host wrote before the "
+                                       "word", a.out)
+    res["tests"]["T5"] = {"ok": True, "iters": iters, "bytes": n, "host_store_to_ack": _pct(lat)}
+    print(f"PASS T5 reply path x{iters} ({n} B): host store -> stream wait -> copy -> ack p50 "
+          f"{_pct(lat).get('p50_us')} us p90 {_pct(lat).get('p90_us')} us", flush=True)
+
+    # T6: information only - can a kernel read the registered memory directly (GB10: the expert's zero-copy option)
+    try:
+        zc = torch.frombuffer(mm, dtype=torch.uint8, count=n, offset=ZC)
+        zc.copy_((base % 199).to(torch.uint8))
+
+        class _Cai:
+            __cuda_array_interface__ = {"shape": (n,), "typestr": "|u1", "data": (dptr + ZC, False), "version": 3,
+                                        "strides": None}
+
+        view = torch.as_tensor(_Cai(), device="cuda")
+        got = int(view.to(torch.int64).sum().item())
+        want = int((base % 199).sum().item())
+        res["tests"]["T6"] = {"ok": got == want, "info_only": True}
+        print(f"INFO T6 zero-copy kernel read: {'ok' if got == want else f'MISMATCH {got} != {want}'}", flush=True)
+    except Exception as exc:  # noqa: BLE001  information only
+        res["tests"]["T6"] = {"ok": False, "info_only": True, "why": repr(exc)}
+        print(f"INFO T6 zero-copy kernel read: not possible ({exc!r})", flush=True)
+
+    st.synchronize()
+    drv.unregister(host)
+    del anchor, payload, reply
+    return _finish(res, True, "", a.out)
+
+
+def mailbox_check(a) -> int:
+    from tensorfold.families.glm5_next.cuda import mcdma
+
+    res: dict = {"host": socket.gethostname(), "link": a.mailbox, "side": a.side}
+    try:
+        words = mcdma.Words()
+        box = mcdma.Mailbox(a.mailbox, words, a.shm, wait_s=2.0)
+    except Exception as exc:  # noqa: BLE001
+        return _finish(res, False, str(exc), a.out, "MAILBOX")
+    res.update(path=box.path, req_mib=box.req >> 20, rep_mib=box.rep >> 20, link_up=box.plain(mcdma.LINK_UP),
+               generation=box.plain(mcdma.GENERATION), request_word=hex(words.load(box.req_word)),
+               done_word=hex(words.load(box.done)), staged_word=hex(words.load(box.staged)),
+               uid=os.getuid())
+    print(json.dumps(res, sort_keys=True), flush=True)
+    try:
+        box.check_room(mcdma.Layout(HIDDEN, SLOTS), a.rows)
+    except mcdma.LinkError as exc:
+        return _finish(res, False, str(exc), a.out, "MAILBOX")
+    if a.side == "connect" and res["link_up"] != 1:
+        return _finish(res, False, f"link {a.mailbox} is not up (link-up word {res['link_up']})", a.out, "MAILBOX")
+    if a.socket:
+        try:
+            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+            s.settimeout(5.0)
+            s.connect(a.socket)
+            s.sendall(b"STATUS\n")
+            text = b""
+            while b"END" not in text:
+                got = s.recv(4096)
+                if not got:
+                    break
+                text += got
+            s.close()
+        except OSError as exc:
+            return _finish(res, False, f"socket {a.socket}: {exc}", a.out, "MAILBOX")
+        res["status"] = text.decode(errors="replace").strip().splitlines()
+        if not any(line.startswith("PEER") and " up " in f"{line} " for line in res["status"]):
+            return _finish(res, False, f"daemon STATUS shows no PEER up: {res['status']}", a.out, "MAILBOX")
+    return _finish(res, True, "", a.out, "MAILBOX")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--shm", default="/dev/shm", help="where mailboxes live (the probe's own file goes here too)")
+    ap.add_argument("--iters", type=int, default=2000)
+    ap.add_argument("--bytes", type=int, default=8740, help="payload bytes (one row's request: 8740)")
+    ap.add_argument("--timeout", type=float, default=5.0, help="s any single step may take")
+    ap.add_argument("--out", default="", help="also write the JSON line here")
+    ap.add_argument("--mailbox", default="", help="check this live link's mailbox instead (no GPU)")
+    ap.add_argument("--side", choices=["connect", "listen"], default="connect")
+    ap.add_argument("--rows", type=int, default=2048, help="the widest window the mailbox must carry")
+    ap.add_argument("--socket", default="", help="the link daemon's socket, asked STATUS")
+    a = ap.parse_args()
+    if a.bytes > (1 << 20):
+        ap.error("--bytes must be at most 1 MiB")
+    return mailbox_check(a) if a.mailbox else gpu_probe(a)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
