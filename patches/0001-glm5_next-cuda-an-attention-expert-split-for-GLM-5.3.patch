--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/experts_node.py
@@ -0,0 +1,202 @@
+"""The AFD expert node's half: one TP2 rank's routed experts, and its serve loop over the wire."""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import torch
+
+from tensorfold.cuda.exl3.experts import Scratch as Exl3Scratch
+
+from . import exl3_generic, glue
+from .afd import ALIVE_EVERY, CHECK_ENV, CHECK_FORWARDS, MODE_CHUNK, MODE_EAGER, Store, get_store, sha
+from .afd import settings_for, settings_mismatch
+from .split import RankReader
+from .weights import PREFIX, Config
+
+
+def _expert_names(i: int, experts: int) -> list[str]:
+    """Layer ``i``'s EXL3 routed-expert tensors in ``weights.load``'s order (no shared: the attention node keeps it)."""
+
+    p = PREFIX + f"layers.{i}.mlp."
+    return [p + f"experts.{e}.{proj}.{part}" for proj in ("gate_proj", "up_proj", "down_proj")
+            for e in range(experts) for part in ("trellis", "suh", "svh")]
+
+
+def load_half(model_dir, half: int, layers, device: str = "cuda") -> list:
+    """``layers``' routed experts as TP2 half ``half``: one ``Exl3RoutedExperts`` per layer, in order, through
+    ``RankReader(model_dir, half)`` and the existing split rules, every trellis on ``device``."""
+
+    from tensorfold.cuda.exl3 import experts as generic
+
+    cfg = Config.read(model_dir)
+    if cfg.quant != "exl3":
+        raise ValueError(f"expert nodes read EXL3 checkpoints, not {cfg.quant!r}")
+    layers = list(layers)
+    for i in layers:
+        if not 0 <= i < len(cfg.mlp_kinds) or cfg.mlp_kinds[i] != "moe":
+            raise ValueError(f"layer {i} is not one of the checkpoint's MoE layers")
+    dev = torch.device(device)
+    rd = RankReader(model_dir, half)
+    out: list = []
+    try:
+        for n, i in enumerate(layers):
+            rd.prefetch(_expert_names(i, cfg.experts))                  # already queued, but the first
+            if n + 1 < len(layers):
+                rd.prefetch(_expert_names(layers[n + 1], cfg.experts))  # two layers of reads in flight
+            p = PREFIX + f"layers.{i}.mlp."
+
+            def triple(proj: str) -> list:
+                return [(rd.get(p + f"experts.{e}.{proj}.trellis").to(dev),  # noqa: B023  `p` is this layer's
+                         rd.get(p + f"experts.{e}.{proj}.suh").to(dev),
+                         rd.get(p + f"experts.{e}.{proj}.svh").to(dev)) for e in range(cfg.experts)]
+
+            out.append(generic.prepare(triple("gate_proj"), triple("up_proj"), triple("down_proj"), "mcg",
+                                       device=dev))
+            if n % 8 == 7:
+                torch.cuda.empty_cache()
+    finally:
+        rd.close()
+    return out
+
+
+class ExpertBuffers:
+    """The expert node's static scratch and wire-shaped slots: ``rows`` decode rows, ``prefill_rows`` a chunk."""
+
+    def __init__(self, cfg: Config, rows: int = 8, prefill_rows: int = 2048, device: str = "cuda") -> None:
+        if not 1 <= rows <= prefill_rows:
+            raise ValueError(f"rows {rows} must be within 1..prefill_rows {prefill_rows}")
+        D, slots = cfg.hidden, cfg.top_k + 1
+        self.rows, self.prefill_rows, self.slots, self.top_k, self.dims = rows, prefill_rows, slots, cfg.top_k, D
+        dev = torch.device(device)
+        top = prefill_rows                                   # the wire slots span the widest window
+        self.normed = torch.empty((top, D), dtype=torch.bfloat16, device=dev)
+        self.pick = torch.empty((top, slots), dtype=torch.int32, device=dev)
+        self.wts = torch.empty((top, slots), dtype=torch.float32, device=dev)
+        self.routed = torch.empty((top, D), dtype=torch.float32, device=dev)
+        shape = SimpleNamespace(dims=D, width=cfg.moe_width // 2, count=cfg.experts)
+        self.decode = Exl3Scratch(shape, rows, slots, device=dev)
+        self.pref = Exl3Scratch(shape, prefill_rows, slots, device=dev)
+
+    def scratch(self, R: int) -> Exl3Scratch:
+        return self.decode if R <= self.rows else self.pref
+
+    def ey(self, R: int) -> torch.Tensor:
+        """The live scratch's per-slot outputs as ``[R, slots, D]`` (the shared slot still to be zeroed)."""
+
+        s = self.scratch(R)
+        return s.y.view(s.rows, self.slots, self.dims)[:R]
+
+
+class ExpertNode:
+    """One half's routed experts plus buffers; ``compute`` is the per-layer AFD exchange's device side."""
+
+    def __init__(self, model_dir, half: int, layers, *, device: str = "cuda", rows: int = 8,
+                 prefill_rows: int = 2048) -> None:
+        self.cfg = Config.read(model_dir)
+        self.half, self.layers = half, list(layers)
+        self.experts = load_half(model_dir, half, self.layers, device=device)
+        self.by_layer = dict(zip(self.layers, self.experts))
+        self.buf = ExpertBuffers(self.cfg, rows=rows, prefill_rows=prefill_rows, device=device)
+
+    def compute(self, layer_i: int, R: int, x: tuple | None = None) -> torch.Tensor:
+        """``routed_half[:R] = sum_k wts[:, k] * y_k`` in slot order, the shared slot zeroed, fp32.
+        ``x``: (normed, pick, wts) to read instead of the wire slots (where the link landed them)."""
+
+        b = self.buf
+        if R > b.prefill_rows:
+            raise ValueError(f"{R} rows: buffers hold {b.prefill_rows}")
+        normed, pick, wts = x if x is not None else (b.normed[:R], b.pick[:R], b.wts[:R])
+        exl3_generic.routed(normed, pick, self.by_layer[layer_i], b.scratch(R), R, self.cfg.limit)
+        b.ey(R)[:, b.top_k].zero_()                          # the shared slot: attention adds its own sy
+        glue.combine(b.ey(R), wts, b.routed[:R])
+        return b.routed[:R]
+
+
+def _window(node: ExpertNode, link, R: int, collect: tuple[list, list] | None = None) -> None:
+    """One forward's device body: per layer land, compute, reply; hashes when ``collect``."""
+
+    b = node.buf
+    slots, routed = (b.normed[:R], b.pick[:R], b.wts[:R]), b.routed[:R]
+    for pos, i in enumerate(node.layers):
+        x = link.land(pos, slots)
+        if collect is not None:
+            collect[0].append([sha(x[0]), sha(x[1]), sha(x[2])])
+        node.compute(i, R, x)
+        if collect is not None:
+            collect[1].append(sha(routed))
+        link.reply(pos, routed)
+
+
+def forwards(node: ExpertNode, link, store, rank: int, *, check_on: bool = False) -> None:
+    """The per-forward loop over the expert's end of the wire (returns only by raising): every forward eager, the
+    wire check's hashes to the store."""
+
+    checked = 0
+    while True:
+        seq, rows, mode = link.next_forward()
+        if mode not in (MODE_EAGER, MODE_CHUNK):
+            raise RuntimeError(f"forward mode {mode}: the expert runs eager windows only")
+        collect = ([], []) if check_on and checked < CHECK_FORWARDS else None
+        _window(node, link, rows, collect)
+        if collect is not None:
+            checked += 1
+            store.set(f"afd_chk/{seq}/{rank}", json.dumps({"in": collect[0], "out": collect[1]}).encode())
+
+
+def serve(model_dir, half: int, master: str, port: int, *, device: str = "cuda") -> None:
+    """The expert node's whole run: AFD rank ``half + 1`` of 3 over its MCDMA link, the settings handshake, the
+    heartbeat, then ``forwards``."""
+
+    import os
+    import threading
+    import time
+
+    from . import afd_mcdma
+
+    cfg = Config.read(model_dir)
+    rank = half + 1
+    _rendezvous = afd_mcdma.StoreComm(rank, 3, master, port)   # joins the attention's three-rank store
+    store = Store(master, port)                  # the protocol's own short-timeout, self-healing client
+    beat_store = Store(master, port)             # the beat's own wrapper
+    stop = threading.Event()
+
+    def beat() -> None:
+        while not stop.is_set():
+            try:
+                beat_store.set(f"afd_alive/{rank}", f"{time.time():.3f}")
+            except Exception:  # noqa: BLE001  the store outliving us is fine
+                pass
+            stop.wait(ALIVE_EVERY)
+
+    threading.Thread(target=beat, daemon=True, name=f"afd-beat-{rank}").start()
+    link = None
+    try:
+        theirs = None
+        while theirs is None:                            # the attention publishes before its own load
+            raw = get_store(store, "afd_settings", 3600.0)
+            theirs = json.loads(bytes(raw).decode()) if raw else None
+        # the attention's wire must be this one; its link map is checked by open_expert_link
+        mine = dict(settings_for(model_dir, cfg, prefill_rows=int(theirs["prefill_rows"])), transport="mcdma",
+                    mcdma_links=theirs.get("mcdma_links"))
+        bad = settings_mismatch(mine, theirs)
+        if bad:
+            raise SystemExit(f"[tensorfold] afd: settings mismatch on expert {rank}: {bad}")
+        # before the load: a missing daemon fails in seconds, not after it
+        link = afd_mcdma.open_expert_link(theirs, rank, cfg, store, device)
+        store.set(f"afd_ready/{rank}", b"1")
+        node = ExpertNode(model_dir, half, mine["layers"], device=device, rows=int(theirs["max_rows"]),
+                          prefill_rows=int(theirs["prefill_rows"]))
+        print(f"[tensorfold] afd expert {rank}: {len(node.layers)} MoE layers resident", flush=True)
+        store.set(f"afd_loaded/{rank}", b"1")
+        forwards(node, link, store, rank, check_on=os.environ.get(CHECK_ENV, "").strip() == "1")
+    except Exception as exc:  # noqa: BLE001   the attention's watchdog reads this; the process exits for the lane
+        try:
+            store.set(f"afd_error/{rank}", repr(exc).encode())
+        except Exception:  # noqa: BLE001
+            pass
+        raise
+    finally:
+        if link is not None:
+            link.close()
