diff --git a/tests/test_glm_eight_streams.py b/tests/test_glm_eight_streams.py
new file mode 100644
index 0000000..b768750
--- /dev/null
+++ b/tests/test_glm_eight_streams.py
@@ -0,0 +1,368 @@
+"""--parallel up to 8 and TF_GLM_MULTI_WINDOW (MiaAI-Lab recipe patch 0069-glm-eight-streams, v1.5 1576746) on the
+CPU: the settings, the segment tables, the startup estimate (unchanged up to four streams), and the multi-stream
+decoder with eight stream slots, on the AFD attention node (world 1, the real ``BatchedVerify.forward`` over the fake
+model, alone and under ``GlmScheduler``) and at two ranks (the follower applying rank 0's messages): every reply equals
+the request served alone, windows hold up to eight streams' rows and never more than TF_GLM_MULTI_WINDOW's rows."""
+
+from __future__ import annotations
+
+import os
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from tests import test_glm_multi_afd as mafd
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+from tests.test_glm_multi import (  # noqa: F401
+    ALIGN,
+    CASES,
+    FakeMultiDrafter,
+    Pair,
+    _prompt,
+    _sampling,
+    fake,
+    shell,
+    solo,
+)
+from tests.test_glm_multi_afd import World1, afd_fake  # noqa: F401
+
+pytestmark = pytest.mark.torch
+
+# ten requests: the multi-stream tests' six and four more, so eight decode at once and two wait for a slot
+TEN = CASES + [(_prompt(77, 7), 42, "greedy", "f3", True), (_prompt(180, 8), 38, "topk", "f5", True),
+               (_prompt(55, 9), 50, "nucleus", "auto", True), (_prompt(101, 10), 33, "minp", "f3", True)]
+STARTS = (0, 1, 2, 3, 4, 5, 6, 7, 9, 12)
+
+
+# -- settings ---------------------------------------------------------------------------------------------------------
+def test_the_settings(monkeypatch):
+    from tensorfold.cuda.geometry import MLA_DECODE_ROWS
+    from tensorfold.families.glm5_next.cuda import segments
+    from tensorfold.families.glm5_next.cuda.engine import MULTI_WINDOW, PARALLEL_MOST, multi_decode_rows, multi_window
+    from tensorfold.families.glm5_next.cuda.multi import MAX_WINDOW
+
+    assert PARALLEL_MOST == segments.MAX_SEGS == 8 and segments.SEGS_DEFAULT == 4
+    assert MULTI_WINDOW == MAX_WINDOW == 32 and MLA_DECODE_ROWS == 64
+    monkeypatch.delenv("TF_GLM_MULTI_WINDOW", raising=False)
+    assert multi_window() == 32 and multi_window("") == 32 and multi_window(" ") == 32
+    assert [multi_window(str(v)) for v in range(16, 65, 8)] == list(range(16, 65, 8))
+    for bad in ("8", "12", "33", "72", "x", "-16", "32.0"):
+        with pytest.raises(ValueError, match="TF_GLM_MULTI_WINDOW"):
+            multi_window(bad)
+    monkeypatch.setenv("TF_GLM_MULTI_WINDOW", "64")
+    assert multi_window() == 64
+    assert [segments.seg_count(n) for n in range(1, 9)] == [4, 4, 4, 4, 5, 6, 7, 8]
+    for bad in (0, 9):
+        with pytest.raises(ValueError, match="1 to 8 streams"):
+            segments.seg_count(bad)
+    assert multi_decode_rows(1, 64) == 64                                   # one stream: no batched window
+    assert [multi_decode_rows(p, 32) for p in (2, 4, 6, 8)] == [64] * 4     # its 8 rows + 32 fit the 64
+    assert multi_decode_rows(8, 56) == 64 and multi_decode_rows(8, 64) == 72
+
+
+# -- the startup estimate ---------------------------------------------------------------------------------------------
+def _draft_bytes_before(t: dict, streams: int, world: int, *, ring: bool, capacity: int, tap_rows: int = 8) -> int:
+    """``engine.multi_draft_bytes`` as it was before recipe patch 0069 (the reference for up to four streams)."""
+
+    from tensorfold.cuda.geometry import draft_ring_rows
+
+    layers = int(t["num_hidden_layers"])
+    heads = int(t["num_key_value_heads"]) // world
+    hd = int(t["head_dim"])
+    block = int((t.get("dflash_config") or {}).get("block_size", 16))
+    window = int(t.get("sliding_window", 0))
+    ring_rows = draft_ring_rows(window - 1, block) if ring and window > 0 else 0
+    cap = ring_rows if 0 < ring_rows < capacity + block else capacity + block
+    trash = -(-max(64, streams * tap_rows) // block) * block
+    return 2 * layers * heads * hd * (streams * cap + trash) * 2
+
+
+# incoai/GLM-5.3-Flash-DFlash2 @bf582e4e's config, the fields the estimate reads
+DRAFTER = {**mafd.DFLASH2, "hidden_size": 4096, "intermediate_size": 12288,
+           "dflash_config": {"block_size": 8, "target_layer_ids": [5, 14, 24, 33, 42]}}
+
+
+def test_the_estimate_is_unchanged_up_to_four_streams():
+    """Up to four streams the multi-stream drafter's estimate and the geometry are the bits they were; past four the
+    drafter's rings grow by a stream's each (our 8-row windows and 8-row blocks keep its 64-row updates and block
+    passes: recipe 0069's activation term is 0), and with 16-row windows and blocks (the recipe's) the term grows.
+    The geometry sizes MLA_DECODE_ROWS decode rows unless asked for more."""
+
+    from tensorfold.cuda.geometry import mla_geometry
+    from tensorfold.families.glm5_next.cuda.engine import multi_draft_bytes
+
+    for t in (mafd.DFLASH2, DRAFTER):
+        for world in (1, 2):
+            for ring in (True, False):
+                for capacity in (2560, 262152, 1048584):
+                    for streams in range(1, 9):
+                        got = multi_draft_bytes(t, streams, world, ring=ring, capacity=capacity)
+                        assert got == _draft_bytes_before(t, streams, world, ring=ring, capacity=capacity), (
+                            streams, world, ring, capacity)
+    wide = {**DRAFTER, "dflash_config": {"block_size": 16, "target_layer_ids": [5, 14, 24, 33, 42]}}
+    for streams in (1, 2, 3, 4):
+        assert multi_draft_bytes(wide, streams, 1, ring=True, capacity=262152, tap_rows=16) == \
+            _draft_bytes_before(wide, streams, 1, ring=True, capacity=262152, tap_rows=16)
+    for streams in (5, 6, 7, 8):
+        assert multi_draft_bytes(wide, streams, 1, ring=True, capacity=262152, tap_rows=16) > \
+            _draft_bytes_before(wide, streams, 1, ring=True, capacity=262152, tap_rows=16)
+    for kw in ({}, {"kv": "fp8", "ring_rows": 2048}):
+        base = dict(minimum_slots=2560, latent=True, mtp=False, exl3_scratch=False, **kw)
+        a = mla_geometry(mafd.GLM, 1, 8, **base)
+        b = mla_geometry(mafd.GLM, 1, 8, decode_rows=64, **base)
+        c = mla_geometry(mafd.GLM, 1, 8, decode_rows=72, **base)
+        for slots in (2560, 262152, 626688):
+            assert a.bytes_at(slots) == b.bytes_at(slots) < c.bytes_at(slots)
+
+
+# -- segment tables ---------------------------------------------------------------------------------------------------
+def test_segment_tables_hold_up_to_eight_streams(allocations):  # noqa: F811
+    """SegRows keeps four segments by default and takes up to eight; a table of n segments holds n streams' rows, its
+    unused segments 0 rows; the KDA segment table of eight streams fills an [8, SEG_COLS] table in place."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import kda as kda_mod
+    from tensorfold.families.glm5_next.cuda.segments import EXTENT, SegRows, seg_count
+
+    spans = [(i * EXTENT, 100 * i + 5, 4) for i in range(8)]
+    four = SegRows(32, "cpu")
+    assert four.max_segs == 4 and four.seg_rows.numel() == 4
+    with pytest.raises(ValueError, match="at most 4"):
+        four.fill(spans[:5])
+    for n in range(1, 9):
+        rows = SegRows(32, "cpu", max_segs=seg_count(n))
+        t, R = rows.fill(spans[:n])
+        S = rows.max_segs
+        assert R == 4 * n and len(t) == 5 * 32 + 4 * S
+        o = 5 * 32
+        assert list(t[o + S:o + 2 * S]) == [4] * n + [0] * (S - n)            # seg_rows: unused segments empty
+        assert list(t[o:o + n]) == [4 * s for s in range(n)]                  # seg_start
+        assert list(t[2 * 32:2 * 32 + R]) == [s for s in range(n) for _ in range(4)]    # each row's segment
+    with pytest.raises(ValueError, match="1 to 8"):
+        SegRows(32, "cpu", max_segs=9)
+    with pytest.raises(ValueError, match="at most 8"):
+        SegRows(64, "cpu", max_segs=8).fill(spans + [(8 * EXTENT, 0, 1)])
+    out = torch.zeros((8, kda_mod.SEG_COLS), dtype=torch.int32)
+    kda_mod.segment_table([(4, s, s % 2, s, 3) for s in range(6)], "cpu", out=out)
+    assert out[:, kda_mod.SEG_ROWS].tolist() == [4] * 6 + [0, 0]
+    assert out[:6, kda_mod.SEG_ROW0].tolist() == [0, 4, 8, 12, 16, 20]
+
+
+# -- the AFD attention node: eight stream slots ------------------------------------------------------------------------
+def world1(env, *, streams: int, window: int | None = None, **kw) -> World1:
+    """``test_glm_multi_afd.World1`` whose engine was started with TF_GLM_MULTI_WINDOW=``window`` (its decoder reads
+    ``engine.multi_window``; the fake batched seam's rows follow it)."""
+
+    if window is not None:
+        made = mafd.shell
+
+        def shell_with_window(*a, **k):
+            g = made(*a, **k)
+            g.multi_window = window
+            return g
+
+        env.monkeypatch.setattr(mafd, "shell", shell_with_window)
+        env.monkeypatch.setattr(mafd, "WINDOW", window)
+    return World1(env, streams=streams, **kw)
+
+
+def _serve_ten(n1, streams: int) -> list:
+    admitted, pending = [], list(enumerate(TEN))
+    for it in range(8000):
+        while pending and it >= STARTS[pending[0][0]] and n1.d.live() < streams:
+            i, (prompt, count, kind, policy, draft) = pending.pop(0)
+            admitted.append((i, n1.submit(prompt, count, _sampling(kind, 100 + i), policy=policy, draft=draft)))
+        if not n1.d.lanes and not pending:
+            break
+        if n1.d.lanes:
+            n1.step()
+    assert not pending and not n1.d.lanes
+    return admitted
+
+
+def _defaults(monkeypatch) -> None:
+    """Every TF_GLM_* switch unset, for the checks of how a round's window is made up (how many streams share it, how
+    many rows it takes): the prompt-fill switches (TF_GLM_FILL_BUDGET_MS slices a fill by wall time,
+    TF_GLM_MULTI_PREFILL, TF_GLM_FILL_DRAFTS) and TF_GLM_DFLASH_POLICY change which streams decode together and how
+    deep they draft, not their replies. The ``outer`` cases keep the switches the run was started with and check the
+    replies and the window bounds only."""
+
+    for k in [k for k in os.environ if k.startswith("TF_GLM_")]:
+        monkeypatch.delenv(k)
+
+
+@pytest.mark.parametrize("window,outer", [(None, False), (32, False), (64, False), (None, True)])
+def test_world1_eight_streams_equal_their_solo_replies(afd_fake, window, outer):  # noqa: F811
+    """Ten staggered requests on the AFD attention node with eight stream slots: each reply equals its solo draft:false
+    reply; one begin per forward; up to eight streams share a batched window, never past the window's rows (32 by
+    default, TF_GLM_MULTI_WINDOW's otherwise); no message shared (no rank 1). With the switches at their defaults more
+    than four streams share a window."""
+
+    if not outer:
+        _defaults(afd_fake.monkeypatch)
+    torch = afd_fake.torch
+    n1 = world1(afd_fake, streams=8, window=window, blocks=16)
+    rows = 32 if window is None else window
+    assert n1.d.count == 8 and n1.d.window == rows
+    admitted = _serve_ten(n1, 8)
+    for i, s in admitted:
+        prompt, count, kind, _, _ = TEN[i]
+        assert s.got == solo(torch, prompt, count, _sampling(kind, 100 + i)), i
+    assert n1.shared == [] and n1.d.world == 1
+    pairs = n1.wire.pairs()
+    batched = [r for k, r in pairs if k == "batched"]
+    windows = n1.verify.windows
+    assert [r for r, _ in windows] == batched
+    assert all(r == sum(seg) and r <= rows for r, seg in windows)
+    assert max(len(seg) for _, seg in windows) <= 8
+    if not outer:
+        assert max(len(seg) for _, seg in windows) > 4                 # more than four streams shared a window
+    assert n1.d.drafts.proposed > 0 and any(s.accepted for _, s in admitted)
+
