+@pytest.mark.parametrize("outer", [False, True])
+def test_world1_scheduler_burst_past_eight_slots(afd_fake, outer):  # noqa: F811
+    """GlmScheduler with eight slots on the AFD attention node: ten requests at once from ten threads (a burst past
+    the eight slots), one stopped by its client: every other reply equals its solo one. With the switches at their
+    defaults more than four streams share a window."""
+
+    from tensorfold.families.glm5_next.cuda.engine import encode_policy
+    from tensorfold.families.glm5_next.cuda.multi import GlmScheduler
+
+    if not outer:
+        _defaults(afd_fake.monkeypatch)
+    torch = afd_fake.torch
+    n1 = world1(afd_fake, streams=8, blocks=16)
+    sched = GlmScheduler(n1.d, max_streams=8)
+    kinds = ("topk", "greedy", "nucleus", "minp", "greedy")
+    reqs = [(_prompt(40 + 20 * i, 90 + i), 26 + 3 * i, _sampling(kinds[i % 5], i)) for i in range(10)]
+    results: dict[int, list[int]] = {}
+    errors: list = []
+
+    def client(i):
+        prompt, n, sp = reqs[i]
+        got: list[int] = []
+
+        def emit(new):
+            got.extend(new)
+            return i == 3 and len(got) >= 6
+
+        try:
+            sched.submit(prompt, n, sp, True, emit, glm={"code": encode_policy("f3"), "spec": "f3"})
+        except Exception as exc:                     # noqa: BLE001
+            errors.append(exc)
+        results[i] = got
+
+    threads = [threading.Thread(target=client, args=(i,)) for i in range(10)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(timeout=300)
+    sched.close()
+    assert not errors and len(results) == 10
+    for i in range(10):
+        prompt, n, sp = reqs[i]
+        want = solo(torch, prompt, n, sp)
+        if i == 3:
+            assert 6 <= len(results[3]) < n and results[3] == want[:len(results[3])]
+        else:
+            assert results[i] == want, i
+    assert n1.shared == []
+    assert all(r <= 32 for k, r in n1.wire.pairs() if k == "batched")
+    assert max(len(seg) for _, seg in n1.verify.windows) <= 8
+    if not outer:
+        assert max(len(seg) for _, seg in n1.verify.windows) > 4
+
+
+# -- two ranks (rank 1 applies rank 0's messages) ---------------------------------------------------------------------
+@pytest.mark.parametrize("drafters", ["dflash2", "both"])
+def test_two_ranks_eight_streams_equal_their_solo_serial_replies(fake, drafters):  # noqa: F811
+    """Ten staggered requests at two ranks with eight stream slots (rank 1 applying rank 0's messages, both ranks'
+    pools, kept prompts, arenas, slots and draft contexts compared after every round): each reply equals its solo
+    serial reply."""
+
+    torch = fake
+    p = Pair(torch, streams=8, blocks=16, drafter=True, mtp=drafters == "both")
+    assert p.d[0].window == p.d[1].window == 32
+    admitted, pending = [], list(enumerate(TEN))
+    most = 0
+    for it in range(8000):
+        while pending and it >= STARTS[pending[0][0]] and p.d[0].live() < 8:
+            i, (prompt, count, kind, policy, draft) = pending.pop(0)
+            admitted.append((i, p.submit(prompt, count, _sampling(kind, 100 + i), policy=policy, draft=draft)))
+        most = max(most, p.d[0].live())
+        if not p.d[0].lanes and not pending:
+            break
+        if p.d[0].lanes:
+            p.step()
+        elif p.sent:
+            p.follow()
+    assert not pending and not p.d[0].lanes and most == 8
+    for i, s in admitted:
+        prompt, count, kind, _, _ = TEN[i]
+        assert s.got == solo(torch, prompt, count, _sampling(kind, 100 + i)), i
+    assert p.d[0].drafts.proposed > 0 and any(s.accepted for _, s in admitted)
+    assert p.d[1].idle and not p.d[1].lanes
+
