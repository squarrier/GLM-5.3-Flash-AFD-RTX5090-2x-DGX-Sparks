+@pytest.mark.parametrize("window", [32, 48, 64])
+def test_world1_the_window_caps_eight_streams_rows(afd_fake, window):  # noqa: F811
+    """Eight requests drafting seven tokens a round (f7: eight rows a stream, 64 together) started at once, the
+    switches at their defaults: a round's window reaches exactly TF_GLM_MULTI_WINDOW's rows and never passes them (the
+    longest tails trimmed), with eight segments; every reply equals its solo reply."""
+
+    _defaults(afd_fake.monkeypatch)
+    torch = afd_fake.torch
+    n1 = world1(afd_fake, streams=8, window=window, blocks=16)
+    reqs = [(_prompt(60 + 9 * i, 200 + i), 96, _sampling(("greedy", "topk")[i % 2], 300 + i)) for i in range(8)]
+    got = [n1.submit(prompt, n, sp, policy="f7", stop_eos=False) for prompt, n, sp in reqs]
+    n1.run()
+    for s, (prompt, n, sp) in zip(got, reqs):
+        assert s.got == solo(torch, prompt, n, sp, stop_eos=False)
+    windows = n1.verify.windows
+    assert all(r == sum(seg) <= window for r, seg in windows)
+    assert max(r for r, _ in windows) == window
+    assert max(len(seg) for _, seg in windows) == 8
+
