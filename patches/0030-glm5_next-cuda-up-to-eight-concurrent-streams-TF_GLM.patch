+def test_the_afd_engine_takes_eight_and_reads_the_window_before_the_wire(monkeypatch, tmp_path):
+    """AfdEngine accepts --parallel 5 to 8 (it gets as far as opening the wire), refuses 9, and refuses a bad
+    TF_GLM_MULTI_WINDOW before the wire opens (the expert nodes never see a start that cannot serve)."""
+
+    from tensorfold.families.glm5_next.cuda import afd as afd_mod
+    from tensorfold.families.glm5_next.cuda import engine
+
+    class Opened(Exception):
+        pass
+
+    def make_afd(*a, **k):
+        raise Opened
+
+    monkeypatch.setattr(afd_mod, "make_afd", make_afd)
+    for k in ("TF_GLM_MULTI_DEPTH", "TF_GLM_MULTI_LONE", "TF_GLM_MULTI_WINDOW"):
+        monkeypatch.delenv(k, raising=False)
+    for parallel in (5, 6, 7, 8):
+        with pytest.raises(Opened):
+            engine.AfdEngine(tmp_path, master="192.0.2.10", port=29551, parallel=parallel)
+    with pytest.raises(ValueError, match="1 to 8"):
+        engine.AfdEngine(tmp_path, master="192.0.2.10", port=29551, parallel=9)
+    monkeypatch.setenv("TF_GLM_MULTI_WINDOW", "33")
+    with pytest.raises(ValueError, match="TF_GLM_MULTI_WINDOW"):
+        engine.AfdEngine(tmp_path, master="192.0.2.10", port=29551, parallel=8)
+    monkeypatch.setenv("TF_GLM_MULTI_WINDOW", "64")
+    with pytest.raises(Opened):
+        engine.AfdEngine(tmp_path, master="192.0.2.10", port=29551, parallel=8)
