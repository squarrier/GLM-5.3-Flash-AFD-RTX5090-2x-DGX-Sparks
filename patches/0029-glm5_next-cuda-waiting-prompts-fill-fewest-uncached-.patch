+def _long_then_short(torch, monkeypatch, clock, order, *, late: float = 1.0, steps: int = 3, group: bool = False,
+                     **kw):
+    """The long prompt fills ``steps`` chunks; ``late`` seconds after it arrived the short one arrives. Returns the
+    Pair, both streams, the chunk log and the step each got its first token at."""
+
+    _order(monkeypatch, order)
+    if group:
+        monkeypatch.setenv("TF_GLM_MULTI_PREFILL", "1")
+    else:
+        monkeypatch.delenv("TF_GLM_MULTI_PREFILL", raising=False)
+    p = tm.Pair(torch, streams=2, **kw)
+    log = _logged(p)
+    a = p.submit(*LONG)
+    for _ in range(steps):
+        p.step()
+    clock.t += late
+    b = p.submit(*SHORT)
+    first = {}
+    for it in range(2000):
+        if not p.d[0].lanes:
+            break
+        p.step()
+        for name, s in (("long", a), ("short", b)):
+            if s.got and name not in first:
+                first[name] = it
+    for s, req in ((a, LONG), (b, SHORT)):
+        assert s.got == tm.solo(torch, *req)
+    return p, a, b, _fills(log), first
+
+
+def test_a_short_prompt_goes_before_a_long_fill(fake, monkeypatch, clock):
+    """Arrival order: the short prompt waits for the long one's whole fill. sjf: its two chunks (to its kept point,
