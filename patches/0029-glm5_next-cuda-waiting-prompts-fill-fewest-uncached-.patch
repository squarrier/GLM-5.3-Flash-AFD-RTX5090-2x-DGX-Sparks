+# -- admission -------------------------------------------------------------------------------------------------------
+def manual(d, max_streams: int):
+    """A ``GlmScheduler`` without its worker thread (the test calls ``_iteration``): ``Scheduler.__init__``'s fields."""
+
+    from tensorfold.cuda.scheduler import Waiting
+    from tensorfold.families.glm5_next.cuda.multi import GlmScheduler
+
+    s = GlmScheduler.__new__(GlmScheduler)
+    s.held, s.gather_s, s.sjf = None, 0.0, d.order == "sjf"
+    s.decoder, s.max_streams, s.waiting, s.boxes, s.yields = d, max_streams, Waiting(), {}, 0
+    return s
+
+
+def enqueue(sched, g, prompt, count, sampling=None, *, policy: str = "f3"):
+    """``GlmScheduler.submit``'s stream, queued without waiting for the reply; returns (stream, its tokens)."""
+
+    from tensorfold.cuda.streams import Stream
+    from tensorfold.families.glm5_next.cuda import prefill_order
+    from tensorfold.families.glm5_next.cuda.engine import encode_policy
+
+    box: queue.Queue = queue.Queue()
+    s = Stream(list(prompt), max(1, count), sampling, draft=True)
+    s.glm = {"code": g._effective(encode_policy(policy)), "spec": policy}
+    got: list[int] = []
+    s.emit = lambda new: (got.extend(new), box.put(("tokens", new)), False)[2]
+    if sched.sjf:
+        prefill_order.stamp(s)
+    sched.waiting.put((s, box))
+    return s, got
+
+
+def _drive(p, sched, most: int = 4000) -> None:
+    for _ in range(most):
+        if not p.d[0].lanes and sched.held is None and sched.waiting.empty():
+            return
+        sched._iteration()
+        p.follow()
+    raise AssertionError("the requests did not finish")
+
+
+def _admitted(sent) -> list[int]:
+    from tensorfold.families.glm5_next.cuda.multi import ADMIT
+
+    return [p[0] for m in sent for op, p in tm._ops(m) if op == ADMIT]
+
+
+def test_admission_fewest_uncached_first(fake, monkeypatch, clock):
+    """One slot, three requests queued (600, 300 and 40 tokens, in that order): arrival order admits them as they
+    came, sjf the 40, then the 300, then the 600; the replies are the solo ones either way."""
+
+    reqs = [(tm._prompt(600, 41), 6, None), (tm._prompt(300, 42), 6, tm._sampling("topk", 42)),
+            (tm._prompt(40, 43), 6, None)]
+    order_of = {}
+    for order in (None, "sjf"):
+        _order(monkeypatch, order)
+        p = tm.Pair(fake, streams=1)
+        log = _logged(p)
+        sched = manual(p.d[0], 1)
+        out = []
+        for k, r in enumerate(reqs):
+            clock.t = 1000.0 + k
+            out.append(enqueue(sched, p.g[0], *r))
+        _drive(p, sched)
+        sid_of = {s.sid: k for k, (s, _) in enumerate(out)}
+        order_of[order] = [sid_of[x] for x in _admitted(log)]
+        for (s, got), r in zip(out, reqs):
+            assert got == tm.solo(fake, *r)
+        if order == "sjf":
+            assert p.d[0].ordered["admits"] == 3 and p.d[0].ordered["admits_reordered"] == 2
+    assert order_of[None] == [0, 1, 2] and order_of["sjf"] == [2, 1, 0]
+
