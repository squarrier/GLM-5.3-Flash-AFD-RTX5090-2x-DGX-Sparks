+    states and pool rows, both ranks agreeing after every message (Pair.check)."""
+
+    p0, _, _, f0, first0 = _long_then_short(fake, monkeypatch, clock, None)
+    p1, a1, b1, f1, first1 = _long_then_short(fake, monkeypatch, clock, "sjf")
+    assert first0["long"] < first0["short"] and first1["short"] < first1["long"]
+    la, lb = a1.sid, b1.sid
+    assert f0[:3] == f1[:3] == [[la]] * 3
+    assert f1[3:5] == [[lb], [lb]] and all(x == [la] for x in f1[5:5 + 6])        # then the long one's rest
+    assert [x for x in f0 if x == [lb]] and f0.index([lb]) > max(i for i, x in enumerate(f0) if x == [la])
+    assert sorted(map(tuple, f0)) == sorted(map(tuple, f1))                       # the same chunks, reordered
+    import tests.test_glm_multi_prefill as tmp
+
+    assert tmp.kept_view(p0.d[0]) == tmp.kept_view(p1.d[0]) == tmp.kept_view(p1.d[1])
+    h = p1.d[0].health()["prefill_order"]
+    assert h["order"] == "sjf" and h["age_ms"] == 30_000.0 and h["reordered"] >= 1 and h["aged"] == 0
+    assert "prefill_order" not in p0.d[0].health()
