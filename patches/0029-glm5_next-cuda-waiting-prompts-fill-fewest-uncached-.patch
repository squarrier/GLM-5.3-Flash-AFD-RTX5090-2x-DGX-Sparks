+        streams, pending = [], list(enumerate(tm.CASES))
+        for it in range(4000):
+            while pending and it >= 3 * pending[0][0] and p.d[0].live() < 2:
+                i, (prompt, count, kind, policy, draft) = pending.pop(0)
+                streams.append(p.submit(prompt, count, tm._sampling(kind, 100 + i), policy=policy, draft=draft))
+            if not p.d[0].lanes and not pending:
