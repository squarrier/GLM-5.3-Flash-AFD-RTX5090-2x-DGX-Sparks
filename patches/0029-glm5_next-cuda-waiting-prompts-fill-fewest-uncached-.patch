+            po.age_ms(bad)
+    now, age = 100.0, 30.0
+
+    def k(background, arrived, uncached, seq):
+        return po.key(background, arrived, uncached, seq, now, age)
+
+    assert k(False, 90.0, 100_000, 0) < k(True, 99.0, 10, 1)             # foreground before background
+    assert k(False, 70.0, 100_000, 5) < k(False, 99.0, 10, 0)            # aged (30 s) before any fresh one
+    assert k(False, 60.0, 100_000, 5) < k(False, 70.0, 10, 0)            # two aged: by arrival
+    assert k(False, 99.0, 10, 9) < k(False, 80.0, 11, 0)                 # fresh: fewest uncached tokens
+    assert k(False, 80.0, 10, 9) < k(False, 90.0, 10, 0)                 # ... then arrival
+    assert k(False, 80.0, 10, 0) < k(False, 80.0, 10, 1)                 # ... then admission / queue order
+    assert po.key(False, 99.9, 5, 0, 100.0, 0.0)[1] == 0                 # age 0: all aged, i.e. arrival order
+    s = SimpleNamespace()
