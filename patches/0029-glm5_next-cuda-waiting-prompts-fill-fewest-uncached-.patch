+# -- the arrival simulator (tests/glm_prefill_sim.py), small ---------------------------------------------------------
+def test_the_arrival_simulator(afd_fake):
+    """Three clients sending 2K and 32K prompts (three each, Poisson think times) to the engine's own scheduler at
+    world 1 with the final config's prompt switches (grouped chunks, pairs, 200 ms layer slices with drafted rounds),
+    in virtual time: every request gets its first token in both orders; with sjf the 2K prompts' first tokens come
