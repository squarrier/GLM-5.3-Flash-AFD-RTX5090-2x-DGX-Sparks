diff --git a/tests/test_glm_prefill_order.py b/tests/test_glm_prefill_order.py
new file mode 100644
index 0000000..87bd305
--- /dev/null
+++ b/tests/test_glm_prefill_order.py
@@ -0,0 +1,532 @@
+"""TF_GLM_PREFILL_ORDER=sjf (``prefill_order``, ours) on CPU: waiting prompts go fewest uncached tokens first, a prompt
+that has waited TF_GLM_PREFILL_AGE_MS is overtaken by no later arrival, and every reply, kept state and pool row is
+still the one the request gets alone.
+
+- the settings, the order's key and the arrival stamp; the AFD startup check refuses a typo before the wire opens;
+- prompt chunks on #243's fake model at two ranks (tests/test_glm_multi.py's Pair): a short prompt arriving while a
+  long one fills takes the next chunk (in arrival order it waits for the long one's last); once the long one has aged,
+  no later arrival goes first; TF_GLM_MULTI_PREFILL's grouped chunk hands its rows out in the order; the replies are
+  the solo ones and both ranks agree after every message;
+- at world 1 over the fake AFD wire (tests/test_glm_multi_afd.py's World1) with chunk pairs: the pair is planned from
+  the order, so the short prompt's two chunks run as one pair;
+- admission (``GlmScheduler``, driven by hand): queued requests take a free slot fewest uncached tokens first, a kept
+  prefix counting as cached; the request held for room no longer blocks a smaller one, until it has aged;
+- unset and ``fifo`` send the same messages; /health's block only with the setting; the threaded scheduler with a
+  follower thread under the setting.
+"""
+
+from __future__ import annotations
+
+import queue
+from types import SimpleNamespace
+
+import pytest
+
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+pytestmark = pytest.mark.torch
+
+fake = tm.fake
+afd_fake = ta.afd_fake
+ALIGN = tm.ALIGN
+# the prompt switches that change how chunks are cut or grouped: each test sets the ones its scenario needs, so a run
+# with them exported (a whole-config test round) still checks these scenarios as written
+SWITCHES = ("TF_GLM_MULTI_PREFILL", "TF_GLM_MULTI_PREFILL_WAIT_MS", "TF_GLM_FILL_BUDGET_MS", "TF_GLM_FILL_DRAFTS",
+            "TF_GLM_SHARED_PREFIX", "TF_GLM_PREFILL_PAIRS", "TF_AFD_PREFILL_PAIRS", "TF_GLM_PROMPT_GRID",
+            "TF_GLM_PREFILL_ORDER", "TF_GLM_PREFILL_AGE_MS")
+
+
+@pytest.fixture(autouse=True)
+def _own_switches(monkeypatch):
+    for name in SWITCHES:
+        monkeypatch.delenv(name, raising=False)
+
+
+class Clock:
+    """``prefill_order.clock`` under the test's hand (seconds)."""
+
+    def __init__(self, t: float = 1000.0) -> None:
+        self.t = t
+
+    def __call__(self) -> float:
+        return self.t
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import prefill_order
+
+    c = Clock()
+    monkeypatch.setattr(prefill_order, "clock", c)
+    return c
+
+
+def _order(monkeypatch, value: str | None, age: str | None = None) -> None:
+    for name, v in (("TF_GLM_PREFILL_ORDER", value), ("TF_GLM_PREFILL_AGE_MS", age)):
+        if v is None:
+            monkeypatch.delenv(name, raising=False)
+        else:
+            monkeypatch.setenv(name, v)
+
+
+def _fills(sent) -> list[list[int]]:
+    """Each prompt chunk rank 0 told rank 1 about (FILL, MFILL), as the streams it holds, in order."""
+
+    from tensorfold.families.glm5_next.cuda.multi import FILL, MFILL
+
+    out = []
+    for m in sent:
+        for op, p in tm._ops(m):
+            if op == FILL:
+                out.append([p[0]])
+            elif op == MFILL:
+                out.append(list(p[1:1 + 2 * p[0]:2]))
+    return out
+
+
+def _logged(p) -> list:
+    log: list = []
+    share = p.g[0]._share
+    p.g[0]._share = lambda values: (log.append(list(values)), share(values))[1]
+    return log
+
+
+# -- settings ------------------------------------------------------------------------------------------------------
+def test_the_settings(allocations, monkeypatch):  # noqa: F811
+    from tensorfold.families.glm5_next.cuda import prefill_order as po
+    from tensorfold.families.glm5_next.cuda.engine import afd_parallel_check
+
+    _order(monkeypatch, None)
+    assert po.order() == "fifo" and po.order("") == "fifo" and po.order(" SJF ") == "sjf" and po.order("fifo") == "fifo"
+    for bad in ("1", "srpt", "on", "shortest"):
+        with pytest.raises(ValueError, match="TF_GLM_PREFILL_ORDER"):
