+# -- prompt chunks at two ranks ------------------------------------------------------------------------------------
+LONG, SHORT, SHORT2 = (tm._prompt(600, 31), 10, None), (tm._prompt(40, 32), 10, tm._sampling("topk", 32)), \
+    (tm._prompt(50, 33), 10, tm._sampling("minp", 33))
