+def test_the_held_request_blocks_until_it_has_aged(fake, monkeypatch, clock):
+    """Two slots in a 4-extent pool, one stream decoding: a 5,000-token request cannot be placed. In arrival order it
+    is held and a 100-token request queued after it waits behind it; with sjf the small one is admitted past it while
+    it is young, and once it has aged it is first again (held, waiting for room) and the next small one waits."""
+
+    for order in (None, "sjf"):
+        _order(monkeypatch, order)
+        clock.t = 1000.0
+        p = tm.Pair(fake, streams=2, blocks=4)
+        sched = manual(p.d[0], 2)
+        enqueue(sched, p.g[0], tm._prompt(3000, 61), 60)
+        for _ in range(60):                               # the 3,000-token prompt fills, then decodes
+            sched._iteration()
+            p.follow()
+            if p.d[0].lanes and all(x.decoding for x in p.d[0].lanes.values()):
+                break
+        clock.t += 1.0
+        big, _ = enqueue(sched, p.g[0], tm._prompt(5000, 62), 4)
+        clock.t += 1.0
+        small, _ = enqueue(sched, p.g[0], tm._prompt(100, 63), 4)
+        log = _logged(p)
+        sched._iteration()
+        p.follow()
+        if order is None:
+            assert _admitted(log) == [] and sched.held[0] is big       # the small one waits behind the held one
+        else:
+            assert _admitted(log) == [small.sid] and sched.held is None   # past the young big one (still queued)
+            clock.t += 31.0                                            # the big one has aged
+            small2, _ = enqueue(sched, p.g[0], tm._prompt(80, 64), 4)
+            while small.sid in p.d[0].lanes:                           # until a slot frees
+                sched._iteration()
+                p.follow()
+            log2 = _logged(p)
+            sched._iteration()
+            p.follow()
+            assert _admitted(log2) == [] and sched.held[0] is big      # first again, waiting for room
+            assert not small2.done                                     # ... and the small one behind it
+        _drive(p, sched)
+        assert big.done and small.done and big.error is None and small.error is None
+
