index 0000000..1f3c5ad
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/prefill_order.py
@@ -0,0 +1,101 @@
+"""Shortest-first prompt fills with aging (``TF_GLM_PREFILL_ORDER=sjf``, --parallel): when several prompts wait, the one
+with the fewest uncached tokens goes first, so a short prompt's first token does not wait for a long prompt's whole
+fill; a prompt that has waited ``TF_GLM_PREFILL_AGE_MS`` (default 30,000) is overtaken by no prompt that arrived
+after it.
+
+Two places order waiting prompts (``multi``):
+
+- admission (``GlmScheduler._admit``): which queued request takes a free stream slot. Its uncached tokens are its
+  prompt less the longest kept prefix it would resume (``MultiDecoder.uncached``). The request held for room competes
+  with the queue (it no longer blocks it, until it has aged);
+- prompt chunks (``MultiDecoder._fill_turn``): which filling stream's rows the next prompt chunk holds. Its uncached
+  tokens are its prompt rows not filled yet, so a long prompt part-way through its fill yields between two chunks to
+  a shorter one. TF_GLM_MULTI_PREFILL's multi-prompt chunk hands its row budget out in the same order
+  (``MultiDecoder._group``; the recipe's own order there is fewest rows left first, MiaAI-Lab recipe patch 0049).
+
+The order (``key``): foreground before background, as before; then every prompt that has waited the aging bound,
+in arrival order; then the others by fewest uncached tokens, then arrival; then admission (or queue) order. A prompt's
+wait counts from its arrival at the server (``stamp``), across its admission and its chunks.
+
+What already runs keeps running: a chunk going in layer slices (TF_GLM_FILL_BUDGET_MS, MiaAI-Lab recipe patch 0062)
+finishes its slices, and a chunk pair (TF_GLM_PREFILL_PAIRS) is planned from the order and runs whole; the order is
+taken again between chunks. So a prompt that ages is overtaken by nothing that starts after that. Its wait past what
+arrival order gives it is at most the aging bound, the chunk running when it ages, and (for admission) the replies of
+the streams holding the slots.
+
+Exact: the order changes when each stream's rows fill, never which rows or how they are cut, so every reply, kept
+state and pool row is the one the request gets alone. Rank 0 decides it (its FILL / MFILL / ADMIT messages carry the
+decisions); rank 1 applies them as ever.
+
+Unset or ``fifo`` (the default): the arrival order, through the same code as before.
+
+This tree's own scheduling; not a MiaAI-Lab recipe patch.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+import time
+
+ENV = "TF_GLM_PREFILL_ORDER"
+AGE_ENV = "TF_GLM_PREFILL_AGE_MS"
+AGE_MS = 30_000.0                 # the aging bound's default
+AGE_MOST = 3_600_000.0            # an hour
+
+clock = time.monotonic            # arrivals and ages, in seconds (a simulator may replace it)
+
+
+def order(value: str | None = None) -> str:
+    """TF_GLM_PREFILL_ORDER: ``fifo`` (unset, the default: arrival order) or ``sjf`` (fewest uncached tokens first,
+    with aging)."""
+
+    raw = os.environ.get(ENV, "") if value is None else value
+    value = raw.strip().lower() or "fifo"
+    if value not in ("fifo", "sjf"):
+        raise ValueError(f"{ENV}: fifo (the default) or sjf, not {raw!r}")
+    return value
+
+
+def age_ms(value: str | None = None) -> float:
+    """TF_GLM_PREFILL_AGE_MS: with TF_GLM_PREFILL_ORDER=sjf, how long a prompt may wait before no later arrival goes
+    first (default 30,000 ms; 0: arrival order)."""
+
+    raw = os.environ.get(AGE_ENV, "") if value is None else value
+    try:
+        ms = AGE_MS if raw.strip() == "" else float(raw)
+    except ValueError:
+        ms = -1.0
+    if not (math.isfinite(ms) and 0 <= ms <= AGE_MOST):
+        raise ValueError(f"{AGE_ENV}: milliseconds from 0 to {AGE_MOST:.0f} (default {AGE_MS:.0f}), not {raw!r}")
+    return ms
+
+
+def stamp(stream, at: float | None = None) -> float:
+    """The request's arrival (``stream.arrived``, in ``clock``'s seconds), set once: a request given back to the queue
+    keeps its first."""
+
+    if getattr(stream, "arrived", None) is None:
+        stream.arrived = clock() if at is None else float(at)
+    return stream.arrived
+
+
+def aged(arrived: float, now: float, age_s: float) -> bool:
+    return now - arrived >= age_s
+
+
+def key(background: bool, arrived: float, uncached: int, seq: int, now: float, age_s: float) -> tuple:
+    """A waiting prompt's place, smallest first: foreground before background; then every prompt that has waited
+    ``age_s`` seconds or longer by arrival; then the rest by fewest uncached tokens, then arrival; ``seq`` (admission
+    or queue order) breaks ties."""
+
+    if aged(arrived, now, age_s):
+        return (int(bool(background)), 0, arrived, 0, seq)
+    return (int(bool(background)), 1, int(uncached), arrived, seq)
+
+
+def describe(age_s: float) -> str:
+    """The startup line's words for the setting."""
+
+    return (f"waiting prompts fill fewest uncached tokens first, none overtaken by a later arrival after "
+            f"{age_s * 1000:g} ms (TF_GLM_PREFILL_ORDER=sjf, TF_GLM_PREFILL_AGE_MS)")
diff --git a/tests/glm_prefill_sim.py b/tests/glm_prefill_sim.py
new file mode 100644
index 0000000..8e1a6b8
--- /dev/null
+++ b/tests/glm_prefill_sim.py
@@ -0,0 +1,299 @@
+"""An arrival simulator for the --parallel scheduler, for TF_GLM_PREFILL_ORDER (``prefill_order``): the engine's own
+``multi.GlmScheduler`` (driven by hand, one ``_iteration`` at a time) and ``multi.MultiDecoder`` at world 1 over the
+fake AFD wire, on tests/test_glm_sliced_fill.py's layered fake model (``layered``, ``SlicedWorld1``), in virtual time.
+
+Every iteration's work is what rank 0 decided (``MultiDecoder._emit``'s ops: FILL / MFILL prompt chunks, two of them
+for a TF_GLM_PREFILL_PAIRS pair, FILLPART / MFILLPART layer slices, ROUND decode rounds), and a cost model (``Costs``)
+gives its milliseconds, so the clock moves as the hardware's would. Requests come from ``users`` closed-loop clients:
+each sends a prompt of a size drawn from ``sizes``, waits for its reply, thinks an exponential time (mean ``think_s``:
+a Poisson source while idle) and sends the next; one seed gives FIFO and SJF the same clients, prompts and think times.
+Each request: its arrival, admission, first prompt chunk, first token (TTFT, at the end of the iteration that sampled
+it) and end.
+
+The aging check (``violations``): at every prompt chunk decided (a FILL, an MFILL, a pair, a sliced chunk's first
+slice) no filling stream that has waited ``age_ms`` is left out while a stream that arrived after it is in; at every
+admission no queued request that has waited ``age_ms`` and arrived earlier is still queued. A chunk going on (its later
+slices) is not a decision.
+
+The requests do not draft (``draft: false``: one token a round, no kept prompts), so the decode cost is per token;
+their replies are the fake model's and are not checked here (tests/test_glm_prefill_order.py checks replies).
+"""
+
+from __future__ import annotations
+
+import math
+import queue
+import random
+from dataclasses import dataclass, field
+
+ALIGN = 2048
+
+
+@dataclass
+class Costs:
+    """Milliseconds of the hardware's work, by default the final config's on the attention/expert split as measured: a
+    prompt chunk of R rows ``chunk_ms + row_ms * R`` (2,048 rows 1.92 s: a cold 100K alone ~94 s); a chunk pair
+    ``pair`` of its two chunks alone (pairs made prefill +23-25%); a decode round ``round_ms + stream_ms * n`` for n
+    streams, one token each (one stream ~85 tok/s, four ~122 tok/s together)."""
+
+    chunk_ms: float = 80.0
+    row_ms: float = 0.9
+    pair: float = 0.8
+    round_ms: float = 4.8
+    stream_ms: float = 7.0
+
+    def chunk(self, rows: int) -> float:
+        return self.chunk_ms + self.row_ms * rows
+
+    def round(self, n: int) -> float:
+        return self.round_ms + self.stream_ms * n
+
+
+@dataclass(eq=False)
+class Request:
+    user: int
+    k: int
+    size: int
+    arrival: float
+    admitted: float = math.nan
+    started: float = math.nan              # its first prompt chunk (or first slice) began
+    first: float = math.nan                # its first token (the end of that iteration)
+    done: float = math.nan
+    sid: int = -1
+
+    @property
+    def ttft(self) -> float:
+        return self.first - self.arrival
+
+    @property
+    def wait(self) -> float:
+        return self.started - self.arrival
+
+
+@dataclass
+class Config:
+    order: str | None                       # TF_GLM_PREFILL_ORDER (None: unset)
+    users: int = 5                          # concurrent clients (c)
+    per_user: int = 6                       # requests each
+    sizes: tuple = (2048, 8192, 32768, 100000)
+    think_s: float = 2.0
+    tg: int = 128
+    seed: int = 1
+    streams: int = 4                        # --parallel
+    pool: int = 626_688                     # the final config's pool (tokens)
+    prefill_rows: int = 2048
+    budget: str | None = "200"              # TF_GLM_FILL_BUDGET_MS
+    drafts: str | None = "1"                # TF_GLM_FILL_DRAFTS
+    group: bool = True                      # TF_GLM_MULTI_PREFILL
+    pairs: bool = True                      # TF_GLM_PREFILL_PAIRS
+    age_ms: float | None = None             # TF_GLM_PREFILL_AGE_MS (None: unset, 30,000)
+    costs: Costs = field(default_factory=Costs)
+
+
+def _env(mp, name: str, value) -> None:
+    if value is None:
+        mp.delenv(name, raising=False)
+    else:
+        mp.setenv(name, str(value))
+
+
+def run(env, cfg: Config) -> dict:
+    """One simulated run on ``env`` (tests/test_glm_multi_afd.py's ``afd_fake`` fixture). Returns the requests and
+    the run's counters."""
+
+    from tensorfold.cuda.scheduler import Waiting
+    from tensorfold.cuda.streams import Stream
+    from tensorfold.families.glm5_next.cuda import multi, prefill_order, sliced_fill
+    from tests import test_glm_multi as tm
+    from tests import test_glm_sliced_fill as tsf
+
+    mp = env.monkeypatch
+    _env(mp, prefill_order.ENV, cfg.order)
+    _env(mp, prefill_order.AGE_ENV, None if cfg.age_ms is None else f"{cfg.age_ms:g}")
+    _env(mp, "TF_GLM_MULTI_PREFILL", "1" if cfg.group else None)
+    _env(mp, "TF_GLM_PREFILL_PAIRS", "1" if cfg.pairs else None)
+    tsf.layered(mp, cfg.budget, drafts=cfg.drafts)
+    L = len(tsf.KINDS)
+    c = cfg.costs
+    # the startup layer costs from the cost model (not FakeEvent's), and kept so (nothing learned from fake events)
+    samples = {r: tuple([c.chunk(r) / L] * L) for r in (64, 256, 512, 1024, 2048) if r <= cfg.prefill_rows}
+    mp.setattr(multi.MultiDecoder, "_time_prompt_layers", lambda self: sliced_fill.LayerCosts(samples))
+    for name in ("observe", "observe_tail", "observe_overhead"):
+        mp.setattr(sliced_fill.LayerCosts, name, lambda self, *a: None)
+    now = [0.0]
+    mp.setattr(prefill_order, "clock", lambda: now[0])
+    node = tsf.SlicedWorld1(env, streams=cfg.streams, blocks=cfg.pool // ALIGN, prefill_rows=cfg.prefill_rows,
+                            entries=32)
+    d = node.d
+    assert d.order == (cfg.order or "fifo") and d.pairs == cfg.pairs and d.group == cfg.group
+    sched = multi.GlmScheduler.__new__(multi.GlmScheduler)     # Scheduler.__init__'s fields, no worker thread
+    sched.held, sched.gather_s, sched.sjf = None, 0.0, d.order == "sjf"
+    sched.decoder, sched.max_streams, sched.waiting, sched.boxes, sched.yields = d, cfg.streams, Waiting(), {}, 0
+    age_s = d.age_s
+
+    rng = random.Random(cfg.seed)
+    plans = [[(rng.choice(cfg.sizes), rng.expovariate(1.0 / cfg.think_s)) for _ in range(cfg.per_user)]
+             for _ in range(cfg.users)]
+    reqs: list[Request] = []
+    req_of: dict[int, Request] = {}                    # id(stream) -> its request
+    boxes: dict[int, tuple[Request, queue.Queue]] = {}
+    nxt = {u: (plans[u][0][1], 0) for u in range(cfg.users)}     # user -> (its next arrival, request index)
+    violations = {"fill": 0, "admit": 0}
+    work = {"fills": 0, "pairs": 0, "slices": 0, "rounds": 0}
+
+    def arrive(u: int, at: float, k: int) -> None:
+        size = plans[u][k][0]
+        r = Request(u, k, size, at)
+        box: queue.Queue = queue.Queue()
+        s = Stream(tm._prompt(size, cfg.seed * 1_000_003 + u * 1009 + k), cfg.tg, None, draft=False, stop_eos=False)
+        s.glm = {"code": [0, 0, 0, 0], "spec": "0"}
+        s.emit = lambda new, box=box: (box.put(("tokens", new)), False)[1]
+        if sched.sjf:
+            prefill_order.stamp(s, at)                 # what the scheduler's submit stamps: its arrival
+        reqs.append(r)
+        req_of[id(s)] = r
+        boxes[id(s)] = (r, box)
+        sched.waiting.put((s, box))
+
+    # -- each iteration's ops as rank 0 decides them, with the streams' positions then; the two checks
+    ops: list[tuple] = []
+    picked_now: set[int] = set()
+    emit, admit = d._emit, d.admit
+
+    def chosen(op: int, p: list[int]) -> set[int]:
+        if op in (multi.FILL, multi.FILLPART):
+            return {p[0]}
+        if op == multi.MFILL:
+            return set(p[1:1 + 2 * p[0]:2])
+        return set(p[3::2])                            # MFILLPART
+
+    def check_fill(picked: set[int]) -> None:
+        latest = max(req_of[id(d.lanes[s].s)].arrival for s in picked)
+        for sid, lane in d.lanes.items():
+            a = req_of[id(lane.s)].arrival
+            if sid not in picked and not lane.decoding and not lane.s.done and now[0] - a >= age_s and a < latest:
+                violations["fill"] += 1
+
+    def logged(op: int, payload):
+        p = [int(v) for v in payload]
+        ops.append((op, p, {sid: lane.st.pos for sid, lane in d.lanes.items()}))
+        decision = op in (multi.FILL, multi.MFILL) or (
+            op in (multi.FILLPART, multi.MFILLPART) and (p[2] if op == multi.FILLPART else p[1]) == 0)
+        if decision:                                   # a pair's two chunks are one decision
+            picked_now.update(chosen(op, p))
+            check_fill(picked_now)
+        return emit(op, payload)
+
+    def admitted(s):
+        me = req_of[id(s)].arrival
+        with sched.waiting.mutex:
+            queued = [x[2][0] for x in sched.waiting.queue if x[2] is not None]
+        if sched.held is not None and sched.held[0] is not s:
+            queued.append(sched.held[0])
+        for q in queued:
+            a = req_of[id(q)].arrival
+            if now[0] - a >= age_s and a < me:
+                violations["admit"] += 1
+        admit(s)
+        r = req_of[id(s)]
+        r.sid, r.admitted = s.sid, now[0]
+
+    d._emit, d.admit = logged, admitted
+
+    def cost() -> float:
+        fills, ms = [], 0.0
+        pos: dict[int, int] = {}
+        for op, p, at in ops:
+            if op in (multi.FILL, multi.MFILL):
+                pieces = [(p[0], p[1])] if op == multi.FILL else list(zip(p[1:1 + 2 * p[0]:2], p[2:2 + 2 * p[0]:2]))
+                rows = 0
+                for sid, stop in pieces:                # a pair's second chunk starts where its first stopped
+                    rows += stop - pos.get(sid, at[sid])
+                    pos[sid] = stop
+                fills.append(rows)
+            elif op in (multi.FILLPART, multi.MFILLPART):
+                pieces = [(p[0], p[1])] if op == multi.FILLPART else list(zip(p[3::2], p[4::2]))
+                lo, hi = (p[2], p[3]) if op == multi.FILLPART else (p[1], p[2])
+                rows = sum(stop - at[sid] for sid, stop in pieces)   # positions move only after the last slice
+                ms += c.chunk(rows) * (hi - lo) / L
+                work["slices"] += 1
+            elif op == multi.ROUND:
+                ms += c.round(p[0])
+                work["rounds"] += 1
+        if len(fills) == 2:
+            ms += c.pair * (c.chunk(fills[0]) + c.chunk(fills[1]))
+            work["pairs"] += 1
+        elif fills:
+            ms += c.chunk(fills[0])
+        work["fills"] += len(fills)
+        return ms / 1000.0
+
+    finished, total = 0, cfg.users * cfg.per_user
+    for _ in range(50_000_000):
+        if finished == total:
+            break
+        for u, (at, k) in sorted(nxt.items(), key=lambda x: x[1][0]):
+            if at <= now[0]:
+                arrive(u, at, k)
+                del nxt[u]
+        if not d.lanes and sched.held is None and sched.waiting.empty():
+            if not nxt:
+                raise AssertionError("nothing runs and nothing is to come")
+            now[0] = max(now[0], min(at for at, _ in nxt.values()))
+            continue
+        ops.clear()
+        picked_now.clear()
+        start = now[0]
+        sched._iteration()
+        now[0] = start + cost()
+        for sid in {s for op, p, _ in ops if op in (multi.FILL, multi.MFILL, multi.FILLPART, multi.MFILLPART)
+                    for s in chosen(op, p)}:
+            lane = d.lanes.get(sid)
+            r = req_of[id(lane.s)] if lane is not None else next((q for q in reqs if q.sid == sid), None)
+            if r is not None and math.isnan(r.started):
+                r.started = start
+        for key in list(boxes):
+            r, box = boxes[key]
+            while True:
+                try:
+                    kind, value = box.get_nowait()
+                except queue.Empty:
+                    break
+                if kind == "tokens" and math.isnan(r.first):
+                    r.first = now[0]
+                elif kind == "error":
+                    raise value
+                elif kind == "done":
+                    r.done = now[0]
+                    finished += 1
+                    del boxes[key]
+                    if r.k + 1 < cfg.per_user:
+                        nxt[r.user] = (now[0] + plans[r.user][r.k + 1][1], r.k + 1)
+                    break
+    else:
+        raise AssertionError("the simulation did not finish")
+    return {"config": cfg, "requests": reqs, "violations": dict(violations), "work": dict(work),
+            "ordered": dict(d.ordered or {}), "paired": dict(d.paired), "sliced": dict(d.sliced),
+            "grouped": dict(d.grouped), "end_s": now[0], "age_s": age_s}
+
+
+def pct(xs: list[float], q: float) -> float:
+    """The q-quantile of xs (nearest rank)."""
+
+    xs = sorted(xs)
+    return xs[max(0, math.ceil(q * len(xs)) - 1)] if xs else math.nan
+
+
+def stats(xs: list[float]) -> dict:
+    return {"n": len(xs), "mean": sum(xs) / len(xs) if xs else math.nan, "p50": pct(xs, 0.5), "p90": pct(xs, 0.9),
+            "max": max(xs) if xs else math.nan}
+
+
+def summary(res: dict) -> dict:
+    """TTFT (s) overall and by prompt size, the wait for the first chunk, and the run's counters."""
+
+    reqs = res["requests"]
+    return {"ttft": stats([r.ttft for r in reqs]), "wait": stats([r.wait for r in reqs]),
+            "by_size": {s: stats([r.ttft for r in reqs if r.size == s]) for s in sorted({r.size for r in reqs})},
+            "violations": res["violations"], "work": res["work"], "ordered": res["ordered"],
+            "paired": res["paired"], "sliced": res["sliced"], "grouped": res["grouped"], "end_s": res["end_s"]}
