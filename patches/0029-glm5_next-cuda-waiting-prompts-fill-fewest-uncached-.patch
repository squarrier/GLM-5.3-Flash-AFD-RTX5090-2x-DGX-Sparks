+    def _admit_sjf(self, first=None, until: float | None = None) -> list[Stream]:
+        """TF_GLM_PREFILL_ORDER=sjf: ``_admit`` taking the waiting requests in ``prefill_order``'s order (fewest
+        uncached tokens first, those that have waited the aging bound first by arrival) instead of arrival order. The
+        request held for room goes back among them: one that fits can go first, until the held one has aged (then it
+        is first again, and waits for room as before). With an idle server's wait (``until``) the arrivals are taken
+        until the deadline or until they fill the free slots, then admitted in the order."""
+
+        for item in (self.held, first):          # back in the queue: everything waiting is ordered together
+            if item is not None:
+                self.waiting.put(item)
+        self.held = None
+        if until is not None:
+            free = self.max_streams - self.decoder.live()
+            with self.waiting.not_empty:
+                while self.waiting._qsize() < free:
+                    left = until - time.monotonic()
+                    if left <= 0:
+                        break
+                    self.waiting.not_empty.wait(left)
+        done: list[Stream] = []
+        while self.decoder.live() < self.max_streams:
+            item = self._next_waiting()
+            if item is None:
+                break
+            stream, box = item
+            if not self.decoder.fits(stream):
+                self.held = item                     # waits for room, and is ordered with the queue again next time
+                break
+            self.boxes[id(stream)] = box
+            try:
+                self.decoder.admit(stream)
+            except NoRoom:
+                self.boxes.pop(id(stream))
+                self.held = item
+                break
+            except Exception as exc:                 # noqa: BLE001  (this request fails, the others go on)
+                self.boxes.pop(id(stream)).put(("error", exc))
+                continue
+            if stream.done:
+                done.append(stream)
+        return done
+
+    def _next_waiting(self):
+        """The waiting request ``prefill_order`` puts first, taken out of the queue (None when none waits; ``close``'s
+        stop stays for the idle get). Only this worker thread takes from the queue, so the request is still there when
+        its key has been computed outside the queue's lock."""
+
+        with self.waiting.mutex:
+            entries = [x for x in self.waiting.queue if x[2] is not None]
+        if not entries:
+            return None
+        d = self.decoder
+        now = prefill_order.clock()
+
+        def place(entry):
+            prio, seq, (stream, _) = entry
+            return prefill_order.key(prio == 1, prefill_order.stamp(stream), d.uncached(stream), seq, now, d.age_s)
+
+        best = min(entries, key=place)
+        with self.waiting.mutex:
+            q = self.waiting.queue
+            q.pop(next(i for i, x in enumerate(q) if x is best))
+            heapq.heapify(q)
+        counts = d.ordered
+        if counts is not None:                   # reordered: not the earliest arrival (``first`` / ``held`` re-queued)
+            counts["admits"] += 1
+            fifo = min(entries, key=lambda x: (x[0], prefill_order.stamp(x[2][0]), x[1]))
+            counts["admits_reordered"] += int(best is not fifo)
+        return best[2]
+
