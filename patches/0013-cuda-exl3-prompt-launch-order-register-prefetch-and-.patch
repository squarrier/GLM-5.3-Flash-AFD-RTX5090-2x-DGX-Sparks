+def test_shared_suh_is_bitwise():
+    a = (torch.rand((1, 128)) + 0.5).half()
+    same = a.expand(4, 128).contiguous()
+    assert torch.equal(generic.shared_suh(same, same.clone()), a[0])
+    other = same.clone()
+    other[2, 5] = other[2, 5] * 2
+    assert generic.shared_suh(other, other.clone()) is None and generic.shared_suh(same, other) is None
+    z = torch.zeros((3, 128), dtype=torch.float16)
+    nz = z.clone()
+    nz[1, 0] = -0.0
+    assert generic.shared_suh(z, z.clone()) is not None and generic.shared_suh(nz, nz.clone()) is None
+    assert generic.shared_suh(same.float(), same.float()) is None
