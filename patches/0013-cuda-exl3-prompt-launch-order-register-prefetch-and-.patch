+void exl3x_rot_rows_cuda(const at::Tensor& x, int64_t x_stride, const at::Tensor& suh, at::Tensor& out, int64_t rows,
+                         int64_t K) {
+    dim3 grid((unsigned)rows, (unsigned)(K / 128), 1);
+    auto stream = at::cuda::getCurrentCUDAStream();
+    auto s = reinterpret_cast<const half*>(suh.data_ptr());
+    auto o = reinterpret_cast<half*>(out.data_ptr());
+    if (x.scalar_type() == at::kBFloat16)
+        rot_in_kernel<__nv_bfloat16, true><<<grid, 32, 0, stream>>>(
+            reinterpret_cast<const __nv_bfloat16*>(x.data_ptr()), (int)x_stride, nullptr, s, s, o, o, (int)K, 1, 1);
+    else
+        rot_in_kernel<half, true><<<grid, 32, 0, stream>>>(reinterpret_cast<const half*>(x.data_ptr()), (int)x_stride,
+                                                           nullptr, s, s, o, o, (int)K, 1, 1);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void exl3x_order_cuda(const at::Tensor& uids, const at::Tensor& ucount, const at::Tensor& members, at::Tensor& order,
+                      int64_t cap, int64_t E) {
