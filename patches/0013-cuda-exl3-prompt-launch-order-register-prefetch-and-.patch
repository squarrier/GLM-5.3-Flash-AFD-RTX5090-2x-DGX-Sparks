+def test_switches_need_glms_4bit_mcg_layer(monkeypatch):
+    fake = FakeExt()
+    monkeypatch.setattr(generic, "_ext", lambda: fake)
+    for ex in (_layer(k2=6), _layer(cb=generic.CB_MUL1), _layer(share=False)):
+        fake.calls.clear()
+        s = generic.Scratch(ex, 64, SLOTS, device="cpu")
+        generic.routed(torch.zeros((64, ex.dims), dtype=torch.bfloat16), torch.zeros((64, SLOTS), dtype=torch.int32),
+                       None, ex, s, None, 64, nfirst=True, prefetch=True, order=True, rowrot=True)
+        gu, _ = _today(fake)
+        if ex.cb == generic.CB_MCG and ex.k2_gu == (8, 8):     # the unshared layer: all but rowrot
+            assert ex.shared_suh is None and gu[OLD_ARGS:] == (True, s.order, generic.order_slots(64, SLOTS, E),
+                                                               True, False)
+        else:
+            assert gu[OLD_ARGS:] == (False, None, 0, False, False), (ex.cb, ex.k2_gu)
