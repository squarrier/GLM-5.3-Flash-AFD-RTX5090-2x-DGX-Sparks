index 0000000..7dfbbbc
--- /dev/null
+++ b/tests/test_exl3_prompt_switches.py
@@ -0,0 +1,385 @@
+"""The prompt switches of the universal EXL3 routed-expert route (``tensorfold/cuda/exl3``; adapted from MiaAI-Lab's
+GLM-5.3-Flash recipe patches 0001, 0020 and 0009), on CPU:
+
+- a pure-Python model of ``grouped_kernel``'s launch (grid and index math, as ``grouped_launch`` and
+  ``prompt_grouped_launch`` size it) covers every (expert, member tile, n block, split, matrix) of a grouping exactly
+  once, and nothing else, in the decode order and under NFIRST, ORDER and both;
+- a model of ``prompt_order_kernel`` (the same per-thread ranges, scans and merge arithmetic) gives a permutation of the
+  routed items that keeps each list's plan order, leaves the shared expert out and fits ``order_slots``;
+- the plumbing: ``exl3_generic.switches`` reads Mia's env names (on from 64 rows, ``=0`` turns one off), GLM's call
+  sites (``exl3_generic.routed``, ``ExpertNode.compute``) pass them, and a caller that passes none (every other family)
+  makes today's calls, argument for argument.
+The GPU side (bits, switches on vs off) is tests/cuda/test_exl3_prompt_switches.py."""
+
+from __future__ import annotations
+
+import itertools
+import math
+import random
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tensorfold.cuda.exl3 import experts as generic
+from tensorfold.families.glm5_next.cuda import exl3_generic
+
+E, TOPK, SLOTS = 288, 8, 9                    # GLM-5.3-Flash: 288 routed experts, top 8, the shared expert last
+GU = {"mats": 2, "SK": 4, "nt": 8}             # GLM_GATEUP's launch, a half's 4096 -> 1024
+DN = {"mats": 1, "SK": 1, "nt": 8}             # GLM_DOWN's, 1024 -> 4096
+Y_MAX = 65535
+
+
+# ------------------------------------------------------------------------------------------- the grouping (model)
+
+def picks(R: int, rng: random.Random, skew: bool) -> list[list[int]]:
+    """R rows of TOPK distinct routed experts and the shared slot (id E); ``skew``: a few experts take most rows."""
+
+    hot = rng.sample(range(E), 12)
+    rows = []
+    for _ in range(R):
+        if skew:
+            row = rng.sample(hot, 6) + rng.sample([e for e in range(E) if e not in hot], TOPK - 6)
+        else:
+            row = rng.sample(range(E), TOPK)
+        rows.append(row + [E])
+    return rows
+
+
+def group(pick: list[list[int]], maxm: int) -> tuple[list[int], list[list[int]]]:
+    """group_kernel: distinct routed experts (< E) in id order; members row * 32 + slot in row order, -1 after."""
+
+    n = len(pick) * SLOTS
+    flat = [pick[i // SLOTS][i % SLOTS] for i in range(n)]
+    uids = sorted({e for e in flat if 0 <= e < E})
+    members = []
+    for e in uids:
+        m = [(i // SLOTS) * 32 + i % SLOTS for i in range(n) if flat[i] == e][:maxm]
+        members.append(m + [-1] * (maxm - len(m)))
+    return uids, members
+
+
+def count(members_u: list[int]) -> int:
+    return next((i for i, c in enumerate(members_u) if c < 0), len(members_u))
+
+
+# ------------------------------------------------------------------------------------- prompt_order_kernel (model)
+
+def order_model(uids, members, maxm: int, cap: int, threads: int = 1024) -> list[int]:
+    """prompt_order_kernel, step by step: per-thread expert ranges, the heavy/light scans, the merge positions."""
+
+    U, MT = len(uids), (maxm + 15) // 16
+    per = (U + threads - 1) // threads
+
+    def items_of(u: int) -> int:
+        if uids[u] >= E:
+            return 0
+        a, b = 0, maxm                                  # first -1 by bisection, as the kernel
+        while a < b:
+            c = (a + b) >> 1
+            if members[u][c] >= 0:
+                a = c + 1
+            else:
+                b = c
+        return (a + 15) >> 4
+
+    ranges = [(min(U, t * per), min(U, min(U, t * per) + per)) for t in range(threads)]
+    hl = []
+    for lo, hi in ranges:
+        h = sum(n for n in map(items_of, range(lo, hi)) if n >= 2)
+        lsum = sum(n for n in map(items_of, range(lo, hi)) if n < 2)
+        hl.append((h, lsum))
+    nh, nl = sum(h for h, _ in hl), sum(lt for _, lt in hl)
+    assert nh + nl <= cap, (nh, nl, cap)                # the kernel traps here: never
+    order = [-2] * cap
+    rh = rl = 0
+    for (lo, hi), (h, lt) in zip(ranges, hl):           # exclusive prefix = the scans' value at the range start
+        for u in range(lo, hi):
+            n = items_of(u)
+            for q in range(n):
+                if n >= 2:
+                    r = rh
+                    rh += 1
+                    X = (2 * r + 1) * nl
+                    cl = min(nl, (X - nh + 2 * nh - 1) // (2 * nh)) if X > nh else 0
+                    pos = r + cl
+                else:
+                    lr = rl
+                    rl += 1
+                    Y = (2 * lr + 1) * nh
+                    ch = min(nh, (Y - nl) // (2 * nl) + 1) if Y >= nl else 0
+                    pos = lr + ch
+                assert order[pos] == -2, pos
+                order[pos] = u * MT + q
+    for s in range(nh + nl, cap):
+        order[s] = -1
+    return order
+
+
+# ------------------------------------------------------------------------------------- grouped_kernel's launch (model)
+
+def launch(uids, members, maxm: int, R: int, mats: int, SK: int, nt: int, N: int, *, nfirst: bool, order: bool):
+    """Every block of the launch and what it computes: a Counter of (u, mtile, n block, split, mat)."""
+
+    U, MT, NB = len(uids), (maxm + 15) // 16, N // (16 * nt)
+    nexp_max = min(R * SLOTS, E)
+    cap = generic.order_slots(R, SLOTS, E)
+    obuf = order_model(uids, members, maxm, cap) if order else None
+    items = cap if order else nexp_max
+    zdim = mats * SK if order else mats * SK * MT
+    gx, gy = (NB, items) if nfirst else (items, NB)
+    assert gy <= Y_MAX and zdim <= Y_MAX, (gx, gy, zdim)
+    done = {}
+    for bz in range(zdim):
+        for by in range(gy):
+            for bx in range(gx):
+                ib, nb = (by, bx) if nfirst else (bx, by)
+                if order:
+                    item = obuf[ib]
+                    if item < 0:
+                        continue
+                    u, mtile = divmod(item, MT)
+                    split, mat = bz % SK, bz // SK
+                else:
+                    u = ib
+                    if u >= U:
+                        continue
+                    mtile, split, mat = bz % MT, (bz // MT) % SK, bz // MT // SK
+                if mtile * 16 >= maxm or members[u][mtile * 16] < 0:
+                    continue                            # members come first: an empty tile
+                key = (u, mtile, nb, split, mat)
+                done[key] = done.get(key, 0) + 1
+    return done
+
+
+def required(uids, members, mats: int, SK: int, NB: int) -> set:
+    return {(u, t, nb, s, m) for u in range(len(uids)) for t in range((count(members[u]) + 15) // 16)
+            for nb in range(NB) for s in range(SK) for m in range(mats)}
+
+
+CASES = [(1, False), (8, False), (64, False), (64, True), (128, True), (594, False), (594, True), (1024, True),
+         (2048, False), (4096, True)]
+
+
+@pytest.mark.parametrize("R,skew", CASES)
+def test_every_block_of_every_order_covers_each_item_exactly_once(R, skew):
+    rng = random.Random(1000 * R + skew)
+    maxm = R
+    uids, members = group(picks(R, rng, skew), maxm)
+    for spec, N in ((GU, 1024), (DN, 4096)):
+        # the n block axis is independent of the item axis: two n blocks are enough past 594 rows (time)
+        nt = spec["nt"] if R <= 594 else N // 32
+        NB = N // (16 * nt)
+        need = required(uids, members, spec["mats"], spec["SK"], NB)
+        for nfirst in (False, True):
+            for order in (False, True):
+                got = launch(uids, members, maxm, R, spec["mats"], spec["SK"], nt, N, nfirst=nfirst, order=order)
+                assert set(got) == need, (R, skew, spec, nfirst, order)
+                assert max(got.values()) == 1, (R, skew, spec, nfirst, order)
+
+
+@pytest.mark.parametrize("R", [64, 128, 594, 1024, 2048, 4096, 8192, 65536])
+def test_prompt_grids_stay_within_cuda_limits_at_glm_shapes(R):
+    MT, cap, nexp = (R + 15) // 16, generic.order_slots(R, SLOTS, E), min(R * SLOTS, E)
+    for spec in (GU, DN):
+        assert spec["mats"] * spec["SK"] * MT <= Y_MAX     # z without ORDER (today's z)
+        assert nexp <= Y_MAX                                # y with NFIRST, without ORDER
+        assert cap <= Y_MAX or R > 100_000                  # y with NFIRST and ORDER (routed() drops ORDER past it)
+
+
+@pytest.mark.parametrize("R,skew", [(64, False), (64, True), (594, True), (2048, False), (2048, True), (4096, True)])
+def test_order_is_a_permutation_in_plan_order_without_the_shared_expert(R, skew):
+    rng = random.Random(7 * R + skew)
+    uids, members = group(picks(R, rng, skew), R)
+    MT, cap = (R + 15) // 16, generic.order_slots(R, SLOTS, E)
+    obuf = order_model(uids, members, R, cap)
+    items = [u * MT + q for u in range(len(uids)) for q in range((count(members[u]) + 15) // 16)]
+    n = len(items)
+    assert sorted(obuf[:n]) == items and obuf[n:] == [-1] * (cap - n)
+    assert all(uids[x // MT] < E for x in obuf[:n])     # never the shared expert (id E)
+    heavy = {u for u in range(len(uids)) if count(members[u]) > 16}
+    hs = [x for x in obuf[:n] if x // MT in heavy]
+    ls = [x for x in obuf[:n] if x // MT not in heavy]
+    assert hs == sorted(hs) and ls == sorted(ls)        # each list keeps plan order
+    if hs and ls:                                       # evenly merged: no run of one kind much past its share
+        runs = [len(list(g)) for _, g in itertools.groupby(x // MT in heavy for x in obuf[:n])]
+        assert max(runs) <= math.ceil(max(len(hs), len(ls)) / min(len(hs), len(ls))) + 1, runs
+
+
+def test_order_edge_cases():
+    # all light (one member each), all heavy (one expert, many members), nothing routed, a stray shared uid
+    MT = 1
+    uids, members = group([[e, E] + [E] * 7 for e in range(16)], 16)
+    assert order_model(uids, members, 16, 20)[:16] == [u * MT for u in range(16)]
+    uids, members = group([[5] + [E] * 8 for _ in range(64)], 64)
+    assert order_model(uids, members, 64, generic.order_slots(64, SLOTS, E))[:4] == [0, 1, 2, 3]
+    assert order_model([], [], 64, 10) == [-1] * 10
+    stray = order_model([3, E], [[0, 32, 64] + [-1] * 61, [1] * 64], 64, 8)
+    assert stray == [0] + [-1] * 7
+
+
+def test_order_slots_bounds_every_grouping():
+    rng = random.Random(3)
+    for R in (1, 2, 7, 16, 17, 64, 100, 594, 1024):
+        for skew in (False, True):
+            _, members = group(picks(R, rng, skew), R)
+            n = sum((count(m) + 15) // 16 for m in members)
+            assert n <= generic.order_slots(R, SLOTS, E), (R, skew, n)
+
+
+# ---------------------------------------------------------------------------------------------------- plumbing
+
+def test_switches_read_mias_env_names(monkeypatch):
+    for v in exl3_generic.SWITCHES.values():
+        monkeypatch.delenv(v, raising=False)
+    assert exl3_generic.switches(1) == {} and exl3_generic.switches(63) == {}
+    assert exl3_generic.switches(64) == {"nfirst": True, "prefetch": True, "order": True, "rowrot": True}
+    assert set(exl3_generic.SWITCHES.values()) == {"TF_GLM_EXL3_NFIRST", "TF_GLM_EXL3_PF", "TF_GLM_EXL3_ORDER",
+                                                    "TF_GLM_EXL3_ROWROT"}
+    for k, v in exl3_generic.SWITCHES.items():
+        monkeypatch.setenv(v, "0")
+        got = exl3_generic.switches(2048)
+        assert got[k] is False and all(got[o] for o in exl3_generic.SWITCHES if o != k), (k, got)
+        for other in ("1", "", "false", "00"):          # as Mia's: only "0" turns one off
+            monkeypatch.setenv(v, other)
+            assert exl3_generic.switches(2048)[k] is True, (k, other)
+        monkeypatch.delenv(v)
+    monkeypatch.setenv("TF_GLM_EXL3_NFIRST", "0")
+    assert exl3_generic.switches(8) == {}               # decode windows never read them
+
+
+class FakeExt:
+    """The extension's calls, recorded (no kernel runs)."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __getattr__(self, name):
+        def call(*args):
+            self.calls.append((name, args))
+        return call
+
+    def named(self, name):
+        return [a for n, a in self.calls if n == name]
+
+
+def _layer(D=256, NI=128, k2=8, cb=generic.CB_MCG, share=True):
+    g = torch.Generator().manual_seed(1)
+
+    def sc(n):
+        return (torch.rand((E, n), generator=g) + 0.5).half()
+
+    suh = sc(D)[:1].expand(E, D).contiguous() if share else sc(D)
+    i64, i32 = torch.zeros(E, dtype=torch.int64), torch.full((E,), k2, dtype=torch.int32)
+    ex = generic.Exl3RoutedExperts(i64, i64, i64, i32, i32, i32, suh, suh.clone(), sc(NI), sc(NI), sc(NI), sc(D),
+                                   E, D, NI, cb, (k2, k2), (k2, k2), torch.zeros(E, dtype=torch.int64))
+    return exl3_generic.share_suh(ex)
+
+
+def _run(monkeypatch, fn, R, rows=128):
+    fake = FakeExt()
+    monkeypatch.setattr(generic, "_ext", lambda: fake)
+    ex = _layer()
+    s = generic.Scratch(ex, rows, SLOTS, device="cpu")
+    x = torch.zeros((R, ex.dims), dtype=torch.bfloat16)
+    pick = torch.zeros((R, SLOTS), dtype=torch.int32)
+    fn(x, pick, ex, s, R)
+    return fake, ex, s
+
+
+# the 22 arguments ext.grouped took before the switches (both launches), then the 5 switch arguments
+OLD_ARGS, NEW_ARGS = 22, 27
+
+
+def _today(fake):
+    gu, dn = fake.named("grouped")
+    assert len(gu) == len(dn) == NEW_ARGS
+    return gu, dn
+
+
+def test_glm_call_site_sets_the_switches_from_64_rows(monkeypatch):
+    for v in exl3_generic.SWITCHES.values():
+        monkeypatch.delenv(v, raising=False)
+    fake, ex, s = _run(monkeypatch, lambda x, p, ex, s, R: exl3_generic.routed(x, p, ex, s, R, 7.0), 64)
+    gu, dn = _today(fake)
+    assert ex.shared_suh is not None
+    assert [n for n, _ in fake.calls] == ["group", "order", "rot_rows", "grouped", "gateup_epilogue", "grouped",
+                                          "down_epilogue"]
+    cap = generic.order_slots(64, SLOTS, E)
+    assert gu[OLD_ARGS:] == (True, s.order, cap, True, True)          # nfirst, order, slots, prefetch, rowrot
+    assert dn[OLD_ARGS:] == (True, s.order, cap, True, False)         # down reads xd: no rowrot
+    assert gu[0] is s.xg and gu[1] is s.xg                            # X0 = X1 = the per-row Xh
+    assert fake.named("order")[0][3:] == (s.order, cap, E)
+    monkeypatch.setenv("TF_GLM_EXL3_ROWROT", "0")
+    monkeypatch.setenv("TF_GLM_EXL3_ORDER", "0")
+    fake, ex, s = _run(monkeypatch, lambda x, p, ex, s, R: exl3_generic.routed(x, p, ex, s, R, 7.0), 128)
+    gu, dn = _today(fake)
+    assert "order" not in [n for n, _ in fake.calls] and fake.named("rot_in") and not fake.named("rot_rows")
+    assert gu[OLD_ARGS:] == (True, None, 0, True, False) and dn[OLD_ARGS:] == (True, None, 0, True, False)
