new file mode 100644
index 0000000..95341b2
--- /dev/null
+++ b/tests/cuda/test_exl3_prompt_switches.py
@@ -0,0 +1,108 @@
+"""The prompt switches of the universal EXL3 routed experts (adapted from MiaAI-Lab recipe patches 0001, 0020 and 0009;
+``experts.routed(.., nfirst, prefetch, order, rowrot)``) on the GPU: every combination gives the per-slot outputs and
+the combined rows of the switches-off launch bit for bit, on a GLM-shaped synthetic layer (288 experts, 4096 -> 1024 a
+half, 4-bit mcg, one shared gate/up suh as GLM-5.3-Flash's EXL3 layers have), at prompt windows of 64 to 2,048 rows,
+with uniform and skewed routing; and the order kernel's slots are exactly the grouping's items, then -1.
+The CPU half (launch model, order model, plumbing) is tests/test_exl3_prompt_switches.py."""
+
+from __future__ import annotations
+
+import itertools
+import random
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA only")
+
+E, D, NI, TOPK, SLOTS, LIMIT = 288, 4096, 1024, 8, 9, 10.0
+ROWS = (64, 128, 594, 2048)
+
+
+def _layer(share: bool):
+    from tensorfold.cuda.exl3 import experts
+    from tensorfold.families.glm5_next.cuda import exl3_generic
+
+    g = torch.Generator().manual_seed(11)
+
+    def trel(k, n):                                   # 4-bit trellis tiles: 64 int16 a 16x16 tile
+        v = torch.randint(-32768, 32768, (E, k // 16, n // 16, 64), dtype=torch.int32, generator=g)
+        return v.to(torch.int16).cuda().contiguous()
+
+    def sc(n, mag):
+        sign = torch.randint(0, 2, (E, n), generator=g).float() * 2 - 1
+        return (sign * (torch.rand((E, n), generator=g) + 0.5) * mag).half().cuda().contiguous()
+
+    suh = sc(D, 0.02)
+    if share:
+        suh = suh[:1].expand(E, D).contiguous()
+    ex = experts.prepare_stacked(trel(D, NI), trel(D, NI), trel(NI, D), suh, suh.clone() if share else sc(D, 0.02),
+                                 sc(NI, 0.5), sc(NI, 0.5), sc(NI, 0.05), sc(D, 0.2), "mcg")
+    return exl3_generic.share_suh(ex)
+
+
+def _inputs(R: int, skew: bool, seed: int):
+    rng, g = random.Random(seed), torch.Generator().manual_seed(seed)
+    hot = rng.sample(range(E), 12)
+    rows = []
+    for _ in range(R):
+        if skew:
+            row = rng.sample(hot, 6) + rng.sample([e for e in range(E) if e not in hot], TOPK - 6)
+        else:
+            row = rng.sample(range(E), TOPK)
+        rows.append(row + [E])                        # the shared slot (id E): not an EXL3 expert
+    pick = torch.tensor(rows, dtype=torch.int32).cuda().contiguous()
+    x = torch.randn((R, D), generator=g).to(torch.bfloat16).cuda()
+    w = torch.cat([torch.rand((R, TOPK), generator=g) * 0.2 + 0.05, torch.ones((R, 1))], 1).float().cuda()
+    return x, pick, w.contiguous()
+
+
+COMBOS = [dict(zip(("nfirst", "prefetch", "order", "rowrot"), bits)) for bits in itertools.product((0, 1), repeat=4)]
+
+
+@pytest.mark.parametrize("share", (True, False), ids=("shared-suh", "own-suh"))
+def test_every_switch_combination_keeps_every_bit(share):
+    from tensorfold.cuda.exl3 import experts
+
+    ex = _layer(share)
+    assert (ex.shared_suh is not None) is share
+    s = experts.Scratch(ex, max(ROWS), SLOTS, experts.GLM_GATEUP, experts.GLM_DOWN)
+    assert experts.prompt_ready(ex, s)
+    for R, skew in itertools.product(ROWS, (False, True)):
+        x, pick, w = _inputs(R, skew, seed=R + skew)
+        P = R * SLOTS
+        ref_y = experts.routed(x, pick, None, ex, s, None, R, limit=LIMIT, act_mode=experts.ACT_BF16).clone()
+        ref = experts.routed(x, pick, w, ex, s, None, R, limit=LIMIT, act_mode=experts.ACT_BF16).clone()
+        assert torch.isfinite(ref).all() and ref.abs().sum() > 0
+        for c in COMBOS[1:]:
+            s.y[:P].fill_(7.0)
+            y = experts.routed(x, pick, None, ex, s, None, R, limit=LIMIT, act_mode=experts.ACT_BF16,
+                               **{k: bool(v) for k, v in c.items()})
+            torch.cuda.synchronize()
+            # the shared slot's rows are the caller's (left as filled): compare the routed slots
+            routed = pick.view(-1).long() < E
+            assert torch.equal(y[routed].view(torch.int32), ref_y[routed].view(torch.int32)), (R, skew, c)
+            out = experts.routed(x, pick, w, ex, s, None, R, limit=LIMIT, act_mode=experts.ACT_BF16,
+                                 **{k: bool(v) for k, v in c.items()})
+            torch.cuda.synchronize()
+            assert torch.equal(out.view(torch.int32), ref.view(torch.int32)), (R, skew, c)
+
+
+def test_order_slots_are_the_groupings_items():
+    from tensorfold.cuda.exl3 import experts
+
+    ex = _layer(True)
+    s = experts.Scratch(ex, 2048, SLOTS, experts.GLM_GATEUP, experts.GLM_DOWN)
+    for R, skew in ((64, False), (594, True), (2048, False), (2048, True)):
+        x, pick, w = _inputs(R, skew, seed=3 * R + skew)
+        experts.routed(x, pick, w, ex, s, None, R, limit=LIMIT, act_mode=experts.ACT_BF16, order=True)
+        torch.cuda.synchronize()
+        ids, members = s.window(R)
+        U, MT, cap = int(s.count[0]), (R + 15) // 16, experts.order_slots(R, SLOTS, E)
+        mem = members[:U].cpu()
+        counts = (mem >= 0).sum(1).tolist()
+        items = sorted(u * MT + q for u in range(U) for q in range((counts[u] + 15) // 16))
+        got = s.order[:cap].cpu().tolist()
+        n = len(items)
+        assert sorted(got[:n]) == items and got[n:] == [-1] * (cap - n), (R, skew)
+        assert all(int(ids[x // MT]) < E for x in got[:n])
