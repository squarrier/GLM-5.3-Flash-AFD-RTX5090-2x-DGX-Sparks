+// The launch order of a prompt window's items for grouped_kernel<.., ORDER> (TF_GLM_EXL3_ORDER; adapted from
+// MiaAI-Lab recipe patch 0020's prompt_order_kernel onto this path's grouping). An item is (u, member tile) for
+// u < ucount and tile < ceil(u's members / 16), coded u * MT + tile. The items of experts with one item (their weights
+// come from DRAM for at most 16 rows: few mma) and of experts with several (the weights stay in L2 across their
+// items: mostly mma) are merged evenly, each list in plan order (expert id, then tile), so DRAM and the tensor cores
+// stay busy together instead of in turns. Only which block runs which item changes: every output keeps its bits.
+// The grouping counts routed picks only (< E), so the shared expert has no items; a uid >= E would be left out all
+// the same. order[slot] = an item for slot < items, -1 up to cap (the grid's slots, an upper bound). One block.
+__global__ void __launch_bounds__(1024) prompt_order_kernel(const int* __restrict__ uids,
+                                                            const int* __restrict__ ucount,
+                                                            const int* __restrict__ members, int* __restrict__ order,
+                                                            int maxm, int cap, int E) {
+    __shared__ int hsum[32], lsum[32];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int U = ucount[0], MT = (maxm + 15) / 16;
+    const int per = (U + 1023) / 1024;
+    const int lo = min(U, tid * per), hi = min(U, lo + per);
+    auto items_of = [&](int u) {                           // members come first, -1 after: find the first -1
+        if (uids[u] >= E) return 0;
+        const int* m = members + (size_t)u * maxm;
+        int a = 0, b = maxm;
+        while (a < b) {
+            const int c = (a + b) >> 1;
+            if (m[c] >= 0) a = c + 1; else b = c;
+        }
+        return (a + 15) >> 4;
+    };
+    int h = 0, l = 0;                                      // this thread's heavy and light items
+    for (int u = lo; u < hi; ++u) {
+        const int n = items_of(u);
+        if (n >= 2) h += n; else l += n;
+    }
+    int vh = h, vl = l;                                    // inclusive scans over the block
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+        const int uh = __shfl_up_sync(0xffffffffu, vh, o), ul = __shfl_up_sync(0xffffffffu, vl, o);
+        if (lane >= o) { vh += uh; vl += ul; }
+    }
+    if (lane == 31) { hsum[warp] = vh; lsum[warp] = vl; }
+    __syncthreads();
+    if (warp == 0) {
+        int wh = hsum[lane], wl = lsum[lane];
+#pragma unroll
+        for (int o = 1; o < 32; o <<= 1) {
+            const int uh = __shfl_up_sync(0xffffffffu, wh, o), ul = __shfl_up_sync(0xffffffffu, wl, o);
+            if (lane >= o) { wh += uh; wl += ul; }
+        }
+        hsum[lane] = wh;
+        lsum[lane] = wl;
+    }
+    __syncthreads();
+    const int nh = hsum[31], nl = lsum[31];
+    if (nh + nl > cap) __trap();                           // cap bounds every grouping's items: never
+    int rh = (warp ? hsum[warp - 1] : 0) + vh - h;         // heavy items before this thread's first expert
+    int rl = (warp ? lsum[warp - 1] : 0) + vl - l;         // light items before it
+    for (int u = lo; u < hi; ++u) {
+        const int n = items_of(u);
+        for (int q = 0; q < n; ++q) {
+            if (n >= 2) {                                  // heavy rank r sits at (r + 1/2) / nh; lights before it: strictly
+                const int r = rh++;
+                const long long X = (2LL * r + 1) * nl;
+                const int cl = X > nh ? (int)min((long long)nl, (X - nh + 2LL * nh - 1) / (2LL * nh)) : 0;
+                order[r + cl] = u * MT + q;
+            } else {                                       // light rank l at (l + 1/2) / nl; heavies at or before it
+                const int lr = rl++;
+                const long long Y = (2LL * lr + 1) * nh;
+                const int ch = Y >= nl ? (int)min((long long)nh, (Y - nl) / (2LL * nl) + 1) : 0;
+                order[lr + ch] = u * MT + q;
+            }
+        }
+    }
+    for (int s = nh + nl + tid; s < cap; s += 1024) order[s] = -1;
+}
