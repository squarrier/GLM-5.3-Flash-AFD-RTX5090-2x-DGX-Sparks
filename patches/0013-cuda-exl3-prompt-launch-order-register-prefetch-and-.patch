+        gu, _ = _today(fake)
+        assert gu[OLD_ARGS] is on and gu[OLD_ARGS + 3] is on and gu[OLD_ARGS + 4] is on, R
+        assert (gu[OLD_ARGS + 1] is node.buf.pref.order) is on, R
+        assert fake.calls[-1][0] == "combine"
