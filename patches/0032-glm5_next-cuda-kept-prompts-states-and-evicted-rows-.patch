diff --git a/tests/test_glm_kept_host.py b/tests/test_glm_kept_host.py
new file mode 100644
index 0000000..a2735ca
--- /dev/null
+++ b/tests/test_glm_kept_host.py
@@ -0,0 +1,272 @@
+"""TF_GLM_KEPT_HOST and TF_GLM_HOST_CACHE_GIB (``kept_host``, ours; the design is glm53f-afd's host RAM tier by Hugh
+Madden, glm53f-afd @ 91db3cc, crates/glm53f-coordinator/src/hostcache.rs): kept prompts' states, and the rows of kept
+prompts evicted for room, in host RAM on the AFD attention node, on CPU.
+
+- the switches: names, defaults, refusals before anything loads;
+- the pool formula: with the states in host RAM the GPU reserves one (``STAGING``), not TF_GLM_CACHE_ENTRIES of them;
+- the tier on its own: a kept state's bytes go to a slot and come back unchanged; a full tier leaves a state on the
+  GPU; parked rows come back as ``pool.Arena.copy`` copies them; parked prompts leave least recently used first, never
+  the one being resumed;
+- the AFD node's decoder (tests/test_glm_multi_afd.py's ``World1`` on tests/test_glm_multi.py's fake model, every
+  reply checked against the request served alone): TF_GLM_KEPT_HOST=1 gives the same replies, cached counts, kept
+  prompts and extents as off, with every kept state in a host slot; with TF_GLM_HOST_CACHE_GIB the kept prompts the
+  pool evicted come back from host RAM (cached where off prefills), with the same replies.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+from tests.test_glm_multi import ALIGN, _prompt, fake, solo  # noqa: F401
+from tests.test_glm_multi_afd import GLM, World1, afd_fake  # noqa: F401
+
+pytestmark = pytest.mark.torch
+
+ENV = ("TF_GLM_KEPT_HOST", "TF_GLM_HOST_CACHE_GIB", "TF_GLM_HOST_CACHE_ENTRIES")
+
+
+def _env(monkeypatch, host=None, gib=None, entries=None) -> None:
+    for name, value in zip(ENV, (host, gib, entries)):
+        if value is None:
+            monkeypatch.delenv(name, raising=False)
+        else:
+            monkeypatch.setenv(name, str(value))
+
+
+# -- the switches ------------------------------------------------------------------------------------------------------
+def test_the_switches(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import kept_host as kh
+
+    _env(monkeypatch)
+    assert not kh.enabled() and kh.cache_gib() == 0.0 and kh.host_entries() == kh.HOST_ENTRIES == 32
+    assert kh.check(afd=False, parallel=1) is False and kh.check(afd=True, parallel=8) is False
+    assert kh.enabled("1") and kh.enabled("on") and not kh.enabled("0") and not kh.enabled("off")
+    assert kh.cache_gib("24") == 24.0 and kh.cache_gib("0") == 0.0 and kh.host_entries("64") == 64
+    for bad in ("2", "yes"):
+        with pytest.raises(ValueError, match="TF_GLM_KEPT_HOST"):
+            kh.enabled(bad)
+    for bad in ("-1", "x", "5000"):
+        with pytest.raises(ValueError, match="TF_GLM_HOST_CACHE_GIB"):
+            kh.cache_gib(bad)
+    for bad in ("0", "-3", "a"):
+        with pytest.raises(ValueError, match="TF_GLM_HOST_CACHE_ENTRIES"):
+            kh.host_entries(bad)
+    _env(monkeypatch, host=1)
+    assert kh.check(afd=True, parallel=8) is True
+    with pytest.raises(ValueError, match="AFD attention node"):
+        kh.check(afd=False, parallel=8)
+    with pytest.raises(ValueError, match="--parallel 2"):
+        kh.check(afd=True, parallel=1)
+    _env(monkeypatch, gib=8)
+    with pytest.raises(ValueError, match="needs TF_GLM_KEPT_HOST=1"):
+        kh.check(afd=True, parallel=8)
+
+
+def test_the_pool_formula_reserves_one_state_with_the_tier():
+    """``GlmEngine``'s pool at world 1 is the window plus what TF_GLM_CACHE_GIB leaves after the kept states. A kept
+    state is 0.178 GiB (a KDA state and a DFlash2 window); at the release config's 6.5 GiB and 20 entries they take
+    3.56 GiB of it off, the tier one of them: 534,528 more tokens at 6,780 bytes a token (727,040 -> 1,261,568),
+    in the same GPU bytes."""
+
+    from tensorfold.families.glm5_next.cuda import kept_host as kh
+    from tensorfold.families.glm5_next.cuda.engine import kept_most, slot_bytes
+    from tensorfold.families.glm5_next.cuda.pool import ALIGN as A
+
+    state = slot_bytes(GLM, 1, rows=0) // 2 + (22 << 20) * 2
+    cache, entries, per_token, window = int(6.5 * 2 ** 30), 20, 6780, 262152
+    assert kept_most(entries, cache, state) == 20
+    assert kh.reserved_states(entries, state, False) == entries * state
+    assert kh.reserved_states(entries, state, True) == kh.STAGING * state == state
+
+    def pool(on: bool) -> int:
+        return (window + max(0, cache - kh.reserved_states(entries, state, on)) // per_token) // A * A
+
+    off, on = pool(False), pool(True)
+    assert off % A == 0 and on % A == 0
+    assert 520_000 < on - off < 540_000 and 1.7 < on / off < 1.8
+
+
+# -- the tier on its own -----------------------------------------------------------------------------------------------
+def _tiny(torch, *, entries: int = 2, gib: float = 0.0, parked_most: int = 32, blocks: int = 6):
+    from tensorfold.families.glm5_next.cuda.kept_host import HostTier
+    from tensorfold.families.glm5_next.cuda.pool import Arena, Plane
+
+    rows = blocks * ALIGN
+    slots = SimpleNamespace(rec=torch.zeros((2, 2, 3, 4, 4), dtype=torch.float32),
+                            conv=torch.zeros((2, 3, 2, 8), dtype=torch.bfloat16))
+    arena = Arena(rows, [Plane(torch.zeros((rows, 5), dtype=torch.bfloat16)),
+                         Plane(torch.zeros((rows // 4 + 2, 3), dtype=torch.float32), 4, 2),
+                         Plane(torch.zeros((rows, 2), dtype=torch.int8))])
+    ctx = SimpleNamespace(window=6, kc=[torch.zeros((2, 64, 4), dtype=torch.bfloat16)],
+                          vc=[torch.zeros((2, 64, 4), dtype=torch.bfloat16)])
+    d = SimpleNamespace(e=SimpleNamespace(slots=slots), drafts=SimpleNamespace(contexts=[ctx]), arena=arena, world=1,
+                        g=SimpleNamespace(cache_entries=entries))
+    return d, HostTier(d, entries=entries, gib=gib, parked_most=parked_most)
+
+
+def _snap(torch, kid: int, n: int, *, base: int = 0, window: int = 7):
+    g = torch.Generator().manual_seed(kid)
+    return SimpleNamespace(ids=list(range(n)), kid=kid, extent=SimpleNamespace(base=base),
+                           rec=torch.randn((3, 4, 4), generator=g),
+                           conv=torch.randn((3, 2, 8), generator=g).to(torch.bfloat16),
+                           drafter_rows=[torch.randn((2, window, 4), generator=g).to(torch.bfloat16) for _ in range(2)],
+                           pending=None, tail=None, head=None)
+
+
+def test_a_kept_state_goes_to_a_host_slot_and_comes_back_unchanged(fake):  # noqa: F811
+    torch = fake
+    _, h = _tiny(torch)
+    s = _snap(torch, 0, 100)
+    want = [s.rec.clone(), s.conv.clone()] + [r.clone() for r in s.drafter_rows]
+    assert h.stow(s) and s.host_slot is not None
+    for t in [s.rec, s.conv] + s.drafter_rows:             # views of the slot's slab, the bytes unchanged
+        assert t.untyped_storage().data_ptr() == h.states.slabs[s.host_slot[0]].untyped_storage().data_ptr()
+    for got, ref in zip([s.rec, s.conv] + s.drafter_rows, want):
+        assert got.dtype == ref.dtype and got.shape == ref.shape and torch.equal(got, ref)
+    st = SimpleNamespace(rec=torch.zeros((2, 3, 4, 4)), conv=torch.zeros((3, 2, 8), dtype=torch.bfloat16), cur=[1])
+    h.restore(st, s)
+    assert torch.equal(st.rec[1], want[0]) and torch.equal(st.conv, want[1]) and not st.rec[0].any()
+    assert all(torch.equal(a, b) for a, b in zip(h.window(s), want[2:]))
+    free = len(h.states.free)
+    h.release(s)
+    assert len(h.states.free) == free + 1 and s.host_slot is None
+    assert h.stats["stowed"] == 1 and h.stats["restored"] == 1
+
+
+def test_a_full_tier_leaves_a_state_on_the_gpu(fake):  # noqa: F811
+    torch = fake
+    _, h = _tiny(torch, entries=1, gib=0.0)                # entries + 1 slots
+    snaps = [_snap(torch, k, 50) for k in range(3)]
+    assert [h.stow(s) for s in snaps] == [True, True, False]
+    third = snaps[2]
+    assert getattr(third, "host_slot", None) is None and h.stats["on_gpu"] == 1
+    rec = third.rec.clone()
+    st = SimpleNamespace(rec=torch.zeros((2, 3, 4, 4)), conv=torch.zeros((3, 2, 8), dtype=torch.bfloat16), cur=[0])
+    h.restore(st, third)                                   # restored from where it is
+    assert torch.equal(st.rec[0], rec) and h.stats["restored"] == 0
+    assert h.window(third) is third.drafter_rows
+    big = _snap(torch, 9, 50, window=40)                   # a window past the slot stays on the GPU too
+    h.release(snaps[0])
+    assert not h.stow(big) and h.stats["on_gpu"] == 2
+
+
+def _fill(torch, arena, seed: int) -> None:
+    g = torch.Generator().manual_seed(seed)
+    for p in arena.planes:
+        t = p.tensor
+        if t.dtype == torch.int8:
+            t.copy_(torch.randint(-100, 100, t.shape, generator=g, dtype=torch.int8))
+        else:
+            t.copy_(torch.randn(t.shape, generator=g).to(t.dtype))
+
+
+@pytest.mark.parametrize("n,cut", [(3001, 3001), (3001, 1777), (2048, 2048), (5, 5)])
+def test_parked_rows_come_back_as_arena_copy_copies_them(fake, n, cut):  # noqa: F811
+    from tensorfold.families.glm5_next.cuda.pool import Arena, Plane
+
+    torch = fake
+    d, h = _tiny(torch, gib=0.01)
+    _fill(torch, d.arena, 7)
+    ref = Arena(d.arena.rows, [Plane(p.tensor.clone(), p.div, p.pad) for p in d.arena.planes])
+    ref.copy(2048, 3 * 2048, cut)                          # what the copy path of ADMIT leaves
+    s = _snap(torch, 1, n, base=2048)
+    assert h.stow(s) and h.park(d, s) and h.holds(s) and len(s.pages) == -(-n // ALIGN)
+    _fill(torch, d.arena, 8)                               # the evicted rows are someone else's now
+    keep = [p.tensor.clone() for p in d.arena.planes]
+    h.fetch(d, s, 3 * 2048, cut)
+    for p, r, k in zip(d.arena.planes, ref.planes, keep):
+        a, m = 3 * 2048 // p.div, -(-cut // p.div)
+        assert torch.equal(p.tensor[a:a + m], r.tensor[a:a + m])            # the copied rows, as Arena.copy's
+        assert torch.equal(p.tensor[:a], k[:a]) and torch.equal(p.tensor[a + m:], k[a + m:])   # nothing else
+    assert h.stats["parks"] == 1 and h.stats["unparks"] == 1
+
+
+def test_parked_prompts_leave_least_recently_used_first_never_the_held_one(fake):  # noqa: F811
+    torch = fake
+    d, h = _tiny(torch, entries=4, gib=0.0)
+    from tensorfold.families.glm5_next.cuda.kept_host import HostTier
+
+    page = h.page_bytes
+    h = HostTier(d, entries=4, gib=3 * page / 2 ** 30 + 1e-9, parked_most=8)     # three pages
+    assert h.pages.count == 3
+    a, b, c = (_snap(torch, k, 2048, base=0) for k in range(3))
+    for s in (a, b, c):
+        assert h.stow(s) and h.park(d, s)
+    assert h.parked == [a, b, c] and not h.pages.free
+    h.touch(a)                                             # a resumed: b is the oldest now
+    h.hold = b                                             # ... but b is being resumed
+    e = _snap(torch, 4, 2048)
+    assert h.stow(e) and h.park(d, e)
+    assert h.parked == [b, a, e] and c.pages is None and getattr(c, "host_slot", None) is None
+    f = _snap(torch, 5, 3 * 2048)                          # needs every page: only the held one may stay
+    assert h.stow(f) and not h.park(d, f) and h.parked == [b] and h.stats["missed"] == 1
+    h2 = HostTier(d, entries=4, gib=8 * page / 2 ** 30 + 1e-9, parked_most=2)    # the count bound
+    x, y, z = (_snap(torch, k, 10) for k in range(3))
+    for s in (x, y, z):
+        assert h2.stow(s) and h2.park(d, s)
+    assert h2.parked == [y, z] and h2.stats["dropped"] == 1
+
+
+# -- the AFD node's decoder --------------------------------------------------------------------------------------------
+def _scenario(env, monkeypatch, **switches):
+    """Six finished requests of 1,000 tokens in a four-block pool (each kept prompt holds a block, so the pool evicts
+    the oldest two), then the three oldest come back with 300 more tokens."""
+
+    _env(monkeypatch, **switches)
+    w = World1(env, streams=2, blocks=4)
+    torch = env.torch
+    out = []
+    prompts = [_prompt(1000, 70 + k) for k in range(6)]
+    for pr in prompts + [p + _prompt(300, 99) for p in prompts[:3]]:
+        s = w.submit(pr, 4)
+        w.run()
+        assert s.got == solo(torch, pr, 4, None)
+        out.append((list(s.got), s.cached))
+    return w, out, [c.ids for c in w.d.kept], [(x.base, x.size) for x in w.d.pool.extents]
+
+
+def test_the_tier_off_and_on_give_the_same_replies_kept_prompts_and_pool(afd_fake):  # noqa: F811
+    env = afd_fake
+    mp = env.monkeypatch
+    w0, out0, kept0, ext0 = _scenario(env, mp)
+    assert getattr(w0.d, "host", "missing") is None and "kept_host" not in w0.d.health()
+    w1, out1, kept1, ext1 = _scenario(env, mp, host=1)
+    assert (out1, kept1, ext1) == (out0, kept0, ext0)
+    assert [c for _, c in out0][6:] == [0, 0, 0]          # the two oldest were evicted, and the third since
+    h = w1.d.host
+    assert h is not None and h.pages is None and h.stats["stowed"] >= 9 and h.stats["on_gpu"] == 0
+    assert all(getattr(c, "host_slot", None) is not None for c in w1.d.kept)
+    assert len(h.states.free) == h.states.count - len(w1.d.kept)        # dropped prompts gave their slots back
+    health = w1.d.health()["kept_host"]
+    assert health["state_slots"] == h.states.count and health["stowed"] == h.stats["stowed"]
+
+
+def test_evicted_prompts_park_in_host_ram_and_resume_from_there(afd_fake):  # noqa: F811
+    env = afd_fake
+    mp = env.monkeypatch
+    _, out0, _, _ = _scenario(env, mp)
+    w, out, _, _ = _scenario(env, mp, host=1, gib=0.01)
+    assert [g for g, _ in out] == [g for g, _ in out0]                  # the same replies
+    assert [c for _, c in out][:6] == [c for _, c in out0][:6]
+    assert [c for _, c in out][6:] == [999, 999, 999]                    # resumed from host RAM, not prefilled
+    h = w.d.host
+    assert h.stats["parks"] >= 3 and h.stats["unparks"] == 3 and h.stats["restored"] >= 3
+    health = w.d.health()["kept_host"]
+    assert health["parked"] == len(h.parked) and health["pages"] == h.pages.count
+    assert all(p.pages for p in h.parked) and h.hold is None
+
