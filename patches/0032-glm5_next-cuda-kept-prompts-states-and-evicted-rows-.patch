diff --git a/src/tensorfold/families/glm5_next/cuda/kept_host.py b/src/tensorfold/families/glm5_next/cuda/kept_host.py
new file mode 100644
index 0000000..af695b7
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/kept_host.py
@@ -0,0 +1,382 @@
+"""TF_GLM_KEPT_HOST and TF_GLM_HOST_CACHE_GIB (default off, ours): a host-RAM tier for the --parallel pool's kept
+prompts on the AFD attention node (world 1: one discrete GPU on a host with RAM to spare).
+
+The design is glm53f-afd's host RAM tier, by Hugh Madden (@dangerm00se, github.com/hughmadden), glm53f-afd @ 91db3cc
+(https://github.com/hughmadden/glm53f-afd): crates/glm53f-coordinator/src/hostcache.rs (page-locked slabs carved into
+fixed-size slots; a snapshot's KV rows plus its positional state, the KDA recurrent states and convolution windows; RAM
+eviction least recently used first), crates/glm53f-coordinator/src/scheduler.rs (a snapshot the GPU evicts for room is
+stored to RAM first, and a prompt that misses the GPU restores from RAM instead of prefilling) and docs/RUNNING.md ("KV
+snapshots and the RAM tier"); glm53f-afd took it from mimo26f-afd's DS41RT host snapshot cache (its on-evict mode).
+No code is copied: TensorFold's pool keeps a kept prompt's rows in its stream's extent (``pool.py``, ``multi.py``),
+and this is written on that pool.
+
+- **TF_GLM_KEPT_HOST=1**: a kept prompt's KDA states, convolution windows and DFlash2 window (0.178 GiB for
+  GLM-5.3-Flash at world 1: 34 KDA layers x 64 heads of 128 x 128 FP32 states are 136 MiB of it) go to a slot of
+  pinned host slabs when the prompt is kept (``MultiDecoder._keep``), and back into the stream's slot when a request
+  resumes it (``MultiDecoder._admitted``). The GPU holds none of them, so ``GlmEngine`` gives TF_GLM_CACHE_GIB to
+  pool rows instead of reserving TF_GLM_CACHE_ENTRIES states (``STAGING`` stays for a keep's device copies before
+  they reach the host), and the count of kept prompts is TF_GLM_CACHE_ENTRIES, no longer bounded by GPU bytes. At
+  the release config (6.5 GiB, 20 kept prompts) that is 1,261,568 pool tokens instead of 727,040 in the same GPU memory. glm53f-afd keeps a
+  snapshot's state on the GPU until pressure moves it; here it moves when taken, which gives the pool its size from
+  startup on, for one 0.18 GiB copy each way (about 7 ms each at the 5090's PCIe Gen5 x8).
+- **TF_GLM_HOST_CACHE_GIB=G** (with TF_GLM_KEPT_HOST=1): a kept prompt that rank 0 evicts for room (``_evict``: a
+  new extent, a growing one, a requeue or a stream's home rows need its rows) first parks its rows in pages of
+  ``PAGE`` tokens carved from G GiB of pinned slabs (a page holds those tokens' rows of every pool plane, the rows
+  ``pool.Arena.copy`` copies), with its states in their slot. A request whose prompt it prefixes (``_resume``; at
+  equal length a kept prompt on the GPU wins) gets a new extent, the parked rows copied into it (ADMIT's copy) and the
+  states as from a kept prompt; the parked prompt stays parked. Parked prompts leave least recently used first when
+  the pages run out or past TF_GLM_HOST_CACHE_ENTRIES (default ``HOST_ENTRIES``); the one being resumed never.
+
+Every copy is exact (bytes, no arithmetic) and runs on the current CUDA stream, as the device copies it replaces did
+(``take_snapshot``'s clones, ``Arena.copy``), so it is ordered with the forwards that wrote or read those rows; the
+host never waits on it. A slot or page records an event after each copy and the next copy that touches it waits on
+that event, so a slot is never rewritten while another stream still reads it, and a device source a keep frees is
+recorded on the stream (``record_stream``). Replies, prompt chunks, kept points and kernel calls do not change, only
+how many kept prompts survive and where their bytes live (a resume from host RAM is the resume from the kept prompt it
+was, byte for byte). Off (both unset) nothing here runs and ``GlmEngine``'s pool is the one before.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+from .pool import ALIGN
+
+SLAB = 1 << 30            # bytes a pinned slab holds; whole slots are carved from each (hostcache.rs's SLAB_BYTES)
+PAGE = ALIGN              # tokens a page of parked rows holds: an extent's alignment, so a page splits no pool row
+STAGING = 1               # kept states the GPU holds for a moment under TF_GLM_KEPT_HOST (a keep's copies)
+HOST_ENTRIES = 32         # TF_GLM_HOST_CACHE_ENTRIES unset: parked prompts at most
+_ALIGN_BYTES = 256        # every tensor a slot holds starts on this
+
+
+def _up(n: int, align: int = _ALIGN_BYTES) -> int:
+    return -(-int(n) // align) * align
+
+
+def _bytes(t: torch.Tensor) -> int:
+    return t.numel() * t.element_size()
+
+
+def _typed(raw: torch.Tensor, dtype, shape) -> torch.Tensor:
+    return raw.view(dtype).view(shape)
+
+
+def enabled(value: str | None = None) -> bool:
+    """TF_GLM_KEPT_HOST: 0 (off, the default) or 1 (on)."""
+
+    value = (os.environ.get("TF_GLM_KEPT_HOST", "") if value is None else value).strip().lower()
+    if value in ("", "0", "off"):
+        return False
+    if value in ("1", "on"):
+        return True
+    raise ValueError(f"TF_GLM_KEPT_HOST: 0 (off) or 1 (on), not {value!r}")
+
+
+def cache_gib(value: str | None = None) -> float:
+    """TF_GLM_HOST_CACHE_GIB: GiB of pinned host RAM for parked prompts' rows; 0 or unset: none (no parking)."""
+
+    raw = (os.environ.get("TF_GLM_HOST_CACHE_GIB", "") if value is None else value).strip()
+    if raw == "":
+        return 0.0
+    try:
+        gib = float(raw)
+    except ValueError:
+        gib = -1.0
+    if not 0 <= gib <= 4096:
+        raise ValueError(f"TF_GLM_HOST_CACHE_GIB: GiB of host RAM from 0 (off) to 4096, not {raw!r}")
+    return gib
+
+
+def host_entries(value: str | None = None) -> int:
+    """TF_GLM_HOST_CACHE_ENTRIES: parked prompts at most (default ``HOST_ENTRIES``), 1 or more."""
+
+    raw = (os.environ.get("TF_GLM_HOST_CACHE_ENTRIES", "") if value is None else value).strip()
+    if raw == "":
+        return HOST_ENTRIES
+    if not raw.isdecimal() or int(raw) < 1:
+        raise ValueError(f"TF_GLM_HOST_CACHE_ENTRIES: a count of 1 or more, not {raw!r}")
+    return int(raw)
+
+
+def check(afd: bool, parallel: int) -> bool:
+    """The settings, read before anything loads: whether the tier is on. It needs the AFD attention node and
+    --parallel's pool; TF_GLM_HOST_CACHE_GIB needs TF_GLM_KEPT_HOST=1."""
+
+    on = enabled()
+    gib = cache_gib()
+    host_entries()
+    if gib > 0 and not on:
+        raise ValueError("TF_GLM_HOST_CACHE_GIB parks evicted prompts with their states in host RAM: it needs "
+                         "TF_GLM_KEPT_HOST=1")
+    if on and not afd:
+        raise ValueError("TF_GLM_KEPT_HOST=1 is for the AFD attention node (--experts remote); a GB10's host memory "
+                         "is its GPU's")
+    if on and parallel < 2:
+        raise ValueError("TF_GLM_KEPT_HOST=1 keeps --parallel's kept prompts in host RAM: run with --parallel 2 or more")
+    return on
+
+
+def reserved_states(entries: int, state: int, on: bool) -> int:
+    """Bytes of kept states the pool formula leaves the GPU (``GlmEngine``): ``entries`` of them, or with
+    TF_GLM_KEPT_HOST only ``STAGING``."""
+
+    return (STAGING if on else int(entries)) * int(state)
+
+
+class Slots:
+    """Fixed-size byte slots carved from host slabs of at most ``SLAB`` bytes (pinned with CUDA; plain memory without
+    it, as in the CPU tests), and the event of each slot's last copy."""
+
+    def __init__(self, size: int, count: int, pinned: bool) -> None:
+        self.size, self.count, self.pinned = _up(size), int(count), bool(pinned)
+        per = max(1, SLAB // self.size)
+        self.slabs: list[torch.Tensor] = []
+        free = []
+        left = self.count
+        while left > 0:
+            n = min(left, per)
+            self.slabs.append(torch.empty((n * self.size,), dtype=torch.uint8, pin_memory=self.pinned))
+            free += [(len(self.slabs) - 1, j) for j in range(n)]
+            left -= n
+        self.free = free[::-1]                       # ``take`` pops the lowest slot first
+        self.events: dict = {}
+
+    def take(self):
+        return self.free.pop() if self.free else None
+
+    def give(self, slot) -> None:
+        self.free.append(slot)
+
+    def view(self, slot, offset: int, nbytes: int) -> torch.Tensor:
+        k, j = slot
+        base = j * self.size + offset
+        return self.slabs[k][base:base + nbytes]
+
+    def wait(self, slot) -> None:
+        """The current stream waits for the slot's last copy (one another stream may have queued)."""
+        ev = self.events.get(slot)
+        if ev is not None:
+            torch.cuda.current_stream().wait_event(ev)
+
+    def mark(self, slot) -> None:
+        if self.pinned:
+            ev = torch.cuda.Event()
+            ev.record()
+            self.events[slot] = ev
+
+    def nbytes(self) -> int:
+        return sum(t.numel() for t in self.slabs)
+
+
+class HostTier:
+    """The tier of one ``multi.MultiDecoder`` (the AFD attention node's; ``tier`` builds it)."""
+
+    def __init__(self, d, *, entries: int, gib: float = 0.0, parked_most: int = HOST_ENTRIES) -> None:
+        e = d.e
+        self.pinned = torch.cuda.is_available() and e.slots.rec.is_cuda
+        self.device = e.slots.rec.device
+        # a kept state at its largest (``decode.take_snapshot``, ``multi.draft_window``): one parity of a slot's KDA
+        # states, its convolution windows, and per DFlash2 context tensor its window (up to window + 1 rows)
+        shapes = [(tuple(e.slots.rec.shape[2:]), e.slots.rec.dtype), (tuple(e.slots.conv.shape[1:]),
+                                                                      e.slots.conv.dtype)]
+        contexts = getattr(getattr(d, "drafts", None), "contexts", None) or []
+        if contexts:
+            ctx = contexts[0]
+            rows = int(ctx.window) + 1
+            shapes += [((int(c.shape[0]), rows, *c.shape[2:]), c.dtype) for c in list(ctx.kc) + list(ctx.vc)]
+        self.state_bytes = sum(_up(torch.Size(s).numel() * torch.empty((), dtype=t).element_size()) for s, t in shapes)
+        self.entries = int(entries)
+        self.parked_most = int(parked_most) if gib > 0 else 0
+        # kept prompts at most, one more while ``_keep`` drops past the count, and the parked ones
+        self.states = Slots(self.state_bytes, self.entries + 1 + self.parked_most, self.pinned)
+        # TF_GLM_HOST_CACHE_GIB: pages of PAGE tokens, each those tokens' rows of every pool plane
+        self.planes = [(PAGE // p.div, tuple(p.tensor.shape[1:]), p.tensor.dtype,
+                        p.tensor[0].numel() * p.tensor.element_size()) for p in d.arena.planes]
+        self.page_bytes = sum(_up(rows * row) for rows, _, _, row in self.planes)
+        pages = int(gib * (1 << 30)) // self.page_bytes if gib > 0 else 0
+        if gib > 0 and pages < 1:
+            raise ValueError(f"TF_GLM_HOST_CACHE_GIB={gib:g}: less than one {PAGE}-token page "
+                             f"({self.page_bytes / 2 ** 20:.1f} MiB)")
+        self.pages = Slots(self.page_bytes, pages, self.pinned) if pages else None
+        self.parked: list = []                   # parked prompts (decode.Snapshot), least recently used first
+        self.hold = None                         # the parked prompt an admission resumes (never dropped meanwhile)
+        self.stats = {"stowed": 0, "restored": 0, "on_gpu": 0, "parks": 0, "unparks": 0, "dropped": 0, "missed": 0}
+
+    # -- kept states (TF_GLM_KEPT_HOST) -------------------------------------------------------------------------------
+    def stow(self, snap) -> bool:
+        """A new kept prompt's KDA states, convolution windows and DFlash2 window into a host slot; the snapshot then
+        holds the slot's views (its ring tail, MTP row and logits row stay on the GPU: a few hundred KB). False (no
+        free slot, or a window past the slot) leaves them on the GPU, as without the tier."""
+
+        tensors = [snap.rec, snap.conv] + list(snap.drafter_rows or [])
+        sizes = [_up(_bytes(t)) for t in tensors]
+        slot = self.states.take() if sum(sizes) <= self.states.size else None
+        if slot is None:
+            self.stats["on_gpu"] += 1
+            return False
+        self.states.wait(slot)
+        out, off = [], 0
+        for t, nb in zip(tensors, sizes):
+            h = _typed(self.states.view(slot, off, _bytes(t)), t.dtype, t.shape)
+            h.copy_(t, non_blocking=self.pinned)
+            if t.is_cuda:
+                t.record_stream(torch.cuda.current_stream())
+            out.append(h)
+            off += nb
+        self.states.mark(slot)
+        snap.rec, snap.conv = out[0], out[1]
+        if snap.drafter_rows is not None:
+            snap.drafter_rows = out[2:]
+        snap.host_slot = slot
+        self.stats["stowed"] += 1
+        return True
+
+    def restore(self, st, snap) -> None:
+        """A kept prompt's KDA states and convolution windows into ``st``'s slot (``_admitted``)."""
+
+        slot = getattr(snap, "host_slot", None)
+        if slot is None:                         # kept on the GPU (``stow`` returned False)
+            st.rec[st.cur[0]].copy_(snap.rec)
+            st.conv.copy_(snap.conv)
+            return
+        self.states.wait(slot)
+        st.rec[st.cur[0]].copy_(snap.rec, non_blocking=self.pinned)
+        st.conv.copy_(snap.conv, non_blocking=self.pinned)
+        self.states.mark(slot)
+        self.stats["restored"] += 1
+
+    def window(self, snap) -> list:
+        """A kept DFlash2 window where ``multi.put_draft_window`` reads it: on the device (index_copy_ takes a source
+        on its own device), copied from host RAM on the current stream."""
+
+        slot = getattr(snap, "host_slot", None)
+        if slot is None or not self.pinned:
+            return snap.drafter_rows
+        self.states.wait(slot)
+        rows = [r.to(self.device, non_blocking=True) for r in snap.drafter_rows]
+        self.states.mark(slot)
+        return rows
+
+    def release(self, snap) -> None:
+        slot = getattr(snap, "host_slot", None)
+        if slot is not None:
+            self.states.give(slot)
+            snap.host_slot = None
+
+    # -- parked prompts (TF_GLM_HOST_CACHE_GIB) -----------------------------------------------------------------------
+    def holds(self, c) -> bool:
+        return any(p is c for p in self.parked)
+
+    def find(self, kid: int):
+        return next((c for c in self.parked if c.kid == kid), None)
+
+    def touch(self, c) -> None:
+        self.parked = [p for p in self.parked if p is not c] + [c]
+
+    def _rows(self, arena, base: int, n: int, pages: list, *, out: bool) -> None:
+        """Tokens [0, n) of an extent at ``base``: to the pages (out) or from them, page by page and plane by plane,
+        the rows ``pool.Arena.copy`` copies for them (the last row of a plane whose rows hold several tokens too)."""
+
+        for k, page in enumerate(pages):
+            t0 = k * PAGE
+            cnt = min(PAGE, n - t0)
+            if cnt <= 0:
+                break
+            self.pages.wait(page)
+            off = 0
+            for p, (rows, shape, dtype, row) in zip(arena.planes, self.planes):
+                a = (base + t0) // p.div
+                m = min(-(-cnt // p.div), rows, p.tensor.shape[0] - a)
+                dev = p.tensor[a:a + m]
+                host = _typed(self.pages.view(page, off, rows * row), dtype, (rows, *shape))[:m]
+                if out:
+                    host.copy_(dev, non_blocking=self.pinned)
+                else:
+                    dev.copy_(host, non_blocking=self.pinned)
+                off += _up(rows * row)
+            self.pages.mark(page)
+
+    def _forget(self, c) -> None:
+        self.parked = [p for p in self.parked if p is not c]
+        for page in getattr(c, "pages", None) or []:
+            self.pages.give(page)
+        c.pages = None
+        self.release(c)
+        c.rec = c.conv = c.pending = None
+        c.tail = c.head = None
+        c.drafter_rows = None
+        self.stats["dropped"] += 1
+
+    def _drop_one(self) -> bool:
+        victim = next((c for c in self.parked if c is not self.hold), None)
+        if victim is None:
+            return False
+        self._forget(victim)
+        return True
+
+    def park(self, d, c) -> bool:
+        """Rank 0: kept prompt ``c``, evicted for room, parks its rows in host pages (its states stay in their slot):
+        True, and the caller unlists it without freeing them; False (no pages, its states on the GPU, or more rows
+        than the pages hold) leaves the eviction as it was."""
+
+        if self.pages is None or getattr(c, "host_slot", None) is None:
+            return False
+        n = len(c.ids)
+        need = -(-n // PAGE)
+        if need > self.pages.count:
+            self.stats["missed"] += 1
+            return False
+        while (len(self.pages.free) < need or len(self.parked) >= self.parked_most) and self._drop_one():
+            pass
+        if len(self.pages.free) < need or len(self.parked) >= self.parked_most:
+            self.stats["missed"] += 1
+            return False
+        pages = [self.pages.take() for _ in range(need)]
+        self._rows(d.arena, c.extent.base, n, pages, out=True)
+        c.pages = pages
+        self.parked.append(c)
+        self.stats["parks"] += 1
+        return True
+
+    def fetch(self, d, c, base: int, n: int) -> None:
+        """A parked prompt's first n tokens' rows into the pool at ``base`` (a new extent's): ADMIT's copy."""
+
+        if n > len(c.ids):
+            raise RuntimeError(f"a parked prompt of {len(c.ids)} tokens cannot give {n}")
+        self._rows(d.arena, base, n, c.pages[:-(-n // PAGE)], out=False)
+        self.touch(c)
+        self.stats["unparks"] += 1
+
+    # -- reports --------------------------------------------------------------------------------------------------------
+    def health(self) -> dict:
+        out = {"state_slots": self.states.count, "state_slots_free": len(self.states.free),
+               "state_mib": round(self.states.size / 2 ** 20, 1),
+               "pinned_gib": round((self.states.nbytes() + (self.pages.nbytes() if self.pages else 0)) / 2 ** 30, 2),
+               **self.stats}
+        if self.pages is not None:
+            out.update(parked=len(self.parked), pages=self.pages.count, pages_free=len(self.pages.free),
+                       page_tokens=PAGE, parked_tokens=sum(len(c.ids) for c in self.parked))
+        return out
+
+    def describe(self) -> str:
+        line = (f"TF_GLM_KEPT_HOST=1: kept prompts' KDA states and DFlash2 windows in pinned host RAM, "
+                f"{self.entries} at most ({self.states.size / 2 ** 20:.1f} MiB each), the pool given what they took "
+                f"(glm53f-afd's host tier, by Hugh Madden)")
+        if self.pages is not None:
+            line += (f"; TF_GLM_HOST_CACHE_GIB: a kept prompt evicted for room parks its rows in host RAM "
+                     f"({self.pages.count} pages of {PAGE} tokens, {self.pages.count * PAGE} tokens, "
+                     f"{self.pages.nbytes() / 2 ** 30:.1f} GiB pinned), {self.parked_most} parked at most "
+                     f"(TF_GLM_HOST_CACHE_ENTRIES), least recently used out first; a request they prefix copies "
+                     f"them back")
+        return line
+
+
+def tier(d) -> HostTier | None:
+    """``MultiDecoder``'s tier: None unless TF_GLM_KEPT_HOST=1 on the AFD attention node (world 1; two ranks run
+    without it, as TF_GLM_PREFILL_PAIRS does, and ``check`` refuses the setting there before the load)."""
+
+    if not enabled() or getattr(d, "world", 2) != 1:
+        return None
+    return HostTier(d, entries=max(1, int(d.g.cache_entries)), gib=cache_gib(), parked_most=host_entries())
