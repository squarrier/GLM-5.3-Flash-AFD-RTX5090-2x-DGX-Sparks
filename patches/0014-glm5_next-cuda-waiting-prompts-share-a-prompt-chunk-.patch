--- /dev/null
+++ b/tests/test_glm_multi_prefill.py
@@ -0,0 +1,677 @@
+"""TF_GLM_MULTI_PREFILL (MiaAI-Lab recipe patch 0049, ``multi_prefill``) on CPU: waiting prompts share a prompt chunk,
+and every reply, kept state and pool row is the one the streams get filled one at a time.
+
+- the settings, ``layout``'s refusals (a shared slot, overlapping extents, more rows than the prompt buffers or the
+  experts' ``prefill_rows``), the staging of the pieces' ids, and the refusal before the AFD wire opens;
+- #243's fake model (tests/test_glm_multi.py: logits that hash what each stream committed, read back from its pool
+  rows and its slot), with the real ``multi_prefill.prefill_pieces`` over a fake forward that runs each piece on its
+  own state: grouped == ungrouped (replies against the requests served alone, kept states and their pool rows, both
+  ranks alike) at two ranks, at world 1 over the fake AFD wire, with fp8 rings and with the shared-prefix points;
+  a burst of four short prompts makes two prompt forwards where it made eight (one where it made four undrafted);
+  rank 1 refuses a piece that passes a kept point; MTP streams fill alone; /health; the idle server's wait;
+- the forward seam itself: the real ``forward.compute`` with ``multi_prefill.PieceMixer`` over recorded kernels. Each
+  piece's stream-state calls (``forward.kda_rows``, ``forward.dsa_rows``) are exactly its solo chunk's, its rows a
+  view of the chunk's buffers; every other call is the one a solo chunk of all the rows makes; the AFD wire sees one
+  ``begin(R, chunk=True)`` and one exchange per MoE layer.
+"""
+
+from __future__ import annotations
+
+import importlib
+import queue
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from tests import test_glm_kv8_multi as tk
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests import test_glm_shared_prefix as tsp
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+pytestmark = pytest.mark.torch
+
+fake = tm.fake
+afd_fake = ta.afd_fake
+rings = tk.rings
+
+BURST = [(9, 11, "topk"), (12, 12, "greedy"), (15, 13, "minp"), (17, 14, "nucleus")]     # (prompt, seed, sampling)
+
+
+# -- settings ------------------------------------------------------------------------------------------------------
+def test_the_settings(allocations, monkeypatch):  # noqa: F811
+    from tensorfold.families.glm5_next.cuda import multi_prefill as mp
+    from tensorfold.families.glm5_next.cuda.engine import afd_parallel_check
+    from tensorfold.families.glm5_next.cuda.multi import fill_unit
+
+    monkeypatch.delenv("TF_GLM_MULTI_PREFILL", raising=False)
+    monkeypatch.delenv("TF_GLM_MULTI_PREFILL_WAIT_MS", raising=False)
+    assert mp.enabled() is False and mp.enabled("") is False and mp.enabled("1") is True and mp.enabled(" 0 ") is False
+    for bad in ("2", "yes", "on", "-1"):
+        with pytest.raises(ValueError, match="TF_GLM_MULTI_PREFILL"):
+            mp.enabled(bad)
+    assert mp.wait_ms() == 0.0 and mp.wait_ms("25") == 25.0 and mp.wait_ms("1000") == 1000.0
+    for bad in ("-1", "1001", "x"):
+        with pytest.raises(ValueError, match="TF_GLM_MULTI_PREFILL_WAIT_MS"):
+            mp.wait_ms(bad)
+    assert fill_unit(0) == 64 and fill_unit(64) == 64 and fill_unit(48) == 192
+    afd_parallel_check({"TF_GLM_MULTI_PREFILL": "1", "TF_GLM_MULTI_PREFILL_WAIT_MS": "20"})     # allowed
+    with pytest.raises(ValueError, match="TF_GLM_MULTI_PREFILL"):                              # before the wire
+        afd_parallel_check({"TF_GLM_MULTI_PREFILL": "true"})
+    with pytest.raises(ValueError, match="TF_GLM_MULTI_PREFILL_WAIT_MS"):
+        afd_parallel_check({"TF_GLM_MULTI_PREFILL": "1", "TF_GLM_MULTI_PREFILL_WAIT_MS": "5000"})
+
+
+def _st(slot, base, capacity, pos=0):
+    return SimpleNamespace(slot=slot, base=base, capacity=capacity, pos=pos, index=None)
+
+
+def test_layout_and_its_refusals(allocations):  # noqa: F811
+    from tensorfold.families.glm5_next.cuda.multi_prefill import Piece, layout
+
+    a, b, c = Piece(_st(0, 0, 2048), [1] * 10), Piece(_st(2, 4096, 2048), [2] * 5, head=True), Piece(
+        _st(1, 2048, 2048), [3] * 7)
+    assert layout([a, b, c], 22) == 22 and [p.lo for p in (a, b, c)] == [0, 10, 15]
+    with pytest.raises(ValueError, match="prompt buffers hold 21"):                          # too many rows
+        layout([a, b, c], 21)
+    with pytest.raises(ValueError, match="share a stream slot"):
+        layout([a, Piece(_st(0, 6144, 2048), [4])], 64)
+    with pytest.raises(ValueError, match="overlapping extents"):
+        layout([a, Piece(_st(3, 1024, 2048), [4])], 64)
+    with pytest.raises(ValueError, match="without rows"):
+        layout([a, Piece(_st(3, 8192, 2048), [])], 64)
+    with pytest.raises(ValueError, match="needs a piece"):
+        layout([], 64)
+
+
+def test_staging_and_the_experts_prefill_rows(allocations, monkeypatch):  # noqa: F811
+    """The real ``_stage``: every piece's room checked, the ids back to back through the pinned copy; and
+    ``prefill_pieces`` lays out at most ``e.prefill_rows`` rows (the AFD settings handshake's), even when the prompt
+    buffers hold more, before anything reaches the wire."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import multi_prefill as mp
+
+    events = []
+    b = SimpleNamespace(rows=64, ids=torch.zeros((64,), dtype=torch.int32),
+                        ids_host=torch.zeros((64,), dtype=torch.int32),
+                        staged=SimpleNamespace(synchronize=lambda: events.append("sync"),
+                                               record=lambda: events.append("record")))
+    w = SimpleNamespace(cfg=SimpleNamespace(dense_limit=10**9))
+    pieces = [mp.Piece(_st(0, 0, 100, pos=40), [5, 6, 7]), mp.Piece(_st(1, 2048, 100, pos=3), [8, 9])]
+    R = mp.layout(pieces, 64)
+    mp._stage(w, b, pieces, R)
+    assert b.ids[:R].tolist() == [5, 6, 7, 8, 9] and events == ["sync", "record"]
+    with pytest.raises(ValueError, match="cache capacity"):
+        mp._stage(w, b, [mp.Piece(_st(0, 0, 100, pos=98), [1, 2, 3])], 3)
+    wire = SimpleNamespace(begin=lambda *a, **k: pytest.fail("the wire saw a chunk past prefill_rows"))
+    e = SimpleNamespace(w=SimpleNamespace(afd=wire, cfg=w.cfg), pbuf=b, prefill_rows=4)
+    with pytest.raises(ValueError, match="prompt buffers hold 4"):
+        mp.prefill_pieces(e, [mp.Piece(_st(0, 0, 100), [1, 2, 3]), mp.Piece(_st(1, 2048, 100), [4, 5])])
+
+
+# -- grouped == ungrouped on #243's fake model --------------------------------------------------------------------------
+def _mode(monkeypatch, on: bool, wait: str | None = None) -> None:
+    if on:
+        monkeypatch.setenv("TF_GLM_MULTI_PREFILL", "1")
+    else:
+        monkeypatch.delenv("TF_GLM_MULTI_PREFILL", raising=False)
+    if wait is None:
+        monkeypatch.delenv("TF_GLM_MULTI_PREFILL_WAIT_MS", raising=False)
+    else:
+        monkeypatch.setenv("TF_GLM_MULTI_PREFILL_WAIT_MS", wait)
+
+
+def kept_view(d) -> list:
+    """Every kept prompt by content (kids and extents may differ between the two modes): its ids, KDA state, conv
+    window, DFlash2 window and its rows in each pool plane."""
+
+    out = []
+    for c in d.kept:
+        x, n = c.extent, len(c.ids)
+        planes = [d.arena.view(0, x.base, x.size)[:n], d.arena.view(1, x.base, x.size)[:n // 4]]
+        if len(d.arena.planes) > 2:
+            planes.append(d.arena.view(2, x.base, x.size)[:n])
+        out.append((tuple(c.ids), c.rec.tolist(), c.conv.tolist(), bool(getattr(c, "shared", False)),
+                    [r.tolist() for r in (c.drafter_rows or [])], [p.tolist() for p in planes]))
+    return sorted(out, key=repr)
+
+
+def _fills(sent) -> tuple[int, int]:
+    from tensorfold.families.glm5_next.cuda.multi import FILL, MFILL
+
+    ops = [op for m in sent for op, _ in tm._ops(m)]
+    return ops.count(FILL), ops.count(MFILL)
+
+
+def burst_pair(torch, monkeypatch, on: bool, *, draft: bool = True, policy: str = "f3"):
+    """Four short prompts admitted together at two ranks; every message rank 0 sent is kept for counting."""
+
+    _mode(monkeypatch, on)
+    p = tm.Pair(torch, streams=4)
+    log = []
+    share = p.g[0]._share
+    p.g[0]._share = lambda values: (log.append(list(values)), share(values))[1]
+    reqs = [(tm._prompt(n, seed), 24, tm._sampling(kind, seed)) for n, seed, kind in BURST]
+    streams = [p.submit(pr, cnt, sp, policy=policy, draft=draft) for pr, cnt, sp in reqs]
+    p.run()
+    for s, (pr, cnt, sp) in zip(streams, reqs):
+        assert s.got == tm.solo(torch, pr, cnt, sp)
+    return p, log, streams
+
+
+@pytest.mark.parametrize("draft", [True, False], ids=["drafted", "undrafted"])
+def test_two_ranks_burst_grouped_equals_ungrouped(fake, monkeypatch, draft):
+    """Each drafted prompt keeps its state before its last token, so it fills in two pieces: 8 FILLs ungrouped, 2
+    MFILLs grouped (4 -> 1 undrafted). Replies equal their solo ones, both ranks agree after every message (Pair.check),
+    and the kept states with their pool rows are the same either way."""
+
+    torch = fake
+    p0, log0, s0 = burst_pair(torch, monkeypatch, False, draft=draft)
+    p1, log1, s1 = burst_pair(torch, monkeypatch, True, draft=draft)
+    assert [s.got for s in s0] == [s.got for s in s1]
+    assert kept_view(p0.d[0]) == kept_view(p1.d[0]) == kept_view(p1.d[1])
+    assert len(p0.d[0].kept) == (4 if draft else 0)
+    rows = sum(n for n, _, _ in BURST)
+    assert _fills(log0) == ((8 if draft else 4), 0)
+    assert _fills(log1) == (0, 2 if draft else 1)
+    assert p1.d[0].grouped == {"chunks": 2 if draft else 1, "pieces": 8 if draft else 4, "rows": rows}
+    assert "multi_prefill" in p1.d[0].health() and "multi_prefill" not in p0.d[0].health()
+    assert p1.g[0].e.chunks == p1.g[1].e.chunks and len(p1.g[0].e.chunks) == (2 if draft else 1)
+    first = p1.g[0].e.chunks[0]                                   # (slot, pos, rows): the four prompts, shortest first
+    assert [r for _, _, r in first] == ([n - 1 for n, _, _ in BURST] if draft else [n for n, _, _ in BURST])
+
+
+def test_mtp_streams_fill_alone(fake, monkeypatch):
+    """With the MTP head (no draft model), drafting streams' prompt rows go through the head too: they never join a
+    multi-prompt chunk, and the replies are their solo ones."""
+
+    torch = fake
+    _mode(monkeypatch, True)
+    p = tm.Pair(torch, streams=4, drafter=False, mtp=True)
+    reqs = [(tm._prompt(n, seed), 20, tm._sampling(kind, seed)) for n, seed, kind in BURST]
+    streams = [p.submit(pr, cnt, sp, policy="2") for pr, cnt, sp in reqs]
+    p.run()
