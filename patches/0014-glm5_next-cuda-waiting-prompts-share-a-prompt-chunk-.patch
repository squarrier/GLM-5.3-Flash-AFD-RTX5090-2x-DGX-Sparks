+def test_the_idle_servers_wait(fake, afd_fake, monkeypatch):
+    """TF_GLM_MULTI_PREFILL_WAIT_MS: an idle server's admission waits for requests arriving with the first and ends as
+    soon as every slot is taken; a stop (close) during the wait goes back for the idle worker; off, no wait. Then the
+    threaded scheduler: four requests at once share the first prompt chunk, each reply its solo one."""
+
+    from tensorfold.cuda.scheduler import Waiting
+    from tensorfold.cuda.streams import Stream
+    from tensorfold.families.glm5_next.cuda.engine import encode_policy
+    from tensorfold.families.glm5_next.cuda.multi import GlmScheduler
+
+    def item(n, seed):
+        s = Stream(tm._prompt(n, seed), 4, None, draft=True)
+        s.glm = {"code": encode_policy("f3"), "spec": "f3"}
+        s.emit = lambda new: False
+        return s, queue.Queue()
+
+    def bare(d, most):                                   # no worker thread: _admit alone
+        s = GlmScheduler.__new__(GlmScheduler)
+        s.decoder, s.max_streams, s.waiting, s.held, s.boxes, s.yields = d, most, Waiting(), None, {}, 0
+        return s
+
+    _mode(monkeypatch, True, wait="900")
+    n1 = ta.World1(afd_fake, streams=2)
+    sched = bare(n1.d, 2)
+    threading.Timer(0.1, lambda: sched.waiting.put(item(12, 2))).start()
+    t = time.monotonic()
+    sched._admit(item(10, 1), time.monotonic() + 0.9)
+    assert n1.d.live() == 2 and time.monotonic() - t < 0.8          # both slots taken: no wait past the second
+    n2 = ta.World1(afd_fake, streams=3)
+    sched2 = bare(n2.d, 3)
+    threading.Timer(0.1, sched2.waiting.stop).start()
+    sched2._admit(item(10, 1), time.monotonic() + 2.0)
+    assert n2.d.live() == 1 and sched2.waiting.get(timeout=1) is None
+    # the threaded scheduler, TF_GLM_MULTI_PREFILL_WAIT_MS=1000: a burst of four lands in one first chunk
+    _mode(monkeypatch, True, wait="1000")
+    n4 = ta.World1(afd_fake, streams=4)
+    sched4 = GlmScheduler(n4.d, max_streams=4)
+    assert sched4.gather_s == 1.0
+    reqs = [(tm._prompt(n, seed), 16, tm._sampling(kind, seed)) for n, seed, kind in BURST]
+    results: dict[int, list[int]] = {}
+
+    def client(i):
+        got: list[int] = []
+        sched4.submit(reqs[i][0], reqs[i][1], reqs[i][2], True, lambda new: got.extend(new) or False,
+                      glm={"code": encode_policy("f3"), "spec": "f3"})
+        results[i] = got
+
+    threads = [threading.Thread(target=client, args=(i,)) for i in range(4)]
+    for th in threads:
+        th.start()
+    for th in threads:
+        th.join(timeout=120)
+    sched4.close()
+    assert [results[i] for i in range(4)] == [tm.solo(afd_fake.torch, *r) for r in reqs]
+    assert len(n4.g.e.chunks[0]) == 4 and n4.d.grouped["chunks"] == 2
+    _mode(monkeypatch, False, wait="900")
+    off = GlmScheduler(ta.World1(afd_fake, streams=2).d, max_streams=2)
+    assert off.gather_s == 0.0
+    off.close()
+
