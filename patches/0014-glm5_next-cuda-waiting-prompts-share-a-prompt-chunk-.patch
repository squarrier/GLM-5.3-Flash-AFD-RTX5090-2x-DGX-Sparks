+# -- the forward seam: the real forward.compute and PieceMixer over recorded kernels ---------------------------------------
+class Rec:
+    """Every kernel call of a forward, in order: (name, arguments) with each tensor named by the buffer, state or
+    weight it views and its element offset, shape and strides; ``enter``/``exit`` around ``kda_rows`` and
+    ``dsa_rows`` (the stream-state parts)."""
+
+    def __init__(self, torch) -> None:
+        self.torch = torch
+        self.names: dict[int, tuple] = {}          # storage pointer -> (name, offset, row stride, row dim, rows)
+        self.aliases: dict[int, str] = {}          # whole objects passed as such (the buffers, the latent scratch)
+        self.calls: list[tuple] = []
+
+    def register(self, name: str, t, row: int = 0) -> None:
+        self.names[t.untyped_storage().data_ptr()] = (name, t.storage_offset(), t.stride(row) if t.dim() else 0, row,
+                                                       t.shape[row] if t.dim() else 0)
+
+    def norm(self, x):
+        """A view that runs to its buffer's last row records its rows as "END": a kernel reads the rows it is told
+        (KDA's scratch from row lo on, ``forward._scratch_rows``, has fewer rows than the whole scratch; the
+        extension only checks there are enough)."""
+
+        torch = self.torch
+        if id(x) in self.aliases:
+            return ("obj", self.aliases[id(x)])
+        if isinstance(x, torch.Tensor):
+            key = self.names.get(x.untyped_storage().data_ptr())
+            if key is None:
+                return ("anon", tuple(x.shape))
+            name, base, rs, row, rows = key
+            off = x.storage_offset() - base
+            shape = list(x.shape)
+            if rs and x.dim() > row and off % rs == 0 and off // rs + shape[row] == rows and x.stride(row) == rs:
+                shape[row] = "END"
+            return (name, off, tuple(shape), tuple(x.stride()))
+        if isinstance(x, (list, tuple)):
+            return tuple(self.norm(v) for v in x)
+        if isinstance(x, SimpleNamespace):
+            return tuple(sorted((k, self.norm(v)) for k, v in vars(x).items()))
+        return x if x is None or isinstance(x, (bool, int, float, str)) else ("obj", type(x).__name__)
+
+    def fn(self, name: str, ret=None):
+        def call(*a, **k):
+            self.calls.append((name, self.norm(a), tuple(sorted((key, self.norm(v)) for key, v in k.items()))))
+            return ret(*a, **k) if ret is not None else None
+        return call
+
+    def shifted(self, call, lo: int):
+        """A call with every prompt-buffer view moved ``lo`` rows up (``b.``-named tensors)."""
+
+        def mv(x):
+            if isinstance(x, tuple) and len(x) == 4 and isinstance(x[0], str) and x[0].startswith("b."):
+                rs = next(v[2] for v in self.names.values() if v[0] == x[0])
+                return (x[0], x[1] - lo * rs, x[2], x[3])
+            if isinstance(x, tuple):
+                return tuple(mv(v) for v in x)
+            return x
+        return mv(call)
+
+
+def build_forward(torch, rec: Rec, *, dense_limit: int = 10**6):
+    """Small CPU stand-ins for Weights (4 layers: KDA + dense MLP, DSA + MoE, KDA + MoE, DSA + MoE; EXL3-style shared
+    expert; the AFD wire), the prompt buffers and the per-stream states, every tensor registered by name."""
+
+    D, S, RMAX, V = 16, 2, 64, 32
+    cfg = SimpleNamespace(hidden=D, streams=S, eps=1e-5, hc_eps=1e-6, hc_iters=2, q_lora=8, kv_lora=8, qk_dim=4,
+                          v_dim=4, index_dim=4, dense_limit=dense_limit, top_k=2, experts=4, routed_scale=1.0,
+                          norm_topk=True, limit=10.0, lower=-5.0)
+    weights = {}
+
+    def W(name):
+        t = torch.zeros((2,))
+        weights[name] = t
+        rec.register("w." + name, t)
+        return t
+
+    layers = []
+    for i, (kind, ffn) in enumerate([("kda", "mlp"), ("dsa", "moe"), ("kda", "moe"), ("dsa", "moe")]):
+        p = f"L{i}."
+        layer = SimpleNamespace(index=i, kind=kind, in_norm=W(p + "in_norm"), post_norm=W(p + "post_norm"),
+                                attn_hc=SimpleNamespace(fn=W(p + "ahc.fn"), base=W(p + "ahc.base"), scale=W(p + "ahc.s")),
+                                ffn_hc=SimpleNamespace(fn=W(p + "fhc.fn"), base=W(p + "fhc.base"), scale=W(p + "fhc.s")),
+                                kda=None, dsa=None, mlp=None, moe=None)
+        if kind == "kda":
+            layer.kda = SimpleNamespace(proj=W(p + "proj"), fa_off=8, ga_off=16, fb=W(p + "fb"), gb=W(p + "gb"),
+                                        b_off=24, conv=W(p + "conv"), a_log=W(p + "a_log"), dt_bias=W(p + "dt"),
+                                        norm=W(p + "norm"), o=W(p + "o"))
+        else:
+            layer.dsa = SimpleNamespace(proj=W(p + "proj"), q_norm=W(p + "qn"), kv_norm=W(p + "kvn"), q_b=W(p + "qb"),
+                                        absorb=W(p + "absorb"), heads=2, o=W(p + "o"),
+                                        index=SimpleNamespace(kw=W(p + "ikw"), gate=W(p + "igate"), ln_w=W(p + "ilnw"),
+                                                              ln_b=W(p + "ilnb"), ape=W(p + "iape"), qb=W(p + "iqb")))
+        if ffn == "mlp":
+            layer.mlp = SimpleNamespace(gu=W(p + "gu"), down=W(p + "down"))
+        else:
+            layer.moe = SimpleNamespace(router=W(p + "router"), bias=W(p + "bias"), experts=W(p + "experts"),
+                                        shared=SimpleNamespace(gu=W(p + "sgu"), down=W(p + "sdown")))
+        layers.append(layer)
+
+    def buf(name, shape, row=0, dtype=None):
+        t = torch.zeros(shape, dtype=dtype or torch.float32)
+        rec.register("b." + name, t, row)
+        return t
+
+    b = SimpleNamespace(prefill=True, rows=RMAX, world=1, tap_at={2: [0]})
+    for name, width in [("x", S * D), ("normed", D), ("xs", 4), ("post", S), ("comb", S * S), ("ka", 8), ("kg", 8),
+                        ("dp", 16), ("qr", 8), ("xs_qr", 2), ("lat", 8), ("xs_lat", 2), ("xs_ao", 2), ("ikr", 6),
+                        ("igr", 4), ("qi", 8), ("part", D), ("sy", D), ("sgu", 8), ("sact", 4), ("sxs", 1),
+                        ("mlog", 4), ("wts", 3), ("hidden", D), ("fnormed", D), ("fxs", 4), ("gu", 8), ("act", 4),
+                        ("xs_act", 1), ("kxs", 2), ("xs_fa", 2), ("xs_ga", 2)]:
+        setattr(b, name, buf(name, (RMAX, width)))
+    b.hcpart = buf("hcpart", (RMAX, 2, 4))
+    b.q, b.vn = buf("q", (RMAX, 2, 4)), buf("vn", (RMAX, 2, 4))
+    b.pick = buf("pick", (RMAX, 3), dtype=torch.int32)
+    b.ids = buf("ids", (RMAX,), dtype=torch.int32)
+    b.ids_host = torch.zeros((RMAX,), dtype=torch.int32)
+    b.staged = SimpleNamespace(synchronize=lambda: None, record=lambda: None)
+    b.kproj = buf("kproj", (1, RMAX, 40), row=1)
+    b.kscratch = SimpleNamespace(out=buf("ks.out", (RMAX, 8)), k=buf("ks.k", (RMAX, 2, 4)),
+                                 v=buf("ks.v", (RMAX, 2, 4)), g=buf("ks.g", (RMAX, 2, 4)), b=buf("ks.b", (RMAX, 2)))
+    b.lat_s = SimpleNamespace(qa=buf("ls.qa", (RMAX, 2, 8)), ol=buf("ls.ol", (RMAX, 2, 8)), nch=64, part_rows=32)
+    rec.aliases[id(b)], rec.aliases[id(b.lat_s)] = "B", "LATENT_SCRATCH"
+    b.afd_recv = buf("afd_recv", (3 * RMAX * D,))
+    b.taps = [buf("tap0", (RMAX, D))]
+    b.logits = buf("logits", (1, V))
+    head, embed, norm = W("head"), W("embed"), W("norm")
+    wire = SimpleNamespace(begin=rec.fn("afd.begin"), exchange=rec.fn("afd.exchange"),
+                           collect=rec.fn("afd.collect", lambda bb, rows, d: bb.afd_recv[:3 * rows * d].view(3, rows, d)))
+    w = SimpleNamespace(cfg=cfg, layers=layers, head=head, embed=embed, norm=norm, comm=None, afd=wire, world=1)
+    return w, b
+
+
+class TraceState:
+    """forward.State's surface for the recorded forward: a slot's KDA states and conv windows, its extent's latents
+    and index rings, its device position."""
+
+    def __init__(self, torch, rec: Rec, slot: int, pos: int, *, index: bool = True) -> None:
+        p = f"st{slot}."
+        self.slot, self.base, self.capacity = slot, 4096 * slot, 4096
+        self.kda_index, self.dsa_index = {0: 0, 2: 1}, {1: 0, 3: 1}
+        self.cur = [0, 0]
+        self.rec = torch.zeros((2, 2, 4))
+        self.conv = torch.zeros((2, 3, 8))
+        self.kc = [torch.zeros((4096, 8)), torch.zeros((4096, 8))]
+        self.vc = [None, None]
+        self.pos_dev = torch.zeros((1,), dtype=torch.int64)
+        self.index = [tuple(torch.zeros((64, 4)) for _ in range(3)) for _ in range(2)] if index else None
+        for name, t in [("rec", self.rec), ("conv", self.conv), ("kc0", self.kc[0]), ("kc1", self.kc[1]),
+                        ("pos_dev", self.pos_dev)]:
+            rec.register(p + name, t)
+        for i, trio in enumerate(self.index or []):
+            for j, t in enumerate(trio):
+                rec.register(f"{p}index{i}.{j}", t)
+        self.pos = pos
+        self.pos_dev.fill_(pos)
+
+    def set_pos(self, pos: int) -> None:
+        self.pos = pos
+        self.pos_dev.fill_(pos)
+
+
+def patch_kernels(monkeypatch, rec: Rec, fwd, forward_mod=None) -> None:
+    """Every kernel the prompt chunk calls, recorded (and ``kda_rows`` / ``dsa_rows`` marked) on module ``fwd``."""
+
+    import torch
+
+    mods = {n: importlib.import_module(f"tensorfold.families.glm5_next.cuda.{n}")
+            for n in ("glue", "kda", "latent", "sparse", "qmm")}
+    for n in ("embed", "hc_pre", "hc_post", "rmsnorm", "router", "select", "swiglu", "combine", "stream_mean"):
+        monkeypatch.setattr(mods["glue"], n, rec.fn("glue." + n))
+    monkeypatch.setattr(mods["kda"], "chain", rec.fn("kda.chain", lambda *a, **k: a[13].out[:a[12]]))
+    monkeypatch.setattr(mods["latent"], "latent_write", rec.fn("latent.latent_write"))
+    monkeypatch.setattr(mods["latent"], "absorb_q", rec.fn("latent.absorb_q", lambda q, a, out: out))
+    monkeypatch.setattr(mods["latent"], "attention", rec.fn("latent.attention", lambda *a, out, **k: out))
+    monkeypatch.setattr(mods["latent"], "sparse_attention", rec.fn("latent.sparse_attention"))
+    monkeypatch.setattr(mods["latent"], "expand_v", rec.fn("latent.expand_v", lambda o, a, out: out))
+    monkeypatch.setattr(mods["sparse"], "index_update", rec.fn("sparse.index_update"))
+    monkeypatch.setattr(mods["sparse"], "select_tokens", rec.fn(
+        "sparse.select_tokens", lambda *a, **k: (torch.zeros((a[4], 4), dtype=torch.int32),
+                                                 torch.zeros((a[4],), dtype=torch.int32))))
+    monkeypatch.setattr(mods["qmm"], "group_sums", rec.fn("qmm.group_sums", lambda x, xs: xs))
+    monkeypatch.setattr(fwd, "mm", rec.fn("mm", lambda b, x, q, xs, out, f32=False: out))
+    monkeypatch.setattr(fwd, "_shift_conv", rec.fn("shift_conv"))
+    for name in ("kda_rows", "dsa_rows"):
+        real = getattr(fwd, name, None)
+        if real is None:
+            continue
+
+        def marked(*a, _real=real, _name=name, **k):
+            if _name == "kda_rows":                  # kda_rows(layer, w, st, b, lo, n)
+                lo, rows, slot = a[4], a[5], a[2].slot
+            else:                                    # dsa_rows(a, w, lc, pos_dev, b, R, ..., lo=0): the slot by pos_dev
+                lo, rows = k.get("lo", a[10] if len(a) > 10 else 0), a[5]
+                slot = int(rec.norm(a[3])[0].split(".")[0][2:])
+            rec.calls.append(("enter", _name, lo, rows, slot))
+            out = _real(*a, **k)
+            rec.calls.append(("exit", _name))
+            return out
+        monkeypatch.setattr(fwd, name, marked)
+
+
+def segments(calls) -> tuple[list, list]:
+    """(the calls outside kda_rows / dsa_rows, [(enter marker, calls inside)] in order)."""
+
+    outside, inside, cur = [], [], None
+    for c in calls:
+        if c[0] == "enter":
+            cur = (c, [])
+        elif c[0] == "exit":
+            inside.append(cur)
+            cur = None
+        elif cur is not None:
+            cur[1].append(c)
+        else:
+            outside.append(c)
+    return outside, inside
+
+
+@pytest.mark.parametrize("dense_limit", [10**6, 100], ids=["dense", "sparse-past-100"])
+def test_the_forward_seam_gives_each_piece_its_solo_calls(allocations, monkeypatch, dense_limit):  # noqa: F811
+    """Three streams' pieces (rows 7, 40 and 12 at positions 500, 90 and 3; with the dense limit at 100 the first
+    piece's rows are all sparse, the second's cross it and the third's are dense): the real prefill_pieces over the
+    real forward. Each piece's stream-state calls are its solo prefill_chunk's, with its rows a view ``lo`` rows into
+    the chunk's buffers (and its own position, chunk count, caches and rings); the rest is a solo chunk of all 59
+    rows; the wire saw one begin(59, chunk=True) and one exchange per MoE layer."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import decode
+    from tensorfold.families.glm5_next.cuda import multi_prefill as mp
+
+    forward = importlib.import_module("tensorfold.families.glm5_next.cuda.forward")
+    rec = Rec(torch)
+    w, b = build_forward(torch, rec, dense_limit=dense_limit)
+    patch_kernels(monkeypatch, rec, forward)
+    monkeypatch.setattr(decode, "commit", forward.commit)
+    plan = [(0, 500, 7), (1, 90, 40), (2, 3, 12)]                    # (slot, position, rows)
+    states = {s: TraceState(torch, rec, s, pos) for s, pos, _ in plan}
+    prompts = {s: list(range(1, pos + n + 1)) for s, pos, n in plan}
+    solo = {}
+    for s, pos, n in plan:                                           # each piece as a chunk of its own
+        e = SimpleNamespace(w=w, st=states[s], pbuf=b, prefill_rows=64, last_hidden=None,
+                            tap_rows=lambda k, bb: torch.cat([t[:k] for t in bb.taps], dim=1))
+        rec.calls = []
+        decode.prefill_chunk(e, prompts[s], pos, n, head=True)
+        solo[s] = list(rec.calls)
+        assert states[s].pos == pos + n
+        states[s].set_pos(pos)
+        states[s].cur = [0, 0]
+    R = sum(n for _, _, n in plan)
+    ref_state = TraceState(torch, rec, 7, 0, index=True)
+    rec.calls = []                                                   # a solo chunk of all the rows: the row-wise calls
+    decode.prefill_chunk(SimpleNamespace(w=w, st=ref_state, pbuf=b, prefill_rows=64, last_hidden=None,
+                                         tap_rows=lambda k, bb: None), list(range(R)), 0, R, head=False)
+    ref_out, _ = segments(rec.calls)
+    rec.calls = []
+    pieces = [mp.Piece(states[s], prompts[s][pos:pos + n], head=s != 1) for s, pos, n in plan]
+    heads = mp.prefill_pieces(SimpleNamespace(w=w, pbuf=b, prefill_rows=64), pieces)
+    out, inside = segments(rec.calls)
+    assert [st.pos for st in states.values()] == [pos + n for _, pos, n in plan]
+    assert [h is not None for h in heads] == [True, False, True]
+    # the stream-state parts: each piece's are its solo chunk's, moved lo rows into the chunk
+    for p, (s, pos, n) in zip(pieces, plan):
+        mine = [(m, [rec.shifted(c, p.lo) for c in calls]) for m, calls in inside if m[4] == s]
+        theirs = segments(solo[s])[1]
+        assert len(mine) == len(theirs) == 4
+        for (m1, c1), (m2, c2) in zip(mine, theirs):
+            assert m1[1] == m2[1] and m1[3] == m2[3] == n and m1[2] == p.lo and m2[2] == 0
+            assert c1 == c2
+        sparse_calls = [c for _, calls in theirs for c in calls if c[0] == "latent.sparse_attention"]
+        assert bool(sparse_calls) == (pos + n - 1 >= dense_limit)
+    assert len(inside) == 4 * len(plan)
+    # the row-wise rest: exactly a solo chunk of R rows (heads aside), behind one begin(R, chunk=True)
+    def is_head(c) -> bool:
+        return c[0] == "mm" and c[1][2][0] == "w.head"
+
+    head_calls = [c for c in out if is_head(c)]
+    assert [c for c in out if not is_head(c)] == [c for c in ref_out if not is_head(c)]
+    assert out[0] == ("afd.begin", (R,), (("chunk", True),))
+    assert [c[1][1][1] // b.fnormed.stride(0) for c in head_calls] == [p.lo + p.rows - 1 for p in pieces if p.head]
+    solo_heads = [[c for c in segments(solo[s])[0] if is_head(c)] for s, _, _ in plan]
+    for c, p, h in zip(head_calls, [q for q in pieces if q.head], [h[0] for h, q in zip(solo_heads, pieces) if q.head]):
+        name, args, kw = c                       # the piece's last row (moved lo rows), the same one-row logits buffer
+        assert rec.shifted((name, args[:4], kw), p.lo) == (h[0], h[1][:4], h[2]) and args[4] == h[1][4]
+    assert sum(c[0] == "afd.exchange" for c in out) == 3 and sum(c[0] == "afd.begin" for c in out) == 1
+    assert all(c[1][1] == R for c in out if c[0] in ("afd.exchange", "afd.collect"))
