+def decide_then_copy(value: str | None = None) -> bool:
+    """TF_GLM_DECIDE_THEN_COPY (MiaAI-Lab recipe patch 0078, by m-naoki-m; off by default here): 1, ``_take_over``
+    works out which kept snapshots stay within the budget before it copies any, and copies only those
+    (``_take_over_decided``); 0 or unset, it copies each in turn as before. Read at each take-over, so an engine made
+    without ``__init__`` follows the environment too (``multi.recipe_switch``'s values, without importing it)."""
+
+    raw = os.environ.get("TF_GLM_DECIDE_THEN_COPY", "") if value is None else value
