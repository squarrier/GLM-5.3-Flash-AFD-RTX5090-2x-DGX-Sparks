     def _take_over(self, keep: list[int]) -> None:
         """Save the rows of every kept snapshot the next prefill overwrites, dropping the oldest entries past the memory budget; both ranks decide alike."""
+        if decide_then_copy():                   # TF_GLM_DECIDE_THEN_COPY=1 (MiaAI-Lab recipe patch 0078)
+            return self._take_over_decided(keep)
         from .decode import row_bytes, save_rows
 
         # TF_GLM_SHARED_PREFIX (MiaAI-Lab recipe patch 0015): saved rows keep DFlash2's window
@@ -1016,6 +1036,68 @@ class GlmEngine:
 
             torch.cuda.empty_cache()             # give the freed rows back rather than keep them in torch's pool
 
+    def _take_over_decided(self, keep: list[int]) -> None:
+        """``_take_over`` with TF_GLM_DECIDE_THEN_COPY=1 (MiaAI-Lab recipe patch 0078, by m-naoki-m): the same
+        snapshots stay and are saved, the same ones are dropped.
+
+        Decided first, copied after: which snapshots stay within the budget is worked out from their sizes alone, the
+        rest are dropped without a copy, and only the survivors are cloned. Cloning each in turn and dropping it for the
+        next grew the allocator's pool with every larger copy (reserved memory far past the budget)."""
+        from .decode import row_bytes, save_rows, snapshot_bytes
+
+        # TF_GLM_SHARED_PREFIX (MiaAI-Lab recipe patch 0015): saved rows keep DFlash2's window
+        drafter = self._kept_drafter()
+        kw = {"drafter": drafter} if drafter is not None else {}
+        live = self.live
+        order = list(self.cache)
+
+        def resumes(c) -> bool:
+            return len(c.ids) <= len(keep) and keep[:len(c.ids)] == c.ids
+
+        alive = {id(c) for c in order}
+        saved: dict[int, int] = {}                   # a survivor's held bytes once its rows are saved
+        drops: list = []
+        over_budget = False                          # a drop made for the budget (not a row already gone)
+
+        def held() -> int:
+            return sum(saved[id(c)] if id(c) in saved else snapshot_bytes(c) for c in order if id(c) in alive)
+
+        def forget(c) -> None:
+            alive.discard(id(c))
+            saved.pop(id(c), None)
+            drops.append(c)
+
+        for snap in order:                           # the walk of saving one by one, with the sizes standing in for the copies
+            n = len(snap.ids)
+            if id(snap) not in alive or snap.rows is not None or resumes(snap):
+                continue
+            if live[:n] != snap.ids:                  # its rows are already gone: nothing to resume from
+                forget(snap)
+                continue
+            need = row_bytes(self.e, snap, **kw)
+            while held() + need > self.cache_bytes:
+                old = next((c for c in order if id(c) in alive and c is not snap and not resumes(c)), None)
+                if old is None:
+                    break
+                forget(old)
+                over_budget = True
+            if held() + need > self.cache_bytes:
+                forget(snap)
+                over_budget = True
+                continue
+            shed = 0 if drafter is not None and snap.drafter_end == n else sum(
+                t.numel() * t.element_size() for t in snap.drafter_rows or [])
+            saved[id(snap)] = snapshot_bytes(snap) - shed + need
+        for snap in drops:
+            self._drop(snap)
+        for snap in order:
+            if id(snap) in saved:
+                save_rows(self.e, snap, **kw)
+        if over_budget:
+            import torch
+
+            torch.cuda.empty_cache()             # give the freed rows back rather than keep them in torch's pool
+
     def _kept_drafter(self):
         """The drafter whose context window saved snapshots keep (TF_GLM_SHARED_PREFIX), or None: they drop it.
         (MiaAI-Lab recipe patch 0015)"""
