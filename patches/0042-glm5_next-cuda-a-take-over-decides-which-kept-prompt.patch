new file mode 100644
index 0000000..0e39fa4
--- /dev/null
+++ b/tests/test_glm_decide_then_copy.py
@@ -0,0 +1,177 @@
+"""MiaAI-Lab recipe patch 0078 (by m-naoki-m), ``TF_GLM_DECIDE_THEN_COPY``: ``GlmEngine._take_over`` works out which
+kept snapshots stay within the budget before it copies any, and copies only those. Without a GPU, over stand-ins for
+decode's row_bytes / save_rows / snapshot_bytes (as tests/test_glm_cuda_kept.py): random kept caches taken over both
+ways keep, save and drop the same snapshots (the patch's own check was 200 random cases against the old walk), and a
+fresh conversation after a long one copies only what stays (the recipe's case: save_rows 22 -> 1)."""
+
+from __future__ import annotations
+
+import copy
+import random
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from tensorfold.families.glm5_next.cuda.engine import GlmEngine, decide_then_copy
+
+pytestmark = pytest.mark.torch
+
+
+class Rows:
+    """A stand-in tensor of ``n`` one-byte elements."""
+
+    def __init__(self, n):
+        self.n = n
+
+    def numel(self):
+        return self.n
+
+    def element_size(self):
+        return 1
+
+
+class Snap:
+    """decode.Snapshot's fields the take-over reads: ids, saved rows, what the snapshot holds beside them (KDA states
+    and the like), and a ring drafter's window (``drafter_rows``, kept only while the snapshot fits DFlash2)."""
+
+    def __init__(self, k, ids, need, states, window=0, drafter_end=-1, view=0):
+        self.k, self.ids, self.need, self.states, self.view = k, list(ids), need, states, view
+        self.rows, self.nbytes = None, 0
+        self.drafter_end = drafter_end
+        self.drafter_rows = [Rows(window)] if window else None
+
+
+def _fits(snap, drafter):
+    return drafter is not None and snap.drafter_end == len(snap.ids)
+
+
+def _engine(monkeypatch, snaps, live, budget, drafter):
+    """An engine with only its kept state, over decode stand-ins that record each copy and the bytes held then."""
+    log = {"saves": [], "copied": 0, "peak": 0, "emptied": 0}
+    engine = GlmEngine.__new__(GlmEngine)
+
+    def snapshot_bytes(s):                   # decode.snapshot_bytes: what it holds, plus any saved rows
+        return s.states + sum(r.n for r in s.drafter_rows or []) + (s.nbytes if s.rows is not None else 0)
+
+    def row_bytes(e, s, drafter=None):       # decode.row_bytes: its attention rows, and DFlash2's when it keeps them
+        return s.need + (s.view if _fits(s, drafter) else 0)
+
+    def save_rows(e, s, drafter=None):       # decode.save_rows: the copy; the window goes unless it still fits
+        s.rows, s.nbytes = object(), row_bytes(e, s, drafter)
+        if not _fits(s, drafter):
+            s.drafter_end, s.drafter_rows = -1, None
+        log["saves"].append(s.k)
+        log["copied"] += s.nbytes
+        log["peak"] = max(log["peak"], sum(snapshot_bytes(c) for c in engine.cache))
+
+    decode = SimpleNamespace(row_bytes=row_bytes, save_rows=save_rows, snapshot_bytes=snapshot_bytes)
+    monkeypatch.setitem(sys.modules, "tensorfold.families.glm5_next.cuda.decode", decode)
+    import torch
+
+    monkeypatch.setattr(torch.cuda, "empty_cache", lambda: log.__setitem__("emptied", log["emptied"] + 1))
+    engine.cache, engine.live, engine.cache_bytes, engine.cache_entries = list(snaps), list(live), budget, 32
+    engine.e = engine
+    engine.shared, engine.drafter = (1, object()) if drafter else (0, None)
+    return engine, log
+
+
+def _state(engine, snaps):
+    """The kept order, and each snapshot's saved rows, bytes and window while kept; a dropped one only as dropped (its
+    rows and window freed: ``_drop``). A snapshot the old walk copied and then dropped keeps the drafter_end its copy
+    reset; nothing reads a dropped snapshot, so that field is left out."""
+    kept = {id(s) for s in engine.cache}
+    return ([s.k for s in engine.cache],
+            [(s.k, s.rows is not None, s.nbytes, s.drafter_end, s.drafter_rows is not None) if id(s) in kept
+             else (s.k, "dropped", s.rows is None and s.nbytes == 0 and s.drafter_rows is None) for s in snaps])
+
+
+def _case(rng):
+    """A kept cache: snapshots of the live conversation's prefixes (resumable from the caches), of others whose rows
+    are gone, some already saved; a next prompt resuming one of them or none; sizes and a budget at random."""
+    live = list(range(rng.randint(40, 400)))
+    snaps = []
+    for k in range(rng.randint(1, 14)):
+        kind = rng.random()
+        if kind < 0.55:
+            ids = live[:rng.randint(1, len(live))]
+        else:
+            ids = [10_000 + k] + live[:rng.randint(0, 30)]
+        end = rng.choice([len(ids), len(ids), -1, max(0, len(ids) - 3)])
+        s = Snap(k, ids, need=rng.randint(1, 80), states=rng.randint(0, 12),
+                 window=rng.choice([0, 0, rng.randint(1, 30)]), drafter_end=end, view=rng.randint(0, 25))
+        if rng.random() < 0.2:
+            s.rows, s.nbytes = object(), rng.randint(1, 60)
+        snaps.append(s)
+    pick = rng.random()
+    if pick < 0.4:
+        keep = []
+    elif pick < 0.8:
+        keep = list(rng.choice(snaps).ids) + [7, 8, 9]
+    else:
+        keep = live[:rng.randint(1, len(live))] + [5]
+    return snaps, live, keep, rng.randint(10, 260), rng.random() < 0.5
+
+
+def _walk(monkeypatch, case, value):
+    snaps, live, keep, budget, drafter = copy.deepcopy(case)
+    monkeypatch.setenv("TF_GLM_DECIDE_THEN_COPY", value)
+    engine, log = _engine(monkeypatch, snaps, live, budget, drafter)
+    engine._take_over(keep)
+    return _state(engine, snaps), log, budget, snaps
+
+
+def test_the_switch_reads_0_or_1():
+    assert decide_then_copy("") is False and decide_then_copy("0") is False and decide_then_copy(" 1 ") is True
+    with pytest.raises(ValueError, match="TF_GLM_DECIDE_THEN_COPY"):
+        decide_then_copy("yes")
+
+
+@pytest.mark.parametrize("seed", range(4))
+def test_random_kept_caches_keep_save_and_drop_the_same_snapshots_either_way(monkeypatch, seed):
+    rng = random.Random(780 + seed)
+    for _ in range(100):
+        case = _case(rng)
+        old, old_log, budget, _ = _walk(monkeypatch, case, "")
+        new, new_log, _, _ = _walk(monkeypatch, case, "1")
+        assert new == old                                       # the same order, saves, drops, bytes and windows
+        assert bool(new_log["emptied"]) == bool(old_log["emptied"])   # torch's pool emptied after the same drops
+        assert set(new_log["saves"]) <= set(old_log["saves"])  # only snapshots the old walk copied too ...
+        survivors = {s[0] for s in new[1] if s[1] is True} & set(old_log["saves"])
+        assert set(new_log["saves"]) == survivors               # ... and only the ones that stay
+        assert new_log["copied"] <= old_log["copied"]
+        assert new_log["peak"] <= budget and old_log["peak"] <= budget
+
+
+@pytest.mark.parametrize("drafter", [False, True])
+def test_a_fresh_conversation_after_a_long_one_copies_only_what_stays(monkeypatch, drafter):
+    """The recipe's case: 22 turns of one long conversation kept, each its prompt's state; a fresh conversation then
+    takes the caches over. The old walk saves each turn's rows and drops it for the next (22 copies, each larger than
+    the last, which grew the allocator's pool); decided first, only the last turn is copied."""
+    live = list(range(23 * 100))
+    snaps = [Snap(k, live[:(k + 1) * 100], need=(k + 1) * 10, states=4, window=6 if drafter else 0,
+                  drafter_end=(k + 1) * 100 if drafter else -1, view=3) for k in range(22)]
+    budget = 300                                     # the last turn's copy fits, never two of the last turns'
+    case = (snaps, live, [], budget, drafter)
+    old, old_log, _, _ = _walk(monkeypatch, case, "")
+    new, new_log, _, _ = _walk(monkeypatch, case, "1")
+    assert new == old
+    assert old_log["saves"] == list(range(22)) and new_log["saves"] == [21]
+    assert old[0] == new[0] == [21]
+    assert new_log["copied"] < old_log["copied"] / 10
+
+
+def test_a_resumed_snapshot_and_rows_already_gone_are_handled_alike(monkeypatch):
+    """The prompt's own resume point is never dropped or copied; a snapshot whose rows the caches no longer hold is
+    dropped without the budget's empty_cache (only drops for the budget empty torch's pool), either way."""
+    live = list(range(300))
+    hit = Snap(0, live[:100], need=50, states=5)
+    gone = Snap(1, [99_999] + live[:10], need=10, states=5)
+    other = Snap(2, live[:200], need=50, states=5)
+    for budget, emptied in ((200, False), (55, True)):
+        case = ([hit, gone, other], live, live[:100] + [1, 2], budget, False)
+        old, old_log, _, _ = _walk(monkeypatch, case, "")
+        new, new_log, _, _ = _walk(monkeypatch, case, "1")
+        assert new == old
+        assert 0 in old[0] and 1 not in old[0]
+        assert bool(new_log["emptied"]) == bool(old_log["emptied"]) == emptied
