+def _gen(seed: int):
+    import torch
+
+    return torch.Generator().manual_seed(seed)
+
+
+def _rows(b, rows, seed: int):
+    """``tp._fill``'s rows from a seed (normed, pick and wts written, as ``layer_front`` / ``moe_route`` write them);
+    returns the shared expert output, which the caller writes after the exchange, as ``forward.moe_send`` does."""
+
+    import torch
+
+    gen = _gen(seed)
+    b.normed[:rows] = torch.randn((rows, D), generator=gen).to(torch.bfloat16)
+    b.pick[:rows] = torch.randint(0, 16, (rows, S), generator=gen, dtype=torch.int32)
+    b.wts[:rows] = torch.rand((rows, S), generator=gen)
+    return torch.randn((rows, D), generator=gen)
+
+
+def _check(got, b, rows, layer, sy) -> None:
+    import torch
+
+    for half in (0, 1):
+        assert torch.equal(got[half], partial(b.normed[:rows], b.pick[:rows], b.wts[:rows], layer, half)), (layer, half)
+    assert torch.equal(got[2], sy), ("the shared expert output", layer)
+
+
+def _lanes_run(monkeypatch, w: Wire, rows, seed: int, out: dict, flight: dict, *, share_sy: bool = False) -> None:
+    """``rows``' chunks as lanes through the real scheduler (``_forward_lanes``, each lane's layer loop a stand-in for
+    ``_steps``) over the real wire; lane k's layer rows are seeded by (seed, k, layer), so every N sends the same
+    rows; the shared expert output is written after the exchange (``moe_send``'s order); each reply is checked and
+    kept in ``out``. ``share_sy``: every lane's buffers hold lane 0's ``sy`` (today's pair buffers)."""
+
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    a = w.a
+    bufs = [tp._bufs() for _ in rows]
+    if share_sy:
+        for b in bufs[1:]:
+            b.sy = bufs[0].sy
+
+    def steps(e, ch):
+        k, r, b = ch.slot, ch.R, bufs[ch.slot]
+        for pos, layer in enumerate(w.layers):
+            sy = _rows(b, r, seed + 100 * k + pos)
+            yield pp.SEND
+            e.w.afd.use(k)
+            e.w.afd.exchange(b, r)
+            b.sy[:r] = sy                          # the shared expert, while the exchange flies
+            flight["now"] += 1
+            flight["max"] = max(flight["max"], flight["now"])
+            yield pp.WAIT
+            e.w.afd.use(k)
+            got = e.w.afd.collect(b, r, D)
+            flight["now"] -= 1
+            _check(got, b, r, layer, sy)
+            out[(seed, k, pos)] = got.clone()
+            yield pp.DONE
+
+    monkeypatch.setattr(pp, "_steps", steps)
+    e = SimpleNamespace(w=SimpleNamespace(afd=a))
+    if len(rows) == 2:
+        a.begin_pair(rows)
+    else:
+        a.begin_lanes(rows)
+    pp._forward_lanes(e, [pp.Chunk([None], k, bufs[k], R=rows[k]) for k in range(len(rows))])
+
+
+def _plain_run(w: Wire, rows, seed: int, out: dict, *, k: int = 0, slice=None) -> None:
+    """One forward (or a layer slice ``(first, count)``) with the same seeding as ``_lanes_run``'s lane ``k``."""
+
+    b = tp._bufs()
+    first, count = slice if slice is not None else (0, len(w.layers))
+    if slice is None:
+        w.a.begin(rows, chunk=rows > 8)
+    else:
+        w.a.begin(rows, chunk=True, slice=slice)
+    for pos in range(first, first + count):
+        sy = _rows(b, rows, seed + 100 * k + pos)
+        w.a.exchange(b, rows)
+        b.sy[:rows] = sy
+        got = w.a.collect(b, rows, D)
+        _check(got, b, rows, w.layers[pos], sy)
+        out[(seed, k, pos)] = got.clone()
+
+
+GROUPS = [(PREFILL, 13, 21, PREFILL), (5, PREFILL, 30), (9, PREFILL)]     # lanes of 4, 3 and a pair
+
+
+def _session(monkeypatch, w: Wire) -> tuple[dict, list]:
+    """The groups as lanes, then plain forwards (a prompt chunk, decode windows) and a layer slice."""
+
+    out, tops = {}, []
+    for g, rows in enumerate(GROUPS):
+        flight = {"now": 0, "max": 0}
+        _lanes_run(monkeypatch, w, rows, 1000 * (g + 1), out, flight)
+        tops.append(flight["max"])
+    _plain_run(w, 11, 9000, out)
+    _plain_run(w, 1, 9100, out)
+    _plain_run(w, PREFILL, 9200, out, slice=(1, 2))
+    _plain_run(w, 3, 9300, out)
+    return out, tops
+
+
+def _serial(monkeypatch, w: Wire) -> dict:
+    """Every lane of every group alone, as a plain prompt-chunk forward (the serial reference), then the same tail."""
+
+    out = {}
+    for g, rows in enumerate(GROUPS):
+        for k, r in enumerate(rows):
+            _plain_run(w, r, 1000 * (g + 1), out, k=k)
+    _plain_run(w, 11, 9000, out)
+    _plain_run(w, 1, 9100, out)
+    _plain_run(w, PREFILL, 9200, out, slice=(1, 2))
+    _plain_run(w, 3, 9300, out)
+    return out
+
+
+def _same(x: dict, y: dict) -> bool:
+    import torch
+
+    return x.keys() == y.keys() and all(torch.equal(x[k], y[k]) for k in x)
+
+
+@pytest.mark.parametrize("modes", MODES, ids=["cpu", "gpu", "mixed"])
+def test_lanes_over_n_link_pairs_equal_the_serial_run(env, words, master, tmp_path, monkeypatch, modes):
+    """N = 1, 2, 4 over the fake MCDMA pair: lanes of 4, 3 and 2 through the real scheduler, then plain forwards and a
+    layer slice. Every reply equals the serial run's (each lane alone, one link pair); both experts saw the same
+    requests (rows and bytes) in the same order at every N; at most N exchanges were in flight, and N of them were
+    (up to the lane count); the requests went round-robin over each node's links; the transport ends with nothing in
+    flight."""
+
+    import torch
+
+    ref = Wire(tmp_path / "serial", words, master, 1, attn=modes[0], experts=modes[1])
+    serial = _serial(monkeypatch, ref)
+    ref.close()
+    seen = {}
+    for n in DEPTHS:
+        w = Wire(tmp_path / f"n{n}", words, master, n, attn=modes[0], experts=modes[1])
+        out, tops = _session(monkeypatch, w)
+        assert _same(out, serial), n
+        assert tops == [min(n, len(rows)) for rows in GROUPS], (n, tops)
+        assert not w.tr._flight and not w.a._busy and w.a.dead is None
+        counts = w.links.count
+        for half in (0, 1):                       # round-robin: each node's links within one request of each other
+            mine = counts[half::2]
+            assert max(mine) - min(mine) <= 1 and sum(mine) == len(w.eps[half].node.seen), (n, counts)
+        for ep in w.eps:
+            assert ep.error is None
+        seen[n] = [(ep.node.seen, ep.node.inputs) for ep in w.eps]
+        w.close()
+    for n in DEPTHS[1:]:                          # the experts' work identical to the switch off's, call for call
+        for (s1, i1), (sn, i_n) in zip(seen[1], seen[n]):
+            assert sn == s1
+            assert all(a[:2] == b[:2] and all(torch.equal(x, y) for x, y in zip(a[2:], b[2:])) for a, b in zip(i1, i_n))
+
+
+@pytest.mark.parametrize("n", [2, 4])
+def test_a_forward_of_three_moe_layers_moves_the_next_to_another_link(env, words, master, tmp_path, monkeypatch, n):
+    """Three MoE layers: a plain forward ends on another link than it began (3 requests over N links), so the next
+    forward's first request comes on link 3 mod N; a pair and lanes after it; every reply as the serial run's."""
+
+    layers = [3, 4, 5]
+    ref = Wire(tmp_path / "serial", words, master, 1, layers=layers)
+    want = {}
+    for seed, rows in ((10, 7), (20, PREFILL), (30, 2)):
+        _plain_run(ref, rows, seed, want)
+    for k, r in enumerate((9, PREFILL)):
+        _plain_run(ref, r, 40, want, k=k)
+    for k, r in enumerate((5, 7, PREFILL)):
+        _plain_run(ref, r, 50, want, k=k)
+    ref.close()
+    w = Wire(tmp_path / f"n{n}", words, master, n, layers=layers)
+    out = {}
+    _plain_run(w, 7, 10, out)
+    end = time.monotonic() + 5                       # each expert moved on after its last reply
+    while [ep.link.at for ep in w.eps] != [3 % n, 3 % n]:
+        assert time.monotonic() < end, [ep.link.at for ep in w.eps]
+        time.sleep(0.005)
+    _plain_run(w, PREFILL, 20, out)
+    _plain_run(w, 2, 30, out)
+    flight = {"now": 0, "max": 0}
+    _lanes_run(monkeypatch, w, (9, PREFILL), 40, out, flight)
+    _lanes_run(monkeypatch, w, (5, 7, PREFILL), 50, out, flight)
+    assert _same(out, want) and flight["max"] == min(n, 3)
+    assert all(ep.error is None for ep in w.eps)
+    w.close()
