+# -- the schedule ----------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("depth", DEPTHS)
+@pytest.mark.parametrize("n", [2, 3, 4])
+@pytest.mark.parametrize("kinds", tl.KINDS, ids=["glm-like", "one-moe", "dense-between", "dense-tail"])
+def test_the_lane_schedule_at_depth(monkeypatch, n, depth, kinds):
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    log = []
+    monkeypatch.setattr(pp, "_steps", tl._stand_in(kinds, log))
+    e = SimpleNamespace(w=SimpleNamespace(afd=SimpleNamespace(depth=depth)))
+    pp._forward_lanes(e, [pp.Chunk([None], k, SimpleNamespace(sy=object())) for k in range(n)])
+    moe = [i for i, kind in enumerate(kinds) if kind == "moe"]
+    xs = [(k, i) for ev, k, i in log if ev == "x"]
+    assert xs == [(k, i) for i in moe for k in range(n)]                    # lane order within each layer
+    assert [(k, i) for ev, k, i in log if ev == "c"] == xs                  # replies in the order the requests went
+    flight = top = 0
+    for ev, _, _ in log:
+        flight += {"x": 1, "c": -1}.get(ev, 0)
+        assert 0 <= flight <= depth
+        top = max(top, flight)
+    assert top == min(depth, n)
+    for k in range(1, n):                                                    # the lane before ran each layer first
+        for i in range(len(kinds)):
+            assert log.index(("a", k - 1, i)) < log.index(("a", k, i)), (k, i)
+    for j, (ev, k, i) in enumerate(log):                                     # a reply is used before the next collect
+        if ev == "c":
+            h = log.index(("h", k, i))
+            assert not [x for x in log[j + 1:h] if x[0] == "c"], (k, i, log[j:h + 1])
+    for i in moe:                                  # depth >= 2: lane k's exchange before lane k - 1's reply of it
+        for k in range(1, n):
+            before = log.index(("x", k, i)) < log.index(("c", k - 1, i))
+            assert before == (depth >= 2), (k, i, depth)
+    assert sum(1 for ev, _, _ in log if ev == "t") == n
