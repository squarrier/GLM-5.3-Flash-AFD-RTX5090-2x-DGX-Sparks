+    assert w.tr.depth == w.a.depth == 1 and w.tr._slots == [None]
+    assert "inflight" not in w.tr.publish(settings())
+    _session(monkeypatch, w)
+    assert calls and all(a == () and k == {} for _, a, k in calls)
+    assert all(len(ep.link.links) == 1 and ep.link.side is None and ep.link.at == 0 for ep in w.eps)
