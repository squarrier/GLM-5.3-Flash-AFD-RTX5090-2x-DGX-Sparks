+# -- each lane's own shared expert output ----------------------------------------------------------------------------
+@pytest.mark.parametrize("n", [1, 2])
+def test_a_shared_shared_expert_output_needs_depth_one(env, words, master, tmp_path, monkeypatch, n):
+    """Why each lane holds its own ``sy`` on a deeper wire: lanes sharing it (the pairs' buffers, the check in
+    ``_forward_lanes`` switched off) are right at N = 1, where a lane's shared expert output is collected before the
+    next lane's exchange writes it, and wrong at N = 2, where the next lane's ``moe_send`` overwrites it first."""
+
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    monkeypatch.setattr(pp, "FLIGHT_FIELDS", ())
+    w = Wire(tmp_path, words, master, n)
+    out = {}
+    if n == 1:
+        _lanes_run(monkeypatch, w, (PREFILL, 13), 5, out, {"now": 0, "max": 0}, share_sy=True)
+        assert len(out) == 2 * len(LAYERS)
+    else:
+        with pytest.raises(AssertionError, match="the shared expert output"):
+            _lanes_run(monkeypatch, w, (PREFILL, 13), 5, out, {"now": 0, "max": 0}, share_sy=True)
+        assert not out                            # lane 0's first reply already carried lane 1's sy
+    for x in w.names:                             # the wire was left mid-pair at N = 2: the experts end on BYE
+        w.daemon.bye(x)
+    for ep in w.eps:
+        ep.t.join(5)
+    w.daemon.close()
+
