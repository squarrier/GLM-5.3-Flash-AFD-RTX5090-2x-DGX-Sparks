+def test_the_switch_off_is_todays_path(env, words, master, tmp_path, monkeypatch):
+    """N = 1 (TF_GLM_MCDMA_INFLIGHT unset): every issue and collect goes to every link at once (today's calls, no link
+    subset), the transport and the wire have depth 1 and the handshake no ``inflight``; the expert ends keep one
+    link and no reply stream."""
