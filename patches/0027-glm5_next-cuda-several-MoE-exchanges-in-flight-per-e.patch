+# -- serve(): the handshake and the expert's links --------------------------------------------------------------------
+def test_serve_with_two_exchanges_in_flight(env, words, tmp_path):
+    """The expert nodes' ``serve`` over the store handshake with ``inflight`` 2: each opens its two links (link 1's
+    socket from ``socket_for``, each link's base from its own store key), echoes ``inflight``, and serves plain
+    forwards and a pair over both link pairs; the attention's watchdog keys see the BYE."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import afd as afd_mod
+    from tensorfold.families.glm5_next.cuda import afd_mcdma, experts_node, mcdma
+    from tests.glm_afd_fakes import buffers, forward
+
+    names = _names(2)
+    daemon = FakeDaemon(tmp_path, names)
+    env.setattr(afd_mod, "WATCH_EVERY", 3600)
+    env.setattr(experts_node, "ALIVE_EVERY", 3600)
+    env.setattr(experts_node.Config, "read", staticmethod(lambda _d: fake_cfg()))
+    env.setattr(experts_node, "ExpertNode", lambda _d, half, layers, **_: FakeNode(layers, half))
+    by_thread = {"x0": "a2", "x1": "a1"}
+    env.setattr(mcdma, "link_name", lambda: by_thread[threading.current_thread().name])
+    env.setattr(mcdma, "socket_for", lambda name, j: None if j == 0 else daemon.sock(name))
+    init = mcdma.ExpertLink.__init__
+    opened = []
+
+    def link_init(self, name, **kw):
+        kw.setdefault("socket_path", daemon.sock(name))
+        opened.append((threading.current_thread().name, name, kw["socket_path"] == daemon.sock(name)))
+        init(self, name, **kw)
+
+    env.setattr(mcdma.ExpertLink, "__init__", link_init)
+    port, errors = free_port(), {}
+
+    def run(half):
+        try:
+            experts_node.serve(tmp_path, half, "127.0.0.1", port, device="cpu")
+        except BaseException as exc:  # noqa: BLE001
+            errors[half] = exc
+
+    threads = [threading.Thread(target=run, args=(h,), name=f"x{h}", daemon=True) for h in (0, 1)]
+    for t in threads:
+        t.start()
+    links = mcdma.AttentionLinks(names, words=words, mode="cpu", timeout=10, shm_dir=str(daemon.shm), linkup_wait=2)
+    tr = afd_mcdma.McdmaTransport("127.0.0.1", port, links=links, device="cpu", hidden=D)
+    a = afd_mod.AfdWire("127.0.0.1", port, transport=tr)
+    a.announce(afd_mod.settings_for(tmp_path, fake_cfg(), prefill_rows=PREFILL, pairs=True))
+    a.wait_loaded(30)
+    assert sorted(opened) == [("x0", "a2", True), ("x0", "a2-1", True), ("x1", "a1", True), ("x1", "a1-1", True)]
+    b, gen = buffers(), torch.Generator().manual_seed(11)
+    for rows in (1, 4, PREFILL, 1):
+        forward(a, b, rows, gen, chunk=rows > 8)
+    tp._pair(a, (9, PREFILL), gen)
+    assert links.count == [len(LAYERS) * 3] * 4                 # 12 requests per node, alternating its two links
+    for x in names:
+        daemon.bye(x)
+    for t in threads:
+        t.join(10)
+        assert not t.is_alive()
+    assert all(isinstance(errors[h], mcdma.LinkError) for h in (0, 1)), errors
+    for r in (1, 2):
+        assert b"BYE" in bytes(a.store.get(f"afd_error/{r}"))
+    daemon.close()
