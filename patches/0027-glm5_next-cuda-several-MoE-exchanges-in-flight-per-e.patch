+DEPTHS = [1, 2, 4]
+MODES = [("cpu", ("cpu", "cpu")), ("gpu", ("gpu", "gpu")), ("gpu", ("cpu", "gpu"))]
+
+
+def _names(n: int) -> list[str]:
+    """The attention's links at N exchanges in flight: rank 1's and rank 2's, per exchange slot."""
+
+    from tensorfold.families.glm5_next.cuda import mcdma
+
+    return [mcdma.more_link(name, j) for j in range(n) for name in ("a2", "a1")]
+
+
+# -- the setting, the link map, the handshake ------------------------------------------------------------------------
+def test_the_setting_and_the_link_map(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import afd_mcdma, mcdma
+
+    monkeypatch.delenv(ENV, raising=False)
+    assert mcdma.inflight() == 1 and mcdma.inflight("") == 1 and mcdma.inflight(" 2 ") == 2
+    assert [mcdma.inflight(str(n)) for n in (1, 2, 3, 4)] == [1, 2, 3, 4]
+    for bad in ("0", "5", "two", "2.0", "-1", "on"):
+        with pytest.raises(ValueError, match=ENV):
+            mcdma.inflight(bad)
+    monkeypatch.setenv(ENV, "4")
+    assert mcdma.inflight() == 4
+    monkeypatch.setenv(mcdma.LINKS_ENV, "a2,a1")
+    assert mcdma.link_names() == ["a2", "a1"] == mcdma.link_names(1)        # one pair: today's map
+    assert mcdma.link_names(2) == ["a2", "a1", "a2-1", "a1-1"] == _names(2)
+    assert mcdma.link_names(4) == ["a2", "a1", "a2-1", "a1-1", "a2-2", "a1-2", "a2-3", "a1-3"]
+    monkeypatch.delenv(mcdma.SOCKET_ENV, raising=False)
+    assert mcdma.socket_for("a2", 0) is None                                 # link 0: ExpertLink's own rule
+    assert mcdma.socket_for("a2-1", 1) == "/tmp/mcdma-rpcd.a2-1.sock"         # the daemon's default
+    monkeypatch.setenv(mcdma.SOCKET_ENV, "/mcdma/a2.sock")
+    assert mcdma.socket_for("a2-3", 3) == "/mcdma/a2-3.sock"                  # beside link 0's
+    for raw, want in (({"inflight": 2}, 2), ({"inflight": 4}, 4), ({}, 1), ({"inflight": 7}, 1),
+                      ({"inflight": True}, 1), ({"inflight": "2"}, 1)):
+        assert afd_mcdma.inflight_asked(raw) == want, raw
