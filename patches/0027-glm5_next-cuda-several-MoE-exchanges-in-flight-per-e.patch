+
+    def rec_issue(self, req, n, rep_len, *a, **k):
+        calls.append(("issue", a, k))
+        return issue(self, req, n, rep_len, *a, **k)
+
+    def rec_collect(self, outs, rep_len, *a, **k):
+        calls.append(("collect", a, k))
