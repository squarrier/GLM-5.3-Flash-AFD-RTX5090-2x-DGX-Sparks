+# -- B issued before A's reply ---------------------------------------------------------------------------------------
+@pytest.mark.parametrize("n", [1, 2])
+def test_the_next_lane_goes_out_before_the_reply(env, words, master, tmp_path, monkeypatch, n):
+    """Lane 0's replies held in the daemon (its link pair stalls): at N = 2 lane 1's request goes out, and both experts
+    compute it, while lane 0's first reply is still held; at N = 1 lane 1's request waits for that reply. The wire's
+    send / reply times (host clock) show the same: at N = 2 lane 1's send precedes lane 0's reply."""
+
+    from tensorfold.families.glm5_next.cuda import afd_mcdma
+
+    w = Wire(tmp_path, words, master, n)
+    events = []
+    send, recv = afd_mcdma.McdmaTransport.send, afd_mcdma.McdmaTransport.recv
+
+    def timed_send(self, b, rows, layer):
+        send(self, b, rows, layer)
+        events.append(("send", rows, layer, time.monotonic()))
+
+    def timed_recv(self, d1, d2, layer):
+        recv(self, d1, d2, layer)
+        events.append(("reply", d1.shape[0], layer, time.monotonic()))
+
+    monkeypatch.setattr(afd_mcdma.McdmaTransport, "send", timed_send)
+    monkeypatch.setattr(afd_mcdma.McdmaTransport, "recv", timed_recv)
+    w.daemon.stalled |= {"a2", "a1"}                 # lane 0's link pair (the k-th request: pair k mod N)
+    rows, out, failed = (PREFILL, 13), {}, []
+
+    def attention():
+        try:
+            _lanes_run(monkeypatch, w, rows, 77, out, {"now": 0, "max": 0})
+        except BaseException as exc:  # noqa: BLE001
+            failed.append(exc)
+
+    t = threading.Thread(target=attention, daemon=True)
+    t.start()
+    end = time.monotonic() + 5
+    while not all(ep.node.seen for ep in w.eps):
+        assert time.monotonic() < end, "lane 0's first request never computed"
+        time.sleep(0.005)
+    if n == 2:                                       # lane 1's request computed while lane 0's reply is held
+        while not all(len(ep.node.seen) >= 2 for ep in w.eps):
+            assert time.monotonic() < end, "lane 1's request did not go out while lane 0's reply was held"
+            time.sleep(0.005)
+        assert [ep.node.seen[:2] for ep in w.eps] == [[(LAYERS[0], PREFILL), (LAYERS[0], 13)]] * 2
+    else:                                            # one link pair: lane 1 waits for lane 0's reply
+        time.sleep(0.5)
+        assert [ep.node.seen for ep in w.eps] == [[(LAYERS[0], PREFILL)]] * 2
+    assert not [e for e in events if e[0] == "reply"]
+    w.daemon.stalled.clear()
+    t.join(10)
+    assert not t.is_alive() and not failed, failed
+    first_reply = next(e[3] for e in events if e[0] == "reply" and e[1] == PREFILL)
+    lane1_send = next(e[3] for e in events if e[0] == "send" and e[1] == 13)
+    assert (lane1_send < first_reply) == (n == 2), events[:6]
+    assert len(out) == 2 * len(LAYERS) and all(ep.error is None for ep in w.eps)
+    w.close()
+
