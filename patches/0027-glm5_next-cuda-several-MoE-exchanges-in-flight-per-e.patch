+@pytest.mark.parametrize("case", ["unanswered", "stopped"])
+@pytest.mark.parametrize("n", [1, 2])
+def test_windows_that_end_with_a_request_unanswered_are_refused(env, words, master, tmp_path, n, case):
+    """A pair whose windows both sent every MoE layer but whose last request was never collected: the next header
+    refuses it (the experts are out of step), at N = 1 as at N = 2. Windows that stopped early (here also with a
+    request unanswered) get today's message: that check comes first."""
+
+    from tensorfold.server.errors import CapacityError
+
+    w = Wire(tmp_path, words, master, n)
+    a, bufs, rows, nl = w.a, [tp._bufs(), tp._bufs()], (PREFILL, 13), len(w.layers)
+    last = nl - 1 if case == "unanswered" else nl - 2      # the layer whose window-1 request stays unanswered
+    a.begin_pair(rows)
+    for pos in range(last + 1):
+        for k in (0, 1):
+            a.use(k)
+            _rows(bufs[k], rows[k], 10 * k + pos)
+            a.exchange(bufs[k], rows[k])
+            if not (k == 1 and pos == last):
+                a.collect(bufs[k], rows[k], D)
+    want = (rf"requests \[\(1, {last}\)\] \(\(window, layer\)\) unanswered" if case == "unanswered" else
+            rf"pair's window 0 \(seq \d+\) stopped after {last + 1} of {nl} MoE exchanges")
+    with pytest.raises(CapacityError, match=want):
+        a.begin(1)
+    for x in w.names:
+        w.daemon.bye(x)
+    for ep in w.eps:
+        ep.t.join(5)
+    w.daemon.close()
