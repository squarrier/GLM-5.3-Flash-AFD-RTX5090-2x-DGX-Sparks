+# -- the expert's reply stream (GPU-driven; streams and events faked) -------------------------------------------------
+class _Ev:
+    def __init__(self, log, name) -> None:
+        self.log, self.name = log, name
+
+    def record(self, stream=None) -> None:
+        self.log.append(("record", self.name, stream.name))
+
+
+class _Stream:
+    def __init__(self, log, name, handle) -> None:
+        self.log, self.name, self.cuda_stream = log, name, handle
+
+    def wait_event(self, ev) -> None:
+        self.log.append(("wait", self.name, ev.name))
+
+
+def test_the_reply_stream(monkeypatch):
+    """Two links, GPU-driven: ``out`` gives each request its link's own rows; ``reply`` records the compute's event,
+    the reply stream waits for it, copies the rows into the link's reply mailbox and stages the word there, then
+    records the link's sent event; the third request (link 0 again) makes the compute stream wait for link 0's last
+    copy before its rows are reused. The replies' bytes are the rows computed."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import afd_mcdma
+
+    log = []
+    comp, side = _Stream(log, "compute", 11), _Stream(log, "reply", 22)
+    monkeypatch.setattr(torch.cuda, "current_stream", lambda *a, **k: comp)
+
+    @contextlib.contextmanager
+    def on(stream):
+        log.append(("enter", stream.name))
+        yield
+        log.append(("exit", stream.name))
+
+    monkeypatch.setattr(torch.cuda, "stream", on)
+    rows = 4
+
+    def fake_link(j):
+        box = SimpleNamespace(rep_bytes=torch.zeros(rows * D * 4, dtype=torch.uint8))
+        return SimpleNamespace(name=f"a2-{j}" if j else "a2", mode="gpu", base=1, box=box,
+                               stage_gpu=lambda seq, n, stream=None, j=j: log.append(("stage", j, seq, n, stream)))
+
+    links = [fake_link(0), fake_link(1)]
+    end = afd_mcdma.McdmaExpertLink(links, D, S, len(LAYERS), PREFILL, device="cpu")
+    assert end.side is None and end.out(rows) is None           # no CUDA device: no reply stream
+    end.side = side                                             # as on CUDA (__init__'s branch)
+    end.outs = [torch.zeros((PREFILL, D)) for _ in links]
+    end._computed = [_Ev(log, f"computed{j}") for j in range(2)]
+    end._sent = [_Ev(log, f"sent{j}") for j in range(2)]
+    end._used = [False, False]
+    end.n_rep = rows * D * 4
+    for k in range(3):
+        log.clear()
+        j = k % 2
+        dst = end.out(rows)
+        assert dst.data_ptr() == end.outs[j].data_ptr() and dst.shape == (rows, D)
+        dst.copy_(torch.full((rows, D), float(k + 1)))           # the compute's rows
+        end.reply(0, dst)
+        want = ([("wait", "compute", "sent0")] if k == 2 else []) + [
+            ("record", f"computed{j}", "compute"), ("wait", "reply", f"computed{j}"), ("enter", "reply"),
+            ("exit", "reply"), ("stage", j, 1 + k // 2, rows * D * 4, 22), ("record", f"sent{j}", "reply")]
+        assert log == want, (k, log)
+        assert torch.equal(links[j].box.rep_bytes.view(torch.float32).view(rows, D), torch.full((rows, D), k + 1.0))
+        assert end.at == (k + 1) % 2 and end.seqs[j] == 2 + k // 2
+    log.clear()
+    other = torch.full((rows, D), 9.0)                          # not ``out``'s rows: the compute stream's copy (today)
+    end.reply(0, other)
+    assert log == [("stage", 1, 2, rows * D * 4, None)]
+    assert torch.equal(links[1].box.rep_bytes.view(torch.float32).view(rows, D), other)
+
