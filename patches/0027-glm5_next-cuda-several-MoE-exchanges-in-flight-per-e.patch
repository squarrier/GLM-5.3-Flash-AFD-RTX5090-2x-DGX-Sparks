+# -- the forward seam: recorded kernels -----------------------------------------------------------------------------
+def _seam_at(monkeypatch, n: int, depth: int):
+    """tests/test_glm_prefill_lanes.py's seam on a wire of ``depth``: lanes 1 .. n - 1's own buffers with their own
+    shared expert output when depth > 1, named l<k>.*."""
+
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    s = tp._seam(monkeypatch)
+    rec = s.rec
+    s.w.afd.begin_lanes = rec.fn("afd.begin_lanes")
+    s.w.afd.depth = depth
+    lanes = []
+    own = pp.SLOT_FIELDS + pp.ROUTED_FIELDS + (pp.FLIGHT_FIELDS if depth > 1 else ())
+    for k in range(1, n):
+        lb = pp.lane_buffers(s.b, flight=True) if depth > 1 else pp.lane_buffers(s.b)
+        for name in own:
+            rec.register(f"l{k}." + name, getattr(lb, name))
+        for i, t in enumerate(lb.taps):
+            rec.register(f"l{k}.tap{i}", t)
+        rec.aliases[id(lb)] = f"L{k}"
+        lanes.append(lb)
+    s.lanes = lanes
+    return s
+
+
+def _wire_ops(calls) -> list:
+    ops, slot = [], 0
+    for c in calls:
+        if c[0] == "afd.use":
+            slot = c[1][0]
+        elif c[0] in ("afd.exchange", "afd.collect"):
+            ops.append((c[0][4], slot))
+    return ops
+
+
+@pytest.mark.parametrize("depth", DEPTHS)
+@pytest.mark.parametrize("sizes,pos,holds", [((64, 64), 0, (0,)), ((40, 1, 64, 23), 3, (1,)), ((7, 64, 9), 90, ()),
+                                             ((64, 30, 64, 64), 500, (0, 2))],
+                         ids=["2x64", "4-odd", "3-odd", "4-far"])
+def test_lanes_at_depth_make_each_chunks_solo_calls(allocations, monkeypatch, depth, sizes, pos, holds):  # noqa: F811
+    """One stream's 2-4 consecutive chunks as lanes on a wire of depth 1, 2 and 4: every kernel call of each lane is
+    its solo prefill_chunk's (later lanes' l<k>.* buffers, their own shared expert output included, named as the
+    solo's), taps, end states and held states as the solo chunks'; on the wire each layer's exchanges go in lane
+    order, are collected in that order, at most ``depth`` in flight, and at depth >= 2 lane k's exchange of a layer
+    goes out before lane k - 1 collects that layer's reply."""
+
+    s = _seam_at(monkeypatch, len(sizes), depth)
+    torch, rec, n = s.torch, s.rec, len(sizes)
+    starts = [pos + sum(sizes[:k]) for k in range(n)]
+    prompt = list(range(1, starts[-1] + sizes[-1] + 1))
+    st = tp.hp.TraceState(torch, rec, 1, pos)
+    e = tp._engine(s, st)
+    solo, taps0, kept = [], [], {}
+    for k in range(n):
+        rec.calls = []
+        out_solo = s.decode.prefill_chunk(e, prompt, starts[k], sizes[k], drafter=tp._drafter(taps0, rec),
+                                          head=k == n - 1)
+        solo.append([tp._canon(c) for c in rec.calls if tp._kernel(c)])
+        kept[k] = (st.rec[st.cur[0]].clone(), st.conv.clone())
+    end_solo = (st.rec.clone(), st.conv.clone(), list(st.cur), st.pos)
+
+    st2 = tp.hp.TraceState(torch, rec, 1, pos)
+    eng = tl._engine(s)
+    taps1 = []
+    rec.calls = []
+    chunks = s.pp.run_lanes(eng, [[tp._mp().Piece(st2, prompt[starts[k]:starts[k] + sizes[k]],
+                                                  drafter=tp._drafter(taps1, rec), head=k == n - 1)]
+                                  for k in range(n)], hold=[[st2] if k in holds else [] for k in range(n - 1)])
+    calls = list(rec.calls)
+    for ch in chunks:
+        s.pp.finish(eng, ch)
+    assert tl._by_lane(calls, n) == solo
+    assert taps1 == taps0 and st2.pos == pos + sum(sizes)
+    assert st2.rec.tolist() == end_solo[0].tolist() and st2.conv.tolist() == end_solo[1].tolist()
+    assert list(st2.cur) == end_solo[2]
+    assert all(ch.heads == [None] for ch in chunks[:-1]) and chunks[-1].heads[0].shape == out_solo.shape
+    for k, ch in enumerate(chunks[:-1]):
+        if k in holds:
+            rec_h, conv_h = ch.held(st2)
+            assert torch.equal(rec_h, kept[k][0]) and torch.equal(conv_h, kept[k][1])
+    ops, moe = _wire_ops(calls), 3                    # build_forward: layers 1, 2, 3 are MoE
+    xs = [k for op, k in ops if op == "e"]
+    assert xs == [k for _ in range(moe) for k in range(n)] and [k for op, k in ops if op == "c"] == xs
+    flight = top = 0
+    for op, _ in ops:
+        flight += 1 if op == "e" else -1
+        assert 0 <= flight <= depth
+        top = max(top, flight)
+    assert top == min(depth, n)
+    for layer in range(moe):                          # the j-th exchange / collect of lane k is its layer j's
+        for k in range(1, n):
+            x = [i for i, (op, kk) in enumerate(ops) if op == "e" and kk == k][layer]
+            c = [i for i, (op, kk) in enumerate(ops) if op == "c" and kk == k - 1][layer]
+            assert (x < c) == (depth >= 2), (layer, k, depth)
+
