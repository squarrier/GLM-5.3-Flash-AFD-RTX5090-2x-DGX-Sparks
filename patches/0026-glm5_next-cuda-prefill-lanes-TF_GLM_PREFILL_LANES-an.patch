+# -- the wire --------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("modes", tl.MODES, ids=["cpu", "gpu", "mixed"])
+def test_fp8_rows_over_the_mcdma_wire(env, daemon, words, master, modes):
+    """With the setting on (the handshake's ``wire_fp8``): plain forwards, a pair and lanes of 3; every expert read
+    exactly the decoded rows (and the sent experts and weights), every reply is its function of them, and each request
+    was the FP8 layout's size."""
+
+    import torch
+
+    w = _w()
+    from tensorfold.families.glm5_next.cuda import mcdma
+
+    links, eps = tl._links(daemon, words, attn=modes[0], experts=modes[1], fp8=True, record=True)
+    wait_attached(daemon)
+    a = tl.attention(links, master, fp8=True)
+    assert a.tr.fp8 and a.tr.layout.req(PREFILL) < mcdma.Layout(D, S).req(PREFILL)
+    gen = torch.Generator().manual_seed(41)
+    sent = []
+    real = a.tr.send
+
+    def send(b, rows, layer):
+        sent.append((b.normed[:rows].clone(), b.pick[:rows].clone(), b.wts[:rows].clone()))
+        return real(b, rows, layer)
+
+    a.tr.send = send
+    b = tp._bufs()
+    a.begin(11, chunk=True)
+    for layer in LAYERS:
+        tp._fill(b, 11, gen)
+        a.exchange(b, 11)
+        got = a.collect(b, 11, D)
+        x = w.roundtrip(b.normed[:11])
+        assert not torch.equal(x, b.normed[:11])         # FP8 rows: not the bf16 rows
+        for half in (0, 1):
+            assert torch.equal(got[half], partial(x, b.pick[:11], b.wts[:11], layer, half))
+    tl._lanes_over(a, (PREFILL, 5, 9), gen, fp8=True)
+    for ep in eps:
+        assert ep.error is None and len(ep.node.inputs) == len(sent)
+        for (layer, rows, normed, pick, wts), (n0, p0, w0) in zip(ep.node.inputs, sent):
+            assert torch.equal(normed, w.roundtrip(n0)) and torch.equal(pick, p0) and torch.equal(wts, w0)
+    for ep in eps:
+        assert ep.link.lay.fp8 and ep.link.n_req == ep.link.lay.req(ep.link.rows)
+    tp._close(daemon, eps)
+
+
+def test_the_wire_check_hashes_the_decoded_rows(env, daemon, words, master, monkeypatch, capsys):
+    """TF_AFD_CHECK=1 with FP8 rows over a plain forward and a pair: the attention hashes the rows the experts decode
+    (``wire_rows``), the experts hash what they computed with; 0 mismatches."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import afd, experts_node
+
+    monkeypatch.setattr(afd, "CHECK_FORWARDS", 3)
+    monkeypatch.setattr(experts_node, "CHECK_FORWARDS", 3)
+    monkeypatch.setattr(torch.cuda, "synchronize", lambda *a, **k: None)
+    holder = {}
+    store = SimpleNamespace(set=lambda k, v: holder["s"].set(k, v))
+    links, eps = tl._links(daemon, words, fp8=True, check=True, store=store)
+    wait_attached(daemon)
+    a = tl.attention(links, master, fp8=True)
+    holder["s"] = a.store
+    a.check = True
+    gen = torch.Generator().manual_seed(42)
+    b = tp._bufs()
+    a.begin(6, chunk=True)
+    for layer in LAYERS:
+        tp._fill(b, 6, gen)
+        a.exchange(b, 6)
+        a.collect(b, 6, D)
+    _fp8_pair(a, (8, 5), gen)
+    a.begin(2)
+    a.layer = a.nlayers
+    out = capsys.readouterr().out
+    assert a.checked == 3 and a.mismatches == 0, out
+    assert "3 forwards (2 of them in prompt chunk pairs, seqs 2-3), 0 mismatches" in out
+    tp._close(daemon, eps)
+
+
+def _fp8_pair(a, rows, gen) -> None:
+    bufs = [tp._bufs(), tp._bufs()]
+    a.begin_pair(rows)
+    for _ in LAYERS:
+        for k in (0, 1):
+            tp._fill(bufs[k], rows[k], gen)
+            a.use(k)
+            a.exchange(bufs[k], rows[k])
+            a.collect(bufs[k], rows[k], D)
