+        if laned:
+            chunks = s.pp.run_lanes(e, lanes, hold=[[sts[0], sts[1]], [sts[0], sts[1], sts[2]]])
+            calls = list(rec.calls)
+            for ch in chunks:
+                s.pp.finish(e, ch)
+            return _by_lane(calls, 3), {k: (st.rec.tolist(), st.conv.tolist(), st.pos) for k, st in sts.items()}, \
+                chunks
+        out, held = [], []
+        for j in range(3):
+            tp._mp().prefill_pieces(e, lanes[j])
+            out.append([tp._canon(c) for c in rec.calls if tp._kernel(c)])
+            held.append({k: (sts[k].rec[sts[k].cur[0]].clone(), sts[k].conv.clone()) for k in sts})
+            rec.calls = []
+        return out, {k: (st.rec.tolist(), st.conv.tolist(), st.pos) for k, st in sts.items()}, held
+
+    calls0, states0, held0 = run(False)
+    calls1, states1, chunks = run(True)
+    assert calls1 == calls0 and states1 == states0
+    from tensorfold.families.glm5_next.cuda.prefill_pairs import At
+
+    for j, ks in ((0, (0, 1)), (1, (0, 1, 2))):
+        for k in ks:
+            st = next((p.st._st if isinstance(p.st, At) else p.st) for p in chunks[j].pieces if p.st.slot == k)
+            assert all(torch.equal(x, y) for x, y in zip(chunks[j].held(st), held0[j][k])), (j, k)
+
+
+# -- the wire: the fake mcdma-rpcd pair --------------------------------------------------------------------------
+def _links(daemon, words, *, attn="cpu", experts=("cpu", "cpu"), timeout=10.0, pairs=True, lanes=4, fp8=False,
+           record=False, check=False, store=None):
+    import threading
+
+    from tensorfold.families.glm5_next.cuda import afd_mcdma, experts_node, mcdma
+
+    drv = FakeDriver(words)
+    links = mcdma.AttentionLinks(["a2", "a1"], words=words, driver=drv if attn == "gpu" else None, mode=attn,
+                                 stream=lambda: 0, timeout=timeout, shm_dir=str(daemon.shm), linkup_wait=2)
+    eps = []
+    for half, (name, mode) in enumerate(zip(["a2", "a1"], experts)):
+        link = mcdma.ExpertLink(name, words=words, driver=drv if mode == "gpu" else None, mode=mode,
+                                socket_path=daemon.sock(name), shm_dir=str(daemon.shm), stream=lambda: 0)
+        link.base = links.base[half]
+        end = afd_mcdma.McdmaExpertLink(link, D, S, len(LAYERS), PREFILL, device="cpu", pairs=pairs, lanes=lanes,
+                                        fp8=fp8)
+        ep = SimpleNamespace(link=end, node=FakeNode(LAYERS, half, record=record), error=None)
+
+        def run(ep=ep, half=half):
+            try:
+                experts_node.forwards(ep.node, ep.link, store if store is not None else DictStore(), half + 1,
+                                      check_on=check)
+            except BaseException as exc:  # noqa: BLE001
+                ep.error = exc
+
+        ep.t = threading.Thread(target=run, daemon=True)
+        ep.t.start()
+        eps.append(ep)
+    return links, eps
+
+
+def attention(links, port, *, fp8=False):
+    """``glm_afd_fakes.mcdma_attention`` with the handshake's ``wire_fp8`` when ``fp8``."""
+
+    from tensorfold.families.glm5_next.cuda import afd as afd_mod
+    from tensorfold.families.glm5_next.cuda import afd_mcdma
+
+    tr = afd_mcdma.McdmaTransport("127.0.0.1", port, links=links, comm=SimpleNamespace(abort=links.release),
+                                  device="cpu", hidden=D)
+    a = afd_mod.AfdWire("127.0.0.1", port, transport=tr)
+    a.announce(dict(settings(), **({"wire_fp8": 1} if fp8 else {})))
+    return a
+
+
+def _lanes_over(a, rows, gen, *, fp8=False, stop_after=None) -> None:
+    """N >= 3 lanes' exchanges in the schedule's wire order (lane 0's layer, lane 1's, ...), each reply checked against
+    the experts' function of the rows they decoded."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import wire_fp8
+
+    bufs = [tp._bufs() for _ in rows]
+    a.begin_lanes(rows)
+    for pos, layer in enumerate(LAYERS):
+        for k, r in enumerate(rows):
+            if stop_after is not None and (pos, k) == stop_after:
+                return
+            tp._fill(bufs[k], r, gen)
+            a.use(k)
+            a.exchange(bufs[k], r)
+            got = a.collect(bufs[k], r, D)
+            x = wire_fp8.roundtrip(bufs[k].normed[:r]) if fp8 else bufs[k].normed[:r]
+            for half in (0, 1):
+                assert torch.equal(got[half], partial(x, bufs[k].pick[:r], bufs[k].wts[:r], layer, half)), (layer, k)
+            assert torch.equal(got[2], bufs[k].sy[:r])
+
+
+MODES = [("cpu", ("cpu", "cpu")), ("gpu", ("gpu", "gpu")), ("gpu", ("cpu", "gpu"))]
+
+
+@pytest.mark.parametrize("modes", MODES, ids=["cpu", "gpu", "mixed"])
+def test_lanes_over_the_mcdma_wire(env, daemon, words, master, modes):
+    """Lanes of 4 (48, 7, 48, 1 rows) and 3 (5, 48, 30), then a pair and a plain chunk: every reply is the experts'
+    function of its own window's request; each expert served each layer's lanes in lane order; every later lane's
+    header was checked against the first's (``next_partner``); the forwards after the lanes carry no lane words."""
+
+    import torch
+
+    links, eps = _links(daemon, words, attn=modes[0], experts=modes[1])
+    wait_attached(daemon)
+    a = attention(links, master)
+    gen = torch.Generator().manual_seed(15)
+    groups = [(PREFILL, 7, PREFILL, 1), (5, PREFILL, 30)]
+    for rows in groups:
+        _lanes_over(a, rows, gen)
+    tp._pair(a, (9, PREFILL), gen)
+    tp._plain(a, 11, gen)
+    for ep in eps:
+        want = [(layer, r) for rows in groups + [(9, PREFILL)] for layer in LAYERS for r in rows]
+        assert ep.node.seen == want + [(layer, 11) for layer in LAYERS], ep.node.seen
+        assert ep.error is None
+    assert a.seq == 4 + 3 + 2 + 1 and a.dead is None
+    tp._close(daemon, eps)
+
+
+def test_an_expert_without_lanes_refuses(env, daemon, words, master):
+    """An expert link opened without the handshake's ``lanes`` refuses MODE_LANES (as an older tree refuses a mode
