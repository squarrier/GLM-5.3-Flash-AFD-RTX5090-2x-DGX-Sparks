+def test_grouped_chunks_as_lanes(allocations, monkeypatch):  # noqa: F811
+    """TF_GLM_MULTI_PREFILL's chunks as three lanes: two streams' pieces, then their next rows and a third stream's,
+    then all three again: each lane's calls are its solo prefill_pieces', the continuing streams' rows from where
+    their rows in the lanes before end, their kept states held."""
+
+    s = _seam(monkeypatch, 3)
+    torch, rec = s.torch, s.rec
+    plan = [(0, 30, (20, 9, 11)), (1, 4, (30, 12, 6)), (2, 7, (0, 21, 17))]      # (slot, position, rows per lane)
+
+    def run(laned):
+        sts = {k: hp.TraceState(torch, rec, k, pos) for k, pos, _ in plan}
+        prompts = {k: list(range(1, pos + sum(ns) + 1)) for k, pos, ns in plan}
+        lanes = []
+        for j in range(3):
+            lanes.append([tp._mp().Piece(sts[k], prompts[k][pos + sum(ns[:j]):pos + sum(ns[:j + 1])], head=j == 2)
+                          for k, pos, ns in plan if ns[j]])
