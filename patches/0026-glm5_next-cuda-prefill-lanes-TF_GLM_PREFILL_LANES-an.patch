+
+
+def reference_scale(block) -> int:
+    """A 32-value block's UE8M0 byte as glm53f-afd's quantizers compute it (``quant_scales_kernel``,
+    ``quantize_hidden``): amax in f64 (``fmax`` skips NaN), ``ceil(log2(amax / 448)) + 127`` clamped to 0 .. 254, 0 for
+    an all-zero block."""
+
+    amax = max((abs(float(v)) for v in block if not math.isnan(float(v))), default=0.0)
+    if amax == 0.0:
+        return 0
+    if math.isinf(amax):
+        return 254
+    return int(min(max(math.ceil(math.log2(amax / E4M3_MAX)) + 127.0, 0.0), 254.0))
+
+
+def _f32(v: float) -> float:
+    return struct.unpack("<f", struct.pack("<f", v))[0]
+
+
+def reference_code(v: float) -> int:
+    """glm53f-afd's device ``e4m3_encode`` of an fp32 value, step by step: the sign of ``v < 0``; the magnitude
+    clamped at 448; zero to the sign alone; ``ilogbf`` picks the band, the subnormal band rounds ``mag * 512``, a normal
+    band ``mag / 2^(E - 3)``, both half up (ties to the larger magnitude); a carry moves to the next band; at most 0x7E.
+    NaN encodes to 0 (the kernel's ``(int)floorf(NaN)`` is 0)."""
+
+    if math.isnan(v):
+        return 0
+    sign = 0x80 if v < 0.0 else 0x00
+    mag = min(abs(v), E4M3_MAX)
+    if mag == 0.0:
+        return sign
+    e = math.frexp(mag)[1] - 1                   # ilogbf
+    if e <= -7:
+        code = math.floor(mag * 512.0 + 0.5)
+    else:
+        q = math.floor(mag / 2.0 ** (e - 3) + 0.5)
+        ee = e + 7
+        if q >= 16:
+            q, ee = 8, ee + 1
+        code = min((ee << 3) | (q - 8), 0x7E)
+    return sign | code
+
+
+def reference_row(row) -> tuple[bytes, bytes]:
+    """One wire row of bf16-representable values: (E4M3 codes, UE8M0 bytes), each value times 2^(127 - s) in fp32 as
+    ``hidden_quantize_encode_kernel`` multiplies (exact: a power of two)."""
+
+    codes, scales = bytearray(), bytearray()
+    row = [float(v) for v in row]
+    for lo in range(0, len(row), BLOCK):
+        block = row[lo:lo + BLOCK]
+        s = reference_scale(block)
+        inv = 2.0 ** (127 - s)
+        scales.append(s)
+        codes.extend(reference_code(_f32(v * inv)) for v in block)
+    return bytes(codes), bytes(scales)
