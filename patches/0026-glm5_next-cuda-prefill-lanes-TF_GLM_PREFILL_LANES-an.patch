+def test_the_lane_schedule(monkeypatch, n, kinds):
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    log = []
+    monkeypatch.setattr(pp, "_steps", _stand_in(kinds, log))
+    e = SimpleNamespace(w=SimpleNamespace(afd=SimpleNamespace(depth=1)))
+    pp._forward_lanes(e, [pp.Chunk([None], k) for k in range(n)])
+    moe = [i for i, kind in enumerate(kinds) if kind == "moe"]
+    xs = [(k, i) for ev, k, i in log if ev == "x"]
+    assert xs == [(k, i) for i in moe for k in range(n)]                    # lane order within each layer
+    flight = 0
+    for ev, _, _ in log:                                                     # one exchange on the wire at a time
+        flight += {"x": 1, "c": -1}.get(ev, 0)
+        assert 0 <= flight <= 1
+    for k in range(1, n):                                                    # the lane before ran each layer first
+        for i in range(len(kinds)):
+            assert log.index(("a", k - 1, i)) < log.index(("a", k, i)), (k, i)
+        assert log.index(("t", k - 1, None)) < log.index(("t", k, None))
+    for j, (ev, k, i) in enumerate(log):                                     # a collect's reply is used before the next
+        if ev == "c":
+            h = log.index(("h", k, i))
+            assert not [x for x in log[j + 1:h] if x[0] == "c"], (k, i, log[j:h + 1])
+    first = (log.index(("x", 0, moe[0])), log.index(("c", 0, moe[0])))
+    for k in range(1, n):                                                    # every later lane starts inside it
+        assert first[0] < log.index(("a", k, moe[0])) < first[1]
+    assert sum(1 for ev, _, _ in log if ev == "t") == n
