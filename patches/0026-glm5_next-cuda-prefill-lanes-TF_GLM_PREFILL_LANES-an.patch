+"""FP8 wire rows for the AFD exchange (``TF_GLM_WIRE_FP8=1``): each MoE exchange's FFN input rows go to the expert
+nodes as FP8 E4M3 codes with one UE8M0 scale byte per 32 values, 4,224 bytes a row at hidden 4,096 instead of bf16's
+8,192; the expert nodes decode them back to bf16 before their experts. The rows' experts and weights, the replies, and
+every other byte of the exchange are unchanged.
+
+The codec is glm53f-afd's wire-out activation quantizer (``Fp8E4m3Ue8m0K32``), bit for bit as its device kernels
+compute it:
+
+- per 32 consecutive values of a row, ``amax`` of their magnitudes (NaN skipped) and the scale byte
+  ``s = 0 if amax == 0 else clamp(ceil(log2(amax / 448)) + 127, 0, 254)``: ``2^(s - 127)`` is the smallest power of two
+  that brings the block within E4M3's 448 (``quant_scales_kernel``);
+- each value times ``2^(127 - s)`` in fp32 (exact: a power of two), then the nearest E4M3 code, ties to the larger
+  magnitude, saturating at 448, the sign kept unless the product is a zero or NaN (``e4m3_encode``,
+  ``hidden_quantize_encode_kernel``);
+- the expert node decodes ``e4m3(code) * 2^(s - 127)``, exact in fp32, rounded once to bf16 (exact unless a block's
+  values fall below bf16's normal range).
+
+Hugh Madden (@dangerm00se, github.com/hughmadden) wrote these kernels in mimo26f-afd and carried them into
+glm53f-afd, where they quantize the hidden rows sent to the expert ranks: hughmadden/glm53f-afd @ 91db3cc
+(``crates/glm53f-coordinator/kernels/wire.cu`` ``quant_scales_kernel``, ``e4m3_encode``,
+``hidden_quantize_encode_kernel``; their host twins ``src/wire.rs`` ``quantize_hidden`` and ``src/fp8.rs``), from
+hughmadden/mimo26f-afd @ bab9fa2 (``crates/mimo26-coordinator/kernels/glue.cu``,
+``crates/mimo26-attn/kernels/include/mimo26_attn_device.cuh``, ``crates/mimo26-attn/kernels/kv_cache_fp8.cu``,
+``crates/mimo26-load/src/e4m3.rs``); MIT, Copyright (c) 2026 Turquoise Bay AI Pty Ltd. No code is copied: here the
+scale step is torch operations, the code step a table of the 32,768 bf16 magnitudes' codes made with the plain-Python
+``reference_code`` (the device encoder's arithmetic, line by line), and ``reference_*`` are the tests' oracle. A NaN
+encodes to 0, as glm53f-afd's host twin encodes it. The row's place in the MCDMA request is this tree's
+(``mcdma.Layout``). The wire row format itself (E4M3 codes, a UE8M0 scale per 32 values) is DS41RT's, by T.J. Purtell
+(@wrldsuksgo2mars; tpurtell/ds41rt, MIT), carried through mimo26f-afd (glm53f-afd's README credits it so).
+
+This changes the experts' inputs, so outputs change; the switch is off by default.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+import struct
+
+import torch
+
+ENV = "TF_GLM_WIRE_FP8"
+BLOCK = 32                      # values per UE8M0 scale byte
+E4M3_MAX = 448.0                # the largest finite E4M3 magnitude (code 0x7E)
+_ROWS = 512                     # rows per pass of ``encode`` / ``decode``: bounds their temporaries (~40 MiB at 4,096)
+_TABLES: dict[str, torch.Tensor] = {}
+
+
+def enabled(value: str | None = None) -> bool:
+    """TF_GLM_WIRE_FP8: 1 sends the MoE exchanges' FFN input rows as FP8 E4M3 rows (one UE8M0 scale per 32 values);
+    unset or 0 (the default) as bf16."""
+
+    value = (os.environ.get(ENV, "") if value is None else value).strip() or "0"
+    if value not in ("0", "1"):
+        raise ValueError(f"{ENV}: 0 or 1, not {value!r}")
+    return value == "1"
+
+
+def row_bytes(d: int) -> int:
+    """One wire row's bytes: d E4M3 codes, then d / 32 scale bytes (4,224 at d = 4,096)."""
+
+    if d <= 0 or d % BLOCK:
+        raise ValueError(f"FP8 wire rows need a hidden size that is a multiple of {BLOCK}, not {d}")
+    return d + d // BLOCK
+
+
+def _pow2(e: torch.Tensor) -> torch.Tensor:
+    """2^e as fp32 for integer exponents e in -127 .. 127, from the bits (2^-127 is fp32's subnormal 0x00400000)."""
+
+    bits = torch.where(e >= -126, (e + 127) << 23, torch.full_like(e, 0x00400000))
+    return bits.to(torch.int32).view(torch.float32)
+
+
+def _scales(x32: torch.Tensor) -> torch.Tensor:
+    """Per 32 values of ``x32`` ([r, d] fp32): the UE8M0 scale bytes as int32 [r, d / 32]. ``amax = m 2^e`` with m in
+    [0.5, 1) and 448 = 0.875 2^9 give ``ceil(log2(amax / 448)) = e - 9 + (m > 0.875)`` exactly."""
+
+    r, d = x32.shape
+    mag = torch.nan_to_num(x32.abs(), nan=0.0, posinf=math.inf)      # the kernel's fmax skips NaN
+    amax = mag.view(r, d // BLOCK, BLOCK).amax(dim=-1)
+    m, e = torch.frexp(amax)
+    s = (e.to(torch.int32) - 9 + (m > 0.875).to(torch.int32) + 127).clamp(0, 254)
+    s = torch.where(amax > 0, s, torch.zeros_like(s))
+    return torch.where(torch.isinf(amax), torch.full_like(s, 254), s)
+
+
+def _table(device) -> torch.Tensor:
+    """The E4M3 code of each bf16 magnitude (index: the bf16 bits without the sign), uint8 [32768] on ``device``."""
+
+    key = str(device)
+    t = _TABLES.get(key)
+    if t is None:
+        codes = bytes(reference_code(struct.unpack("<f", struct.pack("<I", b << 16))[0]) for b in range(1 << 15))
+        t = _TABLES[key] = torch.frombuffer(bytearray(codes), dtype=torch.uint8).to(device)
+    return t
+
+
+def encode(x: torch.Tensor, payload: torch.Tensor, scales: torch.Tensor) -> None:
+    """``x`` ([r, d] bf16, the FFN input rows) as wire rows: ``payload`` [r, d] uint8 E4M3 codes and ``scales``
+    [r, d / 32] uint8 UE8M0 bytes, on ``x``'s device and stream, ``_ROWS`` rows at a time. A product of a bf16 value
+    and a power of two has at most bf16's 8 significant bits, so the table of bf16 magnitudes holds every code that
+    can arise; the sign is the fp32 product's, as the device kernel reads it."""
+
+    r, d = x.shape
+    row_bytes(d)
+    if payload.shape != (r, d) or scales.shape != (r, d // BLOCK):
+        raise ValueError(f"FP8 wire rows: payload {tuple(payload.shape)} and scales {tuple(scales.shape)} for rows "
+                         f"{(r, d)}")
+    table = _table(x.device)
+    for lo in range(0, r, _ROWS):
+        hi = min(r, lo + _ROWS)
+        n = hi - lo
+        x32 = x[lo:hi].to(torch.float32, copy=True)
+        s = _scales(x32)
+        p = x32.view(n, d // BLOCK, BLOCK).mul_(_pow2(127 - s).unsqueeze(-1)).view(n, d)
+        idx = p.abs().to(torch.bfloat16).view(torch.int16).to(torch.int32) & 0x7FFF   # (a NaN's bf16 may set the sign)
+        code = table.index_select(0, idx.view(-1)).view(n, d)
+        code |= (p < 0).to(torch.uint8) << 7
+        payload[lo:hi].copy_(code)
+        scales[lo:hi].copy_(s.to(torch.uint8))
+
+
+def _values(codes: torch.Tensor) -> torch.Tensor:
+    """bf16 values of E4M3 codes (uint8), exact: torch's float8_e4m3fn where this torch has it, else a 256-entry table
+    of ``reference_decode``'s values."""
+
+    f8 = getattr(torch, "float8_e4m3fn", None)
+    if f8 is not None:
+        try:
+            return codes.view(f8).to(torch.bfloat16)
+        except (RuntimeError, TypeError):         # a build without float8 conversions on this device
+            pass
+    key = f"dec:{codes.device}"
+    lut = _TABLES.get(key)
+    if lut is None:
+        lut = _TABLES[key] = torch.tensor([reference_decode(c) for c in range(256)], dtype=torch.float32,
+                                          device=codes.device).to(torch.bfloat16)
+    return lut.index_select(0, codes.reshape(-1).to(torch.int32)).view(codes.shape)
+
+
+def decode(payload: torch.Tensor, scales: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+    """Wire rows back to the bf16 values the expert nodes compute with: ``out[:r] = e4m3(payload) * 2^(scales -
+    127)`` ([r, d] bf16; torch multiplies bf16 in fp32 and rounds once, the exact product's rounding), ``_ROWS`` rows
+    at a time; returns ``out[:r]``."""
+
+    r, d = payload.shape
+    for lo in range(0, r, _ROWS):
+        hi = min(r, lo + _ROWS)
+        n = hi - lo
+        scale = _pow2(scales[lo:hi].to(torch.int32) - 127).to(torch.bfloat16).unsqueeze(-1)
+        torch.mul(_values(payload[lo:hi]).view(n, d // BLOCK, BLOCK), scale, out=out[lo:hi].view(n, d // BLOCK, BLOCK))
+    return out[:r]
+
+
+def roundtrip(x: torch.Tensor) -> torch.Tensor:
+    """``decode(encode(x))``: the bf16 rows an expert node computes with for FFN input rows ``x`` ([r, d] bf16)."""
+
+    r, d = x.shape
+    payload = torch.empty((r, d), dtype=torch.uint8, device=x.device)
+    scales = torch.empty((r, d // BLOCK), dtype=torch.uint8, device=x.device)
+    encode(x, payload, scales)
+    return decode(payload, scales, torch.empty_like(x))
+
+
+# -- plain-Python references (the tests' oracle; ``_table``'s source) -----------------------------------------------
+def reference_decode(code: int) -> float:
+    """One E4M3 code's value (glm53f-afd ``src/fp8.rs`` ``decode_e4m3``): NaN for 0x7F / 0xFF."""
+
+    if code in (0x7F, 0xFF):
+        return math.nan
+    s = -1.0 if code & 0x80 else 1.0
+    e, m = (code >> 3) & 0x0F, code & 0x07
