+@pytest.mark.parametrize("sizes,pos,holds", [((64, 64, 64), 0, (0, 1)), ((40, 1, 64, 23), 3, (1,)),
+                                             ((7, 64, 9), 90, ()), ((64, 30, 64, 64), 500, (0, 2))],
+                         ids=["3x64", "4-odd", "3-odd", "4-far"])
+def test_lanes_give_each_chunk_its_solo_calls(allocations, monkeypatch, sizes, pos, holds):  # noqa: F811
+    """One stream's 3 or 4 consecutive chunks as lanes (odd sizes, positions dense and past the dense limit, the last
+    ending the prompt): every kernel call of each lane is its solo prefill_chunk's (a later lane's l<k>.* buffers and
+    device position named as the solo's), taps and heads included; a state held at a lane's end equals the solo
+    chunk's end state; the wire saw one begin_lanes and per MoE layer each lane's exchange and collect in lane order."""
+
+    s = _seam(monkeypatch, len(sizes))
+    torch, rec, n = s.torch, s.rec, len(sizes)
+    starts = [pos + sum(sizes[:k]) for k in range(n)]
+    prompt = list(range(1, starts[-1] + sizes[-1] + 1))
+    st = hp.TraceState(torch, rec, 1, pos)
+    e = tp._engine(s, st)
+    solo, taps0, kept = [], [], {}
+    for k in range(n):
+        rec.calls = []
+        out_solo = s.decode.prefill_chunk(e, prompt, starts[k], sizes[k], drafter=tp._drafter(taps0, rec),
+                                          head=k == n - 1)
+        solo.append([tp._canon(c) for c in rec.calls if tp._kernel(c)])
+        kept[k] = (st.rec[st.cur[0]].clone(), st.conv.clone())
+    end_solo = (st.rec.clone(), st.conv.clone(), list(st.cur), st.pos)
+
+    st2 = hp.TraceState(torch, rec, 1, pos)
+    eng = _engine(s)
+    taps1 = []
+    rec.calls = []
+    chunks = s.pp.run_lanes(eng, [[tp._mp().Piece(st2, prompt[starts[k]:starts[k] + sizes[k]],
+                                                  drafter=tp._drafter(taps1, rec), head=k == n - 1)]
+                                  for k in range(n)], hold=[[st2] if k in holds else [] for k in range(n - 1)])
+    calls = list(rec.calls)
+    assert st2.pos == pos
+    for ch in chunks:
+        s.pp.finish(eng, ch)
+    assert _by_lane(calls, n) == solo
+    assert taps1 == taps0 and st2.pos == pos + sum(sizes)
+    assert st2.rec.tolist() == end_solo[0].tolist() and st2.conv.tolist() == end_solo[1].tolist()
+    assert list(st2.cur) == end_solo[2]
+    assert all(ch.heads == [None] for ch in chunks[:-1]) and chunks[-1].heads[0].shape == out_solo.shape
+    for k, ch in enumerate(chunks[:-1]):
+        if k in holds:
+            rec_h, conv_h = ch.held(st2)
+            assert torch.equal(rec_h, kept[k][0]) and torch.equal(conv_h, kept[k][1])
+        else:
+            assert ch.held(st2) is None
+    wire = [c for c in calls if c[0].startswith("afd.")]
+    assert wire[0] == ("afd.begin_lanes", (tuple(sizes),), ())
+    ops, slot = [], 0
+    for c in wire[1:]:
+        if c[0] == "afd.use":
+            slot = c[1][0]
+        else:
+            ops.append((c[0][4:], slot, c[1][1]))
+    assert ops == [(op, k, sizes[k]) for _ in range(3) for k in range(n) for op in ("exchange", "collect")]
+
