+@pytest.mark.parametrize("modes", MODES[:2], ids=["cpu", "gpu"])
+def test_the_lane_scheduler_over_the_mcdma_wire(env, daemon, words, master, monkeypatch, modes):
+    """The real lane scheduler (``_forward_lanes``) over the real wire and the fake MCDMA pair, each lane's layer loop
+    a stand-in for ``_steps``: every reply is its own lane's; the experts saw each layer's lanes in lane order; never
+    more than one request on the wire."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    links, eps = _links(daemon, words, attn=modes[0], experts=modes[1])
+    wait_attached(daemon)
+    a = attention(links, master)
+    gen = torch.Generator().manual_seed(19)
+    rows = (PREFILL, 13, 21, PREFILL)
+    bufs = [tp._bufs() for _ in rows]
+    flight = {"now": 0, "max": 0}
+
+    def steps(e, ch):
+        k, r, b = ch.slot, ch.R, bufs[ch.slot]
+        for pos, layer in enumerate(LAYERS):
+            tp._fill(b, r, gen)
+            yield pp.SEND
+            e.w.afd.use(k)
+            e.w.afd.exchange(b, r)
+            flight["now"] += 1
+            flight["max"] = max(flight["max"], flight["now"])
+            yield pp.WAIT
+            e.w.afd.use(k)
+            got = e.w.afd.collect(b, r, D)
+            flight["now"] -= 1
+            for half in (0, 1):
+                assert torch.equal(got[half], partial(b.normed[:r], b.pick[:r], b.wts[:r], layer, half)), (k, pos)
+            yield pp.DONE
+
+    monkeypatch.setattr(pp, "_steps", steps)
+    e = SimpleNamespace(w=SimpleNamespace(afd=a))
+    a.begin_lanes(rows)
+    pp._forward_lanes(e, [pp.Chunk([None], k, None, R=rows[k]) for k in range(len(rows))])
+    assert flight["max"] == 1 and a.dead is None
+    for ep in eps:
+        assert ep.node.seen == [(layer, r) for layer in LAYERS for r in rows] and ep.error is None
+    tp._plain(a, 9, gen)
+    assert all(ep.error is None for ep in eps)
+    tp._close(daemon, eps)
+
+
+def test_the_lane_timer_line(env, daemon, words, master, monkeypatch, capsys):
+    """TF_AFD_TIME=1 with lanes: sampled when the lanes close, one ``afd lane overlap`` line every 8 lane groups with
+    per N and R the window, wait and in-window work (2, 1 and 1 ms on the host clock), apart from the pairs' line."""
+
+    import torch
+
+    monkeypatch.setattr(torch.cuda, "Event", tp._HostEvent)
+    monkeypatch.setattr(torch.cuda, "synchronize", lambda *a, **k: None)
+    links, eps = _links(daemon, words)
+    wait_attached(daemon)
+    a = attention(links, master)
+    a.timing, a.ev = True, None
+    gen = torch.Generator().manual_seed(21)
+    rows, n = (PREFILL, 7, 7), len(LAYERS)
+    for _ in range(9):
+        _lanes_over(a, rows, gen)
+    out = capsys.readouterr().out
+    want = (f"[tensorfold] afd lane overlap: {24 * n} lane MoE exchanges over the last 8 lane groups (8 so far; "
+            f"in-window work: the shared expert + the other lanes' attention); "
+            f"N3 R7 n{16 * n} window p50 2.00 ms p90 2.00, wait for the reply p50 1.00 ms p90 1.00, in-window work "
+            f"p50 1.00 ms p90 1.00; N3 R{PREFILL} n{8 * n} window p50 2.00 ms p90 2.00, wait for the reply p50 1.00 ms "
+            f"p90 1.00, in-window work p50 1.00 ms p90 1.00")
+    assert out.count("afd lane overlap") == 1 and want in out and "afd pair overlap" not in out, out
+    assert a._lanes_timed == 8 and a._lane_overlap == {} and a._pairs_timed == 0
+    tp._plain(a, 5, gen)
+    assert a._lanes_timed == 9 and all(ep.error is None for ep in eps)
+    tp._close(daemon, eps)
