+    def _sample_lanes(self, rows: tuple[int, ...], every: int = 8) -> None:
+        """``_sample_pair`` for a lane group of N >= 3 windows (TF_GLM_PREFILL_LANES): the same window and wait per
+        exchange by the window's rows R; between a lane's send and its collect the stream runs that layer's shared
+        expert and the other lanes' work. Every ``every`` lane groups, one line per N and R."""
+
+        ov = dict(self._lane_overlap or {})
+        n = len(rows)
+        for r, win in zip(rows, self._pev or ()):
+            ov[(n, r)] = [*ov.get((n, r), ()), *((send.elapsed_time(w1), w0.elapsed_time(w1)) for send, w0, w1 in win)]
+        self._lane_overlap = ov
