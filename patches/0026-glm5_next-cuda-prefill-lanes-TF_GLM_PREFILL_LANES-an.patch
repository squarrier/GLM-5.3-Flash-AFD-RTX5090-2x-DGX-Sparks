+# -- the engine: the fake model at world 1 ---------------------------------------------------------------------------
+def _world1(env, monkeypatch, *, lanes, group=False, shared=False, prompts=(), streams=2):
+    """tests/test_glm_prefill_pairs.py's world 1 with TF_GLM_PREFILL_LANES (None: unset, the pairs off); every group
+    checked: no stream decoding, no sliced chunk suspended, at most ``lanes`` chunks, only the last ending prompts."""
+
+    from tests import test_glm_multi_afd as ta
+
+    monkeypatch.delenv(PAIRS, raising=False)
+    for name, on in (("TF_GLM_MULTI_PREFILL", group), ("TF_GLM_SHARED_PREFIX", shared)):
+        if on:
+            monkeypatch.setenv(name, "1")
+        else:
+            monkeypatch.delenv(name, raising=False)
+    if lanes is None:
+        monkeypatch.delenv(LANES, raising=False)
+    else:
+        monkeypatch.setenv(LANES, str(lanes))
+    n1 = ta.World1(env, streams=streams)
+    d = n1.d
+    assert d.n_lanes == (lanes or 1) and d.pairs == ((lanes or 1) >= 2)
+    groups, real = [], d._fill_pair
+
+    def checked(*plans):
+        assert d.partial is None and not any(x.decoding and not x.s.done for x in d.lanes.values())
+        assert 2 <= len(plans) <= d.n_lanes
+        assert all(stop < len(x.s.prompt) for plan in plans[:-1] for x, stop in plan)
+        groups.append([[(x.sid, stop) for x, stop in plan] for plan in plans])
+        return real(*plans)
+
+    d._fill_pair = checked
+    reqs = [(tm._prompt(n, seed), 12, tm._sampling(kind, seed)) for n, seed, kind in prompts]
+    out = [n1.submit(pr, cnt, sp) for pr, cnt, sp in reqs]
+    n1.run()
+    return n1, out, reqs, groups
+
