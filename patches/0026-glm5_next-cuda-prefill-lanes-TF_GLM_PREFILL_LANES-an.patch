+    e = SimpleNamespace(w=SimpleNamespace(afd=SimpleNamespace(depth=1)))
+    pp._forward_pair(e, *[pp.Chunk([None], k) for k in (0, 1)])
+    old_marks, old_log = [], []
+    steps = _stand_in(kinds, old_log)
+    _old_pair_schedule([steps(e, pp.Chunk([None], k)) for k in (0, 1)], old_marks.append)
+    assert marks == old_marks and log == old_log
