+@pytest.mark.parametrize("prompts", tp.LENGTHS, ids=["1-chunk", "2-chunks", "3-chunks", "5-chunks", "64+1", "128+38"])
+def test_a_cold_prompt_alone_in_lanes(afd_fake, monkeypatch, prompts):
+    """A cold prompt alone with 3 and 4 lanes vs pairs vs the setting off (64-row chunks): the same reply (its solo
+    reply), cached count and kept states with their pool rows; lanes run where the prompt has three chunks before
+    its last chunk's start."""
+
+    n0, s0, reqs, _ = _world1(afd_fake, monkeypatch, lanes=None, prompts=prompts)
+    runs = {k: _world1(afd_fake, monkeypatch, lanes=k, prompts=prompts) for k in (2, 3, 4)}
+    chunks = len([c for c in n0.wire.calls if c[0] == "chunk"])
+    for k, (n1, s1, _, groups) in runs.items():
+        for s, (pr, cnt, sp) in zip(s1, reqs):
+            assert s.got == tm.solo(afd_fake.torch, pr, cnt, sp)
+        assert [s.got for s in s0] == [s.got for s in s1] and [s.cached for s in s0] == [s.cached for s in s1]
+        assert tp.hp.kept_view(n0.d) == tp.hp.kept_view(n1.d), k
+        assert n1.wire.pairs() == n0.wire.pairs()        # the same forwards (begin, then chunk) in the same order
+        big = [g for g in groups if len(g) >= 3]
+        assert n1.d.laned["groups"] == len(big) == len(getattr(n1.wire, "laned", ()))
+        assert n1.d.paired["pairs"] == len(groups) - len(big) == len(getattr(n1.wire, "paired", ()))
+        assert sum(len(g) for g in groups) <= chunks and (k < 3 or not big or max(len(g) for g in big) <= k)
+    assert runs[4][0].d.laned["groups"] > 0 if chunks >= 4 else True
+
