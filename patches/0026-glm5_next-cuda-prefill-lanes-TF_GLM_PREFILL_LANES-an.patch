+# -- the schedule ----------------------------------------------------------------------------------------------------
+def _old_pair_schedule(gens, mark):
+    """The pairs' ``prefill_pairs._forward_pair`` as it was before the lanes, verbatim but for its arguments: the
+    pair oracle."""
+
+    from tensorfold.families.glm5_next.cuda.prefill_pairs import DONE, SEND, WAIT
+
+    at = [None, None]
+    end = object()
+    owner = None
+
+    def step(k):
+        mark(k)
+        try:
+            return next(gens[k])
+        except StopIteration:
+            return end
+
+    k = 0
+    at[0] = step(0)
+    while at[0] is not end or at[1] is not end:
+        here, there = at[k], at[1 - k]
+        if here is end:
+            k = 1 - k
+            if at[k] is None:
+                at[k] = step(k)
+            continue
+        if here is SEND:
+            if owner is None:
+                owner = k
+                at[k] = step(k)
+            else:
+                k = 1 - k
+                if at[k] is None:
+                    at[k] = step(k)
+            continue
+        if here is WAIT:
+            if there is None or there is DONE:
+                k = 1 - k
+                at[k] = step(k)
+            else:
+                at[k] = step(k)
+                if at[k] is DONE:
+                    owner = None
+            continue
+        if here is DONE:
+            owner = None
+            if there is SEND:
+                k = 1 - k
+                owner = k
+                at[k] = step(k)
+            else:
+                at[k] = step(k)
+            continue
+        raise AssertionError(here)
+
+
+def _stand_in(kinds, log):
+    """A chunk's layer loop as ``_steps`` stops it: per layer its attention ("a"), at a MoE layer its route, SEND,
+    the exchange ("x"), WAIT, the collect ("c"), DONE, then hc_post ("h"); then its tail ("t")."""
+
+    from tensorfold.families.glm5_next.cuda.prefill_pairs import DONE, SEND, WAIT
+
+    def steps(e, ch):
+        k = ch.slot
+        for i, kind in enumerate(kinds):
+            log.append(("a", k, i))
+            if kind == "moe":
+                yield SEND
+                log.append(("x", k, i))
+                yield WAIT
+                log.append(("c", k, i))
+                yield DONE
+            log.append(("h", k, i))
+        log.append(("t", k, None))
+    return steps
+
