+"""TF_GLM_WIRE_FP8 (``wire_fp8``) on CPU: the MoE exchanges' FFN input rows as FP8 E4M3 wire rows with one UE8M0 scale
+per 32 values, glm53f-afd's wire-out quantizer (hughmadden/glm53f-afd @ 91db3cc, ``Fp8E4m3Ue8m0K32``).
+
+- The setting, the handshake, the row and request sizes (and the bytes saved per layer at 2,048 rows).
+- The codec against plain-Python references written from glm53f-afd's device kernels: every code's value and back,
+  the ties (to the larger magnitude), saturation, NaN and zeros; the scale bytes; whole rows of random, tied, tiny,
+  huge, zero, NaN and infinite values, bit for bit; the decode exact; the round trip's error bound; encoding the
+  decoded rows again changes nothing.
+- The wire: the real ``AfdWire`` + ``McdmaTransport`` and both expert loops over the fake mcdma-rpcd pair, CPU- and
+  GPU-driven: with the setting on, the experts compute with exactly the decoded rows (plain forwards, a pair and
+  lanes), each request carries the FP8 layout's bytes; TF_AFD_CHECK hashes the decoded rows on both sides (0
+  mismatches); an expert without ``wire_fp8`` refuses the settings.
+"""
+
+from __future__ import annotations
+
+import itertools
+import math
+import struct
+from types import SimpleNamespace
+
+import pytest
+
+from tests import test_glm_prefill_lanes as tl
+from tests import test_glm_prefill_pairs as tp
+from tests.glm_afd_fakes import (  # noqa: F401
+    LAYERS,
+    PREFILL,
+    D,
+    S,
+    daemon_fixture,
+    env_fixture,
+    libpath_fixture,
+    master_fixture,
+    partial,
+    wait_attached,
+    words_fixture,
+)
+
+pytestmark = pytest.mark.torch
+ENV = "TF_GLM_WIRE_FP8"
+
+
+def _w():
+    from tensorfold.families.glm5_next.cuda import wire_fp8
+
+    return wire_fp8
+
+
+def _bf16(v: float) -> float:
+    """The bf16 value nearest ``v`` (round to nearest even), as torch rounds."""
+
+    import torch
+
+    return float(torch.tensor([v], dtype=torch.float32).to(torch.bfloat16).float()[0])
+
+
+# -- the setting -----------------------------------------------------------------------------------------------------
+def test_the_setting_the_handshake_and_the_sizes(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import afd, mcdma
+
+    w = _w()
+    monkeypatch.delenv(ENV, raising=False)
+    assert not w.enabled() and not w.enabled("0") and w.enabled("1") and w.enabled(" 1 ")
+    for bad in ("2", "on", "fp8", "true"):
+        with pytest.raises(ValueError, match=ENV):
+            w.enabled(bad)
+    cfg = SimpleNamespace(mlp_kinds=["dense"] * 3 + ["moe"] * 4, quant="exl3", experts=16, top_k=8)
+    plain = afd.settings_for("/nonexistent", cfg, prefill_rows=2048)
+    fp8 = afd.settings_for("/nonexistent", cfg, prefill_rows=2048, wire_fp8=True)
+    assert "wire_fp8" not in plain and fp8 == dict(plain, wire_fp8=1)
+    assert afd.settings_mismatch(plain, fp8) == "wire_fp8: attention 1 != expert None"   # an older expert refuses
+    assert w.row_bytes(4096) == 4224 and w.row_bytes(64) == 66
+    with pytest.raises(ValueError):
+        w.row_bytes(100)
+    # GLM-5.3-Flash at 2,048 rows: hidden 4,096, top-k 8 + the shared slot. Each request (one per expert link per MoE
+    # layer) carries 16 MiB of bf16 rows today, 8.25 MiB of FP8 rows and scales with the setting on
+    bf, f8 = mcdma.Layout(4096, 9), mcdma.Layout(4096, 9, fp8=True)
+    assert bf.req(2048) == 256 + 2048 * 4096 * 2 + 2048 * 36 + 2048 * 36 == 16_924_928
+    assert f8.req(2048) == 256 + 2048 * 4096 + 2048 * 128 + 2048 * 36 + 2048 * 36 == 8_798_464
+    assert bf.req(2048) - f8.req(2048) == 8_126_464                    # 7.75 MiB less per request, x2 links per layer
+    assert f8.rep(2048) == bf.rep(2048) == 2048 * 4096 * 4               # the replies are unchanged
+    for rows in (1, 7, 48, 2048):
+        n, p, wt, end = f8.offsets(rows)
+        assert n == mcdma.HDR_BYTES and p % 256 == 0 and wt % 256 == 0 and end == f8.req(rows)
+        assert p - n == rows * 4096 + rows * 128 + f8.scales_pad(rows) and (rows * 128 + f8.scales_pad(rows)) % 256 == 0
+
+
+# -- the codec -------------------------------------------------------------------------------------------------------
+def test_every_code_decodes_and_encodes_back():
+    w = _w()
+    for c in range(256):
+        v = w.reference_decode(c)
+        if c in (0x7F, 0xFF):
+            assert math.isnan(v)
+            continue
+        if c == 0x80:                                    # -0.0: the kernel's ``x < 0`` is false, code 0
+            assert v == 0.0 and w.reference_code(v) == 0
+            continue
+        assert w.reference_code(v) == c, (hex(c), v)
+    assert w.reference_decode(0x7E) == 448.0 and w.reference_decode(0x01) == 2.0 ** -9
+    assert w.reference_decode(0x08) == 2.0 ** -6 and w.reference_decode(0xFE) == -448.0
+
+
+def test_ties_go_to_the_larger_magnitude_and_saturation():
+    w = _w()
+    mags = sorted({w.reference_decode(c) for c in range(0x7F)})
+    for lo, hi in itertools.pairwise(mags):
+        mid = (lo + hi) / 2
+        assert w.reference_code(mid) == w.reference_code(hi), (lo, hi)                # a tie: the larger
+        assert w.reference_code(-mid) == 0x80 | w.reference_code(hi)
+        below = math.nextafter(mid, 0.0)
+        assert w.reference_code(below) == w.reference_code(lo) if lo else w.reference_code(below) in (0, 1)
+    assert w.reference_code(448.0) == w.reference_code(1e30) == w.reference_code(math.inf) == 0x7E
+    assert w.reference_code(-1e30) == 0xFE and w.reference_code(math.nan) == 0
+    assert w.reference_code(2.0 ** -11) == 0 and w.reference_code(-(2.0 ** -11)) == 0x80   # the sign kept on a zero code
+
+
+def test_the_scale_bytes():
+    w = _w()
+    assert w.reference_scale([0.0] * 32) == 0
+    assert w.reference_scale([448.0] + [0.0] * 31) == 127                          # 448 needs 2^0
+    assert w.reference_scale([448.5] + [0.0] * 31) == 128
+    assert w.reference_scale([1.0] * 32) == 127 - 8                                # 1 / 448 -> 2^-8
+    assert w.reference_scale([math.nan] * 31 + [3.0]) == w.reference_scale([0.0] * 31 + [3.0])   # NaN skipped
+    assert w.reference_scale([math.inf] + [0.0] * 31) == 254
+    assert w.reference_scale([1e-38] + [0.0] * 31) == 0                            # clamped
+
+
+def _rows(torch, gen, r, d):
+    """bf16 rows with every kind of block: gaussian at scales 2^-20 .. 2^20, all zeros, one value, NaN, +-inf, the
+    tiniest and the largest bf16 values, exact E4M3 ties after scaling, values spanning 2^40 inside one block."""
+
+    x = torch.randn((r, d), generator=gen) * torch.exp2(torch.randint(-20, 21, (r, d // 32, 1), generator=gen)
+                                                         .float()).repeat_interleave(32, dim=1).view(r, d)
+    x = x.to(torch.bfloat16)
+    x[0, :32] = 0.0
+    x[0, 32:64] = 0.0
+    x[0, 40] = -3.5
+    x[1, :32] = torch.tensor([math.nan, 1.0] * 16)
+    x[1, 32:64] = torch.tensor([math.inf, -math.inf] + [0.5] * 30)
+    x[2, :32] = 2.0 ** -133                               # bf16's smallest subnormal
+    x[2, 32:64] = torch.tensor([3.3895313892515355e38, -1.0] + [2.0 ** -100] * 30)
+    # ties: 448 and the midpoint between two codes, (1 + 1/16) and (1 + 3/16) at scale 2^0 after the block's 448
+    x[3, :32] = torch.tensor([448.0, 1.0625, 1.1875, -1.0625, 2.0 ** -10, -(2.0 ** -10), 3 * 2.0 ** -11, 0.0] * 4)
+    x[3, 32:64] = torch.tensor([2.0 ** 20, 2.0 ** -20] * 16)
+    return x
+
+
+def test_rows_encode_bit_for_bit_as_the_reference():
+    import torch
+
+    w = _w()
+    gen = torch.Generator().manual_seed(31)
+    r, d = 37, 128
+    x = _rows(torch, gen, r, d)
+    payload = torch.empty((r, d), dtype=torch.uint8)
+    scales = torch.empty((r, d // 32), dtype=torch.uint8)
+    w.encode(x, payload, scales)
+    for i in range(r):
+        codes, sc = w.reference_row(x[i].float().tolist())
+        assert bytes(payload[i].tolist()) == codes, i
+        assert bytes(scales[i].tolist()) == sc, i
+    w._ROWS, keep = 5, w._ROWS                           # several passes: the same bytes
+    try:
+        p2, s2 = torch.empty_like(payload), torch.empty_like(scales)
+        w.encode(x, p2, s2)
+    finally:
+        w._ROWS = keep
+    assert torch.equal(p2, payload) and torch.equal(s2, scales)
+    assert payload[3, :4].tolist() == [0x7E, 0x39, 0x3A, 0xB9]       # 448, 1.0625 -> 1.125, 1.1875 -> 1.25, -1.125
+
+
+def test_the_table_is_the_reference_on_every_bf16_magnitude():
+    import torch
+
+    w = _w()
+    t = w._table("cpu")
+    assert t.shape == (32768,) and t.dtype == torch.uint8
+    for b in list(range(0, 32768, 97)) + [0x0000, 0x3A80, 0x43E0, 0x43E1, 0x7F80, 0x7FC0]:
+        v = struct.unpack("<f", struct.pack("<I", b << 16))[0]
+        assert t[b] == w.reference_code(v), hex(b)
+
+
+def test_the_decode_is_exact_and_the_error_bound():
+    import torch
+
+    w = _w()
+    gen = torch.Generator().manual_seed(32)
+    r, d = 64, 256
+    x = (torch.randn((r, d), generator=gen) * torch.exp2(torch.randint(-12, 13, (r, 1), generator=gen).float()))
+    x = x.to(torch.bfloat16)
+    payload = torch.empty((r, d), dtype=torch.uint8)
+    scales = torch.empty((r, d // 32), dtype=torch.uint8)
+    w.encode(x, payload, scales)
+    y = w.decode(payload, scales, torch.empty_like(x))
+    want = torch.tensor([[_bf16(w.reference_decode(int(c)) * 2.0 ** (int(scales[i, j // 32]) - 127))
+                          for j, c in enumerate(payload[i].tolist())] for i in range(r)], dtype=torch.float32)
+    assert torch.equal(y.float(), want)                  # exact: e4m3 x 2^k, one rounding to bf16 at most
+    # the bound: half a step of E4M3's three mantissa bits (2^-4 relative), or half its smallest subnormal step
+    # (2^-10 at the block's scale) below 2^-6
+    s = torch.exp2(scales.float() - 127).repeat_interleave(32, dim=1)
+    err = (y.float() - x.float()).abs()
+    assert bool((err <= torch.maximum(x.float().abs() * 2.0 ** -4, s * 2.0 ** -10)).all())
+    rel = (err / x.float().abs().clamp_min(1e-30))[x.float().abs() >= s * 2.0 ** -6]
+    assert float(rel.max()) <= 2.0 ** -4 and float(rel.mean()) < 0.025
+    assert torch.equal(w.roundtrip(y), y)                # the decoded rows encode to themselves
+
+
+def test_the_bf16_decode_equals_the_fp32_path():
+    """``decode`` multiplies in bf16 (torch: fp32 math, one rounding); the same as the exact fp32 product rounded."""
+
+    import torch
+
+    w = _w()
+    gen = torch.Generator().manual_seed(33)
+    payload = torch.randint(0, 256, (16, 64), generator=gen, dtype=torch.int32)
+    payload[(payload == 0x7F) | (payload == 0xFF)] = 0x7E
+    payload = payload.to(torch.uint8)
+    scales = torch.randint(0, 255, (16, 2), generator=gen, dtype=torch.int32).to(torch.uint8)
+    y = w.decode(payload, scales, torch.empty((16, 64), dtype=torch.bfloat16))
+    lut = torch.tensor([w.reference_decode(c) if c not in (0x7F, 0xFF) else 0.0 for c in range(256)])
+    f32 = lut[payload.long()] * torch.exp2(scales.float() - 127).repeat_interleave(32, dim=1)
+    assert torch.equal(y, f32.to(torch.bfloat16))
+
