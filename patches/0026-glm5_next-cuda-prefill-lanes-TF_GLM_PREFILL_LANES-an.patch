+# -- the forward seam: recorded kernels -----------------------------------------------------------------------------
+def _seam(monkeypatch, n):
+    """tests/test_glm_prefill_pairs.py's seam plus lanes 1 .. n - 1's own buffers (``lane_buffers``), named l<k>.*."""
+
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    s = tp._seam(monkeypatch)
+    rec = s.rec
+    s.w.afd.begin_lanes = rec.fn("afd.begin_lanes")
+    lanes = []
+    for k in range(1, n):
+        lb = pp.lane_buffers(s.b)
+        for name in pp.SLOT_FIELDS + pp.ROUTED_FIELDS:
+            rec.register(f"l{k}." + name, getattr(lb, name))
+        for i, t in enumerate(lb.taps):
+            rec.register(f"l{k}.tap{i}", t)
+        rec.aliases[id(lb)] = f"L{k}"
+        lanes.append(lb)
+    s.lanes = lanes
+    return s
+
+
+def _canon(x):
+    if isinstance(x, str):
+        x = re.sub(r"^l\d\.", "b.", x).replace(".pos_dev@", ".pos_dev")
+        return "B" if re.fullmatch(r"L\d", x) else x
+    if isinstance(x, tuple):
+        return tuple(_canon(v) for v in x)
+    return x
+
+
+def _engine(s, st=None):
+    torch = s.torch
+    return SimpleNamespace(w=s.w, st=st, pbuf=s.b, pbuf_lanes=list(s.lanes), prefill_rows=64, last_hidden=None,
+                           tap_rows=lambda k, bb: torch.cat([t[:k] for t in bb.taps], dim=1))
+
+
+def _by_lane(calls, n) -> list:
+    out, k = [[] for _ in range(n)], 0
+    for c in calls:
+        if c[0] == "slot":
+            k = c[1]
+        elif tp._kernel(c):
+            out[k].append(_canon(c))
+    return out
+
