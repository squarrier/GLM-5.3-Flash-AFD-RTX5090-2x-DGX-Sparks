+// ---- decode windows (TF_GLM_EXL3_DEC / _FUSE / _XROW / _LOADS): adapted from MiaAI-Lab recipe patch 0016's
+// dec_kernel and 0047's trellis loads, written for her dedicated GLM kernel, onto this file's grouping (an item is an
+// (expert, 16-member tile) with the expert's own trellis pointer) for GLM's 4-bit mcg experts at (8 n tiles, 4 warps,
+// 16 k steps a warp: gate/up K 4096 in 4 splits, down K 1024 in 1). Every mma chain and warp sum is
+// grouped_kernel<1, 8, 4, 1, 8, 8>'s: a warp runs k tiles kt0 .. kt0 + 15 of its split in order from zero, the warps
+// are added in warp order. What changes:
+//   FUSE 1 (the down projection, one split): the block's 128 columns are one Hadamard block, so it applies
+//          down_epilogue_kernel's arithmetic (0 + the split's sum, rotated, times svh_d) to its own sums and writes Y:
+//          no Z round trip, no epilogue launch. FUSE 0 writes Z as grouped_kernel does;
+//   XROW:  X holds one rotated row a token (rot_rows: a layer whose experts share one gate/up suh), so pair
+//          row * slots + slot reads X row `row` (grouped_kernel's XROW);
+//   LD (data movement only): 0: warp_tiles' 32-bit words one k step ahead, with the next step's A fragments;
+//          1: 16-byte ld.global.nc.L1::no_allocate loads of PD k steps' words (lane l: bytes 16 l .. of each 512 B
+//          of a step, NT / 4 loads a lane), the first PD issued before the member rows reach shared memory, staged
+//          through the warp's slice of `red` (two __syncwarp a step) and read back as word `lane` of each tile; the
+//          count and the expert id are read together (0047, which MiaAI-Lab adapted from patch 0580 of
+//          jayleaton/glm53-tensorfold-spark, Apache-2.0, Copyright 2026 Jay Leaton).
+__device__ __forceinline__ uint4 ldg_nc_v4(const uint32_t* p) {
+    uint4 v;
+    asm volatile("ld.global.nc.L1::no_allocate.v4.u32 {%0,%1,%2,%3}, [%4];"
+                 : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w)
+                 : "l"(p));
+    return v;
+}
+
+template <int FUSE, bool XROW, int LD, int PD>
+__global__ void __launch_bounds__(128) dec_kernel(
+    const half* __restrict__ X0, const half* __restrict__ X1, const int64_t* __restrict__ TP0,
+    const int64_t* __restrict__ TP1, const int* __restrict__ uids, const int* __restrict__ ucount,
+    const int* __restrict__ members, float* __restrict__ Z, const half* __restrict__ svh, float* __restrict__ y,
+    int K, int N, int P, int SK, int maxm, int slots) {
+    constexpr int NT = 8, W = 4, STEPS = 16, NV = NT / 4;
+    static_assert(LD == 0 || (LD == 1 && PD >= 1 && STEPS % PD == 0), "LD 1: PD divides the k steps");
+    const int u = blockIdx.x;
+    int e;
+    if constexpr (LD == 0) {
+        if (u >= ucount[0]) return;
+        e = uids[u];
+    } else {                                             // one round trip: uids holds grid.x entries
+        const int total = ucount[0];
+        e = uids[u];
+        if (u >= total) return;
+    }
+    const int MT = (maxm + 15) / 16;
+    const int mtile = blockIdx.z % MT, split = (blockIdx.z / MT) % SK, mat = blockIdx.z / MT / SK;
+    const half* X = mat ? X1 : X0;
+    const uint32_t* T = reinterpret_cast<const uint32_t*>(mat ? TP1[e] : TP0[e]);
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int g = lane >> 2, t = lane & 3;
+    const int KT = K >> 4, NTILES = N >> 4;
+    const int kt0 = split * (KT / SK) + warp * STEPS;    // grouped_kernel's split * per_split + warp * per_warp
+    const int nt0 = blockIdx.y * NT;
+
+    __shared__ int rows_sh[16];
+    __shared__ __align__(16) float red[W][16][NT * 16];
+    const uint32_t* tbase = T + ((size_t)kt0 * NTILES + nt0) * 32;   // 32 words a 4-bit tile
+    const size_t kstep = (size_t)NTILES * 32;                         // words from one k tile to the next
+    uint4 rv[LD == 1 ? PD : 1][NV];
+    if constexpr (LD == 1) {
+#pragma unroll
+        for (int d = 0; d < PD; ++d)
+#pragma unroll
+            for (int v = 0; v < NV; ++v) rv[d][v] = ldg_nc_v4(tbase + d * kstep + 128 * v + 4 * lane);
+    }
+    if (threadIdx.x < 16) {
+        const int m = mtile * 16 + threadIdx.x;
+        const int code = m < maxm ? members[u * maxm + m] : -1;
+        rows_sh[threadIdx.x] = code >= 0 ? (code >> 5) * slots + (code & 31) : -1;
+    }
+    __syncthreads();
+    if (rows_sh[0] < 0) return;                           // members come first, so this tile is empty
+    const int r0 = rows_sh[g], r1 = rows_sh[g + 8];
+    const half* x0 = X + (size_t)(r0 < 0 ? 0 : (XROW ? r0 / slots : r0)) * K + 2 * t;
+    const half* x1 = X + (size_t)(r1 < 0 ? 0 : (XROW ? r1 / slots : r1)) * K + 2 * t;
+
+    float acc[NT][2][4];
+#pragma unroll
+    for (int i = 0; i < NT; ++i)
+#pragma unroll
+        for (int h = 0; h < 2; ++h)
+#pragma unroll
+            for (int c = 0; c < 4; ++c) acc[i][h][c] = 0.f;
+
+    if constexpr (LD == 1) {
+        const tf_exl3x::LaneMap<8> map(lane);
+        uint32_t ra[PD][4];
+#pragma unroll
+        for (int d = 0; d < PD; ++d) {
+            const int k = (kt0 + d) * 16;
+            ra[d][0] = tf_exl3x::load_pair(x0 + k, r0 >= 0); ra[d][1] = tf_exl3x::load_pair(x1 + k, r1 >= 0);
+            ra[d][2] = tf_exl3x::load_pair(x0 + k + 8, r0 >= 0); ra[d][3] = tf_exl3x::load_pair(x1 + k + 8, r1 >= 0);
+        }
+        uint32_t* stage = reinterpret_cast<uint32_t*>(&red[warp][0][0]);
+        for (int kb = 0; kb < STEPS; kb += PD) {
+#pragma unroll
+            for (int d = 0; d < PD; ++d) {
+                const int s = kb + d;
+                const bool more = s + PD < STEPS;
+                uint32_t a[4], words[NT];
+#pragma unroll
+                for (int c = 0; c < 4; ++c) a[c] = ra[d][c];
+                __syncwarp();                            // every lane has read the previous step back
+#pragma unroll
+                for (int v = 0; v < NV; ++v) *reinterpret_cast<uint4*>(stage + 128 * v + 4 * lane) = rv[d][v];
+                if (more) {                              // the slot's registers are free again
+#pragma unroll
+                    for (int v = 0; v < NV; ++v)
+                        rv[d][v] = ldg_nc_v4(tbase + (size_t)(s + PD) * kstep + 128 * v + 4 * lane);
+                    const int k = (kt0 + s + PD) * 16;
+                    ra[d][0] = tf_exl3x::load_pair(x0 + k, r0 >= 0); ra[d][1] = tf_exl3x::load_pair(x1 + k, r1 >= 0);
+                    ra[d][2] = tf_exl3x::load_pair(x0 + k + 8, r0 >= 0);
+                    ra[d][3] = tf_exl3x::load_pair(x1 + k + 8, r1 >= 0);
+                }
+                __syncwarp();
+#pragma unroll
+                for (int i = 0; i < NT; ++i) words[i] = stage[i * 32 + lane];
+#pragma unroll
+                for (int i = 0; i < NT; ++i) {
+                    const uint32_t w1[1] = {words[i]};
+                    uint32_t b0[2], b1[2];
+                    tf_exl3x::decode_tile<1, 8>(w1, map, lane, b0, b1);
+                    tf_exl3x::mma16816(acc[i][0], a, b0);
+                    tf_exl3x::mma16816(acc[i][1], a, b1);
+                }
+            }
+        }
+        __syncwarp();                                    // the staging area becomes red[warp] below
+    } else {
+        tf_exl3x::warp_tiles<1, 8, NT, 1, true>(T, NTILES, kt0, STEPS, nt0, x0, x1, r0 >= 0, r1 >= 0, lane, acc);
+    }
+
+#pragma unroll
+    for (int i = 0; i < NT; ++i)
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            const int col = i * 16 + h * 8 + 2 * t;
+            red[warp][g][col] = acc[i][h][0];
+            red[warp][g][col + 1] = acc[i][h][1];
+            red[warp][g + 8][col] = acc[i][h][2];
+            red[warp][g + 8][col + 1] = acc[i][h][3];
+        }
+    __syncthreads();
+
+    if constexpr (FUSE == 1) {
+        // down_epilogue_kernel on this block's sums: v = 0 + (the warps' sums in warp order), rotated, times svh_d
+        for (int i = warp; i < 16; i += W) {
+            const int p = rows_sh[i];
+            if (p < 0) break;                            // members come first (uniform across the warp)
+            const int n = nt0 * 16 + 4 * lane;
+            float v[4];
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                float s = red[0][i][4 * lane + j];
+#pragma unroll
+                for (int w = 1; w < W; ++w) s += red[w][i][4 * lane + j];
+                float z = 0.f;
+                z += s;
+                v[j] = z;
+            }
+            fwht128(v, lane);
+            float* o = y + (size_t)p * N + n;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) o[j] = v[j] * HAD_SCALE * __half2float(svh[(size_t)e * N + n + j]);
+        }
+    } else {
+        for (int idx = threadIdx.x; idx < 16 * NT * 16; idx += W * 32) {
+            const int row = idx / (NT * 16), col = idx % (NT * 16);
+            const int r = rows_sh[row];
+            if (r < 0) continue;
+            float s = red[0][row][col];
+#pragma unroll
+            for (int w = 1; w < W; ++w) s += red[w][row][col];
+            Z[(((size_t)mat * SK + split) * P + r) * N + nt0 * 16 + col] = s;
+        }
+    }
+}
