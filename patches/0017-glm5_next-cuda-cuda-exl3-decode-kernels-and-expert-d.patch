+// Decode windows (TF_GLM_EXL3_DEC; MiaAI-Lab recipe patches 0016 and 0047): the grouped sums of 4-bit mcg experts at
+// 16 k steps a warp; fuse 1 writes Y (the down projection's epilogue fused), ld 1..3 the 16-byte trellis loads.
+void dec(const at::Tensor& X0, const at::Tensor& X1, const at::Tensor& TP0, const at::Tensor& TP1,
+         const at::Tensor& uids, const at::Tensor& ucount, const at::Tensor& members, at::Tensor Z,
+         const at::Tensor& svh, at::Tensor y, int64_t mats, int64_t K, int64_t N, int64_t P, int64_t SK,
+         int64_t slots, int64_t fuse, bool xrow, int64_t ld) {
+    check(X0, at::kHalf, "X0");
+    check(X1, at::kHalf, "X1");
+    check(TP0, at::kLong, "TP0");
+    check(TP1, at::kLong, "TP1");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(Z, at::kFloat, "Z");
+    check(svh, at::kHalf, "svh");
+    check(y, at::kFloat, "y");
+    TORCH_CHECK(members.dim() == 2 && members.size(0) == uids.size(0), "members: [uids, maxm]");
+    TORCH_CHECK(X0.dim() == 2 && X0.size(1) == K && X1.dim() == 2 && X1.size(1) == K, "X: K columns");
+    TORCH_CHECK(slots >= 1 && slots <= 32, "1 to 32 slots a row");
+    TORCH_CHECK(fuse == 1 || Z.numel() >= mats * SK * P * N, "Z too small");
+    TORCH_CHECK(fuse != 1 || (y.numel() >= P * N && svh.dim() == 2 && svh.size(1) == N), "dec: Y fp32 [P, N], svh [E, N]");
+    c10::cuda::CUDAGuard guard(X0.device());
+    exl3x_dec_cuda(X0, X1, TP0, TP1, uids, ucount, members, Z, svh, y, mats, K, N, P, SK, slots, fuse, xrow, ld);
+}
