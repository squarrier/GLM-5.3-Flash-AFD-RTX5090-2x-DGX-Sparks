+@pytest.mark.parametrize("pd", [1, 2, 4])
+def test_load_ring_model(pd):
+    """0047's ring (dec_kernel, LD 1): step s multiplies the words and A fragments loaded for step s, and the 16-byte
+    staging hands lane l word l of each tile (a model of the index arithmetic, 8 n tiles, 16 k steps)."""
+    steps, nt, nv = 16, 8, 2
+    rv = {d: d for d in range(pd)}                    # slot d holds the step it was loaded for
+    used = []
+    for kb in range(0, steps, pd):
+        for d in range(pd):
+            s = kb + d
+            used.append(rv[d])
+            if s + pd < steps:
+                rv[d] = s + pd
+    assert used == list(range(steps))
+    words = {}                                        # staging offset -> the word offset (from the tile base) put there
+    for lane in range(32):                            # all lanes store, then each reads word `lane` of tile i
+        for v in range(nv):
+            for j in range(4):
+                words[128 * v + 4 * lane + j] = 128 * v + 4 * lane + j
+    for lane in range(32):
+        assert [words[i * 32 + lane] for i in range(nt)] == [i * 32 + lane for i in range(nt)]
