+def test_rings_mtp_drafts_and_kept_prompts(fake, rings):
+    tm.test_mtp_drafts_need_kept_prompts_with_the_heads_rows(fake)
+
+
+# -- the AFD attention node at world 1, batched verify windows (tests/test_glm_multi_afd.py's scenarios) -------------
+
+@pytest.mark.parametrize("streams", [2, 4])
+def test_rings_world1_staggered_requests_equal_their_solo_replies(afd_fake, rings, streams):
+    ta.test_world1_staggered_requests_equal_their_solo_replies(afd_fake, streams)
+
+
+def test_rings_world1_cancel_pause_give_back_and_resume(afd_fake, rings):
+    ta.test_world1_cancel_pause_give_back_and_resume(afd_fake)
+
+
+def test_rings_world1_scheduler_burst(afd_fake, rings):
+    ta.test_world1_scheduler_burst(afd_fake)
+
+
+def test_rings_world1_prompt_rows_cross_in_fill_chunks(afd_fake, rings):
+    ta.test_prompt_rows_cross_in_fill_chunks(afd_fake, afd_fake.monkeypatch)
+
+
+def test_world1_spans_name_each_slots_ring(afd_fake, rings):
+    """BatchedVerify's segments carry each stream's ring base (verify._span) at world 1."""
+
+    w1 = ta.World1(afd_fake, streams=4)
+    seen = []
+    w1.verify.seg_rows.set = lambda spans, sparse_from=None: seen.append(list(spans))
+    for k in range(3):
+        w1.submit(tm._prompt(90 + 7 * k, 40 + k), 24)
+    w1.run()
+    assert seen and all(len(s) == 4 for spans in seen for s in spans)
+    assert {s[3] for spans in seen for s in spans} >= {0, RING}          # more than one slot's ring
+    assert all(s[3] % RING == 0 for spans in seen for s in spans)
+
+
+# -- the fake is ring-sensitive: the glue's absence fails the scenarios ------------------------------------------------
+
+def _moved_mid_pool(torch) -> None:
+    """One stream moved from slot 0 to slot 1 between two rounds while a pool is still filling (pos % 4 != 0), both
+    ranks; it decodes on in slot 1 and must still give its solo reply."""
+
+    p = tm.Pair(torch, streams=2, blocks=4)
+    prompt = tm._prompt(150, 90)
+    s = p.submit(prompt, 60, None, stop_eos=False)
+    moved = False
+    while p.d[0].lanes:
+        p.step()
+        lane = p.d[0].lanes.get(s.sid)
+        if not moved and lane is not None and lane.decoding and lane.slot == 0 and lane.st.pos % 4:
+            for d in p.d:
+                d._reslot(d.lanes[s.sid], 1)
+            moved = True
+    assert moved
+    assert s.got == tm.solo(torch, prompt, 60, None, stop_eos=False)
+
+
+def test_rings_a_stream_moved_mid_pool_keeps_its_rows(fake, rings):
+    _moved_mid_pool(fake)
+
+
+def test_mutation_slot_moves_without_ring_rows_fail(fake, rings):
+    """multi._reslot without its ring copy (the recipe's 0038 as written: the rows stay in the old slot's ring)."""
+
+    multi = importlib.import_module("tensorfold.families.glm5_next.cuda.multi")
+    orig = multi.MultiDecoder._reslot
+
+    def left_behind(self, lane, slot):
+        c = self.e.caches
+        r1 = c.ring_base(slot)
+        saved = [(ik[r1:r1 + c.ring].clone(), ig[r1:r1 + c.ring].clone()) for ik, ig in c.rings]
+        orig(self, lane, slot)
+        for (ik, ig), (a, b) in zip(c.rings, saved):        # undo the copy: the new slot's stale rows
+            ik[r1:r1 + c.ring].copy_(a)
+            ig[r1:r1 + c.ring].copy_(b)
+
+    rings.setattr(multi.MultiDecoder, "_reslot", left_behind)
+    with pytest.raises(AssertionError):
+        _moved_mid_pool(fake)
+
+
+def test_mutation_kept_prompts_without_their_tails_fail(fake, rings):
+    """Kept prompts resumed without their ring tails (decode.put_ring_tail a no-op)."""
+
+    decode = importlib.import_module("tensorfold.families.glm5_next.cuda.decode")
+    rings.setattr(decode, "put_ring_tail", lambda st, snap: None)
+    failed = 0
+    for policy, mtp in (("f3", False), ("2", True)):
+        try:
+            tm.test_resumes_take_kept_extents_over_or_copy_them(fake, policy, mtp)
+        except AssertionError:
+            failed += 1
+    try:
+        tm.test_the_same_prompt_again_resumes_before_its_last_token(fake)
+    except AssertionError:
+        failed += 1
+    assert failed >= 1
