@@ -0,0 +1,233 @@
+"""TF_GLM_KV's cache kernels on the CPU, for tests/test_glm_kv8.py (run as a script in a subprocess: the kernels must be
+defined under TRITON_INTERPRET=1, which this module sets before anything imports triton).
+
+    python tests/glm_kv8_cpu.py CONFIGS...      CONFIG = kv:layout[:deq], kv in bf16|fp8, layout in planes|ring
+
+prints one JSON object: per config, the sha256 of every array the kernels wrote or returned (W*: the write paths'
+caches, R*: the read paths' outputs) and ``kernel_eq_ref`` (fp8: the stored rows equal ``kv8.quantize_rows``).
+``deq``: a bf16 run on the rows an fp8 cache holds, dequantized (its R* must equal the fp8 run's). It runs the tree on
+PYTHONPATH, so the same script records another tree's bytes (MiaAI-Lab's recipe tree, the base before TF_GLM_KV):
+tests/data/glm_kv8_golden.json.
+
+Triton 3.8's interpreter converts fp32 -> bf16 by truncation, fp32 -> fp8 e4m3 without carrying into the exponent,
+and multiplies bf16 dot operands as integers; ``patch_interpreter`` replaces those with IEEE round-to-nearest-even
+conversions (the GPU's cvt.rn.bf16.f32 and cvt.rn.satfinite.e4m3x2.f32) and a float32 product of exact float32
+operands. The write paths then use only exact or IEEE elementwise arithmetic and numpy reductions; the read paths'
+dot products depend on numpy's float32 matmul (stable on one host, not across BLAS builds).
+"""
+from __future__ import annotations
+
+import hashlib
+import importlib
+import json
+import os
+import sys
+
+os.environ["TRITON_INTERPRET"] = "1"
+
+import numpy as np
+import torch
+
+H, LW, D, IH = 64, 512, 128, 32          # world-1 attention heads, latent width, index width and heads
+SCALE = 256 ** -0.5
+
+
+def patch_interpreter() -> None:
+    import triton.language as tl
+    from triton.runtime import interpreter as itp
+
+    types = {tl.float32: torch.float32, tl.bfloat16: torch.bfloat16, tl.float16: torch.float16,
+             tl.float8e4nv: torch.float8_e4m3fn, tl.float8e5: torch.float8_e5m2}
+    original = itp._convert_float
+
+    def convert(input, input_dtype, output_dtype, rounding_mode):
+        src, dst = types.get(input_dtype), types.get(output_dtype)
+        if src is None or dst is None:
+            return original(input, input_dtype, output_dtype, rounding_mode)
+        arr = np.ascontiguousarray(input)
+        view = {1: np.uint8, 2: np.int16, 4: np.int32}[src.itemsize]
+        x = torch.from_numpy(arr.view(view).copy()).view(src)
+        y = x.float().clamp(-448.0, 448.0).to(dst) if dst == torch.float8_e4m3fn else x.to(dst)
+        bits = {1: (torch.uint8, np.uint8), 2: (torch.int16, np.uint16), 4: (torch.int32, np.uint32)}[y.element_size()]
+        return y.contiguous().view(bits[0]).numpy().view(bits[1]).reshape(input.shape)
+
+    def create_dot(self, a, b, d, input_precision, max_num_imprecise_acc):
+        def f32(h):
+            if h.dtype == tl.bfloat16 or (h.dtype.primitive_bitwidth == 8 and h.dtype.is_floating()):
+                return convert(h.data, h.dtype, tl.float32, None).view(np.float32)
+            return h.data.astype(np.float32) if h.dtype == tl.float16 else h.data
+        return itp.TensorHandle(np.matmul(f32(a), f32(b), dtype=d.data.dtype) + d.data, d.dtype.scalar)
+
+    itp._convert_float = convert
+    itp.InterpreterBuilder.create_dot = create_dot
+
+
+def latent_rows(n: int, seed: int, spread: float = 12.0) -> torch.Tensor:
+    """bf16 [n + 10, 512]: GLM-like rows (channel gains, outlier channels, row scales 2^-spread .. 2^spread), then
+    zeros, -0, a single value, rows of e4m3 rounding ties at three exponents, subnormal codes, tiny and huge rows."""
+    g = torch.Generator().manual_seed(seed)
+    gains = torch.exp(torch.randn(LW, generator=g) * 0.7)
+    gains[torch.randperm(LW, generator=g)[:6]] *= 20.0
+    x = torch.randn(n, LW, generator=g) * gains * torch.exp2(torch.empty(n, 1).uniform_(-spread, spread, generator=g))
+    extra = [torch.zeros(LW), torch.full((LW,), -0.0)]
+    one = torch.zeros(LW)
+    one[17] = -3.0
+    extra.append(one)
+    t = torch.arange(LW, dtype=torch.float32)
+    for e in (8, 3, -20):
+        r = 2.0 ** e * (1 + (t % 64) / 64.0) * torch.where(t % 2 == 0, 1.0, -1.0)
+        r[0] = 2.0 ** e * 1.99
+        extra.append(r)
+    sub = t * 2.0 ** -11
+    sub[0] = 255.0
+    extra += [sub, torch.randn(LW, generator=g) * 1e-30, torch.randn(LW, generator=g) * 1e30]
+    return torch.cat([x.to(torch.bfloat16), torch.stack(extra).to(torch.bfloat16)])
+
+
+def run(kv: str, layout: str, deq: bool) -> dict:
+    from tensorfold.families.glm5_next.cuda import latent, segments, sparse
+    try:
+        kv8 = importlib.import_module("tensorfold.families.glm5_next.cuda.kv8")
+    except ImportError:
+        kv8 = None
+    fp8, ring = kv == "fp8", layout == "ring"
+    dev = torch.device("cpu")
+    out: dict[str, torch.Tensor] = {}
+
+    def zeros(rows, width):
+        return kv8.zeros(rows, width, "fp8", dev) if fp8 else torch.zeros((rows, width), dtype=torch.bfloat16)
+
+    def pos_t(p):
+        return torch.tensor([p], dtype=torch.int32)
+
+    def prep(x):
+        return kv8.dequantize(kv8.quantize_rows(x)).to(torch.bfloat16) if deq else x
+
+    def seg(sr, segs, ring_bases, **kw):
+        return sr.set([s + (b,) for s, b in zip(segs, ring_bases)] if ring else segs, **kw)
+
+    # W1 latent_write; W2 seg_latent_write
+    rows = latent_rows(48, 1)                     # 57 rows
+    src = prep(rows)
+    cache = zeros(4096, LW)
+    writes = [(0, 0, 40), (100, 40, 7), (4096 - 16, 47, 10)]
+    for p, a, n in writes:
+        latent.latent_write(src[a:a + n], cache, pos_t(p))
+    out["W1.latent_cache"] = cache
+    if fp8:
+        ref = kv8.quantize_rows(rows)
+        out["kernel_eq_ref"] = torch.tensor([int(all(torch.equal(cache[p:p + n], ref[a:a + n])
+                                                     for p, a, n in writes))])
+    arena = zeros(3 * 2048, LW)
+    sr = segments.SegRows(32, dev, ring=2112) if ring else segments.SegRows(32, dev)
+    R = seg(sr, [(0, 5, 4), (2048, 2045, 3), (4096, 0, 6)], [0, 2112, 4224], sparse_from=None)
+    latent.seg_latent_write(src[:R], arena, sr)
+    out["W2.seg_latent_arena"] = arena
+
+    # W3 index_update, prompt chunks then decode windows; W4 seg_index_update, two streams
+    g = torch.Generator().manual_seed(2)
+    nk = 320
+    k_raw = (torch.randn(nk, D, generator=g) * 3).to(torch.bfloat16)
+    gate = torch.randn(nk, D, generator=g) * 2
+    ln_w = (1 + torch.randn(D, generator=g) * 0.2).to(torch.bfloat16)
+    ln_b = (torch.randn(D, generator=g) * 0.1).to(torch.bfloat16)
+    ape = (torch.randn(4, D, generator=g) * 0.5).to(torch.bfloat16)
+    pk = zeros(2048 // 4 + 2, D)
+    nring = 320 if ring else 2048
+    ik = torch.zeros((nring, D), dtype=torch.bfloat16)
+    ig = torch.zeros((nring, D), dtype=torch.bfloat16)
+    at = 0
+    for p, n in ((0, 300), (300, 7), (307, 1), (308, 12)):
+        sparse.index_update(k_raw[at:at + n], gate[at:at + n], ln_w, ln_b, ape, ik, ig, pk, pos_t(p))
+        at += n
+    out["W3.pooled_keys"], out["W3.index_keys"], out["W3.index_gates"] = pk, ik, ig
+    pk2 = zeros(2 * 4096 // 4 + 2, D)
+    nr2 = 2 * (64 if ring else 4096)
+    ik2 = torch.zeros((nr2, D), dtype=torch.bfloat16)
+    ig2 = torch.zeros((nr2, D), dtype=torch.bfloat16)
+    sr2 = segments.SegRows(32, dev, ring=64) if ring else segments.SegRows(32, dev)
+    used = 0
+    for win in ([(0, 0, 9), (4096, 0, 7)], [(0, 9, 8), (4096, 7, 13)], [(0, 17, 30), (4096, 20, 1)],
+                [(0, 47, 5), (4096, 21, 16)]):
+        R = seg(sr2, win, [0, 64], sparse_from=None)
+        sparse.seg_index_update(k_raw[used:used + R], gate[used:used + R], ln_w, ln_b, ape, ik2, ig2, pk2, sr2)
+        used += R
+    out["W4.seg_pooled_keys"], out["W4.seg_index_keys"], out["W4.seg_index_gates"] = pk2, ik2, ig2
+
+    # R1 dense, R2 sparse, R3 segmented attention over a written cache
+    n_ctx = 700
+    ctx = prep(latent_rows(n_ctx, 3, spread=2.0)[:n_ctx])
+    lc = zeros(4096, LW)
+    latent.latent_write(ctx, lc, pos_t(0))
+    q = torch.Generator().manual_seed(4)
+    qa = (torch.randn(4, H, LW, generator=q) * 0.5).to(torch.bfloat16)
+    pos = n_ctx - 4
+    nch = latent.chunks_for(n_ctx)
+    o = torch.empty((4, H, LW), dtype=torch.bfloat16)
+    latent.attention(qa, lc, pos_t(pos), latent.LatentScratch(4, H, nch, dev), scale=SCALE, nch=nch, out=o)
+    out["R1.dense_out"] = o
+    W = sparse.TOKENS
+    tok = torch.full((4, W), -1, dtype=torch.int32)
+    cnt = torch.zeros((4,), dtype=torch.int32)
+    for r in range(4):
+        k = pos + r + 1 - (r % 2) * 17
+        tok[r, :k] = torch.sort(torch.randperm(pos + r + 1, generator=q)[:k]).values.to(torch.int32)
+        cnt[r] = k
+    o2 = torch.zeros((4, H, LW), dtype=torch.bfloat16)
+    latent.sparse_attention(qa, lc, tok, cnt, o2, SCALE)
+    out["R2.sparse_out"] = o2
+    ar = zeros(2 * 2048, LW)
+    latent.latent_write(ctx[:300], ar, pos_t(0))
+    latent.latent_write(ctx[-600:], ar, pos_t(2048))
+    sr3 = segments.SegRows(16, dev, ring=64) if ring else segments.SegRows(16, dev)
+    R3 = seg(sr3, [(0, 298, 2), (2048, 597, 3)], [0, 64], sparse_from=500)
+    tok3 = torch.full((R3, W), -1, dtype=torch.int32)
+    cnt3 = torch.zeros((R3,), dtype=torch.int32)
+    for r, p in ((2, 597), (3, 598), (4, 599)):
+        k = p + 1 - 5
+        tok3[r, :k] = torch.sort(torch.randperm(p + 1, generator=q)[:k]).values.to(torch.int32)
+        cnt3[r] = k
+    o3 = torch.empty((R3, H, LW), dtype=torch.bfloat16)
+    latent.seg_attention(qa[:1].expand(R3, H, LW).contiguous(), ar, sr3, tok3, cnt3,
+                         latent.LatentScratch(R3, H, latent.seg_chunks(), dev), scale=SCALE, out=o3)
+    out["R3.seg_out"] = o3
+
+    # R4 / R5: the indexer's selection over pooled keys (cache rows as each format stores them)
+    npools = 2048
+    pk_rows = (torch.randn(npools, D, generator=torch.Generator().manual_seed(6)) *
+               torch.exp(torch.randn(npools, 1, generator=torch.Generator().manual_seed(8)))).to(torch.bfloat16)
+    pkl = zeros(npools + 2, D)
+    pkl[:npools] = kv8.quantize_rows(pk_rows) if fp8 else prep(pk_rows)
+    s = torch.Generator().manual_seed(5)
+    qi = (torch.randn(2, IH * D, generator=s) * 0.3).to(torch.bfloat16)
+    wts = torch.randn(2, D + IH, generator=s).to(torch.bfloat16)[:, D:]
+    out["R4.sel_tokens"], out["R4.sel_counts"] = sparse.select_tokens(qi, wts, pkl, 3000, 2, npools, pos_t(3000))
+    sel = segments.SelectScratch(8, (npools + 2) * 4, dev)
+    sr5 = segments.SegRows(8, dev, ring=64) if ring else segments.SegRows(8, dev)
+    seg(sr5, [(0, 6072, 1), (4096, 4088, 1)], [0, 64], sparse_from=500)
+    out["R5.seg_tokens"], out["R5.seg_counts"] = sparse.seg_select_tokens(qi, wts, pkl, sr5, sel)
+
+    def sha(t):
+        t = t.contiguous()
+        return hashlib.sha256(t.view(torch.uint8).numpy().tobytes() if t.is_floating_point() else
+                              t.numpy().tobytes()).hexdigest()
+
+    res = {k: sha(v) for k, v in sorted(out.items()) if k != "kernel_eq_ref"}
+    if "kernel_eq_ref" in out:
+        res["kernel_eq_ref"] = int(out["kernel_eq_ref"].item())
+    res["counts"] = [int(c) for c in out["R4.sel_counts"].tolist() + out["R5.seg_counts"].tolist()]
+    return res
+
+
+def main(argv) -> int:
+    patch_interpreter()
+    results = {}
+    for spec in argv:
+        kv, layout, *rest = spec.split(":")
+        results[spec] = run(kv, layout, deq=rest == ["deq"])
+    print(json.dumps(results))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
