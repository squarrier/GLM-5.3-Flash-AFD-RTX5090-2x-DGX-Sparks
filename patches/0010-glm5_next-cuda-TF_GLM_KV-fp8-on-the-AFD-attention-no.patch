+"""TF_GLM_KV=fp8 on the AFD attention node: CPU checks of the port of MiaAI-Lab's recipe patch 0038-glm-kv-fp8
+(github.com/MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks-TensorFold @ cf28cc4, Apache-2.0), the recipe's default KV cache.
+
+- Flag off (unset or bf16): the caches, the geometry estimate and the kernels' bytes are the base tree's
+  (the split before this port: tests/data/glm_kv8_golden.json).
+- fp8: the cache kernels are the recipe's source text, their bytes the recipe tree's (the CPU runs below, digests in
+  the golden file), the reads equal a bf16 cache's of the dequantized rows, and the kv8 row format round-trips.
+- The rings (the indexer's per-token keys and gates, one ring a stream slot), snapshot tails, the multi-stream slot
+  move and segment spans; the attention node's estimate at --parallel 1/2/4 x 262,144 with q4 dense weights.
+
+The kernels run under Triton's CPU interpreter in a subprocess (tests/glm_kv8_cpu.py, conversions fixed).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import inspect
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+import torch
+
+pytest.importorskip("triton")
+
+from tensorfold.cuda import geometry  # noqa: E402
+from tensorfold.families.glm5_next.cuda import decode, engine, forward, kv8  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[1]
+GOLDEN = json.loads((ROOT / "tests" / "data" / "glm_kv8_golden.json").read_text())
+TEXT = GOLDEN["text_config"]
+GIB = 2 ** 30
+
+
+def _weights(long_context: bool = True, mtp: bool = False):
+    """golden_probe.py's small model: 2 KDA and 3 DSA layers, world 1."""
+
+    cfg = SimpleNamespace(heads=64, kv_lora=512, qk_dim=192, v_dim=256, index_dim=128, lin_heads=8, conv=4)
+    kda = SimpleNamespace(proj=SimpleNamespace(n=64))
+    layers = [SimpleNamespace(kind=k, index=i, kda=kda if k == "kda" else None)
+              for i, k in enumerate(["kda", "dsa", "kda", "dsa", "dsa"])]
+    return SimpleNamespace(cfg=cfg, device=torch.device("cpu"), world=1, layers=layers,
+                           mtp=object() if mtp else None, meta={"long_context": long_context})
+
+
+def _planes(c):
+    return {"planes": [[list(p.tensor.shape), str(p.tensor.dtype), p.div, p.pad] for p in c.arena.planes],
+            "kc": c.kc, "vc": c.vc, "mtp": list(c.mtp) if c.mtp is not None else None,
+            "index": [list(t) for t in c.index] if c.index is not None else None}
+
+
+# -- the switch ----------------------------------------------------------------------------------------------------
+
+def test_kv_kind_values():
+    assert kv8.kv_kind({}) == "bf16"
+    assert kv8.kv_kind({"TF_GLM_KV": ""}) == "bf16"
+    assert kv8.kv_kind({"TF_GLM_KV": " bf16 "}) == "bf16"
+    assert kv8.kv_kind({"TF_GLM_KV": "fp8"}) == "fp8"
+    with pytest.raises(ValueError):
+        kv8.kv_kind({"TF_GLM_KV": "int8"})
+    with mock.patch.dict(os.environ, {}, clear=True):
+        assert kv8.kv_kind() == "bf16"
+
+
+# -- flag off: the base tree's objects -----------------------------------------------------------------------------
+
+def test_flag_off_caches_are_the_base_planes():
+    """Unset, Caches builds the base's arena planes (shapes, dtypes, order); no rings, no ring tails, and snapshots
+    keep the index keys and gates among their row views, as before."""
+
+    for key, want in GOLDEN["base_flag_off"]["caches"].items():
+        long_context, mtp = (bool(int(kv.split("=")[1])) for kv in key.split(","))
+        c = forward.Caches(_weights(long_context, mtp), 4096)
+        assert _planes(c) == want, key
+        assert c.kv == "bf16" and c.rings is None and c.ring is None and c.ring_bytes() == 0
+    c = forward.Caches(_weights(), 4096)
+    st = forward.State(_weights(), 2048, 8, caches=c, base=2048)
+    assert not decode.has_rings(st) and decode._ring_tail(st, 7, 0) is None
+    views = decode._row_views(st, 7, 0)
+    assert len(views) == 3 + 3 * 3                     # 3 latents; keys, gates and pools of 3 DSA layers
+    snap = decode.Snapshot([1] * 7, torch.zeros(1), torch.zeros(1), None, -1, -1)
+    decode.put_ring_tail(st, snap)                     # nothing to put back
+    assert snap.tail is None
+
+
+def test_flag_off_geometry_unchanged():
+    for key, want in GOLDEN["base_flag_off"]["geometry"].items():
+        latent, mtp, exl3 = (bool(int(kv.split("=")[1])) for kv in key.split(","))
+        g = geometry.mla_geometry(TEXT, 1, 8, minimum_slots=2560, latent=latent, mtp=mtp, exl3_scratch=exl3)
+        assert [g.bytes_at(c) for c in (2560, 65544, 262152, 1048584)] == want, key
+        if latent:
+            gb = geometry.mla_geometry(TEXT, 1, 8, minimum_slots=2560, latent=latent, mtp=mtp, exl3_scratch=exl3,
+                                       kv="bf16", ring_rows=4096)
+            assert [gb.bytes_at(c) for c in (2560, 262152)] == [want[0], want[2]]
+
+
+def test_engine_passes_the_flag_only_when_set():
+    """decode.Engine builds rings only for fp8; GlmEngine adds the ring bytes and the geometry's kv only for fp8, and
+    the ranks' settings vector carries the kind."""
+
+    src = inspect.getsource(decode.Engine.__init__)
+    assert 'if kv != "bf16" else None' in src and "ring=ring, kv=kv" in src
+    src = inspect.getsource(engine.GlmEngine.__init__)
+    assert '**({"kv": kv, "ring_rows": ring_rows} if kv != "bf16" else {})' in src
+    assert "extra += (parallel - 1) * mla_ring_bytes(text, ring_rows)" in src
+    assert "KV_KINDS.index(kv)]" in src and "pool_rows=pool_rows, kv=kv)" in src
+
+
+# -- the kernels on the CPU ------------------------------------------------------------------------------------------
+
+@pytest.fixture(scope="module")
+def runs():
+    """tests/glm_kv8_cpu.py on this tree: fp8 rings, bf16 rings, bf16 planes (the flag-off layout), and bf16 rings on
+    the rows an fp8 cache holds, dequantized."""
+
+    env = dict(os.environ, TRITON_INTERPRET="1", PYTHONPATH=os.pathsep.join(
+        [str(ROOT / "src")] + [p for p in os.environ.get("PYTHONPATH", "").split(os.pathsep) if p]))
+    p = subprocess.run([sys.executable, str(ROOT / "tests" / "glm_kv8_cpu.py"), "fp8:ring", "bf16:ring",
+                        "bf16:planes", "bf16:ring:deq"], env=env, capture_output=True, text=True, timeout=1800,
+                       check=False)
+    assert p.returncode == 0, p.stderr[-3000:]
+    return json.loads(p.stdout.strip().splitlines()[-1])
+
+
+def _differ(a: dict, b: dict) -> list[str]:
+    return sorted(k for k in set(a) | set(b) if k != "counts" and a.get(k) != b.get(k))
+
+
+def test_flag_off_kernel_bytes_are_the_base(runs):
+    """bf16 caches in arena planes (the flag unset): every cache and output byte of the base tree's kernels."""
+
+    assert _differ(runs["bf16:planes"], GOLDEN["kernels"]["base_bf16_planes"]) == []
+
+
+def test_fp8_kernel_bytes_are_the_recipe(runs):
+    """fp8 in rings: the bytes of MiaAI-Lab's tree at the recipe's head and right after 0038; bf16 rings too."""
+
+    assert _differ(runs["fp8:ring"], GOLDEN["kernels"]["recipe_fp8_ring"]) == []
+    assert _differ(runs["fp8:ring"], GOLDEN["kernels"]["recipe_post0038_fp8_ring"]) == []
+    assert _differ(runs["bf16:ring"], GOLDEN["kernels"]["recipe_bf16_ring"]) == []
+
+
+def test_fp8_writes_are_kv8_rows_and_reads_the_dequantized_values(runs):
+    """The write kernels store kv8.quantize_rows' bytes; every read (dense, sparse, segmented attention, both
+    selections) returns what bf16 kernels return on the dequantized rows."""
+
+    fp8, deq = runs["fp8:ring"], runs["bf16:ring:deq"]
+    assert fp8["kernel_eq_ref"] == 1
+    reads = [k for k in fp8 if k.startswith("R")]
+    assert len(reads) == 7 and all(fp8[k] == deq[k] for k in reads)
+    assert min(fp8["counts"]) > 2000                   # both selections past the dense limit
+
+
+def test_copied_kernels_are_the_recipe_source():
+    root = ROOT / "src" / "tensorfold" / "families" / "glm5_next" / "cuda"
+    import ast
+
+    for name, want in GOLDEN["recipe_source_sha256"].items():
+        if name == "kv8.py":
+            lines = (root / "kv8.py").read_text().splitlines(keepends=True)
+            while lines and lines[0].startswith("#"):
+                lines.pop(0)                         # the port's two-line credit header
+            got = "".join(lines)
+        else:
+            mod, fn = name.split(".")
+            text = (root / f"{mod}.py").read_text()
+            lines = text.splitlines(keepends=True)
+            node = next(n for n in ast.parse(text).body if getattr(n, "name", None) == fn)
+            start = min([node.lineno] + [d.lineno for d in node.decorator_list])
+            got = "".join(lines[start - 1:node.end_lineno])
+        assert hashlib.sha256(got.encode()).hexdigest() == want, name
+
+
+# -- the kv8 row format --------------------------------------------------------------------------------------------
+
+@pytest.mark.parametrize("seed", [0, 1, 2])
+def test_kv8_rows_round_trip(seed):
+    g = torch.Generator().manual_seed(seed)
+    x = (torch.randn(64, 512, generator=g) * torch.exp2(torch.empty(64, 1).uniform_(-30, 30, generator=g)))
+    x = torch.cat([x, torch.zeros(1, 512)]).to(torch.bfloat16)
+    q = kv8.quantize_rows(x)
+    assert q.dtype == torch.uint8 and q.shape == (65, 512 + kv8.PAD)
+    assert not q[:, 516:].any()                                     # pad bytes after the fp32 scale
+    s = q[:, 512:516].contiguous().view(torch.float32).flatten()
+    bits = s.view(torch.int32)
+    assert ((bits & 0x7FFFFF) == 0).all() and (s > 0).all()          # powers of two
+    codes = q[:, :512].contiguous().view(torch.float8_e4m3fn).float()
+    assert codes.abs().max() <= 256 and codes[-1].abs().max() == 0   # within +-2^SHIFT; a zero row stays zero
+    d = kv8.dequantize(q)
+    amax = x.float().abs().amax(1, keepdim=True)
+    assert ((d - x.float()).abs() <= amax / 16 + 1e-38).all()        # e4m3: half a step of the row's top binade
+    assert torch.equal(kv8.dequantize(kv8.quantize_rows(d)), d)      # the dequantized values are fixed points
+    assert torch.equal(d.to(torch.bfloat16).float(), d)              # and bf16-exact (what --rows-dequant feeds)
+    assert kv8.width(q) == 512 and kv8.kind_of(q) == "fp8" and kv8.row_bytes(512, "fp8") == 528
+
+
+# -- rings, snapshot tails, slot moves and spans ---------------------------------------------------------------------
+
+def test_index_ring_rows():
+    assert forward.index_ring(262152, 2048) == 2112 == geometry.mla_index_ring(262152, 2048)
+    assert forward.index_ring(1000, 2048) == 1000                  # a short context: no row wraps
+    assert forward.index_ring(262152, 8) == 64
+
+
+def test_fp8_caches_rings_and_views():
+    w = _weights()
+    c = forward.Caches(w, 8192, streams=4, ring=2112, kv="fp8")
+    assert c.kv == "fp8" and c.ring == 2112 and len(c.rings) == 3
+    lat = c.arena.planes[c.kc[0]].tensor
+    assert lat.dtype == torch.uint8 and lat.shape == (8192, 528)
+    pk = c.arena.planes[c.index[0][2]].tensor
+    assert pk.shape == (8192 // 4 + 2, 144) and c.index[0][:2] == (None, None)
+    assert all(t.shape == (4 * 2112, 128) and t.dtype == torch.bfloat16 for pair in c.rings for t in pair)
+    assert c.ring_bytes() == 3 * 2 * 4 * 2112 * 128 * 2
+    slots = forward.Slots(w, 4, 8)
+    st = forward.State(w, 4096, 8, caches=c, base=4096, slots=slots, slot=2)
+    ik, _ig, view = st.index[1]
+    assert ik.data_ptr() == c.rings[1][0][2 * 2112].data_ptr() and ik.shape == (2112, 128)
+    pool_plane = c.arena.planes[c.index[1][2]].tensor
+    assert view.data_ptr() == pool_plane[4096 // 4].data_ptr() and view.shape[1] == 144
+    assert c.index_tensors(1)[0] is c.rings[1][0] and c.ring_base(3) == 3 * 2112
+    with pytest.raises(ValueError):
+        forward.Caches(w, 8192, kv="int8")
+    with mock.patch.object(forward.latent, "ENABLED", False), pytest.raises(ValueError):
+        forward.Caches(w, 8192, kv="fp8")              # fp8 holds the latent cache: TF_GLM_LATENT=0 is refused
+
+
+def test_ring_tail_round_trip():
+    """A snapshot's tail is its filling pools' ring rows (n % 4 of them a layer); they go back after later rows
+    overwrote the ring, into the same or another slot's ring."""
+
+    w = _weights()
+    c = forward.Caches(w, 8192, streams=2, ring=128, kv="fp8")
+    slots = forward.Slots(w, 2, 8)
+    a = forward.State(w, 4096, 8, caches=c, base=0, slots=slots, slot=0)
+    for ik, ig in c.rings:
+        ik.copy_(torch.randn(ik.shape).to(torch.bfloat16))
+        ig.copy_(torch.randn(ig.shape).to(torch.bfloat16))
+    n = 1000 * 4 + 3                                       # 3 tokens of a pool still filling, at ring rows 4000-4002
+    tail = decode._ring_tail(a, n, 0)
+    assert len(tail) == 3 and tail[0][0].tolist() == [4000 % 128, 4001 % 128, 4002 % 128]
+    want = [(ik[a.caches.ring_base(0):][:128][[32, 33, 34]].clone()) for ik, _ in c.rings]
+    snap = decode.Snapshot([7] * n, torch.zeros(1), torch.zeros(1), None, -1, -1, tail=tail)
+    assert decode.snapshot_bytes(snap) >= sum(t.numel() * t.element_size() for pair in tail for t in pair)
+    b = forward.State(w, 4096, 8, caches=c, base=4096, slots=slots, slot=1)
+    for ik, ig in c.rings:
+        ik.zero_()
+        ig.zero_()
+    decode.put_ring_tail(b, snap)                          # slot 1's ring
+    for (ik, _), rows in zip(c.rings, want):
+        assert torch.equal(ik[128 + 32:128 + 35], rows) and not ik[:128].any()
+    assert decode._ring_tail(a, 4000, 0) == []             # a whole number of pools: nothing filling
+    plain = forward.State(w, 2048, 8, caches=forward.Caches(w, 2048))
+    with pytest.raises(ValueError):
+        decode.put_ring_tail(plain, snap)                  # ring rows have no place in caches without rings
+    views = decode._row_views(a, n, 0)
+    assert len(views) == 3 + 3                             # latents and pools; keys and gates are in the tail
+
+
+def test_reslot_moves_the_ring_rows():
+    """multi.MultiDecoder._reslot: a stream moved to another slot takes its ring rows (its filling pools' keys)."""
+
+    from tensorfold.families.glm5_next.cuda import multi
+
+    w = _weights()
+    c = forward.Caches(w, 8192, streams=3, ring=64, kv="fp8")
+    slots = forward.Slots(w, 3, 8)
+    st = forward.State(w, 4096, 8, caches=c, base=2048, slots=slots, slot=0)
+    for ik, ig in c.rings:
+        ik[:64].copy_(torch.randn(64, 128).to(torch.bfloat16))
+        ig[:64].copy_(torch.randn(64, 128).to(torch.bfloat16))
+    lane = SimpleNamespace(slot=0, sid=1, extent=SimpleNamespace(size=4096, base=2048), st=st)
+    fake = SimpleNamespace(e=SimpleNamespace(slots=slots, caches=c, rows=8), lanes={1: lane}, drafts=None, w=w)
+    multi.MultiDecoder._reslot(fake, lane, 2)
+    assert lane.slot == 2 and lane.st.slot == 2
+    for ik, ig in c.rings:
+        assert torch.equal(ik[128:192], ik[:64]) and torch.equal(ig[128:192], ig[:64])
+    assert lane.st.index[0][0].data_ptr() == c.rings[0][0][128].data_ptr()
+
+
+def test_verify_spans_name_the_ring():
+    from tensorfold.families.glm5_next.cuda import verify
+
+    w = _weights()
+    for ring, want in ((None, (2048, 5, 3)), (64, (2048, 5, 3, 128))):
+        c = forward.Caches(w, 8192, streams=3, ring=ring, kv="fp8" if ring else "bf16")
+        st = SimpleNamespace(base=2048, slot=2)
+        assert verify.BatchedVerify._span(SimpleNamespace(e=SimpleNamespace(caches=c)), st, 5, 3) == want
+
+
+# -- the attention node's estimate ------------------------------------------------------------------------------------
+
+def _estimate(kv: str, par: int, window: int = 262144) -> tuple[float, int]:
+    """GlmEngine's geometry on the AFD attention node (world 1, MTP off, latent cache, no EXL3 scratch) plus the
+    --parallel extras, in bytes at a --context window; and the geometry's bytes a further window token."""
+
+    from tensorfold.families.glm5_next.cuda.engine import MULTI_WINDOW, multi_draft_bytes, slot_bytes
+
+    rows = max(engine.MAX_ROWS, geometry.PREFILL_ROWS)
+    g = geometry.mla_geometry(TEXT, 1, engine.MAX_ROWS, minimum_slots=engine.DENSE_CAPACITY, latent=True, mtp=False,
+                              exl3_scratch=False, **({"kv": kv, "ring_rows": rows} if kv != "bf16" else {}))
+    slots = window + engine.MAX_ROWS
+    total = g.bytes_at(slots)
+    if par > 1:
+        draft = {"num_hidden_layers": 5, "num_key_value_heads": 8, "head_dim": 128, "sliding_window": 2048,
+                 "dflash_config": {"block_size": 8}}
+        total += (par - 1) * slot_bytes(TEXT, 1) + MULTI_WINDOW * slots
+        total += multi_draft_bytes(draft, par, 1, ring=True, capacity=slots)
+        if kv != "bf16":
+            total += (par - 1) * geometry.mla_ring_bytes(TEXT, rows)
+    return total, (g.bytes_at(slots + 65536) - g.bytes_at(slots)) // 65536
+
+
+def test_estimate_at_262144_with_q4():
+    """fp8 KV takes 6,716 B a window token on the 5090 (bf16: 18,112); with q4 dense weights --parallel 4 at a
+    262,144-token window estimates 16.10 GiB of the 28.75 GiB budget (bf16 KV: 18.83; bf16 dense with bf16 KV, the
+    split before these ports: 29.28, refused). Anchors: the measured single-stream estimate 28.18 GiB at 262,144 (bf16, bf16 KV)
+    and q4's weights 10.443 GiB below bf16's."""
+
+    base_bf16, slope_bf16 = _estimate("bf16", 1)
+    _, slope_fp8 = _estimate("fp8", 1)
+    assert (slope_bf16, slope_fp8) == (18112, 6716)
+    assert geometry.mla_ring_bytes(TEXT, 2048) == 12 * 2 * 2112 * 128 * 2       # 12 DSA layers, MTP off: 12.38 MiB
+    anchored = {}
+    for kv in ("bf16", "fp8"):
+        for par in (1, 2, 4):
+            total, _ = _estimate(kv, par)
+            for dense, saves in (("bf16", 0.0), ("q4", 16.950 - 6.506)):
+                anchored[kv, dense, par] = round((28.18 * GIB + total - base_bf16) / GIB - saves, 2)
+    assert anchored["bf16", "bf16", 1] == 28.18 and anchored["bf16", "bf16", 4] == 29.28
+    assert [anchored["fp8", "q4", p] for p in (1, 2, 4)] == [14.96, 15.38, 16.10]
+    assert [anchored["bf16", "q4", p] for p in (1, 2, 4)] == [17.74, 18.14, 18.83]
+    assert all(anchored["fp8", "q4", p] <= 28.75 for p in (1, 2, 4))
