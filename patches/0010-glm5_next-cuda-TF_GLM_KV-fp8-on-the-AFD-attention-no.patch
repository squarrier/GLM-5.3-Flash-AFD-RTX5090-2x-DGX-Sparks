+"""TF_GLM_KV=fp8's indexer rings in the multi-stream engine (--parallel) and the single-stream paths, on the CPU.
+
+The fake model of tests/test_glm_multi.py and tests/test_glm_multi_afd.py (logits that hash what each stream
+committed, read back from its pool rows and its slot) with the fp8 layout of forward.Caches: one ring of the
+indexer's per-token keys and gates a stream slot, beside the extents' pools, and a pool's key computed from its four
+tokens' RING rows when its last token is written, as the indexer kernels compute it. A ring row lost or stale (a stream
+moved to another slot without its rows, a kept prompt resumed elsewhere without its tail, a tail overwritten by later
+windows) gives another pooled key, other logits and another reply, so every reply that equals its request served
+alone also says the rings followed the stream. The scenarios are the multi-stream suites' own (two ranks with serial
+verify windows; the AFD attention node at world 1 with the real batched-verify seam), run with these caches; two
+mutations (the ring rows left behind by a slot move, kept tails not put back) must make them fail.
+"""
+
+from __future__ import annotations
+
+import importlib
+
+import pytest
+
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+pytestmark = pytest.mark.torch
+
+# The two suites' fixtures, bound here by assignment: pytest registers them in this module under these same names,
+# as the by-name imports did (a test parameter that shadows a fixture imported by name is ruff's F811)
+fake = tm.fake
+afd_fake = ta.afd_fake
+
+RING = 72          # >= the fakes' widest window (64-row prompt chunks) + 3, as forward.index_ring sizes it; wraps often
+
+
+class RingCaches(tm.FakeCaches):
+    """The fake pool plus forward.Caches' fp8 rings: (keys, gates) [4 slots x RING, 1] of the one indexed layer."""
+
+    def __init__(self, torch, rows: int) -> None:
+        super().__init__(torch, rows)
+        self.ring = RING
+        self.rings = [tuple(torch.zeros((4 * RING, 1), dtype=torch.int64) for _ in range(2))]
+
+    def ring_base(self, slot: int) -> int:
+        return int(slot) * self.ring
+
+
+class RingState(tm.FakeState):
+    """forward.State's fp8 views: its slot's rings (index[0] = keys, gates, the extent's pools)."""
+
+    def bind(self, base: int, capacity: int) -> None:
+        super().bind(base, capacity)
+        c = self.caches
+        r0 = c.ring_base(self.slot)
+        self.index = [(c.rings[0][0][r0:r0 + c.ring], c.rings[0][1][r0:r0 + c.ring], self.pk)]
+
+    def write(self, q: int, tok: int) -> None:
+        if q >= self.capacity:
+            raise ValueError("context past the cache capacity")
+        ik, ig, _ = self.index[0]
+        n = ik.shape[0]
+        self.lat[q, 0] = tok + 1
+        ik[q % n, 0] = tok + 1
+        ig[q % n, 0] = 1 + (7 * tok + q) % 13
+        if q % 4 == 3:
+            # the pool's key from its 4 tokens' RING rows (as index_update's pooling reads them): the same value as the
+            # plain fake's (the sum of the tokens + 1, so its drafters' chains still match), unless a ring row is
+            # stale or missing; each row's gate must be its own token's at its own position
+            rows = [(q - i) % n for i in range(4)]
+            for i, r in enumerate(rows):
+                assert int(ig[r, 0]) == 1 + (7 * (int(ik[r, 0]) - 1) + q - i) % 13, ("stale ring row", q - i)
+            self.pk[q // 4, 0] = int(ik[rows, 0].sum())
+
+
+@pytest.fixture
+def rings(monkeypatch):
+    forward = importlib.import_module("tensorfold.families.glm5_next.cuda.forward")
+    monkeypatch.setattr(tm, "FakeCaches", RingCaches)
+    monkeypatch.setattr(tm, "FakeState", RingState)
+    monkeypatch.setattr(forward, "State", RingState)       # multi._reslot's State, whichever fixture ran first
+    return monkeypatch
+
+
+def _ringed(torch) -> None:
+    """The scenarios built ring caches (not the plain fake)."""
+    e = tm.shell(torch, 0, pool=2 * tm.ALIGN, streams=2).e
+    assert isinstance(e.caches, RingCaches) and isinstance(e.home, RingState)
+    from tensorfold.families.glm5_next.cuda.decode import has_rings
+
+    assert has_rings(e.home)
+
+
+# -- two ranks, serial verify windows (tests/test_glm_multi.py's scenarios) ------------------------------------------
+
+@pytest.mark.parametrize("streams,drafters", [(2, "dflash2"), (4, "dflash2"), (4, "both"), (2, "mtp")])
+def test_rings_staggered_requests_equal_their_solo_replies(fake, rings, streams, drafters):
+    _ringed(fake)
+    tm.test_staggered_concurrent_requests_equal_their_solo_serial_replies(fake, streams, drafters)
+
+
+@pytest.mark.parametrize("policy,mtp", [("f3", False), ("2", True)], ids=["dflash2", "mtp"])
+def test_rings_resumes_take_kept_prompts_over_or_copy_them(fake, rings, policy, mtp):
+    tm.test_resumes_take_kept_extents_over_or_copy_them(fake, policy, mtp)
+
+
+def test_rings_the_same_prompt_again_resumes_before_its_last_token(fake, rings):
+    tm.test_the_same_prompt_again_resumes_before_its_last_token(fake)
+
+
+def test_rings_a_lone_stream_moves_home_and_a_second_one_joins(fake, rings):
