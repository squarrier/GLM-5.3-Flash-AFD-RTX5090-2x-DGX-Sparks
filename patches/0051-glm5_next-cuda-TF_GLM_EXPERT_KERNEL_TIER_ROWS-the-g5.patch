diff --git a/src/tensorfold/families/glm5_next/cuda/g53_experts.py b/src/tensorfold/families/glm5_next/cuda/g53_experts.py
index 4041fae..db87a0a 100644
--- a/src/tensorfold/families/glm5_next/cuda/g53_experts.py
+++ b/src/tensorfold/families/glm5_next/cuda/g53_experts.py
@@ -36,6 +36,11 @@ The schedule (TF_GLM_EXPERT_KERNEL_MT, _GW, _NT, _L2, _FUSE, _DISCARD; each unse
 as before): one value for every window, so a launch shape can be tuned for the GPU the experts run on. These fields
 keep every bit. TF_GLM_EXPERT_KERNEL_SK, _SKD and _SWIGLU (the K splits and the SwiGLU precision) change outputs; set,
 they too apply to every window, so a prompt row's bits still never depend on its window.
+
+The tier (TF_GLM_EXPERT_KERNEL_TIER_ROWS=N, 1..4,096; unset: the knobs set apply to every window, as above): the
+schedule the knobs set runs only windows of at least N rows, and smaller windows keep default_cfg's, so a schedule that
+pays on full prompt windows need not cost the small ones. It tiers the same-bits fields only (a row's bits then still
+never depend on its window): with _SK, _SKD or _SWIGLU set it refuses.
 """
 
 from __future__ import annotations
@@ -70,6 +75,7 @@ SCHEDULE_ENVS = {
     "swiglu": ("TF_GLM_EXPERT_KERNEL_SWIGLU", (0, 1)),       # 1: FP32 SwiGLU (outputs change)
 }
 BIT_FIELDS = ("sk", "skd", "swiglu")   # the only fields that change a bit (glm53f-rank's own statement)
+TIER_ENV = "TF_GLM_EXPERT_KERNEL_TIER_ROWS"   # the smallest window the knobs' schedule runs (unset: every window)
 
 
 @lru_cache(maxsize=1)
@@ -114,12 +120,22 @@ def default_cfg(rows: int, *, rowrot: bool = True, order: bool = False) -> Cfg:
     return Cfg(mt=4, sk=1, skd=1, nt=4, gw=16, l2=1, fuse=2, discard=2, swiglu=0, rot=rot, gord=gord)
 
 
-def tuned_cfg(rows: int, *, rowrot: bool = True, order: bool = False, fields: dict | None = None) -> Cfg:
+def tuned_cfg(rows: int, *, rowrot: bool = True, order: bool = False, fields: dict | None = None,
+              tier: int | None = None) -> Cfg:
     """default_cfg(rows) with ``fields`` (``schedule()``'s: the knobs set) over it, the same values for every window
-    size. No fields: default_cfg itself."""
+    size; with ``tier`` (TF_GLM_EXPERT_KERNEL_TIER_ROWS) only for windows of at least ``tier`` rows, smaller ones
+    default_cfg(rows) (the tier takes the same-bits fields only). No fields: default_cfg itself."""
 
     c = default_cfg(rows, rowrot=rowrot, order=order)
-    return replace(c, **fields) if fields else c
+    if not fields:
+        return c
+    if tier is not None:
+        bits = [f for f in BIT_FIELDS if f in fields]
+        if bits:
+            raise ValueError(f"{TIER_ENV} tiers the same-bits fields only, not {', '.join(bits)}")
+        if rows < tier:
+            return c
+    return replace(c, **fields)
 
 
 def _flag(name: str, default: bool) -> bool:
@@ -151,12 +167,37 @@ def schedule() -> dict:
     return got
 
 
+def tier_rows(fields: dict) -> int | None:
+    """TF_GLM_EXPERT_KERNEL_TIER_ROWS (read with the knobs, under g53 only): None when unset or empty (the knobs set
+    apply to every window, as before), else N (1..4,096): the knobs' schedule runs windows of at least N rows only,
+    smaller ones keep default_cfg's. It tiers the same-bits fields only: with a knob that changes bits (``fields``
+    holding sk, skd or swiglu) it refuses, since a row would then get other bits in a big window than in a small one.
+    Bad values refuse."""
+
+    v = os.environ.get(TIER_ENV, "").strip()
+    if v == "":
+        return None
+    try:
+        n = int(v)
+    except ValueError:
+        n = None
+    if n is None or not MIN_ROWS <= n <= MAX_ROWS:
+        raise ValueError(f"{TIER_ENV} is a window size of {MIN_ROWS}..{MAX_ROWS} rows (the smallest window the "
+                         f"knobs' schedule runs), not {v!r}")
+    bits = [SCHEDULE_ENVS[f][0] for f in BIT_FIELDS if f in fields]
+    if bits:
+        raise ValueError(f"{TIER_ENV} tiers the same-bits fields only: {', '.join(bits)} change a row's bits, so they "
+                         f"apply to every window (unset them, or {TIER_ENV})")
+    return n
+
+
 def switch() -> dict | None:
     """TF_GLM_EXPERT_KERNEL, read once at the node's start: None (unset, empty or ``tf``: TensorFold's kernels) or the
     settings of ``g53``: min_rows (TF_GLM_EXPERT_KERNEL_ROWS, 1..4,096, default 1: every prompt window; above 1 the
     smaller windows stay on TensorFold's kernels and a prompt row's bits depend on its window), rowrot
     (TF_GLM_EXPERT_KERNEL_ROWROT, default 1) and order (TF_GLM_EXPERT_KERNEL_ORDER, default 0), plus ``schedule``
-    (``schedule()``'s fields) when a configuration knob is set. Bad values refuse."""
+    (``schedule()``'s fields) when a configuration knob is set and ``tier_rows`` (``tier_rows()``) when
+    TF_GLM_EXPERT_KERNEL_TIER_ROWS is. Bad values refuse."""
 
     v = os.environ.get(ENV, "").strip().lower()
     if v in ("", "tf"):
@@ -176,6 +217,9 @@ def switch() -> dict | None:
     fields = schedule()
     if fields:
         got["schedule"] = fields
+    tier = tier_rows(fields)
+    if tier is not None:
+        got["tier_rows"] = tier
     return got
 
 
@@ -295,6 +339,8 @@ class Node:
         self.node, self.min_rows = node, int(settings["min_rows"])
         self.rowrot, self.order = bool(settings["rowrot"]), bool(settings["order"])
         self.fields = dict(settings.get("schedule") or {})   # the configuration knobs set: none, default_cfg's
+        tier = settings.get("tier_rows")   # TF_GLM_EXPERT_KERNEL_TIER_ROWS: the knobs' smallest window (None: all)
+        self.tier = None if tier is None else int(tier)
         self.max_rows = min(MAX_ROWS, b.prefill_rows)
         self.ready = {i: layer_ready(ex) is None for i, ex in node.by_layer.items()}
         self.scratch = Scratch(self.max_rows, b.routed.device, share=getattr(b, "pref", None))
@@ -311,20 +357,36 @@ class Node:
         if self.fields:
             bits = [f for f in BIT_FIELDS if f in self.fields]
             own = self.scratch._own
-            tuned = (f"; schedule {' '.join(f'{k} {v}' for k, v in self.fields.items())} for every window ("
+            tuned = (f"; schedule {' '.join(f'{k} {v}' for k, v in self.fields.items())} {self._span()} ("
+                     + (f"tier {TIER_ENV}={self.tier}; " if self.tier is not None else "")
                      + (f"{', '.join(bits)}: outputs change" if bits else "the same bits")
                      + (f"; {sum(t.numel() * t.element_size() for t in own) >> 20} MiB own scratch" if own else "")
                      + ")")
+        elif self.tier is not None:
+            tuned = f"; tier {TIER_ENV}={self.tier} with no schedule knob set: every window runs default_cfg"
         print(f"[tensorfold] afd expert {node.half + 1}: {ENV}=g53: prompt chunks of {self.min_rows}-{self.max_rows} "
               f"rows through glm53f-afd's large-M expert kernels (Hugh Madden; outputs class; {floor}; rowrot "
               f"{'on' if self.rowrot else 'off'} ({shared} layers share one gate/up suh), order "
               f"{'on' if self.order else 'off'}); {sum(self.ready.values())} of {len(self.ready)} MoE layers in scope"
               f"{tuned}", flush=True)
 
+    def _span(self) -> str:
+        """The windows the knobs' schedule runs, for the start line: every one, or under TF_GLM_EXPERT_KERNEL_TIER_ROWS
+        those of tier rows and up (the rest default_cfg's)."""
+
+        t, lo, hi = self.tier, self.min_rows, self.max_rows
+        if t is None or t <= lo:
+            return "for every window"
+        if t > hi:
+            return f"for no window (windows here are at most {hi} rows: every one runs default_cfg)"
+        sizes = f"{t}-{hi}" if t < hi else f"{t}"
+        return f"for windows of {sizes} rows, default_cfg's for {lo}-{t - 1}"
+
     def config(self, R: int) -> Cfg:
-        """The configuration a window of R rows runs: default_cfg with the knobs set over it."""
+        """The configuration a window of R rows runs: default_cfg with the knobs set over it (under
+        TF_GLM_EXPERT_KERNEL_TIER_ROWS only for windows of at least that many rows)."""
 
-        return tuned_cfg(R, rowrot=self.rowrot, order=self.order, fields=self.fields)
+        return tuned_cfg(R, rowrot=self.rowrot, order=self.order, fields=self.fields, tier=self.tier)
 
     def takes(self, layer_i: int, R: int, prompt: bool) -> bool:
         """A prompt chunk's window (``prompt``: the node's MODE_CHUNK, MODE_SLICE, MODE_PAIR and MODE_LANES forwards)
@@ -341,7 +403,7 @@ class Node:
         b = self.node.buf
         normed, pick, wts = x if x is not None else (b.normed[:R], b.pick[:R], b.wts[:R])
         dst = b.routed[:R] if out is None else out
-        if self.fields:                 # a configuration knob set: that configuration for every window
+        if self.fields:                 # a configuration knob set: config(R) (every window, or the tier's and up)
             return routed(normed, pick, wts, self.node.by_layer[layer_i], self.scratch, dst, R, self.node.cfg.limit,
                           self.config(R))
         return routed(normed, pick, wts, self.node.by_layer[layer_i], self.scratch, dst, R, self.node.cfg.limit,
