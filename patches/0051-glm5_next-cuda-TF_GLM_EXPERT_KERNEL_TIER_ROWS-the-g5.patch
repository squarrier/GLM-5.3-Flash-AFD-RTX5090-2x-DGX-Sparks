+# ---------------------------------------------------------------------------- the emulated decomposition (CPU digests)
+
+# Reduced sizes (the kernels': H 4,096, WID 1,024, 512-column blocks, 288 experts); the tuned schedule's 512-column
+# down chunks need H 512. At 2,048 rows the 64 experts get 53-1,937 rows: one 64-row group or several.
+DT = sched.Dims(H=512, WID=256, CBW=256, E=64)
+
+
+def _emu(c) -> dict:
+    return {f.name: getattr(c, f.name) for f in dc_fields(c)}
+
+
+def test_emulated_tier_a_rows_bits_in_a_1024_and_a_2048_row_window_are_the_default_schedules(monkeypatch):
+    _knobs(monkeypatch, tier="1536")
+    s = g53_experts.switch()
+    cfg = {R: g53_experts.tuned_cfg(R, rowrot=s["rowrot"], order=s["order"], fields=s["schedule"], tier=s["tier_rows"])
+           for R in (8, 1024, 2048)}
+    assert cfg[8] == g53_experts.default_cfg(8) and cfg[1024] == g53_experts.default_cfg(1024)   # under the tier
+    assert cfg[2048] == replace(g53_experts.default_cfg(2048), **BIG) != g53_experts.default_cfg(2048)
+    assert _emu(g53_experts.default_cfg(2048)) == sched.base_cfg()          # the emulation's default schedule
+    rng = np.random.default_rng(1536)
+    L = sched.layer(DT, rng, shared=True)
+    x, pick, w = sched.inputs(DT, 2048, rng)
+    counts = np.bincount(pick.reshape(-1), minlength=DT.E)
+    assert (counts <= 64).sum() >= 4 and (counts > 128).sum() >= 8      # one and several 64-row groups an expert
+    want = sched.ffn(DT, L, x, pick, w, sched.base_cfg())                  # 2,048 rows, default schedule
+    assert np.isfinite(want).all()
+    full = sched.ffn(DT, L, x, pick, w, _emu(cfg[2048]), seed=11)          # 2,048 rows, the tier's: tuned
+    assert sched.digest(full) == sched.digest(want)
+    for lo, hi in ((0, 1024), (2040, 2048)):                               # 1,024 and 8 rows: default_cfg's
+        part = sched.ffn(DT, L, x[lo:hi], pick[lo:hi], w[lo:hi], _emu(cfg[hi - lo]), seed=lo + 1)
+        assert sched.digest(part) == sched.digest(full[lo:hi]), (lo, hi)
