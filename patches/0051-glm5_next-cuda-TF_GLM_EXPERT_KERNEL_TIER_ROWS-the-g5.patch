 the real checkpoint instead of synthetic tiles.
@@ -633,15 +635,47 @@ def test_tuned_schedules_keep_every_bit(layer, R, kind):
         assert _bits_equal(_ours(ex, inp, _cfg(R, **kw)), want), (R, kind, kw)
 
 
+TIERS = (1280, 1536, 1792, 2048)                 # TF_GLM_EXPERT_KERNEL_TIER_ROWS: the candidate sizes
+BIG = {"mt": 4, "gw": 16, "nt": 4, "l2": 1}       # glm53f-rank's own schedule above 2,048 rows
+
+
+@pytest.mark.parametrize("kind", ["uniform", "skewed"])
+def test_tier_windows_keep_every_bit(layer, kind):
+    """TF_GLM_EXPERT_KERNEL_TIER_ROWS=N with the knobs of glm53f-rank's above-2,048-row schedule (mt 4, gw 16, nt 4,
+    l2 1): that schedule on windows of N rows and up, default_cfg's below. Windows of 1,024, N - 1, N, 2,047 and 2,048
+    rows, from the front and the back of a 2,048-row prompt, give every row the bytes of the default schedule's
+    2,048-row call, for each candidate N."""
+
+    from tensorfold.families.glm5_next.cuda import g53_experts
+
+    _, ex = layer
+    inp = _inputs(2048, kind, 1536)
+    want = _ours(ex, inp, _cfg(2048))
+    done = set()
+    for n in TIERS:
+        for R in (1024, n - 1, n, 2047, 2048):
+            cfg = g53_experts.tuned_cfg(R, fields=BIG, tier=n)
+            assert cfg == (_cfg(R) if R < n else _cfg(R, **BIG)), (n, R)
+            for lo in (0, 2048 - R):
+                if (lo, R, cfg) in done:
+                    continue
+                done.add((lo, R, cfg))
+                part = SimpleNamespace(x=inp.x[lo:lo + R], pick=inp.pick[lo:lo + R], wts=inp.wts[lo:lo + R])
+                assert _bits_equal(_ours(ex, part, cfg), want[lo:lo + R]), (kind, n, R, lo, cfg)
+
+
 def test_tuned_times_report(layer):
     """Information (TF_G53_TUNE_TIMES: a JSON file to write them to): ms a call for the default and each schedule of
-    TUNE at 256-2,048 rows, uniform and skewed routing."""
+    TUNE at 256-2,048 rows (TF_G53_TUNE_ROWS: other window sizes, comma-separated; TF_G53_TUNE_N: timed calls a
+    median, default 20), uniform and skewed routing."""
 
     from tensorfold.families.glm5_next.cuda import g53_experts
 
     name, ex = layer
+    sizes = tuple(int(v) for v in os.environ.get("TF_G53_TUNE_ROWS", "256,512,1024,2048").split(","))
+    n = int(os.environ.get("TF_G53_TUNE_N", "20"))
     res = {}
-    for R in (256, 512, 1024, 2048):
+    for R in sizes:
         for kind in ("uniform", "skewed"):
             inp = _inputs(R, kind, 61 + R)
             s = _scratch(R)
@@ -653,7 +687,7 @@ def test_tuned_times_report(layer):
                 def call(inp=inp, s=s, out=out, R=R, cfg=cfg):
                     g53_experts.routed(inp.x, inp.pick, inp.wts, ex, s, out, R, LIMIT, cfg)
 
-                row[_label(kw)] = _time(call, n=20)
+                row[_label(kw)] = _time(call, n=n)
             res[f"{name} R{R} {kind}"] = row
             print(f"[tune times, ms a call] {name} R{R} {kind}: {row}")
     path = os.environ.get("TF_G53_TUNE_TIMES")
