+def test_start_line_names_the_tier(monkeypatch, capsys):
+    make = _expert_node(monkeypatch)
+    monkeypatch.setenv(g53_experts.ENV, "g53")
+
+    def line(prefill_rows=256):     # a 2,048-row node's CPU buffers are ~2 GB: one at a time
+        node = make(prefill_rows)
+        assert node.g53.scratch._own is None
+        del node
+        gc.collect()
+        return capsys.readouterr().out.strip().splitlines()[-1]
+
+    assert line().endswith("rowrot on (0 layers share one gate/up suh), order off); 2 of 2 MoE layers in scope")
+    monkeypatch.setenv(g53_experts.TIER_ENV, "192")                   # a tier, no knob
+    assert line().endswith("2 of 2 MoE layers in scope; tier TF_GLM_EXPERT_KERNEL_TIER_ROWS=192 with no schedule knob "
+                           "set: every window runs default_cfg")
+    monkeypatch.delenv(g53_experts.TIER_ENV)
+    _knobs(monkeypatch)                                                # the knobs, no tier: K1's line
+    assert line().endswith("2 of 2 MoE layers in scope; schedule mt 4 gw 16 nt 4 l2 1 for every window (the same bits)")
+    for n, span in (("192", "for windows of 192-256 rows, default_cfg's for 1-191"),
+                    ("256", "for windows of 256 rows, default_cfg's for 1-255"),
+                    ("1", "for every window"),
+                    ("1536", "for no window (windows here are at most 256 rows: every one runs default_cfg)")):
+        monkeypatch.setenv(g53_experts.TIER_ENV, n)
+        assert line().endswith(f"2 of 2 MoE layers in scope; schedule mt 4 gw 16 nt 4 l2 1 {span} (tier "
+                               f"TF_GLM_EXPERT_KERNEL_TIER_ROWS={n}; the same bits)"), n
+    monkeypatch.setenv(g53_experts.TIER_ENV, "1536")                  # 2,048-row prompt windows, as served
+    got = line(2048)
+    assert "TF_GLM_EXPERT_KERNEL=g53: prompt chunks of 1-2048 rows through glm53f-afd's large-M expert kernels" in got
+    assert got.endswith("2 of 2 MoE layers in scope; schedule mt 4 gw 16 nt 4 l2 1 for windows of 1536-2048 rows, "
+                        "default_cfg's for 1-1535 (tier TF_GLM_EXPERT_KERNEL_TIER_ROWS=1536; the same bits)")
+
