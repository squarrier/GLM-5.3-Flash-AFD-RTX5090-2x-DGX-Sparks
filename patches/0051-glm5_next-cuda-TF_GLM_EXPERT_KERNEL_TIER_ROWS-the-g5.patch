diff --git a/tests/test_glm_g53_tier.py b/tests/test_glm_g53_tier.py
new file mode 100644
index 0000000..aa72737
--- /dev/null
+++ b/tests/test_glm_g53_tier.py
@@ -0,0 +1,237 @@
+"""The g53 schedule tier, TF_GLM_EXPERT_KERNEL_TIER_ROWS (expert prompt kernels from glm53f-afd, written by Hugh Madden
+(@dangerm00se, github.com/hughmadden), glm53f-afd @ 91db3cc, MIT, Copyright (c) 2026 Turquoise Bay AI Pty Ltd). CPU
+only:
+
+- unset, nothing changes: switch() gives no tier, the knobs set apply to every window, and the node calls routed() and
+  prints its line as before;
+- set to N: the schedule the knobs set runs windows of N rows and up, smaller windows keep default_cfg's; bad values
+  refuse, and so do the fields that change bits (sk, skd, SwiGLU); it is read only under TF_GLM_EXPERT_KERNEL=g53; the
+  node's start line names the tier;
+- tests/glm_g53_schedule.py's emulation of the kernels' work decomposition at 1,024- and 2,048-row windows, with N
+  1,536 and the knobs of glm53f-rank's above-2,048-row schedule (mt 4, gw 16, nt 4, l2 1): the 1,024-row window runs
+  default_cfg's schedule and the 2,048-row one the tuned schedule, and a row's bits are the same in either window and
+  equal to the default schedule's.
+
+The GPU test (tests/cuda/test_glm_g53_kernel.py::test_tier_windows_keep_every_bit) checks the CUDA kernels' bytes for
+the same windows.
+"""
+
+from __future__ import annotations
+
+import gc
+from dataclasses import fields as dc_fields
+from dataclasses import replace
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from tensorfold.families.glm5_next.cuda import g53_experts
+from tests import glm_g53_schedule as sched
+from tests.test_glm_g53_kernel import _layer, _node
+
+KNOBS = {field: name for field, (name, _) in g53_experts.SCHEDULE_ENVS.items()}
+ENVS = (g53_experts.ENV, g53_experts.ROWS_ENV, g53_experts.ROWROT_ENV, g53_experts.ORDER_ENV, g53_experts.TIER_ENV,
+        *KNOBS.values())
+BIG = {"mt": 4, "gw": 16, "nt": 4, "l2": 1}       # glm53f-rank's own schedule above 2,048 rows
+BASE = {"min_rows": 1, "rowrot": True, "order": False}
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    for k in ENVS:
+        monkeypatch.delenv(k, raising=False)
+
+
+def _knobs(monkeypatch, fields=BIG, tier=None):
+    monkeypatch.setenv(g53_experts.ENV, "g53")
+    for field, v in fields.items():
+        monkeypatch.setenv(KNOBS[field], str(v))
+    if tier is not None:
+        monkeypatch.setenv(g53_experts.TIER_ENV, tier)
+
+
+# ------------------------------------------------------------------------------------------------------- the knob
+
+def test_name():
+    assert g53_experts.TIER_ENV == "TF_GLM_EXPERT_KERNEL_TIER_ROWS"
+    assert g53_experts.TIER_ENV not in KNOBS.values()           # not a configuration field
+
+
+def test_unset_tier_is_the_behaviour_before(monkeypatch):
+    _knobs(monkeypatch)
+    assert g53_experts.switch() == {**BASE, "schedule": BIG}                      # no "tier_rows" key
+    monkeypatch.setenv(g53_experts.TIER_ENV, " ")                                 # empty is unset
+    assert g53_experts.switch() == {**BASE, "schedule": BIG}
+    for R in range(1, g53_experts.MAX_ROWS + 1):                 # the knobs on every window, as K1 ran them
+        want = replace(g53_experts.default_cfg(R), **BIG)
+        assert g53_experts.tuned_cfg(R, fields=BIG) == want
+        assert g53_experts.tuned_cfg(R, fields=BIG, tier=None) == want
+    monkeypatch.delenv(KNOBS["mt"])
+    for k in BIG:
+        monkeypatch.delenv(KNOBS[k], raising=False)
+    assert g53_experts.switch() == BASE
+
+
+def test_tier_runs_the_schedule_on_windows_of_n_rows_and_up(monkeypatch):
+    _knobs(monkeypatch, tier=" 1536 ")
+    s = g53_experts.switch()
+    assert s == {**BASE, "schedule": BIG, "tier_rows": 1536}
+    bits = set()
+    for R in range(1, g53_experts.MAX_ROWS + 1):
+        for rowrot, order in ((True, False), (False, True)):
+            d = g53_experts.default_cfg(R, rowrot=rowrot, order=order)
+            c = g53_experts.tuned_cfg(R, rowrot=rowrot, order=order, fields=s["schedule"], tier=s["tier_rows"])
+            assert c == (d if R < 1536 else replace(d, **BIG)), (R, rowrot, order)
+            bits.add((c.sk, c.skd, c.swiglu))
+    assert bits == {(1, 1, 0)}                     # one set of bit fields for every window: a row's bits whatever it
+    for n, below, above in ((1, None, 1), (2048, 2047, 2048), (4096, 4095, 4096)):
+        if below is not None:
