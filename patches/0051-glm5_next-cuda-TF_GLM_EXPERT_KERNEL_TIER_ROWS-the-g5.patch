+def test_node_runs_default_cfg_under_the_tier_and_the_schedule_from_it(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    seen = []
+    monkeypatch.setattr(g53_experts, "routed", lambda x, pick, wts, ex, s, out, R, limit, *a, **k: seen.append(
+        (R, a, k)) or out[:R])
+    _, node = _node(monkeypatch)
+    node.buf = experts_node.ExpertBuffers(node.cfg, rows=8, prefill_rows=2048, device="cpu")
+    sizes = (1, 70, 1024, 1535, 1536, 2047, 2048)
+    h = g53_experts.Node(node, {**BASE, "schedule": BIG, "tier_rows": 1536})
+    assert h.tier == 1536 and h.max_rows == 2048 and h.scratch._own is None
+    for R in sizes:
+        h.compute(3, R)
+    want = [g53_experts.default_cfg(R) if R < 1536 else replace(g53_experts.default_cfg(R), **BIG) for R in sizes]
+    assert seen == [(R, (c,), {}) for R, c in zip(sizes, want)]
+    seen.clear()
+    h = g53_experts.Node(node, {**BASE, "schedule": BIG})            # unset: the knobs on every window, as before
+    for R in sizes:
+        h.compute(3, R)
+    assert seen == [(R, (replace(g53_experts.default_cfg(R), **BIG),), {}) for R in sizes]
+    seen.clear()
+    h = g53_experts.Node(node, {**BASE, "tier_rows": 1536})          # a tier with no knob: the call before
+    for R in (1, 2048):
+        h.compute(3, R)
+    assert seen == [(R, (), {"rowrot": True, "order": False}) for R in (1, 2048)]
+    del h, node                                                      # ~2 GB of CPU buffers
+    gc.collect()
+
