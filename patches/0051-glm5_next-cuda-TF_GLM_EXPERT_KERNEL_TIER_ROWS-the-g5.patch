+def _expert_node(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    cfg = SimpleNamespace(hidden=4096, top_k=8, moe_width=2048, experts=288, limit=10.0)
+    monkeypatch.setattr(experts_node.Config, "read", staticmethod(lambda _d: cfg))
+    monkeypatch.setattr(experts_node, "load_half", lambda _d, _h, layers, device="cuda": [_layer() for _ in layers])
+    real = experts_node.ExpertBuffers
+
+    def cpu_buffers(c, rows, prefill_rows, device):
+        return real(c, rows=rows, prefill_rows=prefill_rows, device="cpu")
+
+    monkeypatch.setattr(experts_node, "ExpertBuffers", cpu_buffers)
+    return lambda prefill_rows: experts_node.ExpertNode("/nowhere", 1, [3, 4], prefill_rows=prefill_rows)
+
