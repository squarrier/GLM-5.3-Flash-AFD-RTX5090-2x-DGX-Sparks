+++ b/tests/test_glm_cap_recency.py
@@ -0,0 +1,120 @@
+"""TF_GLM_CAP_SHARED_RECENCY (MiaAI-Lab recipe patch 0077; the diagnosis and the fix proposed by meleesciony, the
+recipe's issue #75): past TF_GLM_CACHE_ENTRIES, a shared-prefix state goes by recency only, never as superseded by its
+writer's longer state, on the CPU.
+
+Recipe patch 0063's ``cap_victim`` drops superseded states first: a state shorter than another in its extent. A run of
+an agent keeps its system block's shared-prefix state and its own longer state in one extent, so once every other kept
+prompt is some conversation's latest state, the new run's system-block state is the only superseded entry and goes at
+its next kept state, and the agent's next run reads its whole prompt again. 0077's ``cap_victim`` (here
+``cap_victim_recency``) still drops a conversation's earlier non-shared states first, then the least recently used of
+any. Covered: the order (the recipe's own function and this tree's, on the same kept lists), and the agent's next run
+at two ranks and at world 1 over the fake AFD wire (every reply checked against the request served alone).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+pytestmark = pytest.mark.torch
+
+fake = tm.fake
+afd_fake = ta.afd_fake
+
+HEAD, USER, TAIL = [40, 41, 42], 43, [45, 46, 39]      # [gMASK]<sop><|system|>, <|user|>, the tail
+LEAST = 256                                            # TF_GLM_SHARED_PREFIX=1
+
+
+def benchy(context, user):
+    return HEAD + list(context) + [USER] + list(user) + TAIL
+
+
+def test_the_switch(fake, monkeypatch):
+    from tensorfold.families.glm5_next.cuda.multi import recipe_switch
+
+    assert [recipe_switch("TF_GLM_CAP_SHARED_RECENCY", v) for v in ("", "0", "1")] == [False, False, True]
+    monkeypatch.delenv("TF_GLM_CAP_SHARED_RECENCY", raising=False)
+    assert not tm.Pair(fake, streams=2, blocks=4).d[0].cap_recency
+    monkeypatch.setenv("TF_GLM_CAP_SHARED_RECENCY", "1")
+    assert all(d.cap_recency for d in tm.Pair(fake, streams=2, blocks=4).d)
+    monkeypatch.setenv("TF_GLM_CAP_SHARED_RECENCY", "true")
+    with pytest.raises(ValueError, match="TF_GLM_CAP_SHARED_RECENCY"):
+        tm.Pair(fake, streams=2, blocks=4)
+
+
+def _kept(n, extent, shared=False):
+    from types import SimpleNamespace
+
+    return SimpleNamespace(ids=[0] * n, extent=extent, shared=shared)
+
+
+def test_the_order():
+    """0063 drops the system-block state its writer's longer state supersedes; 0077 keeps it (by recency) and drops
+    the least recently used entry; a conversation's earlier non-shared state still goes first under both."""
+    from tensorfold.families.glm5_next.cuda.multi import cap_victim, cap_victim_recency
+
+    x1, x2, run = object(), object(), object()
+    other1, other2 = _kept(900, x1), _kept(700, x2)
+    system, own = _kept(600, run, shared=True), _kept(650, run)
+    kept = [other1, other2, system, own]                 # least recently used first
+    assert cap_victim(kept) is system
+    assert cap_victim_recency(kept) is other1
+    earlier = _kept(300, x2)                             # conversation 2's earlier turn: superseded, not shared
+    kept = [other1, system, earlier, other2, own]
+    assert cap_victim(kept) is earlier and cap_victim_recency(kept) is earlier
+    assert cap_victim([other1]) is other1 and cap_victim_recency([other1]) is other1
+
+
+def agent_runs(torch, node, gs, d) -> dict:
+    """Two conversations keep one state each; an agent's run keeps its system block's state and its own (4 kept,
+    the cap 3); then the agent's next run, with the same system prompt and a new user turn."""
+
+    for g in gs:
+        g.shared, g.opener = LEAST, USER if g.rank == 0 else None
+    for seed in (600, 601):
+        s = node.submit(tm._prompt(700, seed), 4, None)
+        node.run()
+        assert s.got == tm.solo(torch, s.prompt, 4, None)
+    context = tm._prompt(600, 610)
+    at = len(HEAD) + 600
+    first = benchy(context, tm._prompt(40, 611))
+    s = node.submit(first, 8, None)
+    node.run()
+    assert s.cached == 0 and s.got == tm.solo(torch, first, 8, None)
+    kept = sorted(len(k.ids) for k in d.kept)
+    second = benchy(context, tm._prompt(50, 612))
+    nxt = node.submit(second, 8, tm._sampling("topk", 3))
+    node.run()
+    assert nxt.got == tm.solo(torch, second, 8, tm._sampling("topk", 3))
+    return {"kept": kept, "at": at, "cached": nxt.cached}
+
+
+@pytest.mark.parametrize("copy", ["", "1"], ids=["takeover", "copy"])
+@pytest.mark.parametrize("recency", ["", "1"], ids=["off", "on"])
+def test_the_agents_next_run_resumes_its_system_prompt(fake, monkeypatch, recency, copy):
+    """Two ranks, the cap at 3: off, the run's system-block state is dropped as superseded, and the next run reads its
+    whole prompt again; on, it stays and the next run resumes the system block. With TF_GLM_SHARED_PREFIX_COPY=1
+    (patch 0071, which made this common in the recipe) the same."""
+
+    monkeypatch.setenv("TF_GLM_CAP_SHARED_RECENCY", recency)
+    monkeypatch.setenv("TF_GLM_SHARED_PREFIX_COPY", copy)
+    p = tm.Pair(fake, streams=2, blocks=8, entries=3)
+    out = agent_runs(fake, p, p.g, p.d[0])
+    p.check()
+    if recency:
+        assert out["at"] in out["kept"] and out["cached"] == out["at"]
+    else:
+        assert out["at"] not in out["kept"] and out["cached"] == 0
+
+
+@pytest.mark.parametrize("recency", ["", "1"], ids=["off", "on"])
+def test_world1_afd(afd_fake, monkeypatch, recency):
+    """The AFD attention node (world 1 over the fake AFD wire): the same as two ranks."""
+
+    monkeypatch.setenv("TF_GLM_CAP_SHARED_RECENCY", recency)
+    n1 = ta.World1(afd_fake, streams=2, entries=3)
+    out = agent_runs(afd_fake.torch, n1, [n1.g], n1.d)
+    assert out["cached"] == (out["at"] if recency else 0)
