+    return {"greedy": None, "topk": Sampling(seed, 1.0, 20, 0.95), "nucleus": Sampling(seed, 1.0, 0, 0.9),
+            "minp": Sampling(seed, 0.8, 12, 1.0, 0.05)}[kind]
