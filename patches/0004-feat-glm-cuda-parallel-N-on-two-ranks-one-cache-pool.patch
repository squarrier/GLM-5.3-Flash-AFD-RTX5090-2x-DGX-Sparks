+CASES = [(_prompt(37, 1), 60, "topk", "f3", True), (_prompt(150, 2), 50, "greedy", "f5", True),
+         (_prompt(90, 3), 45, "nucleus", "0", False), (_prompt(210, 4), 55, "minp", "2", True),
