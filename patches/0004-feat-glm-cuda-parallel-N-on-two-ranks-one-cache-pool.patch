+class _Twice:
+    """Two ranks of the same shard: every all-gather hands back this rank's words twice."""
+
+    rank, world = 0, 2
+
+    def all_gather(self, send, recv) -> None:
+        n = send.numel()
+        recv.view(-1)[:n].copy_(send.reshape(-1))
+        recv.view(-1)[n:2 * n].copy_(send.reshape(-1))
