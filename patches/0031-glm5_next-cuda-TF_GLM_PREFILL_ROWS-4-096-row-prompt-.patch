+def prefill_rows_from_env(value: str | None = None) -> int:
+    """TF_GLM_PREFILL_ROWS (MiaAI-Lab recipe patches 0004, 0008): the rows a prompt chunk runs at once, a multiple
+    of 64 from 64 to 16,384; unset or empty: ``geometry.PREFILL_ROWS`` (2,048), as before. More rows amortize each
+    chunk's expert weight decode over more tokens and cost buffer memory. Both ranks alike; under AFD the expert
+    nodes size their scratch and wire slots off the settings handshake's ``prefill_rows``, and every MCDMA mailbox
+    must carry a chunk of these rows (``Layout.mib``; the driver's REQ_MIB / REP_MIB)."""
+
+    from tensorfold.cuda.geometry import PREFILL_ROWS
+
+    value = (os.environ.get("TF_GLM_PREFILL_ROWS", "") if value is None else value).strip()
+    rows = PREFILL_ROWS if value == "" else int(value) if value.isdecimal() else -1
+    if not 64 <= rows <= 16384 or rows % 64:
+        raise ValueError(f"TF_GLM_PREFILL_ROWS: prefill rows, a multiple of 64 from 64 to 16,384, not {value!r}")
+    return rows
+
