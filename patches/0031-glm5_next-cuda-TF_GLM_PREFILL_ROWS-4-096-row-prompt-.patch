+# -- KDA's chunked form, the EXL3 prompt plan ------------------------------------------------------------------------------------
+
+@pytest.mark.parametrize("cut,total", [(2048, 4096), (2048, 2048 + 16), (2048, 2048 + 100)])
+def test_kda_chunked_rows_do_not_depend_on_the_chunk(cut, total):
+    """The recipe's fp32 reference of the chunked kernel: a 4,096-row chunk == 2,048 + 2,048 (the state between),
+    and a 2,048 + t chunk == 2,048 then t: every cut on the 32-row sub-chunk grid keeps the bits."""
+
+    from tests.test_glm_kda_chunked import _kc, _rows
+
+    kc = _kc()
+    q, k, v, lg, beta, state = _rows(torch, total, 1, seed=total)
+    y, S = kc.chunked_reference(q, k, v, lg, beta, state, 0, dtype=torch.float32)
+    ya, Sa = kc.chunked_reference(q[:cut], k[:cut], v[:cut], lg[:cut], beta[:cut], state, 0, dtype=torch.float32)
+    yb, Sb = kc.chunked_reference(q[cut:], k[cut:], v[cut:], lg[cut:], beta[cut:], Sa, cut, dtype=torch.float32)
+    assert torch.equal(torch.cat([ya, yb]), y) and torch.equal(Sb, S)
+
