diff --git a/tests/test_glm_prefill_rows.py b/tests/test_glm_prefill_rows.py
new file mode 100644
index 0000000..4918e92
--- /dev/null
+++ b/tests/test_glm_prefill_rows.py
@@ -0,0 +1,323 @@
+"""TF_GLM_PREFILL_ROWS: 4,096-row prompt chunks and expert calls, the switch of MiaAI-Lab's recipe (patches
+0004 and 0008 read it in GlmEngine; our split engine had dropped the read), on the CPU.
+
+- The switch: unset or empty is 2,048, as before; her range (a multiple of 64 from 64 to 16,384) and her refusals.
+- What sizes off it: the estimate's prompt-chunk terms (``mla_geometry(prefill_rows=)``, default the bits before), the
+  pairs' second chunk, the expert node's buffers (the settings handshake's ``prefill_rows``), the MCDMA mailbox need
+  (``Layout.mib``: the driver's REQ_MIB / REP_MIB), the fill rows and the prompt grid.
+- Rows against chunk size, under the Triton interpreter (TRITON_INTERPRET=1, with ``test_glm_att6.bf16_dot``) and
+  the AFD release configuration's switches: a row's bits when it runs in one 4,096-row chunk against two 2,048-row chunks (``same``: the
+  same boundaries, the state between carried), and when it runs in a short tail chunk against inside the larger
+  chunk the switch makes (``tail``: a prompt of 2,048 + t rows is 2,048 + t at 2,048 rows, one chunk at 4,096).
+  ``cases`` also runs on a GPU (``test_cuda_rows``), the GPU identity step.
+- KDA's chunked form on the recipe's own fp32 reference (its CUDA kernel runs on the GPU only), and the EXL3 prompt kernel's plan
+  (her plan_kernel, modelled) at 4,096 rows: that kernel is CUDA, one fp32 chain a row (``exl3_mm.py:144-145`` in her
+  tree), so its rows' identity runs on a GPU.
+"""
+
+from __future__ import annotations
+
+import os
+import random
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests import test_glm_multi_afd as mafd
+
+pytestmark = pytest.mark.torch
+
+# the AFD release configuration's switches that the prompt-path kernels read per call
+RELEASE_ON = {"TF_GLM_LATENT_MMA": "1", "TF_GLM_HC_MMA": "1", "TF_GLM_SEQ_ROWS": "256", "TF_GLM_SPARSE_ONEPASS": "1",
+             "TF_GLM_PROMPT_DSA": "1", "TF_GLM_Q4_TILE": "table", "TF_GLM_LATENT_STAGES": "3",
+             "TF_GLM_KDA_WIDE_ROWS": "1", "TF_GLM_HC_DEC": "1", "TF_GLM_DECODE_SELECT": "1",
+             "TF_GLM_KDA_CHUNKED": "1"}
+
+
+# -- the switch -------------------------------------------------------------------------------------------------------
+
+def test_unset_is_2048_and_her_range(monkeypatch):
+    from tensorfold.cuda.geometry import PREFILL_ROWS
+    from tensorfold.families.glm5_next.cuda.engine import prefill_rows_from_env
+
+    monkeypatch.delenv("TF_GLM_PREFILL_ROWS", raising=False)
+    assert PREFILL_ROWS == 2048 and prefill_rows_from_env() == 2048
+    for value, rows in (("", 2048), (" ", 2048), ("2048", 2048), ("4096", 4096), ("64", 64), ("16384", 16384),
+                        (" 4096 ", 4096)):
+        monkeypatch.setenv("TF_GLM_PREFILL_ROWS", value)
+        assert prefill_rows_from_env() == rows
+        assert prefill_rows_from_env(value) == rows
+    for bad in ("4000", "32", "0", "16448", "32768", "-64", "4k", "4096.0"):
+        with pytest.raises(ValueError, match="TF_GLM_PREFILL_ROWS"):
+            prefill_rows_from_env(bad)
+
+
+def test_the_grid_and_fill_rows_take_4096():
+    from tensorfold.families.glm5_next.cuda.engine import prompt_grid
+    from tensorfold.families.glm5_next.cuda.multi import fill_rows
+
+    assert prompt_grid(4096, "", chunked=True) == 64 and prompt_grid(4096, "128") == 128
+    assert fill_rows(4096, "") == fill_rows(2048, "") == 1024                 # TF_GLM_FILL_ROWS' default unchanged
+    assert fill_rows(4096, "4096") == 4096
+    with pytest.raises(ValueError):
+        fill_rows(2048, "4096")
+
+
+def test_the_estimate_counts_the_chunk_rows():
+    """``mla_geometry``'s default is the 2,048-row estimate bit for bit; 4,096 rows grow only its prompt-chunk terms
+    (buffers, partials, selection, the rings), the same at every capacity (a fixed term), and the pairs' second chunk
+    doubles."""
+
+    from tensorfold.cuda.geometry import mla_geometry
+    from tensorfold.families.glm5_next.cuda import prefill_pairs
+
+    for kw in ({}, {"kv": "fp8", "ring_rows": 2048}):
+        base = dict(minimum_slots=2560, latent=True, mtp=False, exl3_scratch=False, decode_rows=72, **kw)
+        a = mla_geometry(mafd.GLM, 1, 8, **base)
+        b = mla_geometry(mafd.GLM, 1, 8, prefill_rows=2048, **base)
+        big = {**base, **({"ring_rows": 4096} if kw else {})}
+        c = mla_geometry(mafd.GLM, 1, 8, prefill_rows=4096, **big)
+        grow = [c.bytes_at(s) - a.bytes_at(s) for s in (2560, 262152, 727040)]
+        for slots in (2560, 262152, 727040):
+            assert a.bytes_at(slots) == b.bytes_at(slots) < c.bytes_at(slots)
+        assert min(grow) > 0 and grow[1] == grow[2]           # a fixed term once the fp8 ring is a chunk's
+    t = {"hidden_size": 4096, "hc_mult": 4}
+    for fly in ({}, {"flight": True}):
+        assert prefill_pairs.plan_bytes(t, 4096, taps=5, **fly) == 2 * prefill_pairs.plan_bytes(t, 2048, taps=5, **fly)
+
+
+def test_the_expert_node_and_the_mailboxes_size_off_the_rows():
+    """The expert node's buffers come from the handshake's ``prefill_rows`` (on the meta device here); a mailbox must
+    carry a chunk: 20 + 36 MiB at 2,048 rows, 36 + 68 MiB at 4,096 (mcdma-rpcd's req_mib / rep_mib)."""
+
+    from tensorfold.families.glm5_next.cuda import mcdma
+    from tensorfold.families.glm5_next.cuda.experts_node import ExpertBuffers
+
+    cfg = SimpleNamespace(hidden=4096, top_k=8, moe_width=2048, experts=288)
+    small = ExpertBuffers(cfg, rows=8, prefill_rows=2048, device="meta")
+    big = ExpertBuffers(cfg, rows=8, prefill_rows=4096, device="meta")
+    assert big.normed.shape == (4096, 4096) and big.routed.shape == (4096, 4096) and big.pref.rows == 4096
+    assert small.pref.rows == 2048 and big.decode.rows == small.decode.rows == 8
+    assert big.scratch(4096) is big.pref and big.scratch(8) is big.decode
+    assert big.ey(4096).shape == (4096, 9, 4096)
+    lay = mcdma.Layout(4096, 9)
+    assert lay.mib(2048) == (20, 36) and lay.mib(4096) == (36, 68)
+    assert lay.req(4096) == 33_849_600 and lay.rep(4096) == 2 * lay.rep(2048) == 67_108_864
+
+
+# -- rows against chunk size ------------------------------------------------------------------------------------------
+
+def _cmp(whole: torch.Tensor, parts: list[torch.Tensor]) -> tuple[bool, float]:
+    got = torch.cat(parts)
+    return bool(torch.equal(got, whole)), float((got.float() - whole.float()).abs().max())
+
+
+def cases(device: str = "cpu", setenv=None, *, rows: int = 4096, tails=(16, 100)) -> dict[str, tuple[bool, float]]:
+    """{path: (rows equal, max |difference|)} for each prompt-path kernel: ``same/...``: ``rows`` rows in one call
+    against two calls of ``rows // 2`` (state and caches between, as the engine carries them); ``tail{t}/...``:
+    ``half + t`` rows in one call against ``half`` then ``t``. The attention kernels whose cost grows with the
+    context (dense attention, token selection) run at 1,024 rows against 512 + 512: their sub-blocks (MLA_SELECT_ROWS,
+    MLA_PROMPT_ATT_ROWS: 512) and pool counts step the same way as 4,096 against 2,048."""
+
+    from tensorfold.families.glm5_next.cuda import forward, glue, latent, qmm, sparse
+    from tests.test_glm_att6 import _f8, _randn
+
+    setenv = setenv or os.environ.__setitem__
+    for name, value in RELEASE_ON.items():
+        setenv(name, value)
+    dev, out = device, {}
+    half = rows // 2
+
+    def splits(total: int, cut: int):
+        return [(0, cut), (cut, total)]
+
+    def run_rows(tag: str, total: int, cut: int, fn):
+        try:
+            whole = fn(0, total)
+            out[tag] = _cmp(whole, [fn(a, b) for a, b in splits(total, cut)])
+        except Exception as e:  # noqa: BLE001  (recorded: the test fails on any None)
+            print(f"{tag}: {type(e).__name__}: {e}")
+            out[tag] = (None, -1.0)
+
+    # absorb / expand (TF_GLM_LATENT_MMA), H=2 heads of 128 -> 256 latent columns
+    H, D, LW, DV = 2, 128, 256, 128
+    a = latent.AbsorbW(_randn((H, D, LW), 2, 0.05, device=dev), _randn((H, DV, LW), 3, 0.05, device=dev))
+    for tag, total, cut in [("same", rows, half)] + [(f"tail{t}", half + t, half) for t in tails]:
+        q = _randn((total, H, D), 1, device=dev)
+        v = _randn((total, H, LW), 4, device=dev)
+
+        def absorb(r0, r1, q=q):
+            o = torch.empty((r1 - r0, H, LW), dtype=torch.bfloat16, device=dev)
+            latent.absorb_q(q[r0:r1].contiguous(), a, o, prompt=True)
+            return o
+
+        def expand(r0, r1, v=v):
+            o = torch.empty((r1 - r0, H, DV), dtype=torch.bfloat16, device=dev)
+            latent.expand_v(v[r0:r1].contiguous(), a, o, prompt=True)
+            return o
+
+        run_rows(f"{tag}/absorb_mma", total, cut, absorb)
+        run_rows(f"{tag}/expand_mma", total, cut, expand)
+
+    # hyper-connections' pre pass (TF_GLM_HC_MMA), 4 streams of 512
+    S, DH = 4, 512
+    fn_w = _randn((24, S * DH), 6, 0.05, device=dev)
+    base = _randn((24,), 7, 0.1, torch.float32, device=dev)
+    scale = torch.tensor([0.5, 0.25, 0.125], device=dev)
+    norm_w = _randn((DH,), 8, 0.1, device=dev).float() + 1.0
+    for tag, total, cut in [("same", rows, half)] + [(f"tail{t}", half + t, half) for t in tails]:
+        x = _randn((total, S * DH), 5, device=dev)
+
+        def hc(r0, r1, x=x):
+            n = r1 - r0
+            bufs = (torch.empty((n, DH), dtype=torch.bfloat16, device=dev), torch.empty((n, DH // 64), device=dev),
+                    torch.empty((n, S), device=dev), torch.empty((n, S * S), device=dev),
+                    torch.zeros((n, glue.HC_BLOCKS, 32), device=dev))
+            glue.hc_pre(x[r0:r1].contiguous(), fn_w, base, scale, norm_w, *bufs, 1e-6, 1e-6, 3, prompt=True)
+            return torch.cat([bufs[0].float(), bufs[2], bufs[3]], 1)
+
+        run_rows(f"{tag}/hc_mma", total, cut, hc)
+
+    # dense prompt matmuls (TF_GLM_SEQ_ROWS=256, TF_GLM_Q4_TILE=table): bf16 and fp8 (Triton); the q4 dense weights
+    # on a GPU only (a capability-12 GPU runs them in the qmm_group CUDA kernel, group_tile 11 for every chunk past
+    # 96 rows, its split-K by shape)
+    N, K = 512, 1024
+    w = _randn((N, K), 10, 0.05, device=dev)
+    weights = {"b16": qmm.B16(weight=w.contiguous(), n=N, k=K), "f8": _f8(w)}
+    if dev != "cpu":
+        weights["q4"] = qmm.make_dense_q4(w)
+    for tag, total, cut in [("same", rows, half)] + [(f"tail{t}", half + t, half) for t in tails]:
+        xm = _randn((total, K), 9, device=dev)
+        for kind, wq in weights.items():
+            run_rows(f"{tag}/matmul_{kind}", total, cut,
+                     lambda r0, r1, xm=xm, wq=wq: qmm.matmul(xm[r0:r1].contiguous(), wq))
+
+    # one-pass sparse attention (TF_GLM_SPARSE_ONEPASS): rows over their own token lists
+    RS, HS, NC = 8, 16, 600
+    qa = _randn((RS, HS, 512), 11, device=dev)
+    cache = _randn((NC, 512), 12, device=dev).contiguous()
+    counts = torch.tensor([100, 37, 0, 64, 600, 1, 333, 512], dtype=torch.int32)
+    tokens = torch.full((RS, sparse.TOKENS), -1, dtype=torch.int32)
+    for r in range(RS):
+        pick = torch.randperm(NC, generator=torch.Generator().manual_seed(20 + r))[: int(counts[r])].sort().values
+        tokens[r, : len(pick)] = pick.to(torch.int32)
+    counts, tokens = counts.to(dev), tokens.to(dev)
+
+    def onepass(r0, r1):
+        op = torch.zeros((r1 - r0, HS, 512), dtype=torch.bfloat16, device=dev)
+        latent.sparse_onepass(qa[r0:r1].contiguous(), cache, tokens[r0:r1].contiguous(), counts[r0:r1].contiguous(),
+                              op, 0.0625)
+        return op
+
+    run_rows("same/sparse_onepass", RS, RS // 2, onepass)
+    run_rows("tail1/sparse_onepass", RS, RS - 1, onepass)
+
+    # token selection (TF_GLM_PROMPT_DSA): 1,024 rows against 512 + 512 at positions 0 and 3,072 (where the first
+    # half scores 1,024 pools and the whole chunk 2,048), the capacity's pooled keys as the forward passes them
+    NP = 4096 // sparse.POOL * 2 + 2
+    pk = _randn((NP + 2, 128), 32, device=dev)
+    for pos in (0, 3072):
+        qi = _randn((1024, 32 * 128), 30 + pos, device=dev)
+        wts = _randn((1024, 32), 31 + pos, device=dev)
+
+        def select(r0, r1, pos=pos, qi=qi, wts=wts):
+            pd = torch.tensor([pos + r0], dtype=torch.int32, device=dev)
+            tok, cnt = sparse._select_prompt(qi[r0:r1].contiguous(), wts[r0:r1].contiguous(), pk, pos + r0, r1 - r0,
+                                             NP, pd)
+            keep = torch.where(cnt[:, None] > 0, tok, torch.full_like(tok, -7))
+            return torch.cat([cnt[:, None].to(torch.int64), keep.to(torch.int64)], 1)
+
+        run_rows(f"same/select_prompt_at_{pos}", 1024, 512, select)
+
+    # dense latent attention over the first rows (TF_GLM_PROMPT_DSA's lean rows, 512-row parts): 1,024 rows against
+    # 512 + 512, and a 16-row tail; 4 heads
+    HD, lw = 4, 512
+    lc = _randn((1024 + 600, lw), 41, device=dev)
+    for tag, total, cut in (("same", 1024, 512), ("tail16", 512 + 16, 512)):
+        qa3 = _randn((total, HD, lw), 40, device=dev)
+
+        def dense(r0, r1, qa3=qa3):
+            n = r1 - r0
+            nch = latent.chunks_for(r1)
+            s = latent.LatentScratch(n, HD, nch, dev, lw=lw, part_rows=512)
+            o = torch.zeros((n, HD, lw), dtype=torch.bfloat16, device=dev)
+            starts = torch.arange(0, n, 512, dtype=torch.int32, device=dev)
+            forward.dense_attention(qa3[r0:r1].contiguous(), lc, torch.tensor([r0], dtype=torch.int32, device=dev),
+                                    s, scale=0.0625, nch=nch, out=o, hb=latent.head_block(n), starts=starts)
+            return o
+
+        run_rows(f"{tag}/dense_attention", total, cut, dense)
+    return out
+
+
+# The interpreter's outcome at 4,096 rows: every path gives a row the same bits in one chunk as in two, and in a 16-
+# or 100-row tail as inside the larger chunk
+EXPECT: dict[str, bool] = {
+    f"{tag}/{path}": True
+    for tag in ("same", "tail16", "tail100")
+    for path in ("absorb_mma", "expand_mma", "hc_mma", "matmul_b16", "matmul_f8")
+} | {k: True for k in ("same/sparse_onepass", "tail1/sparse_onepass", "same/select_prompt_at_0",
+                       "same/select_prompt_at_3072", "same/dense_attention", "tail16/dense_attention")}
+
+
+@pytest.mark.skipif(os.environ.get("TRITON_INTERPRET") != "1", reason="the Triton interpreter (TRITON_INTERPRET=1)")
+def test_interpreter_rows(monkeypatch):
+    from tests.test_glm_att6 import bf16_dot
+
+    with bf16_dot():
+        got = cases("cpu", lambda k, v: monkeypatch.setenv(k, v))
+    path = os.environ.get("TF_TEST_ROWS_JSON")
+    if path:
+        import json
+
+        with open(path, "w") as f:
+            json.dump({k: list(v) for k, v in got.items()}, f, indent=1)
+    for name, want in EXPECT.items():
+        assert got[name][0] is want, (name, got[name])
+    assert all(v[0] is not None for v in got.values()), got
+    assert all(v[1] < 0.1 for k, v in got.items() if "select_prompt" not in k), got
