+def recipe_switch(env: str, value: str | None = None) -> bool:
+    """A MiaAI-Lab recipe behaviour that this tree ports behind a switch of its own (the recipe runs it always): 0 or
+    unset, off (the default: this tree's behaviour before the port); 1, on (the recipe's behaviour)."""
+
+    raw = os.environ.get(env, "") if value is None else value
