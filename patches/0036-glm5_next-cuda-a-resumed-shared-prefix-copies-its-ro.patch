diff --git a/tests/test_glm_shared_prefix_copy.py b/tests/test_glm_shared_prefix_copy.py
new file mode 100644
index 0000000..c7fb393
--- /dev/null
+++ b/tests/test_glm_shared_prefix_copy.py
@@ -0,0 +1,152 @@
+"""TF_GLM_SHARED_PREFIX_COPY (MiaAI-Lab recipe patch 0071, by ezoushen): a request that resumes a shared system prompt's
+kept state copies its rows into free rows of its own, so the conversation that wrote that state keeps its own, on the
+CPU with tests/test_glm_multi.py's fake model (two ranks, rank 1 applying rank 0's messages, and world 1 over the fake
+AFD wire; every reply checked against the request served alone).
+
+A shared-prefix state (TF_GLM_SHARED_PREFIX) lives in the extent of the conversation that wrote it, beside that
+conversation's own longer state. Another conversation with the same system prompt (an agent's sub-agent) resumes the
+shared state; unset, it takes that extent over and evicts the writer's longer state, so the writer's next turn reads
+its whole history again; set, it copies the shared rows into free rows and the writer's state stays. With no free rows,
+or with TF_GLM_MULTI_LONE=1, it behaves as before.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+pytestmark = pytest.mark.torch
+
+fake = tm.fake
+afd_fake = ta.afd_fake
+
+HEAD, USER, DOT, TAIL = [40, 41, 42], 43, 44, [45, 46, 39]      # [gMASK]<sop><|system|>, <|user|>, ".", the tail
+LEAST = 256                                                       # TF_GLM_SHARED_PREFIX=1
+
+
+def benchy(context, user):
+    return HEAD + list(context) + [USER] + list(user) + TAIL
+
+
+def sharing(gs) -> None:
+    """TF_GLM_SHARED_PREFIX on these engines (every rank); rank 0 knows ``<|user|>``."""
+    for g in gs:
+        g.shared, g.opener = LEAST, USER if g.rank == 0 else None
+
+
+def logged(g0) -> list:
+    """Rank 0's sent messages, in order."""
+    log: list = []
+    real = g0._share
+    g0._share = lambda values: (log.append(list(values)), real(values))[1]
+    return log
+
+
+def evictions(log) -> list[int]:
+    from tensorfold.families.glm5_next.cuda.multi import EVICT
+
+    return [pl[0] for m in log for op, pl in tm._ops(m) if op == EVICT]
+
+
+def test_the_switch(fake, monkeypatch):
+    from tensorfold.families.glm5_next.cuda.multi import recipe_switch
+
+    assert [recipe_switch("TF_GLM_SHARED_PREFIX_COPY", v) for v in ("", "0", " 0 ", "1", " 1")] == [False] * 3 + [True] * 2
+    with pytest.raises(ValueError, match="TF_GLM_SHARED_PREFIX_COPY"):
+        recipe_switch("TF_GLM_SHARED_PREFIX_COPY", "on")
+    monkeypatch.delenv("TF_GLM_SHARED_PREFIX_COPY", raising=False)
+    assert not tm.Pair(fake, streams=2, blocks=4).d[0].share_copy
+    monkeypatch.setenv("TF_GLM_SHARED_PREFIX_COPY", "1")
+    assert all(d.share_copy for d in tm.Pair(fake, streams=2, blocks=4).d)
+    monkeypatch.setenv("TF_GLM_SHARED_PREFIX_COPY", "2")
+    with pytest.raises(ValueError, match="TF_GLM_SHARED_PREFIX_COPY"):
+        tm.Pair(fake, streams=2, blocks=4)
+
+
+def agent_and_subagent(torch, node, g0, *, copy: bool, fill=None) -> dict:
+    """Conversation A (the system block, then its own user turn) keeps the shared state and its own; conversation B
+    with the same system prompt resumes the shared state; then A takes its next turn. ``fill``: another conversation
+    served between A and B (to leave no free rows)."""
+
+    sharing([g0] if not isinstance(node, tm.Pair) else node.g)
+    d = node.d[0] if isinstance(node.d, list) else node.d
+    context = tm._prompt(600, 500)
+    at = len(HEAD) + 600
+    a = benchy(context, tm._prompt(40, 501))
+    first = node.submit(a, 12, None)
+    node.run()
+    assert [(len(k.ids), k.shared) for k in d.kept] == [(at, True), (len(a) - 1, False)]
+    if fill is not None:
+        node.submit(fill, 4, None)
+        node.run()
+    log = logged(g0)
+    b = benchy(context, tm._prompt(64, 502))
+    second = node.submit(b, 16, None)
+    assert second.cached == at                                      # B resumes the system block either way
+    node.run()
+    assert second.got == tm.solo(torch, b, 16, None)
+    out = {"evicted": evictions(log), "kept": sorted(len(k.ids) for k in d.kept), "a": len(a) - 1}
+    turn = a + first.got + [USER] + tm._prompt(30, 503) + TAIL
+    nxt = node.submit(turn, 20, tm._sampling("topk", 3))
+    out["turn_cached"] = nxt.cached
+    node.run()
+    assert nxt.got == tm.solo(torch, turn, 20, tm._sampling("topk", 3))
+    assert first.got == tm.solo(torch, a, 12, None)
+    out["at"] = at
+    return out
+
+
+@pytest.mark.parametrize("copy", ["", "1"], ids=["off", "on"])
+def test_a_subagent_resuming_the_system_block_keeps_the_writers_state(fake, monkeypatch, copy):
+    """Two ranks with free rows: unset, B evicts A's own state (the in-place takeover) and A's next turn resumes only
+    the system block; set, B's rows are a copy, nothing is evicted, and A's next turn resumes its whole first turn."""
+
+    monkeypatch.setenv("TF_GLM_SHARED_PREFIX_COPY", copy)
+    p = tm.Pair(fake, streams=2, blocks=8)
+    out = agent_and_subagent(fake, p, p.g[0], copy=bool(copy))
+    p.check()
+    if copy:
+        assert out["evicted"] == [] and out["a"] in out["kept"] and out["turn_cached"] == out["a"]
+    else:
+        assert len(out["evicted"]) == 1 and out["a"] not in out["kept"] and out["turn_cached"] == out["at"]
+
+
+def test_without_free_rows_the_rows_are_overwritten_as_before(fake, monkeypatch):
+    """Set, but the pool's only other block holds another conversation's kept prompt: no free rows, so B takes the
+    extent over and evicts A's state as before (evicting a third conversation to copy would cost more)."""
+
+    monkeypatch.setenv("TF_GLM_SHARED_PREFIX_COPY", "1")
+    p = tm.Pair(fake, streams=2, blocks=2)
+    out = agent_and_subagent(fake, p, p.g[0], copy=True, fill=tm._prompt(1500, 504))
+    p.check()
+    assert len(out["evicted"]) == 1 and out["a"] not in out["kept"] and out["turn_cached"] == out["at"]
+
+
+def test_a_lone_stream_setting_keeps_the_takeover(fake, monkeypatch):
+    """Set with TF_GLM_MULTI_LONE=1: the in-place takeover as before (the recipe's rule: a copy decoding alone would
+    move home and evict the writer's extent there)."""
+
+    monkeypatch.setenv("TF_GLM_SHARED_PREFIX_COPY", "1")
+    monkeypatch.setenv("TF_GLM_MULTI_LONE", "1")
+    p = tm.Pair(fake, streams=2, blocks=8)
+    out = agent_and_subagent(fake, p, p.g[0], copy=True)
+    p.check()
+    assert len(out["evicted"]) == 1 and out["turn_cached"] == out["at"]
+
+
+@pytest.mark.parametrize("copy", ["", "1"], ids=["off", "on"])
+def test_world1_afd(afd_fake, monkeypatch, copy):
+    """The AFD attention node (world 1 over the fake AFD wire): the same as two ranks. The host RAM tier unset: with
+    it, the takeover's eviction parks the writer's state, which its next turn resumes from host RAM
+    (tests/test_glm_recipe_host_tier.py)."""
+
+    monkeypatch.setenv("TF_GLM_SHARED_PREFIX_COPY", copy)
+    for name in ("TF_GLM_KEPT_HOST", "TF_GLM_HOST_CACHE_GIB"):
+        monkeypatch.delenv(name, raising=False)
+    n1 = ta.World1(afd_fake, streams=2)
+    out = agent_and_subagent(afd_fake.torch, n1, n1.g, copy=bool(copy))
+    assert n1.d.world == 1
+    assert out["turn_cached"] == (out["a"] if copy else out["at"])
