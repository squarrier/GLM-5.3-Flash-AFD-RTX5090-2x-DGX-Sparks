index 0000000..930b05a
--- /dev/null
+++ b/tests/test_cuda_capacity_status.py
@@ -0,0 +1,207 @@
+"""MiaAI-Lab recipe patch 0081 (by johnwhited), ``TF_GLM_CAPACITY_STATUS``: every API layer renders a capacity refusal
+as 429 with ``Retry-After: 5``; unset or 0, TensorFold v0.6.5's 503 without the header. CPU only: the CUDA server's
+handler over a stand-in app (tests/test_cuda_server_errors.py's, without the tokenizers package), and the generic
+server's handler on its tokenizer route."""
+
+from __future__ import annotations
+
+import http.client
+import json
+import threading
+from contextlib import contextmanager
+from http.server import ThreadingHTTPServer
+from types import SimpleNamespace
+
+import pytest
+
+from tensorfold.cuda import server
+from tensorfold.server.errors import (
+    CapacityError,
+    RequestError,
+    admission_response,
+    capacity_status,
+    capacity_status_on,
+)
+
+pytest.importorskip("jinja2")                    # the chat template
+
+TEMPLATE = "{%- for m in messages %}{{ m.role }}:{{ m.content }};{% endfor %}assistant:"
+HI = [{"role": "user", "content": "Hi"}]
+EOS = 0
+BUSY = "all serving lanes are busy; retry shortly"
+
+
+class Tok:
+    def encode(self, text, **kwargs):
+        return SimpleNamespace(ids=[ord(c) for c in text])
+
+    def decode(self, ids, **kwargs):
+        return "".join(chr(c) for c in ids)
+
+
+class Engine:
+    eos = (EOS,)
+
+    def __init__(self):
+        self.fail = None          # an exception generate raises (a scheduler's refusal reaches the server this way)
+
+    def generate(self, prompt, max_tokens, sampling, on_tokens, draft=True):
+        if self.fail is not None:
+            raise self.fail
+        on_tokens([ord(c) for c in "Hello"] + [EOS])
+        return {"generated": 6}
+
+
+def make_app(tmp_path):
+    (tmp_path / "tokenizer_config.json").write_text(json.dumps({"chat_template": TEMPLATE}))
+    app = server.App.__new__(server.App)
+    app.engine = Engine()
+    app.served = "fake-cuda"
+    app.tok = Tok()
+    app.template = server.ChatTemplate(tmp_path)
+    app.default_thinking = False
+    app.sampling = {"temperature": 1.0, "top_k": 20, "top_p": 0.95}
+    app.max_tokens = 64
+    app.native_context_window = app.context_window = 0
+    app.lock = threading.Lock()
+    return app
+
+
+@contextmanager
+def http_server(app):
+    class QuietServer(ThreadingHTTPServer):
+        def handle_error(self, request, client_address):
+            pass
+    httpd = QuietServer(("127.0.0.1", 0), server.make_handler(app))
+    worker = threading.Thread(target=httpd.serve_forever, kwargs={"poll_interval": 0.01}, daemon=True)
+    worker.start()
+    try:
+        yield httpd.server_port
+    finally:
+        httpd.shutdown()
+        httpd.server_close()
+        worker.join()
+
+
+def post(port, body, path="/v1/chat/completions"):
+    """(status, Retry-After or None, body text)."""
+
+    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=10)
+    try:
+        connection.request("POST", path, json.dumps(body), {"Content-Type": "application/json"})
+        response = connection.getresponse()
+        return response.status, response.getheader("Retry-After"), response.read().decode()
+    finally:
+        connection.close()
+
+
+@pytest.fixture(params=["", "1"], ids=["unset", "on"])
+def status(monkeypatch, request):
+    """TF_GLM_CAPACITY_STATUS's value, and the (status, Retry-After) a capacity refusal must get with it."""
+
+    monkeypatch.setenv("TF_GLM_CAPACITY_STATUS", request.param)
+    return (429, "5") if request.param == "1" else (503, None)
+
+
+def test_the_switch_reads_0_or_1(monkeypatch):
+    assert capacity_status("") is False and capacity_status("0") is False and capacity_status(" 1") is True
+    with pytest.raises(ValueError, match="TF_GLM_CAPACITY_STATUS"):
+        capacity_status("429")
+    monkeypatch.setenv("TF_GLM_CAPACITY_STATUS", "429")
+    assert capacity_status_on() is False            # a refusal never fails on the setting (refused at start)
+
+
+def test_admission_response(status):
+    assert admission_response(CapacityError(BUSY)) == (status[0], {"Retry-After": "5"} if status[1] else None)
+    assert admission_response(RequestError("bad")) == (400, None)
+
+
+@pytest.mark.parametrize("site", ["prepare", "run"])
+def test_a_capacity_refusal_of_a_non_streamed_request(tmp_path, monkeypatch, status, site):
+    app = make_app(tmp_path)
+    if site == "prepare":
+        monkeypatch.setattr(app, "prepare", lambda body, chat: (_ for _ in ()).throw(CapacityError(BUSY)),
+                            raising=False)
+    else:
+        app.engine.fail = CapacityError(BUSY)
+    with http_server(app) as port:
+        code, retry, text = post(port, {"messages": HI, "max_tokens": 4})
+    assert (code, retry) == status
+    assert json.loads(text)["error"]["message"] == BUSY
+
+
+def test_a_capacity_refusal_on_the_tokenizer_route(tmp_path, monkeypatch, status):
+    app = make_app(tmp_path)
+    monkeypatch.setattr(app, "tokenize", lambda body: (_ for _ in ()).throw(CapacityError(BUSY)), raising=False)
+    with http_server(app) as port:
+        code, retry, text = post(port, {"prompt": "hi"}, "/tokenize")
+    assert (code, retry) == status and json.loads(text)["error"]["message"] == BUSY
+
+
+def test_other_refusals_stay_400_without_a_retry_hint(tmp_path, status):
+    app = make_app(tmp_path)
+    app.engine.fail = RequestError("not this one")
+    with http_server(app) as port:
+        assert post(port, {"messages": HI, "max_tokens": 4})[:2] == (400, None)
+
+
+def test_a_streamed_refusal_is_still_an_error_event_after_the_headers(tmp_path, status):
+    """The 200 and the event stream's headers go out before the engine runs (as in the recipe): a refusal there is
+    the stream's error event either way."""
+
+    app = make_app(tmp_path)
+    app.engine.fail = CapacityError(BUSY)
+    with http_server(app) as port:
+        code, retry, text = post(port, {"messages": HI, "max_tokens": 4, "stream": True})
+    assert (code, retry) == (200, None)
+    assert BUSY in text and text.rstrip().endswith("data: [DONE]")
+
+
+def test_a_served_request_is_unchanged(tmp_path, status):
+    app = make_app(tmp_path)
+    with http_server(app) as port:
+        code, retry, text = post(port, {"messages": HI, "max_tokens": 8})
+    assert (code, retry) == (200, None) and json.loads(text)["choices"][0]["message"]["content"] == "Hello"
