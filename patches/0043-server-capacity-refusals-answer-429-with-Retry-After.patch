+def test_the_generic_servers_tokenizer_route(monkeypatch, status):
+    """tensorfold.server.http's handler (the Mac server's) renders its capacity refusals the same way."""
+
+    import socket
+    from io import BytesIO
+
+    from tensorfold.server import http as generic
+    from tensorfold.server import token_routes
+
+    monkeypatch.setattr(token_routes, "tokenize", lambda app, body: (_ for _ in ()).throw(CapacityError(BUSY)))
+    payload = json.dumps({"prompt": "hi"}).encode()
+    incoming = (f"POST /tokenize HTTP/1.0\r\nContent-Type: application/json\r\n"
+                f"Content-Length: {len(payload)}\r\n\r\n").encode() + payload
+
+    class Connection:
+        def __init__(self):
+            self.output = bytearray()
+
+        def makefile(self, *args):
+            return BytesIO(incoming)
+
+        def sendall(self, data):
+            self.output.extend(data)
+
+        def fileno(self):
+            return connected.fileno()
+
+        def recv(self, *args):
+            return connected.recv(*args)
+
+    connection = Connection()
+    connected, peer = socket.socketpair()
+    try:
+        generic.make_handler(SimpleNamespace())(connection, ("127.0.0.1", 0), None)
+    finally:
+        connected.close()
+        peer.close()
+    head, body = bytes(connection.output).split(b"\r\n\r\n", 1)
+    lines = head.decode().split("\r\n")
+    retry = next((line.split(":", 1)[1].strip() for line in lines if line.lower().startswith("retry-after:")), None)
+    assert (int(lines[0].split()[1]), retry) == status and json.loads(body)["error"]["message"] == BUSY
