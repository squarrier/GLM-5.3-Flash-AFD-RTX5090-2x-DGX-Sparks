diff --git a/src/tensorfold/server/errors.py b/src/tensorfold/server/errors.py
index 74f40b2..9a1ff2b 100644
--- a/src/tensorfold/server/errors.py
+++ b/src/tensorfold/server/errors.py
@@ -1,9 +1,13 @@
+import os
+
+
 class RequestError(ValueError):
     """A request refusal: HTTP 400, or a named error after a stream starts."""
 
 
 class CapacityError(RequestError):
-    """A transient capacity refusal: HTTP 503, retry shortly."""
+    """A transient capacity refusal: HTTP 503, retry shortly; with TF_GLM_CAPACITY_STATUS=1, HTTP 429 + Retry-After
+    (see admission_response)."""
 
 
 class RoundError(RuntimeError):
@@ -23,6 +27,39 @@ class ContextLengthError(RequestError):
 CONTEXT_LIMIT = "This server's maximum context length is"      # OpenAI's wording, which clients match to compact
 
 
+def capacity_status(value: str | None = None) -> bool:
+    """TF_GLM_CAPACITY_STATUS (MiaAI-Lab recipe patch 0081, by johnwhited; off by default here): 1, every API layer
+    renders a capacity refusal as 429 with ``Retry-After: 5`` (``admission_response``); 0 or unset, TensorFold v0.6.5's
+    503 without the header (400 on the generate path of tensorfold.server.http); anything else is refused (the GLM
+    engine checks it at start)."""
+
+    raw = os.environ.get("TF_GLM_CAPACITY_STATUS", "") if value is None else value
+    if raw.strip() in ("", "0"):
+        return False
+    if raw.strip() == "1":
+        return True
+    raise ValueError(f"TF_GLM_CAPACITY_STATUS: 0 (off, the default) or 1 (on), not {raw!r}")
+
+
+def capacity_status_on() -> bool:
+    """``capacity_status`` while a request is refused: never raises (a bad value is refused at start)."""
+
+    try:
+        return capacity_status()
+    except ValueError:
+        return False
+
+
+def admission_response(exc: Exception) -> tuple[int, dict[str, str] | None]:
+    # TFCAP-0074: how every API layer renders a capacity refusal: a real 429 with a retry hint
+    # (not a bare 503), so the same client backs off instead of stacking invisibly. Deliberate
+    # deviation from vLLM, whose refusals are 503 for a load balancer to route to another
+    # instance: a single-instance LAN deployment has no other instance to route to.
+    if not capacity_status_on():         # TF_GLM_CAPACITY_STATUS unset: TensorFold v0.6.5's 503, no header
+        return (503 if isinstance(exc, CapacityError) else 400), None
+    return (429, {"Retry-After": "5"}) if isinstance(exc, CapacityError) else (400, None)
+
+
 def refusal(problem: str) -> RequestError:
     """A refusal string as its error: a context-window one carries OpenAI's code."""
 
