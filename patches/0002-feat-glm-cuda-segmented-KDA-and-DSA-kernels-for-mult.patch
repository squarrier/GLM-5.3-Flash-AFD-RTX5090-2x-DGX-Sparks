+# -- bit identity ---------------------------------------------------------------------------------------------------
+
+WINDOWS = {
+    "one row, short": [(0, 5, 1)],
+    "one segment, 16 rows": [(1, 700, 16)],
+    "four short": [(3, 0, 3), (1, 511, 8), (0, 1024, 16), (2, 1500, 5)],
