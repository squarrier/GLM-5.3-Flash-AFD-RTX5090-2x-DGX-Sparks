--- /dev/null
+++ b/tests/test_glm_sliced_fill.py
@@ -0,0 +1,522 @@
+"""TF_GLM_FILL_BUDGET_MS (MiaAI-Lab recipe patch 0062, ``sliced_fill``) on CPU: a prompt chunk started while other
+streams decode runs a few layers at a time, a decode round between two slices, over this tree's slice-aware AFD wire
+(``afd.MODE_SLICE``, wire version 2).
+
+The model is tests/test_glm_multi.py's fake (logits that hash what each stream committed, read back from its pool rows
+and its slot) with six layers here (dense, moe, moe, dense, moe, moe: MoE positions 0 .. 3) and a layer-by-layer
+prompt forward (``fake_compute_steps``): the rows' latents go into the pool at layer 0 and the state is folded from
+the pool at the end, so a slice that ran on the wrong rows, a lost row or a decode round that touched the suspended
+chunk changes the replies. At world 1 the AFD wire is ``SliceWire``: the real ``afd.AfdWire.begin`` / ``exchange``
+over a transport whose header table is written by the real ``McdmaTransport.header`` and read back per request as
+the expert's ``McdmaExpertLink.next_forward`` reads it. Covered:
+
+- sliced == unsliced (and == the solo reference): replies, kept states and their pool rows, at world 1 over the
+  checked wire and at two ranks (FILLPART messages, both ranks equal after every message), with TF_GLM_MULTI_PREFILL's
+  grouped chunks (MFILLPART), with TF_GLM_KV=fp8's rings, MTP and DFlash2 streams, TF_GLM_FILL_DRAFTS 0 and 1;
+- a decode round really runs between two slices of one chunk; a request alone fills whole forwards;
+- a cache MOVE between two slices carries the rows the chunk already wrote; cancellation mid-fill frees the extent;
+- the startup layer timings (``_time_prompt_layers``) as whole MODE_CHUNK forwards of the wire;
+- every switch off: no slice op, ROUND messages as before, no ``sliced_fill`` in /health; the messages' parse refuses
+  slice payloads out of shape.
+"""
+
+from __future__ import annotations
+
+from itertools import pairwise
+from types import SimpleNamespace
+
+import pytest
+
+from tests import test_glm_kv8_multi as tk
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests import test_glm_multi_prefill as tmp
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+from tests.test_glm_multi import CASES, _prompt, _sampling, fake, fold, solo  # noqa: F401
+from tests.test_glm_multi_afd import afd_fake  # noqa: F401
+
+pytestmark = pytest.mark.torch
+rings = tk.rings                                              # fixture: TF_GLM_KV=fp8's per-slot indexer rings
+
+KINDS = ("dense", "moe", "moe", "dense", "moe", "moe")        # the fake's layers: MoE positions 0 .. 3 on the wire
+MOE = KINDS.count("moe")
+LAYER_MS = 1000.0       # FakeEvent's elapsed ms: slice >> wall time, so no overhead/tail is learned (deterministic)
+STARTS = {0: 0, 1: 2, 2: 3, 3: 7, 4: 11, 5: 12}               # tests/test_glm_multi.py's staggered admissions
+
+
+# -- the fake model's layer-by-layer prompt forward --------------------------------------------------------------
+class FakeEvent:
+    """torch.cuda.Event on a CPU-only box."""
+
+    def __init__(self, enable_timing: bool = False) -> None:
+        pass
+
+    def record(self, stream=None) -> None:
+        pass
+
+    def synchronize(self) -> None:
+        pass
+
+    def elapsed_time(self, other) -> float:
+        return LAYER_MS
+
+
+def fake_compute_steps(w, st, b, R, *, nch=None, host_pos=None, head=True, mixer=None):
+    """``forward.compute_steps`` on the fake: one yield a layer; at layer 0 every row's latent (and pooled key) into
+    its stream's pool rows; each MoE layer's exchange on the AFD wire; after the last layer each stream's state folded
+    through its rows READ BACK from the pool, its taps, and its last row's logits (a piece's by ``fake_head``)."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda.multi_prefill import PieceMixer
+
+    assert b.prefill and len(b.ids) == R
+    if mixer is not None:                                # TF_GLM_MULTI_PREFILL's multi-prompt chunk (0049)
+        assert st is None and isinstance(mixer, PieceMixer) and not head and mixer.R == R
+        pieces = [(p.st, list(p.tokens), p.lo, p.rows) for p in mixer.pieces]
+    else:
+        assert host_pos == st.pos
+        pieces = [(st, list(b.ids), 0, R)]
+    assert sum(n for *_, n in pieces) == R
+    wire = getattr(w, "afd", None)
+    for i in range(len(w.layers)):
+        if i == 0:
+            for s, toks, _, _ in pieces:
+                for k, t in enumerate(toks):
+                    s.write(s.pos + k, int(t))
+        if wire is not None and w.cfg.mlp_kinds[i] == "moe":
+            wire.exchange(None, R)
+        yield i
+    taps, heads = [], {}
+    for s, toks, lo, n in pieces:
+        h = s.h()
+        for k in range(n):
+            q = s.pos + k
+            h = fold(h, q, int(s.lat[q, 0]) - 1)          # from the pool: a lost or moved-away row shows
+        cur = s.cur[0]
+        s.rec[1 - cur][0] = h
+        s.cur = [1 - cur]
+        s.conv.copy_(torch.tensor(([0, 0, 0] + list(s.conv.tolist()) + toks)[-3:]))
+        taps += [[s.pos + k, t] for k, t in enumerate(toks)]
+        heads[lo + n - 1] = s.logits(s.pos + n - 1, h)
+    if mixer is None:
+        b.taps = torch.tensor(taps, dtype=torch.int64)
+        b.fnormed = b.taps.clone()
+        return heads[R - 1][None] if head else None
+    b.taps = [torch.tensor(taps, dtype=torch.int64)]
+    b.fnormed = torch.arange(R, dtype=torch.int64)[:, None]
+    b.fxs = torch.zeros((R, 1))
+    b.logits = torch.zeros((1, tm.V))
+    b.head_rows = heads
+    b.engine.chunks.append([(p.st.slot, p.st.pos, p.rows) for p in mixer.pieces])
+    return None
+
+
+def layered(monkeypatch, budget: str | None, *, drafts: str | None = None):
+    """The fake model with ``KINDS``'s layers and the sliced fill's seams (``fake_compute_steps``, ``FakeEvent``,
+    startup costs of 1 ms a layer, rank 0's slice messages through the harness's message box). ``budget``: the
+    TF_GLM_FILL_BUDGET_MS value (None: unset). Returns the real ``_time_prompt_layers``."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import forward, multi, sliced_fill
+
+    for name, value in (("TF_GLM_FILL_BUDGET_MS", budget), ("TF_GLM_FILL_DRAFTS", drafts)):
+        if value is None:
+            monkeypatch.delenv(name, raising=False)
+        else:
+            monkeypatch.setenv(name, value)
+    real = tm.FakeEngine.__init__
+
+    def init(self, *a, **k):
+        real(self, *a, **k)
+        self.w.layers = [SimpleNamespace(index=i) for i in range(len(KINDS))]
+        self.w.cfg.mlp_kinds = list(KINDS)
+        self.w.device = "cpu"
+
+    timing = multi.MultiDecoder._time_prompt_layers
+    monkeypatch.setattr(tm.FakeEngine, "__init__", init)
+    monkeypatch.setattr(forward, "compute_steps", fake_compute_steps)
+    monkeypatch.setattr(torch.cuda, "Event", FakeEvent)
+    monkeypatch.setattr(multi.MultiDecoder, "_time_prompt_layers",
+                        lambda self: sliced_fill.LayerCosts({64: [1.0] * len(KINDS), 1024: [1.0] * len(KINDS)}))
+    monkeypatch.setattr(multi.MultiDecoder, "_send", lambda self, values: self.g._share(values))
+    return timing
+
+
+# -- the AFD wire: the real attention side over a checked header table --------------------------------------------
+class CheckedLink:
+    """The MCDMA attention transport's header table, written by the real ``McdmaTransport.header``, read back at each
+    request as the expert's link reads it (``McdmaExpertLink.next_forward``): a forward's first request at its first MoE
+    position (0, or a slice's a, word 6 its count n), one header a forward (seq + 1), the rows within the mailboxes',
+    words 7 .. 63 zero and word 6 only on a slice's first row, then the forward's requests in order; a new header only
+    after the forward's last request. ``events`` is the wire's sequence."""
+
+    def __init__(self, layers: int, prefill: int) -> None:
+        import torch
+
+        from tensorfold.families.glm5_next.cuda import mcdma
+
+        tab = torch.zeros((layers, 64), dtype=torch.int32)
+        tab[:, 0] = mcdma.WIRE_MAGIC
+        tab[:, 3] = torch.arange(layers, dtype=torch.int32)
+        tab[:, 5] = layers
+        self.hdr_tab_cpu, self.hdr_tab, self.sliced = tab, tab.clone(), None
+        self.L, self.prefill = layers, prefill
+        self.fwd = self.next = None
+        self.last = 0
+        self.events: list[tuple] = []
+
+    def header(self, seq: int, rows: int, mode: int, slice=None) -> None:
+        from tensorfold.families.glm5_next.cuda.afd_mcdma import McdmaTransport
+
+        assert self.next is None, ("a header before the last forward's requests all went", self.fwd)
+        McdmaTransport.header(self, seq, rows, mode, slice=slice)
+        self.events.append(("begin", int(rows), int(mode), None if slice is None else tuple(slice)))
+
+    def send(self, b, rows: int, layer: int) -> None:
+        from tensorfold.families.glm5_next.cuda import mcdma
+        from tensorfold.families.glm5_next.cuda.afd import MODE_CHUNK, MODE_EAGER, MODE_SLICE
+
+        h = [int(v) for v in self.hdr_tab[layer].tolist()]
+        if self.next is None:                             # the forward's first request
+            magic, seq, r, pos, mode, nl, count = h[:7]
+            first, n = (pos, count) if mode == MODE_SLICE else (0, self.L)
+            assert magic == mcdma.WIRE_MAGIC and nl == self.L and pos == first == layer, h[:7]
+            assert mode in (MODE_EAGER, MODE_CHUNK, MODE_SLICE) and 1 <= r <= self.prefill, h[:7]
+            assert 1 <= n and first + n <= self.L and seq == (self.last + 1) & 0x7FFFFFFF, h[:7]
+            self.fwd, self.next, self.last = (seq, r, mode, first, n), first, seq
+        seq, r, mode, first, n = self.fwd
+        assert layer == self.next and rows == r and h[1:3] == [seq, r] and h[4] == mode, (layer, h[:7], self.fwd)
+        assert h[6] == (n if mode == MODE_SLICE and layer == first else 0) and not any(h[7:]), h
+        self.events.append(("moe", int(layer)))
+        self.next = None if layer + 1 == first + n else layer + 1
+
+    def recv(self, *a) -> None:
+        pass
+
+
+def slice_wire(layers: int = MOE, prefill: int = 64):
+    """``afd.AfdWire`` (its real begin, exchange, out-of-step refusal and slice bookkeeping) over ``CheckedLink``;
+    ``forward(kind, rows)`` runs an unsliced forward's exchanges (the fakes' chunk and batched windows)."""
+
+    from tensorfold.families.glm5_next.cuda.afd import MODE_CHUNK, MODE_EAGER, AfdWire
+
+    class SliceWire(AfdWire):
+        def __init__(self) -> None:          # no store, watchdog or link daemons: the forward's bookkeeping only
+            self.tr = CheckedLink(layers, prefill)
+            self.events = self.tr.events
+            self.dead, self.seq, self.layer, self.nlayers = None, 0, 0, layers
+            self.start = self.end = 0
+            self.span = None
+            self.rows = self.mode = 0
+            self.check = self.timing = False
+            self.checked, self._chk, self.ev = 0, None, None
+
+        def forward(self, kind: str, rows: int) -> None:
+            assert self.span is None and self.layer == 0 and rows == self.rows, (kind, rows, self.rows, self.span)
+            assert self.mode == {"chunk": MODE_CHUNK, "batched": MODE_EAGER}[kind]
+            for _ in range(self.nlayers):
+                self.exchange(None, rows)
+            self.events.append(("forward", kind, int(rows)))
+
+    return SliceWire()
+
+
+class SlicedWorld1(ta.World1):
+    """tests/test_glm_multi_afd.py's AFD attention node with ``slice_wire`` for its wire."""
+
+    def __init__(self, env, **kw) -> None:
+        super().__init__(env, **kw)
+        self.wire = slice_wire(prefill=self.g.e.prefill_rows)
+        self.g.e.w.afd = self.wire
+
+    def begins(self) -> list[tuple]:
+        return [e for e in self.wire.events if e[0] == "begin"]
+
+
+# -- scenarios ------------------------------------------------------------------------------------------------------
+def staggered(node, d, streams: int, cases=CASES):
+    """tests/test_glm_multi.py's six requests admitted as they come (the decoder ``d``, rank 0's); every reply checked
+    against its solo reference."""
+
+    admitted, pending = [], list(enumerate(cases))
+    for it in range(6000):
+        while pending and it >= STARTS[pending[0][0]] and d.live() < streams:
+            i, (prompt, count, kind, policy, draft) = pending.pop(0)
+            admitted.append((i, node.submit(prompt, count, _sampling(kind, 100 + i), policy=policy, draft=draft)))
+        if not d.lanes and not pending:
+            break
+        if d.lanes:
+            node.step()
+        elif getattr(node, "sent", None):
+            node.follow()
+    assert not pending and not d.lanes
+    for i, s in admitted:
+        prompt, count, kind, _, _ = cases[i]
+        assert s.got == solo(node.torch, prompt, count, _sampling(kind, 100 + i)), i
+    return [s.got for _, s in sorted(admitted, key=lambda x: x[0])]
+
+
+def burst(node, d, k: int = 4, long: bool = True):
+    """One stream decoding, then ``k`` short prompts at once (TF_GLM_MULTI_PREFILL groups them), then a long one."""
+
+    first = node.submit(_prompt(30, 41), 70, _sampling("topk", 9))
+    while not (first.sid in d.lanes and d.lanes[first.sid].decoding):
+        node.step()
+    reqs = [(_prompt(n, seed), 24, _sampling(kind, seed)) for n, seed, kind in tmp.BURST[:k]]
+    if long:
+        reqs.append((_prompt(150, 77), 20, None))
+    streams = [node.submit(p, c, s) for p, c, s in reqs]
+    node.run()
+    for s, (p, c, sp) in zip([first, *streams], [(_prompt(30, 41), 70, _sampling("topk", 9)), *reqs]):
+        assert s.got == solo(node.torch, p, c, sp)
+    return [s.got for s in (first, *streams)]
+
+
+def slice_ops(sent) -> dict[str, int]:
+    from tensorfold.families.glm5_next.cuda.multi import FILL, FILLPART, MFILL, MFILLPART, ROUND
+
+    ops = [op for m in sent for op, _ in tm._ops(m)]
+    return {"FILL": ops.count(FILL), "MFILL": ops.count(MFILL), "FILLPART": ops.count(FILLPART),
+            "MFILLPART": ops.count(MFILLPART), "ROUND": ops.count(ROUND)}
+
+
+class LoggedPair(tm.Pair):
+    """tests/test_glm_multi.py's two ranks, every message rank 0 sent kept."""
+
+    def __init__(self, torch, **kw) -> None:
+        super().__init__(torch, **kw)
+        self.log: list[list[int]] = []
+        share = self.g[0]._share
+        self.g[0]._share = lambda values: (self.log.append(list(values)), share(values))[1]
+
+
+def _between(begins) -> bool:
+    """A batched (eager) forward between two slices of one chunk on the wire."""
+
+    from tensorfold.families.glm5_next.cuda.afd import MODE_EAGER, MODE_SLICE
+
+    for x, y, z in zip(begins, begins[1:], begins[2:]):
+        if x[2] == MODE_SLICE and y[2] == MODE_EAGER and z[2] == MODE_SLICE and z[3][0] > x[3][0]:
+            return True
+    return False
+
+
+# -- world 1 over the checked wire -----------------------------------------------------------------------------------
+@pytest.mark.parametrize("streams", [2, 4])
+def test_world1_sliced_equals_unsliced(afd_fake, monkeypatch, streams):  # noqa: F811
+    """The staggered requests at world 1: unsliced, then sliced (budget 2.5 ms of 1-ms layers): the same replies (each
+    its solo one) and kept states; slices of the chunks started while others decode, each a MODE_SLICE forward whose
+    header and exchanges the checked wire accepted, a batched round between two slices of one chunk."""
+
+    from tensorfold.families.glm5_next.cuda.afd import MODE_CHUNK, MODE_SLICE
+
+    runs = {}
+    for budget in (None, "2.5"):
+        layered(monkeypatch, budget)
+        n1 = SlicedWorld1(afd_fake, streams=streams)
+        runs[budget] = (staggered(n1, n1.d, streams), tmp.kept_view(n1.d), n1)
+    (g0, k0, n0), (g1, k1, n1) = runs[None], runs["2.5"]
+    assert g0 == g1 and k0 == k1
+    assert n0.d.sliced == {"chunks": 0, "slices": 0, "rounds": 0} and "sliced_fill" not in n0.d.health()
+    assert all(m != MODE_SLICE for _, _, m, _ in n0.begins())
+    sl = n1.d.sliced
+    assert sl["chunks"] > 0 and sl["slices"] > sl["chunks"] and sl["rounds"] > 0, sl
+    assert n1.d.health()["sliced_fill"] == sl
+    slices = [b for b in n1.begins() if b[2] == MODE_SLICE]
+    assert slices and all(1 <= n and a + n <= MOE for _, _, _, (a, n) in slices)
+    assert any(b[2] == MODE_CHUNK for b in n1.begins())            # alone or the costs' whole chunks
+    assert _between(n1.begins())
+    assert n1.wire.tr.next is None and n1.d.partial is None and n1.shared == []
+
+
+def test_world1_grouped_burst_and_fp8_rings(afd_fake, rings, monkeypatch):  # noqa: F811
+    """TF_GLM_MULTI_PREFILL=1 (grouped chunks) with TF_GLM_KV=fp8's rings: a burst while one stream decodes,
+    sliced == unsliced, and a grouped chunk went in slices."""
+
+    from tensorfold.families.glm5_next.cuda.multi import MultiDecoder
+
