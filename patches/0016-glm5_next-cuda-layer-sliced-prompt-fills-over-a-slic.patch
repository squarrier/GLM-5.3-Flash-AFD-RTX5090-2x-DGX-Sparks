+def test_parse_refuses_slice_payloads_out_of_shape():
+    from tensorfold.families.glm5_next.cuda.multi import FILL, FILLPART, MFILLPART, MultiDecoder
+
+    parse = MultiDecoder.parse
+    assert parse([FILLPART, 4, 3, 64, 0, 2]) == [(FILLPART, [3, 64, 0, 2])]
+    assert parse([MFILLPART, 7, 2, 2, 6, 1, 9, 3, 12]) == [(MFILLPART, [2, 2, 6, 1, 9, 3, 12])]
+    for bad in ([FILLPART, 3, 3, 64, 0], [FILLPART, 4, 3, 64, 2, 2], [MFILLPART, 5, 1, 0, 2, 1, 9, 3],
+                [MFILLPART, 5, 0, 0, 2, 1, 9], [MFILLPART, 5, 1, 3, 2, 1, 9], [99, 0], [FILL], [FILL, 5, 1]):
+        with pytest.raises(RuntimeError):
+            parse(bad)
