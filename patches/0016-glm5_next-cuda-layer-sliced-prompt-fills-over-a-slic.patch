+def prefill_piece_steps(e, pieces: Sequence[Piece]):
+    """``prefill_pieces`` as a generator for layer-sliced fills (TF_GLM_FILL_BUDGET_MS, MiaAI-Lab recipe patch 0062):
+    the chunk's forward yields after each layer; the heads, the taps and every piece's commit (no position or tap
+    moves) only after the last layer. On the AFD attention node the caller sends each slice's header
+    (``multi.MultiDecoder._afd_slice``)."""
+
+    from . import latent
+    from .forward import commit, compute_steps, mm
+
+    if not latent.ENABLED:
+        raise ValueError("multi-prompt chunks need the latent cache (TF_GLM_LATENT=1)")
+    w, b = e.w, e.pbuf
+    R = layout(pieces, min(b.rows, e.prefill_rows))
+    _stage(w, b, pieces, R)
+    yield from compute_steps(w, None, b, R, head=False, mixer=PieceMixer(w, b, pieces, R))
+    heads: list[torch.Tensor | None] = []
+    for p in pieces:
+        if p.head:
+            r = p.lo + p.rows - 1
+            heads.append(mm(b, b.fnormed[r:r + 1], w.head, b.fxs[r:r + 1], b.logits[:1]).clone())
+        else:
+            heads.append(None)
+    for p in pieces:
+        if p.drafter is not None:
+            p.drafter.add_taps(torch.cat([t[p.lo:p.lo + p.rows] for t in b.taps], dim=1))
+    for p in pieces:
