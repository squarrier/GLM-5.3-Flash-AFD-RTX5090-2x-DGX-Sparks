+# Ported from MiaAI-Lab's GLM-5.3-Flash EXL3 2x DGX Sparks recipe @ 1576746, patch 0062-glm-sliced-fill
+# (Apache-2.0, Copyright 2026 MiaAI-Lab; THIRD_PARTY_NOTICES.md "GLM sliced prompt fills").
+"""CPU policy and saved control state for opt-in layer-sliced concurrent prompt fills.
+
+The GPU rows live in Engine.pbuf, already counted by the startup memory estimate. Only one prompt chunk may
+be suspended; its generator retains the HC split loop's next-front/done state. No additional GPU storage.
+"""
+from __future__ import annotations
+
+import math
+import os
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+
+def budget_ms(value: str | None = None) -> float:
+    value = os.environ.get("TF_GLM_FILL_BUDGET_MS", "") if value is None else value
+    try:
+        ms = float(value.strip() or "0")
+    except ValueError:
+        ms = -1.0
+    if not math.isfinite(ms) or ms < 0:
+        raise ValueError(f"TF_GLM_FILL_BUDGET_MS: finite milliseconds >= 0 (0: off), not {value!r}")
+    return ms
+
+
+def drafted_rounds(value: str | None = None) -> bool:
+    """TF_GLM_FILL_DRAFTS: 1 makes the decode rounds between prompt slices full drafted rounds (more tokens for the
+    decoding streams during a fill, a later first token for the filling one); 0 (default): one token per stream."""
+
+    raw = (os.environ.get("TF_GLM_FILL_DRAFTS", "") if value is None else value).strip() or "0"
+    if raw not in ("0", "1"):
+        raise ValueError(f"TF_GLM_FILL_DRAFTS: 0 or 1, not {raw!r}")
+    return raw == "1"
+
+
+class LayerCosts:
+    """Startup timings at several row counts, interpolated separately for every KDA/DSA/dense layer.
+
+    The first cost includes embedding. Tail work and per-slice overhead are learned separately. A layer slower than the budget runs alone: CUDA
+    kernels cannot be preempted, so this setting is a target, not a hard latency guarantee.
+    """
+    def __init__(self, samples: dict[int, Sequence[float]]) -> None:
+        if not samples:
+            raise ValueError("prompt cost model needs samples")
+        self.samples = {r: tuple(float(v) for v in costs) for r, costs in sorted(samples.items())}
+        self.layers = len(next(iter(self.samples.values())))
+        if (not self.layers or any(r <= 0 or len(c) != self.layers or
+                                  any(not math.isfinite(v) or v <= 0 for v in c)
+                                  for r, c in self.samples.items())):
+            raise ValueError("prompt costs need positive rows and equally sized finite positive layer timings")
+        self.scale = 1.0
+        self.overhead = 0.0
+        self.tails: dict[int, float] = {}
+
+    def tail_cost(self, rows: int) -> float:
+        if not self.tails:
+            return 0.0
+        lo = max((r for r in self.tails if r <= rows), default=min(self.tails))
+        hi = min((r for r in self.tails if r >= rows), default=max(self.tails))
+        if lo == hi:
+            return self.tails[lo] * rows / lo
+        t = (rows - lo) / (hi - lo)
+        return self.tails[lo] + t * (self.tails[hi] - self.tails[lo])
+
+    def observe_tail(self, rows: int, ms: float) -> None:
+        if rows > 0 and math.isfinite(ms) and ms >= 0:
+            self.tails[rows] = 0.8 * self.tails[rows] + 0.2 * ms if rows in self.tails else ms
+
+    def observe_overhead(self, ms: float) -> None:
+        if math.isfinite(ms) and ms >= 0:
+            self.overhead = 0.8 * self.overhead + 0.2 * ms
+
+    def costs(self, rows: int) -> tuple[float, ...]:
+        keys = list(self.samples)
+        lo = max((r for r in keys if r <= rows), default=keys[0])
+        hi = min((r for r in keys if r >= rows), default=keys[-1])
+        if lo == hi:
+            return tuple(v * self.scale for v in self.samples[lo])
+        t = (rows - lo) / (hi - lo)
+        return tuple((a + t * (b - a)) * self.scale for a, b in zip(self.samples[lo], self.samples[hi]))
+
+    def stop(self, rows: int, lo: int, budget: float) -> int:
+        if not 0 <= lo < self.layers or not math.isfinite(budget) or budget <= 0:
+            raise ValueError("slice needs a valid first layer and positive finite budget")
+        costs = list(self.costs(rows))
+        costs[-1] += self.tail_cost(rows)
+        budget = max(0.001, budget - self.overhead)
+        def greedy_end(start):
+            end, ms = start + 1, costs[start]
+            while end < self.layers and ms + costs[end] <= budget:
+                ms += costs[end]
+                end += 1
+            return end
+
+        def pieces(start):
+            count = 0
+            while start < self.layers:
+                start = greedy_end(start)
+                count += 1
+            return count
+
+        # Greedy gives the minimum number of contiguous slices. Among first cuts
+        # that preserve that count, approach the mean cost instead of leaving a
+        # tiny tail after several near-budget stalls. Never exceed the budget
+        # except for one indivisible layer, as on the ordinary greedy path.
+        count = pieces(lo)
+        target = sum(costs[lo:]) / count
+        ends = [hi for hi in range(lo + 1, greedy_end(lo) + 1) if pieces(hi) <= count - 1]
+        return min(ends, key=lambda hi: (abs(sum(costs[lo:hi]) - target), -hi))
+
+    def observe(self, rows: int, lo: int, hi: int, ms: float) -> None:
+        # Layer GPU time only: tail and dispatch cost must not inflate every layer's prediction.
+        predicted = sum(self.costs(rows)[lo:hi])
+        if predicted > 0 and math.isfinite(ms) and ms > 0:
+            self.scale = min(8.0, max(0.5, self.scale * (0.8 + 0.2 * ms / predicted)))
+
+
+@dataclass
+class PendingFill:
+    group: list[tuple[Any, int]]
+    many: bool = False
+    layer: int = 0
+    steps: Any = None
+    retired: set[int] = field(default_factory=set)
+    layer_ms: float = 0.0
+    layer_event: Any = None
+    slice_layer_ms: float = 0.0
+    slice_wall_ms: float = 0.0
+    starts: list[int] = field(init=False)
+
+    def __post_init__(self) -> None:
+        self.starts = [lane.st.pos for lane, _ in self.group]
+
+    @property
+    def rows(self) -> int:
+        return sum(stop - start for (_, stop), start in zip(self.group, self.starts))
+
+    def contains(self, sid: int) -> bool:
+        return any(lane.sid == sid for lane, _ in self.group)
+
+    def close(self) -> None:
+        if self.steps is not None:
+            self.steps.close()
+            self.steps = None
+
+
+def advance(pending: PendingFill, lo: int, hi: int, layers: int, make_steps, before_finalize=None):
+    """Run the requested contiguous layer range; return (complete, forward result)."""
+    if not lo == pending.layer < hi <= layers:
+        raise RuntimeError(f"out-of-order prompt slice [{lo}, {hi}), expected layer {pending.layer} of {layers}")
+    if pending.steps is None:
+        if lo:
+            raise RuntimeError("a resumed prompt slice has no saved forward")
+        pending.steps = make_steps()
+    for _ in range(lo, hi):
+        try:
+            next(pending.steps)
+        except StopIteration as exc:
+            raise RuntimeError("prompt forward ended before its final layer") from exc
+    pending.layer = hi
+    if hi < layers:
+        return False, None
+    if before_finalize is not None:
+        before_finalize()
+    try:
+        next(pending.steps)                   # final norm, taps, commit (after the last layer's yield)
+    except StopIteration as result:
+        pending.steps = None
+        return True, result.value
+    raise RuntimeError("prompt forward has more layers than the slice protocol")
diff --git a/tests/test_glm_afd_slice_wire.py b/tests/test_glm_afd_slice_wire.py
new file mode 100644
index 0000000..449f682
--- /dev/null
+++ b/tests/test_glm_afd_slice_wire.py
@@ -0,0 +1,267 @@
+"""The AFD wire's layer slices (``afd.MODE_SLICE``, wire version 2; this tree's design for MiaAI-Lab recipe patch
+0062's sliced prompt fills) end to end on one host, CPU only: the attention's ``AfdWire`` over ``McdmaTransport`` and
+the experts' ``forwards`` loops over ``McdmaExpertLink``, through the fake mcdma-rpcd pair of ``glm_afd_fakes``.
+
+A slice is a forward over MoE positions a .. a + n - 1 of a prompt chunk's rows: its first request's header has word 3
+= a, word 4 = 5 and word 6 = n; the expert's ``next_forward`` takes a slice's first request at its own position and
+``_window`` runs only those layers, so a decode round's eager window can run between two slices of a chunk. Covered:
+slice headers round-trip between eager windows and whole chunks (every reply checked against the fake experts'
+function), the header words, an expert of the old wire (settings without ``wire: 2``) refused at the handshake both
+ways, a slice that stops early refused like an out-of-step forward, the experts' refusal of malformed slice headers,
+and ``TF_AFD_CHECK``'s hashes keyed by slice.
+"""
+
+from __future__ import annotations
+
+import struct
+import threading
+
+import pytest
+import torch
+
+from tensorfold.families.glm5_next.cuda import afd as afd_mod
+from tensorfold.families.glm5_next.cuda import afd_mcdma, mcdma
+from tensorfold.server.errors import CapacityError
+from tests import glm_afd_fakes as fx
+from tests.glm_afd_fakes import (
+    LAYERS,
+    PREFILL,
+    D,
+    Expert,
+    FakeNode,
+    S,
+    buffers,
+    fake_cfg,
+    finish,
+    forward,
+    free_port,
+    mcdma_attention,
+    partial,
+    setup_pair,
+    wait_attached,
+)
+
+pytestmark = pytest.mark.torch
+# the fakes' fixtures (daemon, env, libpath, master, words), bound here by assignment
+daemon_fixture, env_fixture, libpath_fixture = fx.daemon_fixture, fx.env_fixture, fx.libpath_fixture
+master_fixture, words_fixture = fx.master_fixture, fx.words_fixture
+
+L = len(LAYERS)
+
+
+def slice_forward(a, b, rows, gen, first: int, count: int, stop_after: int | None = None) -> list:
+    """One layer slice of a prompt chunk: ``begin(rows, chunk=True, slice=(first, count))``, then MoE positions
+    first .. first + count - 1, every reply checked against the fake experts' function for that position's layer."""
+
+    a.begin(rows, chunk=True, slice=(first, count))
+    out = []
+    for k, pos in enumerate(range(first, first + count)):
+        if stop_after is not None and k == stop_after:
+            return out
+        assert a.layer == pos
+        b.normed[:rows] = torch.randn((rows, D), generator=gen).to(torch.bfloat16)
+        b.pick[:rows] = torch.randint(0, 16, (rows, S), generator=gen, dtype=torch.int32)
+        b.wts[:rows] = torch.rand((rows, S), generator=gen)
+        b.sy[:rows] = torch.randn((rows, D), generator=gen)
+        a.exchange(b, rows)
+        got = a.collect(b, rows, D)
+        for half in (0, 1):
+            want = partial(b.normed[:rows], b.pick[:rows], b.wts[:rows], LAYERS[pos], half)
+            assert torch.equal(got[half], want), f"slice ({first}, {count}) position {pos} half {half}"
+        assert torch.equal(got[2], b.sy[:rows])
+        out.append(got.clone())
+    return out
+
+
+def header_words(a) -> list[list[int]]:
+    """The attention's header table, words 0 .. 7 of each MoE position's request header."""
+
+    return [[int(v) for v in row[:8]] for row in a.tr.hdr_tab.tolist()]
+
+
+# -- round trips --------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("attn", ["cpu", "gpu"])
+def test_slices_round_trip_between_eager_windows(env, daemon, words, master, attn):
+    """The scheduler's order on the wire: a chunk in slices (0, 2), (2, 2) with an eager window (a decode round)
+    before and between them, a whole chunk, a chunk in four one-layer slices with windows between, a lone window;
+    each expert ran exactly the layers of each forward, in order."""
+
+    links, eps, _ = setup_pair(daemon, words, attn=attn, record=True)
+    wait_attached(daemon)
+    a, b, gen = mcdma_attention(links, master), buffers(), torch.Generator().manual_seed(7)
+    forward(a, b, 2, gen)                                             # a decode round
+    slice_forward(a, b, 40, gen, 0, 2)
+    forward(a, b, 3, gen)                                             # the round between two slices
+    slice_forward(a, b, 40, gen, 2, 2)
+    forward(a, b, PREFILL, gen, chunk=True)                           # a whole chunk: MODE_CHUNK
+    for pos in range(L):
+        slice_forward(a, b, 17, gen, pos, 1)
+        forward(a, b, 1, gen)
+    expected = ([(i, 2) for i in LAYERS] + [(i, 40) for i in LAYERS[:2]] + [(i, 3) for i in LAYERS]
+                + [(i, 40) for i in LAYERS[2:]] + [(i, PREFILL) for i in LAYERS]
+                + [x for pos in range(L) for x in ((LAYERS[pos], 17), *[(i, 1) for i in LAYERS])])
+    finish(daemon, eps)
+    for e in eps:
+        assert e.node.seen == expected
+
+
+def test_the_header_words_of_a_slice(env, daemon, words, master):
+    """MODE_SLICE: word 4 = 5 on every row, word 6 = n on the slice's first row only (word 3 there = a); the next
+    forward's header resets it; modes 1 and 3 leave words 6 .. 63 zero; a slice of every MoE layer is a whole chunk
+    (MODE_CHUNK, no count word); begin refuses a slice of no chunk or out of range."""
+
+    links, eps, _ = setup_pair(daemon, words)
+    wait_attached(daemon)
+    a = mcdma_attention(links, master)
+    a.begin(9, chunk=True, slice=(1, 2))
+    w = header_words(a)
+    assert [r[4] for r in w] == [afd_mod.MODE_SLICE] * L and [r[6] for r in w] == [0, 2, 0, 0]
+    assert w[1][:6] == [mcdma.WIRE_MAGIC, a.seq, 9, 1, afd_mod.MODE_SLICE, L] and (a.start, a.end, a.span) == (1, 3, (1, 2))
+    a.begin(1)
+    assert [r[6] for r in header_words(a)] == [0] * L and [r[4] for r in header_words(a)] == [afd_mod.MODE_EAGER] * L
+    a.begin(9, chunk=True, slice=(0, L))
+    assert [r[4] for r in header_words(a)] == [afd_mod.MODE_CHUNK] * L and a.span is None and (a.start, a.end) == (0, L)
+    a.begin(9, chunk=True, slice=(3, 1))
+    a.begin(5, chunk=True)
+    assert not a.tr.hdr_tab[:, 6:].any() and not a.tr.hdr_tab_cpu[:, 6:].any()
+    for kw in ({"slice": (0, 1)}, {"chunk": True, "slice": (0, 0)}, {"chunk": True, "slice": (3, 2)},
+               {"chunk": True, "slice": (-1, 1)}):
+        with pytest.raises(ValueError, match="slice"):
+            a.begin(4, **kw)
+    finish(daemon, eps)
+
+
+def test_a_slice_stopped_early_kills_the_wire(env, daemon, words, master):
+    links, eps, _ = setup_pair(daemon, words)
+    wait_attached(daemon)
+    a, b = mcdma_attention(links, master), buffers()
+    slice_forward(a, b, 6, torch.Generator().manual_seed(3), 1, 3, stop_after=1)
+    with pytest.raises(CapacityError, match=r"a slice of MoE layers 1 \.\. 3 stopped after 1 of 3"):
+        forward(a, b, 1, torch.Generator().manual_seed(4))
+    assert a.dead is not None
+    finish(daemon, eps)
+
+
+@pytest.mark.parametrize("bad", ["count 0", "past the last layer", "other layer count"])
+def test_expert_refuses_a_bad_slice_header(env, daemon, words, bad):
+    """A slice's first request out of shape is no forward's first (the expert's link fails, as for a bad header)."""
+
+    links, eps, _ = setup_pair(daemon, words)
+    wait_attached(daemon)
+    pos, count, nl = {"count 0": (1, 0, L), "past the last layer": (3, 2, L), "other layer count": (0, 1, L + 1)}[bad]
+    box = links.boxes[0]
+    struct.pack_into(mcdma.HDR_FMT, box.mm, mcdma.CTRL, mcdma.WIRE_MAGIC, 1, 1, pos, afd_mod.MODE_SLICE, nl, count, 0)
+    words.store(box.req_word, mcdma.word(links.base[0], mcdma.Layout(D, S).req(1)))
+    eps[0].join()
+    assert isinstance(eps[0].error, mcdma.LinkError) and "no forward's first" in str(eps[0].error)
+    assert "mode 5 slice of" in str(eps[0].error)
+    daemon.bye("a1")
+    eps[1].join()
+
+
+# -- the handshake --------------------------------------------------------------------------------------------------
+def test_the_settings_name_the_wire():
+    cfg = fake_cfg()
+    s = afd_mod.settings_for("/nonexistent", cfg, prefill_rows=PREFILL)
+    assert s["wire"] == afd_mod.WIRE == 2
+    old = {k: v for k, v in s.items() if k != "wire"}
+    assert afd_mod.settings_mismatch(old, s) == "wire: attention 2 != expert None"
+    assert afd_mod.settings_mismatch(s, old) == "wire: attention None != expert 2"
+    assert afd_mod.settings_mismatch(dict(s, wire=1), s) == "wire: attention 2 != expert 1"
+    assert afd_mod.moe_span(cfg, 0, 3) == (0, 0) and afd_mod.moe_span(cfg, 3, 5) == (0, 2)
+    assert afd_mod.moe_span(cfg, 2, 6) == (0, 3) and afd_mod.moe_span(cfg, 5, 7) == (2, 2)
+
+
+@pytest.mark.parametrize("old", ["expert", "attention"])
+def test_a_node_of_the_old_wire_is_refused(env, daemon, words, tmp_path, old):
+    """serve()'s handshake: an expert node whose settings lack ``wire`` (an older tree) is refused by this
+    attention's settings, and this tree's experts refuse an attention that announces none."""
+
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    env.setattr(afd_mod, "WATCH_EVERY", 3600)
+    env.setattr(experts_node, "ALIVE_EVERY", 3600)
+    env.setattr(experts_node.Config, "read", staticmethod(lambda _d: fake_cfg()))
+    real = afd_mod.settings_for
+
+    def wire1(*a, **k):
+        return {key: v for key, v in real(*a, **k).items() if key != "wire"}
+
+    if old == "expert":
+        env.setattr(experts_node, "settings_for", wire1)
+    port, errors = free_port(), {}
+
+    def run(half):
+        try:
+            experts_node.serve(tmp_path, half, "127.0.0.1", port, device="cpu")
+        except BaseException as exc:  # noqa: BLE001
+            errors[half] = exc
+
+    threads = [threading.Thread(target=run, args=(h,), name=f"x{h}", daemon=True) for h in (0, 1)]
+    for t in threads:
+        t.start()
+    links = mcdma.AttentionLinks(["a2", "a1"], words=words, mode="cpu", stream=lambda: 0, timeout=10,
+                                 shm_dir=str(daemon.shm), linkup_wait=2)
+    tr = afd_mcdma.McdmaTransport("127.0.0.1", port, links=links, device="cpu", hidden=D)
+    a = afd_mod.AfdWire("127.0.0.1", port, transport=tr)
+    mine = (real if old == "expert" else wire1)(tmp_path, fake_cfg(), prefill_rows=PREFILL)
+    a.announce(mine)
+    for t in threads:
+        t.join(20)
+        assert not t.is_alive()
+    want = "wire: attention 2 != expert None" if old == "expert" else "wire: attention None != expert 2"
+    for h in (0, 1):
+        assert isinstance(errors[h], SystemExit) and want in str(errors[h]), errors
+
+
+# -- TF_AFD_CHECK -------------------------------------------------------------------------------------------------
+class CheckedExpert(Expert):
+    """``Expert`` with the wire check on, its hashes into the attention's store."""
+
+    def _run(self) -> None:
+        from tensorfold.families.glm5_next.cuda import experts_node
+
+        try:
+            experts_node.forwards(self.node, self.link, self.store, self.node.half + 1, check_on=True)
+        except BaseException as exc:  # noqa: BLE001
+            self.error = exc
+
+
+def test_the_wire_check_keys_its_hashes_by_slice(env, daemon, words, master, capsys):
+    """TF_AFD_CHECK=1 over slices: both sides key a slice's hashes ``afd_chk/{seq}/{a}+{n}/{peer}`` (a whole
+    forward's stay ``afd_chk/{seq}/{peer}``), every hash meets its peer's, and the window's line names the slices."""
+
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    env.setenv(afd_mod.CHECK_ENV, "1")
+    env.setattr(torch.cuda, "synchronize", lambda *a, **k: None)      # the check's device sync, on a CPU-only box
+    env.setattr(afd_mod, "CHECK_FORWARDS", 6)
+    env.setattr(experts_node, "CHECK_FORWARDS", 6)
+    assert afd_mod.check_key(7, 1) == "afd_chk/7/1" and afd_mod.check_key(7, 2, (2, 3)) == "afd_chk/7/2+3/2"
+    links = mcdma.AttentionLinks(["a2", "a1"], words=words, mode="cpu", stream=lambda: 0, timeout=10,
+                                 shm_dir=str(daemon.shm), linkup_wait=2)
+    a = mcdma_attention(links, master)
+    assert a.check
+    eps = []
+    for half, name in enumerate(["a2", "a1"]):
+        link = mcdma.ExpertLink(name, words=words, mode="cpu", socket_path=daemon.sock(name),
+                                shm_dir=str(daemon.shm), stream=lambda: 0)
+        link.base = links.base[half]
+        end = afd_mcdma.McdmaExpertLink(link, D, S, L, PREFILL, device="cpu")
+        eps.append(CheckedExpert(end, FakeNode(LAYERS, half), store=a.store))
+    wait_attached(daemon)
+    b, gen = buffers(), torch.Generator().manual_seed(5)
+    forward(a, b, 3, gen)                                             # seq 1: a whole forward
+    slice_forward(a, b, 20, gen, 0, 1)                                # seq 2
+    forward(a, b, 2, gen)                                             # seq 3
+    slice_forward(a, b, 20, gen, 1, 3)                                # seq 4
+    slice_forward(a, b, 11, gen, 0, L)                                # seq 5: a whole chunk (MODE_CHUNK)
+    forward(a, b, 1, gen)                                             # seq 6
+    a.begin(1)                                                        # the last forward's check
+    assert a.checked == 6 and a.mismatches == 0 and a._sliced == 2 and a._spans == {(0, 1), (1, 3)}
+    for seq, span in ((1, None), (2, (0, 1)), (3, None), (4, (1, 3)), (5, None), (6, None)):
+        for peer in (1, 2):
+            assert afd_mod.get_store(a.store, afd_mod.check_key(seq, peer, span), 5.0), (seq, span, peer)
+    line = [x for x in capsys.readouterr().out.splitlines() if "window complete" in x]
+    assert line and "0 mismatches" in line[0] and "2 of them layer slices" in line[0], line
+    finish(daemon, eps)
