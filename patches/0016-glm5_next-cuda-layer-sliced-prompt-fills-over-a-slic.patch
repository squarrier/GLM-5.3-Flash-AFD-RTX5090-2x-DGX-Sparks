+def test_startup_layer_timings_are_whole_chunk_forwards(afd_fake, monkeypatch):  # noqa: F811
+    """``_time_prompt_layers`` (the real one, its CUDA events faked): each layer's ms at every row count up to
+    TF_GLM_FILL_ROWS, each timed chunk one whole MODE_CHUNK forward of the wire (the experts' exchange included);
+    the home state reset after."""
+
+    from tensorfold.families.glm5_next.cuda import verify
+    from tensorfold.families.glm5_next.cuda.afd import MODE_CHUNK
+
+    timing = layered(monkeypatch, "2.5")
+    monkeypatch.setattr(verify, "timing_tokens", lambda vocab, n: [i % vocab for i in range(n)])   # the fake's 48
+    n1 = SlicedWorld1(afd_fake, streams=2, prefill_rows=256)
+    costs = timing(n1.d)
+    assert sorted(costs.samples) == [64, 256] and costs.samples[64] == (LAYER_MS,) * len(KINDS)
+    assert {(r, m, s) for _, r, m, s in n1.begins()} == {(64, MODE_CHUNK, None), (256, MODE_CHUNK, None)}
+    assert len(n1.begins()) == 1 + 2 * 2 and n1.wire.tr.next is None      # warm-up, then per size warm + timed
+    e = n1.g.e
+    assert e.st is e.home and e.home.pos == 0 and e.last_hidden is None
