+
+def _mid_fill(n1, d):
+    """Admit a decoding stream, then a long prompt; step until its first chunk is suspended after a slice that wrote
+    its rows (layer > 0). Returns (decoding stream, filling stream, its lane, the pool's free rows before it came)."""
+
+    a = n1.submit(_prompt(20, 5), 60, None)
+    while not (a.sid in d.lanes and d.lanes[a.sid].decoding):
+        n1.step()
+    free = d.pool.free_rows()
+    b = n1.submit(_prompt(200, 6), 12, _sampling("nucleus", 4))
+    for _ in range(200):
+        n1.step()
+        if d.partial is not None and d.partial.layer > 0:
+            return a, b, d.lanes[b.sid], free
+    raise AssertionError("no suspended chunk")
+
+
+@pytest.mark.parametrize("mutant", [False, True], ids=["used-counts-the-chunk", "mutant-used-without-it"])
+def test_a_move_between_slices_carries_the_chunks_rows(afd_fake, monkeypatch, mutant):  # noqa: F811
+    """A MOVE of the suspended chunk's extent between two slices copies the rows its earlier layers wrote
+    (``_used`` counts the chunk's rows up to its stop): the replies are still the solo ones. The mutant (``_used``
+    without the chunk) loses them, and the filling stream's reply changes."""
+
+    from tensorfold.families.glm5_next.cuda.multi import MOVE, MultiDecoder
+
+    layered(monkeypatch, "2.5")
+    if mutant:
+        def used(self, x):
+            n = max([len(k.ids) for k in x.kept], default=0)
+            return max(n, self.lanes[x.owner].st.pos) if x.owner is not None else n
+
+        monkeypatch.setattr(MultiDecoder, "_used", used)
+    n1 = SlicedWorld1(afd_fake, streams=2)
+    d = n1.d
+    a, b, lane, _ = _mid_fill(n1, d)
+    x = lane.extent
+    assert d._used(x) == (lane.st.pos if mutant else d.partial.group[0][1]) and lane.st.pos < d.partial.group[0][1]
+    top = max(e.base + e.size for e in d.pool.extents)
+    assert top + x.size <= d.pool.rows
+    d._emit(MOVE, [x.eid, top, x.size])
+    d._move(x, top, x.size)
+    assert x.base == top and lane.st.base == top
+    n1.run()
+    assert a.got == solo(afd_fake.torch, _prompt(20, 5), 60, None)
+    want = solo(afd_fake.torch, _prompt(200, 6), 12, _sampling("nucleus", 4))
+    assert (b.got != want) if mutant else (b.got == want)
+
+
+def test_cancellation_mid_fill_frees_the_extent(afd_fake, monkeypatch):  # noqa: F811
+    """The filling request's client leaves between two slices (the server's poll, ``emit.cancelled``): the chunk is
+    dropped (its generator closed, the wire's forward complete), the stream leaves and its extent is freed; the
+    decoding stream's reply is its solo one."""
+
+    layered(monkeypatch, "2.5")
+    n1 = SlicedWorld1(afd_fake, streams=2)
+    d = n1.d
+    a, b, lane, free = _mid_fill(n1, d)
+    pending, x = d.partial, lane.extent
+    left = [False]
+    b.emit.cancelled = lambda: left[0]
+    n1.step()                                            # not cancelled yet: a round or the next slice
+    left[0] = True
+    done = n1.step()
+    assert done == [b] and b.done and b.sid not in d.lanes and d.partial is None and pending.steps is None
+    assert all(e is not x for e in d.pool.extents) and n1.wire.tr.next is None and d.pool.free_rows() == free
+    n1.run()
+    assert a.got == solo(afd_fake.torch, _prompt(20, 5), 60, None)
+
