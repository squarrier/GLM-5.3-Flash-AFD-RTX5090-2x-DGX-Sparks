+# -- two ranks: the slice messages ------------------------------------------------------------------------------
+@pytest.mark.parametrize("drafters,drafts", [("dflash2", None), ("both", "1"), ("mtp", None)])
+def test_two_ranks_sliced_equals_unsliced(fake, monkeypatch, drafters, drafts):  # noqa: F811
+    """At two ranks (rank 1 applying rank 0's FILLPART and ROUND messages, both ranks equal after every message): the
+    staggered requests sliced == unsliced, each reply its solo one; between two slices a ROUND whose short flag is
+    TF_GLM_FILL_DRAFTS's opposite; unsliced, no slice op and ROUND payloads as before."""
+
+    from tensorfold.families.glm5_next.cuda.multi import FILLPART, ROUND
+
+    runs = {}
+    for budget in (None, "2.5"):
+        layered(monkeypatch, budget, drafts=drafts)
+        p = LoggedPair(fake, streams=4, drafter=drafters != "mtp", mtp=drafters != "dflash2")
+        runs[budget] = (staggered(p, p.d[0], 4), tmp.kept_view(p.d[0]), p)
+    (g0, k0, p0), (g1, k1, p1) = runs[None], runs["2.5"]
+    assert g0 == g1 and k0 == k1 == tmp.kept_view(p1.d[1])
+    off, on = slice_ops(p0.log), slice_ops(p1.log)
+    assert off["FILLPART"] == off["MFILLPART"] == 0 and on["FILLPART"] > 0, (off, on)
+    rounds = [p for m in p0.log for op, p in tm._ops(m) if op == ROUND]
+    assert rounds and all(len(p) == 2 + 2 * p[0] for p in rounds)            # no short flag with the switch off
+    ops = [(op, p) for m in p1.log for op, p in tm._ops(m)]
+    after = [q for (o, _), (r, q) in pairwise(ops) if o == FILLPART and r == ROUND]
+    assert after and all(q[-1] == (0 if drafts == "1" else 1) for q in after)
+    assert p1.d[1].partial is None and p1.d[1].idle
+
