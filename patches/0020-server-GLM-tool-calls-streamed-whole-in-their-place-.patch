+"""MiaAI-Lab's GLM tool-call fixes behind ``TF_GLM_TOOL_CALLS`` (recipe patches 0036, 0051 and 0056's text part) and
+her kept reasoning behind ``TF_GLM_KEEP_REASONING`` (0036), through the CUDA server's request path: GlmApp and the
+HTTP handler, on CPU.
+
+Unset (the default), every case gives what TensorFold v0.6.5 gives. With ``TF_GLM_TOOL_CALLS=1``:
+- a streamed reply's GLM calls go out whole, each in its place in the stream once its ``</tool_call>`` arrives, with
+  an empty delta every ``CALL_KEEPALIVE_S`` while one is written; a call the reply ends inside (its token limit, a
+  stop string) is never sent, nor its markup as content (0053's rules, which 0036's streamer carries);
+- calls written inside the think block are the reply's calls when they end it, else reasoning (0036's ``ThinkSplit``,
+  after jayleaton/glm53-tensorfold-spark's trailing-calls rule);
+- an agent's history renders as GLM's template can render it: arguments sent as "" or null are no arguments, a call
+  whose arguments are not a JSON object is left out with its result (0051), results whose ids match none of their
+  calls' ids render in the order sent, a step's ``reasoning`` field is its ``reasoning_content``;
+- a tool result's pictures without ``--vision`` render as the template's own reminder instead of HTTP 400 (0056);
+- a parameter schema's type list, ``anyOf`` / ``oneOf``, ``enum`` or ``const`` types its value (0036).
+The real-checkpoint case needs Mia-AiLab's first-revision template (``TF_GLM5_TR3_MODEL``) and skips without it; the
+smooth-streaming case needs ``tensorfold.cuda.stream_pacing`` (recipe patch 0061).
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+import threading
+from pathlib import Path
+
+import pytest
+
+from tensorfold.cuda import server
+from tensorfold.cuda.chat_template import ChatTemplate
+from tensorfold.cuda.reply_text import GlmCallStreamer, ThinkSplit
+from tensorfold.families.glm5_next.cuda.app import GlmApp, ThinkingOffTemplate
+from tensorfold.families.glm5_next.cuda.kept_reasoning import KeptReasoning
+from tensorfold.families.glm5_next.prompts import agent_history
+from tensorfold.tool_parameters import TOOL_CALLS, decode_parameter, tool_calls_on
+from tests.test_cuda_admission import http_server, post
+from tests.test_cuda_stop_strings import events
+from tests.test_glm_tool_call_end import END_ID, TOK, Engine  # skips this module without `tokenizers`
+
+pytest.importorskip("jinja2")
