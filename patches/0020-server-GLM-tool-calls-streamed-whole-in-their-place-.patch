+        "path": {"type": "string"}, "limit": {"type": ["integer", "null"]},
+        "note": {"type": ["string", "null"]}}}}},
+    {"type": "function", "function": {"name": "now", "parameters": {"type": "object", "properties": {}}}},
+    {"type": "function", "function": {"name": "get_weather", "parameters": {"type": "object", "properties": {
+        "city": {"type": "string"}}, "required": ["city"]}}},
+]
+
+# GLM-5.3's template, cut down to the parts these fixes touch (as its first revision, sha256 41cff9af, renders them):
+# a step's reasoning_content, its calls' arguments as a mapping, results sorted by their calls' ids when every one has
+# an id (one matching no call is dropped), and the no-media reminder for pictures
+TEMPLATE = (
+    "{%- macro visible(content) -%}{%- if content is string -%}{{ content }}"
+    "{%- elif content is iterable and content is not mapping -%}{%- for item in content -%}"
+    "{%- if item is mapping and item.type == 'text' -%}{{ item.text }}"
+    "{%- elif item is mapping and item.type in ['image', 'image_url', 'video', 'video_url'] -%}"
+    "<reminder>You are unable to process this {{ item.type | replace('_url', '') }}.</reminder>"
+    "{%- endif -%}{%- endfor -%}{%- elif content is not none -%}{{ content }}{%- endif -%}{%- endmacro -%}"
+    "{%- if tools -%}<|system|>tools:{% for t in tools %}{{ (t.function or t).name }};{% endfor %}{%- endif -%}"
+    "{%- for m in messages -%}"
+    "{%- if m.role == 'user' -%}<|user|>{{ visible(m.content) }}"
+    "{%- elif m.role == 'assistant' -%}<|assistant|>"
+    "{%- if m.reasoning_content is string -%}<think>{{ m.reasoning_content }}</think>"
+    "{%- else -%}<think></think>{%- endif -%}{{ visible(m.content) }}"
+    "{%- for tc in m.tool_calls or [] -%}{%- set f = tc.function if tc.function else tc -%}<tool_call>{{ f.name }}"
+    "{%- for k, v in f.arguments.items() -%}<arg_key>{{ k }}</arg_key>"
+    "<arg_value>{{ v | tojson if v is not string else v }}</arg_value>{%- endfor -%}</tool_call>{%- endfor -%}"
+    "{%- elif m.role == 'tool' -%}{%- if loop.first or messages[loop.index0 - 1].role != 'tool' -%}"
+    "<|observation|>{%- set start = loop.index0 -%}{%- set ns = namespace(end=start, calls=[], sort=true) -%}"
+    "{%- for j in range(start, messages | length) -%}{%- if messages[j].role == 'tool' -%}{%- set ns.end = j -%}"
+    "{%- else -%}{%- break -%}{%- endif -%}{%- endfor -%}"
+    "{%- if start > 0 and messages[start - 1].role == 'assistant' and messages[start - 1].tool_calls -%}"
+    "{%- set ns.calls = messages[start - 1].tool_calls -%}{%- else -%}{%- set ns.sort = false -%}{%- endif -%}"
+    "{%- for k in range(start, ns.end + 1) -%}{%- if not (messages[k].tool_call_id or messages[k].id) -%}"
+    "{%- set ns.sort = false -%}{%- endif -%}{%- endfor -%}"
+    "{%- for tc in ns.calls -%}{%- if not tc.id -%}{%- set ns.sort = false -%}{%- endif -%}{%- endfor -%}"
+    "{%- if ns.sort -%}{%- for tc in ns.calls -%}{%- for k in range(start, ns.end + 1) -%}"
+    "{%- if (messages[k].tool_call_id or messages[k].id) == tc.id -%}"
+    "<tool_response>{{ visible(messages[k].content) }}</tool_response>{%- endif -%}{%- endfor -%}{%- endfor -%}"
+    "{%- else -%}{%- for k in range(start, ns.end + 1) -%}"
+    "<tool_response>{{ visible(messages[k].content) }}</tool_response>{%- endfor -%}{%- endif -%}"
+    "{%- endif -%}"
+    "{%- endif -%}{%- endfor -%}"
+    "{%- if add_generation_prompt -%}<|assistant|><think>{%- endif -%}")
+
+
+class Recording(Engine):
+    """#285's fake GLM engine (a fixed reply in rounds of varying width), keeping each prompt it was given."""
+
+    def __init__(self, reply):
+        super().__init__(reply)
+        self.prompts: list[list[int]] = []
+
+    def generate(self, prompt, max_tokens, sampling, on_tokens, draft=True):
+        self.prompts.append(list(prompt))
+        return super().generate(prompt, max_tokens, sampling, on_tokens, draft=draft)
+
+
+def ids(text: str, *, ended: bool = True) -> list[int]:
+    return TOK.encode(text, add_special_tokens=False).ids + ([END_ID] if ended else [])
+
+
+def make_app(tmp_path, reply, *, thinking=False, kept=None):
+    (tmp_path / "tokenizer_config.json").write_text(json.dumps({"chat_template": TEMPLATE}))
+    app = GlmApp.__new__(GlmApp)
+    app.engine = Recording(reply)
+    app.served = "fake-glm"
+    app.tok = TOK
+    app.vision = None
+    app.template = ThinkingOffTemplate(server.ChatTemplate(tmp_path), kept=kept)
+    app.default_thinking = thinking
+    app.sampling = {"temperature": 0.0}
+    app.max_tokens = 4096
+    app.native_context_window = app.context_window = 0
+    app.lock = threading.Lock()
+    return app
+
+
+def ask(app, body):
+    with http_server(app) as port:
+        return post(port, {"temperature": 0, **body}, True)
+
+
+def stream_parts(text):
+    """The SSE events as (kind, value) in order: content, reasoning, a call (index, name, arguments), an empty delta,
+    the finish reason."""
+
+    out = []
+    for chunk in events(text):
+        for choice in chunk.get("choices") or []:
+            delta = choice.get("delta") or {}
+            if delta == {} and choice.get("finish_reason") is None:
+                out.append(("empty", None))
+            if delta.get("reasoning_content"):
+                out.append(("reasoning", delta["reasoning_content"]))
+            if delta.get("content"):
+                out.append(("content", delta["content"]))
+            for call in delta.get("tool_calls") or []:
+                out.append(("call", (call["index"], call["function"].get("name"),
+                                     call["function"].get("arguments"))))
+            if choice.get("finish_reason"):
+                out.append(("finish", choice["finish_reason"]))
+    return out
+
+
+def merged(parts):
+    """Adjacent text deltas joined (rounds and pacing split them differently); calls and finish as they came."""
+
+    out = []
+    for kind, value in parts:
+        if kind in ("content", "reasoning") and out and out[-1][0] == kind:
+            out[-1] = (kind, out[-1][1] + value)
+        elif kind != "empty":
+            out.append((kind, value))
+    return out
+
+
+def reply_of(text):
+    choice = json.loads(text)["choices"][0]
+    message = choice["message"]
+    calls = [(c["function"]["name"], json.loads(c["function"]["arguments"])) for c in message.get("tool_calls") or []]
+    return message.get("content"), message.get("reasoning_content"), calls, choice["finish_reason"]
+
+
+def prompt_text(app):
+    return TOK.decode(app.engine.prompts[-1], skip_special_tokens=False)
+
