+def test_the_checkpoints_template_renders_the_fixed_history(monkeypatch):
+    inner = ChatTemplate(_first_revision())
+    render = ThinkingOffTemplate(inner).render
+    for arguments in ("", None):
+        monkeypatch.setenv(TOOL_CALLS, "0")
+        assert "_invalid_arguments" in render(history(arguments), tools=TOOLS, enable_thinking=False)
+        monkeypatch.setenv(TOOL_CALLS, "1")
+        assert "<tool_call>now</tool_call>" in render(history(arguments), tools=TOOLS, enable_thinking=False)
+    renumbered = history("{}", result_id="renumbered_7")
+    monkeypatch.setenv(TOOL_CALLS, "0")
+    assert "<tool_response>12:00</tool_response>" not in render(renumbered, tools=TOOLS, enable_thinking=False)
+    monkeypatch.setenv(TOOL_CALLS, "1")
+    assert "<tool_response>12:00</tool_response>" in render(renumbered, tools=TOOLS, enable_thinking=False)
+    shot = [{"role": "user", "content": "look"}, {"role": "tool", "content": [{"type": "image"}]}]
+    assert "You are unable to process this image" in render(shot, tools=None, enable_thinking=False,
+                                                            allow_images=True)
