+@SWITCH
+def test_a_nullable_argument_streams_as_null(tmp_path, monkeypatch, switch):
+    monkeypatch.setenv(TOOL_CALLS, switch)
+    reply = ids("<tool_call>read_file<arg_key>path</arg_key><arg_value>a</arg_value><arg_key>note</arg_key>"
+                "<arg_value>null</arg_value><arg_key>limit</arg_key><arg_value>3</arg_value></tool_call>")
+    whole = reply_of(ask(make_app(tmp_path, reply), {"messages": USER, "tools": TOOLS})[1])
+    want = {"path": "a", "note": None, "limit": 3} if switch == "1" else {"path": "a", "note": "null", "limit": "3"}
+    assert whole[2] == [("read_file", want)]
+    streamed = calls_in(ask(make_app(tmp_path, reply), {"messages": USER, "tools": TOOLS, "stream": True})[1], True)
+    assert streamed == ([("read_file", want)], "tool_calls")
+    if switch == "1":           # the streamer alone, fed a character at a time, gives the end parser's arguments
+        streamer, text = GlmCallStreamer(TOOLS), TOK.decode(reply[:-1], skip_special_tokens=False)
+        deltas = [d for k in range(1, len(text) + 1) for d in streamer.feed(text[:k])]
+        assert [json.loads(d["tool_calls"][0]["function"]["arguments"]) for d in deltas] == [want]
