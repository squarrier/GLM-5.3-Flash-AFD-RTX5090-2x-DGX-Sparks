+    monkeypatch.setenv("TF_GLM_STREAM_SMOOTH", "1")
+    monkeypatch.setenv("TF_GLM_STREAM_SMOOTH_MS", "20")
+    status, text = ask(make_app(tmp_path, ids(TWO_CALLS)), body)
+    assert status == 200, text
+    smooth = stream_parts(text)
+    assert merged(smooth) == plain
+    first = next(i for i, (kind, _) in enumerate(plain) if kind == "call")
+    assert plain[first] == ("call", (0, "read_file", '{"path":"a.txt"}'))
+    assert "time." in "".join(v for k, v in plain[first + 1:] if k == "content")
+    assert sum(kind == "content" for kind, _ in smooth) > sum(kind == "content" for kind, _ in plain)
