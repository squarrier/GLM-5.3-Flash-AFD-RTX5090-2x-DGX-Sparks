+def history(arguments, *, result_id="call_1", reasoning_field=None):
+    step = {"role": "assistant", "content": None,
+            "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "now", "arguments": arguments}}]}
+    if reasoning_field:
+        step[reasoning_field] = "Check the clock."
+    return [{"role": "user", "content": "time?"}, step,
+            {"role": "tool", "tool_call_id": result_id, "content": "12:00"}, {"role": "user", "content": "and now?"}]
