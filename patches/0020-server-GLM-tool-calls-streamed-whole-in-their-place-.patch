+def test_kept_reasoning_puts_a_dropped_steps_reasoning_back(tmp_path, monkeypatch):
+    monkeypatch.setenv("TF_GLM_KEEP_REASONING", "8")
+    kept = KeptReasoning.from_env()
+    first = [{"role": "user", "content": "time?"}]
+    app = make_app(tmp_path, ids("I should check the clock.</think><tool_call>now</tool_call>"), thinking=True,
+                   kept=kept)
+    message = json.loads(ask(app, {"messages": first, "tools": TOOLS})[1])["choices"][0]["message"]
+    assert message["reasoning_content"] == "I should check the clock." and len(kept) == 1
+    nxt = [*first, {"role": "assistant", "content": "", "tool_calls": message["tool_calls"]},     # reasoning dropped
+           {"role": "tool", "tool_call_id": message["tool_calls"][0]["id"], "content": "12:00"}]
+    app = make_app(tmp_path, ids("Noon."), thinking=True, kept=kept)
+    assert ask(app, {"messages": nxt, "tools": TOOLS})[0] == 200
+    assert "<think>I should check the clock.</think><tool_call>now</tool_call>" in prompt_text(app)
+    app = make_app(tmp_path, ids("Noon."), thinking=True, kept=None)          # off: the client's history as sent
+    assert ask(app, {"messages": nxt, "tools": TOOLS})[0] == 200
+    assert "<think></think><tool_call>now</tool_call>" in prompt_text(app)
