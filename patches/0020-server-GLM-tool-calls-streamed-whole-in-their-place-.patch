+def test_drafted_rounds_keep_their_calls_in_place_with_smooth_streaming(tmp_path, on, monkeypatch):
+    # smoothed, a drafted round's text goes out token by token, paced; the calls it closed still follow it, unpaced
+    body = {"messages": USER, "tools": TOOLS, "stream": True}
+    status, text = ask(make_app(tmp_path, ids(TWO_CALLS)), body)
+    assert status == 200, text
