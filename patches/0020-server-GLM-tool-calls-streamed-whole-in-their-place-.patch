+def calls_in(text, streamed):
+    if not streamed:
+        return reply_of(text)[2], reply_of(text)[3]
+    got: dict[int, list[str]] = {}
+    for kind, value in stream_parts(text):
+        if kind == "call":
+            entry = got.setdefault(value[0], ["", ""])
+            entry[0] += value[1] or ""
+            entry[1] += value[2] or ""
+    return [(n, json.loads(a)) for n, a in (got[i] for i in sorted(got))], merged(stream_parts(text))[-1][1]
