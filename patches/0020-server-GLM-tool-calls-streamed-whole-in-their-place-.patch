+def _first_revision() -> Path:
+    found = os.environ.get("TF_GLM5_TR3_MODEL")
+    folder = Path(found) if found else None
+    if folder is None or not (folder / "tokenizer_config.json").is_file():
+        pytest.skip("needs Mia-AiLab's first-revision GLM-5.3 template (TF_GLM5_TR3_MODEL)")
+    return folder
