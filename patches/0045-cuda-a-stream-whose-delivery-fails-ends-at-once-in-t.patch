new file mode 100644
index 0000000..24490c9
--- /dev/null
+++ b/tests/test_cuda_delivery_abort.py
@@ -0,0 +1,156 @@
+"""MiaAI-Lab recipe patch 0083 (by johnwhited), ``TF_GLM_DELIVERY_ABORT``: in TensorFold's base scheduler, a stream
+whose delivery callback raises ends at once and frees its lane; unset, the exception leaves ``submit`` and the stream
+decodes on to its end (the lane leaks until then). CPU only: ``Scheduler`` over a stand-in decoder. GLM's scheduler
+has its own submit loop, which this switch does not touch (its delivery failures are recipe patch 0073's,
+TF_GLM_QUEUED_CANCEL)."""
+
+from __future__ import annotations
+
+import time
+
+import pytest
+
+from tensorfold.cuda.scheduler import Scheduler, delivery_abort
+from tensorfold.families.glm5_next.cuda.multi import GlmScheduler
+
+COUNT = 40
+
+
+class Lanes:
+    """A stand-in decoder: every live stream takes one token a round and ends at its count."""
+
+    def __init__(self):
+        self.streams, self.requeue, self.rounds = {}, [], {}
+
+    def live(self):
+        return len(self.streams)
+
+    def fits(self, stream):
+        return True
+
+    def admit(self, stream):
+        stream.started = time.perf_counter()
+        self.streams[id(stream)] = stream
+
+    def round(self):
+        time.sleep(0.002)
+        done = []
+        for s in list(self.streams.values()):
+            s.take([7])
+            self.rounds[id(s)] = self.rounds.get(id(s), 0) + 1
+            if s.done:
+                done.append(s)
+        return done
+
+    def finish(self, done):
+        for s in done:
+            self.streams.pop(id(s), None)
+
+    def drop(self):
+        out = list(self.streams.values())
+        self.streams.clear()
+        return out
+
+    def stats(self, s):
+        return s.stats()
+
+
+def failing_emit(after, error=None):
+    """A delivery callback whose ``after``-th call raises ``error`` (a broken pipe); it records what it delivered."""
+
+    sent = []
+
+    def emit(new):
+        if len(sent) >= after:
+            raise error if error is not None else BrokenPipeError("the client has gone")
+        sent.append(list(new))
+        return False
+    emit.sent = sent
+    return emit
+
+
+@pytest.fixture
+def make(monkeypatch):
+    made = []
+
+    def build(cls, value):
+        monkeypatch.setenv("TF_GLM_DELIVERY_ABORT", value)
+        s = cls(Lanes(), max_streams=2)
+        made.append(s)
+        return s
+    yield build
+    for s in made:                                        # close() stops an idle worker: let streams end first
+        deadline = time.monotonic() + 5
+        while s.decoder.live() and time.monotonic() < deadline:
+            time.sleep(0.005)
+        s.close()
+
+
+def test_the_switch_reads_0_or_1():
+    assert delivery_abort("") is False and delivery_abort("0") is False and delivery_abort("1") is True
+    with pytest.raises(ValueError, match="TF_GLM_DELIVERY_ABORT"):
+        delivery_abort("on")
+
+
+def test_unset_the_failure_leaves_submit_and_the_stream_decodes_to_its_end(make):
+    s = make(Scheduler, "")
+    with pytest.raises(BrokenPipeError):
+        s.submit([1, 2], COUNT, None, True, failing_emit(3))
+    deadline = time.monotonic() + 5
+    while s.decoder.live() and time.monotonic() < deadline:
+        time.sleep(0.005)
+    assert max(s.decoder.rounds.values()) == COUNT       # every token decoded into a queue nobody read
+
+
+def test_on_the_stream_ends_at_once_and_frees_its_lane(make, capsys):
+    s = make(Scheduler, "1")
+    emit = failing_emit(3)
+    stats = s.submit([1, 2], COUNT, None, True, emit)      # no exception: the stream was ended
+    assert isinstance(stats, dict) and len(emit.sent) == 3
+    assert s.decoder.live() == 0 and max(s.decoder.rounds.values()) <= 5
+    assert "stream aborted: emit failed: BrokenPipeError" in capsys.readouterr().out
+    other = s.submit([3], 4, None, True, lambda new: False)   # the lane serves the next request
+    assert isinstance(other, dict)
+
+
+@pytest.mark.parametrize("value", ["", "1"])
+def test_a_client_that_leaves_ends_the_stream_either_way(make, value):
+    s = make(Scheduler, value)
+    calls = []
+
+    def emit(new):
+        calls.append(new)
+        return len(calls) >= 2                            # True: the client left
+    s.submit([1], COUNT, None, True, emit)
+    assert len(calls) == 2 and max(s.decoder.rounds.values()) <= 4
+
+
+def test_glms_scheduler_keeps_its_own_submit_loop(make):
+    """The switch is read by the base class but GLM's submit is its own: with it set and TF_GLM_QUEUED_CANCEL unset,
+    a delivery failure leaves GlmScheduler.submit as before (0073's loop is the one that ends such a stream)."""
+
+    s = make(GlmScheduler, "1")
+    assert s.delivery_abort is True
+    with pytest.raises(BrokenPipeError):
+        s.submit([1, 2], COUNT, None, True, failing_emit(3))
+
+
+@pytest.mark.parametrize("value", ["", "1"])
+def test_a_reply_served_whole_is_unchanged(make, value):
+    s = make(Scheduler, value)
+    got = []
+    s.submit([1], 6, None, True, lambda new: got.extend(new) or False)
+    assert got == [7] * 6
+
+
+def test_the_relay_fires_once_and_latches():
+    s = Scheduler.__new__(Scheduler)
+    cancel = [False]
+    calls = []
+
+    def emit(new):
+        calls.append(new)
+        raise ConnectionResetError("reset")
+    s._relay_token(emit, [1], cancel)
+    s._relay_token(emit, [2], cancel)
+    assert cancel == [True] and calls == [[1]]
