+def delivery_abort(value: str | None = None) -> bool:
+    """TF_GLM_DELIVERY_ABORT (MiaAI-Lab recipe patch 0083, by johnwhited; off by default here): 1, a stream whose
+    delivery callback (``emit``) raises ends at once and frees its lane (``Scheduler._relay_token``); 0 or unset, the
+    exception leaves ``submit`` and the stream decodes on until its end, as before. GLM's scheduler has its own submit
+    loop (``GlmScheduler.submit``; its delivery failures: TF_GLM_QUEUED_CANCEL, recipe patch 0073)."""
+
+    raw = os.environ.get("TF_GLM_DELIVERY_ABORT", "") if value is None else value
+    if raw.strip() in ("", "0"):
+        return False
+    if raw.strip() == "1":
+        return True
+    raise ValueError(f"TF_GLM_DELIVERY_ABORT: 0 (off, the default) or 1 (on), not {raw!r}")
+
