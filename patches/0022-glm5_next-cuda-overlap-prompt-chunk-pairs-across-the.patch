+"""Prompt chunk pairs on the AFD attention node (``TF_GLM_PREFILL_PAIRS=1``): two prompt chunks in flight at once, so
+the attention GPU runs one chunk's attention while the expert nodes compute the other chunk's routed experts.
+
+A prompt fills chunk by chunk, and a chunk runs layer by layer: the attention node's attention, the MoE exchange
+with both expert nodes, their reply, the next layer. Alone, the attention GPU idles while the experts compute and the
+experts idle while it runs attention. A pair runs two consecutive prompt chunks k and k + 1 through the layers
+interleaved: attention(k, L) and k's exchange out, attention(k + 1, L) while the experts compute k's layer L, k's
+reply in, k + 1's exchange out, attention(k, L + 1) while they compute k + 1's, and so on.
+
+Exact by construction. Each chunk keeps its rows, its row count and its kernels; only the order of the two chunks'
+kernels changes. attention(k + 1, L) reads what attention(k, L) wrote (the layer's latents or keys, its indexer keys,
+its KDA recurrent state), and it runs after it; attention(k, L + 1) reads k's layer-L reply, collected before it.
+Each MoE exchange keeps its rows (at most the experts' prompt chunk), so the experts' grouping, and every bit, is the
+same as the chunks' alone.
+
+- The wire (``afd.AfdWire.begin_pair``, MODE_PAIR): two forwards open, their MoE exchanges alternating, one request
+  in flight on each MCDMA link at a time (protocol 1's one-mailbox rule, unchanged), so the experts serve them in
+  arrival order. The expert nodes accept MODE_PAIR only when the settings handshake carries ``pairs``.
+- Buffers: the second chunk's own residual streams, hyper-connection weights, DFlash2 taps and token ids
+  (``slot_buffers``); everything else is scratch one phase uses and leaves before the other chunk's next phase
+  (``SLOT_FIELDS`` says why each is enough).
+- Kept states: a state kept at the first chunk's end (a kept point, a shared-prefix point) is taken layer by layer
+  (``Hold``): each KDA layer's recurrent state and convolution window right after the first chunk's attention there,
+  before the second chunk's; the latents, indexer pools and rings up to that point are not written by the second chunk.
+- Phase 1 pairs only when no stream needs a decode round (``multi.MultiDecoder``): a cold prompt alone, or several
+  prompts filling together (TF_GLM_MULTI_PREFILL's grouped chunks too); the first chunk ends no prompt and no chunk
+  holds a stream drafting with the MTP head.
+
+This tree's own design for the attention/expert split; not a MiaAI-Lab recipe patch.
+"""
+
+from __future__ import annotations
+
+import copy
+import os
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+import torch
+
+ENV = "TF_GLM_PREFILL_PAIRS"
+
+# the second chunk's own buffers (``slot_buffers``); every other prompt buffer is shared, being scratch that one
+# phase writes and reads before the other chunk's next phase (``_steps``): the KDA / DSA / indexer / dense-MLP / split-K
+# / latent scratch inside ``layer_front`` and ``mlp_block``; normed, xs, pick and wts from ``layer_front`` /
+# ``moe_route`` to ``moe_send`` (only the other chunk's collect runs between); sy from ``moe_send`` to ``collect`` and
+# afd_recv from ``collect`` to ``hc_post`` (only the other chunk's hc_post / attention, or its moe_send, between);
+# hidden, fnormed, fxs and logits within a chunk's tail (its heads and last row copied there)
+SLOT_FIELDS = ("ids", "x", "post", "comb")
+
+SEND, WAIT, DONE = "send", "wait", "done"   # what a chunk's layer loop stops for (``_steps``)
+
+
+def enabled(value: str | None = None) -> bool:
+    """TF_GLM_PREFILL_PAIRS: 1 runs prompt chunks in pairs on the AFD attention node; unset or 0 (the default) one
+    chunk at a time."""
+
+    value = (os.environ.get(ENV, "") if value is None else value).strip() or "0"
+    if value not in ("0", "1"):
+        raise ValueError(f"{ENV}: 0 or 1, not {value!r}")
+    return value == "1"
+
+
+def slot_buffers(b):
+    """The second chunk's prompt buffers: ``b`` (forward.Buffers, prefill) with its own token ids, residual streams,
+    hyper-connection weights and DFlash2 taps (``SLOT_FIELDS``), the rest shared."""
+
+    two = copy.copy(b)
+    for name in SLOT_FIELDS:
+        setattr(two, name, torch.empty_like(getattr(b, name)))
+    two.ids_host = torch.zeros_like(b.ids_host, pin_memory=torch.cuda.is_available())
+    two.staged = torch.cuda.Event() if torch.cuda.is_available() else b.staged
+    two.taps = [torch.empty_like(t) for t in b.taps]
+    two.pair_of = b
+    return two
+
+
+def slot_bytes(b) -> int:
+    """What ``slot_buffers`` adds on the device (the startup line's)."""
+
+    held = [getattr(b, name) for name in SLOT_FIELDS] + list(b.taps)
+    return sum(t.numel() * t.element_size() for t in held)
+
+
+def plan_bytes(text: dict, rows: int, *, taps: int) -> int:
+    """``slot_bytes`` before the buffers exist, for the capacity plan (``text``: the checkpoint's text config; ``rows``:
+    the prompt chunk's; ``taps``: DFlash2's tapped layers, 0 without a drafter): token ids, the residual streams
+    and DFlash2 taps (bf16), the hyper-connection weights (fp32). 144 MiB for GLM-5.3-Flash at 2,048 rows."""
+
+    d, s = int(text["hidden_size"]), int(text.get("hc_mult", 4))
+    return rows * (4 + 2 * s * d + 4 * s + 4 * s * s + 2 * taps * d)
+
+
+class At:
+    """A stream's state as a later chunk of a pair sees it: the position its rows start at (host and device), every
+    cache, state and table the stream's. The forward reads states only; the pair's commits go to the stream."""
+
+    def __init__(self, st, pos: int, pos_dev) -> None:
+        object.__setattr__(self, "_st", st)
+        object.__setattr__(self, "pos", pos)
+        object.__setattr__(self, "pos_dev", pos_dev)
+
+    def __getattr__(self, name: str):
+        return getattr(self._st, name)
+
+    def __setattr__(self, name: str, value) -> None:
+        raise AttributeError(f"a prompt chunk pair's later chunk does not set the stream state's {name!r}")
+
+
+def _pos_tensor(st, pos: int):
+    """The device position a pair's later chunk of ``st`` starts at (its own tensor: the first chunk reads st's)."""
+
+    return torch.full_like(st.pos_dev, pos)
+
+
+class Hold:
+    """A kept state at a pair's first chunk's end for ``st``: each KDA layer's recurrent state and convolution window
+    copied right after that chunk's attention there, before the second chunk's (``take``)."""
+
+    def __init__(self, st) -> None:
+        self.st = st
+        self.rec = torch.empty_like(st.rec[0])
+        self.conv = torch.empty_like(st.conv)
+
+    def take(self, layer) -> None:
+        st = self.st
+        li = st.kda_index.get(layer.index) if layer.kind == "kda" else None
+        if li is not None:
+            self.rec[li].copy_(st.rec[st.cur[li], li])
+            self.conv[li].copy_(st.conv[li])
+
+
+@dataclass(eq=False)
+class Chunk:
+    """One chunk of a pair: its pieces (``multi_prefill.Piece``: one stream's rows, or several streams' as a
+    TF_GLM_MULTI_PREFILL chunk), what the forward runs it on, and after it its heads and kept states."""
+
+    pieces: list
+    slot: int
+    b: Any = None
+    R: int = 0
+    st: Any = None                     # a one-piece chunk's state (At for a pair's later chunk of the same stream)
+    mixer: Any = None                  # several pieces: multi_prefill.PieceMixer
+    nch: int | None = None
+    host_pos: int | None = None
+    holds: list = field(default_factory=list)
+    heads: list = field(default_factory=list)
+    last_hidden: Any = None
+
+    @property
+    def single(self) -> bool:
+        return len(self.pieces) == 1
+
+    def held(self, st):
+        """(rec, conv) kept at this chunk's end for ``st`` (``Hold``), or None."""
+
+        for h in self.holds:
+            if h.st is st:
+                return h.rec, h.conv
+        return None
+
+
+def _stage_chunk(e, ch: Chunk) -> None:
+    """The chunk's room checked and its token ids into its prompt buffers (``forward.stage`` /
+    ``multi_prefill._stage``)."""
+
+    from . import forward, multi_prefill
+
+    if ch.single:
+        forward.stage(e.w, ch.st, ch.b, ch.pieces[0].tokens)
+    else:
+        multi_prefill._stage(e.w, ch.b, ch.mixer.pieces, ch.R)
+
+
+def run_pair(e, first: Sequence, second: Sequence, *, hold: Sequence = ()) -> tuple[Chunk, Chunk]:
+    """Two consecutive prompt chunks' forwards as a pair: ``first`` and ``second`` each a list of
+    ``multi_prefill.Piece`` (one stream's rows, or several streams' back to back); a stream in both has its rows in
+    ``second`` start where ``first``'s end. ``hold``: states of ``first``'s streams to keep at its end (``Hold``).
+    Returns both chunks with their heads (a one-piece chunk's head logits copy, as ``decode.prefill_chunk`` returns
+    it; per piece ending its prompt, as ``multi_prefill.prefill_pieces``); their taps and commits are ``finish``'s,
+    each chunk's in order. Positions are not committed here."""
+
+    from . import latent, multi_prefill
+    from .forward import chunks_for
+
+    w = e.w
+    afd = getattr(w, "afd", None)
+    if afd is None or not hasattr(afd, "begin_pair"):
+        raise RuntimeError("prompt chunk pairs run on the AFD attention node (--experts remote)")
+    b2 = getattr(e, "pbuf2", None)
+    if b2 is None:
+        b2 = e.pbuf2 = slot_buffers(e.pbuf)
+    rows = min(e.pbuf.rows, e.prefill_rows)
+    chunks = []
+    ends: dict[int, tuple[Any, int]] = {}
+    for slot, (pieces, b) in enumerate(((list(first), e.pbuf), (list(second), b2))):
+        if not pieces:
+            raise ValueError("a prompt chunk pair needs two chunks")
+        ch = Chunk(pieces, slot, b)
+        mine = []
+        for p in pieces:
+            if any(q.st is p.st for q in mine):
+                raise ValueError("a stream has one piece in a chunk")
+            mine.append(p)
+            seen = ends.get(id(p.st))
+            if slot == 1 and seen is not None:   # the stream's next rows: from where its rows in the first chunk end
+                p.st = At(seen[0], seen[1], _pos_tensor(seen[0], seen[1]))
+        if not ch.single and not latent.ENABLED:
+            raise ValueError("multi-prompt chunks need the latent cache (TF_GLM_LATENT=1)")
+        ch.R = multi_prefill.layout(pieces, rows) if not ch.single else len(pieces[0].tokens)
+        if not 0 < ch.R <= rows:
+            raise ValueError(f"a prompt chunk of {ch.R} rows, the prompt buffers hold {rows}")
+        if ch.single:
+            ch.st = pieces[0].st
+            ch.nch, ch.host_pos = chunks_for(ch.st, ch.R), ch.st.pos
+        else:
+            ch.mixer = multi_prefill.PieceMixer(w, b, pieces, ch.R)
+        if slot == 0:
+            for p in pieces:
+                ends[id(p.st)] = (p.st, p.st.pos + p.rows)
+        chunks.append(ch)
+    a, b = chunks
+    for st in hold:
+        if not any(p.st is st for p in a.pieces):
+            raise ValueError("a held state belongs to the pair's first chunk")
+        a.holds.append(Hold(st))
+    for ch in chunks:
+        _stage_chunk(e, ch)
+    afd.begin_pair((a.R, b.R))           # both windows' headers, before either's eager kernels
+    _forward_pair(e, a, b)
+    return a, b
+
+
+def _mark(slot: int) -> None:
+    """Each time the pair's schedule resumes a chunk (tests record the interleaving)."""
+
+
+def _forward_pair(e, a: Chunk, b: Chunk) -> None:
+    """Both chunks' layer loops, interleaved: a chunk runs until it would wait (to send while the other's request
+    is in flight, or for its own reply while the other can work); the first chunk goes first."""
+
+    gens = [_steps(e, a), _steps(e, b)]
+    at: list[Any] = [None, None]          # where each loop stopped: None (not started), SEND, WAIT, DONE, or END
+    end = object()
+    owner = None                          # the chunk whose request is on the wire
+
+    def step(k: int):
+        _mark(k)
+        try:
+            return next(gens[k])
+        except StopIteration:
+            return end
+
+    k = 0
+    at[0] = step(0)
+    while at[0] is not end or at[1] is not end:
+        here, there = at[k], at[1 - k]
+        if here is end:
+            k = 1 - k
+            if at[k] is None:
+                at[k] = step(k)
+            continue
+        if here is SEND:
+            if owner is None:             # the link is free: this chunk's exchange goes out now
+                owner = k
+                at[k] = step(k)
+            else:
+                k = 1 - k
+                if at[k] is None:
+                    at[k] = step(k)
+            continue
+        if here is WAIT:
+            if there is None or there is DONE:    # the other chunk works while this one's experts compute
+                k = 1 - k
+                at[k] = step(k)
+            else:
+                at[k] = step(k)           # collect
+                if at[k] is DONE:
+                    owner = None
+            continue
+        if here is DONE:
+            owner = None
+            if there is SEND:             # the link is free: the other chunk's exchange first
+                k = 1 - k
+                owner = k
+                at[k] = step(k)
+            else:
+                at[k] = step(k)
+            continue
+        raise AssertionError(f"a pair's chunk stopped at {here!r}")
+
+
+def _steps(e, ch: Chunk):
+    """One chunk's forward as ``forward.compute`` runs it, layer by layer (``forward.layer_forward``'s calls in its
+    order), stopping before each MoE exchange's send (``SEND``), before its collect (``WAIT``) and after it (``DONE``),
+    then its tail: the final norm and the head (a one-piece chunk's on its last row, as ``decode.prefill_chunk``; per
+    piece ending its prompt, as ``multi_prefill.prefill_pieces``), copied here, before the other chunk's tail reuses
+    the shared rows."""
+
+    from . import forward, glue
+
+    w, b, R, slot = e.w, ch.b, ch.R, ch.slot
+    afd, c = w.afd, w.cfg
+    x = b.x[:R]
+    glue.embed(b.ids[:R], w.embed, c.hidden, c.streams, x)
+    for layer in w.layers:
+        forward.layer_front(layer, w, ch.st, b, R, ch.nch, ch.host_pos, None, None, ch.mixer)
+        for h in ch.holds:
+            h.take(layer)
+        if layer.mlp is not None:
+            g = forward.mlp_block(layer, w, b, R)
+        else:
+            forward.moe_route(layer, w, b, R)
+            yield SEND
+            afd.use(slot)
+            forward.moe_send(layer, w, b, R)
+            yield WAIT
+            afd.use(slot)
+            g = afd.collect(b, R, c.hidden)
+            yield DONE
+        glue.hc_post(x, x, g, b.post[:R], b.comb[:R])
+        for t in b.tap_at.get(layer.index, ()):
+            glue.stream_mean(x, b.taps[t][:R])
+    glue.stream_mean(x, b.hidden[:R])
+    glue.rmsnorm(b.hidden[:R], w.norm, c.eps, b.fnormed[:R], b.fxs[:R])
+    if ch.single:
+        p = ch.pieces[0]
+        out = forward.mm(b, b.fnormed[R - 1:R], w.head, b.fxs[R - 1:R], b.logits[:1])
+        ch.heads = [out.clone() if p.head else None]
+        ch.last_hidden = b.fnormed[R - 1:R].clone()
+    else:
+        for p in ch.pieces:
+            r = p.lo + p.rows - 1
+            ch.heads.append(forward.mm(b, b.fnormed[r:r + 1], w.head, b.fxs[r:r + 1], b.logits[:1]).clone()
+                            if p.head else None)
+
+
+def finish(e, ch: Chunk) -> None:
+    """After the pair's forward, one chunk's host work as its forward alone does it, chunks in order: its last row's
+    hidden state (a one-piece chunk's), its DFlash2 taps, its commits (each stream's position past its rows)."""
+
+    from . import forward
+
+    w, b = e.w, ch.b
+    if ch.single:
+        p = ch.pieces[0]
+        e.last_hidden = ch.last_hidden
+        if p.drafter is not None:
+            p.drafter.add_taps(e.tap_rows(ch.R, b))
+    else:
+        for p in ch.pieces:
+            if p.drafter is not None:
+                p.drafter.add_taps(torch.cat([t[p.lo:p.lo + p.rows] for t in b.taps], dim=1))
+    for p in ch.pieces:
+        st = p.st._st if isinstance(p.st, At) else p.st
+        forward.commit(w, st, b, p.rows, p.rows)
