+_CLOCK = [0.0]       # _HostEvent's clock (ms)
+
+
+class _HostEvent:
+    """A CUDA event on a host clock that ticks 1 ms at each record (TF_AFD_TIME's lines on CPU)."""
+
+    def __init__(self, enable_timing: bool = False) -> None:
+        self.t = None
+
+    def record(self, *_) -> None:
+        _CLOCK[0] += 1.0
+        self.t = _CLOCK[0]
+
+    def elapsed_time(self, end) -> float:
+        if self.t is None or end.t is None:
+            raise RuntimeError("an event not recorded")
+        return end.t - self.t
+
+
+def test_the_pair_timer_line(env, daemon, words, master, monkeypatch, capsys):
+    """TF_AFD_TIME=1 with pairs: each paired exchange's send / collect / reply events, sampled when the pair closes;
+    every 8 pairs one ``afd pair overlap`` line with those 8 pairs' count and, per window size R, the window (send to
+    the reply copied in), the wait (the collect to it) and the in-window work (their difference) p50 / p90. On the host
+    clock here every exchange's window is 2 ms, its wait 1 ms and its work 1 ms; a pair that never closes is not
+    sampled."""
+
+    import torch
+
+    monkeypatch.setattr(torch.cuda, "Event", _HostEvent)
+    monkeypatch.setattr(torch.cuda, "synchronize", lambda *a, **k: None)
+    links, eps = _links(daemon, words)
+    wait_attached(daemon)
+    a = mcdma_attention(links, master)
+    a.timing, a.ev = True, None                          # the pairs' own events only (begin_pair makes them)
+    gen = torch.Generator().manual_seed(12)
+    n, rows = len(LAYERS), (PREFILL, 7)
+
+    def want(total: int) -> str:
+        return (f"[tensorfold] afd pair overlap: {16 * n} paired MoE exchanges over the last 8 pairs ({total} so far; "
+                f"in-window work: the shared expert + the other chunk's attention); " + "; ".join(
+                    f"R{r} n{8 * n} window p50 2.00 ms p90 2.00, wait for the reply p50 1.00 ms p90 1.00, in-window "
+                    f"work p50 1.00 ms p90 1.00" for r in sorted(rows)))
+
+    for k in range(17):
+        _pair(a, rows, gen)
+        if k in (7, 15):
+            assert "afd pair overlap" not in capsys.readouterr().out     # the 8th / 16th pair closes at the next header
+        if k == 8:
+            out = capsys.readouterr().out
+            assert out.count("afd pair overlap") == 1 and want(8) in out, out
+            assert a._pairs_timed == 8 and a._overlap == {} and a.dead is None   # the 9th pair is still open
+    out = capsys.readouterr().out
+    assert out.count("afd pair overlap") == 1 and want(16) in out, out   # each line has its own 8 pairs' samples only
+    assert a._pairs_timed == 16 and a._overlap == {} and a.dead is None
+    _plain(a, 5, gen)
+    assert a._pairs_timed == 17 and sorted(a._overlap) == sorted(rows) and all(ep.error is None for ep in eps)
+    _close(daemon, eps)
+
