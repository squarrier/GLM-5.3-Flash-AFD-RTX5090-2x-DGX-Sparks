+
+    # -- TF_AFD_TIME with prompt chunk pairs: the overlap -----------------------------------------------------------
+    def _sample_pair(self, rows: tuple[int, int], every: int = 8) -> None:
+        """Per paired MoE exchange of a pair whose windows both completed (``_close_pair``), from its events on the
+        compute stream, by the window's rows R: the window (send to the reply copied in) and the wait (the stream
+        reaching the collect to the reply copied in: the GPU idle for the reply, plus the reply's copy). Between a
+        window's send and its collect the stream runs that layer's shared expert and the other chunk's work (its
+        attention and routing, the next exchange's); the window less the wait is that work, which ran while the
+        experts computed. Every ``every`` pairs, per R over those pairs' exchanges: the count and the window, wait and
+        in-window p50 / p90 (the overlap gate compares the window with TF_AFD_TIME's serial exchange at the same R, on
+        the same boot)."""
+
+        if self._pev is None:
+            return
+        self.torch.cuda.synchronize()
+        ov = dict(self._overlap or {})
+        for r, win in zip(rows, self._pev):
+            ov[r] = [*ov.get(r, ()), *((send.elapsed_time(w1), w0.elapsed_time(w1)) for send, w0, w1 in win)]
+        self._overlap = ov
+        self._pairs_timed += 1
+        if self._pairs_timed % every == 0 and ov:
+            parts = []
+            for r, v in sorted(ov.items()):
+                spans, waits, work = [s for s, _ in v], [wt for _, wt in v], [s - wt for s, wt in v]
+                parts.append(f"R{r} n{len(v)} window p50 {p50_p90(spans)[0]:.2f} ms p90 {p50_p90(spans)[1]:.2f}, wait "
+                             f"for the reply p50 {p50_p90(waits)[0]:.2f} ms p90 {p50_p90(waits)[1]:.2f}, in-window "
+                             f"work p50 {p50_p90(work)[0]:.2f} ms p90 {p50_p90(work)[1]:.2f}")
+            print(f"[tensorfold] afd pair overlap: {sum(len(v) for v in ov.values())} paired MoE exchanges over the "
+                  f"last {every} pairs ({self._pairs_timed} so far; in-window work: the shared expert + the other "
+                  f"chunk's attention); {'; '.join(parts)}", flush=True)
+            self._overlap = {}
