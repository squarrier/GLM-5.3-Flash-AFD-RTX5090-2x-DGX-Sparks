+# -- with TF_GLM_FILL_BUDGET_MS: tests/test_glm_sliced_fill.py's layered fake model and checked wire --------------------
+def _sliced(env, monkeypatch, *, pairs):
+    """tests/test_glm_sliced_fill.py's world 1 (budget 2.5 ms of 1-ms layers) with the setting on or off; every pair
+    checked: no stream decoding, no sliced chunk suspended."""
+
+    from tests import test_glm_sliced_fill as tsf
+
+    if pairs:
+        monkeypatch.setenv(ENV, "1")
+    else:
+        monkeypatch.delenv(ENV, raising=False)
+    tsf.layered(monkeypatch, "2.5")
+    n1 = tsf.SlicedWorld1(env, streams=2)
+    d = n1.d
+    assert d.pairs == pairs and d.fill_budget == 2.5
+    fills, real = [], d._fill_pair
+
+    def checked(first, second):
+        assert d.partial is None and not any(x.decoding and not x.s.done for x in d.lanes.values())
+        fills.append(([(x.sid, stop) for x, stop in first], [(x.sid, stop) for x, stop in second]))
+        return real(first, second)
+
+    d._fill_pair = checked
+    return n1, d, fills
+
+
+def _kept(d):
+    from tests import test_glm_sliced_fill as tsf
+
+    return tsf.tmp.kept_view(d)
+
+
+def test_sliced_fills_run_as_before_with_pairs_on(afd_fake, monkeypatch):
+    """A 5-chunk prompt fills alone (pairs, setting on), then decodes while a 4-chunk prompt arrives: that one's chunks
+    go in layer slices with decode rounds between them, as with the setting off (no pair while a stream decodes or a
+    sliced chunk is suspended); the replies are the solo ones and the kept states equal the setting off."""
+
+    from tensorfold.families.glm5_next.cuda.afd import MODE_SLICE
+    from tests import test_glm_sliced_fill as tsf
+
+    reqs = [(tm._prompt(300, 51), 40, tm._sampling("greedy", 51)), (tm._prompt(200, 52), 12, tm._sampling("topk", 52))]
+    runs = {}
+    for pairs in (False, True):
+        n1, d, fills = _sliced(afd_fake, monkeypatch, pairs=pairs)
+        a = n1.submit(*reqs[0])
+        while not (a.sid in d.lanes and d.lanes[a.sid].decoding):
+            n1.step()
+        b = n1.submit(*reqs[1])
+        n1.run()
+        for s, (pr, cnt, sp) in zip((a, b), reqs):
+            assert s.got == tm.solo(afd_fake.torch, pr, cnt, sp)
+        runs[pairs] = (n1, d, fills, [a.got, b.got], _kept(d))
+    (n0, d0, f0, g0, k0), (n1, d1, f1, g1, k1) = runs[False], runs[True]
+    assert g0 == g1 and k0 == k1 and not f0 and f1 and d1.paired["pairs"] == len(f1)
+    assert [e for e in n1.wire.events if e[0] == "pair"] and not [e for e in n0.wire.events if e[0] == "pair"]
+    assert d1.sliced["chunks"] > 0 and d1.sliced == d0.sliced and tsf._between(n1.begins())
+    assert [x for x in n1.begins() if x[2] == MODE_SLICE] == [x for x in n0.begins() if x[2] == MODE_SLICE]
+    assert d1.partial is None and n1.wire.tr.next is None
