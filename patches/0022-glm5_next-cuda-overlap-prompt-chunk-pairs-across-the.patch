@@ -0,0 +1,966 @@
+"""TF_GLM_PREFILL_PAIRS (``prefill_pairs``, ours) on CPU: two prompt chunks in flight on the AFD attention node.
+
+- The forward seam: the real ``prefill_pairs.run_pair`` over the real forward (tests/test_glm_multi_prefill.py's
+  recorded kernels, every tensor named by its buffer, state or weight): each chunk's calls are its solo
+  ``decode.prefill_chunk``'s (or ``multi_prefill.prefill_pieces``'s), the second chunk's own buffers and device
+  position aside; the schedule really interleaves (the second chunk's attention of layer L inside the first's
+  exchange window of layer L, the first's layer L + 1 inside the second's); one request on the wire at a time; a
+  state kept at the first chunk's end is the one the solo chunk leaves, though the second chunk moves the stream on.
+- The wire: the real ``AfdWire`` + ``McdmaTransport`` and both expert loops (``experts_node.forwards``) over the
+  fake mcdma-rpcd pair (tests/glm_afd_fakes.py), CPU- and GPU-driven: a pair's replies, the experts' order, its
+  headers (round trip, the second window checked against the first), a plain forward after it; an expert node
+  without ``pairs`` refuses MODE_PAIR, and an old peer refuses the settings; a reply out of order, a second request
+  on a link and a pair that stops early are refused; a stalled link times out; TF_AFD_CHECK checks paired forwards
+  and names them; pairs and TF_GLM_FILL_BUDGET_MS's layer slices (MODE_SLICE) share one wire, in either order.
+- The engine (tests/test_glm_multi.py's fake model at world 1, ``afd_fake``): with the setting on, replies, cached
+  counts, kept states and their pool rows equal the setting off, for prompts of 1, 2, 3 and 5 chunks and odd
+  remainders, with and without TF_GLM_SHARED_PREFIX and TF_GLM_MULTI_PREFILL, and with fp8 rings; a stream cancelled
+  after a pair frees its extent as after the same chunks alone; while a stream decodes no pair runs. With
+  TF_GLM_FILL_BUDGET_MS (tests/test_glm_sliced_fill.py's checked wire): a chunk started while a stream decodes still
+  goes in layer slices, no pair runs while a sliced chunk is suspended, and a client leaving mid-pair (the server's
+  poll) frees the extent as when it leaves during the same chunk alone.
+"""
+
+from __future__ import annotations
+
+import importlib
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from tests import test_glm_kv8_multi as tk
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests import test_glm_multi_prefill as hp
+from tests.glm_afd_fakes import (  # noqa: F401
+    LAYERS,
+    PREFILL,
+    D,
+    DictStore,
+    FakeDriver,
+    FakeNode,
+    S,
+    daemon_fixture,
+    env_fixture,
+    libpath_fixture,
+    master_fixture,
+    mcdma_attention,
+    partial,
+    wait_attached,
+    words_fixture,
+)
+from tests.test_cuda_geometry import allocations  # noqa: F401
+from tests.test_glm_multi import fake  # noqa: F401
+
+pytestmark = pytest.mark.torch
+afd_fake = ta.afd_fake
+rings = tk.rings
+ENV = "TF_GLM_PREFILL_PAIRS"
+
+
+def _mp():
+    from tensorfold.families.glm5_next.cuda import multi_prefill
+
+    return multi_prefill
+
+
+# -- the setting -----------------------------------------------------------------------------------------------------
+def test_the_setting_and_the_handshake(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import afd
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    monkeypatch.delenv(ENV, raising=False)
+    assert not pp.enabled() and not pp.enabled("0") and not pp.enabled(" ") and pp.enabled("1")
+    for bad in ("2", "on", "true", "yes"):
+        with pytest.raises(ValueError, match=ENV):
+            pp.enabled(bad)
+    cfg = SimpleNamespace(mlp_kinds=["dense"] * 3 + ["moe"] * 4, quant="exl3", experts=16, top_k=8)
+    plain = afd.settings_for("/nonexistent", cfg, prefill_rows=2048)
+    paired = afd.settings_for("/nonexistent", cfg, prefill_rows=2048, pairs=True)
+    assert "pairs" not in plain and paired == dict(plain, pairs=1)       # off: the settings exactly as before
+    assert afd.settings_mismatch(plain, paired) == "pairs: attention 1 != expert None"   # an old expert refuses
+    assert afd.settings_mismatch(paired, paired) == ""
+    # the capacity plan's bytes for the second chunk's buffers at GLM-5.3-Flash's shapes, DFlash2's 5 taps
+    assert pp.plan_bytes({"hidden_size": 4096, "hc_mult": 4}, 2048, taps=5) == 151_166_976    # 144.2 MiB
+
+
+# -- the forward seam: recorded kernels -----------------------------------------------------------------------------
+def _seam(monkeypatch, dense_limit=10**6):
+    """build_forward's weights and buffers, the second chunk's buffers (``slot_buffers``) named b2.*, the wire's
+    pair calls and the schedule's resumptions recorded, KDA chains and conv shifts that move the state (so a kept
+    state taken after the second chunk would differ)."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import decode, kda
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    forward = importlib.import_module("tensorfold.families.glm5_next.cuda.forward")
+    rec = hp.Rec(torch)
+    w, b = hp.build_forward(torch, rec, dense_limit=dense_limit)
+    hp.patch_kernels(monkeypatch, rec, forward)
+    monkeypatch.setattr(decode, "commit", forward.commit)
+    chain, shift = kda.chain, forward._shift_conv
+
+    def moving_chain(*a, **k):
+        a[14].copy_(a[6] * 3 + a[12])                 # rec_out from rec_in and the rows
+        return chain(*a, **k)
+
+    def moving_shift(conv, proj, keep):
+        conv.add_(keep)
+        return shift(conv, proj, keep)
+
+    monkeypatch.setattr(kda, "chain", moving_chain)
+    monkeypatch.setattr(forward, "_shift_conv", moving_shift)
+    w.afd.begin_pair = rec.fn("afd.begin_pair")
+    w.afd.use = rec.fn("afd.use")
+    b2 = pp.slot_buffers(b)
+    for name in pp.SLOT_FIELDS:
+        rec.register("b2." + name, getattr(b2, name))
+    for i, t in enumerate(b2.taps):
+        rec.register(f"b2.tap{i}", t)
+    rec.aliases[id(b2)] = "B2"
+    alive = []
+
+    def pos_tensor(st, pos):
+        t = torch.full_like(st.pos_dev, pos)
+        rec.register(f"st{st.slot}.pos_dev@", t)
+        alive.append(t)
+        return t
+
+    monkeypatch.setattr(pp, "_pos_tensor", pos_tensor)
+    monkeypatch.setattr(pp, "_mark", lambda k: rec.calls.append(("slot", k)))
+    return SimpleNamespace(torch=torch, rec=rec, w=w, b=b, b2=b2, pp=pp, decode=decode, forward=forward, alive=alive)
+
+
+def _canon(x):
+    if isinstance(x, str):
+        return {"B2": "B"}.get(x, x.replace("b2.", "b.").replace(".pos_dev@", ".pos_dev"))
+    if isinstance(x, tuple):
+        return tuple(_canon(v) for v in x)
+    return x
+
+
+def _engine(s, st=None):
+    torch = s.torch
+    return SimpleNamespace(w=s.w, st=st, pbuf=s.b, pbuf2=s.b2, prefill_rows=64, last_hidden=None,
+                           tap_rows=lambda k, bb: torch.cat([t[:k] for t in bb.taps], dim=1))
+
+
+def _kernel(c) -> bool:
+    return c[0] not in ("slot", "enter", "exit") and not c[0].startswith("afd.")
+
+
+def _by_slot(calls) -> tuple[list, list]:
+    out, k = ([], []), 0
+    for c in calls:
+        if c[0] == "slot":
+            k = c[1]
+        elif _kernel(c):
+            out[k].append(_canon(c))
+    return out
+
+
+def _drafter(got, rec):
+    return SimpleNamespace(add_taps=lambda t: got.append(rec.norm(t)))
+
+
+@pytest.mark.parametrize("dense_limit", [10**6, 100], ids=["dense", "sparse-past-100"])
+@pytest.mark.parametrize("pos,na,nb,hold", [(0, 64, 64, False), (3, 40, 1, True), (90, 64, 23, True),
+                                            (500, 7, 64, False)])
+def test_a_pair_gives_each_chunk_its_solo_calls(allocations, monkeypatch, dense_limit, pos, na, nb, hold):  # noqa: F811
+    """One stream's two consecutive chunks (positions dense, crossing the dense limit and past it, odd sizes, the
+    second ending the prompt): every kernel call of each chunk in the pair is its solo prefill_chunk's (the second
+    chunk's b2.* buffers and its own device position named as the solo's), taps and heads included; the wire saw
+    one begin_pair and per MoE layer the first chunk's exchange and collect, then the second's; a state kept at the
+    first chunk's end equals the solo chunk's end state."""
+
+    s = _seam(monkeypatch, dense_limit)
+    torch, rec = s.torch, s.rec
+    prompt = list(range(1, pos + na + nb + 1))
+    st = hp.TraceState(torch, rec, 1, pos)
+    e = _engine(s, st)
+    solo, taps0 = [], []
+    rec.calls = []
+    s.decode.prefill_chunk(e, prompt, pos, na, drafter=_drafter(taps0, rec), head=False)
+    solo.append([_canon(c) for c in rec.calls if _kernel(c)])
+    kept = (st.rec[st.cur[0]].clone(), st.conv.clone())
+    rec.calls = []
+    out_solo = s.decode.prefill_chunk(e, prompt, pos + na, nb, drafter=_drafter(taps0, rec), head=True)
+    solo.append([_canon(c) for c in rec.calls if _kernel(c)])
+    end_solo = (st.rec.clone(), st.conv.clone(), list(st.cur), st.pos)
+
+    st2 = hp.TraceState(torch, rec, 1, pos)
+    eng = _engine(s)
+    taps1 = []
+    rec.calls = []
+    a, b = s.pp.run_pair(eng, [_mp().Piece(st2, prompt[pos:pos + na], drafter=_drafter(taps1, rec))],
+                         [_mp().Piece(st2, prompt[pos + na:pos + na + nb], drafter=_drafter(taps1, rec), head=True)],
+                         hold=[st2] if hold else [])
+    calls = list(rec.calls)
+    assert st2.pos == pos                                # positions are finish's
+    s.pp.finish(eng, a)
+    s.pp.finish(eng, b)
+    assert _by_slot(calls) == (solo[0], solo[1])
+    assert taps1 == taps0 and st2.pos == pos + na + nb
+    assert st2.rec.tolist() == end_solo[0].tolist() and st2.conv.tolist() == end_solo[1].tolist()
+    assert list(st2.cur) == end_solo[2]
+    assert a.heads == [None] and b.heads[0].shape == out_solo.shape
+    if hold:
+        rec_h, conv_h = a.held(st2)
+        assert torch.equal(rec_h, kept[0]) and torch.equal(conv_h, kept[1])
+        assert not torch.equal(rec_h, st2.rec[st2.cur[0]])     # the stream has moved on since
+    else:
+        assert a.held(st2) is None
+    wire = [c for c in calls if c[0].startswith("afd.")]
+    assert wire[0] == ("afd.begin_pair", ((na, nb),), ())
+    moe = 3                                              # build_forward: layers 1, 2, 3 are MoE
+    ops, slot = [], 0
+    for c in wire[1:]:
+        if c[0] == "afd.use":
+            slot = c[1][0]
+        else:
+            ops.append((c[0][4:], slot, c[1][1]))
+    assert ops == [(op, k, (na, nb)[k]) for _ in range(moe) for k in (0, 1) for op in ("exchange", "collect")]
+
+
+def test_the_schedule_interleaves(allocations, monkeypatch):  # noqa: F811
+    """The recorded order: the second chunk's attention of MoE layer L (its mixer's stream-state calls) runs after
+    the first chunk's exchange of layer L and before its collect; the first chunk's attention of layer L + 1 runs
+    inside the second chunk's window of layer L; never two exchanges without a collect between."""
+
+    s = _seam(monkeypatch)
+    torch, rec = s.torch, s.rec
+    st = hp.TraceState(torch, rec, 2, 10)
+    prompt = list(range(1, 200))
+    rec.calls = []
+    s.pp.run_pair(_engine(s), [_mp().Piece(st, prompt[10:74])], [_mp().Piece(st, prompt[74:120], head=True)])
+    events, slot, cur = [], 0, 0
+    for c in rec.calls:
+        if c[0] == "slot":
+            slot = c[1]
+        elif c[0] == "afd.use":
+            cur = c[1][0]
+        elif c[0] in ("afd.exchange", "afd.collect"):
+            events.append((c[0][4], cur))
+        elif c[0] == "enter":                            # a layer's KDA / DSA stream-state work
+            events.append(("m", slot))
+    xs = [i for i, ev in enumerate(events) if ev[0] == "e"]
+    cs = [i for i, ev in enumerate(events) if ev[0] == "c"]
+    assert len(xs) == len(cs) == 6 and all(x < c for x, c in zip(xs, cs))
+    assert all(c < x for c, x in zip(cs, xs[1:]))         # one request on the wire at a time
+    for n, (x, c) in enumerate(zip(xs, cs)):
+        k = events[x][1]
+        between = [ev for ev in events[x + 1:c] if ev[0] == "m"]
+        if n < 5:                                        # every window but the last holds the other chunk's attention
+            assert between and all(ev[1] == 1 - k for ev in between), (n, events[x:c + 1])
+    mixers = [ev[1] for ev in events if ev[0] == "m"]
+    assert mixers.count(0) == mixers.count(1) == 4
+
+
+def test_grouped_chunks_pair(allocations, monkeypatch):  # noqa: F811
+    """TF_GLM_MULTI_PREFILL's chunks as a pair: the first of two streams' pieces, the second of the same two streams'
+    next rows and a third stream's: each chunk's calls are its solo prefill_pieces', the continuing streams' rows
+    from their first-chunk ends (their own device positions), their kept states held."""
+
+    s = _seam(monkeypatch)
+    torch, rec = s.torch, s.rec
+    plan = [(0, 30, 20, 9), (1, 4, 30, 12), (2, 7, 0, 21)]      # (slot, position, first rows, second rows)
+
+    def run(paired):
+        sts = {k: hp.TraceState(torch, rec, k, pos) for k, pos, _, _ in plan}
+        prompts = {k: list(range(1, pos + n1 + n2 + 1)) for k, pos, n1, n2 in plan}
+        first = [_mp().Piece(sts[k], prompts[k][pos:pos + n1]) for k, pos, n1, _ in plan if n1]
+        second = [_mp().Piece(sts[k], prompts[k][pos + n1:pos + n1 + n2], head=True) for k, pos, n1, n2 in plan]
+        e = _engine(s)
+        rec.calls = []
+        if paired:
+            a, b = s.pp.run_pair(e, first, second, hold=[sts[0], sts[1]])
+            calls = list(rec.calls)
+            s.pp.finish(e, a)
+            s.pp.finish(e, b)
+            return _by_slot(calls), {k: (st.rec.tolist(), st.conv.tolist(), st.pos) for k, st in sts.items()}, a
+        _mp().prefill_pieces(e, first)
+        one = [_canon(c) for c in rec.calls if _kernel(c)]
+        held = {k: (sts[k].rec[sts[k].cur[0]].clone(), sts[k].conv.clone()) for k in (0, 1)}
+        rec.calls = []
+        _mp().prefill_pieces(e, second)
+        two = [_canon(c) for c in rec.calls if _kernel(c)]
+        return (one, two), {k: (st.rec.tolist(), st.conv.tolist(), st.pos) for k, st in sts.items()}, held
+
+    calls0, states0, held0 = run(False)
+    calls1, states1, a = run(True)
+    assert calls1 == calls0 and states1 == states0
+    for k in (0, 1):
+        assert all(torch.equal(x, y) for x, y in zip(a.held(next(p.st for p in a.pieces if p.st.slot == k)),
+                                                     held0[k]))
+
