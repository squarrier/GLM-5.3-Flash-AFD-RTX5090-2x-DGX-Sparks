+    def begin_pair(self, rows) -> None:
+        """Two prompt chunks' headers, before either's eager kernels: forwards seq + 1 (slot 0) and seq + 2 (slot 1),
+        both MODE_PAIR. Their MoE exchanges alternate on the wire, slot 0's layer L, then slot 1's layer L, then slot
+        0's layer L + 1 ...: each link still carries one request at a time (``exchange`` refuses a second before the
+        first's ``collect``); ``use`` picks the window ``exchange`` and ``collect`` act for. The next ``begin`` (or
+        ``begin_pair``) closes the pair: both windows must have made all their exchanges."""
+
+        ra, rb = (int(r) for r in rows)
+        self.begin(ra, chunk=True)               # the refusals and the last forward's check and timing, as begin's
+        first = self.seq                         # (begin wrote slot 0's seq; the header tables are rewritten below)
+        win = {"seq": first, "rows": ra, "mode": MODE_PAIR, "layer": 0, "_chk": None, "_ahead": 0}
+        self._pair = [win, dict(win, seq=first + 1, rows=rb, _ahead=1)]
+        self._slot, self._busy = 0, None
+        self._load(win)
+        self.tr.header_pair((first, first + 1), (ra, rb))
+        if self.timing and self._pev is None:
+            self._pev = [[[self.torch.cuda.Event(enable_timing=True) for _ in range(3)] for _ in range(self.nlayers)]
+                         for _ in range(2)]
+
+    def use(self, slot: int) -> None:
+        """The open pair's window that the next ``exchange`` / ``collect`` act for."""
+
+        if self._pair is None or slot not in (0, 1):
+            raise RuntimeError(f"no prompt chunk pair window {slot} is open")
+        if slot != self._slot:
+            self._pair[self._slot] = {k: getattr(self, k) for k in self._WIN}
+            self._load(self._pair[slot])
+            self._slot = slot
+            self.tr.use(slot)
+
+    def _load(self, win: dict) -> None:
+        for k in self._WIN:
+            setattr(self, k, win[k])
+
+    def _close_pair(self) -> None:
+        """The open pair's end (at the next header): both windows complete, their checks and timing; then the
+        single-window fields as after a forward (seq the pair's last)."""
+
+        self._pair[self._slot] = {k: getattr(self, k) for k in self._WIN}
+        wins, self._pair = self._pair, None
+        self._slot, self._busy = 0, None
+        self.tr.close_pair()
+        for k, win in enumerate(wins):
+            if win["layer"] != self.nlayers:
+                why = (f"a prompt chunk pair's window {k} (seq {win['seq']}) stopped after {win['layer']} of "
+                       f"{self.nlayers} MoE exchanges; the experts are out of step")
+                self.die(why)
+                raise self._cap(f"the AFD expert nodes are gone ({why}); restart the serving stack")
+        if self.check:
+            for win in wins:
+                self._load(win)
+                self._finish_check()
+        if self.timing:
+            self._sample_pair(rows=(wins[0]["rows"], wins[1]["rows"]))
+        self._load(dict(wins[1], layer=0, _chk=None, _ahead=0))
