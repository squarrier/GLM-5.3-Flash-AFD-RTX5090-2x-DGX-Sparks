+# -- the engine: the fake model at world 1 (test_glm_multi_afd.afd_fake's fake_pairs) ---------------------------------
+def _world1(env, monkeypatch, *, pairs, group=False, shared=False, prompts=(), streams=2, cancel=None):
+    for name, on in ((ENV, pairs), ("TF_GLM_MULTI_PREFILL", group), ("TF_GLM_SHARED_PREFIX", shared)):
+        if on:
+            monkeypatch.setenv(name, "1")
+        else:
+            monkeypatch.delenv(name, raising=False)
+    n1 = ta.World1(env, streams=streams)
+    assert n1.d.pairs == pairs
+    fills = []
+    real = n1.d._fill_pair
+
+    def checked(first, second):
+        assert not any(x.decoding and not x.s.done for x in n1.d.lanes.values())
+        fills.append(([(x.sid, stop) for x, stop in first], [(x.sid, stop) for x, stop in second]))
+        return real(first, second)
+
+    n1.d._fill_pair = checked
+    reqs = [(tm._prompt(n, seed), 12, tm._sampling(kind, seed)) for n, seed, kind in prompts]
+    out = [n1.submit(pr, cnt, sp) for pr, cnt, sp in reqs]
+    if cancel is not None:
+        for _ in range(cancel):
+            n1.step()
+        out[0].done = True
+        n1.d.finish([out[0]])
+        return n1, out, reqs, fills
+    n1.run()
+    return n1, out, reqs, fills
+
+
+def _wire_pairs(wire) -> int:
+    """The pairs the fake wire was given: WireLog's ``paired``, or the checked slice wire's ("pair", ...) events (World1
+    has that wire in a run with TF_GLM_FILL_BUDGET_MS set and the sliced fill's seams installed)."""
+
+    return len(getattr(wire, "paired", ())) + len([e for e in getattr(wire, "events", ()) if e[0] == "pair"])
+
+
+LENGTHS = [((40, 1, "greedy"),), ((100, 2, "greedy"),), ((150, 3, "topk"),), ((300, 4, "greedy"),),
+           ((65, 5, "greedy"),), ((166, 6, "topk"),)]
+
+
+@pytest.mark.parametrize("prompts", LENGTHS, ids=["1-chunk", "2-chunks", "3-chunks", "5-chunks", "64+1", "128+38"])
+def test_a_cold_prompt_alone(afd_fake, monkeypatch, prompts):
+    """A cold prompt alone, setting on vs off (64-row chunks): the same reply (its solo reply), cached count and kept
+    states with their pool rows; pairs run where the prompt has two chunks before its last."""
+
+    n0, s0, reqs, _ = _world1(afd_fake, monkeypatch, pairs=False, prompts=prompts)
+    n1, s1, _, fills = _world1(afd_fake, monkeypatch, pairs=True, prompts=prompts)
+    for s, (pr, cnt, sp) in zip(s1, reqs):
+        assert s.got == tm.solo(afd_fake.torch, pr, cnt, sp)
+    assert [s.got for s in s0] == [s.got for s in s1] and [s.cached for s in s0] == [s.cached for s in s1]
+    assert hp.kept_view(n0.d) == hp.kept_view(n1.d)
+    chunks = len([c for c in n0.wire.calls if c[0] == "chunk"])
+    assert n1.d.paired["pairs"] == len(fills) == _wire_pairs(n1.wire) and (len(fills) > 0) == (chunks >= 2)
+    assert n1.wire.pairs() == n0.wire.pairs()            # the same forwards (begin, then chunk) in the same order
+
+
+@pytest.mark.parametrize("group", [False, True], ids=["one-at-a-time", "multi-prefill"])
