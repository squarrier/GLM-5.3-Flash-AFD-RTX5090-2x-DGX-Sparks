+def fake_pairs(torch, monkeypatch) -> None:
+    """TF_GLM_PREFILL_PAIRS (``prefill_pairs``) on the fake model: the real ``run_pair`` (the second chunk's
+    states, the first chunk's holds) and ``finish``, over a pair forward that runs each chunk's rows as
+    ``fake_compute`` / ``fake_pieces_compute`` would, the first chunk's, its holds taken at its end, then the second's;
+    each chunk logged on the wire as a forward of its own (its begin, then the chunk)."""
+
+    from tensorfold.families.glm5_next.cuda import forward
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+    from tests.test_glm_multi import fold
+
+    def stage(e, ch):
+        for p in ch.pieces:
+            forward.check_room(e.w, p.st, p.rows)
+
+    def run(e, a, b):
+        for ch in (a, b):
