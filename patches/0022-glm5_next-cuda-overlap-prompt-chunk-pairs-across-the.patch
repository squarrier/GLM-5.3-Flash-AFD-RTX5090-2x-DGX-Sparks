+def test_a_client_leaving_mid_pair(afd_fake, monkeypatch):
+    """A 5-chunk prompt's client leaves (the server's poll, ``emit.cancelled``) while its first two chunks run: as a
+    pair (setting on; it leaves once the pair's first chunk went over the wire) or alone (off; during the second
+    chunk). The pair completes both chunks, then the stream leaves at the next iteration and its extent goes back to
+    the pool, exactly as with the setting off."""
+
+    from tensorfold.families.glm5_next.cuda.afd import MODE_CHUNK
+
+    runs = {}
+    for pairs in (False, True):
+        n1, d, fills = _sliced(afd_fake, monkeypatch, pairs=pairs)
+        free = d.pool.free_rows()
+        left, seen = [False], []
+        real = n1.wire.forward
+
+        def forward(kind, rows, real=real, left=left, seen=seen, pairs=pairs):
+            real(kind, rows)
+            if kind == "chunk":
+                seen.append(rows)
+                left[0] = left[0] or len(seen) == (1 if pairs else 2)
+
+        n1.wire.forward = forward
+        begins = len(n1.begins())
+        s = n1.submit(tm._prompt(300, 61), 12, tm._sampling("greedy", 61))
+        s.emit.cancelled = lambda left=left: left[0]
+        done = []
+        for _ in range(4):
+            done = n1.step()
+            if done:
+                break
+        assert done == [s] and s.done and s.sid not in d.lanes and d.partial is None
+        assert d.pool.free_rows() == free and n1.wire.tr.next is None and seen == [64, 64]
+        assert [x[2] for x in n1.begins()[begins:]] == [MODE_CHUNK, MODE_CHUNK]
+        runs[pairs] = (len(fills), _kept(d))
+    assert runs[False] == (0, runs[True][1]) and runs[True][0] == 1
