+PAIR_WORDS = "<10i"             # a request header's words 0-9 (mcdma.HDR_FMT reads 0-7; a MODE_PAIR's are 7-9)
+
 
 def _bytes(t):
     """A contiguous tensor's bytes as a flat uint8 view (no copy)."""
