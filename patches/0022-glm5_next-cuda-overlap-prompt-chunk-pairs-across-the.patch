+                for i, t in enumerate(p.tokens):
+                    q = p.st.pos + i
+                    st.write(q, int(t))
+                    h = fold(h, q, int(t))
+                cur = st.cur[0]
+                st.rec[1 - cur][0] = h
+                st.cur = [1 - cur]
+                st.conv.copy_(torch.tensor(([0, 0, 0] + list(st.conv.tolist()) + [int(t) for t in p.tokens])[-3:]))
+                taps += [[p.st.pos + i, int(t)] for i, t in enumerate(p.tokens)]
+                ch.heads.append(st.logits(p.st.pos + p.rows - 1, h)[None] if p.head else None)
+            t = torch.tensor(taps, dtype=torch.int64)
+            ch.b.taps = t if ch.single else [t]
+            ch.last_hidden = t[-1:].clone()
+            for hold in ch.holds:
+                hold.rec.copy_(hold.st.rec[hold.st.cur[0]])
+                hold.conv.copy_(hold.st.conv)
+
+    def slot_buffers(b):
+        return SimpleNamespace(**{**vars(b), "ids": [], "taps": None, "fnormed": None, "pair_of": b})
+
+    monkeypatch.setattr(pp, "_stage_chunk", stage)
+    monkeypatch.setattr(pp, "_forward_pair", run)
+    monkeypatch.setattr(pp, "_pos_tensor", lambda st, pos: None)         # the fake states keep no device position
