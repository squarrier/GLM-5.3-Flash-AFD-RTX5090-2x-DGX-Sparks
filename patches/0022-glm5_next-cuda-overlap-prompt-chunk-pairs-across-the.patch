+    def header_pair(self, seqs, rows) -> None:
+        """A prompt chunk pair's two forwards (``AfdWire.begin_pair``): each window's request headers as ``header``
+        writes them with MODE_PAIR, plus word 7 its slot, word 8 the other window's rows and word 9 the pair's first
+        seq; one blocking copy each (the second window's tables are made at the first pair)."""
+
+        torch = self.torch
+        if self._tabs is None:
+            cpu = torch.zeros(self.hdr_tab_cpu.shape, dtype=torch.int32, pin_memory=self.device != "cpu")
+            cpu.copy_(self.hdr_tab_cpu)
+            self._tabs = [(self.hdr_tab, self.hdr_tab_cpu), (torch.zeros_like(self.hdr_tab), cpu)]
+        for k, (dev, tab) in enumerate(self._tabs):
+            tab[:, 1] = seqs[k] & 0x7FFFFFFF
+            tab[:, 2] = rows[k]
+            tab[:, 4] = MODE_PAIR
+            tab[:, PAIR_SLOT] = k
+            tab[:, PAIR_OTHER] = rows[1 - k]
+            tab[:, PAIR_FIRST] = seqs[0] & 0x7FFFFFFF
+            dev.copy_(tab)                       # blocking, as header's
+        self.use(0)
+
+    def use(self, slot: int) -> None:
+        """The pair window whose header tables the next ``send`` packs."""
+
+        self.hdr_tab, self.hdr_tab_cpu = self._tabs[slot]
+
+    def close_pair(self) -> None:
