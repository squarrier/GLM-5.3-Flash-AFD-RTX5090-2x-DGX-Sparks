+# -- the wire: the fake mcdma-rpcd pair --------------------------------------------------------------------------
+def _links(daemon, words, *, attn="cpu", experts=("cpu", "cpu"), timeout=10.0, pairs=True, check=False, store=None):
+    from tensorfold.families.glm5_next.cuda import afd_mcdma, experts_node, mcdma
+
+    drv = FakeDriver(words)
+    links = mcdma.AttentionLinks(["a2", "a1"], words=words, driver=drv if attn == "gpu" else None, mode=attn,
+                                 stream=lambda: 0, timeout=timeout, shm_dir=str(daemon.shm), linkup_wait=2)
+    eps = []
+    for half, (name, mode) in enumerate(zip(["a2", "a1"], experts)):
+        link = mcdma.ExpertLink(name, words=words, driver=drv if mode == "gpu" else None, mode=mode,
+                                socket_path=daemon.sock(name), shm_dir=str(daemon.shm), stream=lambda: 0)
+        link.base = links.base[half]
+        end = afd_mcdma.McdmaExpertLink(link, D, S, len(LAYERS), PREFILL, device="cpu", pairs=pairs)
+        node = FakeNode(LAYERS, half)
+        ep = SimpleNamespace(link=end, node=node, error=None)
+
+        def run(ep=ep, half=half):
+            try:
+                experts_node.forwards(ep.node, ep.link, store if store is not None else DictStore(), half + 1,
+                                      check_on=check)
+            except BaseException as exc:  # noqa: BLE001
+                ep.error = exc
+
+        ep.t = threading.Thread(target=run, daemon=True)
+        ep.t.start()
+        eps.append(ep)
+    return links, eps
+
+
+def _close(daemon, eps) -> None:
+    for n in ("a2", "a1"):
+        daemon.bye(n)
+    for ep in eps:
+        ep.t.join(5)
+        assert not ep.t.is_alive()
+
+
+def _bufs(rows=PREFILL):
+    import torch
+
+    return SimpleNamespace(normed=torch.zeros((rows, D), dtype=torch.bfloat16),
+                           pick=torch.zeros((rows, S), dtype=torch.int32),
+                           wts=torch.zeros((rows, S), dtype=torch.float32), sy=torch.zeros((rows, D)),
+                           afd_recv=torch.zeros((3 * rows * D,)))
+
+
+def _fill(b, rows, gen) -> None:
+    import torch
+
+    b.normed[:rows] = torch.randn((rows, D), generator=gen).to(torch.bfloat16)
+    b.pick[:rows] = torch.randint(0, 16, (rows, S), generator=gen, dtype=torch.int32)
+    b.wts[:rows] = torch.rand((rows, S), generator=gen)
+    b.sy[:rows] = torch.randn((rows, D), generator=gen)
+
+
+def _pair(a, rows, gen, *, stop_after=None) -> None:
+    """A pair's exchanges in the schedule's wire order (window 0's layer, window 1's, ...), each reply checked."""
+
+    import torch
+
+    bufs = [_bufs(), _bufs()]
+    a.begin_pair(rows)
+    for pos, layer in enumerate(LAYERS):
+        for k in (0, 1):
+            if stop_after is not None and (pos, k) == stop_after:
+                return
+            _fill(bufs[k], rows[k], gen)
+            a.use(k)
+            a.exchange(bufs[k], rows[k])
+            got = a.collect(bufs[k], rows[k], D)
+            for half in (0, 1):
+                want = partial(bufs[k].normed[:rows[k]], bufs[k].pick[:rows[k]], bufs[k].wts[:rows[k]], layer, half)
+                assert torch.equal(got[half], want), (layer, k, half)
+            assert torch.equal(got[2], bufs[k].sy[:rows[k]])
+
+
+def _plain(a, rows, gen) -> None:
+    import torch
+
+    b = _bufs()
+    a.begin(rows, chunk=True)
+    for layer in LAYERS:
+        _fill(b, rows, gen)
+        a.exchange(b, rows)
+        got = a.collect(b, rows, D)
+        assert torch.equal(got[0], partial(b.normed[:rows], b.pick[:rows], b.wts[:rows], layer, 0))
+
