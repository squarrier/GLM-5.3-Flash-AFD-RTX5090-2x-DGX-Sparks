+@pytest.mark.parametrize("modes", [("cpu", ("cpu", "cpu")), ("gpu", ("gpu", "gpu"))], ids=["cpu", "gpu"])
+def test_the_scheduler_over_the_mcdma_wire(env, daemon, words, master, monkeypatch, modes):
+    """The real pair scheduler (``prefill_pairs._forward_pair``) over the real wire and the fake MCDMA pair (whose
+    expert links check every header), each chunk's layer loop a stand-in for ``_steps`` (its attention marked, its
+    route filling the request, then exchange and collect at the scheduler's stops): every reply is its own window's;
+    the experts saw A's layer, B's layer, ...; the other chunk's attention of the same layer (B's) or the next (A's)
+    runs inside each exchange window but the last; never more than one request on the wire, two windows open."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    links, eps = _links(daemon, words, attn=modes[0], experts=modes[1])
+    wait_attached(daemon)
+    a = mcdma_attention(links, master)
+    gen = torch.Generator().manual_seed(9)
+    log, bufs, rows = [], [_bufs(), _bufs()], (PREFILL, 13)
+    flight = {"now": 0, "max": 0}
+    exchange, collect = a.exchange, a.collect
+
+    def counted_exchange(b, r):
+        flight["now"] += 1
+        flight["max"] = max(flight["max"], flight["now"])
+        return exchange(b, r)
+
+    def counted_collect(b, r, d):
+        out = collect(b, r, d)
+        flight["now"] -= 1
+        return out
+
+    monkeypatch.setattr(a, "exchange", counted_exchange)
+    monkeypatch.setattr(a, "collect", counted_collect)
+
+    def steps(e, ch):
+        k, r, b = ch.slot, ch.R, bufs[ch.slot]
+        for pos, layer in enumerate(LAYERS):
+            log.append(("attn", k, pos))
+            _fill(b, r, gen)
+            yield pp.SEND
+            e.w.afd.use(k)
+            e.w.afd.exchange(b, r)
+            log.append(("send", k, pos))
+            yield pp.WAIT
+            e.w.afd.use(k)
+            got = e.w.afd.collect(b, r, D)
+            for half in (0, 1):
+                assert torch.equal(got[half], partial(b.normed[:r], b.pick[:r], b.wts[:r], layer, half)), (k, pos)
+            log.append(("recv", k, pos))
+            yield pp.DONE
+
+    monkeypatch.setattr(pp, "_steps", steps)
+    e = SimpleNamespace(w=SimpleNamespace(afd=a))
+    chunks = [pp.Chunk([None], k, None, R=rows[k]) for k in (0, 1)]
+    a.begin_pair(rows)
+    pp._forward_pair(e, *chunks)
+    assert flight["max"] == 1 and a.dead is None
+    n = len(LAYERS)
+    sends = [ev for ev in log if ev[0] == "send"]
+    assert sends == [("send", k, pos) for pos in range(n) for k in (0, 1)]
+    for i, (_, k, pos) in enumerate(sends):
+        lo, hi = log.index(("send", k, pos)), log.index(("recv", k, pos))
+        inside = [ev for ev in log[lo:hi] if ev[0] == "attn"]
+        want = ("attn", 1, pos) if k == 0 else ("attn", 0, pos + 1)
+        assert inside == ([want] if i < 2 * n - 1 else []), (k, pos, log[lo:hi + 1])
+    for ep in eps:
+        assert ep.node.seen == [(layer, r) for layer in LAYERS for r in rows] and ep.error is None
+    _plain(a, 9, gen)                                    # a plain forward after the pair: closes it, no pair words
+    assert all(ep.error is None for ep in eps)
+    _close(daemon, eps)
+
+
+@pytest.mark.parametrize("modes", [("cpu", ("cpu", "cpu")), ("gpu", ("gpu", "gpu")), ("gpu", ("cpu", "gpu"))],
+                         ids=["cpu", "gpu", "mixed"])
+def test_pairs_and_slices_share_the_wire(env, daemon, words, master, modes):
+    """TF_GLM_FILL_BUDGET_MS's layer slices (MODE_SLICE) and pairs on one wire, in an order the scheduler makes: a
+    chunk in two slices with a decode round's window between them, a pair, a chunk in slices again, a pair, a whole
+    chunk. Every reply is the experts' function of its own request and each expert ran exactly each forward's layers
+    in order; the pair after a slice carries no slice count (word 6), the slices after a pair no pair words (7-9)."""
+
+    import torch
+
+    from tests.glm_afd_fakes import forward as window
+    from tests.test_glm_afd_slice_wire import slice_forward
+
+    n = len(LAYERS)
+    links, eps = _links(daemon, words, attn=modes[0], experts=modes[1])
+    wait_attached(daemon)
+    a = mcdma_attention(links, master)
+    gen = torch.Generator().manual_seed(17)
+    b = _bufs()
+    slice_forward(a, b, 40, gen, 0, 2)
+    window(a, b, 3, gen)                                 # a decode round between two slices of the chunk
+    slice_forward(a, b, 40, gen, 2, n - 2)
+    _pair(a, (PREFILL, 9), gen)
+    assert all(row[6] == 0 for dev, _ in a.tr._tabs for row in dev.tolist())    # no slice count in either window
+    slice_forward(a, b, 21, gen, 0, 1)
+    assert not any(v for row in a.tr.hdr_tab.tolist() for v in row[7:10])       # no pair words on the slice
+    window(a, b, 2, gen)
+    slice_forward(a, b, 21, gen, 1, n - 1)
+    _pair(a, (6, PREFILL), gen)
+    _plain(a, 11, gen)
+    want = ([(i, 40) for i in LAYERS[:2]] + [(i, 3) for i in LAYERS] + [(i, 40) for i in LAYERS[2:]]
+            + [(i, r) for i in LAYERS for r in (PREFILL, 9)]
+            + [(LAYERS[0], 21)] + [(i, 2) for i in LAYERS] + [(i, 21) for i in LAYERS[1:]]
+            + [(i, r) for i in LAYERS for r in (6, PREFILL)] + [(i, 11) for i in LAYERS])
+    for ep in eps:
+        assert ep.node.seen == want and ep.error is None, ep.node.seen
+    assert a.dead is None and a.seq == 11                # 5 slices and windows, 2 pairs (2 forwards each), a chunk
+    _close(daemon, eps)
