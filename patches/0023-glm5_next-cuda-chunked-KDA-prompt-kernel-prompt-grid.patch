+def test_shared_prefix_points_round_down_to_the_grid(fake, grid):
+    """TF_GLM_SHARED_PREFIX: the system block's end rounds down to the grid; the inference request resumes there."""
+    p = tm.Pair(fake, streams=2, blocks=8)
+    sp.sharing(p.g)
+    context = tm._prompt(600, 500)
+    load, inference = sp.benchy(context, tm._prompt(100, 501)), sp.benchy(context, tm._prompt(64, 502))
+    at = (len(sp.HEAD) + 600) // GRID * GRID                          # 603 -> 576; load's own grid point 704
+    first = p.submit(load, 8, None)
+    p.run()
+    assert sorted((len(k.ids), k.shared) for k in p.d[0].kept) == [(at, True), (len(load) // GRID * GRID, False)]
+    phase2 = p.submit(inference, 12, None)
+    assert phase2.cached == at
+    p.run()
+    p.check()
+    assert phase2.got == tm.solo(fake, inference, 12, None) and first.got == tm.solo(fake, load, 8, None)
+    assert all(len(k.ids) % GRID == 0 for k in p.d[0].kept)
+
