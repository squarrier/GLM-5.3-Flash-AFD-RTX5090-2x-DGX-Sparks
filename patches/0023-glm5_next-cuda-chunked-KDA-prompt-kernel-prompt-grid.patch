diff --git a/tests/cuda/test_glm_kda_chunked.py b/tests/cuda/test_glm_kda_chunked.py
new file mode 100644
index 0000000..0d62ec6
--- /dev/null
+++ b/tests/cuda/test_glm_kda_chunked.py
@@ -0,0 +1,76 @@
+"""TF_GLM_KDA_CHUNKED's CUDA kernel (``kda_chunk.cu``, MiaAI-Lab recipe patch 0039) on the GPU: against the recipe's
+torch references (``kda_chunked.chain_reference``, verbatim), deterministic, and a prompt cut on the 32-row sub-chunk
+grid keeping the bits of one chunk (the prompt grid's reason). GLM-5.3-Flash's KDA shapes: 128-wide heads, H heads
+of a rank (the AFD attention node holds them all). Byte identity with the recipe's own build of the kernel, per KDA
+layer shape, is checked by a separate GPU run outside this suite."""
+
+from __future__ import annotations
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA only")
+
+
+def _inputs(rows: int, H: int, seed: int, device="cuda"):
+    from tensorfold.families.glm5_next.cuda import kda_chunked as kc
+
+    g = torch.Generator().manual_seed(seed)
+    C = 3 * H * kc.DK
+    b_off = C + 2 * 128
+    p = (0.5 * torch.randn(rows, b_off + H, generator=g)).to(torch.bfloat16)
+    a = (0.5 * torch.randn(rows, H * kc.DK, generator=g)).to(torch.bfloat16)
+    gate = torch.randn(rows, H * kc.DV, generator=g).to(torch.bfloat16)
+    cs = (0.5 * torch.randn(kc.TAPS - 1, C, generator=g)).to(torch.bfloat16)
+    cw = (0.5 * torch.randn(C, kc.TAPS, generator=g)).to(torch.bfloat16)
+    state = 0.05 * torch.randn(H, kc.DV, kc.DK, generator=g)
+    a_log = 0.1 * torch.randn(H, generator=g)
+    dt_bias = 0.1 * torch.randn(H * kc.DK, generator=g)
+    norm_w = (1 + 0.1 * torch.randn(kc.DV, generator=g)).to(torch.bfloat16)
+    return [t.to(device) for t in (p, a, gate, cs, cw, state, a_log, dt_bias, norm_w)], b_off
+
+
+def _run(args, b_off, rows, pos, state=None, cs=None):
+    from tensorfold.families.glm5_next.cuda import kda_chunked as kc
+
+    p, a, gate, cs0, cw, state0, a_log, dt_bias, norm_w = args
+    H = a_log.numel()
+    out = torch.empty((rows, H * kc.DV), dtype=torch.bfloat16, device=p.device)
+    s_out = torch.empty_like(state0)
+    kc.chain(p, b_off, a, gate, cs0 if cs is None else cs, cw, state0 if state is None else state, a_log, dt_bias,
+             norm_w, 1e-6, -5.0, rows, out, s_out, pos)
+    torch.cuda.synchronize()
+    return out, s_out
+
+
+@pytest.mark.parametrize("H", [4, 16])
+@pytest.mark.parametrize("rows,pos", [(1, 0), (31, 1), (64, 0), (594, 37), (2048, 4096)])
+def test_the_kernel_against_the_recipes_references(H, rows, pos):
+    from tensorfold.families.glm5_next.cuda import kda_chunked as kc
+
+    args, b_off = _inputs(rows, H, seed=rows * 7 + H)
+    out, S = _run(args, b_off, rows, pos)
+    again, S2 = _run(args, b_off, rows, pos)
+    assert torch.equal(out, again) and torch.equal(S, S2)                       # deterministic
+    p, a, gate, cs, cw, state, a_log, dt_bias, norm_w = (t.cpu() for t in args)
+    ref, S_ref, _ = kc.chain_reference(p, b_off, a, gate, cs, cw, state, a_log, dt_bias, norm_w, 1e-6, -5.0, rows,
+                                       pos=pos, chunked=True, dtype=torch.float64)
+    assert torch.allclose(out.cpu().float(), ref.float(), rtol=2 ** -6, atol=2 ** -6)     # bf16 rounding apart
+    assert torch.allclose(S.cpu(), S_ref, rtol=1e-3, atol=1e-4)
+
+
+@pytest.mark.parametrize("cut", [64, 32 * 5])
+def test_a_cut_on_the_grid_keeps_the_bits(cut):
+    """Rows 0..R from pos 0 in one call == rows 0..cut then cut..R from the state between, the conv window the cut's
+    previous three rows: the same bits (prompt chunks and kept states on TF_GLM_PROMPT_GRID)."""
+    from tensorfold.families.glm5_next.cuda import kda_chunked as kc
+
+    rows, H = 256, 8
+    args, b_off = _inputs(rows, H, seed=cut)
+    out, S = _run(args, b_off, rows, 0)
+    p, a, gate, cs, cw, state, a_log, dt_bias, norm_w = args
+    first, Sa = _run(args, b_off, cut, 0)
+    C = 3 * H * kc.DK
+    rest_args = [p[cut:], a[cut:], gate[cut:], cs, cw, state, a_log, dt_bias, norm_w]
+    rest, Sb = _run(rest_args, b_off, rows - cut, cut, state=Sa, cs=p[cut - 3:cut, :C].contiguous())
+    assert torch.equal(torch.cat([first, rest]), out) and torch.equal(Sb, S)
