+# -- the engine's settings --------------------------------------------------------------------------------------------
+def test_the_prompt_grid_setting(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import engine, kda
+    from tensorfold.families.glm5_next.cuda.multi import fill_rows, keep_point
+
+    monkeypatch.delenv("TF_GLM_PROMPT_GRID", raising=False)
+    monkeypatch.setattr(kda, "CHUNKED", False)
+    assert engine.prompt_grid(2048) == 0 and not engine.kda_chunked_on() and engine.GlmEngine.grid == 0
+    for value, chunked, want in [("", False, 0), ("0", False, 0), ("16", False, 16), (" 128 ", False, 128),
+                                 ("", True, 64), ("0", True, 64), ("32", True, 32), ("128", True, 128)]:
+        assert engine.prompt_grid(2048, value, chunked) == want, (value, chunked)
+    for value, chunked, match in [("48", False, "one of 16, 32, 64, 128"), ("x", False, "one of"),
+                                  ("16", True, "grid of 32, 64 or 128"), ("128", False, "multiple of it")]:
+        with pytest.raises(ValueError, match=match):
+            engine.prompt_grid(2048 if match != "multiple of it" else 64 * 3, value, chunked)
+    monkeypatch.setattr(kda, "CHUNKED", True)
+    assert engine.kda_chunked_on() and engine.prompt_grid(2048) == 64
+    monkeypatch.setenv("TF_GLM_PROMPT_GRID", "32")
+    assert engine.prompt_grid(2048) == 32
+    # kept points: the recipe's grid point with a grid, before the last token without one (as before)
+    assert [engine.grid_point(n, c, 64) for n, c in [(640, 0), (650, 0), (650, 640), (63, 0), (700, 600)]] == \
+        [640, 640, None, None, 640]
+    assert engine.grid_point(650, 0, 0) == 650
+    assert [engine.keep_at(n, c, 0) for n, c in [(650, 0), (1, 0), (650, 649)]] == \
+        [keep_point(650, 0), keep_point(1, 0), keep_point(650, 649)] == [649, 1, None]
+    assert engine.keep_at(650, 0, 64) == 640 and engine.keep_at(640, 0, 64) == 640
+    # TF_GLM_FILL_ROWS stays on the grid
+    assert fill_rows(2048, "") == 1024 and fill_rows(2048, "", grid=128) == 1024
+    with pytest.raises(ValueError, match="prompt grid"):
+        fill_rows(2048, "192", grid=128)
+    assert fill_rows(2048, "192", grid=64) == 192
+
