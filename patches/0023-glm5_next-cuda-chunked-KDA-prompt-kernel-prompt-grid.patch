+# -- the single-stream engine ---------------------------------------------------------------------------------------
+def test_single_stream(fake, grid, monkeypatch):
+    """MTP drafts: the grid point is kept by prefilling to it (no cut inside a chunk), the same prompt resumes there,
+    an on-grid prompt's end state keeps the head's row and replays (no chunk at all), and the next turn resumes it."""
+    torch = fake
+    sp._cut_compute(monkeypatch)
+    decode = importlib.import_module("tensorfold.families.glm5_next.cuda.decode")
+    chunk = decode.compute
+    calls = []
+
+    def compute(w, st, b, R, *, cut=None, **kw):
+        calls.append((st.pos, R, cut is not None))
+        return chunk(w, st, b, R, cut=cut, **kw)
+
+    monkeypatch.setattr(decode, "compute", compute)
+    g = sp._engine(torch)
+    g.e.grid = GRID
+    assert g.grid == GRID
+    off_grid, on_grid = tm._prompt(650, 71), tm._prompt(640, 72)
+    cached, got = sp._ask(g, off_grid, 12)
+    assert cached == 0 and got == tm.solo(torch, off_grid, 12, None)
+    assert [(len(c.ids), c.head is None) for c in g.cache] == [(640, True)] and not any(x[2] for x in calls)
+    calls.clear()
+    assert sp._ask(g, off_grid, 12) == (640, got) and calls == [(640, 10, False)]
+    cached, first = sp._ask(g, on_grid, 12, tm._sampling("topk", 5))
+    assert cached == 0 and first == tm.solo(torch, on_grid, 12, tm._sampling("topk", 5))
+    assert [(len(c.ids), c.head is None) for c in g.cache] == [(640, True), (640, False)]
+    calls.clear()
+    assert sp._ask(g, on_grid, 12, tm._sampling("topk", 5)) == (640, first) and calls == []
+    turn = on_grid + first + tm._prompt(20, 73)
+    cached, got = sp._ask(g, turn, 8)
+    assert cached == 640 and got == tm.solo(torch, turn, 8, None)
+    assert all(len(c.ids) % GRID == 0 for c in g.cache)
+    with pytest.raises(ValueError, match="grid"):                 # a resume off the grid is refused
+        decode.prefill(g.e, off_grid, None, resume=decode.Snapshot(off_grid[:100], None, None, None, -1, -1))
