+    scenario(fake, p, policy, Rows(monkeypatch, p.d[0].e))
+    p.check()
+    assert [(c.kid, c.ids, c.head is None) for c in p.d[0].kept] == [(c.kid, c.ids, c.head is None)
+                                                                       for c in p.d[1].kept]
