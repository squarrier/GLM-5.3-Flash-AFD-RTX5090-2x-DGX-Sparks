@@ -0,0 +1,271 @@
+"""TF_GLM_KDA_CHUNKED: GLM-5.3-Flash's KDA prompt chunks in chunked (WY) form (MiaAI-Lab recipe patches 0012, 0014 and
+0039's end state: ``kda_chunk.cu`` and the thin ``kda_chunked.py``), on the CPU.
+
+The CUDA kernel runs on the GPU only (tests/cuda/test_glm_kda_chunked.py, and an identity run outside this suite). Here:
+the torch references are the recipe's own (1576746, all patches applied), pinned by source hash; the chunked algorithm
+as the kernel runs it equals the delta rule row by row in float64; its rows depend only on their 32-row sub-chunk and
+the state entering it, so a prompt cut on a multiple of 32 gives the same bits as one chunk (the prompt grid's
+reason), and a cut elsewhere does not; ``kda.chain`` sends prompt chunks (``pos`` given) to the chunked kernel only
+under the setting, decode windows to the serial kernels always; ``kda_chunked.chain`` passes the row's offset in its
+sub-chunk; the forward gives ``kda.chain`` the rows' position only under the setting (so without it the recorded
+calls are the ones before); and the engine's settings (``prompt_grid``, ``grid_point``, ``keep_at``, ``fill_rows``).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib
+import inspect
+from types import SimpleNamespace
+
+import pytest
+
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so the forward imports)
+
+pytestmark = pytest.mark.torch
+
+# sha256 of each reference function's source in the recipe's kda_chunked.py at 1576746, all patches applied (for a name
+# defined twice, the definition Python keeps): ours are hers, verbatim
+PINS = {
+    "_bf": "dee3a8c9f8ceb0f11fd32296dec9597fb76f0e8e5f927407c9761ad8cda2749c",
+    "_sigmoid": "39dfd79c1e4359c1c51aa9d164849dae6502023e3094cc75f3a055f28122b3dc",
+    "prep_reference": "854dfd48cd56289b236cb081d0249c521a8fe693f2f4acc01127f28362074c9a",
+    "recurrent_reference": "d7d9c6218af90f94f888f9cdf90fe2f057f1cf7a8792229011fba2c1bda62d11",
+    "chunked_reference": "804b17ac9d47441b6d5b4ab0e516396c7ed6d5cdf21d4a1cca8ccce33eca5cf3",
+    "gate_norm_reference": "f113a9605b80e08a2fcde5f85f6e93c61483cbb7eb57fb93d1bc18c7837da092",
+    "chain_reference": "56b66d7f1fc3323e194762205fc58dda711abc85fefbdbc808f18648ece42bdf",
+}
+
+
+def _kc():
+    return importlib.import_module("tensorfold.families.glm5_next.cuda.kda_chunked")
+
+
+def _rows(torch, rows: int, H: int, seed: int):
+    """Delta-rule inputs as ``prep_reference`` leaves them: unit-norm keys, scaled queries, decays near 1."""
+    g = torch.Generator().manual_seed(seed)
+    kc = _kc()
+    q = torch.nn.functional.normalize(torch.randn(rows, H, kc.DK, generator=g), dim=-1) * kc.SCALE
+    k = torch.nn.functional.normalize(torch.randn(rows, H, kc.DK, generator=g), dim=-1)
+    v = torch.randn(rows, H, kc.DV, generator=g).to(torch.bfloat16).float()
+    lg = -0.05 * torch.rand(rows, H, kc.DK, generator=g)
+    beta = torch.rand(rows, H, generator=g).to(torch.bfloat16).float()
+    state = 0.1 * torch.randn(H, kc.DV, kc.DK, generator=g)
+    return q, k, v, lg, beta, state
+
+
+def test_the_references_are_the_recipes():
+    kc = _kc()
+    got = {name: hashlib.sha256(inspect.getsource(getattr(kc, name)).rstrip("\n").encode()).hexdigest()
+           for name in PINS}
+    assert got == PINS
+    assert kc.CHUNK == 32 and kc.DK == kc.DV == 128 and kc.TAPS == 4
+
+
+@pytest.mark.parametrize("pos,rows", [(0, 64), (5, 70), (37, 3)])
+def test_chunked_equals_the_delta_rule(pos, rows):
+    import torch
+
+    kc = _kc()
+    q, k, v, lg, beta, state = _rows(torch, rows, 2, seed=pos * 1000 + rows)
+    y, S = kc.chunked_reference(q, k, v, lg, beta, state, pos, dtype=torch.float64)
+    y0, S0 = kc.recurrent_reference(q, k, v, lg, beta, state, dtype=torch.float64)
+    assert y.shape == y0.shape == (rows, 2, kc.DV) and S.shape == S0.shape == (2, kc.DV, kc.DK)
+    assert torch.allclose(y, y0, rtol=0, atol=1e-10) and torch.allclose(S, S0, rtol=0, atol=1e-10)
+
+
+def test_a_cut_on_the_sub_chunk_grid_keeps_the_bits():
+    """fp32 as the kernel: rows 0..96 in one chunk == rows 0..64 then 64..96 from the state between (the same
+    sub-chunks); a cut at row 50 (a sub-chunk split differently) is close but not the same bits."""
+    import torch
+
+    kc = _kc()
+    q, k, v, lg, beta, state = _rows(torch, 96, 2, seed=7)
+    y, S = kc.chunked_reference(q, k, v, lg, beta, state, 0, dtype=torch.float32)
+
+    def two(cut):
+        ya, Sa = kc.chunked_reference(q[:cut], k[:cut], v[:cut], lg[:cut], beta[:cut], state, 0, dtype=torch.float32)
+        yb, Sb = kc.chunked_reference(q[cut:], k[cut:], v[cut:], lg[cut:], beta[cut:], Sa, cut, dtype=torch.float32)
+        return torch.cat([ya, yb]), Sb
+
+    y64, S64 = two(64)
+    assert torch.equal(y64, y) and torch.equal(S64, S)
+    y50, S50 = two(50)
+    assert torch.allclose(y50, y, rtol=0, atol=1e-4) and torch.allclose(S50, S, rtol=0, atol=1e-4)
+    assert not torch.equal(S50, S)
+
+
+def _chain_inputs(torch, rows: int, H: int, seed: int):
+    g = torch.Generator().manual_seed(seed)
+    kc = _kc()
+    C = 3 * H * kc.DK
+    b_off = C + 2 * 128                                   # [q | k | v | fa | ga | b] as the projection rows hold them
+    p = (0.5 * torch.randn(rows, b_off + H, generator=g)).to(torch.bfloat16)
+    a = (0.5 * torch.randn(rows, H * kc.DK, generator=g)).to(torch.bfloat16)
+    gate = torch.randn(rows, H * kc.DV, generator=g).to(torch.bfloat16)
+    conv_state = (0.5 * torch.randn(kc.TAPS - 1, C, generator=g)).to(torch.bfloat16)
+    conv_w = (0.5 * torch.randn(C, kc.TAPS, generator=g)).to(torch.bfloat16)
+    state = 0.05 * torch.randn(H, kc.DV, kc.DK, generator=g)
+    a_log = 0.1 * torch.randn(H, generator=g)
+    dt_bias = 0.1 * torch.randn(H * kc.DK, generator=g)
+    norm_w = (1 + 0.1 * torch.randn(kc.DV, generator=g)).to(torch.bfloat16)
+    return p, b_off, a, gate, conv_state, conv_w, state, a_log, dt_bias, norm_w
+
+
+def test_the_chain_reference_chunked_and_serial_agree():
+    import torch
+
+    kc = _kc()
+    args = _chain_inputs(torch, 40, 2, seed=3)
+    p, b_off, a, gate, conv_state, conv_w, state, a_log, dt_bias, norm_w = args
+    out, S, y = kc.chain_reference(p, b_off, a, gate, conv_state, conv_w, state, a_log, dt_bias, norm_w, 1e-6, -5.0,
+                                   40, pos=9, chunked=True, dtype=torch.float64)
+    out0, S0, y0 = kc.chain_reference(p, b_off, a, gate, conv_state, conv_w, state, a_log, dt_bias, norm_w, 1e-6,
+                                      -5.0, 40, chunked=False, dtype=torch.float64)
+    assert out.dtype == torch.bfloat16 and out.shape == (40, 2 * kc.DV) and S.dtype == torch.float32
+    assert torch.allclose(y, y0, rtol=0, atol=1e-10) and torch.allclose(S, S0, rtol=0, atol=1e-7)
+    assert (out.float() - out0.float()).abs().max().item() <= 2 ** -6        # bf16 rounding of equal read-outs
+
+
+# -- the dispatch ---------------------------------------------------------------------------------------------------
+class _Ext:
+    def __init__(self):
+        self.calls = []
+
+    def __getattr__(self, name):
+        return lambda *a: self.calls.append((name, a))
+
+
+def test_kda_chain_sends_prompt_chunks_to_the_chunked_kernel_under_the_setting(monkeypatch):
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import kda
+
+    kc = _kc()
+    sent = []
+    monkeypatch.setattr(kc, "chain", lambda *a: sent.append(a) or "chunked")
+    ext = _Ext()
+    monkeypatch.setattr(kda, "_ext", lambda: ext)
+    scratch = SimpleNamespace(out=torch.zeros(80, 8), k=None, v=None, g=None, b=None)
+    p, a_log = torch.zeros(80, 16), torch.zeros(2)
+    args = (p, 4, p, p, "conv", "conv_w", "s_in", a_log, "dt", "norm", 1e-6, -5.0, 70, scratch, "s_out")
+    for chunked in (False, True):
+        monkeypatch.setattr(kda, "CHUNKED", chunked)
+        sent.clear()
+        ext.calls.clear()
+        assert kda.prompt_kw(70) == ({"pos": 70} if chunked else {})
+        got = kda.chain(*args, **kda.prompt_kw(70))
+        if chunked:
+            assert got == "chunked" and not ext.calls and len(sent) == 1
+            want = args[:13] + (scratch.out, "s_out", 70)
+            assert len(sent[0]) == len(want) and all(x is y for x, y in zip(sent[0], want))
+        else:
+            assert [c[0] for c in ext.calls] == ["chain_wide"] and not sent
+        ext.calls.clear()
+        kda.chain(*args[:12], 4, scratch, "s_out")        # a decode window: the serial kernel either way
+        assert [c[0] for c in ext.calls] == ["chain"]
+
+
+def test_kda_chunked_chain_passes_the_offset_in_its_sub_chunk(monkeypatch):
+    import torch
+
+    kc = _kc()
+    ext = _Ext()
+    monkeypatch.setattr(kc, "_ext", lambda: ext)
+    p, a, g = torch.zeros(9, 40), torch.zeros(9, 16), torch.zeros(9, 16)
+    out = torch.zeros(9, 16)
+    for pos, off in [(0, 0), (70, 6), (96, 0), (127, 31)]:
+        ext.calls.clear()
+        got = kc.chain(p, 33, a, g, "cs", "cw", "si", "al", "dt", "nw", 1e-6, -5.0, 5, out, "so", pos)
+        assert got.shape == (5, 16)
+        (name, call), = ext.calls
+        assert name == "chain" and call[1] == 40 and call[2] == 33 and call[4] == 16 and call[6] == 16
+        assert call[15:18] == (5, off, out) and call[18] == "so"
+
+
+@pytest.mark.parametrize("chunked", [False, True], ids=["off", "on"])
+def test_the_forward_gives_prompt_rows_their_position_only_under_the_setting(allocations, monkeypatch,  # noqa: F811
+                                                                            chunked):
+    """The recorded kernel calls of prompt chunks (alone, with a kept cut inside) and of a decode window
+    (tests/test_glm_multi_prefill.py's recorder): ``kda.chain`` gets ``pos`` (the chunk's first row; after a cut, the
+    cut row) only under the setting; everything else is the same call either way."""
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import decode, kda
+    from tests import test_glm_multi_prefill as h
+
+    forward = importlib.import_module("tensorfold.families.glm5_next.cuda.forward")
+    monkeypatch.setattr(kda, "CHUNKED", chunked)
+    rec = h.Rec(torch)
+    w, b = h.build_forward(torch, rec, dense_limit=10**6)
+    h.patch_kernels(monkeypatch, rec, forward)
+    monkeypatch.setattr(decode, "commit", forward.commit)
+    alive, seen = [], {}
+    for slot, pos, n in [(0, 500, 7), (1, 64, 40)]:
+        st = h.TraceState(torch, rec, slot, pos)
+        alive.append(st)
+        e = SimpleNamespace(w=w, st=st, pbuf=b, prefill_rows=64, last_hidden=None,
+                            tap_rows=lambda k, bb: torch.cat([t[:k] for t in bb.taps], dim=1))
+        rec.calls = []
+        decode.prefill_chunk(e, list(range(1, pos + n + 1)), pos, n, head=True)
+        seen[f"chunk {pos}"] = [c[2] for c in rec.calls if c[0] == "kda.chain"]
+    st = h.TraceState(torch, rec, 5, 20)
+    cut = forward.Cut(10, torch.empty_like(st.rec[0]), st.conv.clone())
+    alive += [st, cut]
+    rec.calls = []
+    R = forward.stage(w, st, b, list(range(7, 7 + 32)))
+    forward.compute(w, st, b, R, nch=forward.chunks_for(st, R), host_pos=st.pos, cut=cut)
+    seen["cut"] = [c[2] for c in rec.calls if c[0] == "kda.chain"]
+    layers = len(seen["chunk 500"])
+    assert layers >= 1 and len(seen["cut"]) == 2 * layers
+    if chunked:
+        assert seen["chunk 500"] == [(("pos", 500),)] * layers and seen["chunk 64"] == [(("pos", 64),)] * layers
+        assert seen["cut"] == [(("pos", 20),), (("pos", 30),)] * layers
+    else:
+        assert all(kw == () for calls in seen.values() for kw in calls)
+
