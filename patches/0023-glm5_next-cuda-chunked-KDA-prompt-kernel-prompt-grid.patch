+def test_multi_prompt_chunks_on_the_grid(fake, grid, monkeypatch):
+    """TF_GLM_MULTI_PREFILL=1: a burst of four short prompts groups into multi-prompt chunks whose pieces start and
+    stop on the grid (or at a prompt's end); replies equal their solo ones; an on-grid prompt again replays alone."""
+    pieces = []
+    mp = importlib.import_module("tensorfold.families.glm5_next.cuda.multi_prefill")
+    real = mp.prefill_pieces
+
+    def record(e, ps):
+        pieces.append([(p.st.pos, len(p.tokens), p.head) for p in ps])
+        return real(e, ps)
+
+    monkeypatch.setattr(mp, "prefill_pieces", record)
+    p, log, streams = tp.burst_pair(fake, monkeypatch, True)
+    assert pieces and tp._fills(log)[1] >= 1
+    for group in pieces:
+        assert len(group) > 1
+        for start, n, ends in group:
+            assert start % GRID == 0 and (ends or (start + n) % GRID == 0)
+    assert all(len(k.ids) % GRID == 0 for k in p.d[0].kept)
+    p.check()
+    on = next((s for s in streams if len(s.prompt) % GRID == 0), None)
+    if on is not None:
+        again = p.submit(on.prompt, 6, None)
+        assert again.cached == len(on.prompt)
+        p.run()
+        assert again.got == tm.solo(fake, on.prompt, 6, None)
+
