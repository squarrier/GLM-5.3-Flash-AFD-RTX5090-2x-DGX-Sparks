+"""TF_GLM_PROMPT_GRID (MiaAI-Lab recipe patch 0008) and the prompt replay (0042), on the CPU: the grid
+TF_GLM_KDA_CHUNKED=1 runs on (64 tokens), on #243's fake model.
+
+With a grid, a drafted prompt keeps its state at its grid point: its end when that is on the grid (with the head's
+logits row its first token was sampled from), else the last grid multiple in it, which the prompt prefills to as a
+prompt of that length and resumes from. Every kept state, resume and chunk start then sits on the grid, so the
+chunked KDA kernel (whose rows depend on their 32-row sub-chunks at absolute positions) gives a resumed prompt the bits
+of a fresh one; the same prompt again resumes at its grid point, and an on-grid prompt again replays its kept end
+state, prefilling nothing (0042). Covered: the multi-stream engine at two ranks (DFlash2 and MTP drafts, both ranks
+alike), at world 1 over the fake AFD wire, with TF_GLM_KV=fp8's rings, with shared-prefix points (they round down to
+the grid) and with TF_GLM_MULTI_PREFILL's multi-prompt chunks; the single-stream engine (MTP drafts). Replies equal
+their requests served alone. Without a grid nothing changes (the other test files, unchanged, run on this tree).
+"""
+
+from __future__ import annotations
+
+import importlib
+
+import pytest
+
+from tests import test_glm_kv8_multi as tk
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests import test_glm_multi_prefill as tp
+from tests import test_glm_shared_prefix as sp
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+pytestmark = pytest.mark.torch
+
+fake = tm.fake
+afd_fake = ta.afd_fake
+rings = tk.rings
+GRID = 64
+
+
+@pytest.fixture
+def grid(monkeypatch):
+    """TF_GLM_PROMPT_GRID=64 on every engine the test builds (``GlmEngine.grid``, which ``MultiDecoder`` reads)."""
+    from tensorfold.families.glm5_next.cuda import engine
+
+    monkeypatch.setattr(engine.GlmEngine, "grid", GRID)
+    return GRID
+
+
+class Rows:
+    """The prompt rows rank 0's engine prefills, as (start, rows) per prompt chunk (``decode.prefill_chunk``)."""
+
+    def __init__(self, monkeypatch, e0) -> None:
+        decode = importlib.import_module("tensorfold.families.glm5_next.cuda.decode")
+        real = decode.prefill_chunk
+        self.rows: list[tuple[int, int]] = []
+
+        def chunk(e, prompt, start, R, **kw):
+            if e is e0:
+                self.rows.append((start, R))
+            return real(e, prompt, start, R, **kw)
+
+        monkeypatch.setattr(decode, "prefill_chunk", chunk)
+
+
+def scenario(torch, node, policy: str, rows: Rows) -> None:
+    d = node.d[0] if isinstance(node.d, list) else node.d
+    off_grid, on_grid = tm._prompt(650, 61), tm._prompt(640, 62)     # 650 = 10 x 64 + 10
+    topk = tm._sampling("topk", 3)
+    a = node.submit(off_grid, 12, None, policy=policy)
+    node.run()
+    assert a.cached == 0 and a.got == tm.solo(torch, off_grid, 12, None)
+    assert [(len(k.ids), k.head is None) for k in d.kept] == [(640, True)]      # its grid point, not 649
+    assert rows.rows[-2:] == [(576, 64), (640, 10)]
+    rows.rows.clear()
+    b = node.submit(off_grid, 12, None, policy=policy)                 # the same prompt: from its grid point
+    node.run()
+    assert b.cached == 640 and rows.rows == [(640, 10)] and b.got == a.got
+    c = node.submit(on_grid, 12, topk, policy=policy)
+    node.run()
+    assert c.cached == 0 and c.got == tm.solo(torch, on_grid, 12, topk)
+    end = [k for k in d.kept if k.ids == on_grid]
+    assert len(end) == 1 and end[0].head is not None and end[0].head.shape[0] == 1      # with its head's row
+    rows.rows.clear()
+    r = node.submit(on_grid, 12, topk, policy=policy)                  # an on-grid prompt again: a replay
+    node.run()
+    assert r.cached == 640 and rows.rows == [] and r.got == c.got
+    turn = on_grid + c.got + tm._prompt(30, 63)                        # its next turn resumes the end state
+    t = node.submit(turn, 10, None, policy=policy)
+    node.run()
+    assert t.cached == 640 and t.got == tm.solo(torch, turn, 10, None)
+    assert all(len(k.ids) % GRID == 0 for k in d.kept)
+
+
+@pytest.mark.parametrize("policy,mtp", [("f3", False), ("2", True)], ids=["dflash2", "mtp"])
+def test_two_ranks(fake, grid, monkeypatch, policy, mtp):
