+def test_the_scheduler_hands_the_decoder_its_waiting_prompts():
+    """``GlmScheduler._waiting_prompts``: the held request first, then the queue in admission order (background
+    requests after the others); a stop marker is not a request."""
+
+    from types import SimpleNamespace
+
+    from tensorfold.cuda.scheduler import Waiting
+    from tensorfold.families.glm5_next.cuda.multi import GlmScheduler
+
+    def item(prompt, background=False):
+        return SimpleNamespace(prompt=prompt, background=background), None
+
+    waiting = Waiting()
+    waiting.put(item([1, 2]))
+    waiting.put(item([3], background=True))
+    waiting.put(item([4, 5, 6]))
+    waiting.stop()
+    sched = SimpleNamespace(held=item([9]), waiting=waiting)
+    assert GlmScheduler._waiting_prompts(sched) == [[9], [1, 2], [4, 5, 6], [3]]
+    sched.held = None
+    assert GlmScheduler._waiting_prompts(sched) == [[1, 2], [4, 5, 6], [3]]
