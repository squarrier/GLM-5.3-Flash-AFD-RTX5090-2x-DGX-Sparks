+def benchy(context, user):
+    return HEAD + list(context) + [USER] + list(user) + TAIL
+
+
+class Queue:
+    """``GlmScheduler._admit``'s rule over a ``Pair``: a FIFO queue, admitted while a slot is free and the request
+    ``fits`` (``NoRoom`` holds the head); the decoder's ``wanted`` is the queue's prompts."""
+
+    def __init__(self, p, streams: int) -> None:
+        self.p, self.d, self.streams, self.waiting = p, p.d[0], streams, []
+        self.d.wanted = lambda: [s.prompt for s in self.waiting]
+
+    def stream(self, prompt, count: int):
+        from tensorfold.cuda.streams import Stream
+        from tensorfold.families.glm5_next.cuda.engine import encode_policy
+
+        s = Stream(list(prompt), count, None, draft=True, stop_eos=False)
+        s.glm = {"code": self.p.g[0]._effective(encode_policy("f3")), "spec": "f3"}
+        s.got = []
+        s.emit = lambda new: (s.got.extend(new), False)[1]
+        return s
+
+    def run(self, prompts, count: int) -> list:
+        from tensorfold.families.glm5_next.cuda.multi import NoRoom
+
+        streams = [self.stream(pr, count) for pr in prompts]
+        self.waiting += streams
+        for _ in range(20000):
+            while self.d.live() < self.streams and self.waiting and self.d.fits(self.waiting[0]):
+                try:
+                    self.d.admit(self.waiting[0])
+                except NoRoom:
+                    break
+                self.waiting.pop(0)
+            if not self.d.lanes:
+                if not self.waiting:
+                    return streams
+                raise AssertionError("a request never fits")
+            self.p.step()
+            for s in self.d.requeue:
+                again = s.continued()
+                again.glm, again.got, again.emit = s.glm, s.got, s.emit
+                self.waiting.append(again)
+            self.d.requeue = []
+        raise AssertionError("the requests did not finish")
+
+
+@pytest.mark.parametrize("room", ["", "1"], ids=["off", "on"])
+def test_benchy_runs_resume_their_contexts(fake, monkeypatch, room):  # noqa: F811
+    """llama-benchy's prefix-caching runs (c context loads queued together, then their c inference requests, a new
+    context each run) with more loads than streams, in a pool that holds every context but not in one piece: the
+    arena's d100000_c5 on the 5090 (306 blocks, 49-block loads, 50-block inference requests, 4 streams, c = 5) scaled
+    to 13 blocks, 3-block loads, 4-block inference requests, 2 streams, c = 3 (off: 3 of 12 inference requests miss;
+    on: none). Every reply equals its solo one."""
+
+    from tensorfold.families.glm5_next.cuda import engine
+
+    monkeypatch.setenv("TF_GLM_CACHE_ROOM", room)
+    monkeypatch.setattr(engine.GlmEngine, "grid", 64)
+    torch = fake
+    p = Pair(torch, streams=2, blocks=13, entries=32, prefill_rows=2048)
+    for g in p.g:
+        g.shared, g.opener = 256, USER if g.rank == 0 else None
+    q = Queue(p, 2)
+    c, context = 3, 5000                      # a load of 5,008 tokens (3 blocks), its inference request 7,055 (4)
+    at = (len(HEAD) + context) // 64 * 64
+    cached, seed = [], 10_000
+    for run in range(4):
+        contexts = [_prompt(context, seed + 2 * i) for i in range(c)]
+        users = [_prompt(2048, seed + 2 * i + 1) for i in range(c)]
+        seed += 2 * c
+        loads = q.run([benchy(x, [DOT]) for x in contexts], 6)
+        infs = q.run([benchy(x, u) for x, u in zip(contexts, users)], 6)
+        for s in loads + infs:
+            assert s.got == solo(torch, s.prompt, 6, None, stop_eos=False)
+        assert all(s.cached == 0 for s in loads)
+        cached += [s.cached for s in infs]
+    assert set(cached) <= {0, at}
+    if room:
+        assert cached == [at] * 12
+    else:
+        assert cached.count(0) == 3
+
