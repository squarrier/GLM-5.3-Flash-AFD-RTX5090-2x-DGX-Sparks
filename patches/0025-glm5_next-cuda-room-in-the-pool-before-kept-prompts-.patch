+def test_evictions_take_what_no_waiting_request_resumes_first(fake, monkeypatch):  # noqa: F811
+    """A full pool of six one-block kept prompts; the waiting requests resume K1, then K0, then K4. A prompt needing 3
+    blocks evicts K2, K3 and K5 (none wanted, least recently used first); one needing 4 more then evicts K4, the
+    kept prompt the latest waiting request wants, and K0 and K1 stay."""
+
+    from tensorfold.families.glm5_next.cuda.multi import EVICT
+
+    monkeypatch.setenv("TF_GLM_CACHE_ROOM", "1")
+    torch = fake
+    p = Pair(torch, streams=2, blocks=6, entries=16)
+    d = p.d[0]
+    prompts = kept_one_block_each(p, 6, 80)
+    kid = {k: next(c.kid for c in d.kept if c.ids == prompts[k][:999]) for k in range(6)}
+    waiting = [prompts[1] + [5, 6], prompts[0] + [7], prompts[4] + [8, 9, 10]]
+    d.wanted = lambda: waiting
+    log = logged(p)
+    first, second = _prompt(5000, 90), _prompt(7000, 91)
+    s = p.submit(first, 4, None)
+    p.run()
+    evicted = [pl[0] for m in log for op, pl in _ops(m) if op == EVICT]
+    assert evicted == [kid[2], kid[3], kid[5]]
+    assert d.room_stats["wanted_evictions"] == 0
+    kid_first = next(c.kid for c in d.kept if c.ids == first[:4999])
+    t = p.submit(second, 4, None)
+    p.run()
+    evicted = [pl[0] for m in log for op, pl in _ops(m) if op == EVICT]
+    assert evicted[3:] == [kid_first, kid[4]]                 # the one no request wants, then the latest wanted
+    assert d.room_stats["wanted_evictions"] == 1
+    for r, pr in ((s, first), (t, second)):
+        assert r.got == solo(torch, pr, 4, None)
+    for k in (0, 1):
+        again = p.submit(waiting[1 - k], 6, None)
+        p.run()
+        assert again.cached == 999 and again.got == solo(torch, waiting[1 - k], 6, None)
