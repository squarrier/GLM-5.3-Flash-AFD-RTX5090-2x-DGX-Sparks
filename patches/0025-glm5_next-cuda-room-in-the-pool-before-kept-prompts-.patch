@@ -0,0 +1,319 @@
+"""TF_GLM_CACHE_ROOM (``cache_room``): room in the --parallel pool from its free rows before any kept prompt is evicted,
+and evictions that spare what waiting requests resume, on CPU with tests/test_glm_multi.py's fake model (two ranks,
+rank 1 applying rank 0's messages; every reply checked against the request served alone).
+
+The pattern is llama-benchy's long arena cells on the RTX 5090's pool, where the multi-stream engine's
+``_room`` and ``_grow`` evicted, least recently used first, the kept prompts that queued requests were about to
+resume while the free rows already covered what was needed (they lay in pieces between extents):
+
+- a new prompt with free rows in pieces (a context load admitted while others fill): off, the oldest kept prompts
+  go until a gap fits; on, the extents move together and nothing goes;
+- a kept prompt taken over in place that must grow by a block, its neighbour right after it (an inference request
+  resuming its context): off, the neighbour's kept prompt goes; on, the extents are packed with the block after it;
+- a pool that truly lacks rows: on, the kept prompts no waiting request resumes go first, then the one the latest
+  waiting request wants;
+- llama-benchy's phases at a scale where the off path misses (``test_benchy_runs_resume_their_contexts``).
+Off is the engine's order unchanged (``tests/test_glm_multi.py`` covers it); these tests pin both.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+from tests.test_glm_multi import ALIGN, Pair, _ops, _prompt, _sampling, fake, solo  # noqa: F401
+
+pytestmark = pytest.mark.torch
+
+HEAD, USER, DOT, TAIL = [40, 41, 42], 43, 44, [45, 46, 39]      # [gMASK]<sop><|system|>, <|user|>, ".", the tail
+
+
+def logged(p):
+    """Rank 0's ops, in order, as they are sent."""
+    log: list = []
+    real = p.g[0]._share
+    p.g[0]._share = lambda values: (log.append(list(values)), real(values))[1]
+    return log
+
+
+def ops_of(log) -> list[int]:
+    return [op for m in log for op, _ in _ops(m)]
+
+
+def blocks(d) -> list[tuple[int, int]]:
+    return [(x.base // ALIGN, x.size // ALIGN) for x in d.pool.extents]
+
+
+def kept_one_block_each(p, count: int, seed: int) -> list[list[int]]:
+    """``count`` finished requests of 1,000 tokens: a kept prompt (999 tokens) in an extent of one block each, placed
+    lowest first."""
+    prompts = [_prompt(1000, seed + k) for k in range(count)]
+    for pr in prompts:
+        s = p.submit(pr, 4, None)
+        p.run()
+        assert s.got == solo(p.torch, pr, 4, None)
+    return prompts
+
+
+def kept_ids(d) -> list[list[int]]:
+    return [c.ids for c in d.kept]
+
+
+def test_the_switch(fake, monkeypatch):  # noqa: F811
+    from tensorfold.families.glm5_next.cuda import cache_room
+
+    assert [cache_room.enabled(v) for v in ("", "0", "off", " OFF ", "1", "on", "On")] == [False] * 4 + [True] * 3
+    with pytest.raises(ValueError, match="TF_GLM_CACHE_ROOM"):
+        cache_room.enabled("2")
+    monkeypatch.delenv("TF_GLM_CACHE_ROOM", raising=False)
+    off = Pair(fake, streams=2, blocks=4)
