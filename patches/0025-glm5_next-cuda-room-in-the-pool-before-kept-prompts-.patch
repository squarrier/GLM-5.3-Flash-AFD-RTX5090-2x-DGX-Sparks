@@ -0,0 +1,197 @@
+"""TF_GLM_CACHE_ROOM (default off): room in the --parallel pool that moves extents before it evicts kept prompts, and
+evictions that spare the kept prompts waiting requests resume.
+
+``MultiDecoder._room`` and ``_grow`` (the multi-stream engine's, MiaAI-Lab recipe patch 0030 as it stands at v1.5,
+unchanged while this is off) evict kept prompts, least recently used first, until a gap fits, and move the extents
+together (``_compact``) only once nothing is left to evict. On the AFD attention node the pool is one RTX 5090's
+(626,688 tokens at TF_GLM_CACHE_GIB=8, against about 2.9 M tokens in the recipe's two-Spark lane), so a few 65K-100K
+contexts fill it and its free rows lie in pieces between extents: a new prompt, or a resumed one taken over in place,
+then evicted the kept prompts that queued requests were about to resume while the free rows already covered it, and
+each such miss refilled its whole context, evicting the next one.
+
+On (``TF_GLM_CACHE_ROOM=1``), rank 0 makes room this way:
+
+- ``room``: a new extent's rows come from the free rows when they cover it (the extents moved together if no gap
+  does); kept prompts are evicted only while the free rows fall short;
+- ``grow``: an extent that must grow (a kept prompt taken over in place, a decoding stream past its rows) grows in
+  place or moves to a gap as before; else kept prompts are evicted only while the free rows fall short, and the
+  extents are packed from row 0 with the rows it needs right after it (``pack``);
+- ``victims``: each eviction takes the first kept prompt, in this order, whose eviction gives rows back (one shorter
+  than another in its extent gives none): those no waiting request would resume, least recently used first; then
+  those that waiting requests would resume, the one the latest request wants first. The waiting requests are the
+  scheduler's (``MultiDecoder.wanted``: their prompts, in admission order).
+
+Replies, prompt chunks, kept points and kernel calls do not change, only which kept prompts survive and where the
+extents sit; rank 0 sends EVICT, MOVE and GROW as before, so rank 1 applies them with no setting of its own. /health
+gains ``cache_room``: the moves together, the extents and rows they moved, the evictions and how many of them took a
+kept prompt a waiting request wanted.
+"""
+
+from __future__ import annotations
+
+import os
+
+from .pool import align_up
+
+
+def enabled(value: str | None = None) -> bool:
+    """TF_GLM_CACHE_ROOM: 0 (off, the default) or 1 (on)."""
+
+    value = os.environ.get("TF_GLM_CACHE_ROOM", "") if value is None else value
+    value = value.strip().lower()
+    if value in ("", "0", "off"):
+        return False
+    if value in ("1", "on"):
+        return True
+    raise ValueError(f"TF_GLM_CACHE_ROOM: 0 (off) or 1 (on), not {value!r}")
+
+
+def counters() -> dict:
+    """``MultiDecoder.room_stats``, /health's ``cache_room``."""
+
+    return {"packs": 0, "moved": 0, "moved_rows": 0, "evictions": 0, "wanted_evictions": 0}
+
+
+def wanted(d) -> dict[int, int]:
+    """id(kept prompt) -> the admission position of the first waiting request that would resume it: the longest kept
+    strict prefix of its prompt that sits on the prompt grid, or its whole prompt with a head row (a replay):
+    ``MultiDecoder._resume``'s choice without its drafter checks."""
+
+    source = getattr(d, "wanted", None)
+    prompts = list(source()) if callable(source) else []
+    ranks: dict[int, int] = {}
+    if not prompts or not d.kept:
+        return ranks
+    for i, prompt in enumerate(prompts):
+        best = None
+        for c in d.kept:
+            n = len(c.ids)
+            if best is not None and n <= len(best.ids):
+                continue
+            if (d.grid and n % d.grid) or n > len(prompt) or (n == len(prompt) and getattr(c, "head", None) is None):
+                continue
+            k = min(n, 64)
+            if prompt[n - k:n] != c.ids[n - k:] or prompt[:n] != c.ids:
+                continue
+            best = c
+        if best is not None:
+            ranks.setdefault(id(best), i)
+    return ranks
+
+
+def freed(c) -> int:
+    """The rows evicting kept prompt ``c`` gives back now (its extent, held by no stream, shrinks to its longest other
+    kept prompt or goes: ``MultiDecoder._settle``)."""
+
+    x = c.extent
+    rest = [len(k.ids) for k in x.kept if k is not c]
+    return max(0, x.size - (align_up(max(rest)) if rest else 0))
+
+
+def victims(d, protect, ranks: dict[int, int]) -> list:
+    """``MultiDecoder._victims`` (kept prompts in extents no stream holds and not in ``protect``, least recently used
+    first) in eviction order: those no waiting request would resume, in that order; then the others, the one the
+    latest waiting request wants first."""
+
+    pool = d._victims(protect)
+    spare = [c for c in pool if id(c) not in ranks]
+    held = sorted((c for c in pool if id(c) in ranks), key=lambda c: -ranks[id(c)])
+    return spare + held
+
+
+def evict(d, rows: int, protect) -> None:
+    """Rank 0: evict until the pool's free rows cover ``rows``, each time the first kept prompt in ``victims``' order
+    whose eviction gives rows back; stops early when none does."""
+
+    ranks = None
+    while d.pool.free_rows() < rows:
+        if ranks is None:
+            ranks = wanted(d)
+        pick = next((c for c in victims(d, protect, ranks) if freed(c) > 0), None)
+        if pick is None:
+            return
+        d.room_stats["evictions"] += 1
+        d.room_stats["wanted_evictions"] += int(id(pick) in ranks)
+        d._evict(pick)
+
+
+def _moved(d, before: dict) -> None:
+    st = d.room_stats
+    st["packs"] += 1
+    for x in d.pool.extents:
+        base, used = before.get(id(x), (x.base, 0))
+        if x.base != base:
+            st["moved"] += 1
+            st["moved_rows"] += used
+
+
+def room(d, need: int, protect=()) -> int | None:
+    """``MultiDecoder._room`` with TF_GLM_CACHE_ROOM=1: a base with ``need`` free rows, from the free rows first (the
+    extents moved together when no gap fits), evicting only what they lack; None if even that leaves too little."""
+
+    base = d.pool.place(need)
+    if base is not None:
+        return base
+    evict(d, need, protect)
+    if d.pool.free_rows() < need:
+        return None
+    base = d.pool.place(need)
+    if base is None:
+        before = {id(x): (x.base, d._used(x)) for x in d.pool.extents}
+        d._compact()
+        _moved(d, before)
+        base = d.pool.place(need)
+    return base
+
+
+def pack(d, x, extra: int) -> None:
+    """Rank 0: every extent moved together from row 0, in their order, with ``extra`` free rows right after x (MOVEs:
+    those moving down first, lowest first, then those moving up, highest first, so that no move lands on rows another
+    extent still holds)."""
+
+    from .multi import MOVE
+
+    before = {id(y): (y.base, d._used(y)) for y in d.pool.extents}
+    targets = []
+    at = 0
+    for y in list(d.pool.extents):
+        targets.append((y, at))
+        at += y.size + (extra if y is x else 0)
+    if at > d.pool.rows:
+        raise RuntimeError(f"the pool's {d.pool.rows} rows cannot hold its extents and {extra} more after {x.eid}")
+    for y, base in targets:
+        if base < y.base:
+            d._emit(MOVE, [y.eid, base, y.size])
+            d._move(y, base, y.size)
+    for y, base in reversed(targets):
+        if base > y.base:
+            d._emit(MOVE, [y.eid, base, y.size])
+            d._move(y, base, y.size)
+    _moved(d, before)
+
+
+def grow(d, x, size: int, protect) -> bool:
+    """``MultiDecoder._grow`` with TF_GLM_CACHE_ROOM=1 (``size`` aligned and past x's; ``protect`` holds x): in place, or
+    moved to a gap; else evicting only what the free rows lack, then in place or to a gap again, else packed."""
+
+    from .multi import GROW, MOVE
+
+    extra = size - x.size
+    for attempt in (0, 1):
+        if d.pool.room_after(x) >= extra:
+            d._emit(GROW, [x.eid, size])
+            d._resize(x, size)
+            return True
+        base = d.pool.place(size, ignore=[x])
+        if base is not None:
+            d._emit(MOVE, [x.eid, base, size])
+            d._move(x, base, size)
+            return True
+        if attempt == 0:
+            evict(d, extra, protect)
+            if d.pool.free_rows() < extra:
+                return False
+    pack(d, x, extra)
+    d._emit(GROW, [x.eid, size])
+    d._resize(x, size)
+    return True
