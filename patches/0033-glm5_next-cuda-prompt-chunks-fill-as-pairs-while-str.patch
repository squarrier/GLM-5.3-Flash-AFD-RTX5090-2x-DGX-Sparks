--- /dev/null
+++ b/tests/test_glm_fill_pairs.py
@@ -0,0 +1,346 @@
+"""TF_GLM_FILL_PAIRS and TF_GLM_FILL_ROUNDS (``fill_pairs``, ours) on CPU: prompt fills paced while other streams
+decode on the AFD attention node.
+
+The model is tests/test_glm_sliced_fill.py's layered fake (six layers of 1-ms startup timings, TF_GLM_FILL_BUDGET_MS
+2.5: slices of two layers) at world 1 over its checked slice wire (``SlicedWorld1``: the real ``afd.AfdWire.begin``
+and exchanges over the real MCDMA header writer, read back as the expert reads them), with
+tests/test_glm_multi_afd.py's fake pairs (the real ``prefill_pairs.run_pair`` and ``finish``; each chunk of a pair a
+forward of its own after the pair's begin, logged as ("pair", rows, rows)). Every reply is checked against the
+request served alone (``solo``), and each run against the same run with the switches unset: replies, cached counts,
+kept states and their pool rows. Covered:
+
+- TF_GLM_FILL_PAIRS=1: a long prompt arriving while a stream decodes fills as pairs between decode rounds
+  (``_fill_pair`` called while a stream decodes, every pair over the checked wire), with fewer layer slices; a
+  chunk without a partner (its prompt's last) still goes in slices; the staggered six requests at 2 and 4 streams;
+  TF_GLM_MULTI_PREFILL's grouped chunks with TF_GLM_KV=fp8's rings; a client leaving after a pair;
+- TF_GLM_FILL_ROUNDS=K: K batched forwards between two slices of one chunk while streams decode (1 as before), at
+  world 1 and at two ranks (rank 1 applying rank 0's ROUND and FILLPART messages, both ranks equal);
+- the settings: their values and refusals, what they do where they cannot act (nothing: no pairs, no budget, two
+  ranks), /health and the start line's words only with a switch set.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from tests import test_glm_kv8_multi as tk
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_prefill as tmp
+from tests import test_glm_sliced_fill as tsf
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+from tests.test_glm_multi import fake  # noqa: F401
+from tests.test_glm_multi_afd import afd_fake  # noqa: F401
+
+pytestmark = pytest.mark.torch
+rings = tk.rings                                              # fixture: TF_GLM_KV=fp8's per-slot indexer rings
+
+PAIRS, ROUNDS = "TF_GLM_FILL_PAIRS", "TF_GLM_FILL_ROUNDS"
+
+
+def _env(monkeypatch, name: str, value: str | None) -> None:
+    if value is None:
+        monkeypatch.delenv(name, raising=False)
+    else:
+        monkeypatch.setenv(name, value)
+
+
+def _world(env, monkeypatch, *, on: bool, rounds: str | None = None, group: bool = False, streams: int = 2,
+           blocks: int = 24, **kw):
+    """``SlicedWorld1`` (budget 2.5 ms) with TF_GLM_PREFILL_PAIRS=1, TF_GLM_FILL_PAIRS on or unset and
+    TF_GLM_FILL_ROUNDS, its pool large enough that no stream waits for room; ``fills`` records each pair's plans, its
+    rows and whether a stream decoded when it ran."""
+
+    monkeypatch.delenv("TF_GLM_PREFILL_LANES", raising=False)
+    monkeypatch.setenv("TF_GLM_PREFILL_PAIRS", "1")
+    _env(monkeypatch, PAIRS, "1" if on else None)
+    _env(monkeypatch, ROUNDS, rounds)
+    tmp._mode(monkeypatch, group)
+    tsf.layered(monkeypatch, "2.5")
+    n1 = tsf.SlicedWorld1(env, streams=streams, blocks=blocks, **kw)
+    d = n1.d
+    assert d.pairs and d.fill_budget == 2.5 and d.fill_pairs == on and d.fill_rounds == int(rounds or 1)
+    fills, real = [], d._fill_pair
+
+    def logged(*plans):
+        assert d.partial is None and len(plans) == 2
+        busy = any(x.decoding and not x.s.done and not x.paused for x in d.lanes.values())
+        ends: dict[int, int] = {}
+        rows = 0
+        for plan in plans:
+            for x, stop in plan:
+                rows += stop - ends.get(x.sid, x.st.pos)
+                ends[x.sid] = stop
+        fills.append((busy, [[(x.sid, stop) for x, stop in plan] for plan in plans], rows))
+        return real(*plans)
+
+    d._fill_pair = logged
+    return n1, d, fills
+
+
+def _trace(d) -> list[tuple[str, int]]:
+    """The decoder's fill steps and decode rounds in order: ("slice", the layer it starts at), ("round", 0)."""
+
+    seq: list[tuple[str, int]] = []
+    part, rnd = d._part_iteration, d._round
+
+    def sliced():
+        seq.append(("slice", d.partial.layer if d.partial is not None else 0))
+        return part()
+
+    def rounds(*a, **k):
+        seq.append(("round", 0))
+        return rnd(*a, **k)
+
+    d._part_iteration, d._round = sliced, rounds
+    return seq
+
+
+def _rounds_between_slices(seq) -> list[int]:
+    """For every two consecutive slices of one chunk (the second resuming past layer 0), the decode rounds between."""
+
+    out, n, open_ = [], 0, False
+    for kind, layer in seq:
+        if kind == "slice":
+            if open_ and layer > 0:
+                out.append(n)
+            open_, n = True, 0
+        else:
+            n += 1
+    return out
+
+
+def _mid_decode(n1, d, reqs):
+    """The first request decodes (no stop at EOS: it decodes all its tokens, through the second's fill), then the
+    second arrives; both run to the end, each reply its solo one."""
+
+    a = n1.submit(*reqs[0], stop_eos=False)
+    while not (a.sid in d.lanes and d.lanes[a.sid].decoding):
+        n1.step()
+    b = n1.submit(*reqs[1])
+    n1.run()
+    assert a.got == tm.solo(n1.torch, *reqs[0], stop_eos=False) and len(a.got) == reqs[0][1]
+    assert b.got == tm.solo(n1.torch, *reqs[1])
+    return [a.got, b.got], [a.cached, b.cached]
+
+
+REQS = [(tm._prompt(300, 51), 200, tm._sampling("greedy", 51)), (tm._prompt(200, 52), 12, tm._sampling("topk", 52))]
+
+
+# -- TF_GLM_FILL_PAIRS ------------------------------------------------------------------------------------------------
+# (n, pairs mid-decode, their rows, chunks still sliced): 64-row chunks up to the kept point before the prompt's last
+# token, then that token's own chunk (``lane.stops``); a chunk ending the prompt is no pair's first
+CHUNKS = [(200, 2, 199, 1), (150, 2, 150, 0), (129, 1, 128, 1), (60, 1, 60, 0)]
+
+
+@pytest.mark.parametrize("n,pairs,rows,sliced", CHUNKS, ids=["64x3+7+1", "64x2+21+1", "64x2+1", "59+1"])
+def test_a_prompt_arriving_mid_decode_fills_in_pairs(afd_fake, monkeypatch, n, pairs, rows, sliced):  # noqa: F811
+    """A 300-token prompt decodes when an ``n``-token one arrives (64-row chunks): with the switch unset each of that
+    one's chunks goes in layer slices; with it on, a chunk and the next fill as one pair between two decode rounds
+    wherever the first ends no prompt, and a chunk without a partner (the last token's, after a pair) goes in
+    slices. The same replies (the solo ones), cached counts and kept states either way."""
+
+    from tensorfold.families.glm5_next.cuda.afd import MODE_SLICE
+
+    reqs = [REQS[0], (tm._prompt(n, 52), 12, tm._sampling("topk", 52))]
+    runs = {}
+    for on in (False, True):
+        n1, d, fills = _world(afd_fake, monkeypatch, on=on)
+        got, cached = _mid_decode(n1, d, reqs)
+        runs[on] = (n1, d, fills, got, cached, tmp.kept_view(d))
+    (_, d0, f0, g0, c0, k0), (n1, d1, f1, g1, c1, k1) = runs[False], runs[True]
+    assert g0 == g1 and c0 == c1 and k0 == k1
+    assert not [f for f in f0 if f[0]] and d0.busy_paired == {"pairs": 0, "rows": 0}     # off: no pair mid-decode
+    busy = [f for f in f1 if f[0]]
+    assert len(busy) == d1.busy_paired["pairs"] == pairs and d1.busy_paired["rows"] == sum(f[2] for f in busy) == rows
+    assert d1.paired["pairs"] == len(f1) and [e for e in n1.wire.events if e[0] == "pair"]
+    assert d0.sliced["chunks"] == -(-(n - 1) // 64) + 1 and d1.sliced["chunks"] == sliced
+    assert d1.sliced["slices"] < d0.sliced["slices"]
+    assert any(b[2] == MODE_SLICE for b in n1.begins()) == (sliced > 0)
+    assert d1.partial is None and n1.wire.tr.next is None
+    assert d1.health()["fill_pairs"] == d1.busy_paired and "fill_pairs" not in d0.health()
+
+
+@pytest.mark.parametrize("streams", [2, 4])
+def test_the_staggered_requests(afd_fake, monkeypatch, streams):  # noqa: F811
+    """tests/test_glm_multi.py's six staggered requests: the same replies (each its solo one) and kept states with
+    the switch on as unset, and pairs ran while streams decoded."""
+
+    runs = {}
+    for on in (False, True):
+        n1, d, fills = _world(afd_fake, monkeypatch, on=on, streams=streams)
+        runs[on] = (tsf.staggered(n1, d, streams), tmp.kept_view(d), fills, d)
+    (g0, k0, _, _), (g1, k1, f1, d1) = runs[False], runs[True]
+    assert g0 == g1 and k0 == k1
+    assert [f for f in f1 if f[0]] and d1.busy_paired["pairs"] > 0 and d1.partial is None
+
+
+def test_grouped_chunks_and_fp8_rings_pair_mid_decode(afd_fake, rings, monkeypatch):  # noqa: F811
+    """TF_GLM_MULTI_PREFILL=1 (grouped chunks) with TF_GLM_KV=fp8's rings: a burst of three short prompts and a long
+    one while a stream decodes, the switch on as unset: the same replies and kept states; a pair ran mid-decode."""
+
+    tk._ringed(afd_fake.torch)
+    first = (tm._prompt(30, 41), 120, tm._sampling("topk", 9))
+    burst = [(tm._prompt(300, 71), 12, tm._sampling("greedy", 71)), (tm._prompt(200, 72), 12, tm._sampling("minp", 72)),
+             (tm._prompt(40, 73), 12, tm._sampling("nucleus", 73))]
+    runs = {}
+    for on in (False, True):
+        n1, d, fills = _world(afd_fake, monkeypatch, on=on, group=True, streams=4, prefill_rows=256)
+        a = n1.submit(*first)
+        while not (a.sid in d.lanes and d.lanes[a.sid].decoding):
+            n1.step()
+        streams = [n1.submit(*r) for r in burst]
+        n1.run()
+        for s, (pr, cnt, sp) in zip([a, *streams], [first, *burst]):
+            assert s.got == tm.solo(afd_fake.torch, pr, cnt, sp)
+        runs[on] = ([s.got for s in (a, *streams)], tmp.kept_view(d), fills, d)
+    (g0, k0, _, _), (g1, k1, f1, d1) = runs[False], runs[True]
+    assert g0 == g1 and k0 == k1 and d1.grouped["chunks"] > 0
+    busy = [f for f in f1 if f[0]]
+    assert busy and d1.busy_paired["pairs"] == len(busy) and any(len(plan) > 1 for f in busy for plan in f[1])
+
+
+def test_a_client_leaving_after_a_mid_decode_pair(afd_fake, monkeypatch):  # noqa: F811
+    """The arriving prompt's client leaves right after its first pair: the pair completes, the stream leaves at the
+    next iteration, its extent goes back to the pool; the decoding stream's reply is its solo one."""
+
+    n1, d, fills = _world(afd_fake, monkeypatch, on=True)
+    a = n1.submit(*REQS[0], stop_eos=False)
+    while not (a.sid in d.lanes and d.lanes[a.sid].decoding):
+        n1.step()
+    b = n1.submit(*REQS[1])
+    gone = [False]
+    b.emit.cancelled = lambda: gone[0]
+    for _ in range(200):
+        n1.step()
+        if fills and fills[-1][0]:
+            break
+    assert fills and fills[-1][0] and b.sid in d.lanes
+    x = d.lanes[b.sid].extent
+    gone[0] = True
+    for _ in range(5):
+        if b.done:
+            break
+        n1.step()
+    assert b.done and b.sid not in d.lanes and d.partial is None
+    assert all(e is not x for e in d.pool.extents)
+    n1.run()
+    assert a.got == tm.solo(afd_fake.torch, *REQS[0], stop_eos=False) and n1.wire.tr.next is None
+
+
+# -- TF_GLM_FILL_ROUNDS --------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("rounds", [None, "2", "3"])
+def test_decode_rounds_between_two_slices(afd_fake, monkeypatch, rounds):  # noqa: F811
+    """TF_GLM_FILL_ROUNDS=K (unset: 1): between two slices of one chunk while streams decode, K batched forwards
+    (fewer only where the last decoding stream ended between them); the replies are the solo ones and the kept
+    states those of K=1."""
+
+    k = int(rounds or 1)
+    runs = {}
+    for r in (None, rounds):
+        n1, d, _ = _world(afd_fake, monkeypatch, on=False, rounds=r)
+        seq = _trace(d)
+        got, cached = _mid_decode(n1, d, REQS)
+        runs[r] = (got, cached, tmp.kept_view(d), _rounds_between_slices(seq), d)
+    g0, c0, k0, between0, _ = runs[None]
+    g1, c1, k1, between, d1 = runs[rounds]
+    assert g0 == g1 and c0 == c1 and k0 == k1
+    assert between0 and set(between0) == {1}
+    assert between and set(between) == {k}               # REQS[0] decodes past the second prompt's fill
+    assert d1.sliced["rounds"] >= k * (d1.sliced["slices"] - d1.sliced["chunks"])
+
+
+def test_rounds_with_pairs_on(afd_fake, monkeypatch):  # noqa: F811
+    """Both switches: K=2 rounds after each slice and each mid-decode pair; the same replies and kept states."""
+
+    runs = {}
+    for on, r in ((False, None), (True, "2")):
+        n1, d, fills = _world(afd_fake, monkeypatch, on=on, rounds=r)
+        seq = _trace(d)
+        real = d._busy_pair
+
+        def paired(plans, prof, seq=seq, real=real):
+            seq.append(("pair", 0))
+            return real(plans, prof)
+
+        d._busy_pair = paired
+        got, cached = _mid_decode(n1, d, REQS)
+        runs[on] = (got, cached, tmp.kept_view(d), fills, seq)
+    assert runs[False][:3] == runs[True][:3] and [f for f in runs[True][3] if f[0]]
+    seq = [k for k, _ in runs[True][4]]
+    after = [seq[i + 1:i + 3] for i, k in enumerate(seq) if k == "pair"]
+    assert after and all(a == ["round", "round"] for a in after)        # two rounds after each mid-decode pair
+
+
+def test_two_ranks_rounds(fake, monkeypatch):  # noqa: F811
+    """TF_GLM_FILL_ROUNDS=2 at two ranks (rank 1 applying rank 0's messages, both ranks equal after every message):
+    the staggered requests' replies and kept states as with 1, two ROUNDs after each FILLPART while streams decode."""
+
+    from tensorfold.families.glm5_next.cuda.multi import FILLPART, ROUND
+
+    runs = {}
+    for r in (None, "2"):
+        _env(monkeypatch, PAIRS, None)
+        _env(monkeypatch, ROUNDS, r)
+        tsf.layered(monkeypatch, "2.5")
+        p = tsf.LoggedPair(fake, streams=4)
+        runs[r] = (tsf.staggered(p, p.d[0], 4), tmp.kept_view(p.d[0]), p)
+    (g0, k0, _), (g1, k1, p1) = runs[None], runs["2"]
+    assert g0 == g1 and k0 == k1 == tmp.kept_view(p1.d[1])
+    ops = [op for m in p1.log for op, _ in tm._ops(m)]
+    runs_after = []
+    for i, op in enumerate(ops):
+        if op == FILLPART:
+            n = 0
+            for nxt in ops[i + 1:]:
+                if nxt == ROUND:
+                    n += 1
+                elif nxt in (FILLPART,):
+                    break
+            runs_after.append(n)
+    assert runs_after and max(runs_after) >= 2
+    assert p1.d[1].partial is None and p1.d[1].idle
+
