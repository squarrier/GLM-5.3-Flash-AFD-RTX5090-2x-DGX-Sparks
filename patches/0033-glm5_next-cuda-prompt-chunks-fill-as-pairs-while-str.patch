+# -- the settings --------------------------------------------------------------------------------------------------
+def test_the_settings_and_the_afd_check():
+    from tensorfold.families.glm5_next.cuda import fill_pairs
+    from tensorfold.families.glm5_next.cuda.engine import afd_parallel_check
+
+    assert fill_pairs.enabled("") is False and fill_pairs.enabled("0") is False and fill_pairs.enabled("1") is True
+    assert fill_pairs.rounds("") == 1 and fill_pairs.rounds("1") == 1 and fill_pairs.rounds("8") == 8
+    for bad in ("2", "yes", "-1"):
+        with pytest.raises(ValueError, match=PAIRS):
+            fill_pairs.enabled(bad)
+    for bad in ("0", "9", "x", "1.5"):
+        with pytest.raises(ValueError, match=ROUNDS):
+            fill_pairs.rounds(bad)
+    assert fill_pairs.effective(pairs=True, budget=200.0, on=True, k=3) == (True, 3)
+    assert fill_pairs.effective(pairs=False, budget=200.0, on=True, k=2) == (False, 2)    # rounds at any world
+    assert fill_pairs.effective(pairs=True, budget=0.0, on=True, k=2) == (False, 1)       # nothing to pace
+    assert fill_pairs.effective(pairs=True, budget=200.0, on=False, k=1) == (False, 1)
+    assert fill_pairs.describe(False, 1) == ""
+    assert PAIRS in fill_pairs.describe(True, 1) and ROUNDS in fill_pairs.describe(False, 2)
+    afd_parallel_check({PAIRS: "1", ROUNDS: "2", "TF_GLM_FILL_BUDGET_MS": "200"})
+    with pytest.raises(ValueError, match=PAIRS):
+        afd_parallel_check({PAIRS: "on"})
+    with pytest.raises(ValueError, match=ROUNDS):
+        afd_parallel_check({ROUNDS: "0"})
+
+
+def test_inert_without_pairs_or_budget(afd_fake, fake, monkeypatch):  # noqa: F811
+    """TF_GLM_FILL_PAIRS=1 does nothing without TF_GLM_PREFILL_PAIRS (or off the attention node: two ranks), and both
+    settings nothing without TF_GLM_FILL_BUDGET_MS: the decoder takes them as unset (no "fill_pairs" in /health)."""
+
+    monkeypatch.delenv("TF_GLM_PREFILL_LANES", raising=False)
+    monkeypatch.delenv("TF_GLM_PREFILL_PAIRS", raising=False)
+    _env(monkeypatch, PAIRS, "1")
+    _env(monkeypatch, ROUNDS, "2")
+    tsf.layered(monkeypatch, "2.5")
+    d = tsf.SlicedWorld1(afd_fake, streams=2).d
+    assert (d.pairs, d.fill_pairs, d.fill_rounds) == (False, False, 2) and "fill_pairs" not in d.health()
+    p = tsf.LoggedPair(fake, streams=2)
+    assert [(x.fill_pairs, x.fill_rounds) for x in p.d] == [(False, 2), (False, 2)]
+    monkeypatch.setenv("TF_GLM_PREFILL_PAIRS", "1")
+    tsf.layered(monkeypatch, None)
+    d = tsf.SlicedWorld1(afd_fake, streams=2).d
+    assert (d.pairs, d.fill_budget, d.fill_pairs, d.fill_rounds) == (True, 0.0, False, 1)
