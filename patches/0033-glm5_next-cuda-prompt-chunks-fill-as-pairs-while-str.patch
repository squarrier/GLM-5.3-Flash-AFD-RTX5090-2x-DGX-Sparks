diff --git a/src/tensorfold/families/glm5_next/cuda/fill_pairs.py b/src/tensorfold/families/glm5_next/cuda/fill_pairs.py
new file mode 100644
index 0000000..9e3c4ad
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/fill_pairs.py
@@ -0,0 +1,77 @@
+"""Prompt fills while other streams decode, on the AFD attention node (ours): TF_GLM_FILL_PAIRS and TF_GLM_FILL_ROUNDS.
+
+With TF_GLM_FILL_BUDGET_MS (MiaAI-Lab recipe patch 0062, ``sliced_fill``) a prompt chunk started while other streams
+decode runs a few layers at a time, one decode round between two slices. On the split such a chunk fills at about half
+the rate of the same rows as a pair (TF_GLM_PREFILL_PAIRS, ``prefill_pairs``): one chunk alone keeps either the 5090
+or the two Sparks idle while the other works, and the wire carries one exchange at a time. In the release
+configuration's arena cells a 2,105-row fill at 64K of context runs ~2,500 tok/s as a pair and ~1,300 tok/s
+sliced, and a decode round with a slice due costs ~250 ms against ~75 ms without one. At 10 requests x 64K each
+reply's decode rate is 12.0 tok/s, mostly because its rounds wait behind those slices.
+
+- ``TF_GLM_FILL_PAIRS=1``: while streams decode, a new chunk and the one after it fill as one unsliced pair
+  (``MultiDecoder._pair_plan``'s rules: the first chunk ends no prompt and no stream drafts with the MTP head; at most
+  two chunks, TF_GLM_PREFILL_LANES aside), the decode rounds due after it as after a slice; a chunk with no partner
+  goes in layer slices as before. A reply waits once per pair (~0.8 s of 2 x 1,024 rows) instead of ~250 ms a round
+  while the prompt fills; TF_GLM_FILL_ROWS sizes the pair's chunks. Acts on the AFD attention node with
+  TF_GLM_PREFILL_PAIRS=1 (or LANES >= 2) and TF_GLM_FILL_BUDGET_MS > 0, and does nothing elsewhere (``effective``).
+  Default 0: everything as before.
+- ``TF_GLM_FILL_ROUNDS=K`` (1 .. 8, default 1): decode rounds due after each slice (or such pair) before the next
+  fill step, while streams decode, with TF_GLM_FILL_BUDGET_MS > 0 (at any world: rank 1 follows rank 0's messages).
+  More decode per request during fills, a later first token for the filling ones.
+
+Neither changes a reply's bits: every chunk keeps its rows, row count and kernels (a pair only interleaves two
+chunks' kernels, ``prefill_pairs``), and a decode round's streams each get their solo tokens, whichever rounds and
+chunks come between. Only the order of whole forwards on the wire changes; the expert nodes serve MODE_PAIR forwards
+and decode forwards as they come (wire unchanged). This tree's own scheduling for the attention/expert split; not a
+MiaAI-Lab recipe patch.
+"""
+
+from __future__ import annotations
+
+import os
+
+PAIRS_ENV = "TF_GLM_FILL_PAIRS"
+ROUNDS_ENV = "TF_GLM_FILL_ROUNDS"
+MAX_ROUNDS = 8
+
+
+def enabled(value: str | None = None) -> bool:
+    """TF_GLM_FILL_PAIRS: 1 fills two prompt chunks as one unsliced pair while other streams decode; unset or 0
+    (the default) as before (layer slices)."""
+
+    raw = (os.environ.get(PAIRS_ENV, "") if value is None else value).strip() or "0"
+    if raw not in ("0", "1"):
+        raise ValueError(f"{PAIRS_ENV}: 0 or 1, not {raw!r}")
+    return raw == "1"
+
+
+def rounds(value: str | None = None) -> int:
+    """TF_GLM_FILL_ROUNDS: decode rounds due after each prompt slice (or TF_GLM_FILL_PAIRS pair) while streams
+    decode, 1 .. ``MAX_ROUNDS``; unset or empty: 1, as before."""
+
+    raw = (os.environ.get(ROUNDS_ENV, "") if value is None else value).strip() or "1"
+    if raw not in {str(k) for k in range(1, MAX_ROUNDS + 1)}:
+        raise ValueError(f"{ROUNDS_ENV}: 1 .. {MAX_ROUNDS} decode rounds, not {raw!r}")
+    return int(raw)
+
+
+def effective(*, pairs: bool, budget: float, on: bool, k: int) -> tuple[bool, int]:
+    """What the settings do on a decoder (``MultiDecoder.__init__``): ``pairs`` TF_GLM_PREFILL_PAIRS's (or LANES')
+    there, ``budget`` TF_GLM_FILL_BUDGET_MS, ``on`` TF_GLM_FILL_PAIRS, ``k`` TF_GLM_FILL_ROUNDS. TF_GLM_FILL_PAIRS
+    acts only where prompt chunk pairs run (the AFD attention node with TF_GLM_PREFILL_PAIRS=1 or LANES >= 2) and fills
+    are sliced (budget > 0), TF_GLM_FILL_ROUNDS only with sliced fills; elsewhere they do nothing, as
+    TF_GLM_PREFILL_PAIRS does off the attention node (two ranks, a rank-1 follower). Returns (pairs on, rounds)."""
+
+    sliced = budget > 0
+    return on and pairs and sliced, k if sliced else 1
+
+
+def describe(on: bool, k: int) -> str:
+    """The --parallel start line's words for the settings ('' when both are at their defaults)."""
+
+    words = []
+    if on:
+        words.append("prompt chunks fill as pairs while others decode (TF_GLM_FILL_PAIRS)")
+    if k != 1:
+        words.append(f"{k} decode rounds after each prompt slice or pair (TF_GLM_FILL_ROUNDS)")
+    return "; ".join(words)
