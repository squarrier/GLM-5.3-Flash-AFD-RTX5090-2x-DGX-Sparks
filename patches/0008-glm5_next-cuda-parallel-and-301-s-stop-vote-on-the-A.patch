diff --git a/tests/cuda/test_glm_expert_rows_window.py b/tests/cuda/test_glm_expert_rows_window.py
new file mode 100644
index 0000000..b80cb75
--- /dev/null
+++ b/tests/cuda/test_glm_expert_rows_window.py
@@ -0,0 +1,70 @@
+"""The AFD expert node's routed experts (``experts_node.ExpertNode.compute``: ``exl3_generic.routed`` into the decode
+scratch up to 8 rows and the prompt scratch past them, then ``glue.combine``) give a row the same bits alone, in a solo
+decode window and inside a multi-stream batched window of up to 32 rows. This is the expert side of --parallel's
+contract under AFD (each batched reply equals its solo one; the glue after ashhart/TensorFold#243): batched
+windows of 9-32 rows run eager on the prompt scratch, solo windows on the decode scratch. Synthetic GLM-shaped experts
+(4096 -> 1024 a half, 4-bit mcg, the GLM tile settings, the shared slot zeroed). GPU only; a pre-serve check on
+each expert node's GPU and the attention node's."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA only")
+
+E, D, NI, TOPK, LIMIT, LAYER = 32, 4096, 1024, 8, 10.0, 3
+
+
+def _node():
+    from tensorfold.cuda.exl3 import experts
+    from tensorfold.families.glm5_next.cuda.experts_node import ExpertBuffers, ExpertNode
+
+    g = torch.Generator().manual_seed(5)
+
+    def trel(k, n):                                   # 4-bit trellis tiles: 64 int16 a 16x16 tile
+        v = torch.randint(-32768, 32768, (E, k // 16, n // 16, 64), dtype=torch.int32, generator=g)
+        return v.to(torch.int16).cuda().contiguous()
+
+    def sc(n, mag):
+        sign = torch.randint(0, 2, (E, n), generator=g).float() * 2 - 1
+        return (sign * (torch.rand((E, n), generator=g) + 0.5) * mag).half().cuda().contiguous()
+
+    ex = experts.prepare_stacked(trel(D, NI), trel(D, NI), trel(NI, D), sc(D, 0.02), sc(D, 0.02), sc(NI, 0.5),
+                                 sc(NI, 0.5), sc(NI, 0.05), sc(D, 0.2), "mcg")
+    node = ExpertNode.__new__(ExpertNode)             # no checkpoint: the node's buffers and compute only
+    node.cfg = SimpleNamespace(hidden=D, top_k=TOPK, moe_width=2 * NI, experts=E, limit=LIMIT)
+    node.half, node.layers, node.experts, node.by_layer = 0, [LAYER], [ex], {LAYER: ex}
+    node.buf = ExpertBuffers(node.cfg, rows=8, prefill_rows=2048)
+    return node
+
+
+def test_rows_alone_equal_rows_inside_batched_windows():
+    node = _node()
+    g = torch.Generator().manual_seed(9)
+    N = 32
+    x = torch.randn((N, D), generator=g).to(torch.bfloat16).cuda()
+    sel = torch.stack([torch.randperm(E, generator=g)[:TOPK] for _ in range(N)]).to(torch.int32)
+    pick = torch.cat([sel, torch.full((N, 1), E, dtype=torch.int32)], 1).cuda().contiguous()   # the shared slot
+    wts = torch.cat([torch.rand((N, TOPK), generator=g) * 0.2 + 0.05, torch.ones((N, 1))], 1).float().cuda()
+
+    def run(rows: list[int]) -> torch.Tensor:
+        idx = torch.tensor(rows, dtype=torch.long, device="cuda")
+        got = node.compute(LAYER, len(rows), x=(x[idx].contiguous(), pick[idx].contiguous(), wts[idx].contiguous()))
+        torch.cuda.synchronize()
+        return got.clone()
+
+    assert node.buf.scratch(8) is node.buf.decode and node.buf.scratch(9) is node.buf.pref
+    full = run(list(range(N)))                        # a 32-row batched window: the prompt scratch
+    assert torch.isfinite(full).all() and full.abs().sum() > 0
+    for n in (1, 2, 6, 8, 9, 16, 24, 32):
+        for start in sorted({0, 3, N - n}):
+            if start + n > N:
+                continue
+            got = run(list(range(start, start + n)))
+            assert torch.equal(got.view(torch.int32), full[start:start + n].view(torch.int32)), (n, start)
+    six = run(list(range(10, 16)))                    # a stream's 6-row window alone (decode scratch, R6) ...
+    window = run(list(range(4, 28)))                  # ... and inside a 24-row batched window (prompt scratch)
+    assert torch.equal(six.view(torch.int32), window[6:12].view(torch.int32))
