+                              "kda_layers": [i for i in range(45) if i % 4 != 3],
+                              "full_attn_layers": [i for i in range(45) if i % 4 == 3]},
+       "moe_intermediate_size": 2048, "num_experts_per_tok": 8, "kv_lora_rank": 512, "qk_nope_head_dim": 192,
+       "v_head_dim": 256, "index_topk": 2048}
+DFLASH2 = {"num_hidden_layers": 5, "num_key_value_heads": 8, "head_dim": 128, "sliding_window": 2048,
+           "dflash_config": {"block_size": 8}}
+
+
+def test_the_world1_estimate():
+    """At GLM-5.3-Flash's shapes a world-1 stream slot is 0.308 GiB (34 KDA layers x 64 heads), about twice the TP2
+    rank's; the multi-stream drafter's rings at world 1 are twice the TP2 rank's (8 KV heads, not 4); a kept state's
+    KDA state likewise."""
+
+    from tensorfold.families.glm5_next.cuda.engine import multi_draft_bytes, slot_bytes
+
+    one, two = slot_bytes(GLM, 1), slot_bytes(GLM, 2)
+    assert one == 330_577_920 and abs(one / 2 ** 30 - 0.308) < 0.001
+    assert 1.99 < one / two < 2.05
+    assert slot_bytes(GLM, 1, rows=0) // 2 == 2 * (slot_bytes(GLM, 2, rows=0) // 2)
+    for streams in (2, 4):
+        w1 = multi_draft_bytes(DFLASH2, streams, 1, ring=True, capacity=262152)
+        assert w1 == 2 * multi_draft_bytes(DFLASH2, streams, 2, ring=True, capacity=262152)
+    assert abs(multi_draft_bytes(DFLASH2, 2, 1, ring=True, capacity=262152) / 2 ** 30 - 0.084) < 0.001
+
+
+def test_world1_kept_prompts_fit_what_the_window_leaves():
+    """Under --parallel the PR bounds kept prompts by count alone (TF_GLM_CACHE_ENTRIES, 8; multi._keep keeps at least
+    one), and a world-1 kept state (a KDA state and a DFlash2 window) is 0.178 GiB: eight are 1.43 GiB, while the 5090
+    leaves 0.17 GiB at a 262K window. At world 1 the engine bounds the count by what the window leaves: one kept prompt
+    at 262K, seven at 196K (1.28 GiB), the setting itself with room (two ranks keep the PR's count)."""
+
+    from tensorfold.families.glm5_next.cuda.engine import kept_most, slot_bytes
+
+    gib = 2 ** 30
+    state = slot_bytes(GLM, 1, rows=0) // 2 + (22 << 20) * 2
+    assert abs(state / gib - 0.178) < 0.001 and abs(8 * state / gib - 1.425) < 0.001
+    assert kept_most(8, int(0.17 * gib), state) == 1
+    assert kept_most(8, int(1.28 * gib), state) == 7
+    assert kept_most(8, 3 * gib, state) == 8
+    assert kept_most(8, 0, state) == 1 and kept_most(0, 3 * gib, state) == 1
+
+
+# -- the wire for batched windows ---------------------------------------------------------------------------------
+@pytest.mark.parametrize("R", [7, 8, 9, 24, 32])
+def test_batched_window_shapes_on_the_wire(R, monkeypatch):
+    """A batched window of R rows: the MCDMA request and reply fit 20 + 36 MiB mailboxes
+    (startup already checks 2,048 rows); the expert node takes its decode scratch up to 8 rows, its prompt scratch
+    past them; the MCDMA request header carries R in eager mode; settings_for is the same whatever --parallel."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import afd as afd_mod
+    from tensorfold.families.glm5_next.cuda import afd_mcdma, mcdma
+    from tensorfold.families.glm5_next.cuda.experts_node import ExpertBuffers
+
+    lay = mcdma.Layout(4096, 9)
+    assert lay.req(R) <= 20 << 20 and lay.rep(R) <= 36 << 20
+    assert lay.req(R) <= lay.req(2048) and lay.rep(R) <= lay.rep(2048)
+
+    eb = ExpertBuffers.__new__(ExpertBuffers)
+    eb.rows, eb.decode, eb.pref = 8, "decode", "prompt"
+    assert eb.scratch(R) == ("decode" if R <= 8 else "prompt")
+
+    tr = afd_mcdma.McdmaTransport.__new__(afd_mcdma.McdmaTransport)      # the header table only, no links
+    tr.hdr_tab_cpu = torch.zeros((42, mcdma.HDR_INTS), dtype=torch.int32)
+    tr.hdr_tab = torch.zeros((42, mcdma.HDR_INTS), dtype=torch.int32)
+    a = afd_mod.AfdWire.__new__(afd_mod.AfdWire)
+    a.dead, a.check, a.timing, a.seq, a.layer, a.nlayers, a.tr = None, False, False, 0, 0, 42, tr
+    a.begin(R)
+    assert tr.hdr_tab[:, 1].tolist() == [1] * 42 and tr.hdr_tab[:, 2].tolist() == [R] * 42
+    assert tr.hdr_tab[:, 4].tolist() == [afd_mod.MODE_EAGER] * 42
+
+    cfg = SimpleNamespace(mlp_kinds=["dense"] * 3 + ["moe"] * 42, quant="exl3", experts=288, top_k=8)
+    s = afd_mod.settings_for("/nonexistent", cfg, prefill_rows=2048)
+    assert s == {"digest": "", "layers": list(range(3, 45)), "max_rows": 8,
+                 "mtp": 0, "prefill_rows": 2048, "quant": "exl3", "experts": 288, "top_k": 8}
+    assert "parallel" not in s
+
