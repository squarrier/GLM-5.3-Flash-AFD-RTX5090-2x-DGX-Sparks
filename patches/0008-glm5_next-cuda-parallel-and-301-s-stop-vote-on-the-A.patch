+        multi.MultiDecoder(g, 2, drafts=FakeMultiDrafter(torch, 2, 4 * ALIGN))
+    assert [s.captured for s in made] == [True, False]
+
+    bv = BatchedVerify.__new__(BatchedVerify)
+    bv.e, bv.w, bv.b = SimpleNamespace(), SimpleNamespace(afd=WireLog()), None
