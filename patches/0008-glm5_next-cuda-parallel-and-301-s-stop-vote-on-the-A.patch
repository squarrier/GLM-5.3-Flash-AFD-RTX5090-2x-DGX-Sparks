+def test_flush_sends_at_two_ranks_and_not_at_one(afd_fake):
+    """The per-iteration message: rank 0 of two ranks shares it, sealed (the PR's protocol, unchanged); the world-1
+    AFD node applies its ops as it decides them and shares, seals and numbers nothing."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda.afd import Solo
+    from tensorfold.families.glm5_next.cuda.multi import ADMIT, MultiDecoder, unseal
+
+    for comm, world in ((SimpleNamespace(), 2), (Solo(), 1)):
+        g = shell(torch, 0, pool=4 * ALIGN, streams=2)
+        g.comm = comm
+        shared: list = []
+        g._share = lambda values, shared=shared: (shared.append(list(values)), list(values))[1]
+        d = MultiDecoder(g, 2, drafts=FakeMultiDrafter(torch, 2, 4 * ALIGN), verify=SimpleNamespace())
+        assert d.world == world
+        d._emit(ADMIT, [1, 2, 3])
+        d._flush()
+        if world == 2:
+            assert len(shared) == 1 and unseal(shared[0], 0) == [ADMIT, 3, 1, 2, 3] and d.sent == 1
+        else:
+            assert shared == [] and d.sent == 0
+        assert d.outbox == [] and not d.idle
+
+
+def test_prompt_rows_cross_in_fill_chunks(afd_fake, monkeypatch):
+    """TF_GLM_FILL_ROWS sizes the chunks a prompt crosses the wire in while another stream decodes (the knob that
+    bounds an AFD fill's stall): 256-row chunks while busy, the engine's chunk when the prompt fills alone."""
+
+    torch = afd_fake.torch
+    monkeypatch.setenv("TF_GLM_FILL_ROWS", "64")
+    n1 = World1(afd_fake, streams=2, prefill_rows=256)
+    assert n1.d.fill_rows == 64 and n1.g.e.prefill_rows == 256
+    a = n1.submit(_prompt(300, 50), 60, None, stop_eos=False)
+    for _ in range(4):
+        n1.step()
+    alone = [r for k, r in n1.wire.pairs() if k == "chunk"]
+    b = n1.submit(_prompt(300, 51), 20, None)
+    n1.run()
+    beside = [r for k, r in n1.wire.pairs() if k == "chunk"][len(alone):]
+    assert sum(alone) == 300 and max(alone) > 64                 # alone: the engine's chunk (kept points aside)
+    assert sum(beside) == 300 and max(beside) == 64              # beside a decoding stream: 64-row chunks
+    assert a.got == solo(torch, a.prompt, 60, None, stop_eos=False) and b.got == solo(torch, b.prompt, 20, None)
+
