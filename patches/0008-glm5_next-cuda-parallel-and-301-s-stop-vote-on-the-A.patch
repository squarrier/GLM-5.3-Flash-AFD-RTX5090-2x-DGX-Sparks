+def test_world1_cancel_pause_give_back_and_resume(afd_fake):
+    """A cancelled stream ends at the round boundary (the others unchanged); two streams that fill the pool pause
+    and the youngest is given back and replays (each token sent once); the same conversation's next turn resumes
