+def test_world1_scheduler_burst(afd_fake):
+    """GlmScheduler on the AFD attention node alone (no follower thread): five requests at once from five threads
+    (a burst past the two slots), one stopped by its client: every other reply equals its solo one."""
+
+    from tensorfold.families.glm5_next.cuda.engine import encode_policy
+    from tensorfold.families.glm5_next.cuda.multi import GlmScheduler
+
+    torch = afd_fake.torch
+    n1 = World1(afd_fake, streams=2)
+    sched = GlmScheduler(n1.d, max_streams=2)
+    kinds = ("topk", "greedy", "nucleus", "minp", "greedy")
+    reqs = [(_prompt(40 + 30 * i, 70 + i), 30 + 5 * i, _sampling(kinds[i], i)) for i in range(5)]
+    results: dict[int, list[int]] = {}
+    errors: list = []
+
+    def client(i):
+        prompt, n, sp = reqs[i]
+        got: list[int] = []
+
+        def emit(new):
+            got.extend(new)
+            return i == 3 and len(got) >= 6
+
+        try:
+            sched.submit(prompt, n, sp, True, emit, glm={"code": encode_policy("f3"), "spec": "f3"})
+        except Exception as exc:                     # noqa: BLE001
+            errors.append(exc)
+        results[i] = got
+
+    threads = [threading.Thread(target=client, args=(i,)) for i in range(5)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(timeout=120)
+    sched.close()
+    assert not errors and len(results) == 5
+    for i in (0, 1, 2, 4):
+        prompt, n, sp = reqs[i]
+        assert results[i] == solo(torch, prompt, n, sp), i
+    assert 6 <= len(results[3]) < reqs[3][1]
+    assert results[3] == solo(torch, reqs[3][0], reqs[3][1], reqs[3][2])[:len(results[3])]
+    assert n1.shared == []
+    assert all(r <= WINDOW for k, r in n1.wire.pairs() if k == "batched")
