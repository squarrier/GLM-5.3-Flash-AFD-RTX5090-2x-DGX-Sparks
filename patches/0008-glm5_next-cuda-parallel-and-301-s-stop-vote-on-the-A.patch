@@ -0,0 +1,71 @@
+"""The PR's segmented-kernel GPU checks (tests/cuda/test_glm_kda_segments.py, test_glm_attn_segments.py) at the AFD
+attention node's world-1 shapes: 64 KDA heads and 64 attention heads a rank, where those files use TP2's 32. The same
+solo-vs-segmented bit comparisons (torch.equal), run on private copies of those modules with the head counts set to
+world 1; the indexer's 32 heads are whole on every rank at either world. GPU only (< 4 GiB); a pre-serve check on
+the attention node (the glue after ashhart/TensorFold#243)."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+import numpy as np
+
+HERE = Path(__file__).resolve().parent
+H1 = 64                                   # KDA heads (linear_attn_config num_heads) and attention heads at world 1
+C1 = 3 * H1 * 128
+
+
+def _copy(name: str, **consts):
+    """A private copy of a sibling test module with module constants replaced (its helpers read them at call time)."""
+
+    spec = importlib.util.spec_from_file_location(f"{name}_world1", HERE / f"{name}.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    for k, v in consts.items():
+        assert hasattr(mod, k), (name, k)
+        setattr(mod, k, v)
+    return mod
+
+
+@pytest.fixture(scope="module")
+def kseg():
+    return _copy("test_glm_kda_segments", H=H1, C=C1, B_OFF=C1 + 256, WIDTH=C1 + 256 + H1)
+
+
+@pytest.fixture(scope="module")
+def aseg():
+    return _copy("test_glm_attn_segments", H=H1)
