+            self.captured, self.graphs = False, {}
+
+        def capture(self):
+            self.captured = True
+
+    monkeypatch.setattr(multi, "BatchedVerify", Stub)
+    monkeypatch.setattr(torch.cuda, "is_available", lambda: True)
+    monkeypatch.delenv("TF_GLM_MULTI_GRAPHS", raising=False)
+    monkeypatch.delenv("TF_GLM_MULTI_VERIFY", raising=False)
