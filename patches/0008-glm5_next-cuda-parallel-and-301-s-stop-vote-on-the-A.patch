+"""The stop vote (MiaAI-Lab's ashhart/TensorFold#301) on the AFD attention node: world 1, ``afd.Solo`` as its comm.
+
+#301's own tests cover two ranks and one rank without a comm (``w.comm is None``). The AFD attention node is world 1
+with ``afd.Solo`` as ``w.comm``, so its samples take the gathered path (``comm_gather`` over ``Solo.all_gather``) with
+the vote's extra word. These run #301's real decode loops on that path: a stop ends the run after the next round,
+voting never changes a reply, and each verify sample's gather carries exactly one word more. The AFD node decodes
+serially or with DFlash2 drafts (MTP stays off under AFD).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+geometry = pytest.importorskip("tests.test_cuda_geometry")
+stop = pytest.importorskip("tests.test_glm_serial_stop")
+
+allocations = geometry.allocations          # the fake triton the CUDA modules import under
+cpu_loops = stop.cpu_loops                  # #301's CPU decode loops (autouse here too)
+
+KINDS = ("serial", "dflash")
+
+
+class SoloGathers:
+    """``afd.Solo``, the AFD attention node's comm, counting the words each all-gather carries."""
+
+    def __init__(self) -> None:
+        from tensorfold.families.glm5_next.cuda.afd import Solo
+
+        self.solo, self.sizes = Solo(), []
+        self.world = self.solo.world
+
+    def all_gather(self, send, recv) -> None:
+        self.sizes.append(send.numel())
+        self.solo.all_gather(send, recv)
+
+
+def run_solo(kind: str, *, sampling=None, stop_at: int | None = None, vote: bool = True, count: int = 60):
+    """One world-1 run of #301's loop over ``afd.Solo``; the server's callback asks to stop at call ``stop_at``."""
+
+    comm = SoloGathers()
+    e = stop.FakeEngine(0, 1, comm)
+    calls: list[list[int]] = []
+
+    def on_tokens(new):
+        calls.append(list(new))
+        return stop_at is not None and len(calls) >= stop_at
+
+    fn = on_tokens
+    if vote:
+        fn = e.vote = stop.decode.StopVote(on_tokens)
+    res = stop.loop(kind, e, count, sampling, fn)
+    return res, calls, e, comm
+
+
+@pytest.mark.parametrize("kind", KINDS)
+@pytest.mark.parametrize("mode", sorted(stop.SAMPLINGS))
+def test_a_stop_ends_the_afd_node_after_the_next_round(kind, mode):
+    sampling = stop.SAMPLINGS[mode]
+    ref = run_solo(kind, sampling=sampling, vote=False)[0]
+    assert len(ref.tokens) == 60                                     # unstopped: to max_tokens, as before #301
+    for stop_at in (1, 3):
+        res, calls, e, _ = run_solo(kind, sampling=sampling, stop_at=stop_at)
+        assert res.rounds == stop_at + 1 and e.vote.stop and e.vote.mine
+        assert res.tokens == ref.tokens[:len(res.tokens)]
+        assert [7] + [t for call in calls[:stop_at] for t in call] == ref.tokens[:1 + sum(map(len, calls[:stop_at]))]
+
+
+@pytest.mark.parametrize("kind", KINDS)
+@pytest.mark.parametrize("mode", sorted(stop.SAMPLINGS))
+def test_the_vote_never_changes_an_afd_reply(kind, mode):
+    sampling = stop.SAMPLINGS[mode]
+    plain, _, _, unvoted = run_solo(kind, sampling=sampling, vote=False)
+    res, _, e, voted = run_solo(kind, sampling=sampling)
+    assert res.tokens == plain.tokens and res.rounds == plain.rounds and not e.vote.stop
+    assert sum(voted.sizes) == sum(unvoted.sizes) + plain.rounds     # one word more on each verify sample's gather
+
+
+@pytest.mark.parametrize("kind", KINDS)
+def test_solo_and_no_comm_give_the_same_world1_replies(kind):
+    """``afd.Solo`` (the AFD node) and #301's own one-rank case (``w.comm is None``) decode and stop alike."""
+
+    sampling = stop.SAMPLINGS["top_k"]
+    for stop_at in (None, 2):
+        res = run_solo(kind, sampling=sampling, stop_at=stop_at)[0]
+        ref = stop.run_ranks(kind, world=1, sampling=sampling, stop_at=stop_at)[0][0][0]
+        assert res.tokens == ref.tokens and res.rounds == ref.rounds
