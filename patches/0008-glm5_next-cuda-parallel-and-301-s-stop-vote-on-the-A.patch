+# -- one rank: the replies, the wire, no messages ----------------------------------------------------------------
+@pytest.mark.parametrize("streams", [2, 4])
+def test_world1_staggered_requests_equal_their_solo_replies(afd_fake, streams):
+    """The PR's six staggered requests on the AFD attention node (DFlash2 drafts, MTP off): each reply equals its
+    solo draft:false reply; one begin per forward, before it; batched windows of the segments' rows (<= 32);
+    prompt chunks flagged; no message ever shared (no rank 1)."""
+
+    torch = afd_fake.torch
+    n1 = World1(afd_fake, streams=streams)
+    admitted, pending = [], list(enumerate(CASES))
+    starts = {0: 0, 1: 2, 2: 3, 3: 7, 4: 11, 5: 12}
+    for it in range(4000):
+        while pending and it >= starts[pending[0][0]] and n1.d.live() < streams:
+            i, (prompt, count, kind, policy, draft) = pending.pop(0)
+            admitted.append((i, n1.submit(prompt, count, _sampling(kind, 100 + i), policy=policy, draft=draft)))
+        if not n1.d.lanes and not pending:
+            break
+        if n1.d.lanes:
+            n1.step()
+    assert not pending and not n1.d.lanes
+    for i, s in admitted:
+        prompt, count, kind, _, _ = CASES[i]
+        assert s.got == solo(torch, prompt, count, _sampling(kind, 100 + i)), i
+    assert n1.shared == [] and n1.d.world == 1
+    pairs = n1.wire.pairs()
+    batched = [r for k, r in pairs if k == "batched"]
+    assert [r for r, _ in n1.verify.windows] == batched
+    assert all(r == sum(rows) and r <= WINDOW for r, rows in n1.verify.windows)
+    assert any(len(rows) > 1 for _, rows in n1.verify.windows)              # streams shared a window
+    assert any(r > 8 for r in batched)                                      # past a solo window's rows
+    chunks = [r for k, r in pairs if k == "chunk"]
+    assert chunks and all(r <= n1.g.e.prefill_rows for r in chunks)
+    assert n1.d.drafts.proposed > 0 and any(s.accepted for _, s in admitted)
+
