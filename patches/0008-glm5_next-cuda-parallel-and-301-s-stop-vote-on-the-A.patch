+"""--parallel on the AFD attention node (the glue after ashhart/TensorFold#243) on CPU: world 1, the AFD
+wire's per-forward hook, no per-iteration messages, and every reply still its solo ``"draft": false`` reply.
+
+The model is tests/test_glm_multi.py's fake (logits that hash what each stream committed, read back from its pool rows
+and its slot), with its single-stream reference (``GlmEngine.generate(draft=False)`` on the same fake). New here:
+
+- one rank (world 1, ``afd.Solo``) runs ``multi.MultiDecoder`` alone: it sends no per-iteration message, and the
+  replies (staggered, in a burst through the threaded scheduler, greedy and sampled, cancelled, paused and given
+  back, resumed) equal their solo references;
+- the batched verify seam is the real ``verify.BatchedVerify.forward`` (its device work faked): one ``afd.begin(R)``
+  a round, before the forward, with R the window's rows (the streams' segments back to back, at most
+  32); prompt chunks (the real ``decode.prefill_chunk``) call ``afd.begin(R, chunk=True)`` before theirs;
+- no batched-window capture under AFD (and ``BatchedVerify.capture`` refuses there); TF_GLM_MULTI_DEPTH=joint and
+  TF_GLM_MULTI_LONE=1 are refused before the wire opens; --parallel reaches ``AfdEngine``; past 4 it is refused;
+- the world-1 estimate (an extra slot, the multi-stream drafter's rings, the kept states) at the real config;
+- the wire shapes of 7..32-row windows: the MCDMA layout fits the mailboxes the expert nodes already open, its request
+  header carries the rows, the expert node picks its scratch by rows, and ``settings_for`` is the same with and
+  without --parallel (current expert nodes accept this attention node).
+"""
+
+from __future__ import annotations
+
+import importlib
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+from tests.test_glm_multi import (  # noqa: F401
+    ALIGN,
+    CASES,
+    FakeMultiDrafter,
+    _prompt,
+    _sampling,
+    fake,
+    fake_commit,
+    fold,
+    shell,
+    solo,
+)
+
+pytestmark = pytest.mark.torch
+
+WINDOW = 32                               # multi.MAX_WINDOW: rows of every stream's windows together
+
+
+class WireLog:
+    """The attention side of the AFD wire as the forwards see it: ``begin`` per forward, then the forward itself."""
+
+    def __init__(self) -> None:
+        self.calls: list[tuple] = []
+
+    def begin(self, rows: int, *, chunk: bool = False) -> None:      # afd.AfdWire.begin's signature: eager only
+        self.calls.append(("begin", int(rows), bool(chunk)))
+
+    def forces_eager(self) -> bool:
+        return True
+
+    def forward(self, kind: str, rows: int) -> None:
+        self.calls.append((kind, int(rows)))
+
+    def pairs(self) -> list[tuple[str, int]]:
+        """Every forward right after its own ``begin`` of the same rows, ``chunk`` exactly for prompt chunks;
+        returns [(kind, rows)]."""
+
+        out = []
+        calls = list(self.calls)
+        assert len(calls) % 2 == 0, calls[-3:]
+        for b, f in zip(calls[::2], calls[1::2]):
+            assert b[0] == "begin" and f[0] in ("chunk", "batched"), (b, f)
+            assert b[1] == f[1], ("a forward of other rows than its header", b, f)
+            assert b[2] == (f[0] == "chunk"), ("chunk flag", b, f)
+            out.append((f[0], f[1]))
+        return out
+
+
+def _batched(e):
+    """``verify.BatchedVerify`` whose device work is the fake model's: its real ``forward`` (the AFD hook, the
+    segments' spans, the per-segment slices of logits and taps) over a compute that runs every segment's rows on its
+    own state, and a commit that keeps each segment's rows as the fake's single-stream commit does."""
+
+    from tensorfold.families.glm5_next.cuda.verify import BatchedVerify
+
+    class FakeBatched(BatchedVerify):
+        def __init__(self) -> None:          # no buffers, tables or kernels: forward's own logic only
+            self.e, self.w, self.rows_max, self.taps = e, e.w, WINDOW, True
+            self.b = SimpleNamespace(logits=None, taps=[], fnormed=None, rows=WINDOW, owner=self)
+            self.seg_rows = SimpleNamespace(set=lambda spans, sparse_from=None: None, any_sparse=lambda: False)
+            self.graphs, self.replays = {}, {"graph": 0, "eager": 0}
+            self.segments, self.R = [], 0
+            self.windows: list[tuple[int, list[int]]] = []
+
+        def _stage(self, tokens) -> None:
+            assert len(tokens) <= WINDOW
+
+        def _tables(self, segments, keeps=None) -> None:
+            pass
+
+        def commit(self, segments, keeps) -> None:
+            assert [id(s) for s in segments] == [id(s) for s in self.segments]
+            b = SimpleNamespace(prefill=False)
+            for seg, keep in zip(segments, keeps):
+                fake_commit(self.w, seg.st, b, len(seg.tokens), keep)
+            self.segments = []
+
+    verify = FakeBatched()
+    e.caches.index = None
+
+    def compute(w, st, b, R, *, mixer=None, **kw):
+        import torch
+
+        assert st is None and mixer is not None          # the batched window: no state of its own, a mixer
+        v = b.owner                                      # the BatchedVerify whose forward this is
+        w.afd.forward("batched", R)
+        out, taps = [], []
+        for seg in v.segments:                           # each segment on its own stream's state, as alone
+            s = seg.st
+            h = s.h()
+            for r, t in enumerate(seg.tokens):
+                q = s.pos + r
+                s.write(q, int(t))
+                h = fold(h, q, int(t))
+                out.append(s.logits(q, h))
+            s.slots.window[s.slot] = [int(t) for t in seg.tokens]
+            taps += [[s.pos + r, int(t)] for r, t in enumerate(seg.tokens)]
+        assert len(out) == R
+        b.taps = [torch.tensor(taps, dtype=torch.int64)]
+        b.fnormed = b.taps[0].clone()
+        b.logits = torch.stack(out)
+        v.windows.append((R, [len(x.tokens) for x in v.segments]))
+        return b.logits[:R]
+
+    return verify, compute
+
+
+@pytest.fixture
+def afd_fake(fake, monkeypatch):  # noqa: F811
+    """The PR's fake model, plus: prompt chunks logged on the wire and the batched seam's forward faked."""
+
+    torch = fake
+    decode = importlib.import_module("tensorfold.families.glm5_next.cuda.decode")
+    forward = importlib.import_module("tensorfold.families.glm5_next.cuda.forward")
+    chunk = decode.compute                               # the PR fixture's fake prompt chunk
+
+    def chunk_logged(w, st, b, R, **kw):
+        wire = getattr(w, "afd", None)                   # the solo reference's engine has no wire
+        if wire is not None:
+            wire.forward("chunk", R)
+        return chunk(w, st, b, R, **kw)
+
+    monkeypatch.setattr(decode, "compute", chunk_logged)
+    monkeypatch.setattr(forward, "check_room", lambda w, st, R: None)
+    return SimpleNamespace(torch=torch, forward=forward, monkeypatch=monkeypatch)
+
+
+class World1:
+    """The AFD attention node's decoder: one rank, ``afd.Solo`` (world 1), the AFD wire on its weights."""
+
+    def __init__(self, env, *, streams: int = 2, blocks: int = 8, batched: bool = True, **kw) -> None:
+        from tensorfold.families.glm5_next.cuda.afd import Solo
+        from tensorfold.families.glm5_next.cuda.multi import MultiDecoder
+        from tensorfold.families.glm5_next.cuda.verify import SerialVerify
+
+        torch = env.torch
+        self.torch = torch
+        g = self.g = shell(torch, 0, pool=blocks * ALIGN, streams=streams, **kw)
+        g.comm = Solo()
+        self.shared: list = []
+        g._share = lambda values: (self.shared.append(list(values)), list(values))[1]
+        self.wire = WireLog()
+        g.e.w.afd = self.wire
+        g.drafter = object()
+        drafts = FakeMultiDrafter(torch, streams, blocks * ALIGN)
+        if batched:
+            verify, compute = _batched(g.e)
+            env.monkeypatch.setattr(env.forward, "compute", compute)
+        else:
+            verify = SerialVerify(g.e, taps=True)
+        self.verify = verify
+        self.d = MultiDecoder(g, streams, drafts=drafts, verify=verify)
+        g.multi = self.d
+
+    def submit(self, prompt, count, sampling=None, *, policy: str = "f3", draft: bool = True, stop_eos: bool = True,
+               cancel_after: int | None = None):
+        from tensorfold.cuda.streams import Stream
+        from tensorfold.families.glm5_next.cuda.engine import encode_policy
+
+        s = Stream(list(prompt), count, sampling, draft=draft, stop_eos=stop_eos)
+        s.glm = {"code": self.g._effective(encode_policy(policy)), "spec": policy}
+        got: list[int] = []
+
+        def emit(new):
+            got.extend(new)
+            return cancel_after is not None and len(got) >= cancel_after
+
+        s.emit, s.got = emit, got
+        self.d.admit(s)
+        return s
+
+    def step(self) -> list:
+        done = self.d.round()
+        self.d.finish(done)
+        return done
+
+    def run(self, most: int = 5000) -> None:
+        for _ in range(most):
+            if not self.d.lanes:
+                return
+            self.step()
+        raise AssertionError("the streams did not finish")
+
