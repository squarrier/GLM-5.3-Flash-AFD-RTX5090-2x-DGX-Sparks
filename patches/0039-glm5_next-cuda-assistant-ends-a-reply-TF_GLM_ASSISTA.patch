@@ -0,0 +1,192 @@
+"""TF_GLM_ASSISTANT_ENDS (MiaAI-Lab recipe patch 0075; issue #60, reported by Lukas-tek-no-logic): GLM's
+``<|assistant|>`` role token ends a reply like the checkpoint's end tokens, on the CPU.
+
+At high reasoning effort the model sometimes wrote ``<|assistant|>`` inside its answer and began a second one, and the
+raw token reached the reply's text. With the switch on, ``weights.assistant_end`` reads the token's id from the
+checkpoint's tokenizer.json and ``Config.read`` adds it to ``Config.eos``, which every decode loop, the multi-stream
+decoder, the grammar and the server's text use; the startup comparison checks the ranks agree. Unset or 0 (this tree's
+default; the recipe's is 1): the checkpoint's end tokens only, as before. Covered: the token's lookup; ``Config.read``;
+the startup row and the refusal of ranks that differ; a reply through the single-stream engine and through two ranks'
+multi-stream decoders over tests/test_glm_multi.py's fake model, ending at the token with the switch on.
+"""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tests import test_glm_multi as tm
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+fake = tm.fake
+
+ENDS = [154820, 154827, 154829]            # GLM-5.3's <|endoftext|>, <|user|>, <|observation|>
+ASSISTANT = 154828                         # <|assistant|>
+
+
+@pytest.fixture(autouse=True)
+def _fresh_lookup():
+    """``assistant_end`` reads the switch once per checkpoint (``lru_cache``, as in the recipe): each test reads anew."""
+    from tensorfold.families.glm5_next.cuda.weights import assistant_end
+
+    assistant_end.cache_clear()
+    yield
+    assistant_end.cache_clear()
+
+
+def checkpoint(path, *, eos=ENDS, assistant=ASSISTANT, special=True, tokenizer=True):
+    """A GLM-5.3 checkpoint directory's config.json and tokenizer.json (no tensors: Config.read reads neither)."""
+
+    config = {"hidden_size": 64, "num_hidden_layers": 4, "layer_types": ["linear_attention", "full_attention"] * 2,
+              "vocab_size": 154880, "rms_norm_eps": 1e-5, "num_attention_heads": 4, "q_lora_rank": 32,
+              "kv_lora_rank": 16, "qk_nope_head_dim": 16, "qk_rope_head_dim": 8, "v_head_dim": 16,
+              "n_routed_experts": 8, "num_experts_per_tok": 2, "moe_intermediate_size": 32, "intermediate_size": 64,
+              "routed_scaling_factor": 2.5, "eos_token_id": list(eos), "max_position_embeddings": 8192}
+    (path / "config.json").write_text(json.dumps(config))
+    if tokenizer:
+        added = [{"id": e, "content": c, "special": True}
+                 for e, c in zip(ENDS, ("<|endoftext|>", "<|user|>", "<|observation|>"))]
+        added.append({"id": assistant, "content": "<|assistant|>", "special": special})
+        (path / "tokenizer.json").write_text(json.dumps({"added_tokens": added}))
+    return path
+
+
+def eos_of(path, monkeypatch, value):
+    from tensorfold.families.glm5_next.cuda.weights import Config, assistant_end
+
+    if value is None:
+        monkeypatch.delenv("TF_GLM_ASSISTANT_ENDS", raising=False)
+    else:
+        monkeypatch.setenv("TF_GLM_ASSISTANT_ENDS", value)
+    assistant_end.cache_clear()
+    return Config.read(path).eos
+
+
+def test_off_unless_set(tmp_path, monkeypatch):
+    """Unset and 0: the checkpoint's end tokens only (this tree's default); 1: <|assistant|> joins them, last."""
+    checkpoint(tmp_path)
+    assert eos_of(tmp_path, monkeypatch, None) == tuple(ENDS)
+    assert eos_of(tmp_path, monkeypatch, "") == tuple(ENDS)
+    assert eos_of(tmp_path, monkeypatch, "0") == tuple(ENDS)
+    assert eos_of(tmp_path, monkeypatch, "1") == tuple(ENDS) + (ASSISTANT,)
+    assert eos_of(tmp_path, monkeypatch, " 1 ") == tuple(ENDS) + (ASSISTANT,)
+
+
+@pytest.mark.parametrize("value", ["2", "yes", "on", "true"])
+def test_anything_else_is_refused(tmp_path, monkeypatch, value):
+    checkpoint(tmp_path)
+    with pytest.raises(ValueError, match="TF_GLM_ASSISTANT_ENDS: 0 or 1"):
+        eos_of(tmp_path, monkeypatch, value)
+
+
+def test_only_the_special_role_token_ends(tmp_path, monkeypatch):
+    """No tokenizer.json, an unreadable one, a plain-text ``<|assistant|>``, or an id already among the end tokens:
+    the end tokens stay as the checkpoint has them."""
+    from tensorfold.families.glm5_next.cuda.weights import assistant_end
+
+    for kw in ({"tokenizer": False}, {"special": False}):
+        d = tmp_path / json.dumps(kw).strip("{}").replace('"', "").replace(": ", "-")
+        d.mkdir()
+        assert eos_of(checkpoint(d, **kw), monkeypatch, "1") == tuple(ENDS)
+    bad = tmp_path / "bad"
+    bad.mkdir()
+    checkpoint(bad)
+    (bad / "tokenizer.json").write_text("{not json")
+    assert eos_of(bad, monkeypatch, "1") == tuple(ENDS)
+    has = tmp_path / "has"
+    has.mkdir()
+    assert eos_of(checkpoint(has, eos=ENDS + [ASSISTANT]), monkeypatch, "1") == tuple(ENDS) + (ASSISTANT,)
+    monkeypatch.setenv("TF_GLM_ASSISTANT_ENDS", "1")
+    assistant_end.cache_clear()
+    assert assistant_end(str(has)) == ASSISTANT
+
+
+def startup(tmp_path, monkeypatch, value, peer=None):
+    """GlmEngine's start on rank 0 up to the ranks' comparison (``_gather_ints``), with no device and no weights:
+    the row rank 0 sends, and (``peer``: the other rank's row) what the comparison does with it."""
+    torch = pytest.importorskip("torch")
+    from tensorfold.cuda import capacity
+    from tensorfold.families.glm5_next.cuda import engine, weights
+
+    class Sent(Exception):
+        pass
+
+    rows: list = []
+
+    def gather(self, values):
+        rows.append(list(values))
+        if peer is None:
+            raise Sent
+        return [list(values), list(peer)]
+
+    if value is None:
+        monkeypatch.delenv("TF_GLM_ASSISTANT_ENDS", raising=False)
+    else:
+        monkeypatch.setenv("TF_GLM_ASSISTANT_ENDS", value)
+    weights.assistant_end.cache_clear()
+    monkeypatch.setattr(torch.cuda, "set_device", lambda *a: None)
+    monkeypatch.setattr(capacity, "admit", lambda *a, **kw: {"context_window": 8192, "cache_slots": 4,
+                                                              "budget_bytes": 8 << 30,
+                                                              "total_bytes_estimate": 4 << 30})
+    monkeypatch.setattr(engine.GlmEngine, "_gather_ints", gather)
+    monkeypatch.setattr(weights, "load", lambda *a, **kw: pytest.fail("weights were loaded"))
+    comm = SimpleNamespace(barrier=lambda: None, ready=lambda *a, **kw: None)
+    with pytest.raises(Sent if peer is None else RuntimeError) as got:
+        engine.GlmEngine(tmp_path, rank=0, master="example", port=29551, comm=comm)
+    return rows[0], got.value
+
+
+@pytest.mark.torch
+def test_the_ranks_compare_their_end_tokens(tmp_path, allocations, monkeypatch):  # noqa: F811
+    """The start row carries the end tokens (their count and sum, as in the recipe): a rank with the switch on and
+    one with it off refuse to start, naming TF_GLM_ASSISTANT_ENDS; two alike start."""
+    checkpoint(tmp_path)
+    off, _ = startup(tmp_path, monkeypatch, None)
+    on, _ = startup(tmp_path, monkeypatch, "1")
+    assert len(off) == len(on)
+    differ = [i for i, (a, b) in enumerate(zip(off, on)) if a != b]
+    assert [(off[i], on[i]) for i in differ] == [(3, 4), (sum(ENDS), sum(ENDS) + ASSISTANT)]
+    _, refused = startup(tmp_path, monkeypatch, "1", peer=off)
+    assert "different settings" in str(refused) and "TF_GLM_ASSISTANT_ENDS" in str(refused)
+
+
+PLAIN_SHELL = tm.shell
+
+
+def _with_eos(monkeypatch, eos):
+    """tests/test_glm_multi.py's shells with ``eos`` as their checkpoint's end tokens (``Config.eos``)."""
+
+    def shell(*a, **kw):
+        g = PLAIN_SHELL(*a, **kw)
+        g.e.w.cfg.eos = g.eos = tuple(eos)
+        return g
+
+    monkeypatch.setattr(tm, "shell", shell)
+
+
+@pytest.mark.torch
+def test_a_reply_ends_at_the_role_token(tmp_path, fake, monkeypatch):
+    """The fake model's reply to a prompt, with one of its tokens standing for <|assistant|> in the checkpoint's
+    tokenizer: off, the reply runs past it, as before; on, it ends there, through the single-stream engine and two
+    ranks' multi-stream decoders alike (the token is the reply's last, as the checkpoint's end tokens are)."""
+    torch = fake
+    prompt, count = tm._prompt(80, 31), 48
+    plain = tm.solo(torch, prompt, count, None, stop_eos=True)
+    k = next(i for i in range(4, len(plain)) if plain[i] not in plain[:i] and plain[i] != tm.EOS)
+    assert k + 1 < len(plain)                      # the reply runs on past the token without the switch
+    role = plain[k]
+    checkpoint(tmp_path, eos=[tm.EOS], assistant=role)
+    for value, want in ((None, plain), ("1", plain[:k + 1])):
+        eos = eos_of(tmp_path, monkeypatch, value)
+        assert eos == ((tm.EOS,) if value is None else (tm.EOS, role))
+        _with_eos(monkeypatch, eos)
+        assert tm.solo(torch, prompt, count, None) == want
+        p = tm.Pair(torch, streams=2, blocks=4)
+        s = p.submit(prompt, count, None)
+        other = p.submit(tm._prompt(60, 32), 20, tm._sampling("topk", 3), stop_eos=False)
+        p.run()
+        assert s.got == want
+        assert other.got == tm.solo(torch, other.prompt, 20, tm._sampling("topk", 3), stop_eos=False)
+        p.check()
