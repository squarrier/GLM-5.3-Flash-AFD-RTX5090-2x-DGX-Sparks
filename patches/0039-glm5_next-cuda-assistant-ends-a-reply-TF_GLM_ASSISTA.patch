 from pathlib import Path
 from typing import Any
 
@@ -19,6 +21,28 @@ from .qmm import (B16, F8, Q4, as_i32, dense_kind, make_b16, make_dense_q4, make
 PREFIX = "model.language_model."
 
 
+@lru_cache(maxsize=None)  # noqa: UP033  (recipe patch 0075's line, verbatim)
+def assistant_end(model_dir: str) -> int | None:
+    """The id of GLM's ``<|assistant|>`` role token when it ends a reply (TF_GLM_ASSISTANT_ENDS=1; unset or 0: it
+    doesn't), or None without one in the checkpoint's tokenizer. The checkpoint's end tokens are ``<|endoftext|>``,
+    ``<|user|>`` and ``<|observation|>``; at high reasoning effort the model sometimes writes ``<|assistant|>``
+    inside its answer and starts a second one, which reached the client with the token in its text (issue #60). A new
+    assistant turn inside an assistant turn ends it: the reply stops there, as at the other role tokens. (MiaAI-Lab
+    recipe patch 0075, reported by Lukas-tek-no-logic; the recipe's default is 1, this tree's 0)"""
+
+    on = (os.environ.get("TF_GLM_ASSISTANT_ENDS", "") or "0").strip()
+    if on not in ("0", "1"):
+        raise ValueError(f"TF_GLM_ASSISTANT_ENDS: 0 or 1, not {on!r}")
+    path = Path(model_dir) / "tokenizer.json"
+    if on == "0" or not path.is_file():
+        return None
+    try:
+        added = json.loads(path.read_text()).get("added_tokens", [])
+    except (OSError, ValueError):
+        return None
+    return next((int(t["id"]) for t in added if t.get("content") == "<|assistant|>" and t.get("special")), None)
+
+
 def bits_of(quant: dict) -> int:
     """The checkpoint's one bit width; a mixed-bit encode (bits such as "mixed_k34_per_tensor") is refused by name."""
 
