+"""A CPU reference of glm53f-afd's large-M expert arithmetic as g53_rank.cu runs it (TF_GLM_EXPERT_KERNEL=g53; expert
+prompt kernels from glm53f-afd, written by Hugh Madden (@dangerm00se, github.com/hughmadden), glm53f-afd @ 91db3cc,
+MIT, Copyright (c) 2026 Turquoise Bay AI Pty Ltd): the documented math, shared by tests/test_glm_g53_kernel.py (CPU)
+and tests/cuda/test_glm_g53_kernel.py (GPU).
+
+Per row and routed slot s (expert e, weight w), one TP2 half (gate/up 4096 -> 1024 channels, down 1024 -> 4096):
+1. rotation, once a row (a layer whose experts share one gate/up suh; else the same values per (row, matrix)): per
+   128-block, x (BF16 widened to FP32) * suh in FP32, fwht128 (the kernels' lane butterfly, FP32), * 1/sqrt(128) in
+   FP32, rounded to FP16;
+2. gate and up: Z = X_h @ W_q (FP16 x FP16 products, FP32 sums; one K split: one MMA chain over ascending k tiles);
+3. epilogue, per 128-block: (0 + Z) (the splits in order), fwht128, * 1/sqrt(128) then * svh in FP32, the reference
+   model's BF16 SwiGLU (gate min(bf16(g), limit), up clamp(bf16(u), +-limit), bf16(bf16(silu(g)) * u)), * down suh,
+   fwht128, * 1/sqrt(128), FP16: X_d;
+4. down: Z_d = X_d @ W_q(down) (FP32 sums, one K split);
+5. reduce, per 128-block, slots in order 0..7: acc = acc + w * ((fwht128(0 + Z_d) * 1/sqrt(128)) * svh_d), FP32, each
+   multiply and add rounded on its own (built with --fmad=false). The half's row is acc (FP32).
+Steps 1, 3 and 5 are emulated here bit for bit (IEEE float32 / float16 / bfloat16 roundings in the same order; expf is
+the CPU's, which may differ from CUDA's in the last place); the matrix products are exact float64 sums rounded once to
+float32 (the MMA chain's order is the hardware's). ``exact=True`` runs everything in float64 with no rounding, for the
+dense-math check.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+
+H, WID, E, TOPK, HAD = 4096, 1024, 288, 8, 128
+HAD_SCALE = np.float32(1.0 / np.sqrt(128.0))     # 1 / sqrt(128) as float32, the kernels' HAD_SCALE constant
+
+# glm53f-rank's layer image layout at the two-rank width (G53R_WID 1,024), byte offsets in
+# an expert's block: the GPU test builds glm53f-rank's own image from the same tensors with it.
+TRELLIS = H * WID // 2
+OFF_GATE_T, OFF_UP_T, OFF_DOWN_T = 0, TRELLIS, 2 * TRELLIS
+OFF_SUH_G = 3 * TRELLIS
+OFF_SUH_U = OFF_SUH_G + 2 * H
+OFF_SVH_G = OFF_SUH_U + 2 * H
+OFF_SVH_U = OFF_SVH_G + 2 * WID
+OFF_SUH_D = OFF_SVH_U + 2 * WID
+OFF_SVH_D = OFF_SUH_D + 2 * WID
+EXPERT_BYTES = OFF_SVH_D + 2 * H                 # 6,322,176 (exl3_rank.cu's static_assert for TP2)
+
+
+def fwht128(v: np.ndarray) -> np.ndarray:
+    """The kernels' fwht128 on [..., 128] in float32, op for op: lane L holds values 4L..4L+3; strides 1 and 2 in
+    registers, then 4..64 across lanes (lane & m: o - v, else v + o)."""
+
+    v = np.asarray(v, dtype=np.float32)
+    shape = v.shape
+    v = v.reshape(*shape[:-1], 32, 4)
+    a, b = v[..., 0] + v[..., 1], v[..., 0] - v[..., 1]
+    c, d = v[..., 2] + v[..., 3], v[..., 2] - v[..., 3]
+    v = np.stack([a + c, b + d, a - c, b - d], axis=-1)
+    lane = np.arange(32)
+    for m in (1, 2, 4, 8, 16):
+        o = v[..., lane ^ m, :]
+        v = np.where(((lane & m) != 0)[:, None], o - v, v + o)
+    return v.reshape(shape).astype(np.float32)
+
+
+def blocks(f, v: np.ndarray) -> np.ndarray:
+    """``f`` on every 128-block of the last axis."""
+
+    shape = v.shape
+    return f(v.reshape(*shape[:-1], shape[-1] // HAD, HAD)).reshape(shape)
+
+
+def bf16r(x: np.ndarray) -> np.ndarray:
+    """float32 -> bfloat16 (round to nearest even) -> float32, as __float2bfloat16_rn (finite values)."""
+
+    u = np.asarray(x, dtype=np.float32).view(np.uint32).astype(np.uint64)
+    u = (u + 0x7FFF + ((u >> 16) & 1)) & 0xFFFF0000
+    return u.astype(np.uint32).view(np.float32)
+
+
+def e4m3(code: np.ndarray) -> np.ndarray:
+    """E4M3 (FN) codes to float32, exactly (glm53f-rank's e4m3; NaN codes are the caller's to avoid)."""
+
+    c = np.asarray(code, dtype=np.uint32)
+    e, m = (c >> 3) & 0xF, c & 7
+    mag = np.where(e > 0, np.ldexp(1.0 + m / 8.0, e.astype(np.int64) - 7), m * 2.0 ** -9)
+    return np.where(c & 0x80, -mag, mag).astype(np.float32)
+
+
+def fp8_rows(rows: int, rng: np.random.Generator, std: float = 1.0) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """(codes uint8 [rows, H], UE8M0 scale bytes uint8 [rows, H / 32], values float32 [rows, H]): normal rows
+    quantized as the wire's FP8 rows (a UE8M0 scale 2^ceil(log2(amax / 448)) a 32-value block, E4M3 codes rounded to
+    nearest even), whose values (code * 2^(byte - 127)) are exactly BF16 values: glm53f-rank (FP8 rows in) and the
+    port (BF16 rows in) then see the same numbers. No NaN code."""
+
+    import torch
+
+    x = (rng.standard_normal((rows, H)) * std).astype(np.float32).reshape(rows, H // 32, 32)
+    amax = np.maximum(np.abs(x).max(-1), np.float32(2.0 ** -100))
+    e = np.ceil(np.log2(amax / 448.0)).astype(np.int64)
+    q = (x * np.ldexp(1.0, -e)[..., None]).astype(np.float32)                    # |q| <= 448, exact
+    codes = torch.from_numpy(q.reshape(rows, H)).to(torch.float8_e4m3fn).view(torch.uint8).numpy().copy()
+    scales = (e + 127).astype(np.uint8)
+    vals = e4m3(codes) * np.ldexp(1.0, e).repeat(32, axis=1).astype(np.float32)
+    return codes, scales, vals.astype(np.float32)
+
+
+def plan(pick8: np.ndarray, gr: int) -> tuple[list[tuple[int, int, int]], np.ndarray, np.ndarray, np.ndarray]:
+    """glm53f-rank's plan: (groups [(expert, start, count)], pair_row, pair_route, inverse). Pairs of expert e occupy
+    [base[e], base[e] + cnt[e]) in ascending expert order, cut into groups of at most ``gr``; within an expert the
+    kernel's order follows its atomics (here: route order), which cannot change a value."""
+
+    ids = np.asarray(pick8, dtype=np.int64)[:, :TOPK].reshape(-1)
+    routes = ids.size
+    cnt = np.bincount(ids, minlength=E)
+    base = np.concatenate([[0], np.cumsum(cnt)[:-1]])
+    order = np.argsort(ids, kind="stable")               # route order within an expert
+    pair_route = order.astype(np.int64)
+    pair_row = pair_route // TOPK
+    inverse = np.empty(routes, dtype=np.int64)
+    inverse[pair_route] = np.arange(routes)
+    groups = [(e, int(base[e]) + k * gr, int(min(gr, cnt[e] - k * gr)))
+              for e in range(E) for k in range((int(cnt[e]) + gr - 1) // gr)]
+    return groups, pair_row, pair_route, inverse
+
+
+def max_groups(rows: int, gr: int) -> int:
+    """glm53f-rank's bound: routes / gr full groups plus one partial group a distinct expert, at most the routes."""
+
+    routes = rows * TOPK
+    return min(routes, routes // gr + min(routes, E))
+
+
+def rotate(x: np.ndarray, suh: np.ndarray, *, exact: bool = False) -> np.ndarray:
+    """Step 1: X_h [R, K] (FP16 values as float32, or float64 when ``exact``) from rows x [R, K] and suh [K]."""
+
+    if exact:
+        from tensorfold.cuda.exl3 import format as fmt
+
+        return fmt.rotate(np.asarray(x, np.float64) * np.asarray(suh, np.float64), -1)
+    v = np.asarray(x, np.float32) * np.asarray(suh, np.float16).astype(np.float32)
+    v = blocks(fwht128, v) * HAD_SCALE
+    return v.astype(np.float16).astype(np.float32)
+
+
+def matmul(a: np.ndarray, w: np.ndarray, *, exact: bool = False) -> np.ndarray:
+    """Steps 2 and 4: a @ w with exact float64 sums, rounded once to float32 (float64 kept when ``exact``)."""
+
+    out = np.asarray(a, np.float64) @ np.asarray(w, np.float64)
+    return out if exact else out.astype(np.float32)
+
+
+def epilogue(zg: np.ndarray, zu: np.ndarray, svh_g, svh_u, suh_d, limit: float = 10.0, *, bf16: bool = True,
+             exact: bool = False) -> np.ndarray:
+    """Step 3: X_d [P, N] from one split's gate and up sums [P, N] and the pair's svh_g, svh_u, suh_d [P or 1, N]."""
+
+    if exact:
+        from tensorfold.cuda.exl3 import format as fmt
+
+        gg = fmt.rotate(np.asarray(zg, np.float64), -1) * np.asarray(svh_g, np.float64)
+        uu = fmt.rotate(np.asarray(zu, np.float64), -1) * np.asarray(svh_u, np.float64)
+        gg, uu = np.minimum(gg, limit), np.clip(uu, -limit, limit)
+        act = gg / (1.0 + np.exp(-gg)) * uu
+        return fmt.rotate(act * np.asarray(suh_d, np.float64), -1)
+    f32 = np.float32
+    lim = f32(limit)
+    gv = blocks(fwht128, f32(0) + np.asarray(zg, f32))
+    uv = blocks(fwht128, f32(0) + np.asarray(zu, f32))
+    gg = (gv * HAD_SCALE) * np.asarray(svh_g, np.float16).astype(f32)
+    uu = (uv * HAD_SCALE) * np.asarray(svh_u, np.float16).astype(f32)
+    with np.errstate(over="ignore"):
+        if bf16:
+            gg = np.minimum(bf16r(gg), lim)
+            uu = np.minimum(np.maximum(bf16r(uu), -lim), lim)
+            act = bf16r(bf16r(gg / (f32(1) + np.exp(-gg))) * uu)
+        else:
+            gg = np.minimum(gg, lim)
+            uu = np.minimum(np.maximum(uu, -lim), lim)
+            act = gg / (f32(1) + np.exp(-gg)) * uu
+    v = act.astype(f32) * np.asarray(suh_d, np.float16).astype(f32)
+    v = blocks(fwht128, v) * HAD_SCALE
+    return v.astype(np.float16).astype(f32)
+
+
+def reduce(zd: np.ndarray, svh_d: np.ndarray, w: np.ndarray, *, exact: bool = False) -> np.ndarray:
+    """Step 5: one row's [H] from its 8 slots' down sums zd [8, H], their svh_d [8, H] and weights w [8]."""
+
+    if exact:
+        from tensorfold.cuda.exl3 import format as fmt
+
+        y = fmt.rotate(np.asarray(zd, np.float64), -1) * np.asarray(svh_d, np.float64)
+        return (np.asarray(w, np.float64)[:, None] * y).sum(0)
+    f32 = np.float32
+    acc = np.zeros(zd.shape[-1], dtype=f32)
+    for s in range(zd.shape[0]):
+        v = blocks(fwht128, f32(0) + np.asarray(zd[s], f32))
+        t = (v * HAD_SCALE) * np.asarray(svh_d[s], np.float16).astype(f32)
+        acc = acc + f32(w[s]) * t
+    return acc
+
+
+def ffn(x: np.ndarray, pick8: np.ndarray, w8: np.ndarray, layer: dict, limit: float = 10.0, *, bf16: bool = True,
+        exact: bool = False, rowrot: bool = True) -> np.ndarray:
+    """The half's rows [R, H] (float32; float64 when ``exact``) for rows x [R, H] (BF16 values), routes pick8 / w8
+    [R, 8], and ``layer``: per expert id, a dict of numpy arrays: wg, wu [H, N] and wd [N, H] (W_q, decoded), suh_g,
+    suh_u [H], svh_g, svh_u, suh_d [N], svh_d [H]. ``rowrot``: one rotation a row with expert pick8[0, 0]'s gate suh
+    (the layer's shared vector; the per-(row, matrix) rotation gives the same values when the vectors are equal)."""
+
+    R = x.shape[0]
+    out = np.zeros((R, x.shape[1]), dtype=np.float64 if exact else np.float32)
+    for r in range(R):
+        zd, svh, ws = [], [], []
+        for s in range(TOPK):
+            L = layer[int(pick8[r, s])]
+            xg = rotate(x[r:r + 1], L["suh_g"], exact=exact)
+            xu = xg if rowrot else rotate(x[r:r + 1], L["suh_u"], exact=exact)
+            zg, zu = matmul(xg, L["wg"], exact=exact), matmul(xu, L["wu"], exact=exact)
+            xd = epilogue(zg, zu, L["svh_g"], L["svh_u"], L["suh_d"], limit, bf16=bf16, exact=exact)
+            zd.append(matmul(xd, L["wd"], exact=exact)[0])
+            svh.append(L["svh_d"])
+            ws.append(w8[r, s])
+        out[r] = reduce(np.stack(zd), np.stack(svh), np.asarray(ws, np.float32 if not exact else np.float64),
+                        exact=exact)
+    return out
+
+
+def dense(x: np.ndarray, pick8: np.ndarray, w8: np.ndarray, weights: dict, limit: float = 10.0) -> np.ndarray:
+    """The same half's rows in float64 from the dense weights W = diag(suh) H W_q H diag(svh) (``weights``: per expert
+    id, gate, up [H, N], down [N, H] from tensorfold.cuda.exl3.format.dequantize) and an FP32-free SwiGLU."""
+
+    out = np.zeros(x.shape, dtype=np.float64)
+    for r in range(x.shape[0]):
+        for s in range(TOPK):
+            Wg, Wu, Wd = weights[int(pick8[r, s])]
+            g = np.minimum(x[r].astype(np.float64) @ Wg, limit)
+            u = np.clip(x[r].astype(np.float64) @ Wu, -limit, limit)
+            out[r] += float(w8[r, s]) * ((g / (1.0 + np.exp(-g)) * u) @ Wd)
+    return out
+
+
+def rank_image(gate: list, up: list, down: list, suh_g, suh_u, svh_g, svh_u, suh_d, svh_d) -> np.ndarray:
+    """glm53f-rank's two-rank layer image (uint8 [E * EXPERT_BYTES]) from the same per-expert tensors as numpy arrays:
+    trellis int16 gate / up [256, 64, 64], down [64, 256, 64]; fp16 suh_g, suh_u, svh_d [E, H], svh_g, svh_u, suh_d
+    [E, WID]. The trellis bytes are copied as they are (the slicer's tile columns / rows of the checkpoint)."""
+
+    n = len(gate)
+    img = np.zeros(n * EXPERT_BYTES, dtype=np.uint8)
+    for e in range(n):
+        b = img[e * EXPERT_BYTES:(e + 1) * EXPERT_BYTES]
+        for off, t, size in ((OFF_GATE_T, gate[e], TRELLIS), (OFF_UP_T, up[e], TRELLIS), (OFF_DOWN_T, down[e], TRELLIS),
+                             (OFF_SUH_G, suh_g[e], 2 * H), (OFF_SUH_U, suh_u[e], 2 * H),
+                             (OFF_SVH_G, svh_g[e], 2 * WID), (OFF_SVH_U, svh_u[e], 2 * WID),
+                             (OFF_SUH_D, suh_d[e], 2 * WID), (OFF_SVH_D, svh_d[e], 2 * H)):
+            raw = np.ascontiguousarray(t).view(np.uint8).reshape(-1)
+            if raw.size != size:
+                raise ValueError(f"expert {e}: a part of {raw.size} bytes where the layout has {size}")
+            b[off:off + size] = raw
+    return img
