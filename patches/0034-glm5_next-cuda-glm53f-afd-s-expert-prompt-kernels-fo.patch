+# ------------------------------------------------------------------------------------------------- the expert node
+
+def test_expert_node_takes_prompt_chunks_only(layer, capsys):
+    from tensorfold.families.glm5_next.cuda import g53_experts
+    from tensorfold.families.glm5_next.cuda.experts_node import ExpertBuffers, ExpertNode
+
+    _, ex = layer
+    node = ExpertNode.__new__(ExpertNode)
+    node.cfg = SimpleNamespace(hidden=D, top_k=TOPK, moe_width=2 * NI, experts=E, limit=LIMIT)
+    node.half, node.layers, node.experts, node.by_layer = 0, [LAYER], [ex], {LAYER: ex}
+    node.buf = ExpertBuffers(node.cfg, rows=8, prefill_rows=2048)
+    node.g53 = g53_experts.Node(node, {"min_rows": 65, "rowrot": True, "order": False})
+    assert "TF_GLM_EXPERT_KERNEL=g53" in capsys.readouterr().out
+    assert node.g53.scratch.share is node.buf.pref
+    for R in (64, 65, 2048):
+        inp = _inputs(R, "skewed", 41 + R)
+        x = (inp.x, inp.pick, inp.wts)
+        node.prompt = True
+        got = node.compute(LAYER, R, x).clone()
+        node.prompt = False
+        dec = node.compute(LAYER, R, x).clone()
+        torch.cuda.synchronize()
+        tf = _tf(ex, inp, R)
+        assert _bits_equal(dec, tf)                                         # a decode window: TensorFold's bits
+        if R >= 65:
+            assert _bits_equal(got, _ours(ex, inp, _cfg(R)))                 # a prompt chunk: the kernels'
+        else:
+            assert _bits_equal(got, tf)                                     # under the threshold: as before
+
