+    out = torch.empty((128, D), dtype=torch.float32, device="cuda")
+    wide = torch.zeros((128, D + 2), dtype=torch.bfloat16, device="cuda")[:, 1:D + 1]   # a 2-byte aligned start
+    for args, what in (((inp.x.float(), inp.pick, inp.wts), "x"), ((wide, inp.pick, inp.wts), "x"),
+                       ((inp.x, inp.pick.long(), inp.wts), "pick"), ((inp.x, inp.pick[:, :7], inp.wts), "pick")):
+        with pytest.raises(RuntimeError, match=what):
