@@ -0,0 +1,254 @@
+"""glm53f-afd's large-M expert kernels for the AFD expert node's prompt chunks (TF_GLM_EXPERT_KERNEL=g53).
+
+Expert prompt kernels from glm53f-afd, written by Hugh Madden (@dangerm00se, github.com/hughmadden), glm53f-afd @
+91db3cc (https://github.com/hughmadden/glm53f-afd, MIT License, Copyright (c) 2026 Turquoise Bay AI Pty Ltd): the
+plan, the large-M gate/up and down kernels, the fused epilogue and reduce of crates/glm53f-rank/kernels/exl3_rank.cu,
+at the two-rank (TP2) width, with its once-a-row rotation and its group order, ported in g53_rank.cu onto this node's
+resident TP2 half. That file's EXL3 decoder, fragment MMA and Hadamard butterfly come from TensorFold by Ash Hart
+(@ashxhart, github.com/ashhart; TensorFold @ bb4b4a3, MIT); its TP split follows glmrt by T.J. Purtell
+(@wrldsuksgo2mars, github.com/tpurtell); its row rotation was reimplemented from MiaAI-Lab's TensorFold recipe patch
+0009 (ROWROT/SHX). See g53_rank.cu's header and THIRD_PARTY_NOTICES.md.
+
+The switch, on the expert containers: TF_GLM_EXPERT_KERNEL unset, empty or ``tf``: TensorFold's kernels, every call as
+before. ``g53``: a prompt chunk's window (the node's MODE_CHUNK, MODE_SLICE and MODE_PAIR forwards) of at least
+TF_GLM_EXPERT_KERNEL_ROWS rows (default 65: glm53f-rank's own large-M boundary; at most 4,096, its row cap) on a layer
+in the kernels' scope (4-bit mcg, the TP2 half of GLM-5.3-Flash's 288 experts) runs through these kernels: BF16 rows
+in, the half's FP32 rows out (glm53f-rank's g53r_ffn_f32), written straight into the node's reply buffer. Decode
+windows (MODE_EAGER, batched or not) and anything out of scope stay on TensorFold's kernels. Anything else refuses at
+the node's start, before the load.
+
+Bits: outputs class. A prompt row's routed-expert sum then has glm53f-rank's arithmetic (one K split each, sk 1 and
+skd 1: one FP32 MMA chain a sum over ascending k tiles; its fused epilogue; the 8 slots reduced in slot order as
+acc + w * (y * 1/sqrt(128) * svh), built with --fmad=false), not the grouped kernel's split-K sums and combine. The
+rotation and order schedules keep every bit (glm53f-rank's own statement). It never becomes a default by itself.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+ENV = "TF_GLM_EXPERT_KERNEL"
+ROWS_ENV = "TF_GLM_EXPERT_KERNEL_ROWS"
+ROWROT_ENV = "TF_GLM_EXPERT_KERNEL_ROWROT"   # glm53f-rank's GLM53F_RANK_ROWROT (rot 2): on by default, as served
+ORDER_ENV = "TF_GLM_EXPERT_KERNEL_ORDER"     # glm53f-rank's GLM53F_RANK_ORDER (gord 2): off by default, as served
+LARGE_M = 65             # glm53f-rank runs its large-M kernels above 64 rows (g53r_default_cfg)
+MAX_ROWS = 4096          # glm53f-rank's MAX_ROWS (a wire lane's cap)
+H, WID, E, TOPK = 4096, 1024, 288, 8
+NVCC = ["-O3", "--fmad=false", "--ftz=false", "--prec-div=true"]   # glm53f-rank's build.rs flags (arch from build)
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_glm_g53_v1", sources=[str(here / "g53_rank.cpp"), str(here / "g53_rank.cu")],
+                extra_cuda_cflags=list(NVCC), extra_include_paths=[str(here)], verbose=False)
+
+
+@dataclass(frozen=True)
+class Cfg:
+    """glm53f-rank's g53r_cfg fields for its large-M kernels (only sk, skd and swiglu change a bit)."""
+
+    mt: int        # 16-row tiles a group: 2 (32-row groups) or 4 (64)
+    sk: int        # gate/up K splits
+    skd: int       # down K splits
+    nt: int        # down: 16-column tiles a warp (1, 2, 4)
+    gw: int        # gate/up MMA warps a block (8, 16)
+    l2: int        # 2: trellis words loaded evict-first
+    fuse: int      # 2: the epilogue and the reduce fused into gate/up and down
+    discard: int   # 2: consumed partial sums dropped from L2 (fused only)
+    swiglu: int    # 0: the reference model's BF16 roundings, 1: FP32
+    rot: int       # 2: every row rotated once (a layer whose experts share one gate/up suh)
+    gord: int      # 2: the group order (single- and multi-group experts interleaved)
+
+
+def default_cfg(rows: int, *, rowrot: bool = True, order: bool = False) -> Cfg:
+    """glm53f-rank's g53r_default_cfg for its large-M regimes: up to 2,048 rows {mt 2, sk 1, skd 1, nt 2, gw 8, l2 2},
+    above {mt 4, sk 1, skd 1, nt 4, gw 16, l2 1}, both fused with discard and BF16 SwiGLU; rot 2 when ``rowrot`` (its
+    serving GLM53F_RANK_ROWROT=1), gord 2 when ``order`` (GLM53F_RANK_ORDER, off where it is served)."""
+
+    if not LARGE_M <= rows <= MAX_ROWS:
+        raise ValueError(f"the large-M kernels take {LARGE_M}..{MAX_ROWS} rows, not {rows}")
+    rot, gord = (2 if rowrot else 1), (2 if order else 1)
+    if rows <= 2048:
+        return Cfg(mt=2, sk=1, skd=1, nt=2, gw=8, l2=2, fuse=2, discard=2, swiglu=0, rot=rot, gord=gord)
+    return Cfg(mt=4, sk=1, skd=1, nt=4, gw=16, l2=1, fuse=2, discard=2, swiglu=0, rot=rot, gord=gord)
+
+
+def _flag(name: str, default: bool) -> bool:
+    v = os.environ.get(name, "").strip()
+    if v == "":
+        return default
+    if v not in ("0", "1"):
+        raise ValueError(f"{name} is 1 (on) or 0 (off), not {v!r}")
+    return v == "1"
+
+
+def switch() -> dict | None:
+    """TF_GLM_EXPERT_KERNEL, read once at the node's start: None (unset, empty or ``tf``: TensorFold's kernels) or the
+    settings of ``g53``: min_rows (TF_GLM_EXPERT_KERNEL_ROWS, 65..4,096, default 65), rowrot
+    (TF_GLM_EXPERT_KERNEL_ROWROT, default 1) and order (TF_GLM_EXPERT_KERNEL_ORDER, default 0). Bad values refuse."""
+
+    v = os.environ.get(ENV, "").strip().lower()
+    if v in ("", "tf"):
+        return None
+    if v != "g53":
+        raise ValueError(f"{ENV} is g53 (glm53f-afd's expert kernels for prompt chunks) or tf (TensorFold's; the "
+                         f"default), not {v!r}")
+    r = os.environ.get(ROWS_ENV, "").strip() or str(LARGE_M)
+    try:
+        rows = int(r)
+    except ValueError:
+        raise ValueError(f"{ROWS_ENV} is a row count, not {r!r}") from None
+    if not LARGE_M <= rows <= MAX_ROWS:
+        raise ValueError(f"{ROWS_ENV}: {LARGE_M}..{MAX_ROWS} (the large-M kernels' rows), not {rows}")
+    return {"min_rows": rows, "rowrot": _flag(ROWROT_ENV, True), "order": _flag(ORDER_ENV, False)}
+
+
+def layer_ready(ex) -> str | None:
+    """Why a layer (``Exl3RoutedExperts``) cannot take the kernels, or None: 4-bit mcg trellises for gate, up and down,
+    GLM-5.3-Flash's 288 experts of width 4,096, this TP2 half's 1,024 channels, 4-byte aligned trellises, and
+    contiguous fp16 scale vectors."""
+
+    from tensorfold.cuda.exl3 import experts as generic
+
+    if not isinstance(ex, generic.Exl3RoutedExperts):
+        return "not an EXL3 routed-experts layer"
+    if ex.cb != generic.CB_MCG:
+        return "codebook is not mcg"
+    if tuple(ex.k2_gu) != (8, 8) or tuple(ex.k2_d) != (8, 8):
+        return "not 4 bits a weight"
+    if (ex.count, ex.dims, ex.width) != (E, H, WID):
+        return f"shape {ex.count} experts x {ex.dims} -> {ex.width}, not {E} x {H} -> {WID}"
+    if any(t.data_ptr() % 4 for t in ex.keep):
+        return "a trellis is not 4-byte aligned"
+    for name, n in (("suh_g", H), ("suh_u", H), ("svh_d", H), ("svh_g", WID), ("svh_u", WID), ("suh_d", WID)):
+        t = getattr(ex, name)
+        if t.dtype != torch.float16 or not t.is_contiguous() or tuple(t.shape) != (E, n) or t.data_ptr() % 8:
+            return f"{name} is not a contiguous, 8-byte aligned fp16 [{E}, {n}]"
+    return None
+
+
+def max_groups(rows: int, mt: int = 2) -> int:
+    """glm53f-rank's bound on a call's groups: routes / (16 mt) full groups plus one partial group a distinct expert,
+    never more than the routes (32-row groups, mt 2, bound the 64-row ones)."""
+
+    routes, gr = rows * TOPK, 16 * mt
+    return min(routes, routes // gr + min(routes, E))
+
+
+class Scratch:
+    """The plan's buffers for up to ``rows`` rows (the arrival counters zero between calls), and the large buffers:
+    views of ``share`` (the node's prompt scratch, ``Exl3Scratch``: gate/up sums in its z, down sums in its y, down
+    inputs in its xd, rotated rows in its xg; no other user while a call of these kernels runs) when it is large
+    enough, else owned."""
+
+    def __init__(self, rows: int, device, share=None) -> None:
+        if not 1 <= rows <= MAX_ROWS:
+            raise ValueError(f"scratch rows: 1..{MAX_ROWS}, not {rows}")
+        P, G = rows * TOPK, max_groups(rows)
+        i32 = {"dtype": torch.int32, "device": device}
+        self.rows = rows
+        self.groups = torch.zeros((4 * G,), **i32)
+        self.meta = torch.zeros((4,), **i32)
+        self.pair_row = torch.zeros((P,), **i32)
+        self.pair_route = torch.zeros((P,), **i32)
+        self.inverse = torch.zeros((P,), **i32)
+        self.gcnt = torch.zeros((G,), **i32)
+        self.rcnt = torch.zeros((rows * 32,), **i32)
+        self.gorder = torch.zeros((G,), **i32)
+        self.share, self._own = share, None
+        self.device = device
+
+    def big(self, R: int, cfg: Cfg):
+        """(z, xd, zd, xh) for R rows at ``cfg``'s K splits: views of the shared prompt scratch, else owned."""
+
+        P = R * TOPK
+        nz, nd, nxd, nxh = 2 * cfg.sk * P * WID, cfg.skd * P * H, P * WID, R * H
+        s = self.share
+        if s is not None and all(hasattr(s, a) for a in ("z", "y", "xd", "xg")):
+            z, y, xd, xg = s.z.view(-1), s.y.view(-1), s.xd.view(-1), s.xg.view(-1)
+            if (z.dtype == y.dtype == torch.float32 and xd.dtype == xg.dtype == torch.float16
+                    and z.numel() >= nz and y.numel() >= nd and xd.numel() >= nxd and xg.numel() >= nxh):
+                return z[:nz], xd[:nxd], y[:nd], xg[:nxh]
+        if self._own is None or self._own[0].numel() < nz + nd or self._own[1].numel() < nxd \
+                or self._own[2].numel() < nxh:
+            self._own = (torch.empty((nz + nd,), dtype=torch.float32, device=self.device),
+                         torch.empty((nxd,), dtype=torch.float16, device=self.device),
+                         torch.empty((nxh,), dtype=torch.float16, device=self.device))
+        z, xd, xg = self._own
+        return z[:nz], xd[:nxd], z[nz:nz + nd], xg[:nxh]
+
+    def fault(self) -> int:
+        """The last call's fault bits (a host sync): 1 routes, 2 a NaN input value, 4 a non-finite gate/up output, 8 a
+        non-finite output sum."""
+
+        return int(self.meta[1].item())
+
+    def groups_formed(self) -> int:
+        return int(self.meta[0].item())
+
+
+def routed(x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor, ex, s: Scratch, out: torch.Tensor, R: int,
+           limit: float = 10.0, cfg: Cfg | None = None, *, rowrot: bool = True, order: bool = False) -> torch.Tensor:
+    """``out[:R]`` (fp32 [R, 4096]) = the half's routed experts of R BF16 rows ``x`` (any row stride): pick / wts
+    slots 0..7 (the routed slots; a shared slot after them is not read), through glm53f-rank's large-M kernels on
+    ``ex``'s resident tensors; no host sync. ``cfg``: default_cfg(R) unless given; rot 2 needs ``ex.shared_suh``
+    (else the per-(row, matrix) rotation runs: the same bits)."""
+
+    if R > s.rows:
+        raise ValueError(f"{R} rows but the scratch holds {s.rows}")
+    if not math.isfinite(limit):
+        raise ValueError("the kernels clamp at a finite swiglu_limit")
+    c = cfg or default_cfg(R, rowrot=rowrot, order=order)
+    shared = getattr(ex, "shared_suh", None)
+    rot = c.rot if shared is not None else 1
+    z, xd, zd, xh = s.big(R, c)
+    _ext().ffn(ex.gate_ptr, ex.up_ptr, ex.down_ptr, ex.suh_g, ex.suh_u, ex.svh_g, ex.svh_u, ex.suh_d, ex.svh_d,
+               shared if rot == 2 else None, x[:R], pick[:R], wts[:R], out, z, xd, zd, xh, s.groups, s.meta,
+               s.pair_row, s.pair_route, s.inverse, s.gcnt, s.rcnt, s.gorder, R, c.mt, c.sk, c.skd, c.nt, c.gw, c.l2,
+               c.fuse, c.discard, c.swiglu, rot, c.gord, float(limit))
+    return out[:R]
+
+
+class Node:
+    """An expert node's hook (``ExpertNode.g53``, made only under TF_GLM_EXPERT_KERNEL=g53): ``takes`` a prompt chunk's
+    window of an in-scope layer, ``compute`` runs it into the node's reply buffer."""
+
+    def __init__(self, node, settings: dict) -> None:
+        b = node.buf
+        self.node, self.min_rows = node, int(settings["min_rows"])
+        self.rowrot, self.order = bool(settings["rowrot"]), bool(settings["order"])
+        self.max_rows = min(MAX_ROWS, b.prefill_rows)
+        self.ready = {i: layer_ready(ex) is None for i, ex in node.by_layer.items()}
+        self.scratch = Scratch(self.max_rows, b.routed.device, share=getattr(b, "pref", None))
+        if any(self.ready.values()) and b.routed.is_cuda:
+            _ext()                  # loaded (prebuilt: tools/prebuild_ext.py) at the start, not in a prompt forward
+        shared = sum(1 for i, ok in self.ready.items()
+                     if ok and getattr(node.by_layer[i], "shared_suh", None) is not None)
+        print(f"[tensorfold] afd expert {node.half + 1}: {ENV}=g53: prompt chunks of {self.min_rows}-{self.max_rows} "
+              f"rows through glm53f-afd's large-M expert kernels (Hugh Madden; outputs class; rowrot "
+              f"{'on' if self.rowrot else 'off'} ({shared} layers share one gate/up suh), order "
+              f"{'on' if self.order else 'off'}); {sum(self.ready.values())} of {len(self.ready)} MoE layers in scope",
+              flush=True)
+
+    def takes(self, layer_i: int, R: int, prompt: bool) -> bool:
+        """A prompt chunk's window (``prompt``: the node's MODE_CHUNK, MODE_SLICE and MODE_PAIR forwards) of
+        min_rows..max_rows rows, on a layer in the kernels' scope. Decode windows (MODE_EAGER) never."""
+
+        return bool(prompt) and self.min_rows <= R <= self.max_rows and self.ready.get(layer_i, False)
+
+    def compute(self, layer_i: int, R: int, x: tuple | None = None) -> torch.Tensor:
+        """``routed_half[:R]``, fp32, as ``ExpertNode.compute`` returns it (the shared slot not read)."""
+
+        b = self.node.buf
+        normed, pick, wts = x if x is not None else (b.normed[:R], b.pick[:R], b.wts[:R])
+        return routed(normed, pick, wts, self.node.by_layer[layer_i], self.scratch, b.routed[:R], R,
+                      self.node.cfg.limit, rowrot=self.rowrot, order=self.order)
diff --git a/src/tensorfold/families/glm5_next/cuda/g53_rank.cpp b/src/tensorfold/families/glm5_next/cuda/g53_rank.cpp
new file mode 100644
index 0000000..508429a
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/g53_rank.cpp
@@ -0,0 +1,160 @@
+// The torch binding of glm53f-afd's large-M expert kernels (g53_rank.cu; expert prompt kernels from glm53f-afd,
+// written by Hugh Madden (@dangerm00se, github.com/hughmadden), glm53f-afd @ 91db3cc, MIT License, Copyright (c) 2026
+// Turquoise Bay AI Pty Ltd; see g53_rank.cu's header and THIRD_PARTY_NOTICES.md). Checks every tensor, then launches
+// one call on torch's current stream; no host sync.
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+
+#include "g53_rank.h"
+
+namespace {
+
+constexpr int64_t H = 4096, WID = 1024, E = 288, TOPK = 8, MAX_ROWS = 4096;
+
+void check(const at::Tensor& t, at::ScalarType dt, const char* name, bool contiguous = true) {
+    TORCH_CHECK(t.is_cuda() && t.scalar_type() == dt, name, ": expected a CUDA tensor of dtype ", dt, ", got ",
+                t.scalar_type(), t.is_cuda() ? "" : " (not CUDA)");
+    TORCH_CHECK(!contiguous || t.is_contiguous(), name, ": expected a contiguous tensor");
+}
+
+void aligned(const at::Tensor& t, int64_t bytes, const char* name) {
+    TORCH_CHECK(reinterpret_cast<uintptr_t>(t.data_ptr()) % bytes == 0, name, ": expected a ", bytes,
+                "-byte aligned start");
+}
+
+void rows_of(const at::Tensor& t, int64_t rows, int64_t width, const char* name) {
+    TORCH_CHECK(t.dim() == 2 && t.size(0) >= rows && t.size(1) >= width && t.stride(1) == 1, name,
+                ": expected rows of at least ", width, " unit-stride values, ", rows, " of them");
+}
+
+}  // namespace
+
+// out[rows][4096] (fp32) = the half's routed experts of `rows` rows: pick / wts slots 0..7 (the 8 routed slots).
+// Returns nothing; meta[1] holds the call's fault bits once the stream reaches it (1 routes, 2 a NaN input value,
+// 4 a non-finite gate/up output, 8 a non-finite output sum).
+void ffn(const at::Tensor& gate_t, const at::Tensor& up_t, const at::Tensor& down_t, const at::Tensor& suh_g,
+         const at::Tensor& suh_u, const at::Tensor& svh_g, const at::Tensor& svh_u, const at::Tensor& suh_d,
+         const at::Tensor& svh_d, c10::optional<at::Tensor> shared_suh, const at::Tensor& x, const at::Tensor& pick,
+         const at::Tensor& wts, at::Tensor out, at::Tensor z, at::Tensor xd, at::Tensor zd, at::Tensor xh,
+         at::Tensor groups, at::Tensor meta, at::Tensor pair_row, at::Tensor pair_route, at::Tensor inverse,
+         at::Tensor gcnt, at::Tensor rcnt, at::Tensor gorder, int64_t rows, int64_t mt, int64_t sk, int64_t skd,
+         int64_t nt, int64_t gw, int64_t l2, int64_t fuse, int64_t discard, int64_t swiglu, int64_t rot, int64_t gord,
+         double limit) {
+    TORCH_CHECK(rows >= 1 && rows <= MAX_ROWS, "rows: 1..", MAX_ROWS, ", not ", rows);
+    TORCH_CHECK((mt == 2 || mt == 4) && (nt == 1 || nt == 2 || nt == 4) && (gw == 8 || gw == 16) &&
+                    sk >= 1 && 32 % sk == 0 && skd >= 1 && skd <= 4 && 32 % skd == 0 && (l2 == 1 || l2 == 2) &&
+                    (fuse == 1 || fuse == 2) && (discard == 1 || discard == 2) && (swiglu == 0 || swiglu == 1) &&
+                    (rot == 1 || rot == 2) && (gord == 1 || gord == 2),
+                "configuration: mt 2 or 4, nt 1, 2 or 4, gw 8 or 16, sk dividing 32, skd 1, 2 or 4, l2, fuse, discard,"
+                " rot and gord 1 or 2, swiglu 0 or 1");
+    for (const auto* t : {&gate_t, &up_t, &down_t}) {
+        check(*t, at::kLong, "trellis table");
+        TORCH_CHECK(t->numel() == E, "trellis table: one pointer per expert (", E, ")");
+    }
+    check(suh_g, at::kHalf, "suh_g");
+    check(suh_u, at::kHalf, "suh_u");
+    check(svh_d, at::kHalf, "svh_d");
+    check(svh_g, at::kHalf, "svh_g");
+    check(svh_u, at::kHalf, "svh_u");
+    check(suh_d, at::kHalf, "suh_d");
+    TORCH_CHECK(suh_g.numel() == E * H && suh_u.numel() == E * H && svh_d.numel() == E * H, "suh_g, suh_u, svh_d: [",
+                E, ", ", H, "]");
+    TORCH_CHECK(svh_g.numel() == E * WID && svh_u.numel() == E * WID && suh_d.numel() == E * WID,
+                "svh_g, svh_u, suh_d: [", E, ", ", WID, "]");
+    for (const auto* t : {&suh_g, &suh_u, &svh_g, &svh_u, &suh_d, &svh_d}) aligned(*t, 8, "scale vector");
+    const void* shared = nullptr;
+    if (rot == 2) {
+        TORCH_CHECK(shared_suh.has_value(), "rot 2: the layer's shared gate/up suh is needed");
+        check(*shared_suh, at::kHalf, "shared_suh");
+        TORCH_CHECK(shared_suh->numel() == H, "shared_suh: [", H, "]");
+        aligned(*shared_suh, 8, "shared_suh");
+        shared = shared_suh->data_ptr();
+    }
+    check(x, at::kBFloat16, "x", false);
+    rows_of(x, rows, H, "x");
+    TORCH_CHECK(x.stride(0) % 4 == 0, "x: a row stride of a multiple of 4 values (8-byte loads)");
+    aligned(x, 8, "x");
+    check(pick, at::kInt, "pick", false);
+    rows_of(pick, rows, TOPK, "pick");
+    check(wts, at::kFloat, "wts", false);
+    rows_of(wts, rows, TOPK, "wts");
+    check(out, at::kFloat, "out");
+    TORCH_CHECK(out.numel() >= rows * H, "out: [rows, ", H, "]");
+    aligned(out, 16, "out");
+    const int64_t P = rows * TOPK, gr = 16 * mt;
+    const int64_t bound = P / gr + (P < E ? P : E), max_groups = P < bound ? P : bound;
+    check(z, at::kFloat, "z");
+    check(xd, at::kHalf, "xd");
+    check(zd, at::kFloat, "zd");
+    TORCH_CHECK(z.numel() >= 2 * sk * P * WID, "z: 2 sk rows*8 x ", WID, " floats");
+    TORCH_CHECK(xd.numel() >= P * WID, "xd: rows*8 x ", WID, " halves");
+    TORCH_CHECK(zd.numel() >= skd * P * H, "zd: skd rows*8 x ", H, " floats");
+    aligned(z, 128, "z");
+    aligned(xd, 128, "xd");
+    aligned(zd, 128, "zd");
+    if (rot == 2) {
+        check(xh, at::kHalf, "xh");
+        TORCH_CHECK(xh.numel() >= rows * H, "xh: rows x ", H, " halves");
+        aligned(xh, 128, "xh");
+    }
+    for (const auto* t : {&groups, &meta, &pair_row, &pair_route, &inverse, &gcnt, &rcnt, &gorder})
+        check(*t, at::kInt, "plan buffer");
+    TORCH_CHECK(groups.numel() >= 4 * max_groups && gcnt.numel() >= max_groups && gorder.numel() >= max_groups,
+                "groups (4 words a group), gcnt, gorder: ", max_groups, " groups");
+    TORCH_CHECK(meta.numel() >= 4, "meta: 4 words");
+    TORCH_CHECK(pair_row.numel() >= P && pair_route.numel() >= P && inverse.numel() >= P, "pair buffers: rows*8");
+    TORCH_CHECK(rcnt.numel() >= rows * (32 / nt), "rcnt: rows x ", 32 / nt, " chunks");
+    aligned(groups, 16, "groups");
+    c10::cuda::CUDAGuard guard(x.device());
+    G53Call c{};
+    c.gate_t = gate_t.data_ptr<int64_t>();
+    c.up_t = up_t.data_ptr<int64_t>();
+    c.down_t = down_t.data_ptr<int64_t>();
+    c.suh_g = suh_g.data_ptr();
+    c.suh_u = suh_u.data_ptr();
+    c.svh_g = svh_g.data_ptr();
+    c.svh_u = svh_u.data_ptr();
+    c.suh_d = suh_d.data_ptr();
+    c.svh_d = svh_d.data_ptr();
+    c.shared_suh = shared;
+    c.x = x.data_ptr();
+    c.xs = static_cast<int>(x.stride(0));
+    c.pick = pick.data_ptr<int32_t>();
+    c.ps = static_cast<int>(pick.stride(0));
+    c.wts = wts.data_ptr<float>();
+    c.ws = static_cast<int>(wts.stride(0));
+    c.out = out.data_ptr<float>();
+    c.z = z.data_ptr<float>();
+    c.xd = xd.data_ptr();
+    c.zd = zd.data_ptr<float>();
+    c.xh = rot == 2 ? xh.data_ptr() : nullptr;
+    c.groups = groups.data_ptr();
+    c.meta = meta.data_ptr<int32_t>();
+    c.pair_row = pair_row.data_ptr<int32_t>();
+    c.pair_route = pair_route.data_ptr<int32_t>();
+    c.inverse = inverse.data_ptr<int32_t>();
+    c.gcnt = gcnt.data_ptr<int32_t>();
+    c.rcnt = rcnt.data_ptr<int32_t>();
+    c.gorder = gorder.data_ptr<int32_t>();
+    c.rows = static_cast<int>(rows);
+    c.mt = static_cast<int>(mt);
+    c.sk = static_cast<int>(sk);
+    c.skd = static_cast<int>(skd);
+    c.nt = static_cast<int>(nt);
+    c.gw = static_cast<int>(gw);
+    c.l2 = static_cast<int>(l2);
+    c.fuse = static_cast<int>(fuse);
+    c.discard = static_cast<int>(discard);
+    c.swiglu = static_cast<int>(swiglu);
+    c.rot = static_cast<int>(rot);
+    c.gord = static_cast<int>(gord);
+    c.limit = static_cast<float>(limit);
+    c.sms = at::cuda::getCurrentDeviceProperties()->multiProcessorCount;
+    const cudaError_t e = g53_ffn_launch(c, at::cuda::getCurrentCUDAStream());
+    TORCH_CHECK(e == cudaSuccess, "glm53f-afd expert kernels: launch failed: ", cudaGetErrorString(e));
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("ffn", &ffn, "glm53f-afd's large-M expert kernels: one call of a TP2 half's routed experts (fp32 out)");
+}
