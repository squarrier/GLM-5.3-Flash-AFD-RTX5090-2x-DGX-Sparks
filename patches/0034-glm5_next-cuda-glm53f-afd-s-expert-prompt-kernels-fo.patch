@@ -0,0 +1,54 @@
+// glm53f-afd's large-M expert kernels in TensorFold's AFD expert node (TF_GLM_EXPERT_KERNEL=g53): the launch's
+// arguments, shared by g53_rank.cu (the kernels, from glm53f-afd by Hugh Madden; see its header) and g53_rank.cpp
+// (the torch binding). Plain pointer types, so the host compiler needs no CUDA half types.
+#pragma once
+
+#include <cuda_runtime_api.h>
+#include <cstdint>
+
+// One call's tensors and configuration (glm53f-rank's g53r_cfg fields for the large-M kernels; g53_experts.py
+// resolves the defaults): mt 2 or 4 (16-row tiles a group), sk and skd (K splits; sk divides 32, skd divides 8 and
+// is at most 4), nt 1, 2 or 4 (down: 16-column tiles a warp), gw 8 or 16 (gate/up MMA warps), l2 1 or 2 (2: the
+// trellis words loaded evict-first), fuse 1 or 2 (2: the epilogue and reduce fused), discard 1 or 2 (2: the consumed
+// partial sums dropped from L2, fused only), swiglu 0 (BF16 roundings) or 1 (FP32), rot 1 or 2 (2: every row rotated
+// once with the layer's shared gate/up suh), gord 1 or 2 (2: the group order).
+struct G53Call {
+    // the layer: per-expert trellis pointer tables (int64) and stacked fp16 scale vectors
+    const int64_t* gate_t;
+    const int64_t* up_t;
+    const int64_t* down_t;
+    const void* suh_g;       // fp16 [288][4096]
+    const void* suh_u;
+    const void* svh_g;       // fp16 [288][1024]
+    const void* svh_u;
+    const void* suh_d;       // fp16 [288][1024]
+    const void* svh_d;       // fp16 [288][4096]
+    const void* shared_suh;  // fp16 [4096], the layer's one gate/up suh (rot 2), or null
+    // the call: BF16 rows, routes, the FP32 output
+    const void* x;           // bf16 [rows][xs]
+    int xs;
+    const int32_t* pick;     // [rows][ps]: slots 0..7 routed
+    int ps;
+    const float* wts;        // [rows][ws]
+    int ws;
+    float* out;              // fp32 [rows][4096]
+    // scratch
+    float* z;                // [2][sk][rows * 8][1024]
+    void* xd;                // fp16 [rows * 8][1024]
+    float* zd;               // [skd][rows * 8][4096]
+    void* xh;                // fp16 [rows][4096] (rot 2)
+    void* groups;            // 16 bytes a group
+    int* meta;               // 4 words: groups, fault, two work counters
+    int* pair_row;
+    int* pair_route;
+    int* inverse;
+    int* gcnt;               // zero between calls
+    int* rcnt;               // zero between calls
+    int* gorder;
+    int rows;
+    int mt, sk, skd, nt, gw, l2, fuse, discard, swiglu, rot, gord;
+    float limit;
+    int sms;
+};
+
+cudaError_t g53_ffn_launch(const G53Call& c, cudaStream_t st);
