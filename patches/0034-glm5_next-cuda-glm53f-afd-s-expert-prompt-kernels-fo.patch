@@ -0,0 +1,494 @@
+"""glm53f-afd's large-M expert kernels in the AFD expert node (TF_GLM_EXPERT_KERNEL=g53; families/glm5_next/cuda/
+g53_rank.cu; expert prompt kernels from glm53f-afd, written by Hugh Madden (@dangerm00se, github.com/hughmadden),
+glm53f-afd @ 91db3cc, MIT, Copyright (c) 2026 Turquoise Bay AI Pty Ltd) on the GPU. GPU only: it runs on an expert
+node's GPU with no model server loaded.
+
+- Against glm53f-rank's own kernels on the same tiles: its two-rank source (TF_G53_RANK_SRC: glm53f-afd @ 91db3cc with
+  the two-rank width and the row rotation patches applied, pinned by sha256) is built here with its build.rs flags and
+  -DG53R_WID=1024 and called through its C API (g53r_layer_new on an image cut from this layer's tensors, g53r_ffn_f32
+  on FP8 rows whose values the port gets as BF16 rows). The half's FP32 rows must be byte-equal at 65-4,096 rows, both
+  configurations (32- and 64-row groups), uniform and skewed routing, row rotation once a row and per (row, matrix),
+  group order on and off, BF16 and FP32 SwiGLU; and, with discard off, the intermediates (gate/up sums, down inputs,
+  down sums) byte-equal route by route.
+- Its own properties: the same bytes twice; a row's bits whatever window it is in; invalid routes fault and poison
+  the call's rows with NaN; the binding's refusals.
+- Against TensorFold's kernels (the node's path before: exl3_generic.routed and glue.combine) on the same layer and
+  rows: an outputs-class distance, reported and bounded (rel. L2 <= 1e-3); and both against the CPU reference
+  (tests/glm_g53_reference.py) on a few rows.
+- The expert node: a prompt chunk's window takes the kernels and a decode window does not.
+- Times (report only): ms per call at 2,048 and 4,096 rows for the port, glm53f-rank and TensorFold's kernels
+  (TF_G53_TIMES: a JSON file to write them to).
+
+TF_GLM_MODEL_DIR (with TF_G53_LAYER, default the first MoE layer, and TF_G53_HALF, default 0): one MoE layer's half of
+the real checkpoint instead of synthetic tiles.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from tests import glm_g53_reference as ref
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA only")
+
+E, D, NI, TOPK, LIMIT, LAYER = 288, 4096, 1024, 8, 10.0, 3
+REF_SHA256 = "59d8edd8a54f9a566d466ab5e23fb17510af2b4a8764ee90e488e9d95efc8566"   # glm53f-rank two-rank exl3_rank.cu
+ROWS = [65, 128, 594, 2048, 2049, 4096]
+
+
+# ------------------------------------------------------------------------------------------------- the two layers
+
+def _synthetic(shared: bool):
+    from tensorfold.cuda.exl3 import experts as generic
+    from tensorfold.families.glm5_next.cuda import exl3_generic
+
+    g = torch.Generator().manual_seed(53)
+
+    def trel(k, n):
+        v = torch.randint(-32768, 32768, (E, k // 16, n // 16, 64), dtype=torch.int32, generator=g)
+        return v.to(torch.int16).cuda().contiguous()
+
+    def sc(n, mag, one=False):
+        rows = 1 if one else E
+        sign = torch.randint(0, 2, (rows, n), generator=g).float() * 2 - 1
+        v = (sign * (torch.rand((rows, n), generator=g) + 0.5) * mag).half()
+        return v.expand(E, n).contiguous().cuda() if one else v.cuda().contiguous()
+
+    suh_g = sc(D, 0.02, one=shared)
+    suh_u = suh_g.clone() if shared else sc(D, 0.02)
+    ex = generic.prepare_stacked(trel(D, NI), trel(D, NI), trel(NI, D), suh_g, suh_u, sc(NI, 0.5), sc(NI, 0.5),
+                                 sc(NI, 0.05), sc(D, 0.2), "mcg")
+    return exl3_generic.share_suh(ex)
+
+
+def _real():
+    from tensorfold.families.glm5_next.cuda.experts_node import load_half
+    from tensorfold.families.glm5_next.cuda.weights import Config
+
+    d = os.environ["TF_GLM_MODEL_DIR"]
+    cfg = Config.read(d)
+    layer = int(os.environ.get("TF_G53_LAYER", str(cfg.mlp_kinds.index("moe"))))
+    return load_half(d, int(os.environ.get("TF_G53_HALF", "0")), [layer])[0]
+
+
+@pytest.fixture(scope="module", params=["shared", "per-expert"] + (["real"] if os.environ.get("TF_GLM_MODEL_DIR")
+                                                                    else []))
+def layer(request):
+    ex = _real() if request.param == "real" else _synthetic(request.param == "shared")
+    from tensorfold.families.glm5_next.cuda import g53_experts
+
+    assert g53_experts.layer_ready(ex) is None
+    if request.param == "shared":
+        assert ex.shared_suh is not None
+    if request.param == "per-expert":
+        assert ex.shared_suh is None
+    yield request.param, ex
+    torch.cuda.empty_cache()
+
+
+# ------------------------------------------------------------------------------------------ glm53f-rank's own build
+
+class Cfg(ctypes.Structure):
+    _fields_ = [(n, ctypes.c_int) for n in ("mt", "sk", "skd", "fp32_swiglu", "big", "nt", "fuse", "discard", "gw",
+                                             "gp", "plan", "l2", "pf", "ord", "pdl", "rot", "gord")]
+
+
+def _their_cfg(c) -> Cfg:
+    """glm53f-rank's g53r_cfg for the port's Cfg: every field given (big 2 alone would take its 4,096-row defaults)."""
+
+    return Cfg(mt=c.mt, sk=c.sk, skd=c.skd, fp32_swiglu=c.swiglu, big=2, nt=c.nt, fuse=c.fuse, discard=c.discard,
+               gw=c.gw, gp=-1, plan=1, l2=c.l2, pf=1, ord=1, pdl=1, rot=c.rot, gord=c.gord)
+
+
+@pytest.fixture(scope="module")
+def rank_lib(tmp_path_factory):
+    src = os.environ.get("TF_G53_RANK_SRC", "")
+    if not src:
+        pytest.skip("TF_G53_RANK_SRC (glm53f-rank's two-rank exl3_rank.cu) unset")
+    data = Path(src).read_bytes()
+    assert hashlib.sha256(data).hexdigest() == REF_SHA256, "not the pinned glm53f-rank source"
+    major, minor = torch.cuda.get_device_capability()
+    arch = f"{major}{minor}"
+    nvcc = os.environ.get("TF_G53_NVCC") or shutil.which("nvcc") or "/usr/local/cuda/bin/nvcc"
+    out = tmp_path_factory.mktemp("g53r") / "libg53r.so"
+    cmd = [nvcc, "-O3", "-std=c++17", "--fmad=false", "--ftz=false", "--prec-div=true", f"-arch=sm_{arch}",
+           "-Xcompiler=-fPIC", f"-DG53R_BAKED_ARCH={arch}", "-DG53R_WID=1024", "-shared", "-cudart", "shared",
+           "-o", str(out), src]
+    subprocess.run(cmd, check=True, capture_output=True)
+    lib = ctypes.CDLL(str(out))
+    vp, sz, i32 = ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int
+    lib.g53r_layer_new.argtypes = [vp, ctypes.c_uint64, ctypes.POINTER(vp), ctypes.c_char_p, sz]
+    lib.g53r_layer_new.restype = i32
+    lib.g53r_layer_shared_suh.argtypes = [vp]
+    lib.g53r_layer_shared_suh.restype = i32
+    lib.g53r_layer_free.argtypes = [vp]
+    lib.g53r_scratch_new.argtypes = [ctypes.POINTER(vp), ctypes.c_char_p, sz]
+    lib.g53r_scratch_new.restype = i32
+    lib.g53r_scratch_free.argtypes = [vp]
+    lib.g53r_ffn_f32.argtypes = [vp, vp, vp, sz, vp, sz, vp, vp, ctypes.c_uint32, vp, ctypes.POINTER(Cfg), vp,
+                                 ctypes.c_char_p, sz]
+    lib.g53r_ffn_f32.restype = i32
+    lib.g53r_debug_copy.argtypes = [vp, vp, sz, vp, sz, vp, sz, vp, sz, ctypes.c_char_p, sz]
+    lib.g53r_debug_copy.restype = i32
+    return lib
+
+
+def _np(t: torch.Tensor) -> np.ndarray:
+    return t.detach().cpu().contiguous().numpy()
+
+
+@pytest.fixture(scope="module")
+def theirs(rank_lib, layer):
+    """glm53f-rank's layer (an image cut from the same tensors) and scratch."""
+
+    _, ex = layer
+    keep = ex.keep                                    # prepare's order: E gate trellises, E up, E down
+    assert len(keep) == 3 * E
+    for e in (0, E - 1):
+        assert keep[e].data_ptr() == int(ex.gate_ptr[e]) and keep[2 * E + e].data_ptr() == int(ex.down_ptr[e])
+    img = ref.rank_image([_np(t) for t in keep[:E]], [_np(t) for t in keep[E:2 * E]], [_np(t) for t in keep[2 * E:]],
+                         _np(ex.suh_g), _np(ex.suh_u), _np(ex.svh_g), _np(ex.svh_u), _np(ex.suh_d), _np(ex.svh_d))
+    err = ctypes.create_string_buffer(512)
+    L, S = ctypes.c_void_p(), ctypes.c_void_p()
+    assert rank_lib.g53r_layer_new(img.ctypes.data_as(ctypes.c_void_p), img.size, ctypes.byref(L), err, 512) == 0, \
+        err.value
+    del img
+    assert rank_lib.g53r_scratch_new(ctypes.byref(S), err, 512) == 0, err.value
+    assert bool(rank_lib.g53r_layer_shared_suh(L)) == (ex.shared_suh is not None)   # the two scans agree
+    yield SimpleNamespace(lib=rank_lib, L=L, S=S)
+    rank_lib.g53r_scratch_free(S)
+    rank_lib.g53r_layer_free(L)
+
+
+def _their_ffn(t, codes, scales, pick8, w8, cfg, ms=None):
+    R = codes.shape[0]
+    out = np.zeros((R, D), np.float32)
+    ids = np.ascontiguousarray(pick8[:, :TOPK], dtype=np.int32)
+    wts = np.ascontiguousarray(w8[:, :TOPK], dtype=np.float32)
+    msb = np.zeros(9, np.float32)
+    err = ctypes.create_string_buffer(512)
+    c = _their_cfg(cfg)
+    torch.cuda.synchronize()
+    rc = t.lib.g53r_ffn_f32(t.L, t.S, codes.ctypes.data_as(ctypes.c_void_p), D, scales.ctypes.data_as(ctypes.c_void_p),
+                            D // 32, ids.ctypes.data_as(ctypes.c_void_p), wts.ctypes.data_as(ctypes.c_void_p), R,
+                            out.ctypes.data_as(ctypes.c_void_p), ctypes.byref(c), msb.ctypes.data_as(ctypes.c_void_p),
+                            err, 512)
+    assert rc == 0, err.value
+    if ms is not None:
+        ms.append(float(msb[1]))
+    return out
+
+
+# ----------------------------------------------------------------------------------------------- inputs and calls
+
+def _inputs(R: int, kind: str, seed: int):
+    rng = np.random.default_rng(seed)
+    codes, scales, vals = ref.fp8_rows(R, rng)
+    if kind == "uniform":
+        sel = np.stack([rng.permutation(E)[:TOPK] for _ in range(R)])
+    else:                                              # skewed: a few hot experts, as real routing has
+        p = 1.0 / np.arange(1, E + 1) ** 1.1
+        p = p[rng.permutation(E)]
+        sel = np.stack([rng.choice(E, TOPK, replace=False, p=p / p.sum()) for _ in range(R)])
+    w = (rng.random((R, TOPK)) * 0.3 + 0.05).astype(np.float32)
+    pick = np.concatenate([sel, np.full((R, 1), E)], 1).astype(np.int32)             # the shared slot after them
+    wts = np.concatenate([w, np.ones((R, 1), np.float32)], 1)
+    x = torch.from_numpy(vals).to(torch.bfloat16).cuda()
+    assert torch.equal(x.float().cpu(), torch.from_numpy(vals))                       # FP8 values, exactly BF16
+    return SimpleNamespace(codes=codes, scales=scales, x=x, pick=torch.from_numpy(pick).cuda(),
+                           wts=torch.from_numpy(wts).cuda(), pick_np=pick, wts_np=wts)
+
+
+_SCRATCH = {}
+
+
+def _scratch(R: int):
+    from tensorfold.families.glm5_next.cuda import g53_experts
+
+    s = _SCRATCH.get("s")
+    if s is None or s.rows < R:
+        s = _SCRATCH["s"] = g53_experts.Scratch(max(R, 4096), "cuda")
+    return s
+
+
+def _ours(ex, inp, cfg, R=None):
+    from tensorfold.families.glm5_next.cuda import g53_experts
+
+    R = R or inp.x.shape[0]
+    s = _scratch(R)
+    out = torch.full((R, D), float("nan"), dtype=torch.float32, device="cuda")
+    g53_experts.routed(inp.x, inp.pick, inp.wts, ex, s, out, R, LIMIT, cfg)
+    torch.cuda.synchronize()
+    assert s.fault() == 0
+    return out
+
+
+def _cfg(R, **kw):
+    from dataclasses import replace
+
+    from tensorfold.families.glm5_next.cuda import g53_experts
+
+    return replace(g53_experts.default_cfg(R), **kw)
+
+
+def _tf(ex, inp, R, s=None, sync=True):
+    """The node's path before: exl3_generic.routed into a prompt scratch, the shared slot zeroed, glue.combine."""
+
+    from tensorfold.cuda.exl3.experts import Scratch as Exl3Scratch
+    from tensorfold.families.glm5_next.cuda import exl3_generic, glue
+
+    s = s or Exl3Scratch(SimpleNamespace(dims=D, width=NI, count=E), R, TOPK + 1, device="cuda")
+    exl3_generic.routed(inp.x, inp.pick, ex, s, R, LIMIT)
+    ey = s.y.view(s.rows, TOPK + 1, D)[:R]
+    ey[:, TOPK].zero_()
+    out = torch.empty((R, D), dtype=torch.float32, device="cuda")
+    glue.combine(ey, inp.wts, out)
+    if sync:
+        torch.cuda.synchronize()
+    return out
+
+
+def _bits_equal(a: torch.Tensor, b) -> bool:
+    b = torch.as_tensor(b, device=a.device)
+    return bool(torch.equal(a.contiguous().view(torch.int32), b.contiguous().view(torch.int32)))
+
+
+# ---------------------------------------------------------------------------------------- against glm53f-rank
+
+@pytest.mark.parametrize("R", ROWS)
+@pytest.mark.parametrize("kind", ["uniform", "skewed"])
+def test_outputs_byte_equal_glm53f_rank(layer, theirs, R, kind):
+    name, ex = layer
+    inp = _inputs(R, kind, R)
+    for kw in ({}, {"gord": 2}, {"rot": 1}):
+        cfg = _cfg(R, **kw)
+        got = _ours(ex, inp, cfg)
+        want = _their_ffn(theirs, inp.codes, inp.scales, inp.pick_np, inp.wts_np, cfg)
+        assert np.isfinite(want).all()
+        assert _bits_equal(got, want), f"{name} R{R} {kind} {kw}: max |diff| {(got.cpu() - want).abs().max():.3e}"
+
+
+@pytest.mark.parametrize("R", [128, 2049])
+def test_fp32_swiglu_byte_equal_glm53f_rank(layer, theirs, R):
+    _, ex = layer
+    inp = _inputs(R, "skewed", 7 + R)
+    cfg = _cfg(R, swiglu=1)
+    assert _bits_equal(_ours(ex, inp, cfg), _their_ffn(theirs, inp.codes, inp.scales, inp.pick_np, inp.wts_np, cfg))
+
+
+@pytest.mark.parametrize("R", [594, 4096])
+def test_intermediates_byte_equal_route_by_route(layer, theirs, R):
+    _, ex = layer
+    inp = _inputs(R, "uniform", 11 + R)
+    cfg = _cfg(R, discard=1)                              # the partial sums kept for the copy
+    _ours(ex, inp, cfg)
+    s = _scratch(R)
+    z, xd, zd, _ = s.big(R, cfg)
+    P = R * TOPK
+    _their_ffn(theirs, inp.codes, inp.scales, inp.pick_np, inp.wts_np, cfg)
+    tz, tpr = np.zeros(2 * P * NI, np.float32), np.zeros(P, np.int32)
+    txd, tzd = np.zeros(P * NI, np.uint16), np.zeros(P * D, np.float32)
+    err = ctypes.create_string_buffer(512)
+    rc = theirs.lib.g53r_debug_copy(theirs.S, tz.ctypes.data_as(ctypes.c_void_p), tz.size,
+                                    tpr.ctypes.data_as(ctypes.c_void_p), tpr.size,
+                                    txd.ctypes.data_as(ctypes.c_void_p), txd.size,
+                                    tzd.ctypes.data_as(ctypes.c_void_p), tzd.size, err, 512)
+    assert rc == 0, err.value
+    ours_pr = _np(s.pair_route[:P]).astype(np.int64)
+    theirs_inv, ours_inv = np.empty(P, np.int64), np.empty(P, np.int64)
+    theirs_inv[tpr.astype(np.int64)] = np.arange(P)                      # route -> its pair, theirs and ours
+    ours_inv[ours_pr] = np.arange(P)
+    assert np.array_equal(np.sort(ours_pr), np.arange(P))
+    a, b = ours_inv, theirs_inv
+    oz, oxd, ozd = _np(z).reshape(2, P, NI), _np(xd.view(torch.int16)).reshape(P, NI), _np(zd).reshape(P, D)
+    assert np.array_equal(oz[:, a].view(np.uint32), tz.reshape(2, P, NI)[:, b].view(np.uint32))      # gate / up sums
+    assert np.array_equal(oxd[a].view(np.uint16), txd.reshape(P, NI)[b])                              # down inputs
+    assert np.array_equal(ozd[a].view(np.uint32), tzd.reshape(P, D)[b].view(np.uint32))               # down sums
+
+
+# ---------------------------------------------------------------------------------------------- its own properties
+
+def test_same_bytes_twice_and_a_rows_bits_whatever_its_window(layer):
+    _, ex = layer
+    inp = _inputs(4096, "skewed", 3)
+    full = _ours(ex, inp, _cfg(4096))                                        # 64-row groups
+    assert _bits_equal(_ours(ex, inp, _cfg(4096)), full)
+    for lo, hi in ((0, 2048), (2048, 2113), (2113, 4096)):                  # 32-row groups, and 64 again
+        part = SimpleNamespace(x=inp.x[lo:hi], pick=inp.pick[lo:hi], wts=inp.wts[lo:hi])
+        assert _bits_equal(_ours(ex, part, _cfg(hi - lo)), full[lo:hi]), (lo, hi)
+
