+"""glm53f-afd's large-M expert kernels in the AFD expert node (TF_GLM_EXPERT_KERNEL=g53; families/glm5_next/cuda/
+g53_rank.cu and g53_experts.py; expert prompt kernels from glm53f-afd, written by Hugh Madden (@dangerm00se,
+github.com/hughmadden), glm53f-afd @ 91db3cc, MIT, Copyright (c) 2026 Turquoise Bay AI Pty Ltd). CPU only:
+
+- the documented arithmetic (tests/glm_g53_reference.py): the kernels' butterfly is the 128-point Hadamard transform;
+  the whole pipeline (row rotation, gate/up, epilogue, down, slot reduce) in float64 is the dense math of
+  diag(suh) H W_q H diag(svh) with GLM's clamped SwiGLU, and with the kernels' FP16 / BF16 / FP32 roundings stays
+  within their rounding error of it; FP8 test rows are exact BF16 values;
+- glm53f-rank's plan and its group bound, its large-M default configuration, its two-rank image layout;
+- the switch: names, defaults and refusals; unset, the expert node's every call is the one before (no hook, the same
+  calls); set, only prompt chunks (MODE_CHUNK, MODE_SLICE, MODE_PAIR forwards) of at least the threshold's rows on
+  in-scope layers take the kernels, decode windows never; the node refuses a bad value before the load; the scratch
+  shares the node's prompt scratch.
+The GPU test (tests/cuda/test_glm_g53_kernel.py) checks the CUDA kernels against glm53f-rank's own build.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from tensorfold.cuda.exl3 import experts as generic
+from tensorfold.cuda.exl3 import format as fmt
+from tensorfold.families.glm5_next.cuda import g53_experts
+from tests import glm_g53_reference as ref
+
+ENVS = (g53_experts.ENV, g53_experts.ROWS_ENV, g53_experts.ROWROT_ENV, g53_experts.ORDER_ENV)
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    for k in ENVS:
+        monkeypatch.delenv(k, raising=False)
+
+
+# ----------------------------------------------------------------------------------------- the documented arithmetic
+
+def test_butterfly_is_the_hadamard_transform():
+    rng = np.random.default_rng(1)
+    v = rng.standard_normal((16, 128)).astype(np.float32)
+    got = ref.fwht128(v).astype(np.float64) * float(ref.HAD_SCALE)
+    want = fmt.rotate(v.astype(np.float64), -1)
+    assert np.allclose(got, want, rtol=1e-5, atol=1e-5)
+    twice = ref.fwht128(ref.fwht128(v)).astype(np.float64) / 128.0          # H H = 128 I
+    assert np.allclose(twice, v, rtol=1e-5, atol=1e-5)
+    assert ref.fwht128(v).dtype == np.float32
+
+
+def test_bf16_rounding_and_fp8_rows_are_exact():
+    rng = np.random.default_rng(2)
+    x = rng.standard_normal(4096).astype(np.float32) * 3
+    want = torch.from_numpy(x).to(torch.bfloat16).float().numpy()
+    assert np.array_equal(ref.bf16r(x), want)
+    codes, scales, vals = ref.fp8_rows(4, rng)
+    assert codes.shape == (4, ref.H) and scales.shape == (4, ref.H // 32)
+    assert not np.any((codes & 0x7F) == 0x7F)                                    # no NaN code
+    assert np.all((scales >= 110) & (scales <= 125))                            # normal rows: 2^-17 .. 2^-2
+    back = torch.from_numpy(vals).to(torch.bfloat16).float().numpy()
+    assert np.array_equal(back, vals)                                            # every value is a BF16 value
+    blocks = np.abs(vals.reshape(4, ref.H // 32, 32)).max(-1) / np.ldexp(1.0, scales.astype(np.int64) - 127)
+    assert np.all(blocks <= 448) and np.all(blocks >= 224)                       # the scale is the block's own
+    x = rng.standard_normal((4, ref.H)).astype(np.float32)
+    assert np.abs(vals - x).max() > 0                                            # quantized, not the input
+    assert np.array_equal(ref.e4m3(np.array([0x38, 0xB8, 0x01, 0x7E], np.uint8)),
+                          np.array([1.0, -1.0, 2.0 ** -9, 448.0], np.float32))
+
+
+def _small_layer(rng, n_exp=10, K=256, N=128, shared=True):
+    """Experts K -> N (gate, up) and N -> K (down), 4-bit mcg trellises, GLM-like scale magnitudes."""
+
+    def trel(k, n):
+        return rng.integers(-32768, 32768, size=(k // 16, n // 16, 64), dtype=np.int64).astype(np.int16)
+
+    def sc(n, mag):
+        return (rng.choice([-1.0, 1.0], n) * (rng.random(n) + 0.5) * mag).astype(np.float16)
+
+    suh0 = sc(K, 1.0)
+    layer, dense = {}, {}
+    for e in range(n_exp):
+        tg, tu, td = trel(K, N), trel(K, N), trel(N, K)
+        L = {"suh_g": suh0 if shared else sc(K, 1.0), "svh_g": sc(N, 0.02), "svh_u": sc(N, 0.02),
+             "suh_d": sc(N, 1.0), "svh_d": sc(K, 0.03)}
+        L["suh_u"] = L["suh_g"] if shared else sc(K, 1.0)
+        L["wg"] = fmt.unpack(tg, 4, "mcg").astype(np.float32)
+        L["wu"] = fmt.unpack(tu, 4, "mcg").astype(np.float32)
+        L["wd"] = fmt.unpack(td, 4, "mcg").astype(np.float32)
+        layer[e] = L
+        dense[e] = (fmt.dequantize(tg, L["suh_g"], L["svh_g"], 4, "mcg"),
+                    fmt.dequantize(tu, L["suh_u"], L["svh_u"], 4, "mcg"),
+                    fmt.dequantize(td, L["suh_d"], L["svh_d"], 4, "mcg"))
+    return layer, dense
+
+
+@pytest.mark.parametrize("shared", [True, False])
+def test_pipeline_is_the_dense_math(shared):
+    rng = np.random.default_rng(3)
+    layer, dense = _small_layer(rng, shared=shared)
+    R = 3
+    x = torch.from_numpy(rng.standard_normal((R, 256)).astype(np.float32)).to(torch.bfloat16).float().numpy()
+    pick = np.stack([rng.permutation(10)[:8] for _ in range(R)])
+    w = (rng.random((R, 8)) * 0.3 + 0.05).astype(np.float32)
+    want = ref.dense(x, pick, w, dense)
+    exact = ref.ffn(x, pick, w, layer, exact=True, rowrot=shared)
+    assert np.allclose(exact, want, rtol=1e-9, atol=1e-9 * np.abs(want).max())   # the math, no rounding
+    got = ref.ffn(x, pick, w, layer, rowrot=shared)                              # the kernels' roundings
+    rel = np.linalg.norm(got - want) / np.linalg.norm(want)
+    assert got.dtype == np.float32 and 0 < rel < 2e-2
+    got32 = ref.ffn(x, pick, w, layer, bf16=False, rowrot=shared)                # FP32 SwiGLU: closer
+    assert np.linalg.norm(got32 - want) / np.linalg.norm(want) < rel
+
+
+def test_rowrot_gives_the_per_matrix_rotation_bits():
+    rng = np.random.default_rng(4)
+    layer, _ = _small_layer(rng, shared=True)
+    x = torch.from_numpy(rng.standard_normal((2, 256)).astype(np.float32)).to(torch.bfloat16).float().numpy()
+    pick = np.stack([rng.permutation(10)[:8] for _ in range(2)])
+    w = (rng.random((2, 8)) * 0.3).astype(np.float32)
+    a = ref.ffn(x, pick, w, layer, rowrot=True)
+    b = ref.ffn(x, pick, w, layer, rowrot=False)
+    assert np.array_equal(a.view(np.uint32), b.view(np.uint32))
+
+
+def test_reduce_order_is_slot_order_with_separate_roundings():
+    rng = np.random.default_rng(5)
+    zd = rng.standard_normal((8, 128)).astype(np.float32) * 50
+    svh = (rng.random((8, 128)) * 0.03).astype(np.float16)
+    w = rng.random(8).astype(np.float32)
+    got = ref.reduce(zd, svh, w)
+    acc = np.zeros(128, np.float32)
+    for s in range(8):
+        y = (ref.fwht128(np.float32(0) + zd[s]) * ref.HAD_SCALE) * svh[s].astype(np.float32)
+        acc = np.float32(acc + np.float32(w[s] * y))
+    assert np.array_equal(got.view(np.uint32), acc.view(np.uint32))
+
+
+# --------------------------------------------------------------------------------------- glm53f-rank's plan and setup
+
+def _routes(rng, R, kind):
+    if kind == "uniform":
+        return np.stack([rng.permutation(ref.E)[:8] for _ in range(R)])
+    if kind == "skewed":                                      # a few hot experts, as real routing has
+        p = 1.0 / np.arange(1, ref.E + 1) ** 1.1
+        p /= p.sum()
+        return np.stack([rng.choice(ref.E, 8, replace=False, p=p) for _ in range(R)])
+    return np.tile(np.arange(8), (R, 1))                      # every row the same 8 experts
+
+
+@pytest.mark.parametrize("R", [65, 594, 2048, 2049, 4096])
+@pytest.mark.parametrize("kind", ["uniform", "skewed", "same"])
+def test_plan_groups_every_route_once_within_the_bound(R, kind):
+    rng = np.random.default_rng(R)
+    pick = _routes(rng, R, kind)
+    for gr in (32, 64):
+        groups, pair_row, pair_route, inverse = ref.plan(pick, gr)
+        assert len(groups) <= ref.max_groups(R, gr)
+        assert ref.max_groups(R, gr) == g53_experts.max_groups(R, gr // 16)
+        assert np.array_equal(np.sort(pair_route), np.arange(R * 8))
+        assert np.array_equal(inverse[pair_route], np.arange(R * 8))
+        assert np.array_equal(pair_row, pair_route // 8)
+        start = 0
+        for e, s, c in groups:
+            assert s == start and 1 <= c <= gr and np.all(pick.reshape(-1)[pair_route[s:s + c]] == e)
+            start += c
+        assert start == R * 8
+        assert [g[0] for g in groups] == sorted(g[0] for g in groups)    # ascending expert order
+    assert g53_experts.max_groups(R) >= g53_experts.max_groups(R, 4)  # the scratch (mt 2) bounds 64-row groups too
