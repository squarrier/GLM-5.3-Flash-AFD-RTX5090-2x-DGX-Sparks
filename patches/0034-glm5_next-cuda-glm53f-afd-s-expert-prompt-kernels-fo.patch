+class _Hook:
+    def __init__(self, take):
+        self.take, self.seen = take, []
+
+    def takes(self, layer_i, R, prompt):
+        self.seen.append((layer_i, R, prompt))
+        return self.take
+
+    def compute(self, layer_i, R, x=None):
+        return ("g53", layer_i, R, x)
+
+
+def test_compute_dispatch(monkeypatch):
+    calls = []
+    for take in (True, False):
+        hook = _Hook(take)
+        experts_node, node = _node(monkeypatch, hook)
+        monkeypatch.setattr(experts_node.exl3_generic, "routed", lambda *a, **k: calls.append("routed"))
+        monkeypatch.setattr(experts_node.glue, "combine", lambda ey, wts, out: None)
+        node.prompt = True
+        got = node.compute(4, 100, x="landed" if take else None)
+        assert hook.seen == [(4, 100, True)]
+        if take:
+            assert got == ("g53", 4, 100, "landed") and calls == []
+        else:
+            assert calls == ["routed"] and got.shape == (100, 4096)
+
