+def test_unset_compute_is_the_call_before(monkeypatch):
+    experts_node, node = _node(monkeypatch)
+    calls = []
+    monkeypatch.setattr(experts_node.exl3_generic, "routed", lambda *a, **k: calls.append(("routed", a, k)))
+    monkeypatch.setattr(experts_node.glue, "combine", lambda ey, wts, out: calls.append(("combine",)))
+    for R, prompt in ((1, False), (8, False), (65, True), (256, True)):
+        node.prompt = prompt
+        out = node.compute(3, R)
+        assert out.shape == (R, 4096)
+        (name, a, k), last = calls[-2], calls[-1]
+        # the call before: no keyword on this base; a tree that also has the EXL3 prompt kernel's switch passes the
+        # node's prompt mark as its one keyword (prompt=), which these kernels leave alone
+        assert name == "routed" and last == ("combine",) and k in ({}, {"prompt": prompt})
+        assert a[0].shape == (R, 4096) and a[1].shape == (R, 9) and a[2] is node.by_layer[3]
+        assert a[3] is node.buf.scratch(R) and a[4] == R and a[5] == 10.0
+    assert getattr(node, "g53", None) is None
+
