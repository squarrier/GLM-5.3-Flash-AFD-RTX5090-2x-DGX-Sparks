+    rows = [0, 1]
+    used = sorted({int(e) for r in rows for e in inp.pick_np[r, :TOPK]})
+    keep = ex.keep
+    L = {}
+    for e in used:
+        L[e] = {"wg": _np(generic.dequant(keep[e], "mcg")), "wu": _np(generic.dequant(keep[E + e], "mcg")),
+                "wd": _np(generic.dequant(keep[2 * E + e], "mcg")), "suh_g": _np(ex.suh_g[e]),
+                "suh_u": _np(ex.suh_u[e]), "svh_g": _np(ex.svh_g[e]), "svh_u": _np(ex.svh_u[e]),
+                "suh_d": _np(ex.suh_d[e]), "svh_d": _np(ex.svh_d[e])}
+    x = _np(inp.x[rows].float())
+    want = ref.ffn(x, inp.pick_np[rows], inp.wts_np[rows], L, LIMIT, rowrot=ex.shared_suh is not None)
+    want_t = torch.from_numpy(want)
+    dg, dt = _dist(got[rows].cpu(), want_t), _dist(tf[rows].cpu(), want_t)
+    print(f"[vs the CPU reference] {name}: g53 {dg}, TensorFold {dt}")
+    assert dg["rel_l2"] <= 5e-3 and dt["rel_l2"] <= 5e-3, (dg, dt)
