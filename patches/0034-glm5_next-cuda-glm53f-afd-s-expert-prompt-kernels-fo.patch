+class FakeLink:
+    """forwards()'s link: a fixed list of forwards (seq, rows, mode[, span]), then _Done."""
+
+    def __init__(self, fwd):
+        self.fwd, self.pairs, self.span, self.rows = list(fwd), True, None, 0
+
+    def next_forward(self):
+        if not self.fwd:
+            raise _Done
+        seq, rows, mode, *span = self.fwd.pop(0)
+        self.span, self.rows = (span[0] if span else None), rows
+        return seq, rows, mode
+
+    def next_partner(self):
+        return (99,)
+
+    def use(self, slot):
+        pass
+
+    def land(self, pos, slots):
+        return slots
+
+    def reply(self, pos, routed):
+        pass
+
