+def _node(monkeypatch, hook=None):
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    ex = _layer()
+    node = experts_node.ExpertNode.__new__(experts_node.ExpertNode)
+    node.cfg = SimpleNamespace(hidden=4096, top_k=8, moe_width=2048, experts=288, limit=10.0)
+    node.half, node.layers, node.experts, node.by_layer = 0, [3, 4], [ex, ex], {3: ex, 4: ex}
+    node.buf = experts_node.ExpertBuffers(node.cfg, rows=8, prefill_rows=256, device="cpu")
+    if hook is not None:
+        node.g53 = hook
+    return experts_node, node
+
