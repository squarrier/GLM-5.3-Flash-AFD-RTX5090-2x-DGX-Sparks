+def test_scratch_shares_the_prompt_scratch():
+    R = 128
+    share = generic.Scratch(SimpleNamespace(dims=4096, width=1024, count=288), R, 9, device="cpu")
+    s = g53_experts.Scratch(R, "cpu", share=share)
+    cfg = g53_experts.default_cfg(R)
+    z, xd, zd, xh = s.big(R, cfg)
+    P = R * 8
+    assert z.data_ptr() == share.z.data_ptr() and xd.data_ptr() == share.xd.data_ptr()
+    assert zd.data_ptr() == share.y.data_ptr() and xh.data_ptr() == share.xg.data_ptr()
+    assert (z.numel(), xd.numel(), zd.numel(), xh.numel()) == (2 * P * 1024, P * 1024, P * 4096, R * 4096)
+    for big in (z, zd):                                   # the node's 9-slot prompt scratch holds the 8 routed slots
+        assert big.dtype == torch.float32
+    big4k = g53_experts.Scratch(2048, "cpu", share=generic.Scratch(SimpleNamespace(dims=4096, width=1024, count=288),
+                                                                    2048, 9, device="cpu"))
+    _, _, zd4, _ = big4k.big(2048, g53_experts.default_cfg(2048))
+    assert big4k._own is None and zd4.data_ptr() == big4k.share.y.data_ptr()       # 2,048 rows: shared, no new memory
+    own = g53_experts.Scratch(R, "cpu", share=SimpleNamespace(z=torch.zeros(8), y=torch.zeros(8),
+                                                              xd=torch.zeros(8).half(), xg=torch.zeros(8).half()))
+    z2, _xd2, zd2, xh2 = own.big(R, cfg)                   # too small to share: owned buffers
+    assert z2.numel() == 2 * P * 1024 and zd2.numel() == P * 4096 and xh2.dtype == torch.float16
+    assert s.gcnt.numel() == g53_experts.max_groups(R) and s.rcnt.numel() == R * 32 and int(s.gcnt.sum()) == 0
+    with pytest.raises(ValueError):
+        g53_experts.routed(torch.zeros((R + 1, 4096)), None, None, _layer(), s, None, R + 1)
+    with pytest.raises(ValueError):
+        g53_experts.routed(torch.zeros((R, 4096)), None, None, _layer(), s, None, R, limit=float("inf"))
