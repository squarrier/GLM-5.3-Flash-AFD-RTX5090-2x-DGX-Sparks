+# --------------------------------------------------------------------------------- against TensorFold's kernels
+
+def _dist(a: torch.Tensor, b: torch.Tensor) -> dict:
+    a, b = a.double(), b.double()
+    return {"rel_l2": float((a - b).norm() / b.norm()), "max_abs": float((a - b).abs().max()),
+            "cos": float((a * b).sum() / (a.norm() * b.norm())), "equal": float((a == b).double().mean())}
+
+
+@pytest.mark.parametrize("R", [594, 2048])
+def test_outputs_class_distance_from_tensorfolds_kernels(layer, R):
+    name, ex = layer
+    inp = _inputs(R, "skewed", 21 + R)
+    got, tf = _ours(ex, inp, _cfg(R)), _tf(ex, inp, R)
+    d = _dist(got, tf)
+    print(f"[g53 vs TensorFold's kernels] {name} R{R}: {d}")
+    assert d["rel_l2"] <= 1e-3 and d["cos"] >= 0.999999, d
