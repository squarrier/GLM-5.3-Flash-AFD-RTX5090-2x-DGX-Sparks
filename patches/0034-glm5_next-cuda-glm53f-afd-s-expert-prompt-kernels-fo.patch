+def _layer(cb=generic.CB_MCG, k2=8, E=288, D=4096, width=1024, device="cpu"):
+    t = torch.zeros((4,), dtype=torch.int16, device=device)
+    z = torch.zeros((E,), dtype=torch.int64, device=device)
+    k = torch.full((E,), k2, dtype=torch.int32, device=device)
+
+    def s(n):
+        return torch.zeros((E, n), dtype=torch.float16, device=device)
+
+    return generic.Exl3RoutedExperts(z, z, z, k, k, k, s(D), s(D), s(width), s(width), s(width), s(D), E, D, width, cb,
+                                     (k2, k2), (k2, k2), z, [t])
+
+
+def test_layer_scope():
+    assert g53_experts.layer_ready(_layer()) is None
+    assert "not an EXL3" in g53_experts.layer_ready(SimpleNamespace(cb=generic.CB_MCG))
+    assert "mcg" in g53_experts.layer_ready(_layer(cb=generic.CB_3INST))
+    assert "4 bits" in g53_experts.layer_ready(_layer(k2=6))
+    assert "shape" in g53_experts.layer_ready(_layer(width=2048))
+    assert "shape" in g53_experts.layer_ready(_layer(E=32))
