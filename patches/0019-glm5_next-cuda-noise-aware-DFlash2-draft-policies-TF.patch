+def _chain_cases(rng):
+    from tensorfold.engine.exact_sampling import Sampling
+
+    for case in range(400):
+        depth = int(rng.integers(1, 8))
+        sampling = None if case % 3 == 0 else Sampling(int(rng.integers(0, 2**31)), float(rng.choice([0.6, 1.0])),
+                                                       0, 1.0)
+        kw = {}
+        rule = case % 5
+        if rule == 1:
+            kw = {"beta": float(rng.choice([1.0, 2.0]))}
+        elif rule == 2:
+            kw = {"beta": 2.0, "round_ms": tuple(sorted(rng.uniform(5, 14, 8)))}
+        elif rule == 3:
+            kw = {"confs": []}
+        elif rule == 4:
+            kw = {"beta": 2.0, "confs": []}
+        yield depth, sampling, float(rng.choice([0.0, 0.1, 0.3, 0.6])), kw
+
+
+def test_chain_equals_mias_under_every_rule(allocations):  # noqa: F811
+    """Our ``Drafter.chain`` against the recipe's (verbatim), on random candidates and selectors: the same drafts and
+    the same confidences under fc (product), fnc (noise-aware product), fcost (best_depth) and the joint allocation's
+    confs (plain and noise-aware); every rule's chain is a prefix of the whole walk."""
+
+    _, dfl = _mods()
+    rng = np.random.default_rng(21)
+    succ, pred = _selector(rng)
+    ours = SimpleNamespace(succ=succ, pred=pred)
+    ref = mia.MiaDrafter()
+    ref.succ, ref.pred = succ, pred
+    cut = 0
+    for depth, sampling, conf, kw in _chain_cases(rng):
+        tokens, values, proj = _candidates(rng, depth, spread=float(rng.choice([0.3, 1.0, 3.0])))
+        anchor, first = int(rng.integers(0, 64)), int(rng.integers(1, 5000))
+        k1 = {k: (list(v) if k == "confs" else v) for k, v in kw.items()}
+        k2 = {k: (list(v) if k == "confs" else v) for k, v in kw.items()}
+        a = dfl.Drafter.chain(ours, tokens, values, proj, anchor, first, sampling, conf, **k1)
+        b = ref.chain(tokens, values, proj, anchor, first, sampling, conf, **k2)
+        assert a == b and k1.get("confs") == k2.get("confs")
+        whole = dfl.Drafter.chain(ours, tokens, values, proj, anchor, first, sampling, 0.0)
+        assert a == whole[:len(a)] and (len(a) >= 1 or "round_ms" in kw)
+        cut += len(a) < len(whole)
+    assert cut > 50                                          # the rules did stop chains early
