+# -- the fake model: the real chain over fake candidates ---------------------------------------------------------------
+class PolicyDrafter(tm.FakeMultiDrafter):
+    """PR #243's fake DFlash2 contexts (taps checked to arrive in order) with the real ``MultiDrafter.propose`` and
+    ``Drafter.chain`` over fake candidates: at each position the fake model's greedy token (wrong every third, as the
+    PR's fake drafter) and K - 1 others, with margins that vary by position, so each rule stops chains at its own
+    depths. Every proposal is logged as (asked depth, beta, round_ms set, drafts)."""
+
+    def __init__(self, torch, streams: int, capacity: int, seed: int = 7) -> None:
+        super().__init__(torch, streams, capacity)
+        from tensorfold.families.glm5_next.cuda.dflash2 import Drafter
+        from tensorfold.families.glm5_next.cuda.dflash2_multi import MultiDrafter
+
+        self._chain, self._propose = Drafter.chain, MultiDrafter.propose
+        self.succ, self.pred = _selector(np.random.default_rng(seed), tm.V)
+        self.log: list[tuple[int, float, bool, int]] = []
+
+    @property
+    def d(self):
+        return self
+
+    def chain(self, *a, **k):
+        return self._chain(self, *a, **k)
+
+    def candidates(self, reqs):
+        torch, out = self.torch, []
+        for c, pending, depth in reqs:
+            seq = [int(v) - 1 for v in c.kc[0][0, :c.context_end, 0].tolist()] + [int(pending)]
+            toks, vals = [], []
+            for k in range(depth):
+                t = int(torch.argmax(tm.pure_logits(torch, seq)))
+                if k % 3 == 2:
+                    t = (t + 1) % tm.V
+                toks.append([t] + [(t + 1 + i) % tm.V for i in range(K - 1)])
+                lead = (9.0, 8.0, 4.0 - 1.5 * ((int(pending) + k) % 3))[k % 3]   # long chains, a softer third pick
+                vals.append([lead, 0.0, -0.4, -1.0])
+                seq.append(t)
+            proj = np.full((depth, 3), 0.05, dtype=np.float32)
+            out.append((np.asarray(toks, dtype=np.int64), np.asarray(vals, dtype=np.float32), proj))
+        return out
+
+    def propose(self, reqs) -> list[list[int]]:
+        got = self._propose(self, reqs)
+        self.proposed += 1
+        self.log += [(r.depth, r.beta, r.round_ms is not None, len(d)) for r, d in zip(reqs, got)]
+        return got
+
+
+class SoloContext(tm.FakeContext):
+    """The single-stream drafter: one of PolicyDrafter's contexts with ``DraftContext.propose``."""
+
+    def propose(self, *a, **k):
+        from tensorfold.families.glm5_next.cuda.dflash2_multi import DraftContext
+
+        return DraftContext.propose(self, *a, **k)
+
