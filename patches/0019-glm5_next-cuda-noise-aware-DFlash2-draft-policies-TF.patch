+def _stats(log) -> dict:
+    return {"rounds": len(log), "drafts": sum(n for *_, n in log), "most": max((n for *_, n in log), default=0),
+            "noisy": sum(1 for _, b, _, _ in log if b > 0), "cost": sum(1 for *_, c, _ in log if c)}
