+def _staggered(p, policies, streams: int = 4):
+    """Five requests admitted as they come (two at once, then one every few rounds, while a slot is free), each with
+    its policy (``policies`` in turn)."""
+
+    d0 = p.d[0] if isinstance(p.d, list) else p.d
+    admitted, pending = [], list(enumerate(REQS))
+    starts = {0: 0, 1: 0, 2: 3, 3: 6, 4: 9}
+    for it in range(4000):
+        while pending and it >= starts[pending[0][0]] and d0.live() < streams:
+            i, (n, seed, kind, count) = pending.pop(0)
+            admitted.append((i, p.submit(tm._prompt(n, seed), count, tm._sampling(kind, seed),
+                                         policy=policies[i % len(policies)])))
+        if not d0.lanes and not pending:
+            break
+        if d0.lanes:
+            p.step()
+        elif getattr(p, "sent", None):
+            p.follow()
+    assert not pending and not d0.lanes
+    return admitted
+
