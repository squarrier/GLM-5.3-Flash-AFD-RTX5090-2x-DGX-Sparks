+def test_the_drafters_pass_the_rule_to_chain(fake):
+    """``MultiDrafter.propose`` (and ``DraftContext.propose`` / ``Drafter.propose`` through it) hands beta and round_ms
+    to ``chain``: its drafts are ``chain``'s with the same rule on the same candidates, and the rules give different
+    drafts somewhere."""
+
+    from tensorfold.engine.exact_sampling import Sampling
+    from tensorfold.families.glm5_next.cuda.dflash2 import Drafter
+    from tensorfold.families.glm5_next.cuda.dflash2_multi import DraftContext, DraftRequest
+
+    torch = fake
+    md = PolicyDrafter(torch, 2, 4 * tm.ALIGN)
+    ctx = md.contexts[0]
+    taps = torch.tensor([[p, t] for p, t in enumerate(tm._prompt(30, 3))], dtype=torch.int64)
+    md.commit([(ctx, taps)])
+    rms = eng_rms = tuple(COSTS["verify"][i] + 1.24 for i in range(8))
+    seen = set()
+    for pending in range(12):
+        for sampling in (None, Sampling(pending, 1.0, 0, 1.0)):
+            for kw in ({}, {"beta": 2.0}, {"beta": 2.0, "round_ms": eng_rms}, {"beta": 0.7, "round_ms": rms}):
+                (tokens, values, proj), = md.candidates([(ctx, pending, 7)])
+                want = Drafter.chain(md, tokens, values, proj, pending, ctx.context_end + 1, sampling, 0.3, **kw)
+                got = md.propose([DraftRequest(ctx, pending, 7, sampling, 0.3, **kw)])[0]
+                assert got == want == DraftContext.propose(ctx, pending, 7, sampling, 0.3, **kw)
+                seen.add((pending, sampling is None, tuple(sorted(kw)), tuple(got)))
+    by_rule: dict = {}
+    for pending, greedy, rule, got in seen:
+        by_rule.setdefault((pending, greedy), set()).add(got)
+    assert any(len(v) > 1 for v in by_rule.values())
