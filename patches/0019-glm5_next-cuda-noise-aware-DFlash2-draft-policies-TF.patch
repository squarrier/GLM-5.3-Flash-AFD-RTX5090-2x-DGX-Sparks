+"""MiaAI-Lab recipe patches 0018 and 0021: DFlash2's noise-aware stop rules (``fncN:P[:B]``,
+``fcostN:noisy[:B]``) and ``TF_GLM_DFLASH_POLICY``, on CPU.
+
+Covered:
+- Mia's reference units (``tests/glm_draft_policy_mia.py``: copied verbatim from the recipe's tree, each pinned by the
+  sha256 of its lines) against ours: ``noisy_confidence``, ``best_depth``, ``round_costs``, ``_encode_noisy``'s codes
+  and refusals, and ``Drafter.chain`` under every rule (fc, fnc, fcost and the joint allocation's confs) on random
+  candidates, greedy and sampled. Every rule's chain is a prefix of the whole walk: the picks never change.
+- The policy codes: every spec the base accepted encodes as before; the new ones decode to the noise-aware
+  ``DepthPolicy`` (``chain_rule``), fcost needs the cost table, and the MTP twins under --parallel keep the MTP rule.
+- ``TF_GLM_DFLASH_POLICY``: read at import (fresh interpreters), unset = fc5:0.3; a non-DFlash2 or malformed value is
+  refused at startup, on the AFD attention node before the wire opens.
+- Drafted replies equal serial replies under each policy on PR #243's fake model, with the real ``MultiDrafter.propose``
+  and ``Drafter.chain`` over fake candidates, so the policy decides where each chain stops: one stream
+  (``dflash_decode`` through ``GlmEngine.generate``), PR #243's streams at two ranks (both ranks agree), its staggered
+  requests with every policy, TF_GLM_KV=fp8's rings, world 1 over the fake AFD wire, and the joint allocation with
+  noise-aware confidences.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib
+import os
+import subprocess
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from tests import glm_draft_policy_mia as mia
+from tests import test_glm_kv8_multi as tk
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+pytestmark = pytest.mark.torch
+fake = tm.fake
+afd_fake = ta.afd_fake
+rings = tk.rings
+
+ROOT = Path(__file__).resolve().parents[1]
+K = 4                                                       # fake candidates per position
+COSTS = {"verify": [9.0, 9.6, 10.1, 10.7, 11.2, 11.8, 12.3, 12.9], "block": 1.2, "taps_row": 0.04}
+POLICIES = ["fc5:0.3", "fnc7:0.3", "fnc7:0.6:1.0", "fnc3:0.0", "fcost7:noisy", "fcost5:noisy:3", "f3"]
+
+
+def _mods():
+    eng = importlib.import_module("tensorfold.families.glm5_next.cuda.engine")
+    dfl = importlib.import_module("tensorfold.families.glm5_next.cuda.dflash2")
+    return eng, dfl
+
+
+# -- Mia's reference units ---------------------------------------------------------------------------------------------
+def test_the_reference_units_are_mias_lines():
+    """tests/glm_draft_policy_mia.py holds each recipe unit's exact lines: the sha256 recorded from the recipe's tree
+    (recorded when the file was generated from the recipe's tree) is the sha256 of the lines in the file."""
+
+    text = (ROOT / "tests" / "glm_draft_policy_mia.py").read_text()
+    for label, (_, lo, hi, digest) in mia.PINS.items():
+        name = label.split(".")[-1]
+        lines = text.splitlines(keepends=True)
+        starts = [i for i, ln in enumerate(lines) if ln.lstrip().startswith((f"def {name}(", f"{name} ="))]
+        assert len(starts) == 1, label
+        i = starts[0]
+        got = "".join(lines[i:i + hi - lo + 1])
+        assert hashlib.sha256(got.encode()).hexdigest() == digest, label
+
+
+def _candidates(rng, depth: int, vocab: int = 64, k: int = K, spread: float = 2.0):
+    tokens = np.stack([rng.choice(vocab, size=k, replace=False) for _ in range(depth)]).astype(np.int64)
+    values = (rng.standard_normal((depth, k)) * spread).astype(np.float32)
+    proj = rng.standard_normal((depth, 3)).astype(np.float32)
+    return tokens, values, proj
+
+
+def _selector(rng, vocab: int = 64):
+    return (rng.standard_normal((vocab, 3)).astype(np.float32), rng.standard_normal((vocab, 3)).astype(np.float32))
+
+
+def test_noisy_confidence_best_depth_and_round_costs_equal_mias(allocations):  # noqa: F811
+    eng, dfl = _mods()
+    rng = np.random.default_rng(18)
+    for _ in range(300):
+        score = rng.standard_normal(rng.integers(2, 9)) * rng.uniform(0.1, 6)
+        noise = None if rng.random() < 0.4 else -np.log(-np.log(rng.uniform(1e-9, 1, score.shape)))
+        j, beta = int(rng.integers(0, score.shape[0])), float(rng.choice([0.5, 1.0, 1.8, 2.0, 3.0]))
+        assert dfl.noisy_confidence(score, noise, j, beta) == mia.noisy_confidence(score, noise, j, beta)
+        q = rng.uniform(0, 1, rng.integers(0, 8))
+        ms = sorted(rng.uniform(5, 15, 8))
+        assert dfl.best_depth(q, ms) == mia.best_depth(q, ms)
+    assert dfl.NOISY_BETA == mia.NOISY_BETA and (dfl.EDGE, dfl.NOISE) == (mia.EDGE, mia.NOISE)
+    assert eng.round_costs(COSTS) == mia.round_costs(COSTS)
+    assert len(eng.round_costs(COSTS)) == len(COSTS["verify"]) == eng.MAX_ROWS
+
+
+def test_the_noise_codes_and_refusals_equal_mias(allocations, monkeypatch):  # noqa: F811
+    """``_encode_noisy``: the same code or the same refusal as the recipe's for N 0..9 (both bound N by 7: here the
+    verify windows ``_calibrate`` times, 1 .. MAX_ROWS = 8 rows; there its captured ones, 1 .. 8), every P and B form."""
+
+    eng, dfl = _mods()
