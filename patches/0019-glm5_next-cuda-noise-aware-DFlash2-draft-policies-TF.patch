+                  f"nc{n}:0.3:1e-7", f"cost{n}:noisy", f"cost{n}:noisy:3", f"cost{n}:quiet", f"cost{n}:noisy:0"]
+    specs += ["nc7", "nc7:0.3:1:2", "nc7:x", "ncx:0.3", "cost7", "cost7:noisy:1:2"]
+    for spec in specs:
