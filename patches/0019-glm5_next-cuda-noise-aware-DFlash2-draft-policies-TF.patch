+@pytest.mark.parametrize("policy", POLICIES)
+def test_one_stream_drafted_replies_equal_serial(fake, monkeypatch, policy):
+    """``dflash_decode`` through ``GlmEngine.generate`` (one stream, two-rank shell): every request's drafted reply
+    under the policy equals its draft:false reply; the rule reached the drafter (beta, round_ms) and set the depths.
+    (A drafted single-stream prompt keeps its state before its last token; the PR's fake prompt chunk has no cut, so
+    the cut is dropped here: each request runs on a fresh engine and nothing resumes from it.)"""
+
+    torch = fake
+    decode = importlib.import_module("tensorfold.families.glm5_next.cuda.decode")
+    chunk = decode.compute
+    monkeypatch.setattr(decode, "compute", lambda w, st, b, R, *, cut=None, **kw: chunk(w, st, b, R, **kw))
+    log_all = []
+    for n, seed, kind, count in REQS:
+        g = tm.shell(torch, 0, pool=16 * tm.ALIGN, streams=1)
+        g._share = lambda values: list(values)
+        owner = PolicyDrafter(torch, 1, 16 * tm.ALIGN)
+        g.drafter = owner.contexts[0] = SoloContext(torch, owner, 0, 16 * tm.ALIGN)
+        g.costs = dict(COSTS)
+        g.request.policy = policy
+        prompt, sampling = tm._prompt(n, seed), tm._sampling(kind, seed)
+        out: list[int] = []
+        stats = g.generate(list(prompt), count, sampling, out.extend)
+        assert out == tm.solo(torch, prompt, count, sampling), (policy, seed)
+        assert stats["drafted"] > 0 and owner.proposed > 0
+        log_all += owner.log
+    s = _stats(log_all)
+    noisy, cost = policy.startswith(("fnc", "fcost")), policy.startswith("fcost")
+    assert (s["noisy"] == s["rounds"]) if noisy else s["noisy"] == 0
+    assert (s["cost"] == s["rounds"]) if cost else s["cost"] == 0
+    assert s["most"] <= int(policy.split(":")[0].lstrip("fncost") or 0) and s["drafts"] > 0
+
