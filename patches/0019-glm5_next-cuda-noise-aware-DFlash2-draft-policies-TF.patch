+def _policy_pair(torch, monkeypatch, streams: int, *, mtp: bool = False, **kw):
+    monkeypatch.setattr(tm, "FakeMultiDrafter", PolicyDrafter)
+    p = tm.Pair(torch, streams=streams, mtp=mtp, **kw)
+    for g in p.g:
+        g.costs = dict(COSTS)
+    return p
