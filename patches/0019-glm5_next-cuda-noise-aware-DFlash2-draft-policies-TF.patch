+    assert eng.encode_policy("fnc7:0.3") == [16, 7, 300000, 2000000]
+    assert eng.encode_policy("fcost7:noisy") == [17, 7, 2000000, 0]
+    for bad in ("fnc8:0.3", "fnc7:2", "fcost7:quiet", "nc7:0.3", "fnc7"):
+        with pytest.raises(ValueError, match="fncN:P"):
