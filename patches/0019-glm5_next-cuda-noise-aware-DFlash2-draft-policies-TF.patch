+    s0, s1 = _stats(p.d[0].drafts.log), _stats(p.d[1].drafts.log)
+    assert s0 == s1 and s0["drafts"] > 0                  # rank 1 drafted the same chains
+    noisy = policy.startswith(("fnc", "fcost"))
+    assert (s0["noisy"] == s0["rounds"]) if noisy else s0["noisy"] == 0
