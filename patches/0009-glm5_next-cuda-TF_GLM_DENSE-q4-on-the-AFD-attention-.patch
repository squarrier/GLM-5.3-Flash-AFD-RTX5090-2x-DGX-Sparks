+@pytest.mark.parametrize("n,k", [(64, 4096), (8192 // 16, 128), (256, 2048)])
+def test_rows_quantize_independently(n, k):
+    g = torch.Generator().manual_seed(n + k)
+    w = (torch.randn(n, k, generator=g) * 0.02).to(torch.bfloat16)
+    whole = _raw(w)
+    halves = [_raw(w[: n // 2]), _raw(w[n // 2:])]
+    for f in range(3):
+        assert torch.equal(whole[f], torch.cat([h[f] for h in halves]))
