+++ b/tests/test_glm_q4dense.py
@@ -0,0 +1,383 @@
+"""TF_GLM_DENSE=q4 on the AFD attention node, on the CPU (no GPU, no network).
+
+Ported from MiaAI-Lab's recipe (github.com/MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks-TensorFold @ cf28cc4, patches
+0002-glm-dense-fp8, 0005-glm-dense-q4, 0013-glm-decode-rounds, 0028-glm-lean-prompt-scratch; Apache License 2.0).
+
+- flag off (unset or ``bf16``): the world-1 attention node's every tensor is byte-identical to the base tree's
+  (``data/glm_q4dense_base_digests.json``: made by this file's ``--digests`` from the split before this port, on the
+  same synthetic checkpoint) and the startup estimate is unchanged;
+- flag on: every projection is the recipe's MSE 4-bit copy of the BF16 weight the flag-off node holds, the head its
+  FP8 copy, kv_b BF16 behind ``absorb`` only, every other tensor unchanged;
+- TP2 vs world 1: rows quantize independently and a column half is whole groups of 64, so the recipe's two ranks'
+  4-bit bytes are the world-1 node's split by the checkpoint split rule;
+- with TF_Q4_FIXTURES (tensors cut from the checkpoint Mia-AiLab/GLM-5.3-Flash-EXL3-4bpw-TensorFold @078455ff;
+  not shipped), our bytes match the recipe tree's own per-rank bytes (``data/glm_q4dense_mia_digests.json``).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import os
+import sys
+from pathlib import Path
+from unittest import mock
+
+import pytest
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+DATA = ROOT / "tests" / "data"
+
+from tensorfold.cuda.geometry import split_weights  # noqa: E402
+from tensorfold.families.glm5_next.cuda import engine, qmm  # noqa: E402
+from tensorfold.families.glm5_next.cuda import split as tsplit  # noqa: E402
+from tensorfold.families.glm5_next.cuda.weights import load  # noqa: E402
+
+
+def _engine_module():
+    """tests/cuda/test_glm_engine.py's synthetic checkpoint builder, imported on a CPU-only host (its module skips
+    without CUDA; the builder itself is numpy)."""
+
+    with mock.patch("torch.cuda.is_available", return_value=True):
+        spec = importlib.util.spec_from_file_location("_glm_engine_ckpt", ROOT / "tests" / "cuda" / "test_glm_engine.py")
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+    return mod
+
+
+class _Event:
+    def synchronize(self) -> None:
+        pass
+
+
+class _Stream:
+    def record_event(self) -> _Event:
+        return _Event()
+
+
+def _load_cpu(path: Path, dense: str | None, **kw):
+    """The loader on the CPU: its per-layer CUDA events stubbed, TF_GLM_DENSE as given (None: unset)."""
+
+    env = {k: v for k, v in os.environ.items() if k != "TF_GLM_DENSE"}
+    if dense is not None:
+        env["TF_GLM_DENSE"] = dense
+    with mock.patch.dict(os.environ, env, clear=True), \
+            mock.patch("torch.cuda.current_stream", return_value=_Stream()):
+        return load(path, device="cpu", **kw)
+
+
+def digests(obj, prefix: str = "") -> dict[str, list]:
+    """Every tensor reachable from a Weights object: path -> [dtype, shape, sha256]; ints and None recorded too."""
+
+    out: dict[str, list] = {}
+
+    def walk(x, p: str) -> None:
+        if isinstance(x, torch.Tensor):
+            raw = x.detach().reshape(-1).contiguous().cpu().view(torch.uint8)
+            out[p] = [str(x.dtype), list(x.shape), hashlib.sha256(raw.numpy().tobytes()).hexdigest()]
+        elif x is None or isinstance(x, (bool, int, float, str)):
+            out[p] = [type(x).__name__, repr(x)]
+        elif isinstance(x, (list, tuple)):
+            for i, v in enumerate(x):
+                walk(v, f"{p}.{i}")
+        elif isinstance(x, dict):
+            for k in sorted(x, key=str):
+                walk(x[k], f"{p}.{k}")
+        elif hasattr(x, "__dict__"):
+            out[p + ".__class__"] = [type(x).__name__]
+            for k, v in sorted(vars(x).items()):
+                if k in ("cfg", "comm", "meta", "rd") or callable(v):
+                    continue
+                walk(v, f"{p}.{k}" if p else k)
+
+    walk(obj, prefix)
+    return out
+
