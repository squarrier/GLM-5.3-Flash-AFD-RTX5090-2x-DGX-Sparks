+def test_stack_rows_map_to_rank_stacks():
+    """A stack (KDA [q | k | v | f_a | g_a | b]) on world 1 vs each rank's stack of its row halves and the replicated
+    parts: the same rows, quantized the same."""
+
+    g = torch.Generator().manual_seed(5)
+    parts = {name: (torch.randn(n, 512, generator=g) * 0.02).to(torch.bfloat16)
+             for name, n in (("q", 256), ("k", 256), ("v", 256), ("f_a", 128), ("g_a", 128), ("b", 64))}
+    kinds = {"q": "row", "k": "row", "v": "row", "f_a": "rep", "g_a": "rep", "b": "row"}
+    whole = qmm.to_mlx(qmm.stack_dense_q4(list(parts.values())))
+    ranks = []
+    for r in (0, 1):
+        rp = [t[r * t.shape[0] // 2:(r + 1) * t.shape[0] // 2] if kinds[k] == "row" else t for k, t in parts.items()]
+        ranks.append(qmm.to_mlx(qmm.stack_dense_q4(rp)))
+    wo, ro = 0, [0, 0]
+    for k, t in parts.items():
+        n = t.shape[0]
+        for r in (0, 1):
+            take = n // 2 if kinds[k] == "row" else n
+            src = slice(ro[r], ro[r] + take)
+            dst = slice(wo + (r * n // 2 if kinds[k] == "row" else 0), wo + (r * n // 2 if kinds[k] == "row" else 0) + take)
+            for f in range(3):
+                assert torch.equal(ranks[r][f][src], whole[f][dst]), (k, r, f)
+            ro[r] += take
+        wo += n
+
