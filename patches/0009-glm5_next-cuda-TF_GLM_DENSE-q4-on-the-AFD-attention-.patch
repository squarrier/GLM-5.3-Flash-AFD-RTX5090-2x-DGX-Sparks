+def test_q4_objects_are_the_recipe_copies_of_the_bf16_weights(nodes):
+    off, on = nodes["bf16"], nodes["q4"]
+    n = 0
+    for (p, b), (p2, q) in zip(_projections(off), _projections(on)):
+        assert p == p2
+        assert isinstance(b, qmm.B16), p
+        if b.k % 64 == 0:
+            assert isinstance(q, qmm.Q4), p
+            w, s, z = qmm.to_mlx(q)
+            rw, rs, rz = qmm.quantize4_mse_raw(b.weight)
+            assert torch.equal(w, rw) and torch.equal(s, rs) and torch.equal(z, rz), p
+        else:                                      # make_dense_q4's fallback (the recipe's): FP8 for K % 64
+            assert type(q).__name__ in ("F8", "B16"), p
+        n += 1
+    assert n >= 10
+    assert isinstance(on.head, qmm.F8)
+    ref = qmm.make_f8(off.head.weight)
+    assert torch.equal(on.head.weight.view(torch.uint8), ref.weight.view(torch.uint8))
+    assert torch.equal(on.head.scale, ref.scale)
+    # the draft head: the same 4-bit minmax copy in both modes
+    assert all(torch.equal(getattr(on.draft_head, f), getattr(off.draft_head, f)) for f in ("weight", "scales", "biases"))
