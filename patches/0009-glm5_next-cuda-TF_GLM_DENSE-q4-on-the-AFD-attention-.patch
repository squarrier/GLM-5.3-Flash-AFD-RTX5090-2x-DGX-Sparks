+# -- the checkpoint's own tensors (opt-in: TF_Q4_FIXTURES) ---------------------------------------------------------
+
+FIX = os.environ.get("TF_Q4_FIXTURES")
+
+
+def _fixture(name: str) -> tuple[torch.Tensor, dict]:
+    meta = json.loads((Path(FIX) / f"{name}.json").read_text())
+    raw = (Path(FIX) / f"{name}.bin").read_bytes()
+    assert hashlib.sha256(raw).hexdigest() == meta["sha256"], name
+    rows = meta["rows"][1] - meta["rows"][0]
+    return torch.frombuffer(bytearray(raw), dtype=torch.bfloat16).view(rows, *meta["full_shape"][1:]), meta
+
+
+def _sha(t: torch.Tensor) -> str:
+    t = t.contiguous()
+    return hashlib.sha256(t.view(torch.uint8).numpy().tobytes()).hexdigest()
+
+
+def _fields(q) -> dict[str, torch.Tensor]:
+    if isinstance(q, qmm.Q4):
+        return dict(zip(("q4_words", "q4_scales", "q4_biases"), qmm.to_mlx(q)))
+    return {"f8_weight": q.weight, "f8_scale": q.scale}
+
+
+@pytest.mark.skipif(not FIX, reason="TF_Q4_FIXTURES: checkpoint fixtures (not shipped)")
+def test_checkpoint_tensors_match_the_recipe_ranks_bytes():
+    """Our world-1 bytes, cut as the recipe's TP2 ranks cut the tensor, against the sha256 of the bytes the recipe
+    tree itself built per rank (TF v0.6.0 + recipe @cf28cc4, CPU arithmetic, harness/q4_identity.py)."""
+
+    gold = json.loads((DATA / "glm_q4dense_mia_digests.json").read_text())
+    checked = 0
+    for case in gold["cases"]:
+        key, kind = case["key"], case["kind"]
+        if kind == "head":
+            t, meta = _fixture(key)
+            got = {**_fields(qmm.make_f8(t)), **{"draft_" + k: v for k, v in _fields(qmm.quantize4(t)).items()}}
+            a = meta["rows"][0]
+            for r, (lo, hi) in case["rank_rows"].items():
+                for f, sha in case["ranks"][r].items():
+                    assert _sha(got[f][lo - a:hi - a]) == sha, (key, r, f)
+                    checked += 1
+            continue
+        names = case["parts"]
+        tensors = [_fixture(n)[0] for n in names]
+        q = qmm.stack_dense_q4(tensors) if len(names) > 1 else qmm.make_dense_q4(tensors[0])
+        got = _fields(q)
+        rules = [tsplit.rule(n) for n in names]
+        for r in ("0", "1"):
+            for f, sha in case["ranks"][r].items():
+                x = got[f]
+                if len(names) == 1 and rules[0] == "col":
+                    h = x.shape[1] // 2
+                    piece = x[:, int(r) * h:(int(r) + 1) * h]
+                else:                                     # rows: each part's half (row) or all of it (rep)
+                    rows, off = [], 0
+                    for t, rule in zip(tensors, rules):
+                        n = t.shape[0]
+                        rows.append(x[off + int(r) * n // 2: off + (int(r) + 1) * n // 2] if rule == "row"
+                                    else x[off:off + n])
+                        off += n
+                    piece = torch.cat(rows)
+                assert _sha(piece) == sha, (key, r, f)
+                checked += 1
+    assert checked == gold["arrays"]
+
