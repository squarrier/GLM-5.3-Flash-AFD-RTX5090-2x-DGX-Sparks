     if isinstance(q, B16):
         return _matmul_b16(x, q, out=out, f32=f32, part=part)
+    if isinstance(q, F8):                 # TF_GLM_DENSE=q4's head (MiaAI-Lab patch 0002)
+        return _matmul_f8(x, q, out=out, f32=f32, part=part)
