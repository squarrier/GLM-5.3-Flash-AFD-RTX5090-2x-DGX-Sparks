+@pytest.mark.parametrize("n,k", [(128, 8192), (64, 12288), (96, 2048), (64, 16384)])
+def test_column_halves_are_whole_groups(n, k):
+    """The recipe's column split (o_proj, down_proj) cuts K in halves; K / 2 is a multiple of 64 for every such
+    tensor of the checkpoint, so each half's groups are the whole tensor's."""
+
+    g = torch.Generator().manual_seed(n * k)
+    w = (torch.randn(n, k, generator=g) * 0.02).to(torch.bfloat16)
+    whole = _raw(w)
+    left, right = _raw(w[:, : k // 2].contiguous()), _raw(w[:, k // 2:].contiguous())
+    for f in range(3):
+        assert torch.equal(whole[f], torch.cat([left[f], right[f]], dim=1))
