+def prompt_split_k(w: Weights) -> bool:
+    """Whether a prompt chunk's projections take split-K partials: an EXL3 checkpoint's BF16 ones do; 4-bit ones (an
+    MLX checkpoint, TF_GLM_DENSE=q4, read off the first layer's input projection) run without. (MiaAI-Lab recipe
+    patch 0028-glm-lean-prompt-scratch, Apache-2.0.)"""
