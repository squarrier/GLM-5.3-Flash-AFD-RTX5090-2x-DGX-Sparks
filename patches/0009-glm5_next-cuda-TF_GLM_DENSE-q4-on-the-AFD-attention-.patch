+def _projections(w):
+    """(path, object) of every matrix the loader builds through q4() / stack() (what TF_GLM_DENSE converts): the
+    B16 / Q4 / F8 fields of each layer's KDA, DSA and its indexer (TF 0.6.3's IndexW: kw = [wk | weights_proj], qb =
+    wq_b), dense MLP and shared expert; kv_k / kv_v (kv_b's per-head copies) are not among them."""
+
+    mats = (qmm.Q4, qmm.B16, qmm.F8)
+    for i, layer in enumerate(w.layers):
+        subs = []
+        if layer.kda is not None:
+            subs.append(("kda", layer.kda))
+        if layer.dsa is not None:
+            subs += [("dsa", layer.dsa), ("dsa.index", layer.dsa.index)]
+        if layer.mlp is not None:
+            subs.append(("mlp", layer.mlp))
+        if layer.moe is not None and layer.moe.shared is not None:
+            subs.append(("moe.shared", layer.moe.shared))
+        for label, o in subs:
+            for k, v in vars(o).items():
+                if k not in ("kv_k", "kv_v") and isinstance(v, mats):
+                    yield f"layers.{i}.{label}.{k}", v
+
