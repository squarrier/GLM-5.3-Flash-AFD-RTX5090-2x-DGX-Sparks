+def test_the_admit_carries_the_points(fake):
+    """Rank 0's points ride in the ADMIT, inside its sealed message; rank 1 keeps the same states."""
+    from tensorfold.families.glm5_next.cuda.multi import ADMIT, SHARED_SLOTS, MultiDecoder, unseal
+
+    p = tm.Pair(fake, streams=2, blocks=8)
+    sharing(p.g)
+    sent: list = []
+    real = p.g[0]._share
+    p.g[0]._share = lambda values: (sent.append(list(values)), real(values))[1]
+    load, _, _ = shapes()
+    at = len(HEAD) + 600
+    p.submit(load, 4, None)
+    p.run()
+    p.check()
+    admits = [a for op, a in MultiDecoder.parse(unseal(sent[0], 0)) if op == ADMIT]
+    assert len(admits) == 1 and len(admits[0]) == 9 + 10 + SHARED_SLOTS + 4 + 1 + len(load) + 1
+    assert admits[0][19:19 + SHARED_SLOTS] == [at, 0] and MultiDecoder._parse_admit(admits[0])["shared"] == [at]
+    for d in p.d:
+        assert [(len(k.ids), k.shared) for k in d.kept] == [(at, True), (len(load) - 1, False)]
+
