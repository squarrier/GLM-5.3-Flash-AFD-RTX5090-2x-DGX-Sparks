+def test_single_stream_dflash2_resumes_a_saved_shared_state_with_its_window(fake, monkeypatch):
+    """Another conversation takes the live caches: the kept states' rows are saved with DFlash2's window, and DFlash2
+    requests later resume them, the shared-prefix state included (the recording prefill checks that a resume finds its
+    rows and its window in place). Off, a saved state drops the window, so a DFlash2 request cannot resume it."""
+
+    load, inference, _ = shapes()
+    other = benchy(tm._prompt(900, 3), [DOT])
+    at = len(HEAD) + 600
+    on = Single(fake, monkeypatch)
+    sharing([on.g])
+    assert [on.ask(load), on.ask(other)] == [0, 0]
+    saved = [c for c in on.g.cache if c.rows is not None]
+    assert [len(c.ids) for c in saved] == [at, len(load) - 1] and all(c.drafter_end == len(c.ids) for c in saved)
+    assert all(len(c.rows) == 3 for c in saved)                   # attention rows, DFlash2's keys and values
+    assert on.ask(inference) == at                                # the saved shared-prefix state, with its window
+    assert on.ask(load) == len(load) - 1                          # a saved own state, with its window
+    off = Single(fake, monkeypatch)
+    assert [off.ask(load), off.ask(other)] == [0, 0]
+    assert [(len(c.ids), c.drafter_end, len(c.rows)) for c in off.g.cache if c.rows is not None] == \
+        [(len(load) - 1, -1, 1)]
+    assert [off.ask(load), off.ask(inference)] == [0, 0]
+
