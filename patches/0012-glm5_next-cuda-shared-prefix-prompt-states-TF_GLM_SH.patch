+# -- the single-stream engine: replies on the multi-stream tests' fake model --------------------------------------
+def _cut_compute(monkeypatch):
+    """The fake prompt chunk with ``decode.prefill``'s cut inside it (the kept point of a drafted prompt): the state
+    and conv window at the cut row, then the rest of the chunk."""
+    decode = importlib.import_module("tensorfold.families.glm5_next.cuda.decode")
+    chunk = decode.compute
+
+    def compute(w, st, b, R, *, nch=None, host_pos=None, cut=None, **kw):
+        if cut is None:
+            return chunk(w, st, b, R, nch=nch, host_pos=host_pos, **kw)
+        torch = b.engine.torch
+        before = list(st.conv.tolist())
+        h = st.h()
+        for i, t in enumerate(b.ids):
+            q = st.pos + i
+            st.write(q, t)
+            h = tm.fold(h, q, t)
+            if i + 1 == cut.point:
+                cut.rec[0] = h
+                cut.conv.copy_(torch.tensor(([0, 0, 0] + before + b.ids[:cut.point])[-3:]))
+        cur = st.cur[0]
+        st.rec[1 - cur][0] = h
+        st.cur = [1 - cur]
+        st.conv.copy_(torch.tensor(([0, 0, 0] + before + b.ids)[-3:]))
+        b.taps = torch.tensor([[st.pos + i, t] for i, t in enumerate(b.ids)], dtype=torch.int64)
+        b.fnormed = b.taps.clone()
+        return st.logits(st.pos + R - 1, h)[None]
+
+    monkeypatch.setattr(decode, "compute", compute)
+
+
+def _engine(torch, *, prefill_rows: int = 64):
+    g = tm.shell(torch, 0, pool=16 * tm.ALIGN, streams=1, prefill_rows=prefill_rows, mtp=True)
+    g._share = lambda values: list(values)
+    from tensorfold.families.glm5_next.cuda.decode import has_rings
+
+    st = g.e.st                                   # what _row_views saves: every plane the fake's logits read
+    if not has_rings(st):
+        st.index = [(st.lat, st.lat, st.pk)]
+    st.mtp_kc = st.mtpv
+    g.request.policy = "2"                        # MTP drafts (the fake's single-stream drafter)
+    return g
+
+
+def _ask(g, prompt, count: int, sampling=None):
+    out: list[int] = []
+    stats = g.generate(list(prompt), count, sampling, out.extend)
+    return stats["cached"], out
+
+
+@pytest.mark.parametrize("fp8", [False, True], ids=["bf16", "fp8-rings"])
+def test_single_stream_replies_equal_their_solo_replies(fake, monkeypatch, request, fp8):
+    if fp8:
+        request.getfixturevalue("rings")
+    torch = fake
+    _cut_compute(monkeypatch)
+    load, inference, prompt = shapes()
+    at = len(HEAD) + 600
+    g = _engine(torch)
+    sharing([g])
+    first = _ask(g, load, 12)
+    assert first[0] == 0 and [len(c.ids) for c in g.cache] == [at, len(load) - 1]
+    other = benchy(tm._prompt(500, 4), [DOT])                        # another conversation takes the caches
+    assert _ask(g, other, 8)[0] == 0
+    cached, got = _ask(g, inference, 20)
+    assert cached == at and got == tm.solo(torch, inference, 20, None)
+    turn = load + first[1] + [USER] + prompt + TAIL
+    cached, got = _ask(g, turn, 20, tm._sampling("topk", 3))
+    assert cached == len(load) - 1 and got == tm.solo(torch, turn, 20, tm._sampling("topk", 3))
+    assert first[1] == tm.solo(torch, load, 12, None)
