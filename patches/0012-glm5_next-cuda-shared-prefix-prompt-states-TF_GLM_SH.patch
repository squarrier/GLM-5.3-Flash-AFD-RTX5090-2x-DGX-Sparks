+@pytest.mark.parametrize("rule", ["cap_victim", "oldest"])
+def test_the_cap_drops_a_conversations_superseded_states_first(fake, monkeypatch, rule):
+    """TF_GLM_CACHE_ENTRIES=3 (recipe patch 0063): a conversation that takes turns drops its own earlier turns, not the
+    only state of another conversation (the oldest), which then still resumes; both ranks drop the same ones. The
+    oldest-first rule before it dropped the other conversation's state."""
+    from tensorfold.families.glm5_next.cuda import multi
+
+    if rule == "oldest":
+        monkeypatch.setattr(multi, "cap_victim", lambda kept: kept[0])
+    p = tm.Pair(fake, streams=2, blocks=8, entries=3)
+    other = tm._prompt(300, 21)
+    p.submit(other, 6, None)
+    p.run()
+    convo, before = tm._prompt(200, 22), 0
+    for turn in range(3):
+        s = p.submit(convo, 6, None)
+        assert s.cached == max(before - 1, 0)
+        p.run()
+        p.check()
+        before, convo = len(convo), convo + s.got + tm._prompt(5, 30 + turn)
+    kept = [len(k.ids) for k in p.d[0].kept]
+    assert len(kept) == 3 and ((len(other) - 1 in kept) == (rule == "cap_victim"))
+    again = other + tm._prompt(4, 40)
+    s = p.submit(again, 6, None)
+    assert s.cached == (len(other) - 1 if rule == "cap_victim" else 0)
+    p.run()
+    p.check()
+    assert s.got == tm.solo(fake, again, 6, None)
