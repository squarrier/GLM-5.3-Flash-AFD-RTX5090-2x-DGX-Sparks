+def test_single_stream_rank1_keeps_the_same_states(fake, monkeypatch):
+    """Rank 1 takes the points from the header and keeps, saves and resumes alike."""
+
+    class Stop(Exception):
+        pass
+
+    load, inference, prompt = shapes()
+    r0, r1 = Single(fake, monkeypatch), Single(fake, monkeypatch, rank=1)
+    sharing([r0.g, r1.g])
+    rounds = []
+    for p in (load, benchy(tm._prompt(700, 9), [DOT]), inference, load + [11] + [USER] + prompt + TAIL):
+        monkeypatch.setattr(r0.decode, "prefill", r0.prefill)
+        r0.ask(p)
+        monkeypatch.setattr(r1.decode, "prefill", r1.prefill)
+        bell = iter([None])
+        r1.g._share = lambda values: r0.sent.pop(0)
+
+        def await_once(bell=bell):
+            try:
+                next(bell)
+            except StopIteration:
+                raise Stop from None
+
+        r1.g._await_bell = await_once
+        with pytest.raises(Stop):
+            r1.g.follow()
+        rounds.append((r0.kept(), r1.kept()))
+    assert all(a == b for a, b in rounds) and r0.calls == r1.calls and not r0.sent
+    assert [c.rows is None for c in r0.g.cache] == [c.rows is None for c in r1.g.cache]
+
