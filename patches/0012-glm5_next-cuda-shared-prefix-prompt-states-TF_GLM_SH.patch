+# -- the multi-stream engine (two ranks, world 1, fp8 rings) --------------------------------------------------------
+def scenario(torch, node, policy: str, gs) -> dict:
+    """llama-benchy's two requests, then the context load's next turn: on, the inference request resumes the system
+    block; every reply equals its request served alone."""
+    sharing(gs)
+    load, inference, prompt = shapes()
+    at = len(HEAD) + 600
+    first = node.submit(load, 12, None, policy=policy)
+    node.run()
+    d = node.d[0] if isinstance(node.d, list) else node.d
+    assert first.cached == 0 and [(len(k.ids), k.shared) for k in d.kept] == [(at, True), (len(load) - 1, False)]
+    turn = load + first.got + [USER] + prompt + TAIL
+    nxt = node.submit(turn, 20, tm._sampling("topk", 3), policy=policy)
+    assert nxt.cached == len(load) - 1                               # the kept prompt plus a new suffix, as before
+    node.run()
+    assert nxt.got == tm.solo(torch, turn, 20, tm._sampling("topk", 3))
+    phase2 = node.submit(inference, 20, None, policy=policy)
+    assert phase2.cached == at                                       # the whole system block
+    node.run()
+    assert phase2.got == tm.solo(torch, inference, 20, None)
+    again = node.submit(benchy(tm._prompt(600, 500), tm._prompt(64, 9)), 16, None, policy=policy)
+    assert again.cached == at
+    node.run()
+    assert again.got == tm.solo(torch, again.prompt, 16, None)
+    assert first.got == tm.solo(torch, load, 12, None)
+    return {"kept": sorted(len(k.ids) for k in d.kept), "at": at}
+
