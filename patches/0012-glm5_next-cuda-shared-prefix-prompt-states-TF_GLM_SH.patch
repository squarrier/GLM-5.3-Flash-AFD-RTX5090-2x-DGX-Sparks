--- /dev/null
+++ b/tests/test_glm_shared_prefix.py
@@ -0,0 +1,506 @@
+"""TF_GLM_SHARED_PREFIX: shared-prefix prompt states (MiaAI-Lab recipe patches 0015 and 0063, with 0030's shared-prefix
+parts), on the CPU.
+
+llama-benchy's prefix-caching mode sends ``[system: C, user: "."]``, then ``[system: C, user: P]``. Rendered by the GLM
+chat template, the second prompt parts from the first right after its first ``<|user|>``, before the first prompt's
+kept state (its length less one), so the kept-prompt rule alone prefills the whole context again. With the setting
+on, a drafted request also keeps its state at the end of its system block (its first ``<|user|>``) and where it stops
+sharing a kept prompt; the second request then resumes the whole system block, and its reply is the one it gets
+served alone (``draft: false``).
+
+Covered: the setting, ``shared_points``, ``user_opener``, ``cap_victim``'s order, saved rows that keep DFlash2's window;
+the single-stream engine (kept states and cached counts, rank 1 alike, a DFlash2 request resumed from a saved
+shared-prefix state with its window, replies on the multi-stream tests' fake model, with and without TF_GLM_KV=fp8's
+rings); the multi-stream engine at two ranks (DFlash2 and MTP drafts), at world 1 over the fake AFD wire
+(``afd.Solo``), with fp8 rings, and the kept-state cap at two ranks; with the setting off, the cached counts and kept
+states of the same requests as before.
+"""
+
+from __future__ import annotations
+
+import importlib
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tests import test_glm_kv8_multi as tk
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+pytestmark = pytest.mark.torch
+
+fake = tm.fake
+afd_fake = ta.afd_fake
+rings = tk.rings
+
+HEAD, USER, DOT, TAIL = [40, 41, 42], 43, 44, [45, 46, 39]      # [gMASK]<sop><|system|>, <|user|>, ".", the tail
+LEAST = 256                                                       # TF_GLM_SHARED_PREFIX=1
+
+
+def benchy(context, user):
+    return HEAD + list(context) + [USER] + list(user) + TAIL
+
+
+def shapes(seed: int = 500, n: int = 600):
+    """llama-benchy's context load and inference request on one context, and its prompt."""
+    context, prompt = tm._prompt(n, seed), tm._prompt(64, seed + 1)
+    return benchy(context, [DOT]), benchy(context, prompt), prompt
+
+
+def sharing(gs, least: int = LEAST, opener: int | None = USER) -> None:
+    """TF_GLM_SHARED_PREFIX on these engines (every rank); rank 0 knows ``<|user|>``."""
+    for g in gs:
+        g.shared, g.opener = least, opener if g.rank == 0 else None
+
+
+# -- the setting and the points -------------------------------------------------------------------------------------
+def test_the_setting(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import engine
+
+    monkeypatch.delenv("TF_GLM_SHARED_PREFIX", raising=False)
+    assert engine.shared_prefix() == 0 and engine.GlmEngine.shared == 0 and engine.GlmEngine.grid == 0
+    for value, want in [("", 0), ("0", 0), ("off", 0), (" OFF ", 0), ("1", 256), ("on", 256), ("16", 16),
+                        ("4096", 4096)]:
+        assert engine.shared_prefix(value) == want, value
+    for bad in ("2", "15", "-1", "x", "1.5"):
+        with pytest.raises(ValueError, match="TF_GLM_SHARED_PREFIX"):
+            engine.shared_prefix(bad)
+    monkeypatch.setenv("TF_GLM_SHARED_PREFIX", "1")
+    assert engine.shared_prefix() == engine.SHARED_DEFAULT == 256
+
+
+def test_shared_points():
+    from tensorfold.families.glm5_next.cuda.engine import SHARED_MOST, common_prefix, shared_points
+
+    load, inference, _ = shapes()
+    at = len(HEAD) + 600                                          # the first <|user|>: the system block's end
+    own = len(inference) - 1
+    assert common_prefix(load, inference) == at + 1 and common_prefix([], load) == 0
+    assert shared_points(inference, 0, own, 0, LEAST, [], USER) == [at]                    # exact, no grid
+    assert shared_points(inference, 0, own, 64, LEAST, [], USER) == [at // 64 * 64]       # the recipe's grid
+    assert shared_points(inference, at - LEAST + 1, own, 0, LEAST, [], USER) == []         # adds too little
+    assert shared_points(inference, 0, at, 0, LEAST, [], USER) == []                       # not short of its point
+    assert shared_points(inference, 0, None, 0, LEAST, [], USER) == []
+    assert shared_points(inference, 0, own, 0, 0, [], USER) == []                          # off
+    assert shared_points(inference, 0, own, 0, LEAST, [], None) == []                      # no <|user|> known
+    # where it stops sharing a kept prompt, and the system block's end, each LEAST past the one before
+    other = inference[:300] + [99] * 400
+    assert shared_points(inference, 0, own, 0, LEAST, [other], USER) == [300, at]
+    assert shared_points(inference, 0, own, 0, 301, [other], USER) == [at]                 # 300 adds too little
+    assert shared_points(inference, 0, own, 0, LEAST, [inference[:500] + [99] * 400], USER) == [500]   # 603: 103
+    assert shared_points(inference, 0, own, 0, LEAST, [other[:LEAST - 1]], USER) == [at]  # too short to count
+    assert shared_points(inference, 0, own, 0, LEAST, [load], USER) == [at]                # shares at + 1: one
+    assert len(shared_points(inference, 0, own, 0, 16, [other, load], USER)) <= SHARED_MOST
+
+
+def test_user_opener(tmp_path):
+    from tensorfold.families.glm5_next.cuda.engine import user_opener
+
+    assert user_opener(tmp_path) is None
+    (tmp_path / "tokenizer.json").write_text("{not json")
+    assert user_opener(tmp_path) is None
+    (tmp_path / "tokenizer.json").write_text(json.dumps({"added_tokens": [
+        {"id": 154820, "content": "[gMASK]"}, {"id": 154827, "content": "<|user|>"},
+        {"id": 154828, "content": "<|assistant|>"}]}))
+    assert user_opener(tmp_path) == 154827
+
+
+def test_cap_victim_order():
+    """Past TF_GLM_CACHE_ENTRIES (least recently used first): a conversation's superseded states (shorter than another
+    in its extent), the oldest that is not a shared-prefix state, then the oldest of those; then the oldest."""
+    from tensorfold.families.glm5_next.cuda.multi import cap_victim
+
+    x, y = SimpleNamespace(), SimpleNamespace()
+
+    def kept(n, extent, shared=False):
+        return SimpleNamespace(ids=list(range(n)), extent=extent, shared=shared)
+
+    a, b, c, d = kept(10, x), kept(20, x, True), kept(30, x), kept(5, y)
+    assert cap_victim([d, a, b, c]) is a
+    assert cap_victim([d, b, a, c]) is a                                  # a non-shared one before an older shared
+    assert cap_victim([d, b, c]) is b
+    assert cap_victim([d, c]) is d                                        # nothing superseded: the oldest
+    assert cap_victim([kept(5, y)]).ids == list(range(5))
+
+
+@pytest.mark.parametrize("ring", [False, True], ids=["flat", "ring"])
+def test_saved_rows_keep_the_drafters_window(fake, ring):
+    """``save_rows`` with the drafter copies DFlash2's window rows with the attention rows and keeps the snapshot's
+    drafter end; ``load_rows`` puts both back. Without it (the setting off) the window is dropped, as before."""
+    torch = fake
+    from tensorfold.families.glm5_next.cuda.decode import Snapshot, load_rows, row_bytes, save_rows
+
+    window, n = 6, 40
+    st = SimpleNamespace(kc=[torch.arange(64, dtype=torch.int64)[:, None] + 1], vc=[None], index=None, caches=None)
+    cap = 16 if ring else 64
+    d = SimpleNamespace(window=window, ring=cap if ring else 0,
+                        kc=[torch.arange(cap, dtype=torch.int64)[None, :, None] + 100],
+                        vc=[torch.arange(cap, dtype=torch.int64)[None, :, None] + 200])
+    e = SimpleNamespace(st=st)
+
+    def snap():
+        s = Snapshot(list(range(n)), torch.zeros(1), torch.zeros(3), None, -1, n)
+        s.drafter_rows = [torch.zeros(1)] if ring else None
+        return s
+
+    off = snap()
+    save_rows(e, off)
+    assert off.drafter_end == -1 and off.drafter_rows is None and len(off.rows) == 1
+    on = snap()
+    lo = n - window - 1
+    if ring:      # past the ring the window lives in the snapshot's own copy (drafter_rows), which save_rows keeps
+        assert row_bytes(e, on, drafter=d) == row_bytes(e, on) and d.kc[0][:, lo:n].numel() == 0
+    else:         # a flat context: the window's rows are copied out with the attention rows
+        assert row_bytes(e, on, drafter=d) == row_bytes(e, on) + 2 * (n - lo) * 8
+    save_rows(e, on, drafter=d)
+    assert on.drafter_end == n and len(on.rows) == 3 and (on.drafter_rows is not None) == ring
+    want_k, want_v = d.kc[0][:, lo:n].clone(), d.vc[0][:, lo:n].clone()
+    st.kc[0].zero_()
+    d.kc[0].zero_()
+    d.vc[0].zero_()
+    load_rows(e, on, drafter=d)
+    assert torch.equal(st.kc[0][:n, 0], torch.arange(n) + 1)
+    assert torch.equal(d.kc[0][:, lo:n], want_k) and torch.equal(d.vc[0][:, lo:n], want_v)
+    with pytest.raises(ValueError, match="do not match"):
+        load_rows(e, on)                                  # rows saved with the window go back with it
+
+
+# -- the single-stream engine: bookkeeping ------------------------------------------------------------------------
+class Single:
+    """``GlmEngine``'s single-stream bookkeeping as it is (generate, _resume, _shared, _run_once, _remember, _take_over;
+    rank 1's follow), the real save_rows / load_rows, with a prefill that records its calls and writes the rows a real
+    one writes: one attention row a token (token + 1) and, drafting with DFlash2, a flat context row a token. It checks
+    every resume finds its prefix's rows, and its DFlash2 window, in place."""
+
+    def __init__(self, torch, monkeypatch, *, rank: int = 0, rows: int = 4096, window: int = 6) -> None:
+        from tensorfold.families.glm5_next.cuda import decode
+        from tensorfold.families.glm5_next.cuda.engine import GlmEngine
+
+        self.torch, self.calls, self.window = torch, [], window
+        g = self.g = GlmEngine.__new__(GlmEngine)
+        g.rank, g.limit, g.serial_only, g.policy = rank, rows - 64, False, "0"
+        g.cache, g.live, g.cache_bytes, g.cache_entries = [], [], 1 << 40, 8
+        st = SimpleNamespace(kc=[torch.zeros((rows, 1), dtype=torch.int64)], vc=[None], index=None, caches=None)
+        g.e = SimpleNamespace(st=st, constraint=None, window=None)
+        g.w = SimpleNamespace(cfg=SimpleNamespace(quant="exl3", eos=(1,)), mtp=object())
+        g.drafter = SimpleNamespace(window=window, ring=0, kc=[torch.zeros((1, rows, 1), dtype=torch.int64)],
+                                    vc=[torch.zeros((1, rows, 1), dtype=torch.int64)])
+        g.scheduler = None
+        g.request = SimpleNamespace(policy="f3", stop_eos=True)
+        g._ring = lambda: None
+        self.sent: list = []
+        g._share = lambda values: (self.sent.append(list(values)), list(values))[1]
+        self.decode = decode
+        monkeypatch.setattr(decode, "prefill", self.prefill)
+
+    def prefill(self, e, prompt, sampling, *, mtp=True, drafter=None, resume=None, keep_at=None, keep=None,
+                sample=True):
+        torch, d = self.torch, self.g.drafter
+        begin = len(resume.ids) if resume is not None else 0
+        if resume is not None:
+            assert list(prompt[:begin]) == resume.ids and begin < len(prompt)
+            ids = torch.tensor(resume.ids, dtype=torch.int64) + 1
+            assert torch.equal(e.st.kc[0][:begin, 0], ids), "a resume without its rows"
+            if drafter is not None:
+                assert resume.drafter_end == begin
+                lo = max(0, begin - self.window - 1)
+                assert torch.equal(d.kc[0][0, lo:begin, 0], ids[lo:]), "a DFlash2 resume without its window"
+        tokens = torch.tensor(list(prompt[begin:]), dtype=torch.int64) + 1
+        e.st.kc[0][begin:len(prompt), 0] = tokens
+        if drafter is not None:
+            d.kc[0][0, begin:len(prompt), 0] = tokens
+            d.vc[0][0, begin:len(prompt), 0] = tokens
+        self.calls.append((len(prompt), begin, keep_at, sample))
+        if keep_at is not None:
+            assert keep is not None and begin <= keep_at <= len(prompt)
+            keep(resume if keep_at == begin else self.decode.Snapshot(
+                list(prompt[:keep_at]), torch.zeros(1), torch.zeros(3), torch.zeros((1, 1)) if mtp else None,
+                keep_at - 1 if mtp else -1, keep_at if drafter is not None else -1))
+        return 7 if sample else None
+
+    def ask(self, prompt, policy: str = "f3", draft: bool = True) -> int:
+        self.g.request.policy = policy
+        return int(self.g.generate(list(prompt), 1, None, lambda new: None, draft=draft)["cached"])
+
+    def kept(self) -> list[int]:
+        return [len(c.ids) for c in self.g.cache]
+
+
+@pytest.mark.parametrize("policy", ["f3", "2"], ids=["dflash2", "mtp"])
+def test_single_stream_benchy_shape(fake, monkeypatch, policy):
+    load, inference, prompt = shapes()
+    at = len(HEAD) + 600
+    on = Single(fake, monkeypatch)
+    sharing([on.g])
+    assert on.ask(load, policy) == 0
+    assert on.calls == [(at, 0, at, False), (len(load), at, len(load) - 1, True)]
+    assert on.kept() == [at, len(load) - 1]
+    assert on.ask(inference, policy) == at                          # the whole system block
+    assert on.calls[2:] == [(len(inference), at, len(inference) - 1, True)]
+    assert on.kept() == [len(load) - 1, at, len(inference) - 1]     # what it resumed from is newest but its own
+    assert on.ask(benchy(tm._prompt(600, 500), tm._prompt(64, 777)), policy) == at
+    turn = load + [11, 12] + [USER] + prompt + TAIL
+    assert on.ask(turn, policy) == len(load) - 1                    # the kept prompt plus a new suffix, as before
+    assert on.ask(inference, policy) == len(inference) - 1          # the same prompt again
+    assert on.ask(inference, policy, draft=False) == 0              # the reference: no resume, nothing kept
+    # off: the inference request misses; the next turn resumes the context load's state, as before, unless that state
+    # was saved out (the inference request took the caches) and the turn drafts with DFlash2: saved states drop it
+    off = Single(fake, monkeypatch)
+    resumed = len(load) - 1 if policy == "2" else 0
+    assert [off.ask(load, policy), off.ask(inference, policy), off.ask(turn, policy)] == [0, 0, resumed]
+    assert off.calls == [(len(load), 0, len(load) - 1, True), (len(inference), 0, len(inference) - 1, True),
+                         (len(turn), resumed, len(turn) - 1, True)]
+    assert off.kept() == [len(load) - 1, len(inference) - 1, len(turn) - 1]
+    assert all(h[15:17] == [0, 0] for h in off.sent[::2])        # the header's two slots, empty
+    assert on.sent[0][15:17] == [at, 0] and on.sent[2][15:17] == [0, 0]
