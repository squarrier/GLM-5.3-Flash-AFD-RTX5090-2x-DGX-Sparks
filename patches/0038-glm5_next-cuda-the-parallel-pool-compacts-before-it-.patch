@@ -0,0 +1,219 @@
+"""TF_GLM_COMPACT_BEFORE_EVICT (MiaAI-Lab recipe patch 0074, by ezoushen): the --parallel pool moves extents together
+before it evicts kept prompts, and evicts only while its free rows fall short, on the CPU.
+
+- The recipe's own checks for 0074 (``tools/pool_room_check.py``, vendored verbatim as ``tests/glm_pool_room_check.py``)
+  on this tree's ``MultiDecoder``: all pass with the switch on; off, the evictions before 0074 show.
+- Two ranks over tests/test_glm_multi.py's fake model (rank 1 applying rank 0's messages, every reply checked against
+  the request served alone), the patterns of tests/test_glm_cache_room.py: a new prompt with the free rows in pieces;
+  a kept prompt taken over in place that must grow into its neighbour's block; growing streams; llama-benchy's runs in
+  a scaled pool. With TF_GLM_CACHE_ROOM=1 also set, ``cache_room`` makes the room (this tree's own rule).
+"""
+
+from __future__ import annotations
+
+import runpy
+from pathlib import Path
+
+import pytest
+
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+from tests.test_glm_cache_room import Queue, benchy, blocks, kept_ids, kept_one_block_each, logged, ops_of
+from tests.test_glm_multi import Pair, _ops, _prompt, _sampling, fake, solo  # noqa: F401
+
+pytestmark = pytest.mark.torch
+
+CHECK = Path(__file__).with_name("glm_pool_room_check.py")
+
+
+@pytest.fixture(autouse=True)
+def _room_rule_unset(monkeypatch):
+    """0074 against the recipe's room rule (0030): TF_GLM_CACHE_ROOM, this tree's own rule, unset unless a test
+    sets it (tests/test_glm_cache_room.py covers it)."""
+
+    monkeypatch.delenv("TF_GLM_CACHE_ROOM", raising=False)
+
+
+def test_the_switch(fake, monkeypatch):  # noqa: F811
+    from tensorfold.families.glm5_next.cuda.multi import recipe_switch
+
+    assert [recipe_switch("TF_GLM_COMPACT_BEFORE_EVICT", v) for v in ("", "0", "1")] == [False, False, True]
+    monkeypatch.delenv("TF_GLM_COMPACT_BEFORE_EVICT", raising=False)
+    assert not Pair(fake, streams=2, blocks=4).d[0].compact_first
+    monkeypatch.setenv("TF_GLM_COMPACT_BEFORE_EVICT", "1")
+    assert all(d.compact_first for d in Pair(fake, streams=2, blocks=4).d)
+    monkeypatch.setenv("TF_GLM_COMPACT_BEFORE_EVICT", "on")
+    with pytest.raises(ValueError, match="TF_GLM_COMPACT_BEFORE_EVICT"):
+        Pair(fake, streams=2, blocks=4)
+
+
+@pytest.mark.parametrize("on", [False, True], ids=["off", "on"])
+def test_the_recipe_pool_room_checks(monkeypatch, capsys, on):
+    """The recipe's checks: every one passes with the switch on; off, the ones that need compacting before evicting
+    fail (the evictions 0074 removes), and the rest pass."""
+    from tensorfold.families.glm5_next.cuda.multi import MultiDecoder
+
+    monkeypatch.setattr(MultiDecoder, "compact_first", on)
+    with pytest.raises(SystemExit) as end:
+        runpy.run_path(str(CHECK), run_name="__main__")
+    out = capsys.readouterr().out
+    failed = [line[5:].split(" (")[0] for line in out.splitlines() if line.startswith("FAIL ")]
+    if on:
+        assert end.value.code == 0 and "all passed" in out and not failed
+    else:
+        assert end.value.code == 1
+        assert failed == ["grow: compacts instead of evicting", "grow: the neighbour moves once",
+                          "decoding grow: compacts instead of evicting", "room: compacts instead of evicting",
+                          "room short: evicts only the least recently used state it needs"]
+
+
+@pytest.mark.parametrize("cf", ["", "1"], ids=["off", "on"])
+def test_a_new_prompt_takes_the_free_rows_before_any_kept_prompt(fake, monkeypatch, cf):  # noqa: F811
+    """Six kept prompts in blocks 0-5 of 8, two of them evicted: 4 free blocks, the widest gap 2. A prompt needing 3
+    blocks: off, the two oldest kept prompts go until a gap fits; on, the extents move together and every kept prompt
+    stays, then resumes."""
+
+    from tensorfold.families.glm5_next.cuda.multi import EVICT, MOVE
+
+    monkeypatch.setenv("TF_GLM_COMPACT_BEFORE_EVICT", cf)
+    torch = fake
+    p = Pair(torch, streams=2, blocks=8, entries=16)
+    d = p.d[0]
+    prompts = kept_one_block_each(p, 6, 50)
+    assert blocks(d) == [(k, 1) for k in range(6)]
+    kid = {k: next(c.kid for c in d.kept if c.ids == prompts[k][:999]) for k in range(6)}
+    log = logged(p)
+    for c in [c for c in d.kept if c.kid in (kid[1], kid[3])]:
+        d._evict(c)
+    big = _prompt(5000, 60)
+    s = p.submit(big, 6, None)
+    p.run()
+    assert s.got == solo(torch, big, 6, None) and s.cached == 0
+    left = [k for k in (0, 2, 4, 5) if prompts[k][:999] in kept_ids(d)]
+    evicted = [pl[0] for m in log for op, pl in _ops(m) if op == EVICT]
+    if cf:
+        assert left == [0, 2, 4, 5] and evicted == [kid[1], kid[3]] and MOVE in ops_of(log)
+    else:
+        assert left == [4, 5] and evicted == [kid[1], kid[3], kid[0], kid[2]]    # least recently used first
+    turn = prompts[0] + _prompt(40, 61)
+    again = p.submit(turn, 8, _sampling("topk", 3))
+    p.run()
+    assert again.cached == (999 if cf else 0)
+    assert again.got == solo(torch, turn, 8, _sampling("topk", 3))
+    p.check()
+
+
+@pytest.mark.parametrize("cf", ["", "1"], ids=["off", "on"])
+def test_a_kept_prompt_taken_over_in_place_grows_by_moving_its_neighbours(fake, monkeypatch, cf):  # noqa: F811
+    """Kept prompts A (blocks 0-1), B (2-3) and C (4) in 6 blocks: a request resuming A needs a third block, with B
+    right after A and one free block at the end. Off, B's kept prompt goes so that A grows in place; on, the extents
+    after A move up (``_compact(grow=A)``) and A grows into the freed block, and B's next turn still resumes."""
+
+    from tensorfold.families.glm5_next.cuda.multi import EVICT, GROW, MOVE
+
+    monkeypatch.setenv("TF_GLM_COMPACT_BEFORE_EVICT", cf)
+    torch = fake
+    p = Pair(torch, streams=2, blocks=6, entries=16)
+    d = p.d[0]
+    a, b, c = _prompt(3000, 70), _prompt(3000, 71), _prompt(1000, 72)
+    for pr in (a, b, c):
+        p.submit(pr, 4, None)
+        p.run()
+    assert blocks(d) == [(0, 2), (2, 2), (4, 1)]
+    log = logged(p)
+    turn = a + _prompt(1100, 73)
+    s = p.submit(turn, 10, None)
+    assert s.cached == 2999
+    p.run()
+    assert s.got == solo(torch, turn, 10, None)
+    ops = ops_of(log)
+    if cf:
+        assert b[:2999] in kept_ids(d) and c[:999] in kept_ids(d)
+        assert EVICT not in ops and MOVE in ops and GROW in ops
+    else:
+        assert b[:2999] not in kept_ids(d) and EVICT in ops
+    nxt = b + _prompt(30, 74)
+    again = p.submit(nxt, 8, None)
+    p.run()
+    assert again.cached == (2999 if cf else 0) and again.got == solo(torch, nxt, 8, None)
+    p.check()
+
+
+@pytest.mark.parametrize("cf", ["", "1"], ids=["off", "on"])
+def test_growing_streams_keep_every_row(fake, monkeypatch, cf):  # noqa: F811
+    """tests/test_glm_multi.py's fragmented pool with three long replies that grow past their blocks, both settings:
+    every reply equals its solo one (the moves copied the right rows on both ranks: ``Pair.check`` after every
+    iteration), and on evicts no more kept prompts than off."""
+
+    from tensorfold.families.glm5_next.cuda.multi import EVICT, MOVE
+
+    counts = {}
+    for setting in ("", cf):
+        monkeypatch.setenv("TF_GLM_COMPACT_BEFORE_EVICT", setting)
+        torch = fake
+        p = Pair(torch, streams=3, blocks=6, entries=8)
+        log = logged(p)
+        for seed in (20, 21, 22, 23):
+            p.submit(_prompt(100 + seed, seed), 10, None)
+            p.run()
+        reqs = [(_prompt(1900, 30), 400, None), (_prompt(1500, 31), 700, _sampling("topk", 5)),
+                (_prompt(1000, 32), 1200, _sampling("minp", 6))]
+        streams = [p.submit(pr, n, sp, stop_eos=False) for pr, n, sp in reqs]
+        p.run()
+        for s, (pr, n, sp) in zip(streams, reqs):
+            assert s.got == solo(torch, pr, n, sp, stop_eos=False)
+        ops = ops_of(log)
+        assert MOVE in ops
+        counts[setting] = ops.count(EVICT)
+    assert counts[cf] <= counts[""]
+
+
+@pytest.mark.parametrize("cf", ["", "1"], ids=["off", "on"])
+def test_benchy_runs_in_a_scaled_pool(fake, monkeypatch, cf):  # noqa: F811
+    """tests/test_glm_cache_room.py's scaled llama-benchy runs (13 blocks, 3-block loads, 4-block inference requests,
+    2 streams, c = 3, 4 runs; off: 3 of 12 inference requests miss): on misses no more than off. Every reply equals its
+    solo one."""
+
+    from tensorfold.families.glm5_next.cuda import engine
+
+    monkeypatch.setenv("TF_GLM_COMPACT_BEFORE_EVICT", cf)
+    monkeypatch.setattr(engine.GlmEngine, "grid", 64)
+    torch = fake
+    p = Pair(torch, streams=2, blocks=13, entries=32, prefill_rows=2048)
+    for g in p.g:
+        g.shared, g.opener = 256, 43 if g.rank == 0 else None
+    q = Queue(p, 2)
+    q.d.wanted = None
+    c, context = 3, 5000
+    at = (3 + context) // 64 * 64
+    cached, seed = [], 10_000
+    for run in range(4):
+        contexts = [_prompt(context, seed + 2 * i) for i in range(c)]
+        users = [_prompt(2048, seed + 2 * i + 1) for i in range(c)]
+        seed += 2 * c
+        loads = q.run([benchy(x, [44]) for x in contexts], 6)
+        infs = q.run([benchy(x, u) for x, u in zip(contexts, users)], 6)
+        for s in loads + infs:
+            assert s.got == solo(torch, s.prompt, 6, None, stop_eos=False)
+        cached += [s.cached for s in infs]
+    assert set(cached) <= {0, at}
+    assert cached.count(0) <= 3 and (cached.count(0) == 3 or cf)
+
+
+def test_cache_room_makes_the_room_when_both_are_set(fake, monkeypatch):  # noqa: F811
+    """TF_GLM_CACHE_ROOM=1 with TF_GLM_COMPACT_BEFORE_EVICT=1: ``cache_room`` makes the room (its counters move), the
+    kept prompts stay, as with either alone in this pattern."""
+
+    monkeypatch.setenv("TF_GLM_COMPACT_BEFORE_EVICT", "1")
+    monkeypatch.setenv("TF_GLM_CACHE_ROOM", "1")
+    torch = fake
+    p = Pair(torch, streams=2, blocks=8, entries=16)
+    d = p.d[0]
+    prompts = kept_one_block_each(p, 6, 50)
+    for c in [c for c in d.kept if c.ids in (prompts[1][:999], prompts[3][:999])]:
+        d._evict(c)
+    s = p.submit(_prompt(5000, 60), 6, None)
+    p.run()
+    assert s.got == solo(torch, s.prompt, 6, None)
+    assert [k for k in (0, 2, 4, 5) if prompts[k][:999] in kept_ids(d)] == [0, 2, 4, 5]
+    assert d.health()["cache_room"]["packs"] == 1 and d.health()["cache_room"]["evictions"] == 0
+    p.check()
