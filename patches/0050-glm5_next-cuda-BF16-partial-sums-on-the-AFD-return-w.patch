+# -- the expert's reply stream (GPU-driven; streams and events faked) ----------------------------------------------------
+class _Ev:
+    def __init__(self, log, name) -> None:
+        self.log, self.name = log, name
+
+    def record(self, stream=None) -> None:
+        self.log.append(("record", self.name, stream.name))
+
+
+class _Stream:
+    def __init__(self, log, name, handle) -> None:
+        self.log, self.name, self.cuda_stream = log, name, handle
+
+    def wait_event(self, ev) -> None:
+        self.log.append(("wait", self.name, ev.name))
+
+
+def test_the_reply_stream_rounds_and_copies(monkeypatch):
+    """Two links, GPU-driven, a prompt window (tests/test_glm_mcdma_inflight.py's ``test_the_reply_stream`` with the
+    switch): ``reply`` records the compute's event, the reply stream waits for it, rounds the link's rows into the
+    link's own bf16 rows and copies their bytes into the reply mailbox (both inside the stream's context), stages the
+    word there with the bf16 length, then records the link's sent event; the third request waits for link 0's last
+    copy. A decode window's reply goes as fp32, today's way."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import afd_mcdma
+
+    log = []
+    comp, side = _Stream(log, "compute", 11), _Stream(log, "reply", 22)
+    monkeypatch.setattr(torch.cuda, "current_stream", lambda *a, **k: comp)
+
+    @contextlib.contextmanager
+    def on(stream):
+        log.append(("enter", stream.name))
+        yield
+        log.append(("exit", stream.name))
+
+    monkeypatch.setattr(torch.cuda, "stream", on)
+    rows = 4
+
+    def fake_link(j):
+        box = SimpleNamespace(rep_bytes=torch.zeros(rows * D * 4, dtype=torch.uint8))
+        return SimpleNamespace(name=f"a2-{j}" if j else "a2", mode="gpu", base=1, box=box,
+                               stage_gpu=lambda seq, n, stream=None, j=j: log.append(("stage", j, seq, n, stream)))
+
+    links = [fake_link(0), fake_link(1)]
+    end = afd_mcdma.McdmaExpertLink(links, D, S, len(LAYERS), PREFILL, device="cpu", bf16=True)
+    assert [h.dtype for h in end.halves] == [torch.bfloat16] * 2 and end.halves[0].shape == (PREFILL, D)
+    assert end.halves[0].data_ptr() != end.halves[1].data_ptr()
+    end.side = side                                             # as on CUDA (__init__'s branch)
+    end.outs = [torch.zeros((PREFILL, D)) for _ in links]
+    end._computed = [_Ev(log, f"computed{j}") for j in range(2)]
+    end._sent = [_Ev(log, f"sent{j}") for j in range(2)]
+    end._used = [False, False]
+    end.bf16_rep, end.n_rep = True, rows * D * 2                # a prompt window (next_forward / _open set these)
+    copies = []
+    real_copy = torch.Tensor.copy_
+
+    def copy(self, src, non_blocking=False):
+        copies.append((self.dtype, src.dtype, log[-1][0] if log else None))
+        return real_copy(self, src, non_blocking=non_blocking)
+
+    for k in range(3):
+        log.clear()
+        copies.clear()
+        j = k % 2
+        dst = end.out(rows)
+        assert dst.data_ptr() == end.outs[j].data_ptr()
+        rows_k = torch.full((rows, D), 0.1 * (k + 1))           # the compute's rows (not bf16 values)
+        dst.copy_(rows_k)
+        monkeypatch.setattr(torch.Tensor, "copy_", copy)
+        end.reply(0, dst)
+        monkeypatch.setattr(torch.Tensor, "copy_", real_copy)
+        want = ([("wait", "compute", "sent0")] if k == 2 else []) + [
+            ("record", f"computed{j}", "compute"), ("wait", "reply", f"computed{j}"), ("enter", "reply"),
+            ("exit", "reply"), ("stage", j, 1 + k // 2, rows * D * 2, 22), ("record", f"sent{j}", "reply")]
+        assert log == want, (k, log)
+        # the rounding, then the bytes, both inside the reply stream's context
+        assert copies == [(torch.bfloat16, torch.float32, "enter"), (torch.uint8, torch.uint8, "enter")], copies
+        sent = links[j].box.rep_bytes[:rows * D * 2].view(torch.bfloat16).view(rows, D)
+        assert torch.equal(sent, rows_k.to(torch.bfloat16))
+        assert torch.equal(end.sent(dst), _bf(dst)) and not torch.equal(end.sent(dst), dst)
+        assert end.at == (k + 1) % 2 and end.seqs[j] == 2 + k // 2
+    log.clear()
+    end.bf16_rep, end.n_rep = False, rows * D * 4               # a decode window: fp32, today's path
+    other = torch.full((rows, D), 0.7)
+    end.reply(0, other)
+    assert log == [("stage", 1, 2, rows * D * 4, None)]
+    assert torch.equal(links[1].box.rep_bytes.view(torch.float32).view(rows, D), other)
+    assert end.sent(other) is other
+
