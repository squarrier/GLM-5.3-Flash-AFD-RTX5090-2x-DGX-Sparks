+def test_the_widening_is_exact_and_the_round_trip():
+    import torch
+
+    p = _p()
+    every = torch.arange(1 << 16, dtype=torch.int32).to(torch.int16).view(torch.bfloat16)     # all 65,536 patterns
+    wide = every.to(torch.float32)
+    pat = torch.arange(1 << 16, dtype=torch.int64)
+    real = ~torch.isnan(wide)
+    assert int(real.sum()) == 65536 - 2 * 127                                                # NaN stays NaN
+    assert torch.equal(wide.view(torch.int32)[real].to(torch.int64) & 0xFFFFFFFF, pat[real] << 16)   # exact
+    assert torch.equal(wide[real].to(torch.bfloat16).view(torch.int16), every[real].view(torch.int16))
+    # the error bound below the overflow point: half a bf16 step (2^-8 relative for normals, 2^-134 absolute in the
+    # subnormal range); the reference's values are torch's
+    vals = [v for v in _values() if math.isfinite(v) and abs(v) < _f32(0x7F7F8000)]
+    x = torch.tensor(vals, dtype=torch.float64)
+    r = torch.tensor(vals, dtype=torch.float32).to(torch.bfloat16).to(torch.float64)
+    assert bool(((r - x).abs() <= torch.maximum(x.abs() * 2.0 ** -8, torch.full_like(x, 2.0 ** -134))).all())
+    assert [p.reference_value(p.reference_bits(v)) for v in vals] == r.tolist()
+    # rounding once more changes nothing: the widened rows are exactly the bf16 values the expert sent
+    once = _bf(torch.tensor(vals, dtype=torch.float32))
+    assert torch.equal(_bf(once), once)
+
