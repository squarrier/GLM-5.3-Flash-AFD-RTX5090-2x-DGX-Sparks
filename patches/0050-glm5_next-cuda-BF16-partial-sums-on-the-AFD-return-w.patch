+def test_the_sum_order_is_unchanged(env, words, master, tmp_path):
+    """``collect`` returns rank 1's, rank 2's and the shared expert's planes as fp32 ``[3, R, D]`` over ``afd_recv``,
+    in today's order: with the switch on they equal the switch-off planes with only the two halves rounded to bf16,
+    so ``hc_post`` (unchanged) adds the rounded halves and the shared expert in fp32 in today's order. The rounding is
+    of each half's whole fp32 sum (the experts' slot-order sum is untouched)."""
+
+    import torch
+
+    rows = 13
+    got: dict = {False: [], True: []}
+    for bf16 in (False, True):
+        w = BfpWire(tmp_path / f"bf16-{bf16}", words, master, 1, bf16=bf16)
+        b = tp._bufs()
+        w.a.begin(rows, chunk=True)
+        for pos in range(len(LAYERS)):
+            sy = _seeded(b, rows, 71 + pos)
+            w.a.exchange(b, rows)
+            b.sy[:rows] = sy
+            g = w.a.collect(b, rows, D)
+            assert g.shape == (3, rows, D) and g.dtype == torch.float32 and g.data_ptr() == b.afd_recv.data_ptr()
+            got[bf16].append(g.clone())
+        w.close()
+    for off, on in zip(got[False], got[True]):
+        assert torch.equal(on[0], _bf(off[0])) and torch.equal(on[1], _bf(off[1])) and torch.equal(on[2], off[2])
+        assert not torch.equal(on[0], off[0])
