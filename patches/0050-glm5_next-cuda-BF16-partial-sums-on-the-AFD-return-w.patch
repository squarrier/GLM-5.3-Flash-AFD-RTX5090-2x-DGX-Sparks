+    monkeypatch.setattr(afd, "CHECK_FORWARDS", 4)
+    monkeypatch.setattr(experts_node, "CHECK_FORWARDS", 4)
+    monkeypatch.setattr(torch.cuda, "synchronize", lambda *a, **k: None)
+    holder = {}
+    store = SimpleNamespace(set=lambda k, v: holder["s"].set(k, v))
+    links, eps = _links(daemon, words, check=True, store=store)
+    wait_attached(daemon)
+    a = _attention(links, master)
+    holder["s"] = a.store
+    a.check = True
+    gen = torch.Generator().manual_seed(91)
+    _plain(a, 6, gen)
+    _windows(a, (8, 5), gen)
+    _plain(a, 2, gen, chunk=False)
+    a.begin(2)
+    a.layer = a.nlayers
+    out = capsys.readouterr().out
+    assert a.checked == 4 and a.mismatches == 0, out
+    assert "4 forwards (2 of them in prompt chunk pairs, seqs 2-3), 0 mismatches" in out
+    tp._close(daemon, eps)
+
