diff --git a/src/tensorfold/families/glm5_next/cuda/partials_bf16.py b/src/tensorfold/families/glm5_next/cuda/partials_bf16.py
new file mode 100644
index 0000000..ab52d81
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/cuda/partials_bf16.py
@@ -0,0 +1,76 @@
+"""BF16 partial sums on the AFD wire's return (``TF_GLM_PARTIALS_BF16=1``): each expert node rounds its half's weighted
+routed-expert sum of a prompt window to bf16 before it replies, 8,192 bytes a row at hidden 4,096 instead of fp32's
+16,384; the attention node widens them back to fp32 (exact) and adds the two halves and its shared expert in fp32 as
+before (``glue.hc_post``: rank 1's, rank 2's, the shared one, in that order). The halves' sums themselves are unchanged
+(the experts' kernels sum the 8 routed slots in fp32 in slot order, as before); only their one rounding to bf16, to
+nearest even, is new. Decode windows (MODE_EAGER) keep fp32 replies: they carry 1 .. 128 rows, so their bytes are
+small, and they keep today's bits.
+
+The rounding is row-local (each value is rounded alone), so a prompt row's reply is the same in any window: alone or
+grouped (TF_GLM_MULTI_PREFILL), in a pair or lanes, at any exchanges in flight. It changes outputs, so the switch is off
+by default.
+
+Both ends must agree: the attention node announces ``"partials_bf16": 1`` in the settings handshake only when its
+switch is on (off: the handshake as before), and each expert node compares its own switch with it and refuses to start
+on a difference (``refusal``), naming both nodes' settings; an expert node of a tree without the switch refuses the
+unknown key (``afd.settings_mismatch``). Set it the same on all three containers.
+
+glm53f-afd's ranks return bf16 planes the same way: each rank reduces its 8 routed slots in fp32 and rounds the sum to
+bf16, and the coordinator adds the planes in fp32 (hughmadden/glm53f-afd @ 91db3cc, ``crates/glm53f-rank/README.md``:
+the large-M path's reduce step and the return-path table, "Four BF16 planes, added in FP32 by the coordinator"; Hugh
+Madden, @dangerm00se, github.com/hughmadden; MIT, Copyright (c) 2026 Turquoise Bay AI Pty Ltd). No code is copied:
+here the rounding is torch's float-to-bf16 conversion on the expert node and the reply's place in the MCDMA mailbox
+is this tree's (``mcdma.Layout``).
+"""
+
+from __future__ import annotations
+
+import os
+import struct
+
+ENV = "TF_GLM_PARTIALS_BF16"
+
+
+def enabled(value: str | None = None) -> bool:
+    """TF_GLM_PARTIALS_BF16: 1 sends the expert nodes' prompt-window partial sums back as bf16; unset or 0 (the default)
+    as fp32. Anything else refuses (read before the wire opens, on every node)."""
+
+    value = (os.environ.get(ENV, "") if value is None else value).strip() or "0"
+    if value not in ("0", "1"):
+        raise ValueError(f"{ENV}: 0 or 1, not {value!r}")
+    return value == "1"
+
+
+def row_bytes(d: int, on: bool) -> int:
+    """One reply row's bytes: bf16 (2 a value) with the switch on, fp32 (4) off."""
+
+    return (2 if on else 4) * int(d)
+
+
+def refusal(attention: bool, expert: bool, rank: int) -> str:
+    """The expert node's startup refusal when the two nodes' switches differ (``experts_node.serve``)."""
+
+    def said(on: bool) -> str:
+        return "1 (bf16 partial sums)" if on else "unset (fp32 partial sums)"
+
+    return (f"{ENV} differs between the nodes: the attention node has {said(attention)}, expert {rank} has "
+            f"{said(expert)}; both ends of the wire must agree on the reply format: set {ENV} the same on the "
+            "attention node and on both expert nodes")
+
+
+# -- the tests' oracle ----------------------------------------------------------------------------------------------
+def reference_bits(v: float) -> int:
+    """The bf16 bits of an fp32 value rounded to nearest, ties to even (the conversion the expert node uses), from the
+    fp32 bits: add 0x7FFF plus the kept part's lowest bit, keep the top 16 bits. Infinities and zeros keep their sign;
+    a NaN gives a quiet NaN (its payload is the converter's; the tests compare NaN-ness only)."""
+
+    u = struct.unpack("<I", struct.pack("<f", v))[0]
+    if (u & 0x7F800000) == 0x7F800000 and u & 0x007FFFFF:
+        return ((u >> 16) | 0x0040) & 0xFFFF
+    return ((u + 0x7FFF + ((u >> 16) & 1)) >> 16) & 0xFFFF
+
+
+def reference_value(bits: int) -> float:
+    """A bf16 bit pattern's value (exact as fp32)."""
+
+    return struct.unpack("<f", struct.pack("<I", (bits & 0xFFFF) << 16))[0]
diff --git a/tests/test_glm_partials_bf16.py b/tests/test_glm_partials_bf16.py
new file mode 100644
index 0000000..ad8ca73
--- /dev/null
+++ b/tests/test_glm_partials_bf16.py
@@ -0,0 +1,972 @@
+"""TF_GLM_PARTIALS_BF16 (``partials_bf16``) on CPU: the expert nodes' prompt-window partial sums back as bf16.
+
+The design is glm53f-afd's return path (hughmadden/glm53f-afd @ 91db3cc, Hugh Madden, @dangerm00se): each rank rounds
+its slot-order fp32 sum to bf16 and the coordinator adds the planes in fp32. No code of it is used here.
+
+- The setting, the handshake (``partials_bf16`` only when on; an older expert refuses the key) and the sizes: the reply
+  bytes per row, the mailbox room (a 2,048-row prompt reply at hidden 4,096 needs a 20 MiB reply half instead of 36,
+  while decode windows of up to 128 rows keep fp32 replies).
+- The pack and unpack: the expert's rounding is round-to-nearest-even, bit for bit against a plain-Python
+  transcription over every class of value (random scales, exact ties both ways, either side of a tie, the largest
+  values and those that round to infinity, subnormals, signed zeros, infinities, NaN); the attention's widening is
+  exact for all 65,536 bf16 patterns; rounding the widened values again changes nothing; the error is at most half a
+  bf16 step; the rounding is row-local.
+- The wire: the real ``AfdWire`` + ``McdmaTransport`` and both experts' ``forwards`` over the fake mcdma-rpcd pair,
+  CPU-, GPU-driven and mixed: prompt windows (plain chunks, a layer slice, a pair, lanes of 3 and 4) come back as the
+  bf16 rounding of each expert's fp32 partial, decode windows as the fp32 partial itself; the shared expert's plane is
+  intact; each reply word carries 2 bytes a value for prompt windows and 4 for decode windows; the mailbox holds the
+  bf16 bytes.
+- The sum order: ``collect`` returns rank 1's, rank 2's and the shared expert's fp32 planes in today's buffer and
+  order, equal to the switch-off planes with the two halves rounded; ``glue.hc_post`` (the Triton kernel under the
+  interpreter, TRITON_INTERPRET=1) over them is the rank-ordered fp32 sum, rounded once, mixed as before.
+- Row-local: a prompt row's reply is the same in any window (alone, in a chunk, a pair, lanes), and lanes at 1 to 4
+  exchanges in flight through the real scheduler equal each lane alone.
+- The expert's reply stream with bf16 rows (faked streams and events), the wire check (0 mismatches), the mailbox
+  sizing at startup on both ends, the startup refusals (a switch that differs between the attention node and an
+  expert node, naming both settings; a bad value, before the handshake) and serve() with both on.
+- The switch off: the settings, the sizes, the replies and the reply lengths are today's.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import math
+import os
+import struct
+import threading
+import time
+from datetime import timedelta
+from types import SimpleNamespace
+
