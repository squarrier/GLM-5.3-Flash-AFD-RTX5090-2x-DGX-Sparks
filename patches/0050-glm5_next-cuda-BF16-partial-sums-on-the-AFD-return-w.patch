+# -- the pack and unpack -----------------------------------------------------------------------------------------------
+def _f32(bits: int) -> float:
+    return struct.unpack("<f", struct.pack("<I", bits & 0xFFFFFFFF))[0]
+
+
+def _values():
+    """fp32 values of every class: random at scales 2^-140 .. 2^127, random bit patterns, exact ties to even both ways
+    (the kept part even and odd), one ulp either side of a tie, the largest bf16 value and the fp32 values that round
+    to infinity, fp32 and bf16 subnormals, signed zeros, infinities. No NaN (``test_the_rounding...`` checks those)."""
+
+    import random
+
+    rng = random.Random(7)
+    vals = []
+    for e in range(-140, 128, 3):
+        vals += [rng.uniform(-1, 1) * 2.0 ** e for _ in range(8)]
+    for _ in range(400):
+        b = rng.getrandbits(32)
+        if (b & 0x7F800000) == 0x7F800000:
+            continue
+        vals.append(_f32(b))
+    for kept in (0x3F80, 0x3F81, 0x4049, 0x404A, 0x0001, 0x0002, 0x7F7E, 0x7F7F, 0xBF80, 0xBF81):
+        for low in (0x8000, 0x7FFF, 0x8001, 0x0000, 0xFFFF):  # the tie, and either side of it
+            vals.append(_f32(kept << 16 | low))
+    vals += [_f32(0x7F7FFFFF), _f32(0x7F7F8000), _f32(0x7F7F7FFF), -_f32(0x7F7F8000)]   # to inf, and not
+    vals += [_f32(1), _f32(0x00008000), _f32(0x00018000), _f32(0x007FFFFF), 0.0, -0.0, math.inf, -math.inf]
+    return vals
+
+
+def test_the_rounding_is_round_to_nearest_even_bit_for_bit():
+    import torch
+
+    p = _p()
+    vals = _values()
+    got = torch.tensor(vals, dtype=torch.float32).to(torch.bfloat16).view(torch.int16).to(torch.int32) & 0xFFFF
+    assert got.tolist() == [p.reference_bits(v) for v in vals]
+    # the reference, spelled out: ties to even both ways, past the largest bf16 to infinity, a tiny subnormal to zero
+    assert p.reference_bits(_f32(0x3F808000)) == 0x3F80 and p.reference_bits(_f32(0x3F818000)) == 0x3F82
+    assert p.reference_bits(_f32(0x3F808001)) == 0x3F81 and p.reference_bits(_f32(0x3F817FFF)) == 0x3F81
+    assert p.reference_bits(_f32(0x7F7F8000)) == 0x7F80 and p.reference_bits(_f32(0x7F7F7FFF)) == 0x7F7F
+    assert p.reference_bits(-0.0) == 0x8000 and p.reference_bits(_f32(1)) == 0x0000
+    nan = torch.tensor([math.nan, -math.nan], dtype=torch.float32).to(torch.bfloat16)
+    assert bool(torch.isnan(nan).all())
+    assert all(math.isnan(p.reference_value(p.reference_bits(v))) for v in (math.nan, -math.nan))
+
