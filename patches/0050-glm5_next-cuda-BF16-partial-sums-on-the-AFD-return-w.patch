+# -- the wire ----------------------------------------------------------------------------------------------------------
+def _links(daemon, words, *, attn="cpu", experts=("cpu", "cpu"), bf16=True, check=False, store=None):
+    """Both MCDMA links' attention end and both experts' loops (``experts_node.forwards``) over their own ends, with
+    the experts' ``bf16`` (the handshake's ``partials_bf16``, as ``open_expert_link`` passes it)."""
+
+    from tensorfold.families.glm5_next.cuda import afd_mcdma, experts_node, mcdma
+
+    drv = FakeDriver(words)
+    links = mcdma.AttentionLinks(["a2", "a1"], words=words, driver=drv if attn == "gpu" else None, mode=attn,
+                                 stream=lambda: 0, timeout=10.0, shm_dir=str(daemon.shm), linkup_wait=2)
+    eps = []
+    for half, (name, mode) in enumerate(zip(["a2", "a1"], experts)):
+        link = mcdma.ExpertLink(name, words=words, driver=drv if mode == "gpu" else None, mode=mode,
+                                socket_path=daemon.sock(name), shm_dir=str(daemon.shm), stream=lambda: 0)
+        link.base = links.base[half]
+        end = afd_mcdma.McdmaExpertLink(link, D, S, len(LAYERS), PREFILL, device="cpu", pairs=True, lanes=4,
+                                        bf16=bf16)
+        ep = SimpleNamespace(link=end, node=FakeNode(LAYERS, half), error=None)
+
+        def run(ep=ep, half=half):
+            try:
+                experts_node.forwards(ep.node, ep.link, store if store is not None else DictStore(), half + 1,
+                                      check_on=check)
+            except BaseException as exc:  # noqa: BLE001
+                ep.error = exc
+
+        ep.t = threading.Thread(target=run, daemon=True)
+        ep.t.start()
+        eps.append(ep)
+    return links, eps
+
+
+def _attention(links, port, *, bf16=True):
+    """``glm_afd_fakes.mcdma_attention`` with the handshake's ``partials_bf16`` when ``bf16``."""
+
+    from tensorfold.families.glm5_next.cuda import afd as afd_mod
+    from tensorfold.families.glm5_next.cuda import afd_mcdma
+
+    tr = afd_mcdma.McdmaTransport("127.0.0.1", port, links=links, comm=SimpleNamespace(abort=links.release),
+                                  device="cpu", hidden=D)
+    a = afd_mod.AfdWire("127.0.0.1", port, transport=tr)
+    a.announce(dict(settings(), **({"partials_bf16": 1} if bf16 else {})))
+    return a
+
+
+def _check(a, got, b, rows, layer, sy=None) -> None:
+    """A collected ``[3, rows, D]`` against the experts' function: a prompt window's halves are the bf16 rounding of
+    the fp32 partials (exactly), a decode window's (or any with the switch off) the partials themselves; the shared
+    plane is ``sy`` (``b.sy``'s rows by default)."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda.afd import MODE_EAGER
+
+    prompt = a.bf16 and a.mode != MODE_EAGER
+    for half in (0, 1):
+        p = partial(b.normed[:rows], b.pick[:rows], b.wts[:rows], layer, half)
+        assert torch.equal(got[half], _bf(p) if prompt else p), (layer, half, rows, a.mode)
+        if prompt:
+            assert not torch.equal(got[half], p)          # the rounding happened (the fake's values are not bf16)
+    assert torch.equal(got[2], b.sy[:rows] if sy is None else sy)
+
+
+def _plain(a, rows, gen, *, chunk=True, slice=None) -> None:
+    """One forward (``chunk``: a prompt chunk, else a decode window) or a prompt chunk's layer slice, every reply
+    checked."""
+
+    b = tp._bufs()
+    first, count = slice if slice is not None else (0, len(LAYERS))
+    if slice is None:
+        a.begin(rows, chunk=chunk)
+    else:
+        a.begin(rows, chunk=True, slice=slice)
+    for pos in range(first, first + count):
+        tp._fill(b, rows, gen)
+        a.exchange(b, rows)
+        _check(a, a.collect(b, rows, D), b, rows, LAYERS[pos])
+
+
+def _windows(a, rows, gen) -> None:
+    """A pair (two windows) or lanes (three or four) in the schedule's wire order, every reply checked."""
+
+    bufs = [tp._bufs() for _ in rows]
+    if len(rows) == 2:
+        a.begin_pair(rows)
+    else:
+        a.begin_lanes(rows)
+    for layer in LAYERS:
+        for k, r in enumerate(rows):
+            tp._fill(bufs[k], r, gen)
+            a.use(k)
+            a.exchange(bufs[k], r)
+            _check(a, a.collect(bufs[k], r, D), bufs[k], r, layer)
+
+
+def _record_lengths(monkeypatch) -> list:
+    """Every ``AttentionLinks.collect``'s reply length (the bytes the reply word must carry)."""
+
+    from tensorfold.families.glm5_next.cuda import mcdma
+
+    lengths = []
+    collect = mcdma.AttentionLinks.collect
+
+    def rec(self, outs, rep_len, *a, **k):
+        lengths.append(rep_len)
+        return collect(self, outs, rep_len, *a, **k)
+
+    monkeypatch.setattr(mcdma.AttentionLinks, "collect", rec)
+    return lengths
+
+
+@pytest.mark.parametrize("modes", MODES, ids=["cpu", "gpu", "mixed"])
+def test_bf16_partials_over_the_mcdma_wire(env, daemon, words, master, monkeypatch, modes):
+    """With the switch on at both ends: plain prompt chunks, decode windows, a layer slice, a pair and lanes of 3 and 4.
+    Every prompt window's halves are the bf16 rounding of the experts' fp32 partials, every decode window's the
+    partials, the shared plane intact; each collect waited for 2 bytes a value (prompt) or 4 (decode); the mailbox's
+    reply half holds the bf16 bytes."""
+
+    import torch
+
+    lengths = _record_lengths(monkeypatch)
+    links, eps = _links(daemon, words, attn=modes[0], experts=modes[1])
+    wait_attached(daemon)
+    a = _attention(links, master)
+    assert a.bf16 and a.tr.bf16 and a.tr.layout.bf16
+    gen = torch.Generator().manual_seed(51)
+    want = []
+    _plain(a, 11, gen)                                    # a prompt chunk: bf16
+    want += [2 * 11 * D] * len(LAYERS)
+    _plain(a, 3, gen, chunk=False)                        # a decode window: fp32
+    want += [4 * 3 * D] * len(LAYERS)
+    _plain(a, PREFILL, gen)
+    want += [2 * PREFILL * D] * len(LAYERS)
+    _plain(a, PREFILL, gen, slice=(1, 2))                 # MODE_SLICE: a prompt chunk's layers 1 .. 2
+    want += [2 * PREFILL * D] * 2
+    _windows(a, (9, PREFILL), gen)
+    want += [2 * r * D for _ in LAYERS for r in (9, PREFILL)]
+    _windows(a, (5, PREFILL, 30), gen)
+    want += [2 * r * D for _ in LAYERS for r in (5, PREFILL, 30)]
+    _windows(a, (PREFILL, 7, PREFILL, 1), gen)
+    want += [2 * r * D for _ in LAYERS for r in (PREFILL, 7, PREFILL, 1)]
+    _plain(a, 1, gen, chunk=False)
+    want += [4 * D] * len(LAYERS)
+    _plain(a, 8, gen, chunk=False)                        # the widest decode window of the settings (max_rows 8)
+    want += [4 * 8 * D] * len(LAYERS)
+    assert lengths == want
+    # a prompt forward's reply bytes, as they sit in each mailbox after each collect: the bf16 rows
+    b = tp._bufs()
+    a.begin(6, chunk=True)
+    for layer in LAYERS:
+        tp._fill(b, 6, gen)
+        a.exchange(b, 6)
+        a.collect(b, 6, D)
+        for half, box in enumerate(links.boxes):
+            sent = box.rep_bytes[:2 * 6 * D].view(torch.bfloat16).view(6, D)
+            assert torch.equal(sent, partial(b.normed[:6], b.pick[:6], b.wts[:6], layer, half).to(torch.bfloat16))
+    for ep in eps:
+        assert ep.error is None and len(ep.link.halves) == 1 and ep.link.halves[0].dtype == torch.bfloat16
+    tp._close(daemon, eps)
