+    for rows in (129, 200, 256):                           # then a 128-row decode window's until 256 rows
+        assert bf.room(rows) == 4 * 4096 * 128
+    assert bf.room(1024) == bf.rep(1024, prompt=True) == 2 * 4096 * 1024
+    # per 2,048-row prompt window and MoE layer, both expert nodes' replies into the attention node: 64 MiB -> 32 MiB
+    assert 2 * off.rep(2048) - 2 * bf.rep(2048, prompt=True) == 32 << 20
+    assert "TF_GLM_PARTIALS_BF16 differs" in p.refusal(True, False, 1) and "expert 2 has 1" in p.refusal(False, True, 2)
