+# -- the setting, the handshake, the sizes -----------------------------------------------------------------------------
+def test_the_setting_the_handshake_and_the_sizes(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import afd, mcdma
+
+    p = _p()
+    monkeypatch.delenv(ENV, raising=False)
+    assert not p.enabled() and not p.enabled("0") and not p.enabled("") and p.enabled("1") and p.enabled(" 1 ")
+    monkeypatch.setenv(ENV, "1")
+    assert p.enabled()
+    for bad in ("2", "on", "bf16", "true", "yes"):
+        with pytest.raises(ValueError, match=ENV):
+            p.enabled(bad)
+    cfg = SimpleNamespace(mlp_kinds=["dense"] * 3 + ["moe"] * 4, quant="exl3", experts=16, top_k=8)
+    plain = afd.settings_for("/nonexistent", cfg, prefill_rows=2048)
+    on = afd.settings_for("/nonexistent", cfg, prefill_rows=2048, partials_bf16=True)
+    assert "partials_bf16" not in plain and on == dict(plain, partials_bf16=1)
+    assert afd.settings_mismatch(plain, on) == "partials_bf16: attention 1 != expert None"   # an older expert refuses
+    assert afd.settings_mismatch(on, on) == ""
+    assert p.row_bytes(4096, True) == 8192 and p.row_bytes(4096, False) == 16384
+    # GLM-5.3-Flash at 2,048 rows: hidden 4,096, top-k 8 + the shared slot. A prompt window's reply from each expert
+    # node is 32 MiB of fp32 today and 16 MiB of bf16 with the switch; decode windows stay fp32; the request is unchanged
+    off, bf = mcdma.Layout(4096, 9), mcdma.Layout(4096, 9, bf16=True)
+    assert off.rep(2048) == off.rep(2048, prompt=True) == bf.rep(2048) == 2048 * 4096 * 4 == 32 << 20
+    assert bf.rep(2048, prompt=True) == 2048 * 4096 * 2 == 16 << 20
+    assert bf.req(2048) == off.req(2048) == 16_924_928
+    # the reply half: today 32 MiB + its control page -> 36 MiB; with the switch the larger of a 2,048-row bf16 reply
+    # and a 128-row fp32 decode reply -> 20 MiB (the request half stays 20 MiB)
+    assert off.room(2048) == 32 << 20 and bf.room(2048) == 16 << 20
+    assert off.mib(2048) == (20, 36) and bf.mib(2048) == (20, 20)
