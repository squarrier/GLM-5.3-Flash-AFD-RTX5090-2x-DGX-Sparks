+# -- exchanges in flight -----------------------------------------------------------------------------------------------
+class BfpWire:
+    """N link pairs of the fake mcdma-rpcd pair (tests/test_glm_mcdma_inflight.py's ``Wire``) with the switch at both
+    ends: the attention's ``AfdWire`` over ``McdmaTransport``, both experts' ``forwards`` over their N links."""
+
+    def __init__(self, root, words, port, n, *, attn="cpu", experts=("cpu", "cpu"), bf16=True) -> None:
+        from tensorfold.families.glm5_next.cuda import afd as afd_mod
+        from tensorfold.families.glm5_next.cuda import afd_mcdma, experts_node, mcdma
+
+        root.mkdir(parents=True, exist_ok=True)
+        self.n, self.layers = n, list(LAYERS)
+        self.names = [mcdma.more_link(name, j) for j in range(n) for name in ("a2", "a1")]
+        self.daemon = FakeDaemon(root, self.names)
+        self.drv = FakeDriver(words)
+        self.links = mcdma.AttentionLinks(self.names, words=words, driver=self.drv if attn == "gpu" else None,
+                                          mode=attn, stream=lambda: 0, timeout=10.0, shm_dir=str(self.daemon.shm),
+                                          linkup_wait=2)
+        self.eps = []
+        for half, mode in enumerate(experts):
+            mine = []
+            for j in range(n):
+                name = self.names[2 * j + half]
+                link = mcdma.ExpertLink(name, words=words, driver=self.drv if mode == "gpu" else None, mode=mode,
+                                        socket_path=self.daemon.sock(name), shm_dir=str(self.daemon.shm),
+                                        stream=lambda: 0)
+                link.base = self.links.base[2 * j + half]
+                mine.append(link)
+            end = afd_mcdma.McdmaExpertLink(mine[0] if n == 1 else mine, D, S, len(self.layers), PREFILL,
+                                            device="cpu", pairs=True, lanes=4, bf16=bf16)
+            ep = SimpleNamespace(link=end, node=FakeNode(self.layers, half), error=None)
+
+            def run(ep=ep, half=half):
+                try:
+                    experts_node.forwards(ep.node, ep.link, DictStore(), half + 1)
+                except BaseException as exc:  # noqa: BLE001
+                    ep.error = exc
+
+            ep.t = threading.Thread(target=run, daemon=True)
+            ep.t.start()
+            self.eps.append(ep)
+        end = time.monotonic() + 5
+        while any(self.daemon.svc[x] is None for x in self.names):
+            assert time.monotonic() < end, "services never attached"
+            time.sleep(0.01)
+        self.tr = afd_mcdma.McdmaTransport("127.0.0.1", port, links=self.links,
+                                           comm=SimpleNamespace(abort=self.links.release), device="cpu", hidden=D)
+        self.a = afd_mod.AfdWire("127.0.0.1", port, transport=self.tr)
+        self.a.announce(dict(settings(layers=self.layers), **({"partials_bf16": 1} if bf16 else {})))
+        assert self.a.depth == n and self.a.bf16 == bf16
+
+    def close(self) -> None:
+        for x in self.names:
+            self.daemon.bye(x)
+        for ep in self.eps:
+            ep.t.join(5)
+            assert not ep.t.is_alive()
+        self.daemon.close()
+
+
+def _seeded(b, rows, seed: int):
+    """tests/test_glm_mcdma_inflight.py's ``_rows``: the request rows from a seed; returns the shared expert output,
+    which the caller writes after the exchange (``forward.moe_send``'s order)."""
+
+    import torch
+
+    gen = torch.Generator().manual_seed(seed)
+    b.normed[:rows] = torch.randn((rows, D), generator=gen).to(torch.bfloat16)
+    b.pick[:rows] = torch.randint(0, 16, (rows, S), generator=gen, dtype=torch.int32)
+    b.wts[:rows] = torch.rand((rows, S), generator=gen)
+    return torch.randn((rows, D), generator=gen)
+
+
+def _lanes_run(monkeypatch, w: BfpWire, rows, seed: int, out: dict, flight: dict) -> None:
+    """``rows``' chunks as lanes through the real scheduler (``prefill_pairs._forward_lanes``), each lane's layer loop
+    a stand-in (tests/test_glm_mcdma_inflight.py's ``_lanes_run``), every reply checked and kept."""
+
+    from tensorfold.families.glm5_next.cuda import prefill_pairs as pp
+
+    a = w.a
+    bufs = [tp._bufs() for _ in rows]
+
+    def steps(e, ch):
+        k, r, b = ch.slot, ch.R, bufs[ch.slot]
+        for pos, layer in enumerate(w.layers):
+            sy = _seeded(b, r, seed + 100 * k + pos)
+            yield pp.SEND
+            e.w.afd.use(k)
+            e.w.afd.exchange(b, r)
+            b.sy[:r] = sy                          # the shared expert, while the exchange flies
+            flight["now"] += 1
+            flight["max"] = max(flight["max"], flight["now"])
+            yield pp.WAIT
+            e.w.afd.use(k)
+            got = e.w.afd.collect(b, r, D)
+            flight["now"] -= 1
+            _check(a, got, b, r, layer, sy)
+            out[(seed, k, pos)] = got.clone()
+            yield pp.DONE
+
+    monkeypatch.setattr(pp, "_steps", steps)
+    e = SimpleNamespace(w=SimpleNamespace(afd=a))
+    if len(rows) == 2:
+        a.begin_pair(rows)
+    else:
+        a.begin_lanes(rows)
+    pp._forward_lanes(e, [pp.Chunk([None], k, bufs[k], R=rows[k]) for k in range(len(rows))])
+
+
+def _plain_run(w: BfpWire, rows, seed: int, out: dict, *, k: int = 0) -> None:
+    """One forward with ``_lanes_run``'s seeding for lane ``k`` (a prompt chunk above 8 rows, else a decode window)."""
+
+    b = tp._bufs()
+    w.a.begin(rows, chunk=rows > 8)
+    for pos in range(len(w.layers)):
+        sy = _seeded(b, rows, seed + 100 * k + pos)
+        w.a.exchange(b, rows)
+        b.sy[:rows] = sy
+        got = w.a.collect(b, rows, D)
+        _check(w.a, got, b, rows, w.layers[pos], sy)
+        out[(seed, k, pos)] = got.clone()
+
+
+GROUPS = [(PREFILL, 13, 21, PREFILL), (9, PREFILL, 30), (9, PREFILL)]     # lanes of 4, 3 and a pair
+
+
+@pytest.mark.parametrize("modes", MODES, ids=["cpu", "gpu", "mixed"])
+def test_bf16_replies_in_flight_equal_each_lane_alone(env, words, master, tmp_path, monkeypatch, modes):
+    """N = 1 to 4 exchanges in flight with the switch on: lanes of 4, 3 and 2 through the real scheduler, then a
+    decode window. Every reply equals the serial run's (each lane alone over one link pair): the rounding is row-local,
+    so a concurrent reply equals its solo reply. At most N were in flight and N were reached; each expert link kept
+    its own bf16 rows."""
+
+    import torch
+
+    ref = BfpWire(tmp_path / "serial", words, master, 1, attn=modes[0], experts=modes[1])
+    serial: dict = {}
+    for g, rows in enumerate(GROUPS):
+        for k, r in enumerate(rows):
+            _plain_run(ref, r, 1000 * (g + 1), serial, k=k)
+    _plain_run(ref, 3, 9000, serial)
+    ref.close()
+    for n in (1, 2, 3, 4):
+        w = BfpWire(tmp_path / f"n{n}", words, master, n, attn=modes[0], experts=modes[1])
+        out, tops = {}, []
+        for g, rows in enumerate(GROUPS):
+            flight = {"now": 0, "max": 0}
+            _lanes_run(monkeypatch, w, rows, 1000 * (g + 1), out, flight)
+            tops.append(flight["max"])
+        _plain_run(w, 3, 9000, out)
+        assert out.keys() == serial.keys() and all(torch.equal(out[x], serial[x]) for x in out), n
+        assert tops == [min(n, len(rows)) for rows in GROUPS], (n, tops)
+        assert not w.tr._flight and not w.a._busy and w.a.dead is None
+        for ep in w.eps:
+            assert ep.error is None and len(ep.link.halves) == n
+        w.close()
+
