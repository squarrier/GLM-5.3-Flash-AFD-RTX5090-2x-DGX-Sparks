+@pytest.mark.skipif(os.environ.get("TRITON_INTERPRET") != "1", reason="the Triton interpreter (TRITON_INTERPRET=1)")
+def test_hc_post_adds_the_widened_halves_in_rank_order():
+    """``glue.hc_post`` (the Triton kernel, interpreted) over switch-on planes (two widened bf16 halves, the shared
+    expert) equals its sum transcribed: rank 1's + rank 2's, + the shared expert's, in fp32, cast once to bf16 as the
+    branch, then mixed with the residual streams as before. Triton 3.8's interpreter casts fp32 to bf16 by truncation
+    where the GPU rounds to nearest even, so the transcription casts the way the interpreter does."""
+
+    import torch
+
+    from tensorfold.families.glm5_next.cuda import glue
+
+    def cast(t):                                           # the interpreter's fp32 -> bf16 -> fp32: drop the low half
+        return (t.view(torch.int32) & ~0xFFFF).view(torch.float32)
+
+    gen = torch.Generator().manual_seed(81)
+    rows, d, s = 5, 64, 4
+    halves = torch.randn((2, rows, d), generator=gen) * 3
+    sy = torch.randn((rows, d), generator=gen)
+    x = torch.randn((rows, s * d), generator=gen).to(torch.bfloat16)
+    post = torch.rand((rows, s), generator=gen)
+    comb = torch.rand((rows, 16), generator=gen)
+    on = torch.stack([_bf(halves[0]), _bf(halves[1]), sy]).contiguous()
+    out = torch.empty_like(x)
+    glue.hc_post(x, out, on, post, comb)
+    branch = cast((on[0] + on[1]) + on[2])
+    xs = x.float().view(rows, s, d)
+    for k in range(s):
+        c = [comb[:, j * 4 + k, None] for j in range(4)]
+        mixed = ((c[0] * xs[:, 0] + c[1] * xs[:, 1]) + c[2] * xs[:, 2]) + c[3] * xs[:, 3]
+        want = cast(post[:, k, None] * branch + mixed)
+        assert torch.equal(out.view(rows, s, d)[:, k].float(), want), k
+
