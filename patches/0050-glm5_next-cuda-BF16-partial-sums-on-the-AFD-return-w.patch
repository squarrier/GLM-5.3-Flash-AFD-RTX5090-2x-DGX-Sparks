+    a = afd_mod.AfdWire("127.0.0.1", port, transport=tr)
+    a.announce(afd_mod.settings_for(tmp_path, fake_cfg(), prefill_rows=PREFILL, pairs=True, partials_bf16=True))
+    a.wait_loaded(30)
+    assert a.bf16 and tr.bf16
+    gen = torch.Generator().manual_seed(11)
+    _plain(a, 4, gen, chunk=False)
