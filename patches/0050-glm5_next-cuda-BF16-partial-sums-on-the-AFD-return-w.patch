+# -- the mailbox sizing ------------------------------------------------------------------------------------------------
+def test_the_mailbox_room_at_glm_size():
+    """GLM-5.3-Flash's 2,048-row windows: 20 + 36 MiB mailboxes (the fp32 replies' sizes) carry both formats; 20 + 20
+    MiB carry the switch's replies and are refused without it, naming the sizes to run; 20 + 16 MiB are refused either
+    way."""
+
+    from tensorfold.families.glm5_next.cuda import mcdma
+
+    def box(req_mib, rep_mib):
+        return SimpleNamespace(req=req_mib << 20, rep=rep_mib << 20, path="/dev/shm/mcdma-rpc.a2", name="a2")
+
+    off, bf = mcdma.Layout(4096, 9), mcdma.Layout(4096, 9, bf16=True)
+    for lay in (off, bf):
+        mcdma.Mailbox.check_room(box(20, 36), lay, 2048)
+    mcdma.Mailbox.check_room(box(20, 20), bf, 2048)
+    with pytest.raises(mcdma.LinkError, match=r"\(20\+20 MiB\) cannot carry a 2048-row window .* rep_mib>=36"):
+        mcdma.Mailbox.check_room(box(20, 20), off, 2048)
+    with pytest.raises(mcdma.LinkError, match=r"\(20\+16 MiB\) cannot carry .* req_mib>=20 rep_mib>=20"):
+        mcdma.Mailbox.check_room(box(20, 16), bf, 2048)
+
