+def test_a_row_gets_the_same_reply_in_any_window(env, daemon, words, master):
+    """The same rows sent alone (1 row), in a 48-row chunk, in a pair (second window) and in lanes (every lane) come
+    back with the same bits, row for row."""
+
+    import torch
+
+    links, eps = _links(daemon, words)
+    wait_attached(daemon)
+    a = _attention(links, master)
+    row = tp._bufs()
+    tp._fill(row, PREFILL, torch.Generator().manual_seed(61))
+    seen: dict = {}
+
+    def run(rows_list, kind):
+        bufs = [tp._bufs() for _ in rows_list]
+        for buf, r in zip(bufs, rows_list):
+            for name in ("normed", "pick", "wts", "sy"):
+                getattr(buf, name)[:r] = getattr(row, name)[:r]     # every window holds the first r rows
+        if kind == "plain":
+            a.begin(rows_list[0], chunk=True)
+        elif len(rows_list) == 2:
+            a.begin_pair(rows_list)
+        else:
+            a.begin_lanes(rows_list)
+        for layer in LAYERS:
+            for k, r in enumerate(rows_list):
+                if kind != "plain":
+                    a.use(k)
+                a.exchange(bufs[k], r)
+                got = a.collect(bufs[k], r, D)
+                for i in range(r):
+                    seen.setdefault((layer, i), []).append(got[:2, i].clone())
+
+    run([1], "plain")
+    run([PREFILL], "plain")
+    run([5, PREFILL], "pair")
+    run([PREFILL, 3, 9], "lanes")
+    assert len(seen) == len(LAYERS) * PREFILL
+    for key, got in seen.items():
+        assert all(torch.equal(got[0].view(torch.int32), g.view(torch.int32)) for g in got[1:]), key
+    assert len(seen[(LAYERS[0], 0)]) == 7 and all(ep.error is None for ep in eps)
+    a.layer = a.nlayers
+    tp._close(daemon, eps)
+
