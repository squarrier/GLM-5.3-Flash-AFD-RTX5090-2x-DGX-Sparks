+# -- startup: the switch at both ends ----------------------------------------------------------------------------------
+def _store_and_expert(env, tmp_path):
+    """The attention's three-rank store (as ``StoreComm(0, ...)`` hosts it) and expert 1's ``serve`` in a thread (no
+    weights: the node would be a FakeNode); returns (server, port, thread, errors)."""
+
+    from torch.distributed import TCPStore
+
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    port = free_port()
+    server = TCPStore("127.0.0.1", port, 3, True, timeout=timedelta(seconds=30), wait_for_workers=False)
+    env.setattr(experts_node, "ALIVE_EVERY", 3600)
+    env.setattr(experts_node.Config, "read", staticmethod(lambda _d: fake_cfg()))
+    env.setattr(experts_node, "ExpertNode", lambda _d, h, layers, **_: FakeNode(layers, h))
+    errors: dict = {}
+
+    def run():
+        try:
+            experts_node.serve(tmp_path, 0, "127.0.0.1", port, device="cpu")
+        except BaseException as exc:  # noqa: BLE001
+            errors["x"] = exc
+
+    t = threading.Thread(target=run, daemon=True)
+    t.start()
+    return server, port, t, errors
+
+
+@pytest.mark.parametrize("attention,expert", [(True, False), (False, True)], ids=["attention-on", "expert-on"])
+def test_a_switch_that_differs_is_refused_at_startup(env, tmp_path, attention, expert):
+    """The attention announces ``partials_bf16`` only when its switch is on; an expert node whose own switch differs
+    refuses before it opens its link or loads anything, with a message naming both settings, and publishes it as its
+    error key (the attention's watchdog prints it and stops)."""
+
+    from tensorfold.families.glm5_next.cuda import afd as afd_mod
+
+    if expert:
+        env.setenv(ENV, "1")
+    else:
+        env.delenv(ENV, raising=False)
+    server, port, t, errors = _store_and_expert(env, tmp_path)
+    s = afd_mod.Store("127.0.0.1", port)
+    s.set("afd_settings", json.dumps(afd_mod.settings_for(tmp_path, fake_cfg(), prefill_rows=PREFILL,
+                                                          partials_bf16=attention)).encode())
+    t.join(20)
+    assert not t.is_alive()
+    exc = errors.get("x")
+    assert isinstance(exc, SystemExit), repr(exc)
+    said = {True: "1 (bf16 partial sums)", False: "unset (fp32 partial sums)"}
+    assert f"the attention node has {said[attention]}, expert 1 has {said[expert]}" in str(exc)
+    assert "set TF_GLM_PARTIALS_BF16 the same on the attention node and on both expert nodes" in str(exc)
+    assert bytes(s.get("afd_error/1")).decode() in str(exc)
+    assert not s.check(["afd_ready/1"]) and not s.check(["afd_loaded/1"])     # refused before the link and the load
+    del server
