+def test_the_rounding_is_row_local():
+    """Each value is rounded alone: rows rounded in any grouping or order give the same bits."""
+
+    import torch
+
+    gen = torch.Generator().manual_seed(3)
+    x = torch.randn((48, D), generator=gen) * torch.exp2(torch.randint(-30, 30, (48, 1), generator=gen).float())
+    whole = x.to(torch.bfloat16).view(torch.int16)
+    for cut in (1, 7, 13, 47):
+        assert torch.equal(torch.cat([x[:cut].to(torch.bfloat16), x[cut:].to(torch.bfloat16)]).view(torch.int16), whole)
+    perm = torch.randperm(48, generator=gen)
+    assert torch.equal(x[perm].to(torch.bfloat16).view(torch.int16), whole[perm])
