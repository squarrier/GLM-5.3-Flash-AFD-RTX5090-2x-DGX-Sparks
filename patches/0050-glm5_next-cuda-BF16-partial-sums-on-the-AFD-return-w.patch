+def test_the_mailbox_room_at_startup_on_both_ends(env, words, tmp_path):
+    """Real mailbox files at GLM's sizes (hidden 4,096, 2,048-row windows) of 20 + 20 MiB: the attention's
+    ``publish`` and the expert's ``open_expert_link`` accept them with the switch on and refuse them without it."""
+
+    from tensorfold.families.glm5_next.cuda import afd_mcdma, mcdma
+
+    daemon = FakeDaemon(tmp_path, ["a2", "a1"], req=20 << 20, rep=20 << 20)
+    try:
+        links = mcdma.AttentionLinks(["a2", "a1"], words=words, mode="cpu", timeout=5, shm_dir=str(daemon.shm),
+                                     linkup_wait=2)
+        glm = dict(settings(prefill=2048), top_k=8)
+        tr = afd_mcdma.McdmaTransport("", 0, links=links, comm=object(), device="cpu", hidden=4096)
+        tr.publish(dict(glm, partials_bf16=1))
+        assert tr.bf16 and tr.layout.room(2048) == 16 << 20
+        tr2 = afd_mcdma.McdmaTransport("", 0, links=links, comm=object(), device="cpu", hidden=4096)
+        with pytest.raises(mcdma.LinkError, match=r"rep_mib>=36"):
+            tr2.publish(glm)
+        env.setattr(mcdma, "link_name", lambda: "a2")
+        init = mcdma.ExpertLink.__init__
+
+        def link_init(self, name, **kw):
+            kw.setdefault("socket_path", daemon.sock(name))
+            init(self, name, **kw)
+
+        env.setattr(mcdma.ExpertLink, "__init__", link_init)
+        cfg = SimpleNamespace(hidden=4096, top_k=8)
+        theirs = dict(glm, transport="mcdma", mcdma_links=["a2", "a1"])
+        with pytest.raises(mcdma.LinkError, match=r"rep_mib>=36"):
+            afd_mcdma.open_expert_link(theirs, 1, cfg, None, device="cpu", log=lambda *a, **k: None)
+        with contextlib.suppress(OSError):                     # that process would exit: its service goes away
+            daemon.bye("a2")                                   # (the refused link's socket is closed already)
+        store = DictStore()
+        store.set("afd_mcdma/base/1", b"1")
+        end = afd_mcdma.open_expert_link(dict(theirs, partials_bf16=1), 1, cfg, store, device="cpu",
+                                         log=lambda *a, **k: None)
+        assert end.bf16 and end.lay.bf16 and len(end.halves) == 1 and end.halves[0].shape == (2048, 4096)
+        daemon.bye("a2")
+        end.close()
+    finally:
