@@ -0,0 +1,274 @@
+"""TF_GLM_EXPERT_KERNEL=g53 and the prompt windows the expert nodes see, on CPU: a prompt row's routed experts take
+glm53f-afd's kernels (expert prompt kernels from glm53f-afd, written by Hugh Madden (@dangerm00se,
+github.com/hughmadden), glm53f-afd @ 91db3cc) whatever window the attention node fills the row in.
+
+The AFD attention node at world 1 on tests/test_glm_multi.py's fake model with the AFD wire logged
+(tests/test_glm_multi_afd.py's World1), the 64-row prompt grid on (TF_GLM_KDA_CHUNKED's default). Every prompt window
+rank 0 fills (``MultiDecoder._fill``, ``_fill_many``, ``_fill_pair``: one forward the expert nodes see as R rows of a
+prompt chunk) is recorded with its pieces (request, first position, rows) and checked against the wire's chunk
+forwards, so each prompt row's window is known. The expert node's own dispatch (``g53_experts.Node.takes``, with the
+switch's settings) then gives the kernel that row's routed experts take. The scenarios, each against its counterpart:
+
+- four 40-row prompts filled alone (a 40-row window each) and grouped by TF_GLM_MULTI_PREFILL (one 160-row window);
+- a 70-row prompt drafted (kept on the grid: windows of 64 and 6 rows) and plain (one 70-row window);
+- the same drafted prompt again, resumed from its kept 64 rows (a 6-row tail; its first 64 rows are the kept ones);
+- a 600-row prompt in 256-row chunks filled in pairs (TF_GLM_PREFILL_PAIRS=1): drafted (256 + 256 + 64 to its grid
+  point, then a 24-row tail) and plain (256 + 256 + 88).
+
+Under the former 65-row floor (TF_GLM_EXPERT_KERNEL_ROWS=65: glm53f-rank's own large-M boundary, the switch's first
+default) the same row takes glm53f-afd's kernels in one scenario and TensorFold's in its counterpart, so a reply
+depended on how it was served (a drafted prompt against its plain run, concurrent replies against their alone runs).
+Under the switch's default (every prompt window, 1..4,096 rows) every prompt row takes glm53f-afd's kernels in every
+scenario; decode windows never do.
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from tests import test_glm_multi as tm
+from tests import test_glm_multi_afd as ta
+from tests.test_cuda_geometry import allocations  # noqa: F401  (fixture: fake triton, so decode imports)
+
+pytestmark = pytest.mark.torch
+
+fake = tm.fake
+afd_fake = ta.afd_fake
+GRID, PREFILL_ROWS, LAYER = 64, 256, 3
+# (scenario, its counterpart): the same prompt's rows served two ways
+PAIRS = [*[(f"40-row prompt {k} alone", f"40-row prompt {k} grouped") for k in range(4)],
+         ("70-row prompt drafted", "70-row prompt plain"), ("70-row prompt resumed", "70-row prompt plain"),
+         ("600-row prompt drafted, paired", "600-row prompt plain, paired")]
+
+
+@pytest.fixture
+def grid(monkeypatch):
+    """TF_GLM_PROMPT_GRID=64 (TF_GLM_KDA_CHUNKED=1's grid) on every engine the test builds; every other TF_GLM_ and
+    TF_AFD_ switch unset (the scenarios set their own), so the windows are the same under any settings the run has."""
+
+    from tensorfold.families.glm5_next.cuda import engine
+
+    for k in list(os.environ):
+        if k.startswith(("TF_GLM_", "TF_AFD_")):
+            monkeypatch.delenv(k, raising=False)
+    monkeypatch.setattr(engine.GlmEngine, "grid", GRID)
+    return GRID
+
+
+class Windows:
+    """Every prompt window rank 0 fills, in order: (rows, [(request, first position, rows)]) per window."""
+
+    def __init__(self, monkeypatch) -> None:
+        from tensorfold.families.glm5_next.cuda.multi import MultiDecoder
+
+        self.windows: list[tuple[int, list]] = []
+        self.pairs = 0                                  # _fill_pair calls (prompt chunk pairs)
+        fill, many, pair = MultiDecoder._fill, MultiDecoder._fill_many, MultiDecoder._fill_pair
+
+        def _fill(d, lane, stop, *, layers=None):
+            if (layers is None or layers[0] == 0) and stop > lane.st.pos:     # a replay (0042) fills no rows
+                self.windows.append((stop - lane.st.pos, [(lane.s, lane.st.pos, stop - lane.st.pos)]))
+            return fill(d, lane, stop, layers=layers)
+
+        def _fill_many(d, group, *, layers=None):
+            if layers is None or layers[0] == 0:
+                pieces = [(lane.s, lane.st.pos, stop - lane.st.pos) for lane, stop in group]
+                self.windows.append((sum(p[2] for p in pieces), pieces))
+            return many(d, group, layers=layers)
+
+        def _fill_pair(d, *plans):
+            self.pairs += 1
+            ends: dict[int, int] = {}
+            for k, plan in enumerate(plans):            # as _fill_pair lays them out: a later chunk from the last end
+                pieces = []
+                for lane, stop in plan:
+                    start = ends.get(id(lane), lane.st.pos) if k else lane.st.pos
+                    pieces.append((lane.s, start, stop - start))
+                self.windows.append((sum(p[2] for p in pieces), pieces))
+                ends.update((id(lane), stop) for lane, stop in plan)
+            return pair(d, *plans)
+
+        monkeypatch.setattr(MultiDecoder, "_fill", _fill)
+        monkeypatch.setattr(MultiDecoder, "_fill_many", _fill_many)
+        monkeypatch.setattr(MultiDecoder, "_fill_pair", _fill_pair)
+
+    def rows(self, s) -> dict[int, int]:
+        """Request ``s``'s filled prompt rows: position -> the rows of the window it was filled in (each once)."""
+
+        out: dict[int, int] = {}
+        for R, pieces in self.windows:
+            for req, start, n in pieces:
+                if req is s:
+                    for q in range(start, start + n):
+                        assert q not in out, f"row {q} filled twice"
+                        out[q] = R
+        return out
+
+
+def _node(env, monkeypatch, *, multi: bool = False, pairs: bool = False) -> ta.World1:
+    for name, on in (("TF_GLM_MULTI_PREFILL", multi), ("TF_GLM_PREFILL_PAIRS", pairs)):
+        if on:
+            monkeypatch.setenv(name, "1")
+        else:
+            monkeypatch.delenv(name, raising=False)
+    n = ta.World1(env, streams=4, prefill_rows=PREFILL_ROWS)
+    assert n.d.grid == GRID and n.d.world == 1 and n.d.group == multi and n.d.pairs == pairs
+    return n
+
+
+def serve(env, monkeypatch) -> dict[str, list[int]]:
+    """Every scenario, each on a fresh node run to the end before the next (replies checked against their solo
+    ones, the recorded windows against the wire's chunk forwards): per request, each prompt row's window rows in
+    position order (a resumed request's kept rows: those of the windows its kept state was filled in)."""
+
+    torch = env.torch
+    w = Windows(monkeypatch)
+    out: dict[str, list[int]] = {}
+
+    def chunks(n) -> list[int]:
+        return [r for k, r in n.wire.pairs() if k == "chunk"]
+
+    def fresh(n) -> None:                               # the windows from here on: this node's next requests
+        w.windows.clear()
+        w.pairs = 0
+        n.mark = len(chunks(n))
+
+    def run(n, reqs) -> None:
+        n.run()
+        for s, (pr, cnt, sp) in reqs:
+            assert s.got == tm.solo(torch, pr, cnt, sp)
+        assert chunks(n)[n.mark:] == [R for R, _ in w.windows]
+        assert all(R <= PREFILL_ROWS for R, _ in w.windows)
+
+    def table(s, n_rows: int, kept: list[int] | tuple = ()) -> list[int]:
+        rows = w.rows(s)
+        assert set(rows) == set(range(len(kept), n_rows)), (sorted(rows)[:3], len(kept), n_rows)
+        return [*kept, *[rows[q] for q in range(len(kept), n_rows)]]
+
+    # four 40-row prompts: alone (one after another), then grouped (admitted together, TF_GLM_MULTI_PREFILL=1)
+    prompts = [(tm._prompt(40, 70 + k), 8, tm._sampling("topk", k)) for k in range(4)]
+    for mode, multi in (("alone", False), ("grouped", True)):
+        n = _node(env, monkeypatch, multi=multi)
+        fresh(n)
+        reqs = []
+        for req in prompts:
+            reqs.append((n.submit(*req), req))
+            if not multi:
+                run(n, reqs[-1:])
+        run(n, reqs)
+        for k, (s, _) in enumerate(reqs):
+            out[f"40-row prompt {k} {mode}"] = table(s, 40)
+        if multi:
+            assert len(w.windows) == 1 and w.windows[0][0] == 160
+    # a 70-row prompt: drafted (kept at its grid point 64), the same again (resumed there), and plain
+    p70 = (tm._prompt(70, 77), 8, None)
+    n = _node(env, monkeypatch)
+    fresh(n)
+    a = n.submit(*p70)
+    run(n, [(a, p70)])
+    out["70-row prompt drafted"] = table(a, 70)
+    assert [R for R, _ in w.windows] == [64, 6] and a.cached == 0
+    fresh(n)
+    b = n.submit(*p70)
+    run(n, [(b, p70)])
+    assert b.cached == 64 and [R for R, _ in w.windows] == [6]
+    out["70-row prompt resumed"] = table(b, 70, kept=out["70-row prompt drafted"][:64])
+    n = _node(env, monkeypatch)
+    fresh(n)
+    c = n.submit(*p70[:2], None, draft=False)
+    run(n, [(c, p70)])
+    assert [R for R, _ in w.windows] == [70]
+    out["70-row prompt plain"] = table(c, 70)
+    # a 600-row prompt in prompt chunk pairs: drafted (kept at 576) and plain
+    p600 = (tm._prompt(600, 78), 8, tm._sampling("greedy", 0))
+    for mode, draft in (("drafted", True), ("plain", False)):
+        n = _node(env, monkeypatch, pairs=True)
+        fresh(n)
+        s = n.submit(*p600, draft=draft)
+        run(n, [(s, p600)])
+        assert [R for R, _ in w.windows] == ([256, 256, 64, 24] if draft else [256, 256, 88])
+        assert w.pairs >= 1                                      # the chunks did run as pairs
+        out[f"600-row prompt {mode}, paired"] = table(s, 600)
+    return out
+
+
+def _hook(monkeypatch, rows: str | None):
+    """The expert node's dispatch (``g53_experts.Node.takes``) under TF_GLM_EXPERT_KERNEL=g53 and, if given,
+    TF_GLM_EXPERT_KERNEL_ROWS=rows; the experts' prompt buffers hold PREFILL_ROWS rows, every layer in scope."""
+
+    from tensorfold.families.glm5_next.cuda import g53_experts
+
+    monkeypatch.setenv(g53_experts.ENV, "g53")
+    if rows is None:
+        monkeypatch.delenv(g53_experts.ROWS_ENV, raising=False)
+    else:
+        monkeypatch.setenv(g53_experts.ROWS_ENV, rows)
+    settings = g53_experts.switch()
+    assert settings is not None
+    h = g53_experts.Node.__new__(g53_experts.Node)
+    h.min_rows, h.max_rows, h.ready = settings["min_rows"], min(g53_experts.MAX_ROWS, PREFILL_ROWS), {LAYER: True}
+    for k in (g53_experts.ENV, g53_experts.ROWS_ENV):
+        monkeypatch.delenv(k, raising=False)
+    return h
+
+
+def kernels(h, windows: list[int]) -> list[str]:
+    """Each prompt row's kernel: ``g53`` (glm53f-afd's) or ``tf`` (TensorFold's: TF_GLM_EXL3_PROMPT=1's prompt kernel,
+    or the grouped kernel), by its window's rows; and a decode window of the same rows never takes g53."""
+
+    assert not any(h.takes(LAYER, R, False) for R in set(windows))
+    return ["g53" if h.takes(LAYER, R, True) else "tf" for R in windows]
+
+
+def spans(windows: list[int], ks: list[str]) -> str:
+    """'rows a-b: an R-row window (kernel)' runs, for the printed table."""
+
+    out, lo = [], 0
+    for q in range(1, len(windows) + 1):
+        if q == len(windows) or (windows[q], ks[q]) != (windows[lo], ks[lo]):
+            out.append(f"rows {lo}-{q - 1}: {windows[lo]}-row window ({ks[lo]})")
+            lo = q
+    return "; ".join(out)
+
+
+def test_under_the_65_row_floor_a_rows_kernel_depends_on_its_window(afd_fake, grid, monkeypatch, capsys):
+    """The former 65-row floor (TF_GLM_EXPERT_KERNEL_ROWS=65): in each pair of scenarios some row takes glm53f-afd's
+    kernels one way and TensorFold's the other, which made a reply depend on how it was served."""
+
+    h = _hook(monkeypatch, "65")
+    served = serve(afd_fake, monkeypatch)
+    with capsys.disabled():
+        print("\n[g53 windows] TF_GLM_EXPERT_KERNEL=g53 TF_GLM_EXPERT_KERNEL_ROWS=65 (the former floor):")
+        for name, win in served.items():
+            print(f"  {name}: {spans(win, kernels(h, win))}")
+    for a, b in PAIRS:
+        ka, kb = kernels(h, served[a]), kernels(h, served[b])
+        differ = [q for q in range(len(ka)) if ka[q] != kb[q]]
+        assert differ, (a, b)
+    assert set(kernels(h, served["40-row prompt 0 alone"])) == {"tf"}
+    assert set(kernels(h, served["40-row prompt 0 grouped"])) == {"g53"}
+    assert set(kernels(h, served["70-row prompt drafted"])) == {"tf"}          # 64 + 6: both under 65
+    assert set(kernels(h, served["70-row prompt plain"])) == {"g53"}
+    assert kernels(h, served["600-row prompt drafted, paired"])[512:] == ["tf"] * 88
+
+
+def test_every_prompt_row_takes_the_kernels_whatever_its_window(afd_fake, grid, monkeypatch, capsys):
+    """The switch's default (every prompt window, TF_GLM_EXPERT_KERNEL_ROWS unset = 1): every prompt row of every
+    scenario takes glm53f-afd's kernels, so a row's kernel (and with it its bits) never depends on how it was
+    served."""
+
+    h = _hook(monkeypatch, None)
+    assert h.min_rows == 1
+    served = serve(afd_fake, monkeypatch)
+    with capsys.disabled():
+        print("\n[g53 windows] TF_GLM_EXPERT_KERNEL=g53 (default rows):")
+        for name, win in served.items():
+            print(f"  {name}: {spans(win, kernels(h, win))}")
+    for name, win in served.items():
+        assert set(kernels(h, win)) == {"g53"}, name
+    for a, b in PAIRS:
+        assert kernels(h, served[a]) == kernels(h, served[b])
+    for R in range(1, PREFILL_ROWS + 1):                            # every window size the experts' buffers hold
+        assert h.takes(LAYER, R, True) and not h.takes(LAYER, R, False)
