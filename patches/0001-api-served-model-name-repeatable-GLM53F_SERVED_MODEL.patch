             Some(v) => number("GLM53F_MAX_SLOTS", &v)?,
             None => 16,
@@ -710,6 +718,13 @@ impl Options {
                 "--local-experts-gib" => local_gib = number(k, &val()?)?,
                 "--listen" => listen = val()?,
