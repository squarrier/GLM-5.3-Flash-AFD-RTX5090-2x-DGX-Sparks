@@ -1247,6 +1263,29 @@ mod tests {
         }
     }
 
+    #[test]
+    fn served_model_names_are_repeatable_flags_or_a_variable() {
+        let none = |k: &str| (k == "GLM53F_SPARK_ADDRS").then(|| RANK_LIST.to_string());
+        let o = Options::parse(&args("--checkpoint /c"), &none).unwrap();
+        assert!(o.served_model_names.is_empty());
+        let o = Options::parse(
+            &args("--checkpoint /c --served-model-name my-glm --served-model-name GLM-5.3-Flash-AFD"),
+            &none,
+        )
+        .unwrap();
+        assert_eq!(o.served_model_names, vec!["my-glm", "GLM-5.3-Flash-AFD"]);
+        let envset = |k: &str| match k {
+            "GLM53F_SERVED_MODEL_NAMES" => Some("a, b ,c".to_string()),
+            "GLM53F_SPARK_ADDRS" => Some(RANK_LIST.to_string()),
+            _ => None,
+        };
+        let o = Options::parse(&args("--checkpoint /c"), &envset).unwrap();
+        assert_eq!(o.served_model_names, vec!["a", "b", "c"]);
+        // flags replace the variable
+        let o = Options::parse(&args("--checkpoint /c --served-model-name x"), &envset).unwrap();
+        assert_eq!(o.served_model_names, vec!["x"]);
+    }
