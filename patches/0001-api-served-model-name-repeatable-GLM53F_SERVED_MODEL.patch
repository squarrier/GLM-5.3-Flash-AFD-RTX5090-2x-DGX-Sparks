diff --git a/crates/glm53f-api/src/types.rs b/crates/glm53f-api/src/types.rs
index 653b5ed..c383ec9 100644
--- a/crates/glm53f-api/src/types.rs
+++ b/crates/glm53f-api/src/types.rs
@@ -160,6 +160,34 @@ pub struct ChatRequest {
 /// checked, so clients that send another id are still served.
 pub const MODEL_ID: &str = "glm-5.3-flash";
 
+/// Served model names (local patch 0001, `--served-model-name`): the first is reported as the
+/// response `model` and listed first by `/v1/models`. Unset = `[MODEL_ID]` (upstream behaviour).
+static SERVED_MODEL_NAMES: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+
+/// Sets the served names once at start-up. Empty names are refused; an empty list keeps the default.
+pub fn set_served_model_names(names: Vec<String>) -> Result<(), String> {
+    if names.iter().any(|n| n.trim().is_empty()) {
+        return Err("--served-model-name: an empty name".into());
+    }
+    if names.is_empty() {
+        return Ok(());
+    }
+    SERVED_MODEL_NAMES.set(names).map_err(|_| "served model names already set".to_string())
+}
+
+/// The served names, primary first.
+pub fn served_model_names() -> Vec<String> {
+    match SERVED_MODEL_NAMES.get() {
+        Some(v) if !v.is_empty() => v.clone(),
+        _ => vec![MODEL_ID.to_string()],
+    }
+}
+
+/// The primary served name (the response `model`).
+pub fn model_id() -> String {
+    served_model_names().swap_remove(0)
+}
+
 const IMAGE_TYPES: &[&str] = &["image_url", "input_image", "image"];
 const MEDIA_TYPES: &[&str] = &["input_audio", "audio", "input_video", "video"];
 
