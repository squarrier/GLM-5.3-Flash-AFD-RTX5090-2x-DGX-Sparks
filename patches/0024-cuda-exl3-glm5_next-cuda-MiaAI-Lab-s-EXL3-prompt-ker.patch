+def test_prompt_kernel_needs_her_scope(monkeypatch):
+    odd = torch.zeros(64, dtype=torch.int16)[1:]                          # a trellis 2 bytes off a 16-byte boundary
+    cases = [(_layer(k2=6), "k2"), (_layer(cb=generic.CB_MUL1), "codebook"), (_layer(D=128), "D % 256"),
+             (_layer(NI=64), "width % 128"), (_layer(keep=[odd]), "alignment")]
+    for ex, why in cases:
+        fake, _, _, _ = _run(monkeypatch, lambda x, p, ex, s, R: generic.routed(x, p, None, ex, s, None, R,
+                                                                               act_mode=generic.ACT_BF16, prompt=True),
+                             64, ex=ex)
+        assert "prompt" not in [n for n, _ in fake.calls], why
+    fake, _, _, _ = _run(monkeypatch, lambda x, p, ex, s, R: generic.routed(x, p, None, ex, s, None, R,
+                                                                           act_mode=generic.ACT_F32, prompt=True), 64)
+    assert "prompt" not in [n for n, _ in fake.calls]                     # her kernel is GLM's bf16 SwiGLU only
+    assert generic.prompt_kernel_ready(_layer(), SLOTS) and not generic.prompt_kernel_ready(_layer(), 33)
+    with pytest.raises(ValueError, match="prompt_pass"):
+        _run(monkeypatch, lambda x, p, ex, s, R: generic.routed(x, p, None, ex, s, None, R, act_mode=generic.ACT_BF16,
+                                                               prompt=True, prompt_pass=32), 64)
