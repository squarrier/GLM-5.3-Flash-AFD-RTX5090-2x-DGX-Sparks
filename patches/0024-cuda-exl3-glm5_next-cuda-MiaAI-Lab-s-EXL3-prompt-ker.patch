+# ------------------------------------------------------------------------------------------------------ plumbing
+
+class FakeExt:
+    """The extension's calls, recorded (no kernel runs)."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __getattr__(self, name):
+        def call(*args):
+            self.calls.append((name, args))
+        return call
+
+    def named(self, name):
+        return [a for n, a in self.calls if n == name]
+
+
+def _layer(D=256, NI=128, k2=8, cb=generic.CB_MCG, share=True, keep=()):
+    g = torch.Generator().manual_seed(1)
+
+    def sc(n):
+        return (torch.rand((E, n), generator=g) + 0.5).half()
+
+    suh = sc(D)[:1].expand(E, D).contiguous() if share else sc(D)
+    i64, i32 = torch.zeros(E, dtype=torch.int64), torch.full((E,), k2, dtype=torch.int32)
+    ex = generic.Exl3RoutedExperts(i64, i64.clone(), i64.clone(), i32, i32, i32, suh, suh.clone(), sc(NI), sc(NI),
+                                   sc(NI), sc(D), E, D, NI, cb, (k2, k2), (k2, k2), torch.zeros(E, dtype=torch.int64),
+                                   list(keep))
+    return exl3_generic.share_suh(ex)
+
+
+def _run(monkeypatch, fn, R, ex=None, rows=2048):
+    fake = FakeExt()
+    monkeypatch.setattr(generic, "_ext", lambda: fake)
+    ex = ex or _layer()
+    s = generic.Scratch(ex, rows, SLOTS, device="cpu")
+    x = torch.zeros((R, ex.dims), dtype=torch.bfloat16)
+    pick = torch.zeros((R, SLOTS), dtype=torch.int32)
+    out = fn(x, pick, ex, s, R)
+    return fake, ex, s, out
+
+
+def _glm(prompt):
+    return lambda x, p, ex, s, R: exl3_generic.routed(x, p, ex, s, R, 7.0, prompt=prompt)
+
+
+@pytest.mark.parametrize("R", (1, 8, 63, 64, 594, 2048))
+def test_switch_on_prompt_chunks_take_her_kernel(monkeypatch, R):
+    monkeypatch.setenv("TF_GLM_EXL3_PROMPT", "1")
+    fake, ex, s, out = _run(monkeypatch, _glm(True), R)
+    assert [n for n, _ in fake.calls] == ["group", "rot_rows", "prompt"]   # every prompt chunk, as her Buffers(prefill)
+    (a,) = fake.named("prompt")
+    items, counts, obuf = s.prompt_bufs
+    cap = generic.prompt_items(R, SLOTS, E, 64)
+    ids, members = s.window(R)
+    assert a[0] is s.xg and a[1] is s.xg                                 # one rotated row a token for gate and up
+    assert a[2] is ex.gate_ptr and a[3] is ex.up_ptr and a[4] is ex.down_ptr
+    assert torch.equal(a[5], ids) and a[6] is s.count and torch.equal(a[7], members)
+    assert a[8] is items and a[9] is counts and a[10] is obuf
+    assert a[11:15] == (ex.svh_g, ex.svh_u, ex.suh_d, ex.svh_d) and a[15] is s.xd and a[16] is s.y
+    assert a[17:] == (ex.dims, ex.width, E, cap, 7.0, 64, SLOTS, True)
+    assert items.numel() == 3 * generic.prompt_items(2048, SLOTS, E, 64) and obuf.numel() * 3 == items.numel()
+    assert out.data_ptr() == s.y.data_ptr() and out.shape == (R * SLOTS, ex.dims)
+    rr = fake.named("rot_rows")[0]
+    assert rr[2] is ex.shared_suh and rr[3] is s.xg and rr[4:] == (R, ex.dims)
+
