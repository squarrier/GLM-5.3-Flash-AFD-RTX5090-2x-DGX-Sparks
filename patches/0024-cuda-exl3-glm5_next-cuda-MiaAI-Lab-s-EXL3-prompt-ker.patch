index 0000000..1c17b92
--- /dev/null
+++ b/tests/cuda/test_exl3_prompt_kernel.py
@@ -0,0 +1,299 @@
+"""MiaAI-Lab's EXL3 prompt kernel on the universal route (her GLM-5.3-Flash recipe patch 0004 at the end of her
+chain, ``tensorfold/cuda/exl3/experts_prompt.cu``) against her own kernel on the GPU: byte-equal per shape.
+
+Her kernel is built here from her tree: TF_MIA_TREE names the ``src`` directory of the recipe's TensorFold tree
+(the recipe @ 1576746's patches 0001-0068 applied to TensorFold v0.6.0), whose
+``tensorfold/families/glm5_next/cuda/exl3.cpp`` / ``exl3.cu`` build with her extension's flags (-O3 and this GPU's
+arch, as her ``exl3_mm._ext`` through ``tensorfold.cuda.build.load``). Without TF_MIA_TREE the comparison skips; the
+self-checks run anyway.
+
+On a GLM-shaped synthetic layer (288 experts, 4096 -> 1024 a half, 4-bit mcg trellises), with one gate/up suh shared
+by every expert (GLM-5.3-Flash's EXL3 layers) and with one an expert, at prompt windows of 1 to 2,048 rows with
+uniform and skewed routing:
+- ours (``experts.routed(.., prompt=True)``: group(), her rotations, ``prompt``) and hers (her rotations, her plan,
+  her ``prompt``) write the same xd (fp16) and Y (fp32) bytes, rows they do not write included, at passes of 64 and
+  128 members, her item order on and off, the input rotated once a row and once a pair;
+- ours gives the same bytes twice, and a row's outputs do not depend on the rows windowed with it (her kernel's "any
+  chunking gives the same prompt state");
+- for information (printed with -s, and to TF_EXL3_PROMPT_IDENT_OUT as JSON): the kernels' times, and how far the prompt bits
+  are from the grouped kernel's (the outputs class)."""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import os
+import random
+from functools import lru_cache
+from pathlib import Path
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA only")
+
+E, D, NI, TOPK, SLOTS, LIMIT = 288, 4096, 1024, 8, 9, 10.0
+ROWS = (1, 16, 63, 64, 65, 594, 1024, 2048)
+MIA_TREE = os.environ.get("TF_MIA_TREE", "").strip()
+# her end state's files (patches 0001-0068 on v0.6.0): the reference must be exactly these
+MIA_SHA256 = {"exl3.cu": "160c054a8069e191979a993c8b9f323f8485ca2b20bd4f1035c6fced2557ed37",
+              "exl3.cpp": "ebbe4494a3e0475420f57d881854858f727b76729ec6a6240eaffb9682a6dac9"}
+REPORT: dict = {"cases": [], "speed": [], "grouped": []}
+
+
+def _report(key: str, row: dict) -> None:
+    REPORT[key].append(row)
+    out = os.environ.get("TF_EXL3_PROMPT_IDENT_OUT", "").strip()
+    if out:
+        Path(out).write_text(json.dumps(REPORT, indent=1))
+
+
+@lru_cache(maxsize=1)
+def _mia():
+    """Her dedicated exl3 extension (exl3.cpp + exl3.cu at the end of her chain), built from TF_MIA_TREE with her flags."""
+
+    from tensorfold.cuda.build import load
+
+    d = Path(MIA_TREE) / "tensorfold/families/glm5_next/cuda"
+    for name, want in MIA_SHA256.items():
+        got = hashlib.sha256((d / name).read_bytes()).hexdigest()
+        assert got == want, f"TF_MIA_TREE's {name} is not her chain's end state ({got[:16]})"
+    return load(name="ref_tensorfold_glm_exl3_v20", sources=[str(d / "exl3.cpp"), str(d / "exl3.cu")],
+                extra_cuda_cflags=["-O3"], verbose=False)
+
+
+def _need_mia():
+    if not MIA_TREE:
+        pytest.skip("TF_MIA_TREE (the recipe tree's src: patches 0001-0068 on v0.6.0) is not set")
+    return _mia()
+
+
+@lru_cache(maxsize=2)
+def _layer(share: bool):
+    """(ours, hers): our Exl3RoutedExperts over stacked synthetic trellises, and her stacked int32 words of the same."""
+
+    from tensorfold.cuda.exl3 import experts
+    from tensorfold.families.glm5_next.cuda import exl3_generic
+
+    g = torch.Generator().manual_seed(11)
+
+    def trel(k, n):                                   # 4-bit trellis tiles: 64 int16 a 16x16 tile
+        v = torch.randint(-32768, 32768, (E, k // 16, n // 16, 64), dtype=torch.int32, generator=g)
+        return v.to(torch.int16).cuda().contiguous()
+
+    def sc(n, mag):
+        sign = torch.randint(0, 2, (E, n), generator=g).float() * 2 - 1
+        return (sign * (torch.rand((E, n), generator=g) + 0.5) * mag).half().cuda().contiguous()
+
+    gt, ut, dt = trel(D, NI), trel(D, NI), trel(NI, D)
+    suh_g = sc(D, 0.02)
+    if share:
+        suh_g = suh_g[:1].expand(E, D).contiguous()
+    suh_u = suh_g.clone() if share else sc(D, 0.02)
+    svh_g, svh_u, suh_d, svh_d = sc(NI, 0.5), sc(NI, 0.5), sc(NI, 0.05), sc(D, 0.2)
+    ex = exl3_generic.share_suh(experts.prepare_stacked(gt, ut, dt, suh_g, suh_u, svh_g, svh_u, suh_d, svh_d, "mcg"))
+    hers = {"gt": gt.view(torch.int32), "ut": ut.view(torch.int32), "dt": dt.view(torch.int32), "suh_g": suh_g,
+            "suh_u": suh_u, "svh_g": svh_g, "svh_u": svh_u, "suh_d": suh_d, "svh_d": svh_d}
+    return ex, hers
+
+
+def _inputs(R: int, skew: bool, seed: int):
+    rng, g = random.Random(seed), torch.Generator().manual_seed(seed)
+    hot = rng.sample(range(E), 12)
+    rows = []
+    for _ in range(R):
+        if skew:
+            row = rng.sample(hot, 6) + rng.sample([e for e in range(E) if e not in hot], TOPK - 6)
+        else:
+            row = rng.sample(range(E), TOPK)
+        rows.append(row + [E])                        # the shared slot (id E): not an EXL3 expert
+    pick = torch.tensor(rows, dtype=torch.int32).cuda().contiguous()
+    x = torch.randn((R, D), generator=g).to(torch.bfloat16).cuda()
+    return x, pick
+
+
+def _her_plan(pick: torch.Tensor, tile: int):
+    """Her plan_kernel's plan (the recipe's tensorfold/cuda/experts.cu, place_items): pairs p = row * slots + slot grouped by
+    expert in pair order over her plan's experts (the routed ones and the shared one, id E); items (expert, first,
+    count) of up to ``tile`` pairs in expert order; counts [items, distinct experts]; her max_items."""
+
+    flat = pick.reshape(-1).long()
+    P = flat.numel()
+    members = torch.argsort(flat * P + torch.arange(P, device=flat.device)).to(torch.int32).contiguous()
+    cnt = torch.bincount(flat, minlength=E + 1).tolist()
+    items, off = [], 0
+    for e, c in enumerate(cnt):
+        items += [(e, off + tile * j, min(tile, c - tile * j)) for j in range((c + tile - 1) // tile)]
+        off += c
+    cap = min(P, E + 1) + P // tile
+    it = torch.zeros((cap, 3), dtype=torch.int32)
+    it[:len(items)] = torch.tensor(items, dtype=torch.int32)
+    counts = torch.tensor([len(items), sum(c > 0 for c in cnt)], dtype=torch.int32)
+    return members, it.cuda().contiguous(), counts.cuda(), cap
+
+
+def _rot_rows_of(xg, xu, pick, R: int, shx: bool):
+    """The rotated inputs both sides write: one row a token (``shx``), else every routed pair's gate and up rows."""
+
+    if shx:
+        return xg[:R].clone()
+    live = (pick.reshape(-1) < E).nonzero().squeeze(1)
+    return torch.cat([xg[live], xu[live]])
+
+
+def _hers_prepared(mia, h: dict, ex, x, pick, R: int, pm: int, order: bool, shx: bool):
+    """Her prompt branch (her exl3_mm.routed at the end of her chain) as a closure: her plan built once (on the host,
+    as her plan_kernel lays it out), then each call her rotation and her ``prompt``. Returns (run, xd, y, xg, xu)."""
+
+    P = R * SLOTS
+    xg = torch.zeros((P, D), dtype=torch.float16, device="cuda")
+    xu = xg if shx else torch.zeros_like(xg)
+    xd = torch.full((P, NI), float("nan"), dtype=torch.float16, device="cuda")
+    y = torch.full((P, D), float("nan"), dtype=torch.float32, device="cuda")
+    members, items, counts, cap = _her_plan(pick, pm)
+    obuf = torch.full((cap,), -1, dtype=torch.int32, device="cuda") if order else None
+
+    def run():
+        if shx:
+            mia.rot_rows(x, x.stride(0), ex.shared_suh, xg, R, D)
+        else:
+            mia.rot_in(x, x.stride(0), pick, h["suh_g"], h["suh_u"], xg, xu, R, D, SLOTS)
+        mia.prompt(xg, xu, h["gt"], h["ut"], h["dt"], items, counts, members, h["svh_g"], h["svh_u"], h["suh_d"],
+                   h["svh_d"], xd, y, D, NI, E, cap, LIMIT, pm, SLOTS, shx, obuf)
+
+    return run, xd, y, xg, xu
+
+
+def _hers(mia, h: dict, ex, x, pick, R: int, pm: int, order: bool, shx: bool):
+    """Her prompt branch once: xd, Y and the rotated inputs."""
+
+    run, xd, y, xg, xu = _hers_prepared(mia, h, ex, x, pick, R, pm, order, shx)
+    run()
+    return xd, y, _rot_rows_of(xg, xu, pick, R, shx)
+
+
+def _ours(s, ex, x, pick, R: int, pm: int, order: bool, rowrot: bool):
+    from tensorfold.cuda.exl3 import experts
+
+    P = R * SLOTS
+    s.xd[:P].fill_(float("nan"))
+    s.y[:P].fill_(float("nan"))
+    experts.routed(x, pick, None, ex, s, None, R, limit=LIMIT, act_mode=experts.ACT_BF16, prompt=True,
+                   prompt_pass=pm, order=order, rowrot=rowrot)
+    shx = rowrot and ex.shared_suh is not None
+    return s.xd[:P].clone(), s.y[:P].clone(), _rot_rows_of(s.xg, s.xg if shx else s.xu, pick, R, shx)
+
+
+def _first_diff(a: torch.Tensor, b: torch.Tensor) -> str:
+    ai, bi = a.view(torch.int16 if a.dtype == torch.float16 else torch.int32), \
+        b.view(torch.int16 if b.dtype == torch.float16 else torch.int32)
+    bad = (ai != bi).nonzero()
+    if not bad.numel():
+        return "same"
+    r, c = bad[0].tolist()
+    return f"{bad.shape[0]} elements differ; first [{r} (row {r // SLOTS} slot {r % SLOTS}), {c}]: {a[r, c]} vs {b[r, c]}"
+
+
+def _scratch(ex):
+    from tensorfold.cuda.exl3 import experts
+
+    s = experts.Scratch(ex, max(ROWS), SLOTS, experts.GLM_GATEUP, experts.GLM_DOWN)
+    assert experts.prompt_kernel_ready(ex, SLOTS)
+    return s
+
+
+@pytest.mark.parametrize("share", (True, False), ids=("shared-suh", "own-suh"))
+def test_prompt_kernel_is_hers_byte_for_byte(share):
+    mia = _need_mia()
+    ex, h = _layer(share)
+    assert (ex.shared_suh is not None) is share
+    s = _scratch(ex)
+    bad = []
+    for R, skew in itertools.product(ROWS, (False, True)):
+        x, pick = _inputs(R, skew, seed=R * 2 + skew)
+        for pm, order, rowrot in itertools.product((64, 128), (False, True), (True, False) if share else (False,)):
+            xd, y, xr = _ours(s, ex, x, pick, R, pm, order, rowrot)
+            hxd, hy, hxr = _hers(mia, h, ex, x, pick, R, pm, order, rowrot and share)
+            dx, dy = _first_diff(xd, hxd), _first_diff(y, hy)
+            drot = "same" if torch.equal(xr.view(torch.int16), hxr.view(torch.int16)) else "DIFFERENT"
+            ok = dx == "same" and dy == "same"
+            written = int(torch.isfinite(y).all(1).sum())             # rows written: the routed pairs
+            _report("cases", {"share": share, "R": R, "skew": skew, "pass": pm, "order": order, "rowrot": rowrot,
+                              "same": ok, "xd": dx, "y": dy, "rotated_inputs": drot, "rows_written": written,
+                              "y_sha": hashlib.sha256(y.cpu().numpy().tobytes()).hexdigest()[:16]})
+            assert written == R * TOPK
+            if not ok:
+                bad.append((R, skew, pm, order, rowrot, dx, dy, f"rotated inputs {drot}"))
+    print(f"EXL3_PROMPT_IDENT {'OK' if not bad else 'DIFF'} share={share}: {len(bad)} of "
+          f"{len(ROWS) * 2 * 4 * (2 if share else 1)} cases differ {bad[:3]}")
+    assert not bad, bad[:3]
+
+
+@pytest.mark.parametrize("share", (True, False), ids=("shared-suh", "own-suh"))
+def test_prompt_kernel_rows_are_their_own(share):
+    """Twice the same bytes, and a 2,048-row window's rows equal the same rows run as windows of 594 and 1,454."""
+
+    ex, _ = _layer(share)
+    s = _scratch(ex)
+    R, cut = 2048, 594
+    x, pick = _inputs(R, True, seed=7)
+    for pm, order in itertools.product((64, 128), (False, True)):
+        xd, y, _ = _ours(s, ex, x, pick, R, pm, order, True)
+        xd2, y2, _ = _ours(s, ex, x, pick, R, pm, order, True)
+        assert _first_diff(y, y2) == "same" and _first_diff(xd, xd2) == "same"
+        a_xd, a_y, _ = _ours(s, ex, x[:cut].contiguous(), pick[:cut].contiguous(), cut, pm, order, True)
+        b_xd, b_y, _ = _ours(s, ex, x[cut:].contiguous(), pick[cut:].contiguous(), R - cut, pm, order, True)
+        assert _first_diff(torch.cat([a_y, b_y]), y) == "same", (pm, order)
+        assert _first_diff(torch.cat([a_xd, b_xd]), xd) == "same", (pm, order)
+
+
+def _time(fn, reps: int = 5) -> float:
+    fn()
+    ts = []
+    for _ in range(reps):
+        a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        a.record()
+        fn()
+        b.record()
+        b.synchronize()
+        ts.append(a.elapsed_time(b))
+    return sorted(ts)[len(ts) // 2]
+
+
+def test_report_speed_and_distance_from_the_grouped_kernel():
+    """Information only: each path's time (ms, median of 5) and the prompt bits' distance from the grouped kernel's."""
+
+    from tensorfold.cuda.exl3 import experts
+    from tensorfold.families.glm5_next.cuda import exl3_generic
+
+    ex, h = _layer(True)
+    s = _scratch(ex)
+    mia = _mia() if MIA_TREE else None
+    for R in (64, 128, 594, 1024, 2048):
+        x, pick = _inputs(R, False, seed=R)
+        sw = exl3_generic.switches(R)                  # the prompt launch switches, as the GLM call site sets them
+        P = R * SLOTS
+
+        def grouped(x=x, pick=pick, R=R, sw=sw):
+            return experts.routed(x, pick, None, ex, s, None, R, limit=LIMIT, act_mode=experts.ACT_BF16, **sw)
+
+        def ours(x=x, pick=pick, R=R):
+            return experts.routed(x, pick, None, ex, s, None, R, limit=LIMIT, act_mode=experts.ACT_BF16, prompt=True,
+                                  order=True, rowrot=True)
+
+        row = {"R": R, "grouped_ms": _time(grouped), "ours_ms": _time(ours)}
+        if mia is not None:                            # her rotation and kernels, her plan prepared beforehand
+            row["mia_ms"] = _time(_hers_prepared(mia, h, ex, x, pick, R, 64, True, True)[0])
+        _report("speed", row)
+        gy = grouped().clone()
+        py = ours().clone()
+        routed = torch.isfinite(gy).all(1) & (pick.reshape(-1) < E)
+        d = (py[routed] - gy[routed]).abs()
+        rel = d.max() / gy[routed].abs().max().clamp_min(1e-30)
+        _report("grouped", {"R": R, "differ_frac": float((py[routed] != gy[routed]).float().mean()),
+                            "max_abs": float(d.max()), "max_rel_to_max": float(rel)})
+        hers = "" if mia is None else f", hers {row['mia_ms']:.3f} ms"
+        print(f"R={R}: grouped {row['grouped_ms']:.3f} ms, prompt kernel {row['ours_ms']:.3f} ms{hers}; "
+              f"vs grouped bits: {REPORT['grouped'][-1]}")
+        assert P > 0
