         self.order = torch.full((order_slots(rows, slots, ex.count),), -1, dtype=torch.int32, device=device)
+        # ``routed``'s ``prompt`` kernel's plan and order buffers (``_prompt_buffers``), made on its first window
+        self.prompt_bufs: tuple[torch.Tensor, torch.Tensor, torch.Tensor] | None = None
 
     def window(self, R: int):
         """(ids, members) sized for R rows: the grids only span what R rows can use."""
@@ -225,11 +231,42 @@ def nc_aligned(ex: Exl3RoutedExperts) -> bool:
     return ok
 
 
+def prompt_kernel_ready(ex: Exl3RoutedExperts, slots: int) -> bool:
+    """Whether ``routed``'s ``prompt`` (MiaAI-Lab recipe patch 0004's prompt kernel) applies: her kernel's scope, 4-bit
+    mcg experts (one 32-bit word a lane a tile), widths in its blocks (D: 256 columns, the width: 128), trellises on
+    16-byte boundaries (its cp.async stages), at most 32 slots (group()'s member codes)."""
+
+    return (ex.cb == CB_MCG and tuple(ex.k2_gu) == PROMPT_K2 and tuple(ex.k2_d) == PROMPT_K2
+            and ex.dims % 256 == 0 and ex.width % 128 == 0 and 1 <= slots <= 32 and nc_aligned(ex))
+
+
+def prompt_items(R: int, slots: int, count: int, pass_: int) -> int:
+    """The prompt kernel's launch slots (grid y) for R rows: her plan's ``max_items`` for R * slots pairs over the
+    routed experts and the shared one (an item per used expert, plus one per ``pass_`` pairs past its first)."""
+
+    return min(R * slots, count + 1) + (R * slots) // pass_
+
+
+def _prompt_buffers(s: Scratch, count: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """The prompt kernel's plan (items [3 x launch slots], counts [2]) and order buffers, sized for ``s``'s widest
+    window at the smaller pass; made on the first prompt window (a few KB), so a scratch that never takes one is
+    unchanged."""
+
+    bufs = s.prompt_bufs
+    if bufs is None:
+        cap = prompt_items(s.rows, s.slots, count, min(PROMPT_PASSES))
+        dev = s.xg.device
+        bufs = (torch.zeros((3 * cap,), dtype=torch.int32, device=dev), torch.zeros((2,), dtype=torch.int32, device=dev),
+                torch.full((cap,), -1, dtype=torch.int32, device=dev))
+        s.prompt_bufs = bufs
+    return bufs
+
+
 def routed(x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor | None, ex: Exl3RoutedExperts, s: Scratch,
            out: torch.Tensor | None, R: int, limit: float = math.inf, act_mode: int = ACT_F32,
            group: bool = True, *, nfirst: bool = False, prefetch: bool = False, order: bool = False,
            rowrot: bool = False, dec: bool = False, fuse: int = 1, dec_xrow: bool = False,
-           loads: int = 0) -> torch.Tensor:
+           loads: int = 0, prompt: bool = False, prompt_pass: int = 64) -> torch.Tensor:
     """Routed experts of R rows (picks >= E skipped): Y per slot, or ``out`` = the wts-weighted sum when ``wts``; no host sync.
 
     The prompt switches (all off by default; GLM sets them for prompt windows) change only the launch, never a bit
@@ -241,7 +278,14 @@ def routed(x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor | None, ex: Ex
     patches 0016 and 0047) keep every bit too: ``dec`` runs gate/up and down through the decode kernel, ``fuse`` 1 with
     the down projection's epilogue in it, ``dec_xrow`` one rotated input a row (a ``shared_suh`` layer), ``loads``
     1..3 its 16-byte trellis loads 1 / 2 / 4 k steps ahead (0 without 16-byte aligned trellises). Off unless
-    ``dec_ready``."""
+    ``dec_ready``.
+
+    ``prompt`` (off by default; GLM's expert node sets it for prompt chunks under TF_GLM_EXL3_PROMPT=1) runs the window
+    through her prompt kernel (recipe patch 0004 at the end of her chain, experts_prompt.cu): passes of
+    ``prompt_pass`` members (64 or 128), one fp32 mma chain over ascending k an output, the gate/up and down epilogues
+    fused, with ``order`` her item order and ``rowrot`` one rotated input a row. Her lane's prompt bits, not the grouped
+    kernel's split-K sums (outputs class), for GLM's bf16 SwiGLU (``act_mode`` ACT_BF16) only. Off unless
+    ``prompt_kernel_ready``."""
 
     ext = _ext()
     D, I, E = ex.dims, ex.width, ex.count
@@ -252,6 +296,8 @@ def routed(x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor | None, ex: Ex
     ids, members = s.window(R)
     if group:
         ext.group(pick, ids, s.count, members, R, slots, E)
+    if prompt and act_mode == ACT_BF16 and prompt_kernel_ready(ex, slots):
+        return _prompt_routed(ext, x, pick, wts, ex, s, out, R, limit, ids, members, prompt_pass, order, rowrot)
     if (nfirst or prefetch or order or rowrot) and not prompt_ready(ex, s):
         nfirst = prefetch = order = rowrot = False
     rowrot = rowrot and ex.shared_suh is not None
@@ -327,6 +373,38 @@ def _dec_routed(ext, x, pick, wts, ex: Exl3RoutedExperts, s: Scratch, out, R: in
     return out
 
 
+def _prompt_routed(ext, x, pick, wts, ex: Exl3RoutedExperts, s: Scratch, out, R: int, limit: float, ids, members,
+                   pass_: int, order: bool, rowrot: bool) -> torch.Tensor:
+    """``routed`` for a prompt window through MiaAI-Lab's prompt kernel (recipe patch 0004, her exl3_mm.routed's
+    prompt branch on this grouping): her rotations (``rot_rows`` for a ``shared_suh`` layer under ``rowrot``, else
+    ``rot_in``), then ``ext.prompt``: the plan, her item order under ``order``, her gate/up and down kernels writing xd
+    and Y. No Z partials; the combine is ``combine``'s fma chain, as the fused decode path's."""
+
+    if pass_ not in PROMPT_PASSES:
+        raise ValueError(f"routed: prompt_pass is 64 or 128, not {pass_}")
+    D, NI, E = ex.dims, ex.width, ex.count
+    slots = s.slots
+    P = R * slots
+    items, counts, obuf = _prompt_buffers(s, E)
+    cap = prompt_items(R, slots, E, pass_)
+    shx = rowrot and ex.shared_suh is not None
+    if shx:                                             # one rotated input a row, read by all its pairs' gate and up
+        ext.rot_rows(x, x.stride(0), ex.shared_suh, s.xg, R, D)
+        xg = xu = s.xg
+    else:
+        ext.rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, R, D, slots, E)
+        xg, xu = s.xg, s.xu
+    ext.prompt(xg, xu, ex.gate_ptr, ex.up_ptr, ex.down_ptr, ids, s.count, members, items, counts,
+               obuf if order else None, ex.svh_g, ex.svh_u, ex.suh_d, ex.svh_d, s.xd, s.y, D, NI, E, cap, float(limit),
+               pass_, slots, shx)
+    if wts is None:
+        return s.y[:P]
+    if out is None:
+        out = torch.empty((R, D), dtype=torch.float32, device=x.device)
+    ext.combine(s.y, wts, out, R, D, slots)
+    return out
+
+
 def dequant(trellis: torch.Tensor, codebook: int | str) -> torch.Tensor:
     """W_q [K, N] fp16 of one matrix through the kernels' own lane decode (ExLlamaV3's ``reconstruct``); for tests."""
 
