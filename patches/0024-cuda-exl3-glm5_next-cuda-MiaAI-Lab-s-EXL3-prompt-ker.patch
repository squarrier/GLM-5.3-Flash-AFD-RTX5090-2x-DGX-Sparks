+def _node(monkeypatch):
+    from tensorfold.families.glm5_next.cuda import experts_node
+
+    ex = _layer()
+    node = experts_node.ExpertNode.__new__(experts_node.ExpertNode)
+    node.cfg = SimpleNamespace(hidden=ex.dims, top_k=TOPK, moe_width=2 * ex.width, experts=E, limit=7.0)
+    node.half, node.layers, node.experts, node.by_layer = 0, [3, 4], [ex, ex], {3: ex, 4: ex}
+    node.buf = experts_node.ExpertBuffers(node.cfg, rows=8, prefill_rows=128, device="cpu")
+    return experts_node, node
