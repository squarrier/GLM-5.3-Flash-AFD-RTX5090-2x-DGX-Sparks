 static void check(const at::Tensor& x, at::ScalarType t, const char* name) {
     TORCH_CHECK(x.is_cuda() && x.scalar_type() == t && x.is_contiguous(), name,
@@ -190,6 +195,36 @@ void dec(const at::Tensor& X0, const at::Tensor& X1, const at::Tensor& TP0, cons
     exl3x_dec_cuda(X0, X1, TP0, TP1, uids, ucount, members, Z, svh, y, mats, K, N, P, SK, slots, fuse, xrow, ld);
 }
 
+// A prompt window's routed experts through MiaAI-Lab's prompt kernel (TF_GLM_EXL3_PROMPT; recipe patch 0004,
+// experts_prompt.cu): group()'s grouping as her plan of `pass`-member items, her item order when `order` is given,
+// then xd [P, N] fp16 and y [P, D] fp32 of every routed pair (one fp32 mma chain an output, the epilogues fused).
+void prompt(const at::Tensor& Xg, const at::Tensor& Xu, const at::Tensor& TPg, const at::Tensor& TPu,
+            const at::Tensor& TPd, const at::Tensor& uids, const at::Tensor& ucount, const at::Tensor& members,
+            at::Tensor items, at::Tensor counts, c10::optional<at::Tensor> order, const at::Tensor& svh_g,
+            const at::Tensor& svh_u, const at::Tensor& suh_d, const at::Tensor& svh_d, at::Tensor xd, at::Tensor y,
+            int64_t D, int64_t N, int64_t E, int64_t max_items, double limit, int64_t pass, int64_t slots,
+            bool shx) {
+    for (auto* t : {&Xg, &Xu, &svh_g, &svh_u, &suh_d, &svh_d}) check(*t, at::kHalf, "prompt: fp16 input");
+    for (auto* t : {&TPg, &TPu, &TPd}) check(*t, at::kLong, "prompt: trellis pointers");
+    for (auto* t : {&uids, &ucount, &members}) check(*t, at::kInt, "prompt: int32 input");
+    check(items, at::kInt, "prompt: items");
+    check(counts, at::kInt, "prompt: counts");
+    check(xd, at::kHalf, "prompt: xd");
+    check(y, at::kFloat, "prompt: y");
+    TORCH_CHECK(TPg.numel() >= E && TPu.numel() >= E && TPd.numel() >= E, "prompt: a trellis pointer an expert");
+    TORCH_CHECK(members.dim() == 2 && members.size(0) >= uids.numel(), "prompt: members [>= uids, maxm]");
+    TORCH_CHECK(max_items > 0 && items.numel() >= 3 * max_items && counts.numel() >= 2, "prompt: plan buffers");
+    TORCH_CHECK(!shx || Xg.data_ptr() == Xu.data_ptr(), "prompt: shared rows take one Xh for gate and up");
+    TORCH_CHECK(slots > 0 && slots <= 32, "prompt: 1 to 32 slots a row");
+    TORCH_CHECK(svh_g.size(-1) == N && svh_u.size(-1) == N && suh_d.size(-1) == N && svh_d.size(-1) == D,
+                "prompt: scales [E, N] (gate, up, down's suh) and [E, D] (down's svh)");
+    TORCH_CHECK(xd.size(-1) == N && y.size(-1) == D, "prompt: xd [P, N], y [P, D]");
+    if (order.has_value()) check(*order, at::kInt, "prompt: order");
+    c10::cuda::CUDAGuard guard(Xg.device());
+    exl3x_prompt_cuda(Xg, Xu, TPg, TPu, TPd, uids, ucount, members, items, counts, order, svh_g, svh_u, suh_d, svh_d,
+                      xd, y, D, N, E, max_items, limit, pass, slots, shx);
+}
+
 PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
     m.def("grouped", &grouped);
     m.def("dequant", &dequant);
@@ -202,4 +237,5 @@ PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
     m.def("combine", &combine);
     m.def("down_combine", &down_combine);
     m.def("dec", &dec);
+    m.def("prompt", &prompt);
 }
