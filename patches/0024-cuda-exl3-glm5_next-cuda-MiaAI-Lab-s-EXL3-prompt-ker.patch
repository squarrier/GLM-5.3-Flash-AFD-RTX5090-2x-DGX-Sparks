+    seen = []
+    monkeypatch.setattr(experts_node.exl3_generic, "routed", lambda *a, **k: seen.append(k))
+    monkeypatch.setattr(experts_node.glue, "combine", lambda ey, wts, out: None)
+    assert node.prompt is False                                           # the class default: a decode window
+    node.compute(3, 64)
+    node.prompt = True
+    node.compute(3, 8)
+    assert seen == [{"prompt": False}, {"prompt": True}]
