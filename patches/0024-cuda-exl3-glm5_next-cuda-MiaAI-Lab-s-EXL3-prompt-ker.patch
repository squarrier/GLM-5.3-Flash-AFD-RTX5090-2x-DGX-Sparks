--- /dev/null
+++ b/tests/test_exl3_prompt_kernel.py
@@ -0,0 +1,422 @@
+"""MiaAI-Lab's EXL3 prompt kernel on the universal route (her GLM-5.3-Flash recipe patch 0004 at the end of her
+chain, ``tensorfold/cuda/exl3/experts_prompt.cu``), on CPU:
+
+- a model of ``prompt_plan_kernel`` (group()'s grouping laid out as her plan) gives exactly the routed items her
+  ``plan_kernel`` gives (expert, members' pairs p, count), in her order, within ``prompt_items`` launch slots; her
+  ``prompt_order_kernel`` (modelled) then gives the same launch order on both plans;
+- the switch: ``exl3_generic.prompt_switches`` reads her names (TF_GLM_EXL3_PROMPT, default off here, and
+  TF_GLM_EXL3_PASS, ORDER, ROWROT), and refuses other values; unset, every GLM call is the call before, argument for
+  argument;
+- the plumbing: ``generic.routed(.., prompt=True)`` makes the prompt kernel's calls (her rotations, then ``prompt``)
+  only for her kernel's scope, else the launches before; the expert node marks prompt chunks (MODE_CHUNK, MODE_SLICE,
+  MODE_PAIR) from the forward's mode, and ``compute`` passes the mark.
+The GPU side (bits against her kernel, built from her tree) is tests/cuda/test_exl3_prompt_kernel.py."""
+
+from __future__ import annotations
+
+import random
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tensorfold.cuda.exl3 import experts as generic
+from tensorfold.families.glm5_next.cuda import exl3_generic
+
+E, TOPK, SLOTS = 288, 8, 9                    # GLM-5.3-Flash: 288 routed experts, top 8, the shared expert last
+ENVS = ("TF_GLM_EXL3_PROMPT", "TF_GLM_EXL3_PASS", "TF_GLM_EXL3_ORDER", "TF_GLM_EXL3_ROWROT", "TF_GLM_EXL3_NFIRST",
+        "TF_GLM_EXL3_PF", "TF_GLM_EXL3_DEC", "TF_GLM_EXL3_LOADS", "TF_GLM_EXL3_FUSE", "TF_GLM_EXL3_XROW")
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    for v in ENVS:
+        monkeypatch.delenv(v, raising=False)
+
+
+# ----------------------------------------------------------------------------------------------- the plans (models)
+
+def picks(R: int, rng: random.Random, skew: bool) -> list[list[int]]:
+    """R rows of TOPK distinct routed experts and the shared slot (id E); ``skew``: a few experts take most rows."""
+
+    hot = rng.sample(range(E), 12)
+    rows = []
+    for _ in range(R):
+        if skew:
+            row = rng.sample(hot, 6) + rng.sample([e for e in range(E) if e not in hot], TOPK - 6)
+        else:
+            row = rng.sample(range(E), TOPK)
+        rows.append(row + [E])
+    return rows
+
+
+def group(pick: list[list[int]], maxm: int) -> tuple[list[int], list[int]]:
+    """group_kernel: distinct routed experts (< E) in id order; members row * 32 + slot in row order, -1 after."""
+
+    n = len(pick) * SLOTS
+    flat = [pick[i // SLOTS][i % SLOTS] for i in range(n)]
+    uids = sorted({e for e in flat if 0 <= e < E})
+    members: list[int] = []
+    for e in uids:
+        m = [(i // SLOTS) * 32 + i % SLOTS for i in range(n) if flat[i] == e][:maxm]
+        members += m + [-1] * (maxm - len(m))
+    return uids, members
+
+
+def our_plan(uids: list[int], members: list[int], maxm: int, pm: int, cap: int) -> tuple[list[tuple], list[int]]:
+    """prompt_plan_kernel: each expert's members counted up to its first -1, its items in pass order after the items
+    of the experts before it (the block's exclusive scan); items (expert, first, count), counts [items, experts]."""
+
+    per_u = []
+    for u in range(len(uids)):
+        row = members[u * maxm:(u + 1) * maxm]
+        n = next((i for i, c in enumerate(row) if c < 0), maxm) if uids[u] < E else 0
+        per_u.append(n)
+    items = []
+    for u, n in enumerate(per_u):
+        j = 0
+        while j * pm < n:
+            items.append((uids[u], u * maxm + j * pm, min(pm, n - j * pm)))
+            j += 1
+    assert len(items) <= cap, "the kernel traps here: cap must bound every grouping"
+    return items, [len(items), len(uids)]
+
+
+def her_plan(pick: list[list[int]], experts: int, tile: int) -> tuple[list[tuple], list[int], list[int]]:
+    """MiaAI-Lab's plan_kernel (the recipe's tensorfold/cuda/experts.cu, place_items): pairs p = row * slots + slot
+    grouped by expert in pair order; items (expert, first, count) of <= tile pairs in expert order; counts [items,
+    distinct experts]. ``experts`` is her plan's (the routed ones plus the shared expert, id E)."""
+
+    flat = [e for row in pick for e in row]
+    cnt = [0] * experts
+    for e in flat:
+        cnt[e] += 1
+    off, at = [0] * experts, 0
+    for e in range(experts):
+        off[e], at = at, at + cnt[e]
+    members, rank = [0] * len(flat), [0] * experts
+    for p, e in enumerate(flat):
+        members[off[e] + rank[e]] = p
+        rank[e] += 1
+    items = [(e, off[e] + tile * j, min(tile, cnt[e] - tile * j)) for e in range(experts)
+             for j in range((cnt[e] + tile - 1) // tile)]
+    return items, [len(items), sum(c > 0 for c in cnt)], members
+
+
+def order_model(items: list[tuple], count: int, cap: int) -> list[int]:
+    """Her prompt_order_kernel's result (the merge arithmetic, per item): heavy items (an expert with several) and
+    light ones merged evenly, each list in plan order; items of the shared expert (id >= E, last) left out; -1 after."""
+
+    allx = min(count, cap)
+    routed = 0
+    for i in range(allx):
+        if items[i][0] < E and (i + 1 == allx or items[i + 1][0] >= E):
+            routed = i + 1
+    n = routed
+
+    def heavy(i):
+        e = items[i][0]
+        return (i > 0 and items[i - 1][0] == e) or (i + 1 < n and items[i + 1][0] == e)
+
+    nh = sum(heavy(i) for i in range(n))
+    nl = n - nh
+    order = [-2] * allx
+    rh = 0
+    for i in range(n):
+        if heavy(i):
+            r = rh
+            rh += 1
+            x = (2 * r + 1) * nl
+            cl = min(nl, (x - nh + 2 * nh - 1) // (2 * nh)) if x > nh else 0
+            order[r + cl] = i
+        else:
+            lr = i - rh
+            y = (2 * lr + 1) * nh
+            ch = min(nh, (y - nl) // (2 * nl) + 1) if y >= nl else 0
+            order[lr + ch] = i
+    for i in range(n, allx):
+        order[i] = -1
+    return order
+
+
+def _pairs_of(item, members, maxm, ours: bool) -> list[int]:
+    _, first, cnt = item
+    got = members[first:first + cnt]
+    return [(c >> 5) * SLOTS + (c & 31) for c in got] if ours else got
+
+
+@pytest.mark.parametrize("pm", (64, 128))
+@pytest.mark.parametrize("R,skew", [(1, False), (7, True), (63, False), (64, True), (65, False), (594, True),
+                                    (1024, False), (2048, False), (2048, True)])
+def test_our_plan_is_her_plans_routed_items(R, skew, pm):
+    pick = picks(R, random.Random(R * 7 + skew), skew)
+    uids, members = group(pick, R)
+    cap = generic.prompt_items(R, SLOTS, E, pm)
+    ours, counts = our_plan(uids, members, R, pm, cap)
+    hers, hcounts, hmembers = her_plan(pick, E + 1, pm)
+    routed = [it for it in hers if it[0] < E]
+    assert hers[len(routed):] == [it for it in hers if it[0] >= E]          # her shared expert's items come last
+    assert [(e, c) for e, _, c in ours] == [(e, c) for e, _, c in routed]
+    for a, b in zip(ours, routed):
+        assert _pairs_of(a, members, R, True) == _pairs_of(b, hmembers, R, False)
+    assert counts == [len(routed), hcounts[1] - 1] and hcounts[0] <= cap   # her bound is the launch's grid y
+    # every routed pair exactly once
+    seen = sorted(p for it in ours for p in _pairs_of(it, members, R, True))
+    assert seen == sorted(r * SLOTS + s for r in range(R) for s in range(TOPK))
+    # her order kernel puts the same items in the same launch slots on either plan
+    assert order_model(ours, len(ours), cap) == order_model(hers, len(hers), cap)[:len(ours)] + []
+    full = order_model(hers, len(hers), cap)
+    assert full[len(ours):] == [-1] * (len(full) - len(ours))
+
+
+def test_prompt_items_bounds_every_grouping():
+    rng = random.Random(5)
+    for R in (1, 2, 3, 8, 31, 64, 100, 594, 2048, 4096):
+        for pm in (64, 128):
+            worst = 0
+            for e_used in {min(E, R * TOPK), 1, TOPK}:     # spread over every expert, or the fewest possible
+                n = R * TOPK
+                per = [n // e_used + (1 if i < n % e_used else 0) for i in range(e_used)]
+                worst = max(worst, sum((c + pm - 1) // pm for c in per))
+            assert worst <= generic.prompt_items(R, SLOTS, E, pm), (R, pm)
+        pick = picks(R, rng, True)
+        uids, members = group(pick, R)
+        our_plan(uids, members, R, 64, generic.prompt_items(R, SLOTS, E, 64))
+
+
+# --------------------------------------------------------------------------------------------------------- switch
+
+def test_prompt_switch_reads_her_names_off_unless_set(monkeypatch):
+    assert exl3_generic.prompt_switches() == {}
