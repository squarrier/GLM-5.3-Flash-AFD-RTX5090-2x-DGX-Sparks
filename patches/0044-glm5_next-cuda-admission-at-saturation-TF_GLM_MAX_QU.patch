diff --git a/tests/test_glm_admission_cap.py b/tests/test_glm_admission_cap.py
new file mode 100644
index 0000000..f9617f0
--- /dev/null
+++ b/tests/test_glm_admission_cap.py
@@ -0,0 +1,187 @@
+"""MiaAI-Lab recipe patch 0082 (by johnwhited), ``TF_GLM_MAX_QUEUED``: admission at saturation. Unset (the recipe's
+default), a request past the lanes queues as every scheduler always has; N, a foreground request past the lanes plus
+N waiting ones is refused at once (``CapacityError``: 429 with Retry-After under TF_GLM_CAPACITY_STATUS=1, else 503),
+while background requests still queue. CPU only: GlmScheduler over a stand-in decoder whose lanes stay busy until the
+test lets them go; with TF_GLM_QUEUED_CANCEL unset and set (0073's submit runs the same check first)."""
+
+from __future__ import annotations
+
+import threading
+import time
+
+import pytest
+
+from tensorfold.cuda.scheduler import Scheduler, Waiting
+from tensorfold.cuda.streams import Stream
+from tensorfold.families.glm5_next.cuda.multi import GlmScheduler
+from tensorfold.server.errors import CapacityError
+
+LANES = 2
+COUNT = 3
+
+
+class Lanes:
+    """A stand-in MultiDecoder: an admitted stream holds a lane; while ``go`` is set every live stream takes one token
+    a round and ends at its count."""
+
+    def __init__(self):
+        self.streams = {}
+        self.requeue = []
+        self.go = threading.Event()
+
+    def live(self):
+        return len(self.streams)
+
+    def fits(self, stream):
+        return True
+
+    def admit(self, stream):
+        stream.started = time.perf_counter()
+        self.streams[id(stream)] = stream
+
+    def round(self):
+        time.sleep(0.001)
+        if not self.go.is_set():
+            return []
+        done = []
+        for s in list(self.streams.values()):
+            s.take([7])
+            if s.done:
+                done.append(s)
+        return done
+
+    def finish(self, done):
+        for s in done:
+            self.streams.pop(id(s), None)
+
+    def drop(self):
+        out = list(self.streams.values())
+        self.streams.clear()
+        return out
+
+    def stats(self, s):
+        return s.stats()
+
+
+def until(cond, seconds=5.0):
+    end = time.monotonic() + seconds
+    while not cond():
+        if time.monotonic() > end:
+            raise AssertionError("timed out")
+        time.sleep(0.002)
+
+
+class Client(threading.Thread):
+    """One request: ``submit`` on its own thread, as the server's handler thread calls it."""
+
+    def __init__(self, scheduler, background=False):
+        super().__init__(daemon=True)
+        self.scheduler, self.background, self.tokens, self.result, self.error = scheduler, background, [], None, None
+        self.start()
+
+    def run(self):
+        try:
+            self.result = self.scheduler.submit([1, 2, 3], COUNT, None, True, self.emit, background=self.background)
+        except Exception as exc:  # noqa: BLE001  the test reads it
+            self.error = exc
+
+    def emit(self, new):
+        self.tokens.extend(new)
+        return False
+
+
+@pytest.fixture(params=["", "1"], ids=["submit", "queued-cancel"])
+def scheduler(monkeypatch, request):
+    """A factory: GlmScheduler over ``Lanes`` with TF_GLM_MAX_QUEUED set to the given value (None: unset)."""
+
+    monkeypatch.setenv("TF_GLM_QUEUED_CANCEL", request.param)
+    made = []
+
+    def make(queued):
+        if queued is None:
+            monkeypatch.delenv("TF_GLM_MAX_QUEUED", raising=False)
+        else:
+            monkeypatch.setenv("TF_GLM_MAX_QUEUED", queued)
+        s = GlmScheduler(Lanes(), max_streams=LANES)
+        made.append(s)
+        return s
+    yield make
+    for s in made:                                        # close() stops an idle worker: let streams end first
+        s.decoder.go.set()
+        deadline = time.monotonic() + 5
+        while (s.decoder.live() or s.waiting.qsize()) and time.monotonic() < deadline:
+            time.sleep(0.005)
+        s.close()
+
+
+@pytest.mark.parametrize("queued, cap", [(None, None), ("", None), ("0", LANES), ("3", LANES + 3)])
+def test_the_cap_is_the_lanes_plus_max_queued(scheduler, queued, cap):
+    assert scheduler(queued).max_in_system == cap        # "" is what the recipe's config.sh exports when unset
+
+
+def test_unset_a_request_past_the_lanes_queues_as_before(scheduler):
+    s = scheduler(None)
+    busy = [Client(s) for _ in range(LANES)]
+    until(lambda: s.decoder.live() == LANES)
+    extra = Client(s)
+    until(lambda: s.waiting.foreground_count() == 1)
+    s.decoder.go.set()
+    for c in [*busy, extra]:
+        c.join(5)
+        assert c.error is None and c.tokens == [7] * COUNT
+
+
+def test_max_queued_0_refuses_the_request_past_the_lanes_at_once(scheduler):
+    s = scheduler("0")
+    busy = [Client(s) for _ in range(LANES)]
+    until(lambda: s.decoder.live() == LANES)
+    t0 = time.monotonic()
+    refused = Client(s)
+    refused.join(5)
+    assert isinstance(refused.error, CapacityError) and "retry shortly" in str(refused.error)
+    assert time.monotonic() - t0 < 1.0 and refused.tokens == []
+    background = Client(s, background=True)             # background requests bypass the cap and queue
+    until(lambda: s.waiting.qsize() == 1)
+    s.decoder.go.set()
+    for c in [*busy, background]:
+        c.join(5)
+        assert c.error is None and c.tokens == [7] * COUNT
+
+
+def test_max_queued_1_lets_one_wait_and_refuses_the_next(scheduler):
+    s = scheduler("1")
+    busy = [Client(s) for _ in range(LANES)]
+    until(lambda: s.decoder.live() == LANES)
+    waits = Client(s)
+    until(lambda: s.waiting.foreground_count() == 1)
+    refused = Client(s)
+    refused.join(5)
+    assert isinstance(refused.error, CapacityError)
+    s.decoder.go.set()
+    for c in [*busy, waits]:
+        c.join(5)
+        assert c.error is None and c.tokens == [7] * COUNT
+    after = Client(s)                                     # room again once the lanes free
+    after.join(5)
+    assert after.error is None and after.tokens == [7] * COUNT
+
+
+def test_foreground_count_skips_background_and_the_stop_entry():
+    w = Waiting()
+    w.put((Stream([1], 1), None))
+    w.put((Stream([1], 1, background=True), None))
+    w.stop()                                              # TensorFold v0.6.5's close() entry: not a request
+    assert w.foreground_count() == 1
+
+
+def test_the_base_scheduler_never_refuses_without_a_cap():
+    s = Scheduler(Lanes(), max_streams=1)
+    try:
+        assert s.max_in_system is None
+        s._check_admission(False)
+        s.max_in_system = 0
+        with pytest.raises(CapacityError):
+            s._check_admission(False)
+        s._check_admission(True)                          # background bypasses
+    finally:
+        s.close()
