+            ranks[i][0].st = &states[i - 1];
+        }
+        try cuda.copy_source.enqueue(e.d, b.ids, std.mem.sliceAsBytes(ids[i * rows[0] ..][0..n]), e.stream);
+    }
+    if(comptime @import("builtin").is_test) if(Testing.prefill_views) |observe| try observe(&ptrs,&rows);
