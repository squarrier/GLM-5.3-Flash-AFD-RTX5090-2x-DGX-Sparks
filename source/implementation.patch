+//! Private V4.2 hybrid DFlash2 reachable-consumer regressions; CPU only.
+const std = @import("std");
+const cuda = @import("cuda");
+const native = @import("cuda_native.zig");
+const hybrid = @import("cuda_hybrid_config.zig");
+const env = @import("sys").env;
+const t = std.testing;
+
+fn selectedOpen(opt: ?[:0]const u8, drafts: bool, role: hybrid.Role, drafter: bool) !void {
+    const c: hybrid.Config = .{
+        .revision = 3, .role = role, .session = "00000000000000000000000000000001",
+        .model_sha256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        .master = .{ "127.0.0.1", "127.0.0.1" }, .ports = .{ 29550, 29551 }, .traffic_class = 104,
+        .verbs_device = "fixture", .roce_image = "/unopened.fatbin", .setup_ms = 30000,
+        .transaction_ms = 120000, .close_ms = 5000, .served_context = 300000,
+        .resident_users = 8, .mtp = true, .settings = .{ .pages = true },
+    };
+    const text = try std.json.Stringify.valueAlloc(t.allocator, c, .{});
+    defer t.allocator.free(text);
+    var tmp = t.tmpDir(.{}); defer tmp.cleanup();
+    try tmp.dir.writeFile(t.io, .{ .sub_path = "role.json", .data = text });
+    const path = try tmp.dir.realPathFileAlloc(t.io, "role.json", t.allocator); defer t.allocator.free(path);
+    const z = try t.allocator.dupeSentinel(u8, path, 0); defer t.allocator.free(z);
+    _ = env.setenv("TF_GLM_HYBRID_CONFIG", z, 1); defer _ = env.unsetenv("TF_GLM_HYBRID_CONFIG");
+    _ = env.unsetenv("TF_GLM_RANK"); _ = env.unsetenv("TF_GLM_WORLD");
+    if (opt) |s| { _ = env.setenv("TF_GLM_HYBRID_DFLASH", s, 1); } else { _ = env.unsetenv("TF_GLM_HYBRID_DFLASH"); }
+    defer _ = env.unsetenv("TF_GLM_HYBRID_DFLASH");
+    var ctx: cuda.Context = undefined;
+    _ = try native.open(t.allocator, t.io, &ctx, "/unreachable/model", null, .{
+        .context = 300000, .drafts = drafts, .drafter = if (drafter) "/unreachable/dflash" else null,
+    });
+    return error.UnexpectedDeviceOpen;
+}
+
+test "V42 DFlash: explicit hybrid drafter reaches rank admission before any device or model" {
+    try t.expectError(error.NoRank, selectedOpen("1", true, .attention, true));
+}
+
+test "V42 DFlash: hybrid external drafter is separately opt-in and still needs native draft mode" {
+    try t.expectError(error.HybridDrafterNeedsOptIn, selectedOpen(null, true, .attention, true));
+    try t.expectError(error.HybridDrafterNeedsOptIn, selectedOpen("0", true, .attention, true));
+    try t.expectError(error.DrafterNeedsDrafts, selectedOpen("1", false, .attention, true));
+    try t.expectError(error.BadHybridRole, selectedOpen("1", true, .expert0, true));
+    try t.expectError(error.NoRank, selectedOpen(null, true, .attention, false));
+}
+
+test "V42 DFlash: real selector ignores kernel no-winner sentinel without reading codebooks" {
+    const df = @import("dflash.zig");
+    var dr: df.Drafter = undefined;
+    var candidates: [df.BLOCK * df.CW]i32 = @splat(0x7fffffff);
+    dr.world = 1; dr.cand = &candidates; dr.pred = &.{}; dr.succ = &.{}; dr.gh = &.{};
+    var out: [df.BLOCK - 1]u32 = undefined;
+    var probs: [df.BLOCK - 1]f64 = undefined;
+    @import("dflash_select.zig").select(&dr, 0, df.BLOCK, .{ .slot = 0, .pos = 0, .n = 0,
+        .anchor = 9, .out = &out, .probs = &probs });
+    for (out, probs) |token, p| { try t.expectEqual(@as(u32, 9), token); try t.expectEqual(@as(f64, 0), p); }
+    @import("dflash_select.zig").select(&dr, 0, df.BLOCK, .{ .slot = 0, .pos = 0, .n = 0,
+        .anchor = 0x7fffffff, .out = &out, .probs = &probs });
+    for (out) |token| try t.expect(token < df.VOCAB);
+}
+
+test "V42 DFlash: real selector keeps valid candidates beside invalid IDs and normalizes a corrupt anchor" {
+    const df = @import("dflash.zig");
+    var dr: df.Drafter = undefined;
+    var candidates: [df.BLOCK * df.CW]i32 = @splat(-1);
+    for (1..df.BLOCK) |r| {
+        candidates[r * df.CW] = 0;
+        candidates[r * df.CW + df.TOPK] = @bitCast(@as(f32, 1));
+        candidates[r * df.CW + 1] = df.VOCAB;
+        candidates[r * df.CW + df.TOPK + 1] = @bitCast(@as(f32, 100));
+    }
+    var book: [df.RANK]u16 = @splat(0);
+    var hidden: [df.BLOCK * df.RANK]f32 = @splat(0);
+    dr.world = 1; dr.cand = &candidates; dr.pred = &book; dr.succ = &book; dr.gh = &hidden; dr.temp = 1;
+    var out: [df.BLOCK - 1]u32 = undefined;
+    var probs: [df.BLOCK - 1]f64 = undefined;
+    @import("dflash_select.zig").select(&dr, 0, df.BLOCK, .{ .slot = 0, .pos = 0, .n = 0,
+        .anchor = 0x7fffffff, .out = &out, .probs = &probs });
+    for (out, probs) |token, p| { try t.expectEqual(@as(u32, 0), token); try t.expectEqual(@as(f64, 1), p); }
+}
