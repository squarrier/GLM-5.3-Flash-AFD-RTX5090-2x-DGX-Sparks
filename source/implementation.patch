+pub fn activation(text: ?[]const u8) !bool {
+    const value = text orelse return false;
+    if (!std.mem.eql(u8, value, "observe-v1")) return error.Exact490DiagnosticSelection;
+    return true;
+}
+pub fn env(name: [*:0]const u8) ?[]const u8 {
+    return if (std.c.getenv(name)) |z| std.mem.span(z) else null;
+}
+pub const Physical = struct { free: u64, total: u64, mode: c_uint };
+/// Call the real existing driver ABI. No MiB rounding, payload-counter or nvidia-smi substitute.
+pub fn physical(e: *Engine) !Physical {
+    const selected = env("CUDA_MODULE_LOADING") orelse return error.PrecommitLoadingModeUnknown;
+    const expected: c_uint = if (std.mem.eql(u8, selected, "EAGER")) 1 else if (std.mem.eql(u8, selected, "LAZY")) 2 else return error.PrecommitLoadingModeUnknown;
+    const get: LoadingMode = if (comptime @import("builtin").is_test)
+        Test.loading_mode orelse return error.PrecommitLoadingModeUnknown
+    else blk: { var lib = e.d.lib; break :blk lib.lookup(LoadingMode, "cuModuleGetLoadingMode") orelse return error.PrecommitLoadingModeUnknown; };
+    var mode: c_uint = 0;
+    try e.d.result(get(&mode));
+    if (mode != expected) return error.PrecommitLoadingModeMismatch;
+    try e.stream.synchronize();
+    var free: usize = 0;
+    var total: usize = 0;
+    try e.d.result(e.d.api.cuMemGetInfo_v2(&free, &total));
