+                e.pending = false;
+                return true;
+            }
+            if (rc != cuda.abi.error_not_ready) {
+                e.failed = error.HybridCopyFailed;
+                return error.HybridCopyFailed;
+            }
+            std.atomic.spinLoopHint();
+        }
+        return false;
+    }
+};
