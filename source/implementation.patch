+  s.held=false;s.dirty=true;
+ }
+ pub fn fail(s:*Store) void {s.invalidate();if(s.config!=null){s.terminal=true;s.fault=true;}}
+ pub fn scheduleRelease(s:*Store,at:i96) void {if(s.config==null or s.release_ns!=null)return;s.release_ns=at;s.revision+=1;}
