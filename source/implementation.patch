+pub const Exl3 = struct { experts: u64, hidden: u64, inter: u64, layers: u64 };
+pub const WeightTotals = struct {
+    attention: u64 = 0,
+    dense: u64 = 0,
+    shared: u64 = 0,
+    router: u64 = 0,
+    embedding_head: u64 = 0,
+    routed: u64 = 0,
+    total: u64 = 0,
