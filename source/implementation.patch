+pub fn exercise(comptime M: type) !void {
+    return mode(M, false);
+}
+pub fn exerciseLanes(comptime M: type) !void {
+    return mode(M, true);
+}
+fn mode(comptime M: type, comptime through_lanes: bool) !void {
+    const E = @import("../cuda_engine.zig");
