+        errdefer fallback.releaseStorage();
+        const shape = sizes(capacity, prompt_set != null);
+        var offsets: [shape.len]usize = undefined;
+        var total: usize = 0;
+        for (shape, 0..) |n, i| {
+            offsets[i] = total;
+            total += std.mem.alignForward(usize, n, 256);
+        }
