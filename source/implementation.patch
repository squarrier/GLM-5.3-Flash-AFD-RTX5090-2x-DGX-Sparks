+    var out: [8][3]u32 = undefined;
+    for (&seq, &slots, &reqs, &out, 0..) |*q, *s, *r, *o, i| {
+        q.st.pos = 20 + i;
+        q.st.mtp_len = 10 + i;
+        q.st.mtp_pos_dev = mem.ptr + (2 << 20) + i * 4;
+        q.st.arena.buf.d = &d;
+        q.st.capacity = 4096;
+        q.st.mtp_base = 0;
+        q.st.ring_rows = 4096;
+        q.in_head = 2;
+        q.sampling = null;
+        q.rows_at = mem.ptr + (3 << 20) + i * 2 * 4096 * 2;
+        s.* = q;
+        r.* = .{ .slot = @intCast(i), .follow = &.{ 3, 4 }, .from_prompt = false, .depth = 1 + i % 3, .out = o, .chances = null };
+        const data: [*]u16 = @ptrFromInt(q.rows_at);
