diff --git a/zig/src/core/lane_qualify524.zig b/zig/src/core/lane_qualify524.zig
new file mode 100644
--- /dev/null
+++ b/zig/src/core/lane_qualify524.zig
@@ -0,0 +1,100 @@
+//! AI-assisted integration: finite trial-only pause of completed near-full prompts; default-inert, native Stream lifetime retained.
+const std=@import("std");
+pub const geometry=@import("occupancy_profile.zig");
+pub fn selected() bool {
+ return (geometry.fromEnv() catch @panic("invalid occupancy qualification activation")) != null;
+}
+pub const proof=@import("occupied_phase.zig");
+pub const PhaseConfig=proof.Config;
+// Technical outer ceilings only, never allocation or authority. Parent seals its actual cutoff.
+// Preserve fixed300K startup+work exactly; only named exact490K may use the separate finite bound.
+pub const max_until_work_ns=(960+240)*std.time.ns_per_s;
+pub const max_until_work_490_ns=7200*std.time.ns_per_s;
+pub fn phaseConfig(profile:?geometry.Profile, value:?[]const u8) !?PhaseConfig {
+ const text=value orelse return null;
+ if(profile!=.private300 and profile!=.private490)return error.PhaseProofNeedsExactPrivateGeometry;
+ if(text.len<37 or !std.mem.startsWith(u8,text,"v1:") or text[35]!=':')return error.BadPhaseProof;
+ for(text[3..35]) |c| if(!((c>='0' and c<='9') or (c>='a' and c<='f')))return error.BadPhaseProof;
+ for(text[36..]) |c| if(c<'0' or c>'9')return error.BadPhaseProof;
+ const deadline=std.fmt.parseInt(i96,text[36..],10) catch return error.BadPhaseProof;
+ if(deadline<=0)return error.BadPhaseProof;
+ const prompt_rows:usize=if(profile==.private490)489488 else 299488;
+ return .{.generation=text[3..35].*,.deadline_ns=deadline,.prompt_rows=prompt_rows,.total_window=prompt_rows+512};
+}
+pub const Gate=struct {
+ phase_config:?PhaseConfig=null,
+ drain:bool=false,
+ phase2_until:?i96=null,
+ enabled:bool=false,
+ seen:[9]u64=undefined,
+ seen_n:usize=0,
+ released:bool=false,
+ expired:bool=false,
+ until:?i96=null,
+ profile:geometry.Profile=.legacy524,
+ pub fn fromEnv() Gate {
+  const profile=geometry.fromEnv() catch @panic("invalid occupancy qualification activation");
+  const value=if(std.c.getenv("TF_GLM_OCCUPIED_PHASE_PROOF")) |v| std.mem.span(v) else null;
+  const phase=phaseConfig(profile,value) catch @panic("invalid occupied phase proof activation");
+  if(phase) |config| proof.start(config) catch @panic("occupied phase proof already spent");
+  return .{.enabled=profile!=null,.profile=profile orelse .legacy524,.phase_config=phase};
+ }
+ pub fn maxUntilWorkNs(g:*const Gate) i96 {
+  const config=g.phase_config orelse return max_until_work_ns;
+  return if(g.profile==.private490 and config.prompt_rows==489488 and config.total_window==490000) max_until_work_490_ns else max_until_work_ns;
+ }
+ fn owns(g:*const Gate,seq:u64) bool {
+  for(g.seen[0..g.seen_n]) |id| if(id==seq)return true;
+  return false;
+ }
+ fn release(g:*Gate,jobs:anytype) void {
+  for(jobs) |j| if(j.started and g.owns(j.seq)) {j.stream.paused=false;};
+  g.released=true;
+ }
+ /// The engine thread calls after fill.run returns, never from the prefilled callback or an HTTP thread.
+ pub fn visit(g:*Gate,jobs:anytype,now:i96) bool {
+  if(!g.enabled or g.released)return false;
+  if(g.drain)return true;
+  if(g.phase_config!=null and proof.failed()){g.drain=true;return true;}
+  if(g.phase_config) |config| if(now>=config.deadline_ns or config.deadline_ns-now>g.maxUntilWorkNs()) {g.expired=true;g.drain=true;proof.fail();return true;};
+  if(g.phase2_until) |end| if(now>=end) {proof.release();g.release(jobs);return false;};
+  if(g.phase_config==null) if(g.until) |end| if(now>=end) {
+   g.expired=true;g.release(jobs);
+   std.debug.print("QUALIFY524 {{\"phase\":\"hold_expired\",\"seen\":{d}}}\n",.{g.seen_n});
+   return false;
+  };
+  for(jobs) |j| {
+   if(!j.started or j.prefilled==null or j.stream.finished or !g.profile.acceptsPrompt(j.stream.prompt_len))continue;
+   if(!g.owns(j.seq)) {
+    if(g.seen_n>=g.seen.len) {g.expired=true;g.release(jobs);return false;}
+    g.seen[g.seen_n]=j.seq;g.seen_n+=1;
+    if(g.until==null)g.until=now+5400*std.time.ns_per_s;
+    std.debug.print("QUALIFY524 {{\"phase\":\"held\",\"seq\":{d},\"stream_ptr\":{d},\"seen\":{d},\"prompt_rows\":{d}}}\n",.{j.seq,@intFromPtr(&j.stream),g.seen_n,j.stream.prompt_len});
+   }
+   j.stream.paused=true;
+  }
+  if(g.seen_n==9 and g.phase_config==null) {
+   g.release(jobs);
+   std.debug.print("QUALIFY524 {{\"phase\":\"replacement_prefilled_release\",\"seen\":9}}\n",.{});
+   return false;
+  }
+  if(g.seen_n==9) if(g.phase_config) |config| if(g.phase2_until==null) {
+   g.phase2_until=@min(config.deadline_ns,now+60*std.time.ns_per_s);proof.scheduleRelease(g.phase2_until.?);
+  };
+  var waiting=false;
+  for(jobs) |j| {
+   if(!j.started or j.stream.finished)continue;
+   if(!j.stream.paused)return false;
+   waiting=true;
+  }
+  if(waiting and g.phase_config!=null) {
+   var pointers:[8]usize=undefined;var n:usize=0;
+   for(jobs) |j| if(j.started and !j.stream.finished) {
+    if(n==8){proof.fail();g.drain=true;return true;}
+    pointers[n]=@intFromPtr(&j.stream);n+=1;
+   };
+   proof.hold(pointers[0..n],now);
+  }
+  return waiting;
+ }
+};
