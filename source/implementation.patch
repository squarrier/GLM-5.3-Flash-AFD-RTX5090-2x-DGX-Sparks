+    e.group = null;
+    e.drafter = null;
+    e.images = null;
+    e.l2pf = null;
+    e.settings = .{};
+    e.c = .{ .hidden = 4096 };
+    e.mtp = true;
+    e.structured = false;
+    e.w.role = .attention;
+    e.bm.hin = mem.ptr;
+    e.bm.fnormed = mem.ptr + (512 << 10);
+    var stash: fw.Buffers = undefined;
