+  s.revision+=1;s.phase=phase;s.held=false;s.dirty=false;
+  @memcpy(s.checkpoint[0..text.len],text);s.checkpoint_len=text.len;
+  @memcpy(s.pointers[0..pointers.len],pointers);s.count=pointers.len;
+ }
+ pub fn hold(s:*Store,pointers:[]const usize,now:i96) void {
+  const c=s.config orelse return;
+  if(now>=c.deadline_ns){s.fail();return;}
+  if(s.dirty or s.terminal or s.phase==null)return;
+  if(s.count!=pointers.len){s.fail();return;}
+  for(pointers,0..) |ptr,i| {
+   if(std.mem.indexOfScalar(usize,s.pointers[0..s.count],ptr)==null or std.mem.indexOfScalar(usize,pointers[0..i],ptr)!=null){s.fail();return;}
+  }
+  if(!s.held){s.held=true;s.revision+=1;}
+ }
+ pub fn capture(s:*const Store,a:std.mem.Allocator,now:i96)!?[]u8 {
+  const c=s.config orelse return null;
+  var digest:[32]u8=undefined;std.crypto.hash.sha2.Sha256.hash(s.checkpoint[0..s.checkpoint_len],&digest,.{});
+  const hex=std.fmt.bytesToHex(digest,.lower);
+  return try std.json.Stringify.valueAlloc(a,.{.schema="occupied-phase-v1",.generation=c.generation[0..],.prompt_rows=c.prompt_rows,.total_window=c.total_window,.revision=s.revision,.phase=s.phase,.held=s.held and !s.dirty and !s.terminal and now<c.deadline_ns and (s.release_ns==null or now<s.release_ns.?),.released=s.released,.release_ns=s.release_ns,.terminal=s.terminal or now>=c.deadline_ns,.deadline_ns=c.deadline_ns,.checkpoint_json=s.checkpoint[0..s.checkpoint_len],.checkpoint_sha256=hex[0..]},.{});
+ }
+};
+// A bounded lock protects only copies and state transitions, never device/IO/network work.
+var armed=std.atomic.Value(bool).init(false);
+var locked=std.atomic.Value(bool).init(false);
+var state:Store=.{};
+fn lock() void {while(locked.swap(true,.acquire))std.atomic.spinLoopHint();}
+fn unlock() void {locked.store(false,.release);}
+pub fn start(c:Config)!void {lock();defer unlock();try state.start(c);armed.store(true,.release);}
+pub fn invalidate() void {if(!armed.load(.acquire))return;lock();defer unlock();state.invalidate();}
+pub fn fail() void {if(!armed.load(.acquire))return;lock();defer unlock();state.fail();}
+pub fn record(phase:usize,text:[]const u8,pointers:[]const usize)!void {if(!armed.load(.acquire))return;lock();defer unlock();try state.record(phase,text,pointers);}
+pub fn hold(pointers:[]const usize,now:i96) void {if(!armed.load(.acquire))return;lock();defer unlock();state.hold(pointers,now);}
+pub fn scheduleRelease(at:i96) void {if(!armed.load(.acquire))return;lock();defer unlock();state.scheduleRelease(at);}
+pub fn release() void {if(!armed.load(.acquire))return;lock();defer unlock();state.release();}
+pub fn failed() bool {if(!armed.load(.acquire))return false;lock();defer unlock();return state.fault;}
+pub fn capture(a:std.mem.Allocator,now:i96)!?[]u8 {
+ if(!armed.load(.acquire))return null;
+ lock();const copy=state;unlock();
+ return copy.capture(a,now);
+}
