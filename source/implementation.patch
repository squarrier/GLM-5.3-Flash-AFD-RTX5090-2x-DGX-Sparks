+++ b/zig/src/core/occupancy_profile.zig
@@ -0,0 +1,39 @@
+//! AI-assisted integration: explicit occupancy-only geometry; no scheduler, capacity or speed settings.
+const std = @import("std");
+pub const Profile = enum {
+    legacy524,
+    private300,
+    private490,
+    pub fn acceptsPrompt(p: Profile, rows: usize) bool {
+        return switch (p) {
+            .legacy524 => rows >= 477184,
+            // Exact frozen 300000-window recipe (299488 prompt + 512 output).
+            .private300 => rows == 299488,
+            // Source-selected prospective V4.2 490000 = 489488 prompt + 512 output.
+            .private490 => rows == 489488,
+        };
+    }
+};
+/// No numeric/free-form lower cutoffs. Ambiguous dual activation is refused.
+/// Without the new selector, preserve the original legacy flag's exact semantics.
+pub fn parse(legacy: ?[]const u8, occupancy: ?[]const u8) !?Profile {
+    if (occupancy) |value| {
+        const profile:Profile=if(std.mem.eql(u8,value,"300kx8-v1")) .private300 else if(std.mem.eql(u8,value,"490kx8-v1")) .private490 else return error.UnsupportedOccupancyProfile;
+        if (legacy != null) return error.ConflictingOccupancyActivation;
+        return profile;
+    }
+    if (legacy) |value| if (std.mem.eql(u8, value, "1")) return .legacy524;
+    return null;
+}
+fn env(name: [*:0]const u8) ?[]const u8 {
+    return if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+}
+pub fn fromEnv() !?Profile {
+    if (try serving490()) return null;
+    return parse(env("TF_GLM_QUALIFY_524X8"), env("TF_GLM_QUALIFY_OCCUPANCY"));
+}
+/// Exact serving geometry does not activate qualification pauses/checkpoints or a proof cutoff.
+pub fn serving490() !bool {
+    const settings = @import("sys").environment;
+    return settings.serving490(settings.Process{});
+}
