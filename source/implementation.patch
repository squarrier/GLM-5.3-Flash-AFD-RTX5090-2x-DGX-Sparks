+        @memcpy(out[96..128],&h.model_contract_sha256);@memcpy(out[128..160],&h.row_map_sha256);
+        @memcpy(out[160..192],&h.settings_sha256);@memcpy(out[192..224],&h.call_binding_sha256);
+    }
