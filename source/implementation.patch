+    incremental: [3]Charge = @splat(.{}),
+    peak: Charge = .{},
+    incremental_peak: Charge = .{},
+    incremental_unified_peak: u64 = 0,
+};
+/// Engine-thread metadata, no allocator and no global state. Identities name physical backing, not views.
+pub const Plan = struct {
