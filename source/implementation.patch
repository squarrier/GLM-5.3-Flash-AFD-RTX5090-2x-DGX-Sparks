@@ -0,0 +1,38 @@
+// Scott Quarrier with AI-assisted integration: default-inert startup observations.
+//! Default inert, two startup records, no hold, timer, Gate, traffic or teardown.
+const std=@import("std");const cuda=@import("cuda");const Engine=@import("cuda_engine.zig").Engine;
+pub const Record=struct {
+ schema:u32=1,base_tree:[]const u8="source-overlay-v4.2",
+ phase:enum{planner,ready},free:u64,total:u64,reserve:?u64=null,room:?u64=null,model:?u64=null,
+ remaining_device:u64,remaining_pinned:u64,rings:usize,attached_pages:usize,
+ usage:cuda.memory.Usage,
+};
+pub const Test=if(@import("builtin").is_test)struct{pub var sink:?*const fn(Record)void=null;}else struct{};
+pub fn activation(text:?[]const u8)!bool {
+ const v=text orelse return false;
+ if(!std.mem.eql(u8,v,"observe-v1"))return error.Exact490ObserverSelection;
+ return true;
+}
+fn active()!bool {
+ const raw=if(std.c.getenv("TF_GLM_SERVING_ADMISSION"))|v|std.mem.span(v) else null;
+ if(!try activation(raw))return false;
+ if(!try @import("engine_api").occupancy_qualification.geometry.serving490())return error.Exact490ObserverProfile;
+ return true;
+}
+fn emit(r:Record)void {
+ if(comptime @import("builtin").is_test)if(Test.sink)|sink|{sink(r);return;};
+ std.debug.print("TF_SERVING_ADMISSION {f}\n",.{std.json.fmt(r,.{})});
+}
+pub fn planner(e:*Engine,p:anytype,model:u64)!void {
+ if(!try active())return;
+ if(e.pages!=null or e.drafter==null or !e.drafter.?.paid(8))return error.Exact490ObserverPhase;
+ const pending=try @import("cuda_precommit_memory.zig").payload(e);
+ emit(.{.phase=.planner,.free=p.free,.total=p.total,.reserve=p.reserve,.room=p.room(model),.model=model,
+ .remaining_device=pending.device,.remaining_pinned=pending.pinned,.rings=e.drafter.?.slots.items.len,.attached_pages=0,.usage=cuda.usage(false)});
+}
+pub fn ready(e:*Engine,free:u64,total:u64)!void {
+ if(!try active())return;
+ // The consuming readyAdmission already synchronized and validated floor, rings, lanes and leases.
+ emit(.{.phase=.ready,.free=free,.total=total,.remaining_device=0,.remaining_pinned=0,
+ .rings=e.drafter.?.slots.items.len,.attached_pages=e.pages.?.pool.total(),.usage=cuda.usage(false)});
+}
