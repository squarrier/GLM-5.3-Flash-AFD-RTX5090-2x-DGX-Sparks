+    for ([_][]const u8{ "1", "17", "-1", "8x", "", "true", "8/100", "8/0", "0/4096", "8/", "/4096", "8/4096/2", "1/4096" }) |v| try std.testing.expectError(error.BadAfdStripes, parseStripes(v));
