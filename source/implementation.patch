+test "the binding's refusals: rows, configuration, the layer's shape, the strides, alignments and buffer sizes" {
+    const c = try g.defaultCfg(64);
+    var ls: g.Launches = .{};
+    try g.ffn(&ls, call(64, null), c);
+    const bad = [_]struct { g.Call, g.Cfg }{
+        .{ call(0, null), c },
+        .{ call(4097, null), c },
+        .{ blk: {
+            var x = call(64, null);
+            x.xs = 4094;
+            break :blk x;
+        }, c },
+        .{ blk: {
+            var x = call(64, null);
+            x.x += 2;
+            break :blk x;
+        }, c },
+        .{ blk: {
+            var x = call(64, null);
+            x.big.z += 64;
+            break :blk x;
+        }, c },
+        .{ blk: {
+            var x = call(64, null);
+            x.big.zd_bytes = g.bigNeeds(64, c).zd - 4;
+            break :blk x;
+        }, c },
+        .{ blk: {
+            var x = call(64, null);
+            x.plan.rows = 63;
+            break :blk x;
+        }, c },
+        .{ blk: {
+            var x = call(64, null);
+            x.layer.width = 2048;
+            break :blk x;
+        }, c },
+        .{ blk: {
+            var x = call(64, null);
+            x.ps = 7;
