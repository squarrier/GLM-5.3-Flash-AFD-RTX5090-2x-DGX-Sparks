+    if (free < need) return error.PrecommitKnownPayloadShortfall;
+    const driver = l.driver_peak orelse return error.PrecommitUnknownLiability;
+    const external = l.external_change orelse return error.PrecommitUnknownLiability;
+    const uncertainty = l.observation_uncertainty orelse return error.PrecommitUnknownLiability;
