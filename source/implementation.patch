+//! AI-assisted integration: one-process, startup-bound, default-off held-frontier evidence. No control endpoint.
+const std=@import("std");
+pub const Config=struct {generation:[32]u8,deadline_ns:i96,prompt_rows:usize=0,total_window:usize=0};
+pub const Store=struct {
