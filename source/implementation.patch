+        if (!std.mem.startsWith(u8, line, "MemAvailable:")) continue;
+        if (found != null) return error.PrecommitHostRead;
+        var words = std.mem.tokenizeAny(u8, line[13..], " \t");
+        const value = try decimal(words.next() orelse return error.PrecommitHostRead);
+        if (!std.mem.eql(u8, words.next() orelse return error.PrecommitHostRead, "kB") or words.next() != null) return error.PrecommitHostRead;
