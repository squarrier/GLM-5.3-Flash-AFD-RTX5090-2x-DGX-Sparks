+            return 0;
+        }
+        fn copy(dst: u64, src: u64, n: usize, _: cuda.abi.Stream) callconv(.c) c_int {
+            copied += n;
+            @memcpy(@as([*]u8, @ptrFromInt(dst))[0..n], @as([*]const u8, @ptrFromInt(src))[0..n]);
+            return 0;
+        }
+        fn forward(e: *E.Engine, ids: []const u32, segs: []const fw.Seg) !void {
+            try t.expect(at < 3);
+            try t.expectEqual(@as(usize, 4096), e.c.hidden);
+            waves[at] = ids.len;
+            const input: [*]const u16 = @ptrFromInt(e.bm.hin);
+            const output: [*]u16 = @ptrFromInt(e.bm.fnormed);
+            for (segs) |s| {
+                try t.expect(s.rows > 0);
+                const user = s.st.pos - 20;
+                try t.expect(user < 8);
+                for (0..s.rows) |row| for (0..4096) |col| {
+                    const want = if (at == 0) @as(u16, @intCast(0x3e00 + user * 32 + row + col % 13)) else expected[user] + @as(u16, @intCast(col % 17));
+                    try t.expectEqual(want, input[(s.row0 + row) * 4096 + col]);
+                };
+                const base: u16 = @intCast(0x3f00 + user * 32 + at);
+                for (0..s.rows) |row| for (0..4096) |col| {
+                    output[(s.row0 + row) * 4096 + col] = base + @as(u16, @intCast(col % 17));
+                };
+                expected[user] = base;
+            }
+            at += 1;
+        }
+        fn draw(_: *E.Engine, slot: u32, _: usize, depth: usize, out: *u32, prob: *f64) !void {
+            out.* = 100 * slot + @as(u32, @intCast(depth));
