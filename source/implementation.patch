+    d.api.cuEventRecord = F.record;
+    d.api.cuEventQuery = F.query;
+    d.api.cuEventDestroy_v2 = F.destroy;
+    d.api.cuStreamSynchronize = R.sync;
+    var mem = try cuda.DeviceBuffer.alloc(&d, 4 << 20);
+    defer mem.free();
+    defer {
+        (cuda.Stream{ .d = &d, .handle = null }).synchronize() catch unreachable;
+        cuda.copy_source.dropSpares(&d, null);
+    }
+    @memset(@as([*]u8, @ptrFromInt(mem.ptr))[0..mem.len], 0);
+    var e: E.Engine = undefined;
+    e.d = &d;
+    e.stream = .{ .d = &d, .handle = null };
