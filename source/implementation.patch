+        errdefer arena.free();
+        var buffers: [shape.len]cuda.DeviceBuffer = undefined;
+        for (&buffers, shape, offsets) |*b, n, off| b.* = .{ .d = d, .ptr = arena.ptr + off, .len = n, .borrowed = true };
