+    defer M.Testing.forward = null;
+    M.Testing.draw = R.draw;
+    defer M.Testing.draw = null;
+    if (comptime through_lanes) {
+        const L = @import("../cuda_lanes.zig");
+        const lanes = @import("lanes");
+        e.gpa = t.allocator;
+        e.share.world = 1;
+        var wire: @import("../cuda_follow.zig").Link = undefined;
+        var users: L.Lanes = .{ .x = .{ .e = &e, .link = &wire } };
+        defer users.lanes.deinit(t.allocator);
+        var asks: [8]lanes.backend.DraftRequest = undefined;
