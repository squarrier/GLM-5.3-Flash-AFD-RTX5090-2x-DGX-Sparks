+fn add(a: u64, b: u64) !u64 { return std.math.add(u64, a, b); }
+fn mul(a: u64, b: u64) !u64 { return std.math.mul(u64, a, b); }
+fn aligned(n: u64, alignment: u64) !u64 { return try mul((try add(n, alignment - 1)) / alignment, alignment); }
