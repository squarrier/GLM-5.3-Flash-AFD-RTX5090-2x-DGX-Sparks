# GLM-5.3-Flash AFD — 1× RTX 5090 coordinator + 2× DGX Spark expert ranks
# Copy to .env and edit. Every script reads this file; a variable exported on the
# command line wins (e.g. SLOTS=8 ./start.sh restart).

# --- hosts (SSH targets from the machine that runs ./start.sh) -------------
# The controller can run on any Linux box with SSH to all three hosts (it can be
# the coordinator itself). The SSH user needs passwordless sudo for systemctl.
SSH_USER=ubuntu
COORD_HOST=10.0.0.10          # x86_64 box with the RTX 5090 (sm_120)
SPARK1_HOST=10.0.0.11         # DGX Spark / GB10 #1: expert ranks 0 and 1
SPARK2_HOST=10.0.0.12         # DGX Spark / GB10 #2: expert ranks 2 and 3
# Uid:gid the containers run as (must own GLM_HOME on every host).
RUN_UID=1000
RUN_GID=1000

# --- fabric (RoCE v2 over ConnectX-7) --------------------------------------
# Two rails, one IPv4 per rail on every host. Each Spark runs two rank daemons,
# one per rail (rank A on rail 1, rank B on rail 2). The coordinator needs an
# address on both rails; one dual-homed port is fine (we run both subnets on
# one 200G port of a ConnectX-7 into a switch).
COORD_FABRIC_IPS=10.10.1.10,10.10.2.10
SPARK1_IP_A=10.10.1.11
SPARK1_IP_B=10.10.2.11
SPARK2_IP_A=10.10.1.12
SPARK2_IP_B=10.10.2.12
RANK_PORT=8600                # coordinator -> rank
PEER_PORT=8601                # rank <-> rank mesh (TCP; upstream default)

# --- paths on the hosts ------------------------------------------------------
# One directory per host; weights, rank images, logs. Needs ~16 GB + 2.3 GB on the
# coordinator and 2 × 38.4 GB on each Spark (plus the EXL3 checkpoint while slicing).
GLM_HOME=/home/ubuntu/glm53f-afd

# --- serving --------------------------------------------------------------------
API_LISTEN=0.0.0.0:8000
# Comma list; the first is the response `model` and all are listed by /v1/models
# (needs patches/0001; without it the engine only answers as glm-5.3-flash).
SERVED_NAMES=glm-5.3-flash,GLM-5.3-Flash-AFD
MAX_CONTEXT=262144            # per request; the KV pool on a 32 GB 5090 holds ~1.58M tokens
SLOTS=16
# Bearer-token auth for /v1/* (/health stays open). Path ON THE COORDINATOR to a file whose
# first line is the key (chown RUN_UID, chmod 600). Empty = no auth: only acceptable on a
# trusted, firewalled LAN. See README "Security".
API_KEY_FILE=                 # e.g. /etc/glm53f-afd/secrets/api-key (dir is mounted read-only)
EXTRA_ARGS=                   # appended to glm53f-serve

# --- upstream engine + images ---------------------------------------------------
UPSTREAM_REPO=https://github.com/hughmadden/glm53f-afd.git
UPSTREAM_REF=91db3cc6fe672e2724efa3464f63bd31493f63f6   # v1.1.0
COORD_BUILD_BASE=nvidia/cuda:12.9.1-devel-ubuntu24.04  # x86_64, sm_120
RANK_BUILD_BASE=nvidia/cuda:13.0.1-devel-ubuntu24.04   # aarch64, sm_121
COORD_IMAGE=glm53f-afd-build:cu129-x86
RANK_IMAGE=glm53f-afd-build:cu130-arm64

# --- weights (pinned revisions we measured) ---------------------------------------
BASE_REPO=zai-org/GLM-5.3-Flash
BASE_REV=eb9eb208eb0d988989d07a6a12d0fdeb5f52574a
EXL3_REPO=brandonmusic/GLM-5.3-Flash-tr3-4bpw
EXL3_REV=5ab363a8
DRAFTER_REPO=incoai/GLM-5.3-Flash-DFlash2
DRAFTER_REV=bf582e4e
# Where download.sh puts the ~164 GB EXL3 checkpoint on SPARK1 before slicing.
# Point at an existing copy (NFS is fine) to skip the download.
EXL3_CHECKPOINT=/home/ubuntu/glm53f-afd/exl3-checkpoint

# --- safety -------------------------------------------------------------------
# Start refuses below these MemAvailable floors (GiB). A Spark serving two ranks
# keeps ~27-35 GiB free, so 100 is the "nothing else is resident" check.
MIN_FREE_GIB_SPARK=100
MIN_FREE_GIB_COORD=60
POWER_LIMIT_W=                # e.g. 400: refuse if the 5090 power limit is above this
REQUIRE_GUARD=0               # 1 = refuse unless extras/gb10-hostguard is active
# Optional sha256 pins written by scripts/install.sh after a build (empty = unchecked).
SERVE_SHA256=
RANK_BIN_SHA256=
DRAFTER_SHA256=
