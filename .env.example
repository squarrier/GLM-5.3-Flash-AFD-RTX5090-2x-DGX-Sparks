# GLM-5.3-Flash EXL3 on 1x RTX 5090 + 2x DGX Spark, TensorFold attention/expert split over MCDMA
# Copy to .env and edit. Every script reads this file; a variable exported on the command line wins
# (e.g. PARALLEL=2 ./start.sh up).

# --- hosts (SSH targets from the machine that runs the scripts) -------------
# The controller can be any Linux box with passwordless SSH to all three hosts (it can be the attention host).
# The SSH user needs docker on every host; no sudo is used by these scripts.
SSH_USER=ubuntu
ATTN_HOST=10.0.0.10           # x86_64 + RTX 5090 (sm_120): the attention node, HTTP API, KV cache, drafter
EXPERT0_HOST=10.0.0.11        # DGX Spark / GB10 #1: expert half 0 (`tensorfold experts --rank 0`)
EXPERT1_HOST=10.0.0.12        # DGX Spark / GB10 #2: expert half 1 (`tensorfold experts --rank 1`)

# --- fabric (RoCE v2 over ConnectX-7) ----------------------------------------
# One address per host on the RDMA fabric. The attention node's address is --master (the rendezvous) and the
# connect end of both MCDMA links; each Spark is the listen end of its own link.
ATTN_FABRIC_IP=10.10.1.10
EXPERT0_FABRIC_IP=10.10.1.11
EXPERT1_FABRIC_IP=10.10.1.12
ATTN_RDMA_DEV=mlx5_0          # `ibv_devices` names
EXPERT_RDMA_DEV=rocep1s0f0
RDMA_GID_INDEX=3              # the RoCE v2 GID index (`show_gids`)
RDMA_MTU=4096

# --- MCDMA link daemons --------------------------------------------------------
MCDMA_LINK0=x0                # link name between the attention node and expert half 0
MCDMA_LINK1=x1
MCDMA_CTRL_PORT=18820         # mcdma-rpcd control port on each Spark (fabric address); link j uses MCDMA_CTRL_PORT + j
MCDMA_REQ_MIB=20              # mailbox halves: a 2,048-row prompt chunk is a 16.9 MB request and a 32 MiB reply
MCDMA_REP_MIB=36
MCDMA_INFLIGHT=2              # MoE exchanges in flight per expert node (TF_GLM_MCDMA_INFLIGHT, patch 0027): one link
                              # pair each, so two listen daemons on each Spark (x0, x0-1; x1, x1-1) and four peers on
                              # the connect daemon. 1 = one link per Spark. The scripts take 1-3 (one connect daemon
                              # holds six peers); 2 is the measured setting.
MCDMA_MODE_ATTN=auto          # TF_AFD_MCDMA_MODE per node: auto (GPU-driven if the probe passes) | gpu | cpu
MCDMA_MODE_EXPERT0=auto
MCDMA_MODE_EXPERT1=auto

# --- paths on the hosts --------------------------------------------------------
# AFD_HOME on every host: the patched tree, MCDMA's build, the CUDA extension cache, logs. Owned by SSH_USER.
AFD_HOME=/srv/glm-afd
# The checkpoint at the same path on all three hosts (local disk, or one read-only share). ~176 GB.
MODEL_DIR=/srv/models/GLM-5.3-Flash-EXL3-4bpw-TensorFold
# The DFlash2 drafter, on the attention host only. Empty: serve without a drafter (untested here).
DRAFTER_DIR=/srv/models/GLM-5.3-Flash-DFlash2
# Where ./build.sh assembles the patched TensorFold tree, on the controller.
BUILD_DIR=./build

# --- pins ----------------------------------------------------------------------
TF_REPO_URL=https://github.com/ashhart/TensorFold
# The base. Patches 0046-0048 are TensorFold v0.6.6's own three commits, so the built tree carries v0.6.6
# (docs/DESIGN.md#tensorfold-066).
TF_TAG=v0.6.5
TF_COMMIT=609ca419abecebdc5a059498a613680bd3aa847f
MCDMA_REPO_URL=https://github.com/ashhart/MCDMA
MCDMA_COMMIT=e672c14ff9fc7b38994caf73025cf1588b4de74e
BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
IMAGE=glm-afd-tensorfold:v0.6.5
MODEL_REPO=Mia-AiLab/GLM-5.3-Flash-EXL3-4bpw-TensorFold
MODEL_REV=76c0b5173166d2795dd48860f45d8224817f894c    # safetensors byte-identical to 078455ff
DRAFTER_REPO=incoai/GLM-5.3-Flash-DFlash2
DRAFTER_REV=bf582e4eacc1810f76656d1811693ff6c6737d2a  # CC BY-NC-ND 4.0: non-commercial, no derivatives

# --- serving -------------------------------------------------------------------
API_BIND=0.0.0.0              # read the Security section of the README first
API_PORT=8000
MODEL_NAME=GLM-5.3-Flash-EXL3 # --name
MODEL_ALIAS=glm-5.3-flash     # --alias
MASTER_PORT=29551             # the rendezvous on the attention node (TensorFold's default)
CONTEXT=262144                # tokens a request
PARALLEL=8                    # requests decoding together (1-8). Eight with a 64-row verify window (TF_GLM_MULTI_WINDOW
                              # below, patch 0030) and CACHE_GIB=8.5 with the host RAM tier, as measured
                              # (docs/DESIGN.md#eight-streams). 2.0 measured four streams at PARALLEL=4, CACHE_GIB=8 and
                              # no TF_GLM_MULTI_WINDOW, without the tier (a 966,656-token pool); 2.1 did not re-measure four.
DENSE=q4                      # TF_GLM_DENSE on the attention node: q4 (4-bit dense weights) | bf16
KV=fp8                        # TF_GLM_KV on the attention node: fp8 | bf16
CACHE_GIB=8.5                 # TF_GLM_CACHE_GIB: kept prompt states and the KV pool share this budget; past four
                              # streams their working memory comes out of it, and 8.5 keeps the 5090 under its memory
                              # gate at 8 with the kept states in host RAM (TF_GLM_KEPT_HOST below; 6.5 without them).
CACHE_ENTRIES=20              # TF_GLM_CACHE_ENTRIES: kept prompts at most. With TF_GLM_KEPT_HOST=1 their states live in
                              # pinned host RAM and the GPU keeps one staging state, so the KV pool gets the rest:
                              # 1,579,008 pool tokens here (2.0's 727,040 at 6.5 GiB kept 20 states on the GPU).
MAX_TOKENS=32768              # --max-tokens, the default reply budget
MEMORY_RESERVE_GIB=2          # TENSORFOLD_MEMORY_RESERVE_GIB on the attention node (32 GB card at 262,144)
# Extra TF_GLM_* switches, space-separated NAME=value pairs (checked against ^TF_GLM_[A-Z0-9_]+=[A-Za-z0-9._:-]{1,32}$).
# The measured configuration (docs/DESIGN.md#the-switches): Mia's main lane (docs/DESIGN.md#mias-main-lane) plus this
# recipe's own switches. On the attention node: shared-prefix states, grouped and sliced prompt fills, smooth
# streaming, her decode-window kernels, her tool-call fixes and kept reasoning, the chunked KDA prompt kernel (64-token
# prompt grid), prompt chunk pairs, her noise-aware DFlash2 draft policy at fnc5:0.2 (her lane uses fnc7:0.3:
# docs/BENCHMARKS.md#the-draft-policy), the pool's room rule (TF_GLM_CACHE_ROOM), shortest-first prompt order
# (TF_GLM_PREFILL_ORDER), the eight streams' 64-row verify window (TF_GLM_MULTI_WINDOW), her attention-side prompt
# kernels (patch 0028), which change the replies: on because the agentic eval (AEON-30) held 23 of 30 with them, over
# the bar of 21 (docs/DESIGN.md#her-attention-side-prompt-kernels), and 2.1's six: kept prompts' states and evicted
# rows in host RAM (TF_GLM_KEPT_HOST, TF_GLM_HOST_CACHE_GIB=24: 24 GiB of pinned pages and 53 state slots, 33.35 GiB
# of the attention host's RAM pinned as measured; patch 0032), prompt chunk pairs while streams decode
# (TF_GLM_FILL_PAIRS, patch 0033) and
# her v1.8's take-over, capacity and delivery fixes (TF_GLM_DECIDE_THEN_COPY, TF_GLM_CAPACITY_STATUS,
# TF_GLM_DELIVERY_ABORT; patches 0042, 0043, 0045). On the expert nodes: her decode kernel, and Hugh Madden's expert
# prompt kernels from glm53f-afd on every prompt window (TF_GLM_EXPERT_KERNEL=g53, patches 0034-0035; her EXL3 prompt
# kernel, TF_GLM_EXL3_PROMPT, takes the prompt windows again without it), which change the replies too (AEON-30 23 of
# 30 with them). Remove a pair to turn that feature
# off. Measured and left off: prefill lanes (TF_GLM_PREFILL_LANES=4: out of memory on the 5090), FP8 wire rows
# (TF_GLM_WIRE_FP8=1: fails the KL gate), 4,096-row prompt chunks (TF_GLM_PREFILL_ROWS=4096, patch 0031: GB10's expert
# nodes cannot launch their grouping kernel past 2,812 rows; do not set it), her v1.7.1
# kept-prompt five (TF_GLM_SHARED_PREFIX_COPY, TF_GLM_QUEUED_CANCEL, TF_GLM_COMPACT_BEFORE_EVICT,
# TF_GLM_ASSISTANT_ENDS, TF_GLM_CAP_SHARED_RECENCY; patches 0036-0040) and refusals at saturation (TF_GLM_MAX_QUEUED,
# patch 0044). docs/DESIGN.md#measured-and-off has each.
ATTN_ENV="TF_GLM_SHARED_PREFIX=1 TF_GLM_MULTI_PREFILL=1 TF_GLM_FILL_BUDGET_MS=200 TF_GLM_FILL_DRAFTS=1 TF_GLM_STREAM_SMOOTH=1 TF_GLM_STREAM_SMOOTH_MS=400 TF_GLM_Q4_TILE=table TF_GLM_HC_DEC=1 TF_GLM_LATENT_STAGES=3 TF_GLM_KDA_WIDE_ROWS=1 TF_GLM_DECODE_SELECT=1 TF_GLM_TOOL_CALLS=1 TF_GLM_KEEP_REASONING=1024 TF_GLM_KDA_CHUNKED=1 TF_GLM_PREFILL_PAIRS=1 TF_GLM_DFLASH_POLICY=fnc5:0.2 TF_GLM_CACHE_ROOM=1 TF_GLM_PREFILL_ORDER=sjf TF_GLM_MULTI_WINDOW=64 TF_GLM_LATENT_MMA=1 TF_GLM_HC_MMA=1 TF_GLM_SEQ_ROWS=256 TF_GLM_SPARSE_ONEPASS=1 TF_GLM_PROMPT_DSA=1 TF_GLM_KEPT_HOST=1 TF_GLM_HOST_CACHE_GIB=24 TF_GLM_FILL_PAIRS=1 TF_GLM_DECIDE_THEN_COPY=1 TF_GLM_CAPACITY_STATUS=1 TF_GLM_DELIVERY_ABORT=1"
EXPERT_ENV="TF_GLM_EXL3_DEC=1 TF_GLM_EXL3_FUSE=1 TF_GLM_EXL3_XROW=1 TF_GLM_EXL3_LOADS=nc TF_GLM_EXL3_PROMPT=1 TF_GLM_EXPERT_KERNEL=g53"
AFD_CHECK=0                   # 1: hash both sides' wire tensors (TF_AFD_CHECK); needs CONTEXT <= 98304 on a 32 GB card
AFD_CHECK_FORWARDS=256
AFD_TIME=0                    # 1: per-layer exchange timer lines (TF_AFD_TIME)

# --- safety ---------------------------------------------------------------------
MIN_FREE_GIB_EXPERT=100       # a Spark must show this much MemAvailable before an expert starts
HEALTH_WAIT=2400              # s until /health, at most (the first start compiles kernels)
QUIET_MAX=1200                # s with no new log bytes and no health: a wedged start
