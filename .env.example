# Optional build environment; scripts do not source this file.
# Export only values you intend to use, or prefix a build invocation.
ZIG_BIN=/opt/zig/zig
BUILD_DIR=/opt/afd-build
CACHE_DIR=/opt/afd-build/cache
ASSET_DIR=/opt/afd/assets
RDMA_HEADERS=/usr/include
NVCC=/usr/local/cuda/bin/nvcc
# Runtime locations are renderer CLI flags. Never put an API key here.
